    <link rel="stylesheet" href="yk-hr-overrides.css?v=2" />
    <link rel="stylesheet" href="yk-icons.css?v=2" />
    <style>
        #blazor-error-ui {
            display: none;
            position: fixed;
            inset-inline: 16px;
            bottom: 16px;
            z-index: 20000;
            padding: 14px 18px;
            border: 1px solid #D4AF37;
            border-radius: 12px;
            background: #fff8e1;
            color: #0A0F1E;
            box-shadow: 0 8px 28px rgba(0, 0, 0, .2);
            direction: rtl;
            text-align: right;
            font-family: Tajawal, sans-serif;
        }
        #blazor-error-ui .reload { margin-inline-start: 10px; color: #6b4f00; font-weight: 700; }
        #blazor-error-ui .dismiss {
            position: absolute;
            inset-inline-start: 12px;
            top: 8px;
            border: 0;
            background: transparent;
            color: inherit;
            cursor: pointer;
            font-size: 1.15rem;
        }
    </style>
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <div id="blazor-error-ui" role="alert" aria-live="assertive" data-nosnippet>
        حدث خطأ غير متوقع أو انقطع الاتصال بالنظام.
        <a href="" class="reload">إعادة تحميل الصفحة</a>
        <button type="button" class="dismiss" aria-label="إغلاق">×</button>
    </div>
    <script src="js/apexcharts.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/app.js?v=dashboard-sales-chart-20261027"></script>
</body>
</html>
