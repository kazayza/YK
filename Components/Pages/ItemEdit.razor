@page "/items/new"
@page "/items/edit/{ItemId:int}"
@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject ItemService ItemService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(ItemId == 0 ? "إضافة صنف جديد" : "تعديل صنف") - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card luxury-animate" dir="rtl">
        <div class="no-access-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
        <h4>يجب تسجيل الدخول أولاً</h4>
        <button class="btn-modern btn-primary-hybrid" @onclick='() => Navigation.NavigateTo("/login")'>تسجيل الدخول</button>
    </div>
}
else if (permissions == null || (ItemId == 0 && !permissions.CanAdd) || (ItemId > 0 && !permissions.CanEdit))
{
    <div class="no-access-card luxury-animate" dir="rtl">
        <div class="no-access-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div>
        <h4>ليس لديك صلاحية</h4>
        <p>@(ItemId == 0 ? "لا تملك صلاحية إضافة أصناف" : "لا تملك صلاحية تعديل الأصناف")</p>
        <button class="btn-modern btn-secondary-modern" @onclick="GoBack">العودة للقائمة</button>
    </div>
}
else
{
    <div class="item-edit-page luxury-animate" dir="rtl">

        <!-- HEADER HYBRID DARK GOLD + LOGO -->
        <div class="edit-header-hybrid">
            <div class="eh-gold-line"></div>
            <div class="eh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="eh-content">
                <div class="eh-right">
                    <div class="eh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="eh-logo" /></div>
                    <div class="eh-text">
                        <h2 class="eh-title">@(ItemId == 0 ? "إضافة صنف جديد" : "تعديل صنف")</h2>
                        <p class="eh-subtitle">
                            @if (ItemId == 0){<span>أدخل بيانات الصنف الجديد - سيتم توليد الكود تلقائياً</span>}
                            else{<span>تعديل: <strong class="eh-code">@item.ItemCode</strong> - @item.ItemNameAr</span>}
                        </p>
                    </div>
                </div>
                <div class="eh-actions">
                    <span class="eh-badge"><span class="eh-dot"></span>@(ItemId == 0 ? "جديد" : "تعديل")</span>
                    <button class="btn-modern btn-ghost-dark" @onclick="GoBack">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>رجوع
                    </button>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-state-luxury"><div class="loader-luxury"></div><p>جاري تحميل البيانات...</p></div>
        }
        else
        {
            <!-- MUDTAB STYLE LUXURY GOLD TABS - 6 TABS HYBRID -->
            <div class="mudtabs-luxury">
                <div class="mudtabs-header">
                    <button class="mudtab-btn @(activeTab==0?"active":"")" @onclick="() => activeTab=0">
                        <span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></span>
                        <span>البيانات الأساسية</span>
                        @if (string.IsNullOrWhiteSpace(item.ItemNameAr) || item.ItemType==0 || item.CategoryID==0){<span class="mt-required"></span>}
                    </button>
                    <button class="mudtab-btn @(activeTab==1?"active":"")" @onclick="() => activeTab=1">
                        <span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>
                        <span>التكاليف والأسعار</span>
                    </button>
                    <button class="mudtab-btn @(activeTab==2?"active":"")" @onclick="() => activeTab=2">
                        <span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01 20.73 6.96"/><path d="M12 22.08V12"/></svg></span>
                        <span>المخزون والمواصفات</span>
                    </button>
                    <button class="mudtab-btn @(activeTab==3?"active":"")" @onclick="() => activeTab=3">
                        <span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></span>
                        <span>الوصف والملاحظات</span>
                    </button>
                    <button class="mudtab-btn @(activeTab==4?"active":"")" @onclick="() => activeTab=4">
                        <span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></span>
                        <span>الصور والمرفقات</span>
                    </button>
                    <button class="mudtab-btn @(activeTab==5?"active":"")" @onclick="() => activeTab=5">
                        <span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></span>
                        <span>الحركة والسجل</span>
                    </button>
                    <div class="mudtab-indicator" style="--tab:@activeTab"></div>
                </div>

                <div class="mudtabs-body">

                    <!-- TAB 0: البيانات الأساسية -->
                    @if (activeTab == 0)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><div><h3>البيانات الأساسية</h3><p>المعلومات الرئيسية للصنف</p></div></div>
                            <div class="form-grid cols-4">
                                <div class="form-field"><label class="field-label">كود الصنف</label><div class="field-input disabled"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6"/><path d="M9 15h6"/></svg><span>@(item.ItemCode ?? "سيتم التوليد تلقائياً")</span></div></div>
                                <div class="form-field"><label class="field-label">الباركود</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><path d="M8 7v10M12 7v10M16 7v10"/></svg><input type="text" class="field-input" @bind="item.Barcode" placeholder="اختياري - اتركه فارغاً" /></div></div>
                                <div class="form-field"><label class="field-label required">اسم الصنف (عربي)</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" class="field-input" @bind="item.ItemNameAr" placeholder="مثال: بوية بلاستيك أبيض" /></div></div>
                                <div class="form-field"><label class="field-label">اسم الصنف (إنجليزي)</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" class="field-input" @bind="item.ItemNameEn" dir="ltr" placeholder="White Plastic Paint" /></div></div>
                            </div>
                            <div class="form-grid cols-4">
                                <div class="form-field"><label class="field-label required">نوع الصنف</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8Z"/></svg><select class="field-select" @bind="item.ItemType" @bind:after="OnItemTypeChanged"><option value="0">-- اختر النوع --</option><option value="1">مادة خام</option><option value="2">مادة تعبئة</option><option value="3">نصف مصنع</option><option value="4">منتج تام</option></select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                                <div class="form-field"><label class="field-label required">التصنيف</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg><select class="field-select" @bind="item.CategoryID"><option value="0">-- اختر التصنيف --</option>@foreach(var cat in filteredCategories){<option value="@cat.Id">@cat.Name</option>}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>@if(item.ItemType==0){<span class="field-hint">اختر نوع الصنف أولاً</span>}else if(!filteredCategories.Any()){<span class="field-hint error">لا توجد تصنيفات لهذا النوع</span>}</div>
                                <div class="form-field"><label class="field-label required">الوحدة الأساسية</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg><select class="field-select" @bind="item.PrimaryUnitID"><option value="0">-- اختر الوحدة --</option>@if(units!=null){@foreach(var u in units){<option value="@u.Id">@u.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                                <div class="form-field"><label class="field-label">الوحدة الثانوية</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg><select class="field-select" @bind="item.SecondaryUnitID"><option value="0">-- بدون --</option>@if(units!=null){@foreach(var u in units){<option value="@u.Id">@u.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                            </div>
                            <div class="form-grid cols-3">
                                <div class="form-field"><label class="field-label">معامل التحويل</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 16V4m0 0L3 8m4-4l4 4"/><path d="M17 8v12m0 0 4-4m-4 4-4-4"/></svg><input type="number" class="field-input @(item.SecondaryUnitID==0?"disabled":"")" @bind="item.ConversionFactor" step="0.01" disabled="@(item.SecondaryUnitID==0)" /></div></div>
                                <div class="form-field"><label class="field-label">مدة الصلاحية (يوم)</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><input type="number" class="field-input" @bind="item.ShelfLifeDays" placeholder="365" /></div></div>
                                <div class="form-field"><label class="field-label">الحالة</label><div class="toggle-card @(item.IsActive?"active":"")"><label class="toggle-switch"><input type="checkbox" @bind="item.IsActive" /><span class="toggle-slider"></span><span class="toggle-text">@(item.IsActive?"نشط - متاح للاستخدام":"غير نشط - مؤرشف")</span></label></div></div>
                            </div>
                        </div>
                    }

                    <!-- TAB 1: التكاليف والأسعار -->
                    @if (activeTab == 1)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div><h3>التكاليف والأسعار</h3><p>إدارة التكاليف والضرائب والتسعير</p></div></div>
                            <div class="form-grid cols-4">
                                <div class="form-field"><label class="field-label">التكلفة المعيارية</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="item.StandardCost" step="0.01" placeholder="0.00" /><span class="field-suffix">ج.م</span></div></div>
                                <div class="form-field"><label class="field-label">آخر سعر شراء</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="item.LastPurchasePrice" step="0.01" placeholder="0.00" /><span class="field-suffix">ج.م</span></div></div>
                                <div class="form-field"><label class="field-label">متوسط التكلفة</label><div class="input-with-suffix"><input type="number" class="field-input disabled" @bind="item.AverageCost" step="0.01" disabled /><span class="field-suffix">ج.م</span></div><span class="field-hint">يحسب تلقائياً من الحركات</span></div>
                                <div class="form-field"><label class="field-label">سعر البيع الافتراضي</label><div class="input-with-suffix"><input type="number" class="field-input @(item.ItemType!=4?"disabled":"")" @bind="item.DefaultSellingPrice" step="0.01" disabled="@(item.ItemType!=4)" placeholder="0.00" /><span class="field-suffix">ج.م</span></div>@if(item.ItemType!=4){<span class="field-hint">متاح فقط للمنتج التام</span>}</div>
                            </div>
                            <div class="pricing-cards">
                                <div class="price-card"><div class="pc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="pc-info"><label>هامش الربح</label><span>@GetProfitMargin()%</span></div></div>
                                <div class="price-card"><div class="pc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg></div><div class="pc-info"><label>التكلفة الإجمالية</label><span>@item.StandardCost.ToString("#,##0.00") ج.م</span></div></div>
                            </div>
                            <div class="form-grid cols-3" style="margin-top:16px">
                                <div class="form-field"><label class="field-label">الضريبة</label><div class="toggle-card @(item.IsTaxable?"active":"")"><label class="toggle-switch"><input type="checkbox" @bind="item.IsTaxable" /><span class="toggle-slider"></span><span class="toggle-text">@(item.IsTaxable?"خاضع للضريبة 14%":"معفي من الضريبة")</span></label></div></div>
                                <div class="form-field"><label class="field-label">نسبة الضريبة</label><div class="input-with-suffix"><input type="number" class="field-input @(!item.IsTaxable?"disabled":"")" @bind="item.TaxRate" step="0.01" disabled="@(!item.IsTaxable)" /><span class="field-suffix">%</span></div></div>
                                <div class="form-field"><label class="field-label">سعر شامل الضريبة</label><div class="field-input disabled"><span>@GetPriceWithTax().ToString("#,##0.00") ج.م</span></div></div>
                            </div>
                        </div>
                    }

                    <!-- TAB 2: المخزون والمواصفات -->
                    @if (activeTab == 2)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><div><h3>المخزون والمواصفات الفنية</h3><p>حدود المخزون والأبعاد والوزن</p></div></div>
                            <div class="form-grid cols-3">
                                <div class="form-field"><label class="field-label">حد أدنى للمخزون</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg><input type="number" class="field-input" @bind="item.MinStockLevel" step="0.01" placeholder="10" /></div><span class="field-hint">تنبيه عند الوصول لهذا الحد</span></div>
                                <div class="form-field"><label class="field-label">حد أقصى للمخزون</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg><input type="number" class="field-input" @bind="item.MaxStockLevel" step="0.01" placeholder="1000" /></div></div>
                                <div class="form-field"><label class="field-label">حد إعادة الطلب</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><input type="number" class="field-input" @bind="item.ReorderLevel" step="0.01" placeholder="50" /></div><span class="field-hint">إنشاء طلب شراء تلقائي</span></div>
                            </div>
                            <div class="form-grid cols-3">
                                <div class="form-field"><label class="field-label">الوزن (كجم)</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/></svg><input type="number" class="field-input" @bind="item.Weight" step="0.001" placeholder="1.5" /></div></div>
                                <div class="form-field"><label class="field-label">الحجم (لتر)</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/></svg><input type="number" class="field-input" @bind="item.Volume" step="0.001" placeholder="5" /></div></div>
                                <div class="form-field"><label class="field-label">مدة الصلاحية</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><input type="number" class="field-input" @bind="item.ShelfLifeDays" placeholder="365 يوم" /></div></div>
                            </div>
                            <div class="stock-visual">
                                <div class="sv-item"><span class="sv-dot min"></span><label>الحد الأدنى</label><span>@item.MinStockLevel</span></div>
                                <div class="sv-bar"><div class="sv-fill" style="width:@GetStockPercent()%"></div></div>
                                <div class="sv-item"><span class="sv-dot max"></span><label>الحد الأقصى</label><span>@item.MaxStockLevel</span></div>
                            </div>
                        </div>
                    }

                    <!-- TAB 3: الوصف والملاحظات -->
                    @if (activeTab == 3)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><div><h3>الوصف والملاحظات</h3><p>تفاصيل إضافية وملاحظات فنية</p></div></div>
                            <div class="form-grid cols-2">
                                <div class="form-field"><label class="field-label">الوصف التفصيلي</label><textarea class="field-textarea" rows="5" @bind="item.Description" placeholder="اكتب وصف تفصيلي للصنف، استخداماته، مميزاته..."></textarea><span class="field-hint">سيظهر في التقارير والطباعة</span></div>
                                <div class="form-field"><label class="field-label">ملاحظات داخلية</label><textarea class="field-textarea" rows="5" @bind="item.Notes" placeholder="ملاحظات للفريق الداخلي، تعليمات تخزين، تحذيرات..."></textarea><span class="field-hint">لا تظهر للعملاء - للاستخدام الداخلي فقط</span></div>
                            </div>
                            <div class="desc-preview">
                                <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>معاينة الوصف</h4>
                                <div class="preview-box">@(string.IsNullOrWhiteSpace(item.Description) ? "لا يوجد وصف - سيظهر هنا عند الكتابة" : item.Description)</div>
                            </div>
                        </div>
                    }

                    <!-- TAB 4: الصور والمرفقات -->
                    @if (activeTab == 4)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="M21 15l-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg></div><div><h3>الصور والمرفقات والباركود</h3><p>صور المنتج، المستندات، والباركود</p></div></div>
                            <div class="images-grid">
                                <div class="image-upload-card">
                                    <div class="iuc-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M17 8l-4-4-4 4"/><path d="M12 4v12"/></svg></div>
                                    <h4>رفع صورة المنتج</h4>
                                    <p>اسحب الصورة هنا أو اضغط للاختيار - JPG, PNG حتى 5MB</p>
                                    <button class="btn-modern btn-primary-hybrid" disabled>قريباً - رفع الصور</button>
                                </div>
                                <div class="barcode-card">
                                    <div class="bc-header"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z"/><path d="M8 7v10M12 7v10M16 7v10"/></svg><span>الباركود الحالي</span></div>
                                    <div class="bc-code">@(string.IsNullOrWhiteSpace(item.Barcode) ? item.ItemCode : item.Barcode)</div>
                                    <div class="bc-preview">
                                        <div class="bc-bars"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
                                        <span>@(item.ItemCode ?? "ITEM-000")</span>
                                    </div>
                                    <div class="bc-actions"><button class="btn-modern btn-ghost-luxury" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>طباعة الباركود</button></div>
                                </div>
                            </div>
                            <div class="attachments-section">
                                <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>المرفقات والمستندات</h4>
                                <div class="empty-attachments"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg><span>لا توجد مرفقات - قريباً: رفع شهادات الجودة، MSDS، كتالوجات</span></div>
                            </div>
                        </div>
                    }

                    <!-- TAB 5: الحركة والسجل -->
                    @if (activeTab == 5)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><div><h3>حركة الصنف وسجل التعديلات</h3><p>تتبع الحركات والتعديلات - @(ItemId==0?"سيظهر بعد الحفظ":"سجل كامل")</p></div></div>
                            @if (ItemId == 0)
                            {
                                <div class="empty-history"><div class="eh-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><h4>لا يوجد سجل بعد</h4><p>سيظهر سجل الحركات والتعديلات بعد حفظ الصنف لأول مرة</p></div>
                            }
                            else
                            {
                                <div class="audit-timeline">
                                    <div class="at-item"><div class="at-dot active"></div><div class="at-content"><div class="at-title">تم إنشاء الصنف</div><div class="at-meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>@createdByName</span><span>@createdDate</span></div></div></div>
                                    @if (!string.IsNullOrEmpty(modifiedByName))
                                    {
                                        <div class="at-item"><div class="at-dot"></div><div class="at-content"><div class="at-title">آخر تعديل</div><div class="at-meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>@modifiedByName</span><span>@modifiedDate</span></div></div></div>
                                    }
                                    <div class="at-item future"><div class="at-dot future"></div><div class="at-content"><div class="at-title">الحركات المستقبلية</div><div class="at-meta"><span>قريباً: عرض حركات المخزون، أوامر الشراء، فواتير المبيعات المرتبطة بهذا الصنف</span></div></div></div>
                                </div>
                                <div class="movements-placeholder">
                                    <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg>حركة المخزون - قريباً</h4>
                                    <p>سيتم عرض: أرصدة المخازن، حركات الاستلام والصرف، أوامر التصنيع، المبيعات</p>
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>

            <!-- AUDIT BAR + ACTIONS -->
            @if (ItemId > 0)
            {
                <div class="audit-bar-luxury">
                    <div class="audit-item-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span>أنشئ بواسطة: <strong>@createdByName</strong></span><span class="audit-date">@createdDate</span></div>
                    @if (!string.IsNullOrEmpty(modifiedByName)){<div class="audit-item-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 3v5h5"/></svg><span>آخر تعديل: <strong>@modifiedByName</strong></span><span class="audit-date">@modifiedDate</span></div>}
                </div>
            }

            <div class="actions-bar-luxury">
                <div class="actions-right-luxury">
                    <button class="btn-modern btn-primary-hybrid" @onclick="SaveItem" disabled="@isSaving">
                        @if (isSaving){<div class="btn-spinner"></div><span>جاري الحفظ...</span>}
                        else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H6v8"/></svg><span>@(ItemId==0?"حفظ الصنف":"حفظ التعديلات")</span>}
                    </button>
                    @if (ItemId == 0){<button class="btn-modern btn-success-hybrid" @onclick="SaveAndNew" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>حفظ وجديد</button>}
                </div>
                <button class="btn-modern btn-ghost-luxury" @onclick="GoBack">رجوع للقائمة</button>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(message))
{
    <div class="toast-container-luxury">
        <div class="toast-card-luxury @(isSuccess ? "toast-success" : "toast-error")">
            <div class="toast-icon-luxury">@((MarkupString)(isSuccess ? "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'/><path d='M22 4L12 14.01 9 11.01'/></svg>" : "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='10'/><path d='M15 9l-6 6'/><path d='M9 9l6 6'/></svg>"))</div>
            <span class="toast-text-luxury">@message</span>
            <button class="toast-close-luxury" @onclick='() => message = ""'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>
        </div>
    </div>
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.item-edit-page{display:flex;flex-direction:column;gap:16px;max-width:1300px;margin:0 auto;font-family:'Tajawal',sans-serif}
.luxury-fade{animation:fadeUp .4s cubic-bezier(.4,0,.2,1) both}
@@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}

/* HEADER HYBRID */
.edit-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.eh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.eh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}
.eh-bg-logo img{width:100px;height:100px;object-fit:contain}
.eh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.eh-right{display:flex;align-items:center;gap:10px}
.eh-logo-wrap{width:40px;height:40px;border-radius:10px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}
.eh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}
.eh-title{font-size:1.1rem;font-weight:900;color:#F5E6C8;margin:0}
.eh-subtitle{font-size:.74rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.eh-code{color:var(--gold);background:rgba(212,175,55,.1);padding:2px 8px;border-radius:6px;font-family:monospace}
.eh-actions{display:flex;align-items:center;gap:8px}
.eh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:700;color:var(--gold)}
.eh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}
.btn-modern{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:10px;font-weight:700;font-size:.78rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}
.btn-primary-hybrid{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 2px 10px rgba(212,175,55,.25)}
.btn-success-hybrid{background:linear-gradient(135deg,#10b981,#059669);color:#fff}
.btn-ghost-dark{background:rgba(255,255,255,.06);color:#cbd5e1;border:1px solid rgba(212,175,55,.12)}
.btn-ghost-dark:hover{background:rgba(255,255,255,.1)}
.btn-ghost-luxury{background:#fff;border:1px solid #e8e2d0;color:#475569}
.btn-ghost-luxury:hover{background:#fcfaf6;border-color:var(--gold)}
.btn-modern svg{width:14px;height:14px}

/* MUDTABS LUXURY GOLD - HYBRID STYLE */
.mudtabs-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:20px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.05);position:relative}
.mudtabs-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.6;z-index:2}
.mudtabs-header{position:relative;display:flex;gap:0;background:linear-gradient(135deg,#fcfaf6 0%,#f8f6f0 100%);border-bottom:1px solid #e8e2d0;padding:0 8px;overflow-x:auto;scrollbar-width:none}
.mudtabs-header::-webkit-scrollbar{display:none}
.mudtab-btn{position:relative;display:flex;align-items:center;gap:8px;padding:14px 18px;background:transparent;border:none;border-bottom:2px solid transparent;font-family:'Tajawal';font-size:.82rem;font-weight:700;color:#8B95A5;cursor:pointer;transition:all .25s;white-space:nowrap;flex-shrink:0}
.mudtab-btn:hover{background:rgba(212,175,55,.04);color:#0A0F1E}
.mudtab-btn.active{color:var(--gold-dark);background:rgba(212,175,55,.06);border-bottom-color:var(--gold)}
.mt-icon{width:20px;height:20px;display:flex;align-items:center;justify-content:center;color:inherit}
.mt-icon svg{width:16px;height:16px}
.mudtab-btn.active .mt-icon{color:var(--gold-dark)}
.mt-required{width:6px;height:6px;border-radius:50%;background:#ef4444;box-shadow:0 0 0 3px rgba(239,68,68,.12);margin-right:4px}
.mudtab-indicator{position:absolute;bottom:0;height:2px;background:var(--gold);transition:all .3s cubic-bezier(.4,0,.2,1);width:calc(100% / 6);right:calc(var(--tab) * (100% / 6));opacity:0}
.mudtabs-body{padding:22px;background:#fff;min-height:400px}

/* TAB PANEL */
.tab-panel{display:flex;flex-direction:column;gap:18px}
.tab-header{display:flex;align-items:center;gap:12px;padding-bottom:14px;border-bottom:1px solid #f1efe8}
.tab-icon{width:40px;height:40px;border-radius:12px;background:#fcfaf6;border:1px solid #e8e2d0;display:flex;align-items:center;justify-content:center;color:#475569}
.tab-icon.gold{background:rgba(212,175,55,.1);border-color:rgba(212,175,55,.15);color:var(--gold-dark)}
.tab-icon.dark{background:linear-gradient(135deg,var(--black2),var(--black3));border-color:var(--border-gold);color:var(--gold)}
.tab-icon svg{width:18px;height:18px}
.tab-header h3{font-size:.95rem;font-weight:800;color:#0A0F1E;margin:0}
.tab-header p{font-size:.72rem;color:#8B95A5;font-weight:600;margin:2px 0 0}

/* FORM */
.form-grid{display:grid;gap:14px;margin-bottom:4px}
.cols-2{grid-template-columns:repeat(2,1fr)} .cols-3{grid-template-columns:repeat(3,1fr)} .cols-4{grid-template-columns:repeat(4,1fr)}
.form-field{display:flex;flex-direction:column;gap:6px}
.field-label{font-size:.78rem;font-weight:700;color:#374151}
.field-label.required::after{content:' *';color:#ef4444}
.input-wrap{position:relative;display:flex;align-items:center}
.input-wrap svg{position:absolute;right:10px;width:14px;height:14px;color:#9ca3af;pointer-events:none;z-index:1}
.field-input{width:100%;height:42px;padding:0 36px 0 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.86rem;background:#fff;font-family:'Tajawal';transition:all .2s;outline:none}
.field-input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.field-input.disabled{background:#f9fafb;color:#9ca3af;border-style:dashed}
.field-input.disabled span{color:#6b7280}
.field-input.disabled{display:flex;align-items:center;gap:8px;padding:0 12px}
.field-input.disabled svg{position:static;width:14px;height:14px}
.select-wrap{position:relative;display:flex;align-items:center}
.select-wrap svg:first-child{position:absolute;right:10px;width:14px;height:14px;color:#9ca3af;pointer-events:none;z-index:1}
.field-select{width:100%;height:42px;padding:0 36px 0 28px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.86rem;background:#fff;font-family:'Tajawal';appearance:none;cursor:pointer;outline:none;transition:all .2s}
.field-select:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.select-arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.field-hint{font-size:.7rem;color:#9ca3af;font-weight:600}
.field-hint.error{color:#ef4444}
.input-with-suffix{position:relative;display:flex;align-items:center}
.input-with-suffix .field-input{padding-left:50px}
.field-suffix{position:absolute;left:1px;top:1px;bottom:1px;width:44px;display:flex;align-items:center;justify-content:center;background:#f8f6f0;border-radius:0 9px 9px 0;font-size:.78rem;font-weight:700;color:#6b7280;border-right:1px solid #e8e2d0}
.field-textarea{width:100%;padding:12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.86rem;background:#fff;font-family:'Tajawal';resize:vertical;outline:none;transition:all .2s}
.field-textarea:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.toggle-card{padding:8px 12px;background:#fcfaf6;border:1px solid #e8e2d0;border-radius:10px;transition:all .2s}
.toggle-card.active{background:rgba(212,175,55,.06);border-color:rgba(212,175,55,.15)}
.toggle-switch{display:flex;align-items:center;gap:10px;cursor:pointer}
.toggle-switch input{display:none}
.toggle-slider{width:40px;height:22px;background:#d1d5db;border-radius:999px;position:relative;transition:.3s;flex-shrink:0}
.toggle-slider::after{content:'';position:absolute;width:16px;height:16px;background:#fff;border-radius:50%;top:3px;right:3px;transition:.3s;box-shadow:0 1px 3px rgba(0,0,0,.15)}
.toggle-switch input:checked + .toggle-slider{background:var(--gold)}
.toggle-switch input:checked + .toggle-slider::after{right:21px}
.toggle-text{font-size:.8rem;font-weight:600;color:#374151}

/* PRICING CARDS */
.pricing-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:4px}
.price-card{display:flex;align-items:center;gap:12px;padding:14px;background:linear-gradient(135deg,#fcfaf6,#fff);border:1px solid #e8e2d0;border-radius:12px}
.pc-icon{width:36px;height:36px;border-radius:10px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.12);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}
.pc-icon svg{width:18px;height:18px}
.pc-info{display:flex;flex-direction:column}
.pc-info label{font-size:.7rem;color:#8B95A5;font-weight:600}
.pc-info span{font-size:1rem;font-weight:900;color:#0A0F1E;margin-top:2px}

/* STOCK VISUAL */
.stock-visual{display:flex;align-items:center;gap:12px;margin-top:16px;padding:14px;background:#fcfaf6;border:1px solid #f1efe8;border-radius:12px}
.sv-item{display:flex;align-items:center;gap:6px;font-size:.76rem;font-weight:600;color:#475569}
.sv-dot{width:8px;height:8px;border-radius:50%}
.sv-dot.min{background:#f59e0b} .sv-dot.max{background:#10b981}
.sv-bar{flex:1;height:6px;background:#e8e2d0;border-radius:99px;overflow:hidden}
.sv-fill{height:100%;background:linear-gradient(90deg,var(--gold),var(--gold-dark));border-radius:99px;transition:width .8s}

/* DESC PREVIEW */
.desc-preview{margin-top:8px;padding:16px;background:#fcfaf6;border:1px solid #f1efe8;border-radius:12px}
.desc-preview h4{display:flex;align-items:center;gap:6px;font-size:.84rem;font-weight:800;color:#0A0F1E;margin:0 0 10px}
.desc-preview h4 svg{width:14px;height:14px;color:var(--gold-dark)}
.preview-box{padding:12px;background:#fff;border:1px solid #e8e2d0;border-radius:10px;font-size:.82rem;color:#475569;min-height:60px;line-height:1.6}

/* IMAGES & BARCODE */
.images-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:14px}
.image-upload-card{border:2px dashed #e8e2d0;border-radius:16px;padding:24px;text-align:center;background:#fcfaf6;transition:all .2s}
.image-upload-card:hover{border-color:var(--gold);background:rgba(212,175,55,.03)}
.iuc-icon{width:48px;height:48px;margin:0 auto 12px;border-radius:12px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.12);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}
.iuc-icon svg{width:24px;height:24px}
.image-upload-card h4{font-size:.9rem;font-weight:800;color:#0A0F1E;margin:0}
.image-upload-card p{font-size:.74rem;color:#8B95A5;margin:6px 0 12px}
.barcode-card{background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:16px;text-align:center}
.bc-header{display:flex;align-items:center;justify-content:center;gap:6px;font-size:.82rem;font-weight:700;color:#0A0F1E;margin-bottom:10px}
.bc-header svg{width:16px;height:16px;color:var(--gold-dark)}
.bc-code{font-family:monospace;font-size:1.1rem;font-weight:800;letter-spacing:1px;color:var(--gold-dark);background:#f8f6f0;padding:8px;border-radius:8px;margin-bottom:12px}
.bc-preview{padding:12px;background:#fff;border:1px dashed #e8e2d0;border-radius:10px}
.bc-bars{display:flex;gap:2px;justify-content:center;margin-bottom:8px;height:40px;align-items:flex-end}
.bc-bars span{width:3px;background:#0A0F1E;border-radius:1px}
.bc-bars span:nth-child(odd){height:100%} .bc-bars span:nth-child(even){height:60%}
.bc-actions{margin-top:12px}
.attachments-section{margin-top:16px;padding:16px;background:#fcfaf6;border:1px solid #f1efe8;border-radius:12px}
.attachments-section h4{display:flex;align-items:center;gap:6px;font-size:.84rem;font-weight:800;color:#0A0F1E;margin:0 0 12px}
.attachments-section h4 svg{width:14px;height:14px}
.empty-attachments{display:flex;align-items:center;gap:10px;padding:16px;background:#fff;border:1px dashed #e8e2d0;border-radius:10px;color:#8B95A5;font-size:.8rem;font-weight:600;justify-content:center}
.empty-attachments svg{width:20px;height:20px;flex-shrink:0}

/* HISTORY */
.empty-history{text-align:center;padding:40px 20px}
.eh-icon{width:56px;height:56px;margin:0 auto 12px;border-radius:14px;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.12);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}
.eh-icon svg{width:28px;height:28px}
.empty-history h4{font-size:.9rem;font-weight:800;color:#0A0F1E;margin:0}
.empty-history p{font-size:.76rem;color:#8B95A5;margin:6px 0 0}
.audit-timeline{display:flex;flex-direction:column;gap:0;padding-right:8px}
.at-item{display:flex;gap:12px;padding:12px 0;position:relative}
.at-dot{width:12px;height:12px;border-radius:50%;background:#e8e2d0;border:2px solid #fff;box-shadow:0 0 0 2px #e8e2d0;flex-shrink:0;margin-top:2px;position:relative;z-index:1}
.at-dot.active{background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);border-color:#fff}
.at-dot.future{background:#f1efe8;box-shadow:0 0 0 2px #e8e2d0}
.at-item::before{content:'';position:absolute;right:5px;top:24px;bottom:-12px;width:2px;background:#f1efe8}
.at-item:last-child::before{display:none}
.at-item.future{opacity:.6}
.at-content{flex:1}
.at-title{font-size:.84rem;font-weight:700;color:#0A0F1E}
.at-meta{display:flex;gap:10px;margin-top:4px;font-size:.72rem;color:#8B95A5;font-weight:600;align-items:center;flex-wrap:wrap}
.at-meta svg{width:12px;height:12px}
.movements-placeholder{margin-top:16px;padding:16px;background:#fcfaf6;border:1px solid #f1efe8;border-radius:12px}
.movements-placeholder h4{display:flex;align-items:center;gap:6px;font-size:.84rem;font-weight:800;color:#0A0F1E;margin:0 0 6px}
.movements-placeholder h4 svg{width:14px;height:14px;color:var(--gold-dark)}
.movements-placeholder p{font-size:.76rem;color:#8B95A5;margin:0}

/* AUDIT BAR + ACTIONS */
.audit-bar-luxury{display:flex;flex-wrap:wrap;gap:16px;padding:12px 16px;background:#fcfaf6;border:1px solid #f1efe8;border-radius:12px}
.audit-item-luxury{display:flex;align-items:center;gap:6px;font-size:.78rem;color:#6b7280}
.audit-item-luxury svg{width:12px;height:12px}
.audit-item-luxury strong{color:#0A0F1E}
.audit-date{color:#9ca3af;margin-right:4px;font-size:.72rem}
.actions-bar-luxury{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;background:#fff;border-radius:16px;border:1px solid #e8e2d0;box-shadow:0 2px 12px rgba(0,0,0,.04)}
.actions-right-luxury{display:flex;gap:8px}
.btn-spinner{width:16px;height:16px;border:2px solid rgba(0,0,0,.1);border-top-color:var(--black2);border-radius:50%;animation:spin .6s linear infinite}
@@keyframes spin{to{transform:rotate(360deg)}}

/* TOAST */
.toast-container-luxury{position:fixed;bottom:20px;left:20px;z-index:1050;animation:toastIn .4s}
@@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.toast-card-luxury{display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:12px;box-shadow:0 10px 32px rgba(0,0,0,.12);min-width:300px}
.toast-card-luxury.toast-success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}
.toast-card-luxury.toast-error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
.toast-icon-luxury{width:20px;height:20px;flex-shrink:0}
.toast-icon-luxury svg{width:100%;height:100%}
.toast-text-luxury{flex:1;font-weight:600;font-size:.84rem}
.toast-close-luxury{width:20px;height:20px;border:none;background:rgba(0,0,0,.06);border-radius:6px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:inherit}
.toast-close-luxury svg{width:10px;height:10px}

.no-access-card{text-align:center;padding:50px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}
.no-access-icon{width:64px;height:64px;margin:0 auto 16px;border-radius:16px;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.12);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}
.no-access-icon svg{width:32px;height:32px}

@@media(max-width:992px){.cols-4{grid-template-columns:repeat(2,1fr)}.images-grid{grid-template-columns:1fr}.mudtabs-header{flex-wrap:nowrap}}
@@media(max-width:600px){.cols-2,.cols-3,.cols-4{grid-template-columns:1fr}.edit-header-hybrid .eh-content{flex-direction:column;align-items:flex-start}.actions-bar-luxury{flex-direction:column;gap:10px}.actions-right-luxury{width:100%;flex-direction:column}}
</style>

@code {
    [Parameter] public int ItemId { get; set; }
    private int activeTab = 0;
    private ItemEditDto item = new();
    private ModulePermissionDto? permissions;
    private List<LookupDto>? categories;
    private List<LookupDto> filteredCategories = new();
    private List<LookupDto>? units;
    private bool isLoading = true;
    private bool isSaving = false;
    private string message = "";
    private bool isSuccess = true;
    private string createdByName = "";
    private string createdDate = "";
    private string modifiedByName = "";
    private string modifiedDate = "";

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn){Navigation.NavigateTo("/login");return;}
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_ITEMS");
        if (permissions == null) return;
        if (ItemId == 0 && !permissions.CanAdd) return;
        if (ItemId > 0 && !permissions.CanEdit) return;

        categories = await LookupService.GetCategoriesAsync();
        units = await LookupService.GetUnitsAsync();
        FilterCategories();

        if (ItemId > 0)
        {
            var loaded = await ItemService.GetItemByIdAsync(ItemId);
            if (loaded != null){item = loaded; FilterCategories(); await LoadAuditInfo();}
            else{message = "لم يتم العثور على الصنف"; isSuccess = false;}
        }
        else{item.IsTaxable = true; item.TaxRate = 14; item.IsActive = true;}

        isLoading = false;
    }

    private async Task LoadAuditInfo()
    {
        var audit = await ItemService.GetItemAuditAsync(ItemId);
        if (audit != null){createdByName = audit.CreatedByName ?? "غير محدد"; createdDate = audit.CreatedDate?.ToString("dd/MM/yyyy hh:mm tt") ?? ""; modifiedByName = audit.ModifiedByName ?? ""; modifiedDate = audit.ModifiedDate?.ToString("dd/MM/yyyy hh:mm tt") ?? "";}
    }

    private void OnItemTypeChanged(){if (item.ItemType != 4) item.DefaultSellingPrice = 0; FilterCategories();}

    private void FilterCategories()
    {
        if (categories == null){filteredCategories = new(); return;}
        string? parentCode = item.ItemType switch{1 => "RAW",2 => "PKG",3 => "SEMI",4 => "FIN",_ => null};
        if (parentCode == null) filteredCategories = categories.Where(c => c.ParentId != null).ToList();
        else filteredCategories = categories.Where(c => c.ParentCode == parentCode).ToList();
        if (item.CategoryID > 0 && !filteredCategories.Any(c => c.Id == item.CategoryID)) item.CategoryID = 0;
    }

    private decimal GetProfitMargin()
    {
        if (item.StandardCost <= 0 || item.DefaultSellingPrice <= 0) return 0;
        return Math.Round(((item.DefaultSellingPrice - item.StandardCost) / item.DefaultSellingPrice) * 100, 1);
    }
    private decimal GetPriceWithTax() => item.IsTaxable ? item.DefaultSellingPrice * (1 + item.TaxRate / 100) : item.DefaultSellingPrice;
    private double GetStockPercent()
    {
        if (item.MaxStockLevel <= 0) return 50;
        var cur = item.MinStockLevel > 0 ? item.MinStockLevel : item.MaxStockLevel * 0.3m;
        return Math.Min(100, (double)(cur / item.MaxStockLevel * 100));
    }

    private async Task SaveItem()
    {
        if (!ValidateItem()) return;
        isSaving = true; StateHasChanged();
        try
        {
            if (ItemId == 0){item.ItemCode = await ItemService.GenerateItemCodeAsync(item.ItemType); var newId = await ItemService.InsertItemAsync(item, UserSession.UserID); message = $"تم إضافة الصنف بنجاح — الكود: {item.ItemCode}"; isSuccess = true; Navigation.NavigateTo($"/items/edit/{newId}");}
            else{await ItemService.UpdateItemAsync(item, UserSession.UserID); message = "تم حفظ التعديلات بنجاح"; isSuccess = true; await LoadAuditInfo(); StateHasChanged();}
        }catch(Exception ex){message = "خطأ: " + ex.Message; isSuccess = false;}
        finally{isSaving = false;}
    }

    private async Task SaveAndNew()
    {
        if (!ValidateItem()) return;
        isSaving = true; StateHasChanged();
        try
        {
            item.ItemCode = await ItemService.GenerateItemCodeAsync(item.ItemType);
            await ItemService.InsertItemAsync(item, UserSession.UserID);
            var savedCode = item.ItemCode;
            item = new ItemEditDto{IsTaxable = true, TaxRate = 14, IsActive = true};
            message = $"تم حفظ الصنف ({savedCode}) — يمكنك إضافة صنف جديد"; isSuccess = true;
            activeTab = 0;
        }catch(Exception ex){message = "خطأ: " + ex.Message; isSuccess = false;}
        finally{isSaving = false;}
    }

    private bool ValidateItem()
    {
        if (string.IsNullOrWhiteSpace(item.ItemNameAr)){message = "يجب إدخال اسم الصنف بالعربي"; isSuccess = false; activeTab=0; return false;}
        if (item.ItemType == 0){message = "يجب اختيار نوع الصنف"; isSuccess = false; activeTab=0; return false;}
        if (item.CategoryID == 0){message = "يجب اختيار التصنيف"; isSuccess = false; activeTab=0; return false;}
        if (item.PrimaryUnitID == 0){message = "يجب اختيار الوحدة الأساسية"; isSuccess = false; activeTab=0; return false;}
        if (item.ItemType == 4 && item.DefaultSellingPrice <= 0){message = "المنتج التام يجب أن يحتوي على سعر بيع أكبر من صفر"; isSuccess = false; activeTab=1; return false;}
        return true;
    }

    private void GoBack(){Navigation.NavigateTo("/items");}
}
