@code {
    [Parameter]
    public int ItemId { get; set; }

    private ItemEditDto item = new();
    private ModulePermissionDto? permissions;
    private List<LookupDto>? categories;
    
    private List<LookupDto> filteredCategories = new();
    private List<LookupDto>? units;
    private bool isLoading = true;
    private bool isSaving = false;
    private string message = "";
    private bool isSuccess = true;

    // معلومات الإنشاء
    private string createdByName = "";
    private string createdDate = "";
    private string modifiedByName = "";
    private string modifiedDate = "";

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // تحميل الصلاحيات
        if (!PermissionService.IsLoaded)
        {
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        }

        permissions = PermissionService.GetModule("SCR_ITEMS");

        // التحقق من الصلاحية
        if (permissions == null) return;
        if (ItemId == 0 && !permissions.CanAdd) return;
        if (ItemId > 0 && !permissions.CanEdit) return;

        // تحميل القوائم المنسدلة
        categories = await LookupService.GetCategoriesAsync();
        units = await LookupService.GetUnitsAsync();
        FilterCategories();

        if (ItemId > 0)
        {
            var loaded = await ItemService.GetItemByIdAsync(ItemId);
            if (loaded != null)
            {
                item = loaded;
                FilterCategories();
                await LoadAuditInfo();
            }
            else
            {
                message = "لم يتم العثور على الصنف";
                isSuccess = false;
            }
        }
        else
        {
            item.IsTaxable = true;
            item.TaxRate = 14;
            item.IsActive = true;
        }

        isLoading = false;
    }

    private async Task LoadAuditInfo()
    {
        var audit = await ItemService.GetItemAuditAsync(ItemId);
        if (audit != null)
        {
            createdByName = audit.CreatedByName ?? "غير محدد";
            createdDate = audit.CreatedDate?.ToString("dd/MM/yyyy hh:mm tt") ?? "";
            modifiedByName = audit.ModifiedByName ?? "";
            modifiedDate = audit.ModifiedDate?.ToString("dd/MM/yyyy hh:mm tt") ?? "";
        }
    }

      private void OnItemTypeChanged()
    {
        if (item.ItemType != 4)
            item.DefaultSellingPrice = 0;

        FilterCategories();
    }

    private async Task SaveItem()
    {
        if (!ValidateItem()) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            if (ItemId == 0)
            {
                item.ItemCode = await ItemService.GenerateItemCodeAsync(item.ItemType);
                var newId = await ItemService.InsertItemAsync(item, UserSession.UserID);
                message = $"تم إضافة الصنف بنجاح — الكود: {item.ItemCode}";
                isSuccess = true;
                Navigation.NavigateTo($"/items/edit/{newId}");
            }
            else
            {
                await ItemService.UpdateItemAsync(item, UserSession.UserID);
                message = "تم حفظ التعديلات بنجاح";
                isSuccess = true;
                await LoadAuditInfo();
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            message = "خطأ: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveAndNew()
    {
        if (!ValidateItem()) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            item.ItemCode = await ItemService.GenerateItemCodeAsync(item.ItemType);
            await ItemService.InsertItemAsync(item, UserSession.UserID);

            var savedCode = item.ItemCode;

            item = new ItemEditDto
            {
                IsTaxable = true,
                TaxRate = 14,
                IsActive = true
            };

            message = $"تم حفظ الصنف ({savedCode}) — يمكنك إضافة صنف جديد";
            isSuccess = true;
        }
        catch (Exception ex)
        {
            message = "خطأ: " + ex.Message;
            isSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool ValidateItem()
    {
        if (string.IsNullOrWhiteSpace(item.ItemNameAr))
        {
            message = "يجب إدخال اسم الصنف بالعربي";
            isSuccess = false;
            return false;
        }

        if (item.ItemType == 0)
        {
            message = "يجب اختيار نوع الصنف";
            isSuccess = false;
            return false;
        }

        if (item.CategoryID == 0)
        {
            message = "يجب اختيار التصنيف";
            isSuccess = false;
            return false;
        }

        if (item.PrimaryUnitID == 0)
        {
            message = "يجب اختيار الوحدة الأساسية";
            isSuccess = false;
            return false;
        }

        if (item.ItemType == 4 && item.DefaultSellingPrice <= 0)
        {
            message = "المنتج التام يجب أن يحتوي على سعر بيع أكبر من صفر";
            isSuccess = false;
            return false;
        }

        return true;
    }
        private void FilterCategories()
    {
        if (categories == null)
        {
            filteredCategories = new();
            return;
        }

        // تحديد كود التصنيف الأب حسب نوع الصنف
        string? parentCode = item.ItemType switch
        {
            1 => "RAW",
            2 => "PKG",
            3 => "SEMI",
            4 => "FIN",
            _ => null
        };

        if (parentCode == null)
        {
            // لو ما اختارش نوع، أظهر كل التصنيفات الفرعية
            filteredCategories = categories
                .Where(c => c.ParentId != null)
                .ToList();
        }
        else
        {
            // أظهر التصنيفات الفرعية التابعة للنوع المختار فقط
            filteredCategories = categories
                .Where(c => c.ParentCode == parentCode)
                .ToList();
        }

        // لو التصنيف المختار حالياً مش ضمن الفلتر الجديد، صفّره
        if (item.CategoryID > 0 && !filteredCategories.Any(c => c.Id == item.CategoryID))
        {
            item.CategoryID = 0;
        }
    }
    private void GoBack()
    {
        Navigation.NavigateTo("/items");
    }
}