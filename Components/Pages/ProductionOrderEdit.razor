@page "/production-orders/edit/{Id:int}"
@using YKCoatings.Services
@using YKCoatings.Models
@inject ProductionOrderService OrderService
@inject BOMService BomService
@inject NavigationManager NavigationManager
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject IJSRuntime JS

<PageTitle>@(Id == 0 ? "أمر تصنيع جديد" : isViewMode ? "عرض أمر التصنيع" : "تعديل أمر التصنيع") - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card">
        <div class="no-access-icon">🔒</div>
        <h4>يجب تسجيل الدخول أولاً</h4>
    </div>
}
else if (permissions is null || !Perms.CanView)
{
    <div class="no-access-card">
        <div class="no-access-icon">⛔</div>
        <h4>ليس لديك صلاحية لعرض هذه الشاشة</h4>
        <button class="btn-back-dash" @onclick='() => NavigationManager.NavigateTo("/dashboard")'>
            العودة للرئيسية
        </button>
    </div>
}
else if (isLoading)
{
    <div class="loading-page">
        <div class="spinner-lg"></div>
        <span>جاري تحميل البيانات...</span>
    </div>
}
else
{
    <div class="po-edit-page">

        <!-- ===== Header ===== -->
        <div class="page-header">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="bi bi-gear-wide-connected"></i>
                    @if (Id == 0)
                    {
                        <span>إنشاء أمر تصنيع جديد</span>
                    }
                    else if (isViewMode)
                    {
                        <span>عرض أمر التصنيع</span>
                    }
                    else
                    {
                        <span>تعديل أمر التصنيع</span>
                    }
                </h1>
                @if (Id > 0)
                {
                    <p class="header-subtitle">
                        رقم الأمر: @order.OrderNumber
                        <span class="status-chip-header @GetStatusClass(order.OrderStatus)">
                            @GetStatusName(order.OrderStatus)
                        </span>
                    </p>
                }
            </div>
            <div class="header-actions">
                <button class="btn-outline-light" @onclick="GoBack">
                    <i class="bi bi-arrow-right"></i>
                    <span>رجوع</span>
                </button>
            </div>
        </div>

        <!-- ===== الأقسام (Tabs) ===== -->
        <div class="tabs-bar">
            <button class="tab-btn @(activeTab == "main" ? "active" : "")"
                    @onclick='() => activeTab = "main"'>
                <i class="bi bi-info-circle-fill"></i>
                البيانات الأساسية
            </button>
            <button class="tab-btn @(activeTab == "materials" ? "active" : "")"
                    @onclick='() => activeTab = "materials"'>
                <i class="bi bi-box-seam-fill"></i>
                المواد المطلوبة
                @if (materials.Any())
                {
                    <span class="tab-badge">@materials.Count</span>
                }
            </button>
            <button class="tab-btn @(activeTab == "costs" ? "active" : "")"
                    @onclick='() => activeTab = "costs"'>
                <i class="bi bi-calculator-fill"></i>
                التكاليف
            </button>
            @if (Id > 0)
            {
                <button class="tab-btn @(activeTab == "audit" ? "active" : "")"
                        @onclick="LoadAuditTab">
                    <i class="bi bi-clock-history"></i>
                    معلومات النظام
                </button>
            }
        </div>

        <!-- ═══════════════════════════════════════ -->
        <!-- تاب البيانات الأساسية                    -->
        <!-- ═══════════════════════════════════════ -->
        @if (activeTab == "main")
        {
            <div class="form-card">
                <div class="form-card-header">
                    <i class="bi bi-info-circle-fill"></i>
                    البيانات الأساسية لأمر التصنيع
                </div>
                <div class="form-card-body">

                    <!-- صف 1 -->
                    <div class="form-row">
                        <div class="form-group col-4">
                            <label class="form-lbl required">الوصفة (BOM)</label>
                            <select class="form-ctrl"
                                    @bind="order.BOMID"
                                    @bind:after="OnBOMChanged"
                                    disabled="@isViewMode">
                                <option value="0">— اختر الوصفة —</option>
                                @foreach (var b in bomLookup)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            </select>
                            @if (validationErrors.ContainsKey("BOMID"))
                            {
                                <span class="field-error">@validationErrors["BOMID"]</span>
                            }
                        </div>
                        <div class="form-group col-4">
                            <label class="form-lbl">المنتج النهائي</label>
                            <input type="text" class="form-ctrl readonly-field"
                                   value="@bomProductName" readonly />
                        </div>
                        <div class="form-group col-4">
                            <label class="form-lbl">تاريخ الأمر</label>
                            <input type="date" class="form-ctrl"
                                   @bind="order.OrderDate"
                                   disabled="@isViewMode" />
                        </div>
                    </div>

                    <!-- صف 2: معلومات الوصفة -->
                    @if (bomInfo != null)
                    {
                        <div class="bom-info-strip">
                            <div class="bom-info-item">
                                <span class="bom-info-label">حجم الدفعة:</span>
                                <span class="bom-info-value">@bomBatchSize.ToString("G") @bomBatchUnitName</span>
                            </div>
                            <div class="bom-info-item">
                                <span class="bom-info-label">الإنتاج المتوقع:</span>
                                <span class="bom-info-value">@bomOutputQty.ToString("G") @bomOutputUnitName</span>
                            </div>
                        </div>
                    }

                    <!-- صف 3 -->
                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl required">الكمية المخططة</label>
                            <input type="number" class="form-ctrl"
                                   @bind="order.PlannedQty"
                                   @bind:after="CalcBatches"
                                   step="0.01" min="0.01"
                                   disabled="@isViewMode" />
                            @if (validationErrors.ContainsKey("PlannedQty"))
                            {
                                <span class="field-error">@validationErrors["PlannedQty"]</span>
                            }
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl required">الوحدة</label>
                            <select class="form-ctrl"
                                    @bind="order.PlannedUnitID"
                                    disabled="@isViewMode">
                                <option value="0">— اختر —</option>
                                @foreach (var u in unitLookup)
                                {
                                    <option value="@u.Id">@u.Name</option>
                                }
                            </select>
                            @if (validationErrors.ContainsKey("PlannedUnitID"))
                            {
                                <span class="field-error">@validationErrors["PlannedUnitID"]</span>
                            }
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">عدد الدفعات</label>
                            <input type="number" class="form-ctrl"
                                   @bind="order.NumberOfBatches"
                                   min="1"
                                   disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl required">الأولوية</label>
                            <select class="form-ctrl" @bind="order.OrderPriority" disabled="@isViewMode">
                                <option value="1">🔴 عاجل</option>
                                <option value="2">🟡 عادي</option>
                                <option value="3">🟢 غير عاجل</option>
                            </select>
                        </div>
                    </div>

                    <!-- صف 4 -->
                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl">تاريخ البدء المخطط</label>
                            <input type="date" class="form-ctrl"
                                   @bind="order.PlannedStartDate"
                                   disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">تاريخ الانتهاء المخطط</label>
                            <input type="date" class="form-ctrl"
                                   @bind="order.PlannedEndDate"
                                   disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">مخزن صرف الخامات</label>
                            <select class="form-ctrl" @bind="order.SourceWarehouseID" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var w in warehouseLookup)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">مخزن استلام المنتج</label>
                            <select class="form-ctrl" @bind="order.TargetWarehouseID" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var w in targetWarehouseLookup)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- صف 5 -->
                    <div class="form-row">
                        <div class="form-group col-6">
                            <label class="form-lbl">المسؤول عن التنفيذ</label>
                            <select class="form-ctrl" @bind="order.AssignedTo" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var e in employeeLookup)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-6">
                            <label class="form-lbl">المشرف</label>
                            <select class="form-ctrl" @bind="order.SupervisorID" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var e in employeeLookup)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <!-- صف 6: الكميات الفعلية (للعرض فقط) -->
                    @if (Id > 0 && order.OrderStatus >= 4)
                    {
                        <div class="section-divider">
                            <span>الكميات الفعلية</span>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-3">
                                <label class="form-lbl">الكمية المنتجة فعلياً</label>
                                <input type="text" class="form-ctrl readonly-field actual-val"
                                       value="@order.ActualQty.ToString("N2")" readonly />
                            </div>
                            <div class="form-group col-3">
                                <label class="form-lbl">كمية الهالك</label>
                                <input type="text" class="form-ctrl readonly-field waste-val"
                                       value="@order.WasteQty.ToString("N2")" readonly />
                            </div>
                            <div class="form-group col-3">
                                <label class="form-lbl">بداية فعلية</label>
                                <input type="text" class="form-ctrl readonly-field"
                                       value="@(order.ActualStartDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")" readonly />
                            </div>
                            <div class="form-group col-3">
                                <label class="form-lbl">انتهاء فعلي</label>
                                <input type="text" class="form-ctrl readonly-field"
                                       value="@(order.ActualEndDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")" readonly />
                            </div>
                        </div>
                    }

                    <!-- صف 7: ملاحظات -->
                    <div class="form-row">
                        <div class="form-group col-12">
                            <label class="form-lbl">ملاحظات</label>
                            <textarea class="form-ctrl textarea-ctrl"
                                      @bind="order.Notes"
                                      rows="3"
                                      placeholder="أضف ملاحظات هنا..."
                                      disabled="@isViewMode"></textarea>
                        </div>
                    </div>

                </div>
            </div>
        }

        <!-- ═══════════════════════════════════════ -->
        <!-- تاب المواد المطلوبة                      -->
        <!-- ═══════════════════════════════════════ -->
        @if (activeTab == "materials")
        {
            <div class="form-card">
                <div class="form-card-header">
                    <div style="display:flex;align-items:center;gap:.5rem;">
                        <i class="bi bi-box-seam-fill"></i>
                        المواد المطلوبة لأمر التصنيع
                        @if (materials.Any())
                        {
                            <span class="mat-count-badge">@materials.Count مادة</span>
                        }
                    </div>
                </div>

                @if (materialsLoading)
                {
                    <div class="state-box">
                        <div class="spinner-md"></div>
                        <span class="state-text">جاري تحميل المواد...</span>
                    </div>
                }
                else if (!materials.Any())
                {
                    <div class="state-box">
                        <div class="empty-icon-circle">
                            <i class="bi bi-inbox"></i>
                        </div>
                        <p class="empty-title">لا توجد مواد محسوبة</p>
                        <p class="empty-sub">سيتم حساب المواد تلقائياً عند حفظ أمر التصنيع</p>
                    </div>
                }
                else
                {
                    <!-- ملخص سريع -->
                    <div class="mat-summary-strip">
                        <div class="mat-summary-item">
                            <i class="bi bi-box-fill" style="color:#0ea5e9;"></i>
                            <span>خامات: <strong>@materials.Count(m => m.MaterialType == 1)</strong></span>
                        </div>
                        <div class="mat-summary-item">
                            <i class="bi bi-bag-fill" style="color:#d97706;"></i>
                            <span>تعبئة: <strong>@materials.Count(m => m.MaterialType == 2)</strong></span>
                        </div>
                        <div class="mat-summary-item">
                            <i class="bi bi-cash-stack" style="color:#10b981;"></i>
                            <span>إجمالي التكلفة: <strong>@materials.Sum(m => m.RequiredQty * m.UnitCost).ToString("N2") ج.م</strong></span>
                        </div>
                    </div>

                    

                    @if (RawMaterials.Any())
                    {
                        <div class="mat-section-title raw-title">
                            <i class="bi bi-box-fill"></i>
                            المواد الخام (@RawMaterials.Count صنف)
                        </div>
                        <div class="table-scroll">
                            <table class="mat-table">
                                <thead>
                                    <tr>
                                        <th style="width:40px;">#</th>
                                        <th>كود الصنف</th>
                                        <th>اسم الصنف</th>
                                        <th class="tc">الكمية المطلوبة</th>
                                        <th class="tc">الوحدة</th>
                                        <th class="tc">المصروف</th>
                                        <th class="tc">المتبقي</th>
                                        <th class="tc">التوفر</th>
                                        <th class="tr">تكلفة الوحدة</th>
                                        <th class="tr">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int ri = 1; }
                                    @foreach (var m in RawMaterials)
                                    {
                                        <tr>
                                            <td class="tc row-num">@(ri++)</td>
                                            <td><span class="code-chip">@m.ItemCode</span></td>
                                            <td class="item-name-cell">@m.ItemName</td>
                                            <td class="tc fw600">@m.RequiredQty.ToString("N3")</td>
                                            <td class="tc text-muted">@m.UnitName</td>
                                            <td class="tc">
                                                <span class="@(m.IssuedQty > 0 ? "issued-val" : "zero-val")">
                                                    @m.IssuedQty.ToString("N3")
                                                </span>
                                            </td>
                                            <td class="tc">
                                                @{
                                                    var remaining = m.RequiredQty - m.IssuedQty;
                                                }
                                                <span class="@(remaining > 0 ? "remaining-val" : "zero-val")">
                                                    @remaining.ToString("N3")
                                                </span>
                                            </td>
                                            <td class="tc">
                                                <span class="avail-chip @m.AvailabilityClass">
                                                    @m.AvailabilityStatus
                                                </span>
                                            </td>
                                            <td class="tr">@m.UnitCost.ToString("N2")</td>
                                            <td class="tr fw700 cost-col">
                                                @((m.RequiredQty * m.UnitCost).ToString("N2"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="total-row">
                                        <td colspan="9" class="tr fw700">إجمالي المواد الخام</td>
                                        <td class="tr fw800 cost-col">
                                            @RawMaterials.Sum(m => m.RequiredQty * m.UnitCost).ToString("N2")
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }

                    @if (PackagingMaterials.Any())
                    {
                        <div class="mat-section-title pkg-title">
                            <i class="bi bi-bag-fill"></i>
                            مواد التعبئة والتغليف (@PackagingMaterials.Count صنف)
                        </div>
                        <div class="table-scroll">
                            <table class="mat-table">
                                <thead>
                                    <tr>
                                        <th style="width:40px;">#</th>
                                        <th>كود الصنف</th>
                                        <th>اسم الصنف</th>
                                        <th class="tc">الكمية المطلوبة</th>
                                        <th class="tc">الوحدة</th>
                                        <th class="tc">المصروف</th>
                                        <th class="tc">المتبقي</th>
                                        <th class="tc">التوفر</th>
                                        <th class="tr">تكلفة الوحدة</th>
                                        <th class="tr">الإجمالي</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int pi = 1; }
                                    @foreach (var m in PackagingMaterials)
                                    {
                                        <tr>
                                            <td class="tc row-num">@(pi++)</td>
                                            <td><span class="code-chip">@m.ItemCode</span></td>
                                            <td class="item-name-cell">@m.ItemName</td>
                                            <td class="tc fw600">@m.RequiredQty.ToString("N3")</td>
                                            <td class="tc text-muted">@m.UnitName</td>
                                            <td class="tc">
                                                <span class="@(m.IssuedQty > 0 ? "issued-val" : "zero-val")">
                                                    @m.IssuedQty.ToString("N3")
                                                </span>
                                            </td>
                                            <td class="tc">
                                                @{
                                                    var remainingPkg = m.RequiredQty - m.IssuedQty;
                                                }
                                                <span class="@(remainingPkg > 0 ? "remaining-val" : "zero-val")">
                                                    @remainingPkg.ToString("N3")
                                                </span>
                                            </td>
                                            <td class="tc">
                                                <span class="avail-chip @m.AvailabilityClass">
                                                    @m.AvailabilityStatus
                                                </span>
                                            </td>
                                            <td class="tr">@m.UnitCost.ToString("N2")</td>
                                            <td class="tr fw700 cost-col">
                                                @((m.RequiredQty * m.UnitCost).ToString("N2"))
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="total-row">
                                        <td colspan="9" class="tr fw700">إجمالي مواد التعبئة</td>
                                        <td class="tr fw800 cost-col">
                                            @PackagingMaterials.Sum(m => m.RequiredQty * m.UnitCost).ToString("N2")
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                }
            </div>
        }

        <!-- ═══════════════════════════════════════ -->
        <!-- تاب التكاليف                            -->
        <!-- ═══════════════════════════════════════ -->
        @if (activeTab == "costs")
        {
            <div class="form-card">
                <div class="form-card-header">
                    <i class="bi bi-calculator-fill"></i>
                    ملخص تكاليف أمر التصنيع
                </div>
                <div class="form-card-body">
                    <div class="cost-grid">
                        <!-- التكاليف التقديرية -->
                        <div class="cost-section">
                            <div class="cost-section-title estimated-title">
                                <i class="bi bi-clipboard-data"></i>
                                التكاليف التقديرية
                            </div>
                            <div class="cost-item">
                                <span class="cost-label">تكلفة المواد</span>
                                <span class="cost-value">@order.EstimatedMaterialCost.ToString("N2")</span>
                            </div>
                            <div class="cost-item">
                                <span class="cost-label">تكلفة العمالة</span>
                                <span class="cost-value">@order.EstimatedLaborCost.ToString("N2")</span>
                            </div>
                            <div class="cost-item">
                                <span class="cost-label">مصاريف غير مباشرة</span>
                                <span class="cost-value">@order.EstimatedOverheadCost.ToString("N2")</span>
                            </div>
                            <div class="cost-item total-item estimated-total">
                                <span class="cost-label">الإجمالي التقديري</span>
                                <span class="cost-value">@order.EstimatedTotalCost.ToString("N2")</span>
                            </div>
                        </div>

                        <!-- التكاليف الفعلية -->
                        <div class="cost-section">
                            <div class="cost-section-title actual-title">
                                <i class="bi bi-receipt-cutoff"></i>
                                التكاليف الفعلية
                            </div>
                            <div class="cost-item">
                                <span class="cost-label">تكلفة المواد</span>
                                <span class="cost-value">@order.ActualMaterialCost.ToString("N2")</span>
                            </div>
                            <div class="cost-item">
                                <span class="cost-label">تكلفة العمالة</span>
                                <span class="cost-value">@order.ActualLaborCost.ToString("N2")</span>
                            </div>
                            <div class="cost-item">
                                <span class="cost-label">مصاريف غير مباشرة</span>
                                <span class="cost-value">@order.ActualOverheadCost.ToString("N2")</span>
                            </div>
                            <div class="cost-item total-item actual-total">
                                <span class="cost-label">الإجمالي الفعلي</span>
                                <span class="cost-value">@order.ActualTotalCost.ToString("N2")</span>
                            </div>
                        </div>

                        <!-- الفرق -->
                        @if (order.ActualTotalCost > 0)
                        {
                            <div class="cost-section variance-section">
                                <div class="cost-section-title variance-title">
                                    <i class="bi bi-arrow-left-right"></i>
                                    الانحراف
                                </div>
                                @{
                                    var variance = order.ActualTotalCost - order.EstimatedTotalCost;
                                    var variancePercent = order.EstimatedTotalCost > 0
                                        ? Math.Round((order.ActualTotalCost - order.EstimatedTotalCost)
                                            / order.EstimatedTotalCost * 100, 1)
                                        : 0m;
                                    var varianceClass = variance > 0 ? "negative-var" : "positive-var";
                                }
                                <div class="cost-item">
                                    <span class="cost-label">الفرق</span>
                                    <span class="cost-value @varianceClass">
                                        @variance.ToString("N2") ج.م
                                    </span>
                                </div>
                                <div class="cost-item">
                                    <span class="cost-label">النسبة</span>
                                    <span class="cost-value @varianceClass">
                                        @variancePercent%
                                    </span>
                                </div>
                            </div>
                        }
                    </div>

                    @if (order.PlannedQty > 0 && order.EstimatedTotalCost > 0)
                    {
                        <div class="unit-cost-strip">
                            <span>تكلفة الوحدة التقديرية:</span>
                            <strong>@((order.EstimatedTotalCost / order.PlannedQty).ToString("N2")) ج.م</strong>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ═══════════════════════════════════════ -->
        <!-- تاب معلومات النظام                       -->
        <!-- ═══════════════════════════════════════ -->
        @if (activeTab == "audit" && Id > 0)
        {
            <div class="form-card">
                <div class="form-card-header">
                    <i class="bi bi-clock-history"></i>
                    معلومات النظام
                </div>
                <div class="form-card-body">
                    @if (auditInfo == null)
                    {
                        <div class="state-box">
                            <div class="spinner-md"></div>
                        </div>
                    }
                    else
                    {
                        <div class="audit-grid">
                            <div class="audit-item">
                                <i class="bi bi-person-plus-fill" style="color:#4f46e5;"></i>
                                <div>
                                    <div class="audit-label">أنشأ بواسطة</div>
                                    <div class="audit-value">@auditInfo.CreatedByName</div>
                                    <div class="audit-date">@auditInfo.CreatedDate?.ToString("dd/MM/yyyy hh:mm tt")</div>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(auditInfo.ModifiedByName))
                            {
                                <div class="audit-item">
                                    <i class="bi bi-pencil-fill" style="color:#f59e0b;"></i>
                                    <div>
                                        <div class="audit-label">آخر تعديل بواسطة</div>
                                        <div class="audit-value">@auditInfo.ModifiedByName</div>
                                        <div class="audit-date">@auditInfo.ModifiedDate?.ToString("dd/MM/yyyy hh:mm tt")</div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(auditInfo.ApprovedByName))
                            {
                                <div class="audit-item">
                                    <i class="bi bi-check-circle-fill" style="color:#10b981;"></i>
                                    <div>
                                        <div class="audit-label">اعتمد بواسطة</div>
                                        <div class="audit-value">@auditInfo.ApprovedByName</div>
                                        <div class="audit-date">@auditInfo.ApprovedDate?.ToString("dd/MM/yyyy hh:mm tt")</div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(auditInfo.AssignedToName))
                            {
                                <div class="audit-item">
                                    <i class="bi bi-person-badge-fill" style="color:#0ea5e9;"></i>
                                    <div>
                                        <div class="audit-label">المسؤول عن التنفيذ</div>
                                        <div class="audit-value">@auditInfo.AssignedToName</div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(auditInfo.SupervisorName))
                            {
                                <div class="audit-item">
                                    <i class="bi bi-shield-fill-check" style="color:#2563eb;"></i>
                                    <div>
                                        <div class="audit-label">المشرف</div>
                                        <div class="audit-value">@auditInfo.SupervisorName</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ═══════════════════════════════════════ -->
        <!-- أزرار الإجراءات                          -->
        <!-- ═══════════════════════════════════════ -->
        <div class="action-bar">
            <div class="action-bar-start">
    @if (Id > 0 && !isViewMode)
    {
        @if (order.OrderStatus == 1 && permissions is not null && Perms.CanApprove)
        {
            <button class="btn-action approve" @onclick="ApproveOrder" disabled="@isSaving">
                <i class="bi bi-check-circle-fill"></i>
                اعتماد الأمر
            </button>
        }
    }
    @if (Id > 0 && order.OrderStatus == 2 && permissions is not null && Perms.CanEdit)
    {
        <button class="btn-action prepare" @onclick="() => ChangeStatus(3)" disabled="@isSaving">
            <i class="bi bi-gear-fill"></i>
            بدء التجهيز
        </button>
    }
    @if (Id > 0 && order.OrderStatus == 3 && permissions is not null && Perms.CanEdit)
    {
        <button class="btn-action start" @onclick="() => ChangeStatus(4)" disabled="@isSaving">
            <i class="bi bi-play-circle-fill"></i>
            بدء التصنيع
        </button>
    }
    @if (Id > 0 && order.OrderStatus == 4 && permissions is not null && Perms.CanEdit)
    {
        <button class="btn-action qc" @onclick="() => ChangeStatus(5)" disabled="@isSaving">
            <i class="bi bi-search"></i>
            إرسال لفحص الجودة
        </button>
    }
    @if (Id > 0 && order.OrderStatus == 5 && permissions is not null && Perms.CanApprove)
    {
        <button class="btn-action complete" @onclick="() => ChangeStatus(6)" disabled="@isSaving">
            <i class="bi bi-check-all"></i>
            إتمام الأمر
        </button>
    }
</div>
            <div class="action-bar-end">
                @if (!isViewMode)
                {
                    <button class="btn-save" @onclick="SaveOrder" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <span class="spinner-tiny"></span>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <i class="bi bi-check-lg"></i>
                            <span>@(Id == 0 ? "حفظ أمر التصنيع" : "حفظ التعديلات")</span>
                        }
                    </button>
                }
                <button class="btn-back" @onclick="GoBack">
                    <i class="bi bi-arrow-right"></i>
                    <span>رجوع</span>
                </button>
            </div>
        </div>

    </div>
}

<!-- ===== Toast ===== -->
@if (!string.IsNullOrEmpty(resultMessage))
{
    <div class="toast-msg @(isSuccess ? "toast-success" : "toast-error")">
        <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
        @resultMessage
    </div>
}

<style>
    /* ===== Variables ===== */
    :root {
        --c-primary: #4f46e5; --c-primary-lt: #eef2ff; --c-primary-dk: #3730a3;
        --c-success: #10b981; --c-success-lt: #ecfdf5;
        --c-warning: #f59e0b; --c-warning-lt: #fffbeb;
        --c-danger: #ef4444;  --c-danger-lt: #fef2f2;
        --c-info: #0ea5e9;    --c-info-lt: #f0f9ff;
        --c-secondary: #64748b; --c-secondary-lt: #f1f5f9;
        --c-teal: #0f766e;    --c-teal-lt: #f0fdfa;
        --c-surface: #fff;    --c-bg: #f8fafc;
        --c-border: #e2e8f0;  --c-text: #0f172a;
        --c-text-2: #64748b;  --c-text-3: #94a3b8;
        --r-sm: 8px; --r-md: 12px; --r-lg: 16px; --r-xl: 20px;
        --sh-sm: 0 1px 3px rgba(0,0,0,.06); --sh-md: 0 4px 16px rgba(0,0,0,.08);
    }

    .po-edit-page {
        direction: rtl; padding: 1.75rem 1.5rem; background: var(--c-bg);
        min-height: 100vh; font-family: 'Segoe UI', system-ui, sans-serif;
        display: flex; flex-direction: column; gap: 1.25rem;
    }

    /* No Access */
    .no-access-card {
        text-align: center; padding: 80px 20px; background: white;
        border-radius: var(--r-xl); border: 1px solid var(--c-border);
        max-width: 480px; margin: 80px auto; box-shadow: var(--sh-sm);
    }
    .no-access-icon { font-size: 3.5rem; margin-bottom: 16px; }
    .btn-back-dash {
        background: var(--c-secondary-lt); color: var(--c-secondary);
        border: none; padding: .6rem 1.4rem; border-radius: var(--r-sm);
        font-weight: 600; cursor: pointer;
    }

    /* Loading */
    .loading-page {
        display: flex; flex-direction: column; align-items: center;
        justify-content: center; min-height: 60vh; gap: 1rem; color: var(--c-text-3);
    }
    .spinner-lg {
        width: 56px; height: 56px; border: 4px solid var(--c-border);
        border-top-color: var(--c-teal); border-radius: 50%;
        animation: spin .7s linear infinite;
    }

    /* Header */
    .page-header {
        background: linear-gradient(135deg, #0f766e, #115e59);
        border-radius: var(--r-xl); padding: 1.5rem 2rem;
        display: flex; justify-content: space-between; align-items: center;
        box-shadow: 0 8px 32px rgba(15,118,110,.25);
        position: relative; overflow: hidden; flex-wrap: wrap; gap: 1rem;
    }
    .page-header::before {
        content: ''; position: absolute; top: -40px; left: -40px;
        width: 180px; height: 180px; background: rgba(255,255,255,.06); border-radius: 50%;
    }
    .header-content { position: relative; z-index: 1; }
    .header-title {
        color: #fff; font-size: 1.35rem; font-weight: 700; margin: 0 0 .2rem;
        display: flex; align-items: center; gap: .5rem;
    }
    .header-subtitle {
        color: rgba(255,255,255,.8); font-size: .85rem; margin: 0;
        display: flex; align-items: center; gap: .6rem;
    }
    .status-chip-header {
        display: inline-flex; align-items: center; gap: .3rem;
        padding: .2rem .6rem; border-radius: 20px;
        font-size: .72rem; font-weight: 700;
    }
    .header-actions { position: relative; z-index: 1; }
    .btn-outline-light {
        background: rgba(255,255,255,.15); color: #fff; border: 1px solid rgba(255,255,255,.3);
        padding: .5rem 1rem; border-radius: var(--r-sm); font-weight: 600;
        cursor: pointer; display: flex; align-items: center; gap: .4rem;
        transition: all .2s; font-size: .85rem;
    }
    .btn-outline-light:hover { background: rgba(255,255,255,.25); }

    /* Tabs */
    .tabs-bar {
        display: flex; gap: .5rem; background: var(--c-surface);
        padding: .5rem; border-radius: var(--r-md); border: 1px solid var(--c-border);
        box-shadow: var(--sh-sm); flex-wrap: wrap;
    }
    .tab-btn {
        background: transparent; border: none; padding: .6rem 1.2rem;
        border-radius: var(--r-sm); font-size: .85rem; font-weight: 600;
        color: var(--c-text-2); cursor: pointer; display: flex;
        align-items: center; gap: .4rem; transition: all .2s;
    }
    .tab-btn:hover { background: var(--c-teal-lt); color: var(--c-teal); }
    .tab-btn.active {
        background: var(--c-teal); color: #fff;
        box-shadow: 0 2px 8px rgba(15,118,110,.3);
    }
    .tab-badge {
        background: rgba(255,255,255,.25); padding: .1rem .45rem;
        border-radius: 10px; font-size: .7rem; font-weight: 700;
    }
    .tab-btn.active .tab-badge { background: rgba(255,255,255,.3); }

    /* Form Card */
    .form-card {
        background: var(--c-surface); border-radius: var(--r-md);
        box-shadow: var(--sh-sm); border: 1px solid var(--c-border); overflow: hidden;
    }
    .form-card-header {
        padding: .9rem 1.4rem; background: #fafafa;
        border-bottom: 1px solid var(--c-border);
        font-size: .88rem; font-weight: 700; color: var(--c-text);
        display: flex; align-items: center; justify-content: space-between; gap: .5rem;
    }
    .form-card-header i { color: var(--c-teal); }
    .form-card-body { padding: 1.4rem; }

    /* Form Grid */
    .form-row { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
    .form-group { display: flex; flex-direction: column; gap: .35rem; }
    .col-3  { flex: 0 0 calc(25% - .75rem); min-width: 180px; }
    .col-4  { flex: 0 0 calc(33.33% - .67rem); min-width: 200px; }
    .col-6  { flex: 0 0 calc(50% - .5rem); min-width: 220px; }
    .col-12 { flex: 0 0 100%; }

    .form-lbl {
        font-size: .8rem; font-weight: 600; color: var(--c-text-2);
    }
    .form-lbl.required::after {
        content: ' *'; color: var(--c-danger); font-weight: 700;
    }

    .form-ctrl {
        border: 1.5px solid var(--c-border); border-radius: var(--r-sm);
        padding: .55rem .9rem; font-size: .88rem; color: var(--c-text);
        background: #fafafa; transition: all .2s; outline: none; width: 100%;
    }
    .form-ctrl:focus {
        border-color: var(--c-teal); background: #fff;
        box-shadow: 0 0 0 3px rgba(15,118,110,.1);
    }
    .form-ctrl:disabled { background: #f1f5f9; color: var(--c-text-2); cursor: not-allowed; }
    .readonly-field { background: #f8fafc !important; color: var(--c-text-2) !important; }
    .textarea-ctrl { resize: vertical; min-height: 70px; }

    .field-error { font-size: .75rem; color: var(--c-danger); font-weight: 600; }

    /* BOM Info Strip */
    .bom-info-strip {
        display: flex; gap: 2rem; padding: .8rem 1.2rem; margin-bottom: 1rem;
        background: var(--c-teal-lt); border-radius: var(--r-sm);
        border: 1px solid #ccfbf1;
    }
    .bom-info-item { display: flex; align-items: center; gap: .5rem; }
    .bom-info-label { font-size: .8rem; color: var(--c-text-2); font-weight: 600; }
    .bom-info-value { font-size: .88rem; font-weight: 700; color: var(--c-teal); }

    /* Section Divider */
    .section-divider {
        display: flex; align-items: center; gap: .75rem; margin: 1.2rem 0;
    }
    .section-divider::before, .section-divider::after {
        content: ''; flex: 1; height: 1px; background: var(--c-border);
    }
    .section-divider span {
        font-size: .82rem; font-weight: 700; color: var(--c-text-2);
        white-space: nowrap;
    }

    .actual-val { color: var(--c-success) !important; font-weight: 700 !important; }
    .waste-val  { color: var(--c-danger) !important; font-weight: 700 !important; }

    /* ===== Materials Tab ===== */
    .mat-count-badge {
        background: var(--c-teal-lt); color: var(--c-teal);
        padding: .15rem .5rem; border-radius: 12px;
        font-size: .72rem; font-weight: 700;
    }
    .mat-summary-strip {
        display: flex; gap: 2rem; padding: .8rem 1.4rem;
        border-bottom: 1px solid var(--c-border); background: #fafafa;
    }
    .mat-summary-item {
        display: flex; align-items: center; gap: .4rem;
        font-size: .85rem; color: var(--c-text-2);
    }
    .mat-section-title {
        padding: .7rem 1.4rem; font-size: .85rem; font-weight: 700;
        display: flex; align-items: center; gap: .4rem;
        border-bottom: 1px solid var(--c-border);
    }
    .raw-title { color: #0284c7; background: #f0f9ff; border-right: 3px solid #0ea5e9; }
    .pkg-title { color: #b45309; background: #fffbeb; border-right: 3px solid #f59e0b; }

    .mat-table { width: 100%; border-collapse: collapse; }
    .mat-table thead th {
        background: #f8fafc; padding: .7rem .9rem; font-size: .74rem;
        font-weight: 700; color: var(--c-text-3); text-transform: uppercase;
        letter-spacing: .05em; border-bottom: 2px solid var(--c-border);
        text-align: right; white-space: nowrap;
    }
    .mat-table thead th.tc { text-align: center; }
    .mat-table thead th.tr { text-align: left; }
    .mat-table tbody td {
        padding: .65rem .9rem; font-size: .84rem; border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .mat-table tbody td.tc { text-align: center; }
    .mat-table tbody td.tr { text-align: left; }
    .mat-table tbody tr:hover { background: #f0fdfa; }

    .row-num { color: var(--c-text-3); font-size: .78rem; }
    .code-chip {
        font-family: 'Courier New', monospace; font-weight: 700;
        color: var(--c-teal); background: var(--c-teal-lt);
        padding: .15rem .45rem; border-radius: 5px; font-size: .8rem;
    }
    .item-name-cell { font-weight: 600; }
    .fw600 { font-weight: 600; }
    .fw700 { font-weight: 700; }
    .fw800 { font-weight: 800; }
    .text-muted { color: var(--c-text-3); }
    .issued-val { color: var(--c-success); font-weight: 600; }
    .remaining-val { color: var(--c-warning); font-weight: 600; }
    .zero-val { color: var(--c-text-3); }
    .cost-col { color: var(--c-success); }

    .avail-chip {
        display: inline-flex; padding: .15rem .5rem; border-radius: 12px;
        font-size: .72rem; font-weight: 700;
    }
    .avail-ok      { background: var(--c-success-lt); color: #059669; }
    .avail-partial { background: var(--c-warning-lt); color: #d97706; }
    .avail-no      { background: var(--c-danger-lt);  color: #dc2626; }

    .total-row td {
        background: #f8fafc; border-top: 2px solid var(--c-border);
        padding: .8rem .9rem; font-size: .88rem;
    }

    .table-scroll { overflow-x: auto; }

    /* ===== Costs Tab ===== */
    .cost-grid {
        display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
    }
    .cost-section {
        background: #fafafa; border-radius: var(--r-md);
        border: 1px solid var(--c-border); overflow: hidden;
    }
    .cost-section-title {
        padding: .75rem 1.2rem; font-size: .85rem; font-weight: 700;
        display: flex; align-items: center; gap: .4rem;
        border-bottom: 1px solid var(--c-border);
    }
    .estimated-title { color: #4f46e5; background: #eef2ff; }
    .actual-title    { color: #0f766e; background: #f0fdfa; }
    .variance-title  { color: #1d4ed8; background: #f5f3ff; }

    .cost-item {
        display: flex; justify-content: space-between; align-items: center;
        padding: .65rem 1.2rem; border-bottom: 1px solid #f1f5f9;
    }
    .cost-item:last-child { border-bottom: none; }
    .cost-label { font-size: .84rem; color: var(--c-text-2); }
    .cost-value { font-size: .88rem; font-weight: 700; color: var(--c-text); direction: ltr; }
    .total-item { background: #f1f5f9; }
    .estimated-total .cost-value { color: #4f46e5; font-size: 1rem; }
    .actual-total .cost-value { color: #0f766e; font-size: 1rem; }
    .negative-var { color: var(--c-danger) !important; }
    .positive-var { color: var(--c-success) !important; }
    .variance-section { border-color: #ddd6fe; }

    .unit-cost-strip {
        margin-top: 1.5rem; padding: .8rem 1.2rem; background: var(--c-teal-lt);
        border-radius: var(--r-sm); border: 1px solid #ccfbf1;
        font-size: .9rem; color: var(--c-text-2); text-align: center;
    }
    .unit-cost-strip strong { color: var(--c-teal); margin-right: .5rem; }

    /* ===== Audit Tab ===== */
    .audit-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1rem;
    }
    .audit-item {
        display: flex; gap: .75rem; padding: 1rem; background: #fafafa;
        border-radius: var(--r-sm); border: 1px solid var(--c-border);
    }
    .audit-item i { font-size: 1.3rem; margin-top: .1rem; }
    .audit-label { font-size: .78rem; color: var(--c-text-3); font-weight: 600; }
    .audit-value { font-size: .9rem; font-weight: 700; color: var(--c-text); }
    .audit-date  { font-size: .78rem; color: var(--c-text-2); margin-top: .1rem; }

    /* ===== Action Bar ===== */
    .action-bar {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1rem 1.4rem; background: var(--c-surface);
        border-radius: var(--r-md); border: 1px solid var(--c-border);
        box-shadow: var(--sh-sm); flex-wrap: wrap; gap: .75rem;
        position: sticky; bottom: 0; z-index: 10;
    }
    .action-bar-start { display: flex; gap: .5rem; flex-wrap: wrap; }
    .action-bar-end   { display: flex; gap: .5rem; flex-wrap: wrap; }

    .btn-action {
        border: none; border-radius: var(--r-sm); padding: .55rem 1.1rem;
        font-size: .85rem; font-weight: 600; cursor: pointer;
        display: flex; align-items: center; gap: .4rem; transition: all .2s;
        color: #fff;
    }
    .btn-action:disabled { opacity: .6; cursor: not-allowed; }
    .btn-action.approve  { background: #059669; }
    .btn-action.prepare  { background: #d97706; }
    .btn-action.start    { background: #ea580c; }
    .btn-action.qc       { background: #4f46e5; }
    .btn-action.complete { background: #0f766e; }
    .btn-action:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(0,0,0,.15); }

    .btn-save {
        background: linear-gradient(135deg, var(--c-teal), #115e59); color: #fff;
        border: none; border-radius: var(--r-sm); padding: .6rem 1.5rem;
        font-size: .88rem; font-weight: 700; cursor: pointer;
        display: flex; align-items: center; gap: .45rem; transition: all .2s;
        box-shadow: 0 4px 12px rgba(15,118,110,.3);
    }
    .btn-save:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(15,118,110,.4); }
    .btn-save:disabled { opacity: .6; cursor: not-allowed; }

    .btn-back {
        background: var(--c-secondary-lt); color: var(--c-secondary);
        border: none; border-radius: var(--r-sm); padding: .6rem 1.2rem;
        font-size: .85rem; font-weight: 600; cursor: pointer;
        display: flex; align-items: center; gap: .4rem;
    }

    /* States */
    .state-box {
        display: flex; flex-direction: column; align-items: center;
        justify-content: center; padding: 3rem 2rem; gap: 1rem;
    }
    .spinner-md {
        width: 44px; height: 44px; border: 3px solid var(--c-border);
        border-top-color: var(--c-teal); border-radius: 50%;
        animation: spin .7s linear infinite;
    }
    .spinner-tiny {
        width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.35);
        border-top-color: #fff; border-radius: 50%;
        animation: spin .6s linear infinite; display: inline-block;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .state-text  { color: var(--c-text-3); font-size: .9rem; font-weight: 500; }
    .empty-icon-circle {
        width: 70px; height: 70px; background: var(--c-teal-lt); border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem; color: var(--c-teal);
    }
    .empty-title { font-size: 1rem; font-weight: 700; color: var(--c-text); margin: 0; }
    .empty-sub   { font-size: .82rem; color: var(--c-text-3); margin: 0; }

