@code {
    [Parameter] public int Id { get; set; }

    private ProductionOrderEditDto order = new();
    private List<ProductionOrderMaterialDto> materials = new();
    private List<ProductionOrderMaterialDto> RawMaterials =>
    materials.Where(m => m.MaterialType == 1).ToList();

private List<ProductionOrderMaterialDto> PackagingMaterials =>
    materials.Where(m => m.MaterialType == 2).ToList();

    private ProductionOrderAuditDto? auditInfo;
    private ModulePermissionDto? permissions;
    private ModulePermissionDto Perms => permissions!;

    // Lookups
    private List<ProductionLookupDto> bomLookup = new();
    private List<ProductionLookupDto> unitLookup = new();
    private List<ProductionLookupDto> warehouseLookup = new();
    private List<ProductionLookupDto> targetWarehouseLookup = new();
    private List<ProductionLookupDto> employeeLookup = new();

    // BOM Info
    private dynamic? bomInfo;
    private string bomProductName = "";
    private decimal bomBatchSize;
    private string bomBatchUnitName = "";
    private decimal bomOutputQty;
    private string bomOutputUnitName = "";

    // UI States
    private bool isLoading = true;
    private bool isSaving = false;
    private bool materialsLoading = false;
    private bool isViewMode = false;
    private string activeTab = "main";

    // Validation
    private Dictionary<string, string> validationErrors = new();

    // Message
    private string? resultMessage;
    private bool isSuccess;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_PRODORD");

        if (Perms == null || !Perms.CanView)
        {
            isLoading = false;
            return;
        }

        try
        {
            // تحميل اللوكابس
            await LoadLookups();

            if (Id > 0)
            {
                // تعديل / عرض
                var existing = await OrderService.GetOrderByIdAsync(Id);
                if (existing == null)
                {
                    NavigationManager.NavigateTo("/production-orders");
                    return;
                }

                order = existing;

                // هل هو View Mode ؟
                isViewMode = order.OrderStatus != 1 || !Perms.CanEdit;

                // تحميل معلومات الوصفة
                if (order.BOMID > 0)
                    await LoadBOMInfo(order.BOMID);

                // تحميل المواد
                await LoadMaterials();
            }
            else
            {
                // إضافة جديد
                if (!Perms.CanAdd)
                {
                    NavigationManager.NavigateTo("/production-orders");
                    return;
                }

                order = new ProductionOrderEditDto
                {
                    OrderDate = DateTime.Today,
                    OrderPriority = 2,
                    NumberOfBatches = 1
                };
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLookups()
    {
        bomLookup = await OrderService.GetActiveBOMsLookupAsync();
        unitLookup = await OrderService.GetUnitsLookupAsync();
        warehouseLookup = await OrderService.GetWarehousesLookupAsync(1); // مخازن الخام
        targetWarehouseLookup = await OrderService.GetWarehousesLookupAsync(4); // مخازن التام
        employeeLookup = await OrderService.GetEmployeesLookupAsync();
    }

    private async Task LoadMaterials()
    {
        if (Id <= 0) return;
        materialsLoading = true;
        try
        {
            materials = await OrderService.GetOrderMaterialsAsync(Id);
        }
        finally
        {
            materialsLoading = false;
        }
    }

    private async Task OnBOMChanged()
    {
        if (order.BOMID > 0)
        {
            await LoadBOMInfo(order.BOMID);

            // تعيين المنتج والوحدة تلقائياً
            if (bomInfo != null)
            {
                order.ProductItemID = (int)bomInfo.ProductItemID;
                order.PlannedUnitID = (int)bomInfo.OutputUnitID;
            }

            CalcBatches();
        }
        else
        {
            bomInfo = null;
            bomProductName = "";
            bomBatchSize = 0;
            bomBatchUnitName = "";
            bomOutputQty = 0;
            bomOutputUnitName = "";
        }
    }

    private async Task LoadBOMInfo(int bomId)
    {
        bomInfo = await OrderService.GetBOMInfoAsync(bomId);
        if (bomInfo != null)
        {
            bomProductName = $"{bomInfo.ProductCode} - {bomInfo.ProductName}";
            bomBatchSize = (decimal)bomInfo.BatchSize;
            bomBatchUnitName = (string)bomInfo.BatchUnitName;
            bomOutputQty = (decimal)bomInfo.OutputQty;
            bomOutputUnitName = (string)bomInfo.OutputUnitName;
        }
    }

    private void CalcBatches()
    {
        if (bomBatchSize > 0 && order.PlannedQty > 0)
        {
            order.NumberOfBatches = (int)Math.Ceiling((double)(order.PlannedQty / bomBatchSize));
        }
    }

    // ===== حفظ =====
    private async Task SaveOrder()
    {
        if (!Validate()) return;

        isSaving = true;
        try
        {
            if (Id == 0)
            {
                var newId = await OrderService.InsertOrderAsync(order, UserSession.UserID);
                isSuccess = true;
                resultMessage = "تم إنشاء أمر التصنيع بنجاح";
                NavigationManager.NavigateTo($"/production-orders/edit/{newId}");
            }
            else
            {
                await OrderService.UpdateOrderAsync(order, UserSession.UserID);
                isSuccess = true;
                resultMessage = "تم حفظ التعديلات بنجاح";
                await LoadMaterials();
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            resultMessage = $"خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            _ = ClearMessage();
        }
    }

    private bool Validate()
    {
        validationErrors.Clear();

        if (order.BOMID <= 0)
            validationErrors["BOMID"] = "يجب اختيار الوصفة";
        if (order.PlannedQty <= 0)
            validationErrors["PlannedQty"] = "الكمية المخططة يجب أن تكون أكبر من صفر";
        if (order.PlannedUnitID <= 0)
            validationErrors["PlannedUnitID"] = "يجب اختيار الوحدة";

        return !validationErrors.Any();
    }

    // ===== تغيير الحالة =====
    private async Task ApproveOrder()
    {
        await ChangeStatus(2);
    }

    private async Task ChangeStatus(int newStatus)
    {
        isSaving = true;
        try
        {
            var result = await OrderService.ChangeStatusAsync(
                Id, newStatus, UserSession.UserID);

            isSuccess = result.Success;
            resultMessage = result.Message;

            if (result.Success)
            {
                // إعادة تحميل البيانات
                var updated = await OrderService.GetOrderByIdAsync(Id);
                if (updated != null)
                {
                    order = updated;
                    isViewMode = order.OrderStatus != 1 || !Perms.CanEdit;
                }
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            resultMessage = $"خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            _ = ClearMessage();
        }
    }

    // ===== Audit Tab =====
    private async Task LoadAuditTab()
    {
        activeTab = "audit";
        if (auditInfo == null && Id > 0)
        {
            auditInfo = await OrderService.GetOrderAuditAsync(Id);
        }
    }

    // ===== Navigation =====
    private void GoBack()
    {
        NavigationManager.NavigateTo("/production-orders");
    }

    // ===== Message =====
    private async Task ClearMessage()
    {
        await Task.Delay(4000);
        resultMessage = null;
        StateHasChanged();
    }

    // ===== Helpers =====
    private string GetStatusClass(int status) => status switch
    {
        1 => "s-draft", 2 => "s-approved", 3 => "s-preparing",
        4 => "s-inprogress", 5 => "s-qc", 6 => "s-completed",
        7 => "s-cancelled", _ => "s-draft"
    };

    private string GetStatusName(int status) => status switch
    {
        1 => "مسودة", 2 => "معتمد", 3 => "جاري التجهيز",
        4 => "قيد التصنيع", 5 => "فحص الجودة",
        6 => "مكتمل", 7 => "ملغي", _ => "—"
    };
}