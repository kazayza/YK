@code {
    [Parameter] public int Id { get; set; }

    private MaterialIssueEditDto header = new();
    private List<PendingMaterialDto> pendingMaterials = new();
    private List<MaterialIssueDetailDto> savedDetails = new();
    private Dictionary<int, decimal> issueQuantities = new();
    private ModulePermissionDto? permissions;
    private ModulePermissionDto Perms => permissions!;

    private List<ProductionLookupDto> orderLookup = new();
    private List<ProductionLookupDto> warehouseLookup = new();
    private List<ProductionLookupDto> employeeLookup = new();

    private bool isLoading = true;
    private bool isSaving = false;
    private bool materialsLoading = false;
    private bool isViewMode = false;

    private Dictionary<string, string> errors = new();
    private string? resultMessage;
    private bool isSuccess;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { NavigationManager.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_MATISS");
        if (permissions is null || !Perms.CanView) { isLoading = false; return; }

        try
        {
            orderLookup = await IssueService.GetProductionOrdersForIssueAsync();
            warehouseLookup = await IssueService.GetWarehousesLookupAsync();
            employeeLookup = await IssueService.GetEmployeesLookupAsync();

            if (Id > 0)
{
    var existing = await IssueService.GetByIdAsync(Id);
    if (existing == null) { NavigationManager.NavigateTo("/material-issues"); return; }

    header = existing;
    isViewMode = header.IssueStatus != 1 || !Perms.CanEdit;
    savedDetails = await IssueService.GetDetailsAsync(Id);

    if (header.IssueStatus == 1)
    {
        await LoadPendingMaterials(header.ProductionOrderID);
        ApplySavedDetailsToInputs();
    }
}
            else
            {
                if (!Perms.CanAdd) { NavigationManager.NavigateTo("/material-issues"); return; }
                header = new MaterialIssueEditDto { IssueDate = DateTime.Today };
            }
        }
        finally { isLoading = false; }
    }

    private async Task OnOrderChanged()
{
    if (header.ProductionOrderID > 0)
    {
        header.IssueType = await IssueService.GetSuggestedIssueTypeAsync(header.ProductionOrderID, Id);
        await LoadPendingMaterials(header.ProductionOrderID);
    }
    else
    {
        header.IssueType = 1;
        pendingMaterials = new();
        issueQuantities = new();
    }
}

    private async Task LoadPendingMaterials(int orderId)
    {
        materialsLoading = true;
        try
        {
            pendingMaterials = await IssueService.GetPendingMaterialsAsync(orderId);
            issueQuantities = new();
            foreach (var m in pendingMaterials)
            {
                issueQuantities[m.POMaterialID] = 0;
            }
        }
        finally { materialsLoading = false; }
    }
    private void ApplySavedDetailsToInputs()
{
    if (!savedDetails.Any() || !pendingMaterials.Any())
        return;

    foreach (var d in savedDetails.Where(x => x.POMaterialID.HasValue))
    {
        var poMaterialId = d.POMaterialID!.Value;
        issueQuantities[poMaterialId] = d.IssueQty;
    }
}

    private decimal GetIssueQty(int poMaterialId)
    {
        return issueQuantities.TryGetValue(poMaterialId, out var qty) ? qty : 0;
    }

    private void SetIssueQty(int poMaterialId, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var val) && val >= 0)
        {
            var mat = pendingMaterials.FirstOrDefault(m => m.POMaterialID == poMaterialId);
            if (mat != null && val > mat.RemainingQty)
                val = mat.RemainingQty;
            issueQuantities[poMaterialId] = val;
        }
        else
        {
            issueQuantities[poMaterialId] = 0;
        }
    }

    private void FillAll()
    {
        foreach (var m in pendingMaterials)
        {
            issueQuantities[m.POMaterialID] = m.RemainingQty;
        }
    }

    private async Task SaveIssue()
{
    if (!Validate()) return;

    isSaving = true;
    try
    {
        var details = pendingMaterials
            .Where(m => GetIssueQty(m.POMaterialID) > 0)
            .Select(m => new MaterialIssueDetailDto
            {
                ItemID = m.ItemID,
                UnitID = m.UnitID,
                MaterialType = m.MaterialType,
                RequiredQty = m.RequiredQty,
                IssuedQty = m.AlreadyIssuedQty,
                IssueQty = GetIssueQty(m.POMaterialID),
                UnitCost = m.UnitCost,
                POMaterialID = m.POMaterialID
            }).ToList();

        if (Id == 0)
        {
            var newId = await IssueService.InsertAsync(header, details, UserSession.UserID);
            isSuccess = true;
            resultMessage = "تم حفظ إذن الصرف بنجاح";
            NavigationManager.NavigateTo($"/material-issues/edit/{newId}");
        }
        else
        {
            await IssueService.UpdateAsync(header, details, UserSession.UserID);
            isSuccess = true;
            resultMessage = "تم حفظ التعديلات بنجاح";

            savedDetails = await IssueService.GetDetailsAsync(Id);
            await LoadPendingMaterials(header.ProductionOrderID);
            ApplySavedDetailsToInputs();
        }
    }
    catch (Exception ex)
    {
        isSuccess = false;
        resultMessage = $"خطأ: {ex.Message}";
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}

    private async Task ApproveAndSave()
    {
        if (Id <= 0) return;
        isSaving = true;
        try
        {
            var result = await IssueService.ApproveAsync(Id, UserSession.UserID);
            isSuccess = result.Success;
            resultMessage = result.Message;
            if (result.Success)
            {
                var updated = await IssueService.GetByIdAsync(Id);
                if (updated != null) header = updated;
                savedDetails = await IssueService.GetDetailsAsync(Id);
                isViewMode = true;
                pendingMaterials = new();
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            resultMessage = $"خطأ: {ex.Message}";
        }
        finally { isSaving = false; _ = ClearMessage(); }
    }

    private bool Validate()
    {
        errors.Clear();
        if (header.ProductionOrderID <= 0) errors["ProductionOrderID"] = "يجب اختيار أمر التصنيع";
        if (header.SourceWarehouseID <= 0) errors["SourceWarehouseID"] = "يجب اختيار المخزن";
        return !errors.Any();
    }

    private void GoBack() => NavigationManager.NavigateTo("/material-issues");

    private async Task ClearMessage() { await Task.Delay(4000); resultMessage = null; StateHasChanged(); }

    private string GetStatusClass(int s) => s switch { 1 => "s-draft", 2 => "s-issued", 3 => "s-cancelled", _ => "s-draft" };
    private string GetStatusName(int s) => s switch { 1 => "مسودة", 2 => "تم الصرف", 3 => "ملغي", _ => "—" };
}