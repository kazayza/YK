@page "/payroll"

@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PayrollService PayrollService
@inject NavigationManager Navigation

<PageTitle>مسير المرتبات - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card"><div class="no-access-icon">🔒</div><h4>يجب تسجيل الدخول أولاً</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access-card"><div class="no-access-icon">⛔</div><h4>ليس لديك صلاحية</h4></div>
}
else
{
    <div class="items-page" dir="rtl">
        <div class="page-header">
            <div>
                <h2 class="page-title">مسير المرتبات</h2>
                <p class="page-subtitle">إدارة مسيرات المرتبات الشهرية وربطها بالفترات المحاسبية</p>
            </div>
            <div class="header-actions">
                <span class="result-badge">@pagedResult.TotalCount مسير</span>
                @if (permissions.CanAdd)
                {
                    <button class="btn-modern btn-primary-modern" @onclick="ShowCreateDialog">
                        <span class="btn-icon">+</span>
                        <span>إنشاء مسير</span>
                    </button>
                }
            </div>
        </div>

        <div class="filter-card">
            <div class="filter-grid">
                <div>
                    <label class="filter-label">الحالة</label>
                    <select class="filter-select" @bind="filters.PayrollStatus">
                        <option value="0">الكل</option>
                        <option value="1">مسودة</option>
                        <option value="2">محسوب</option>
                        <option value="3">معتمد</option>
                        <option value="4">مدفوع</option>
                        <option value="5">ملغي</option>
                    </select>
                </div>
                <div>
                    <label class="filter-label">من تاريخ</label>
                    <input type="date" class="filter-select" @bind="filters.DateFrom" />
                </div>
                <div>
                    <label class="filter-label">إلى تاريخ</label>
                    <input type="date" class="filter-select" @bind="filters.DateTo" />
                </div>
            </div>
            <div class="filter-actions">
                <button class="btn-modern btn-primary-modern" @onclick="SearchData" disabled="@isLoading">بحث</button>
                <button class="btn-modern btn-ghost" @onclick="ClearFilters" disabled="@isLoading">مسح</button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-state"><div class="loader"></div><p>جاري التحميل...</p></div>
        }
        else if (!pagedResult.Items.Any())
        {
            <div class="empty-state"><div class="empty-icon">💰</div><h4>لا توجد مسيرات</h4></div>
        }
        else
        {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th class="th-num">#</th>
                                <th>رقم المسير</th>
                                <th>الشهر</th>
                                <th>الفترة المحاسبية</th>
                                <th>العنوان</th>
                                <th class="th-center">عدد الموظفين</th>
                                <th class="th-number">إجمالي الاستحقاقات</th>
                                <th class="th-number">إجمالي الخصومات</th>
                                <th class="th-number">صافي المرتبات</th>
                                <th>آخر حساب بواسطة</th>
                                <th>الحالة</th>
                                <th class="th-actions">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rowIdx = (filters.PageNumber - 1) * filters.PageSize;
                            }
                            @foreach (var p in pagedResult.Items)
                            {
                                rowIdx++;
                                <tr>
                                    <td class="td-num">@rowIdx</td>
                                    <td><code class="item-code">@p.PayrollNumber</code></td>
                                    <td>@p.PayrollMonth.ToString("MM/yyyy")</td>
                                    <td>@(p.PeriodName ?? $"#{p.PeriodID}")</td>
                                    <td>@(p.PayrollTitle ?? "—")</td>
                                    <td class="td-center">@p.EmployeeCount</td>
                                    <td class="td-number">@p.TotalGrossEarnings.ToString("#,##0.00")</td>
                                    <td class="td-number">@p.TotalDeductions.ToString("#,##0.00")</td>
                                    <td class="td-number net">@p.TotalNetSalary.ToString("#,##0.00")</td>
                                    <td>@(string.IsNullOrWhiteSpace(p.CalculatedByName) ? "—" : p.CalculatedByName)</td>
                                    <td><span class="status-badge status-@p.PayrollStatus">@p.PayrollStatusName</span></td>
                                    <td class="td-actions">
                                        <div class="actions-wrap">
                                            <button class="action-btn view-btn" @onclick="() => GoToDetails(p.PayrollID)">التفاصيل</button>

                                            @if (p.PayrollStatus == 1 && permissions.CanEdit)
                                            {
                                                <button class="action-btn calc-btn" @onclick='() => OpenActionDialog(p, "calculate")'>حساب</button>
                                            }

                                            @if (p.PayrollStatus == 2 && permissions.CanEdit)
                                            {
                                                <button class="action-btn approve-btn" @onclick='() => OpenActionDialog(p, "approve")'>اعتماد</button>
                                            }

                                            @if (p.PayrollStatus == 3 && permissions.CanEdit)
                                            {
                                                <button class="action-btn pay-btn" @onclick='() => OpenActionDialog(p, "pay")'>دفع</button>
                                            }

                                            @if ((p.PayrollStatus == 1 || p.PayrollStatus == 2) && permissions.CanEdit)
                                            {
                                                <button class="action-btn cancel-btn" @onclick='() => OpenActionDialog(p, "cancel")'>إلغاء</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pagination-bar">
                    <div class="pagination-info">الصفحة @pagedResult.PageNumber من @Math.Max(pagedResult.TotalPages, 1)</div>
                    <div class="pagination-actions">
                        <button class="btn-modern btn-ghost" @onclick="PreviousPage" disabled="@(!pagedResult.HasPrevious)">السابق</button>
                        <button class="btn-modern btn-ghost" @onclick="NextPage" disabled="@(!pagedResult.HasNext)">التالي</button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (showCreateDialog)
    {
        <div class="modal-overlay" @onclick="CloseCreateDialog">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-icon create-modal-icon">💰</div>
                <h4>إنشاء مسير مرتبات</h4>

                <div class="form-grid cols-1" style="margin-top:16px">
                    <div class="form-field">
                        <label class="field-label required-field">شهر المرتبات</label>
                        <input type="date" class="field-input" @bind="newPayrollMonth" />
                    </div>
                    <div class="form-field">
                        <label class="field-label">عنوان (اختياري)</label>
                        <input type="text" class="field-input" @bind="newPayrollTitle" placeholder="مثال: مرتبات أبريل 2026" />
                    </div>
                    <div class="help-text">سيتم تحديد الفترة المحاسبية المفتوحة لهذا الشهر تلقائيًا.</div>
                </div>

                @if (!string.IsNullOrEmpty(dialogMessage))
                {
                    <div class="form-message msg-error">@dialogMessage</div>
                }

                <div class="modal-buttons-row center-buttons">
                    <button class="btn-modern btn-primary-modern" @onclick="CreatePayroll" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <div class="btn-spinner-sm"></div><span>جاري...</span>
                        }
                        else
                        {
                            <span>إنشاء</span>
                        }
                    </button>
                    <button class="btn-modern btn-ghost" @onclick="CloseCreateDialog" disabled="@isProcessing">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (showActionDialog && selectedPayroll != null)
    {
        <div class="modal-overlay" @onclick="CloseActionDialog">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-icon @GetActionIconClass()">@GetActionIcon()</div>
                <h4>@GetActionTitle()</h4>
                <p class="confirm-msg">@GetActionMessage()</p>

                @if (!string.IsNullOrEmpty(actionError))
                {
                    <div class="form-message msg-error">@actionError</div>
                }

                <div class="modal-buttons-row center-buttons">
                    <button class="btn-modern @GetActionButtonClass()" @onclick="ExecuteAction" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <div class="btn-spinner-sm"></div><span>جاري...</span>
                        }
                        else
                        {
                            <span>@GetActionButtonText()</span>
                        }
                    </button>
                    <button class="btn-modern btn-ghost" @onclick="CloseActionDialog" disabled="@isProcessing">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <div class="toast-container">
            <div class="toast-card @(resultSuccess ? "toast-success" : "toast-error")">
                <span class="toast-text">@resultMessage</span>
                <button class="toast-close" @onclick='() => resultMessage = ""'>✕</button>
            </div>
        </div>
    }
}

<style>
    .items-page{display:flex;flex-direction:column;gap:20px}
    .page-header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px}
    .page-title{font-weight:800;color:#1f2937;margin:0}
    .page-subtitle{color:#6b7280;font-size:.9rem;margin:4px 0 0}
    .header-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .result-badge{background:#f3f4f6;color:#4b5563;padding:8px 16px;border-radius:999px;font-size:.82rem;font-weight:700}
    .filter-card{background:#fff;border-radius:20px;padding:18px;border:1px solid #eef2f7;box-shadow:0 4px 16px rgba(15,23,42,.04)}
    .filter-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px}
    .filter-label{display:block;font-size:.8rem;color:#6b7280;font-weight:700;margin-bottom:6px}
    .filter-select{width:100%;padding:12px 14px;border:1.5px solid #e5e7eb;border-radius:14px;font-size:.88rem;background:#fff;outline:none}
    .filter-actions{display:flex;gap:10px;margin-top:16px}
    .table-card{background:#fff;border-radius:20px;overflow:hidden;border:1px solid #eef2f7;box-shadow:0 4px 16px rgba(15,23,42,.04)}
    .table-responsive{overflow-x:auto}
    .data-table{width:100%;border-collapse:collapse;min-width:1450px}
    .data-table thead{background:#f8f9fc}
    .data-table th{padding:14px 12px;font-size:.8rem;font-weight:700;color:#6b7280;text-align:right;border-bottom:2px solid #eef2f7;white-space:nowrap}
    .data-table td{padding:12px 12px;font-size:.86rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}
    .data-table tbody tr:hover{background:#f8f7ff}
    .th-num{width:50px;text-align:center}
    .th-center{text-align:center}
    .th-number{text-align:left}
    .th-actions{width:260px;text-align:center}
    .td-num{text-align:center;color:#9ca3af}
    .td-center{text-align:center}
    .td-number{text-align:left;font-family:monospace;font-weight:700}
    .td-number.net{color:#059669;font-size:.92rem}
    .td-actions{text-align:center}
    .actions-wrap{display:flex;gap:6px;justify-content:center;flex-wrap:wrap}
    .item-code{background:#f3f4f6;padding:4px 10px;border-radius:8px;font-size:.82rem;color:#1d4ed8;font-weight:600}
    .status-badge{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.76rem;font-weight:800}
    .status-1{background:#fef3c7;color:#d97706}
    .status-2{background:#dbeafe;color:#2563eb}
    .status-3{background:#ecfdf5;color:#059669}
    .status-4{background:#dcfce7;color:#15803d}
    .status-5{background:#f3f4f6;color:#6b7280}
    .action-btn{display:inline-flex;align-items:center;justify-content:center;padding:6px 10px;border-radius:10px;border:1.5px solid;background:transparent;font-size:.76rem;font-weight:700;cursor:pointer;min-width:50px}
    .view-btn{color:#2563eb;border-color:#dbeafe}.view-btn:hover{background:#eff6ff}
    .calc-btn{color:#1d4ed8;border-color:#e9e0ff}.calc-btn:hover{background:#f5f3ff}
    .approve-btn{color:#059669;border-color:#d1fae5}.approve-btn:hover{background:#ecfdf5}
    .pay-btn{color:#0f766e;border-color:#99f6e4}.pay-btn:hover{background:#f0fdfa}
    .cancel-btn{color:#6b7280;border-color:#e5e7eb}.cancel-btn:hover{background:#f3f4f6}
    .btn-modern{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 18px;border-radius:14px;border:none;font-weight:700;font-size:.88rem;cursor:pointer;transition:.2s}
    .btn-modern:disabled{opacity:.6;cursor:not-allowed}
    .btn-primary-modern{background:linear-gradient(135deg,#1d4ed8,#2563eb);color:#fff}
    .btn-ghost{background:transparent;color:#6b7280;border:1.5px solid #e5e7eb}
    .btn-approve{background:linear-gradient(135deg,#059669,#10b981);color:#fff}
    .btn-pay{background:linear-gradient(135deg,#0f766e,#14b8a6);color:#fff}
    .btn-reject{background:linear-gradient(135deg,#6b7280,#9ca3af);color:#fff}
    .btn-icon{font-size:1.1rem;font-weight:800}
    .btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}
    .pagination-bar{display:flex;justify-content:space-between;align-items:center;padding:16px;flex-wrap:wrap;gap:12px}
    .pagination-info{color:#6b7280;font-size:.86rem;font-weight:600}
    .pagination-actions{display:flex;gap:10px}
    .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:1000;padding:20px}
    .modal-card{background:#fff;border-radius:24px;padding:30px;max-width:500px;width:92%;text-align:center;box-shadow:0 24px 48px rgba(0,0,0,.15)}
    .modal-icon{width:64px;height:64px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;font-size:1.8rem}
    .create-modal-icon{background:#f5f3ff;color:#1d4ed8}
    .icon-calc{background:#f5f3ff;color:#1d4ed8}
    .icon-approve{background:#ecfdf5;color:#059669}
    .icon-pay{background:#f0fdfa;color:#0f766e}
    .icon-cancel{background:#f3f4f6;color:#6b7280}
    .center-buttons{justify-content:center}
    .modal-buttons-row{display:flex;gap:10px;margin-top:20px;flex-wrap:wrap}
    .cols-1{grid-template-columns:1fr}
    .form-grid{display:grid;gap:14px}
    .form-field{display:flex;flex-direction:column;gap:6px;text-align:right}
    .field-label{font-size:.82rem;font-weight:700;color:#374151}
    .required-field::after{content:" *";color:#ef4444}
    .field-input{width:100%;padding:11px 14px;border:1.5px solid #e5e7eb;border-radius:12px;background:#fff;font-size:.9rem;outline:none}
    .help-text{font-size:.8rem;color:#6b7280;text-align:right}
    .confirm-msg{color:#6b7280;font-size:.92rem;line-height:1.8;margin:8px 0 0}
    .form-message{padding:10px 14px;border-radius:12px;font-size:.85rem;font-weight:600;margin-top:12px}
    .msg-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
    .loading-state{text-align:center;padding:60px 20px;color:#6b7280}
    .loader{width:40px;height:40px;border:3px solid #e5e7eb;border-top-color:#1d4ed8;border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 16px}
    .empty-state{text-align:center;padding:60px 20px;background:#fff;border-radius:20px;border:1px solid #eef2f7}
    .empty-icon{font-size:3rem;margin-bottom:16px}
    .no-access-card{text-align:center;padding:80px 20px;background:#fff;border-radius:24px;border:1px solid #eef2f7}
    .no-access-icon{font-size:3.5rem;margin-bottom:16px}
    .toast-container{position:fixed;bottom:24px;left:24px;z-index:1050;animation:toastIn .4s ease}
    .toast-card{display:flex;align-items:center;gap:12px;padding:14px 20px;border-radius:16px;box-shadow:0 12px 32px rgba(0,0,0,.12);min-width:320px}
    .toast-success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}
    .toast-error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
    .toast-text{flex:1;font-weight:600;font-size:.88rem}
    .toast-close{background:transparent;border:none;font-size:1rem;cursor:pointer;color:inherit;opacity:.6}
    @@keyframes spin{to{transform:rotate(360deg)}}
    @@keyframes toastIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
    @@media(max-width:768px){
        .page-header{flex-direction:column}
        .btn-modern{width:100%}
        .pagination-bar{flex-direction:column}
        .modal-buttons-row{flex-direction:column}
    }
</style>

@code {
    private ModulePermissionDto? permissions;
    private PayrollFilterDto filters = new() { PageNumber = 1, PageSize = 20 };
    private PayrollPagedResult pagedResult = new() { Items = new List<PayrollRunListDto>() };

    private bool isLoading = true;
    private bool isProcessing = false;

    private bool showCreateDialog = false;
    private bool showActionDialog = false;

    private DateTime newPayrollMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string newPayrollTitle = "";
    private string dialogMessage = "";

    private PayrollRunListDto? selectedPayroll;
    private string pendingAction = "";
    private string actionError = "";

    private string resultMessage = "";
    private bool resultSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_PAYROLL");

        if (permissions == null || !permissions.CanView)
        {
            isLoading = false;
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            pagedResult = await PayrollService.GetPayrollsPagedAsync(filters);
        }
        catch (Exception ex)
        {
            resultMessage = "خطأ: " + ex.Message;
            resultSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SearchData()
    {
        filters.PageNumber = 1;
        await LoadData();
    }

    private async Task ClearFilters()
    {
        filters = new() { PageNumber = 1, PageSize = 20 };
        await LoadData();
    }

    private async Task PreviousPage()
    {
        if (pagedResult.HasPrevious)
        {
            filters.PageNumber--;
            await LoadData();
        }
    }

    private async Task NextPage()
    {
        if (pagedResult.HasNext)
        {
            filters.PageNumber++;
            await LoadData();
        }
    }

    private void GoToDetails(int id) => Navigation.NavigateTo($"/payroll/details/{id}");

    private void ShowCreateDialog()
    {
        newPayrollMonth = new(DateTime.Today.Year, DateTime.Today.Month, 1);
        newPayrollTitle = "";
        dialogMessage = "";
        showCreateDialog = true;
    }

    private void CloseCreateDialog()
    {
        if (isProcessing) return;
        showCreateDialog = false;
        dialogMessage = "";
    }

    private async Task CreatePayroll()
    {
        if (newPayrollMonth == default)
        {
            dialogMessage = "حدد الشهر";
            return;
        }

        isProcessing = true;
        dialogMessage = "";

        try
        {
            var item = new PayrollRunEditDto
            {
                PayrollMonth = new DateTime(newPayrollMonth.Year, newPayrollMonth.Month, 1),
                PayrollTitle = newPayrollTitle
            };

            await PayrollService.CreatePayrollAsync(item, UserSession.UserID);

            showCreateDialog = false;
            resultMessage = "تم إنشاء المسير بنجاح ✅";
            resultSuccess = true;

            await LoadData();
        }
        catch (Exception ex)
        {
            dialogMessage = "خطأ: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void OpenActionDialog(PayrollRunListDto payroll, string action)
    {
        selectedPayroll = payroll;
        pendingAction = action;
        actionError = "";
        showActionDialog = true;
    }

    private void CloseActionDialog()
    {
        if (isProcessing) return;
        showActionDialog = false;
        selectedPayroll = null;
        pendingAction = "";
        actionError = "";
    }

    private async Task ExecuteAction()
    {
        if (selectedPayroll == null || string.IsNullOrWhiteSpace(pendingAction))
            return;

        isProcessing = true;
        actionError = "";

        try
        {
            switch (pendingAction)
            {
                case "calculate":
                    await PayrollService.CalculatePayrollAsync(selectedPayroll.PayrollID, UserSession.UserID);
                    resultMessage = "تم حساب المرتبات وإرسال إشعار للاعتماد ✅";
                    break;

                case "approve":
                    await PayrollService.ApprovePayrollAsync(selectedPayroll.PayrollID, UserSession.UserID);
                    resultMessage = "تم اعتماد المسير ✅";
                    break;

                case "pay":
                    await PayrollService.PayPayrollAsync(selectedPayroll.PayrollID, UserSession.UserID);
                    resultMessage = "تم دفع المسير وإنشاء القيد المحاسبي ✅";
                    break;

                case "cancel":
                    await PayrollService.CancelPayrollAsync(selectedPayroll.PayrollID, UserSession.UserID);
                    resultMessage = "تم إلغاء المسير";
                    break;
            }

            resultSuccess = true;
            showActionDialog = false;
            selectedPayroll = null;
            pendingAction = "";

            await LoadData();
        }
        catch (Exception ex)
        {
            actionError = "خطأ: " + ex.Message;
            resultSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private string GetActionTitle() => pendingAction switch
    {
        "calculate" => "تأكيد حساب المرتبات",
        "approve" => "تأكيد اعتماد المسير",
        "pay" => "تأكيد دفع المسير",
        "cancel" => "تأكيد إلغاء المسير",
        _ => "تأكيد العملية"
    };

    private string GetActionMessage()
    {
        if (selectedPayroll == null) return "";

        return pendingAction switch
        {
            "calculate" => $"سيتم حساب المسير {selectedPayroll.PayrollNumber} لشهر {selectedPayroll.PayrollMonth:MM/yyyy} وإرسال إشعار للمدير العام.",
