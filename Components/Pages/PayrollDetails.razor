    private void OpenEditDialog(PayrollDetailDto detail)
    {
        editError = "";
        editModel = new PayrollDetailEditDto
        {
            PayrollDetailID = detail.PayrollDetailID,
            PayrollID = detail.PayrollID,
            EmployeeID = detail.EmployeeID,
            EmployeeCode = detail.EmployeeCode,
            EmployeeName = detail.EmployeeName,
            Incentives = detail.Incentives,
            Commissions = detail.Commissions,
            Rewards = detail.Rewards,
            OtherEarnings = detail.OtherEarnings,
            OtherDeductions = detail.OtherDeductions,
            Notes = detail.Notes
        };
        showEditDialog = true;
    }

    private void CloseEditDialog()
    {
        if (isSavingEdit) return;
        showEditDialog = false;
        editModel = null;
        editError = "";
    }

    private async Task SaveEdit()
    {
        if (editModel == null) return;

        isSavingEdit = true;
        editError = "";

        try
        {
            await PayrollService.UpdatePayrollDetailManualAsync(editModel, UserSession.UserID);
            showEditDialog = false;
            editModel = null;

            resultMessage = "تم حفظ التعديل اليدوي ✅";
            resultSuccess = true;

            await LoadData();
        }
        catch (Exception ex)
        {
            editError = "خطأ: " + ex.Message;
        }
        finally
        {
            isSavingEdit = false;
        }
    }
}