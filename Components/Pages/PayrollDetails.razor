@page "/payroll/details/{PayrollId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PayrollService PayrollService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>تفاصيل المسير - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card"><div class="no-access-icon">🔒</div><h4>يجب تسجيل الدخول أولاً</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access-card"><div class="no-access-icon">⛔</div><h4>ليس لديك صلاحية</h4></div>
}
else if (isLoading)
{
    <div class="loading-state"><div class="loader"></div><p>جاري التحميل...</p></div>
}
else if (payroll == null)
{
    <div class="no-access-card">
        <div class="no-access-icon">❌</div>
        <h4>المسير غير موجود</h4>
        <button class="btn-modern btn-ghost" @onclick='() => Navigation.NavigateTo("/payroll")'>العودة</button>
    </div>
}
else
{
    <div class="items-page" dir="rtl">
        <div class="page-header">
            <div>
                <div class="breadcrumb-line">
                    <span class="crumb-link" @onclick='() => Navigation.NavigateTo("/payroll")'>مسير المرتبات</span>
                    <span class="crumb-sep">/</span>
                    <span class="crumb-current">@payroll.PayrollNumber</span>
                </div>
                <h2 class="page-title">@payroll.PayrollNumber — @payroll.PayrollMonth.ToString("MM/yyyy")</h2>
                <div class="sub-info-line">
                    <span class="mini-chip">الفترة: @(payroll.PeriodName ?? $"#{payroll.PeriodID}")</span>
                    <span class="mini-chip">العنوان: @(string.IsNullOrWhiteSpace(payroll.PayrollTitle) ? "—" : payroll.PayrollTitle)</span>
                </div>
            </div>

            <div class="header-actions">
                <span class="status-badge status-@payroll.PayrollStatus">@payroll.PayrollStatusName</span>

                @if (permissions.CanEdit && payroll.PayrollStatus == 1)
                {
                    <button class="btn-modern btn-primary-modern" @onclick='() => OpenActionDialog("calculate")'>حساب</button>
                }

                @if (permissions.CanEdit && payroll.PayrollStatus == 2)
                {
                    <button class="btn-modern btn-approve" @onclick='() => OpenActionDialog("approve")'>اعتماد</button>
                }

                @if (permissions.CanEdit && payroll.PayrollStatus == 3)
                {
                    <button class="btn-modern btn-pay" @onclick='() => OpenActionDialog("pay")'>دفع</button>
                }

                <button class="btn-modern btn-export" @onclick="ExportData" disabled="@isExporting">
                    @if (isExporting)
                    {
                        <div class="btn-spinner-sm"></div><span>جاري...</span>
                    }
                    else
                    {
                        <span>تصدير Excel</span>
                    }
                </button>

                <button class="btn-modern btn-ghost" @onclick='() => Navigation.NavigateTo("/payroll")'>رجوع</button>
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-card stat-purple">
                <div class="stat-value">@payroll.EmployeeCount</div>
                <div class="stat-label">موظف</div>
            </div>
            <div class="stat-card stat-blue">
                <div class="stat-value">@payroll.TotalGrossEarnings.ToString("#,##0.00")</div>
                <div class="stat-label">إجمالي الاستحقاقات</div>
            </div>
            <div class="stat-card stat-red">
                <div class="stat-value">@payroll.TotalDeductions.ToString("#,##0.00")</div>
                <div class="stat-label">إجمالي الخصومات</div>
            </div>
            <div class="stat-card stat-green">
                <div class="stat-value">@payroll.TotalNetSalary.ToString("#,##0.00")</div>
                <div class="stat-label">صافي المرتبات</div>
            </div>
        </div>

        @if (!details.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">📋</div>
                <h4>لا توجد تفاصيل</h4>
                <p style="color:#9ca3af;font-size:.88rem">قم بحساب المسير أولاً</p>
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th class="th-num">#</th>
                                <th>الكود</th>
                                <th>الموظف</th>
                                <th>القسم</th>
                                <th>الوظيفة</th>
                                <th class="th-center">حضور</th>
                                <th class="th-number">الأساسي</th>
                                <th class="th-number">البدلات</th>
                                <th class="th-number">حوافز</th>
                                <th class="th-number">عمولات</th>
                                <th class="th-number">مكافآت</th>
                                <th class="th-number">استحقاقات أخرى</th>
                                <th class="th-number">إجمالي استحقاق</th>
                                <th class="th-number">تأمينات</th>
                                <th class="th-number">ضرائب</th>
                                <th class="th-number">سلف</th>
                                <th class="th-number">جزاءات</th>
                                <th class="th-number">غياب</th>
                                <th class="th-number">أخرى/تأخير</th>
                                <th class="th-number">إجمالي خصومات</th>
                                <th class="th-number">صافي المرتب</th>
                                <th class="th-actions">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in details.Select((x, i) => new { x, Index = i + 1 }))
                            {
                                <tr>
                                    <td class="td-num">@row.Index</td>
                                    <td><code class="item-code">@row.x.EmployeeCode</code></td>
                                    <td class="item-name">@row.x.EmployeeName</td>
                                    <td>@(row.x.DepartmentName ?? "—")</td>
                                    <td>@(row.x.JobTitleName ?? "—")</td>
                                    <td class="td-center">@row.x.PresentDays</td>
                                    <td class="td-number">@row.x.BasicSalary.ToString("#,##0.00")</td>
                                    <td class="td-number">@GetAllowanceTotal(row.x).ToString("#,##0.00")</td>
                                    <td class="td-number">@row.x.Incentives.ToString("#,##0.00")</td>
                                    <td class="td-number">@row.x.Commissions.ToString("#,##0.00")</td>
                                    <td class="td-number">@row.x.Rewards.ToString("#,##0.00")</td>
                                    <td class="td-number">@row.x.OtherEarnings.ToString("#,##0.00")</td>
                                    <td class="td-number gross">@row.x.GrossEarnings.ToString("#,##0.00")</td>
                                    <td class="td-number">@row.x.InsuranceEmployee.ToString("#,##0.00")</td>
                                    <td class="td-number">@row.x.IncomeTax.ToString("#,##0.00")</td>
                                    <td class="td-number">@row.x.LoanDeduction.ToString("#,##0.00")</td>
                                    <td class="td-number">@row.x.PenaltyDeduction.ToString("#,##0.00")</td>
                                    <td class="td-number">@row.x.AbsenceDeduction.ToString("#,##0.00")</td>
                                    <td class="td-number">@((row.x.OtherDeductions + row.x.LateDeduction).ToString("#,##0.00"))</td>
                                    <td class="td-number ded">@row.x.TotalDeductions.ToString("#,##0.00")</td>
                                    <td class="td-number net">@row.x.NetSalary.ToString("#,##0.00")</td>
                                    <td class="td-actions">
                                        <div class="actions-wrap">
                                            <button class="action-btn slip-btn" @onclick="() => GoToSlip(row.x.EmployeeID)">كشف مرتب</button>

                                            @if (CanManualEdit)
                                            {
                                                <button class="action-btn edit-btn" @onclick="() => OpenEditDialog(row.x)">تعديل يدوي</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    @if (showActionDialog)
    {
        <div class="modal-overlay" @onclick="CloseActionDialog">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-icon @GetActionIconClass()">@GetActionIcon()</div>
                <h4>@GetActionTitle()</h4>
                <p class="confirm-msg">@GetActionMessage()</p>

                @if (!string.IsNullOrEmpty(actionError))
                {
                    <div class="form-message msg-error">@actionError</div>
                }

                <div class="modal-buttons-row">
                    <button class="btn-modern @GetActionButtonClass()" @onclick="ExecuteAction" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <div class="btn-spinner-sm"></div><span>جاري...</span>
                        }
                        else
                        {
                            <span>@GetActionButtonText()</span>
                        }
                    </button>
                    <button class="btn-modern btn-ghost" @onclick="CloseActionDialog" disabled="@isProcessing">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (showEditDialog && editModel != null)
    {
        <div class="modal-overlay" @onclick="CloseEditDialog">
            <div class="modal-card edit-modal" @onclick:stopPropagation="true">
                <div class="modal-icon icon-edit">✏️</div>
                <h4>تعديل يدوي لتفاصيل الموظف</h4>

                <div class="employee-mini-card">
                    <div><strong>@editModel.EmployeeName</strong></div>
                    <div class="muted-text">@(editModel.EmployeeCode ?? "—")</div>
                </div>

                <div class="edit-grid">
                    <div class="form-field">
                        <label class="field-label">الحوافز</label>
                        <input type="number" step="0.01" class="field-input" @bind="editModel.Incentives" />
                    </div>
                    <div class="form-field">
                        <label class="field-label">العمولات</label>
                        <input type="number" step="0.01" class="field-input" @bind="editModel.Commissions" />
                    </div>
                    <div class="form-field">
                        <label class="field-label">المكافآت</label>
                        <input type="number" step="0.01" class="field-input" @bind="editModel.Rewards" />
                    </div>
                    <div class="form-field">
                        <label class="field-label">استحقاقات أخرى</label>
                        <input type="number" step="0.01" class="field-input" @bind="editModel.OtherEarnings" />
                    </div>
                    <div class="form-field">
                        <label class="field-label">خصومات أخرى</label>
                        <input type="number" step="0.01" class="field-input" @bind="editModel.OtherDeductions" />
                    </div>
                    <div class="form-field full">
                        <label class="field-label">ملاحظات</label>
                        <textarea class="field-input" rows="3" @bind="editModel.Notes"></textarea>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(editError))
                {
                    <div class="form-message msg-error">@editError</div>
                }

                <div class="modal-buttons-row">
                    <button class="btn-modern btn-primary-modern" @onclick="SaveEdit" disabled="@isSavingEdit">
                        @if (isSavingEdit)
                        {
                            <div class="btn-spinner-sm"></div><span>جاري...</span>
                        }
                        else
                        {
                            <span>حفظ التعديل</span>
                        }
                    </button>
                    <button class="btn-modern btn-ghost" @onclick="CloseEditDialog" disabled="@isSavingEdit">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <div class="toast-container">
            <div class="toast-card @(resultSuccess ? "toast-success" : "toast-error")">
                <span class="toast-text">@resultMessage</span>
                <button class="toast-close" @onclick='() => resultMessage = ""'>✕</button>
            </div>
        </div>
    }
}

<style>
    .items-page{display:flex;flex-direction:column;gap:20px}
    .page-header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px}
    .page-title{font-weight:800;color:#1f2937;margin:0}
    .header-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .breadcrumb-line{display:flex;align-items:center;gap:8px;margin-bottom:6px;font-size:.85rem}
    .crumb-link{color:#1d4ed8;font-weight:700;cursor:pointer}
    .crumb-sep{color:#9ca3af}
    .crumb-current{color:#6b7280}
    .sub-info-line{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
    .mini-chip{background:#f8fafc;border:1px solid #e5e7eb;color:#475569;padding:6px 10px;border-radius:999px;font-size:.78rem;font-weight:700}
    .status-badge{display:inline-block;padding:6px 16px;border-radius:999px;font-size:.82rem;font-weight:800}
    .status-1{background:#fef3c7;color:#d97706}
    .status-2{background:#dbeafe;color:#2563eb}
    .status-3{background:#ecfdf5;color:#059669}
    .status-4{background:#dcfce7;color:#15803d}
    .status-5{background:#f3f4f6;color:#6b7280}
    .stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
    .stat-card{background:#fff;border-radius:16px;padding:20px;text-align:center;border:1px solid #eef2f7;box-shadow:0 4px 12px rgba(15,23,42,.04)}
    .stat-value{font-size:1.5rem;font-weight:800;margin-bottom:4px}
    .stat-label{font-size:.82rem;color:#6b7280;font-weight:600}
    .stat-purple .stat-value{color:#1d4ed8}
    .stat-blue .stat-value{color:#2563eb}
    .stat-red .stat-value{color:#dc2626}
    .stat-green .stat-value{color:#059669}
    .table-card{background:#fff;border-radius:20px;overflow:hidden;border:1px solid #eef2f7;box-shadow:0 4px 16px rgba(15,23,42,.04)}
    .table-responsive{overflow-x:auto}
    .data-table{width:100%;border-collapse:collapse;min-width:2100px}
    .data-table thead{background:#f8f9fc}
    .data-table th{padding:12px 10px;font-size:.78rem;font-weight:700;color:#6b7280;text-align:right;border-bottom:2px solid #eef2f7;white-space:nowrap}
    .data-table td{padding:10px 10px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}
    .data-table tbody tr:hover{background:#f8f7ff}
    .th-num{width:40px;text-align:center}
    .th-center{text-align:center}
    .th-number{text-align:left}
    .th-actions{width:180px;text-align:center}
    .td-num{text-align:center;color:#9ca3af}
    .td-center{text-align:center}
    .td-number{text-align:left;font-family:monospace;font-weight:600;font-size:.82rem}
    .td-number.gross{color:#2563eb}
    .td-number.ded{color:#dc2626}
    .td-number.net{color:#059669;font-size:.88rem;font-weight:800}
    .item-code{background:#f3f4f6;padding:3px 8px;border-radius:6px;font-size:.78rem;color:#1d4ed8;font-weight:600}
    .item-name{font-weight:700;color:#1f2937}
    .td-actions{text-align:center}
    .actions-wrap{display:flex;gap:6px;justify-content:center;flex-wrap:wrap}
    .action-btn{display:inline-flex;align-items:center;justify-content:center;padding:6px 10px;border-radius:10px;border:1.5px solid;background:transparent;font-size:.76rem;font-weight:700;cursor:pointer;min-width:50px}
    .slip-btn{color:#2563eb;border-color:#dbeafe}.slip-btn:hover{background:#eff6ff}
    .edit-btn{color:#1d4ed8;border-color:#e9e0ff}.edit-btn:hover{background:#f5f3ff}
    .btn-modern{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 18px;border-radius:14px;border:none;font-weight:700;font-size:.88rem;cursor:pointer;transition:.2s}
    .btn-modern:disabled{opacity:.6;cursor:not-allowed}
    .btn-primary-modern{background:linear-gradient(135deg,#1d4ed8,#2563eb);color:#fff}
    .btn-ghost{background:transparent;color:#6b7280;border:1.5px solid #e5e7eb}
    .btn-export{background:linear-gradient(135deg,#059669,#10b981);color:#fff}
    .btn-approve{background:linear-gradient(135deg,#059669,#10b981);color:#fff}
