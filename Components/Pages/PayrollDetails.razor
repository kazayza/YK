    .modal-card{background:#fff;border-radius:24px;padding:30px;max-width:520px;width:92%;text-align:center;box-shadow:0 24px 48px rgba(0,0,0,.15)}
    .edit-modal{max-width:700px;text-align:right}
    .modal-icon{width:64px;height:64px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;font-size:1.8rem}
    .icon-calc{background:#f5f3ff;color:#1d4ed8}
    .icon-approve{background:#ecfdf5;color:#059669}
    .icon-pay{background:#f0fdfa;color:#0f766e}
    .icon-edit{background:#f5f3ff;color:#1d4ed8}
    .confirm-msg{color:#6b7280;font-size:.92rem;line-height:1.7}
    .modal-buttons-row{display:flex;gap:10px;justify-content:center;margin-top:18px;flex-wrap:wrap}
    .employee-mini-card{background:#f8fafc;border:1px solid #e5e7eb;border-radius:14px;padding:12px 14px;margin:16px 0}
    .muted-text{font-size:.82rem;color:#6b7280}
    .edit-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
    .form-field{display:flex;flex-direction:column;gap:6px;text-align:right}
