    .form-message{padding:10px 14px;border-radius:12px;font-size:.85rem;font-weight:600;margin-top:12px}
    .msg-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
    .loading-state{text-align:center;padding:60px 20px;color:#6b7280}
    .loader{width:40px;height:40px;border:3px solid #e5e7eb;border-top-color:#1d4ed8;border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 16px}
    .empty-state{text-align:center;padding:60px 20px;background:#fff;border-radius:20px;border:1px solid #eef2f7}
    .empty-icon{font-size:3rem;margin-bottom:16px}
    .no-access-card{text-align:center;padding:80px 20px;background:#fff;border-radius:24px;border:1px solid #eef2f7}
    .no-access-icon{font-size:3.5rem;margin-bottom:16px}
    .toast-container{position:fixed;bottom:24px;left:24px;z-index:1050;animation:toastIn .4s ease}
    .toast-card{display:flex;align-items:center;gap:12px;padding:14px 20px;border-radius:16px;box-shadow:0 12px 32px rgba(0,0,0,.12);min-width:320px}
    .toast-success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}
    .toast-error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
    .toast-text{flex:1;font-weight:600;font-size:.88rem}
    .toast-close{background:transparent;border:none;font-size:1rem;cursor:pointer;color:inherit;opacity:.6}
    @@keyframes spin{to{transform:rotate(360deg)}}
    @@keyframes toastIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
    @@media(max-width:768px){
        .page-header{flex-direction:column}
        .stats-row{grid-template-columns:1fr 1fr}
        .btn-modern{width:100%}
        .edit-grid{grid-template-columns:1fr}
    }
</style>

@code {
    [Parameter] public int PayrollId { get; set; }

    private ModulePermissionDto? permissions;
    private PayrollRunEditDto? payroll;
    private List<PayrollDetailDto> details = new();

    private bool isLoading = true;
    private bool isExporting = false;
    private bool isProcessing = false;
    private bool isSavingEdit = false;

    private bool showActionDialog = false;
    private string pendingAction = "";
    private string actionError = "";

    private bool showEditDialog = false;
    private PayrollDetailEditDto? editModel;
    private string editError = "";

    private string resultMessage = "";
    private bool resultSuccess = true;

    private bool CanManualEdit => permissions?.CanEdit == true
                                  && payroll != null
                                  && (payroll.PayrollStatus == 1 || payroll.PayrollStatus == 2);

    protected override async Task OnParametersSetAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_PAYROLL");

        if (permissions == null || !permissions.CanView)
        {
            isLoading = false;
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;

        try
        {
            payroll = await PayrollService.GetPayrollByIdAsync(PayrollId);
            details = payroll != null
                ? await PayrollService.GetPayrollDetailsAsync(PayrollId)
                : new List<PayrollDetailDto>();
        }
        catch (Exception ex)
        {
            resultMessage = "خطأ: " + ex.Message;
            resultSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private decimal GetAllowanceTotal(PayrollDetailDto item)
        => item.TransportAllowance + item.HousingAllowance + item.PhoneAllowance + item.FoodAllowance + item.OtherAllowances;

    private void GoToSlip(int employeeId)
        => Navigation.NavigateTo($"/payroll/slip/{PayrollId}/{employeeId}");

    private async Task ExportData()
    {
        if (payroll == null) return;

        isExporting = true;
        try
        {
            var bytes = await PayrollService.ExportPayrollToExcelAsync(details, payroll.PayrollNumber ?? "Payroll");
            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile",
                $"Payroll_{payroll.PayrollNumber}_{DateTime.Now:yyyyMMddHHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                b64);

            resultMessage = "تم التصدير ✅";
            resultSuccess = true;
        }
        catch (Exception ex)
        {
            resultMessage = "خطأ: " + ex.Message;
            resultSuccess = false;
        }
        finally
        {
            isExporting = false;
        }
    }

    private void OpenActionDialog(string action)
    {
        pendingAction = action;
        actionError = "";
        showActionDialog = true;
    }

    private void CloseActionDialog()
    {
        if (isProcessing) return;
        showActionDialog = false;
        pendingAction = "";
        actionError = "";
    }

    private async Task ExecuteAction()
    {
        if (payroll == null || string.IsNullOrWhiteSpace(pendingAction))
            return;

        isProcessing = true;
        actionError = "";

        try
        {
            switch (pendingAction)
            {
                case "calculate":
                    await PayrollService.CalculatePayrollAsync(payroll.PayrollID, UserSession.UserID);
                    resultMessage = "تم حساب المرتبات وإرسال إشعار للاعتماد ✅";
                    break;

                case "approve":
                    await PayrollService.ApprovePayrollAsync(payroll.PayrollID, UserSession.UserID);
                    resultMessage = "تم اعتماد المسير ✅";
                    break;

                case "pay":
                    await PayrollService.PayPayrollAsync(payroll.PayrollID, UserSession.UserID);
                    resultMessage = "تم دفع المسير وإنشاء القيد المحاسبي ✅";
                    break;
            }

            resultSuccess = true;
            showActionDialog = false;
            pendingAction = "";

            await LoadData();
        }
        catch (Exception ex)
        {
            actionError = "خطأ: " + ex.Message;
            resultSuccess = false;
        }
        finally
        {
            isProcessing = false;
        }
    }

