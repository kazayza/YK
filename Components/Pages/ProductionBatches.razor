@page "/production-batches"
@using YKCoatings.Services
@using YKCoatings.Models
@inject ProductionBatchService BatchService
@inject NavigationManager NavigationManager
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject IJSRuntime JS

<PageTitle>دفعات الإنتاج - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card"><div class="no-access-icon"><i class="bi bi-lock-fill"></i></div><h4>يجب تسجيل الدخول أولاً</h4></div>
}
else if (permissions is null || !Perms.CanView)
{
    <div class="no-access-card">
        <div class="no-access-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <h4>ليس لديك صلاحية لعرض هذه الشاشة</h4>
        <button class="btn-back-dash" @onclick='() => NavigationManager.NavigateTo("/dashboard")'>العودة للرئيسية</button>
    </div>
}
else
{
    <div class="pb-page yk-gold-page">

        <div class="page-header">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="bi bi-layers-fill"></i>
                    دفعات الإنتاج
                </h1>
                <p class="header-subtitle">إدارة ومتابعة دفعات التصنيع</p>
            </div>
            <div class="header-actions">
                @if (Perms.CanExport)
                {
                    <button class="btn-success-modern" @onclick="ExportToExcel" disabled="@isExporting">
                        @if (isExporting)
                        {
                            <span class="spinner-tiny"></span><span>جاري التصدير...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-excel-fill"></i><span>تصدير إكسيل</span>
                        }
                    </button>
                }
                @if (Perms.CanAdd)
                {
                    <button class="btn-primary-modern" @onclick="NavigateToAdd">
                        <i class="bi bi-plus-lg"></i><span>دفعة جديدة</span>
                    </button>
                }
            </div>
        </div>

        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon-wrap primary"><i class="bi bi-collection-fill"></i></div>
                <div class="stat-info"><div class="stat-value">@batches.Count.ToString("N0")</div><div class="stat-label">الدفعات المعروضة</div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon-wrap warning"><i class="bi bi-gear-wide-connected"></i></div>
                <div class="stat-info"><div class="stat-value">@(batches.Count(x => x.BatchStatus == 2).ToString("N0"))</div><div class="stat-label">قيد التصنيع</div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon-wrap info"><i class="bi bi-search"></i></div>
                <div class="stat-info"><div class="stat-value">@(batches.Count(x => x.BatchStatus == 4).ToString("N0"))</div><div class="stat-label">فحص الجودة</div></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon-wrap success"><i class="bi bi-check-circle-fill"></i></div>
                <div class="stat-info"><div class="stat-value">@(batches.Count(x => x.BatchStatus == 5).ToString("N0"))</div><div class="stat-label">مقبول</div></div>
            </div>
        </div>

        <div class="filter-card">
            <div class="filter-header"><i class="bi bi-funnel-fill"></i>خيارات التصفية والبحث</div>
            <div class="filter-body">
                <div class="filter-group filter-search">
                    <label class="filter-label">بحث سريع</label>
                    <div class="search-wrap">
                        <i class="bi bi-search search-ico"></i>
                        <input type="text" class="filter-input" placeholder="رقم الباتش أو أمر التصنيع أو المنتج..."
                               @bind="searchQuery" @bind:event="oninput" @onkeyup="HandleSearch" />
                    </div>
                </div>
                <div class="filter-group filter-status">
                    <label class="filter-label">الحالة</label>
                    <select class="filter-select" @bind="statusFilter">
                        <option value="">— الكل —</option>
                        <option value="1">مسودة</option>
                        <option value="2">قيد التصنيع</option>
                        <option value="3">اكتمل التصنيع</option>
                        <option value="4">فحص الجودة</option>
                        <option value="5">مقبول</option>
                        <option value="6">مرفوض</option>
                    </select>
                </div>
                <div class="filter-group filter-date">
                    <label class="filter-label">من تاريخ</label>
                    <input type="date" class="filter-input" @bind="fromDate" />
                </div>
                <div class="filter-group filter-date">
                    <label class="filter-label">إلى تاريخ</label>
                    <input type="date" class="filter-input" @bind="toDate" />
                </div>
                <div class="filter-group filter-apply">
                    <span class="filter-label filter-label-spacer" aria-hidden="true">.</span>
                    <button class="btn-primary-modern" @onclick="LoadData">
                        <i class="bi bi-search"></i><span>تصفية</span>
                    </button>
                </div>
            </div>
        </div>

        <div class="table-card">
            <div class="table-card-header">
                <div class="table-card-title">
                    <i class="bi bi-table"></i>
                    قائمة دفعات الإنتاج
                    @if (!isLoading)
                    {
                        <span class="count-badge">@batches.Count.ToString("N0") دفعة</span>
                    }
                </div>
            </div>

            @if (isLoading)
            {
                <div class="state-box loading-state" role="status" aria-busy="true">
                    <div class="spinner-md" aria-hidden="true"></div>
                    <span class="state-text">جاري تحميل الدفعات...</span>
                </div>
            }
            else if (!batches.Any())
            {
                <div class="state-box empty-state" role="status">
                    <div class="empty-icon-circle" aria-hidden="true"><i class="bi bi-inbox"></i></div>
                    <p class="empty-title">لا توجد دفعات مطابقة</p>
                    <p class="empty-sub">غيّر معايير البحث أو الحالة أو التاريخ لتوسيع النتائج.</p>
                    @if (Perms.CanAdd)
                    {
                        <button class="btn-primary-modern" @onclick="NavigateToAdd">
                            <i class="bi bi-plus-lg"></i><span>دفعة جديدة</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="pb-table" aria-label="قائمة دفعات الإنتاج">
                        <thead>
                            <tr>
                                <th>رقم الباتش</th>
                                <th>التاريخ</th>
                                <th>أمر التصنيع</th>
                                <th>المنتج</th>
                                <th class="tc">المخطط</th>
                                <th class="tc">الصالح</th>
                                <th class="tc">المرفوض</th>
                                <th class="tc">الهالك %</th>
                                <th class="tr">التكلفة</th>
                                <th class="tc">الحالة</th>
                                <th class="tc">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var batch in batches)
                            {
                                <tr>
                                    <td><span class="code-chip">@batch.BatchNumber</span></td>
                                    <td><span class="date-txt">@batch.BatchDate.ToString("dd/MM/yyyy")</span></td>
                                    <td><span class="order-chip">@batch.ProductionOrderNumber</span></td>
                                    <td>
                                        <div class="prod-name">@batch.ProductName</div>
                                        <div class="prod-code">@batch.ProductCode</div>
                                    </td>
                                    <td class="tc">@batch.PlannedQty.ToString("N2") @batch.UnitName</td>
                                    <td class="tc"><span class="good-val">@batch.GoodQty.ToString("N2")</span></td>
                                    <td class="tc"><span class="rejected-val">@batch.RejectedQty.ToString("N2")</span></td>
                                    <td class="tc"><span class="waste-chip">@batch.WastePercent%</span></td>
                                    <td class="tr"><span class="cost-val">@batch.TotalCost.ToString("N2")</span></td>
                                    <td class="tc">
                                        <span class="status-chip @GetStatusClass(batch.BatchStatus)">
                                            @batch.StatusName
                                        </span>
                                    </td>
                                    <td class="tc">
                                        <div class="actions-wrap">
                                            @if ((batch.BatchStatus == 1 || batch.BatchStatus == 2 || batch.BatchStatus == 3 || batch.BatchStatus == 4) && Perms.CanEdit)
                                            {
                                                <button type="button" class="ico-btn edit-btn" title="تعديل" aria-label="تعديل الدفعة @batch.BatchNumber"
                                                        @onclick="() => NavigateToEdit(batch.BatchID)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="ico-btn view-btn" title="عرض" aria-label="عرض الدفعة @batch.BatchNumber"
                                                        @onclick="() => NavigateToEdit(batch.BatchID)">
                                                    <i class="bi bi-eye-fill"></i>
                                                </button>
                                            }

                                            @if (Perms.CanPrint)
                                            {
                                                <button type="button" class="ico-btn print-btn" title="طباعة" aria-label="طباعة الدفعة @batch.BatchNumber"
                                                        @onclick="() => PrintBatch(batch.BatchID)">
                                                    <i class="bi bi-printer-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<style>
/* Shared Gold & Black page structure, following Material Issues spacing and component rhythm. */
    .pb-page{ gap:1.5rem; }
.no-access-card{
        max-width:480px; margin:80px auto; padding:64px 24px; text-align:center;
        background:var(--yk-surface); border:1px solid var(--yk-border);
        border-radius:20px; box-shadow:var(--yk-shadow);
    }
.no-access-icon{
        width:72px; height:72px; margin:0 auto 16px; border-radius:50%;
        display:flex; align-items:center; justify-content:center;
        background:var(--yk-gold-10); color:var(--yk-gold-dark); font-size:2rem;
    }
.no-access-card h4{ margin:0 0 14px; color:var(--yk-text); font-size:1rem; font-weight:800; }
.btn-back-dash{
        padding:.6rem 1.4rem; border:1px solid var(--yk-border-gold); border-radius:10px;
        background:var(--yk-gold-10); color:var(--yk-gold-dark); font-family:'Tajawal','Segoe UI',sans-serif;
        font-weight:700; cursor:pointer; transition:all var(--yk-transition);
    }
.btn-back-dash:hover{ background:var(--yk-gold); color:var(--yk-black2); }
.header-content{ position:relative; z-index:1; min-width:0; }
.header-title{ display:flex; align-items:center; gap:.6rem; margin:0 0 .25rem; font-size:1.5rem; line-height:1.3; }
.header-subtitle{ margin:0; font-size:.85rem; }
.header-actions{ gap:.75rem; }
.header-actions button{ min-height:40px; }
.stats-row{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:1rem; }
.stat-card{ display:flex; min-width:0; align-items:center; gap:1rem; padding:1.2rem 1.4rem; }
.stat-icon-wrap{ width:48px; height:48px; flex:0 0 48px; display:flex; align-items:center; justify-content:center; border-radius:10px; font-size:1.3rem; }
.yk-gold-page .stat-icon-wrap.warning{ color:var(--yk-text); background:var(--yk-warning-soft); border:1px solid var(--yk-warning-soft); }
.yk-gold-page .stat-icon-wrap.success{ color:var(--yk-success); background:var(--yk-success-soft); border:1px solid var(--yk-success-soft); }
.stat-info{ flex:1; min-width:0; }
.stat-value{ font-size:1.6rem; font-weight:800; line-height:1; font-variant-numeric:tabular-nums; }
.stat-label{ margin-top:.2rem; color:var(--yk-text-3); font-size:.78rem; font-weight:600; line-height:1.45; }
.filter-header{ display:flex; align-items:center; gap:.5rem; padding:.85rem 1.4rem; font-size:.82rem; font-weight:700; }
.filter-body{ display:flex; flex-wrap:wrap; align-items:flex-end; gap:1rem; padding:1.2rem 1.4rem; }
.filter-group{ display:flex; min-width:0; flex-direction:column; gap:.4rem; }
.filter-search{ flex:2 1 220px; }
.filter-status,.filter-date{ flex:1 1 140px; }
.filter-apply{ flex:.6 1 100px; justify-content:flex-end; }
.filter-label{ color:var(--yk-text-2); font-size:.8rem; font-weight:700; }
.filter-label-spacer{ visibility:hidden; }
.filter-input,.filter-select{
        width:100%; min-width:0; min-height:41px; padding:.55rem .9rem;
        border:1px solid var(--yk-border); border-radius:10px; outline:none;
        color:var(--yk-text); background:var(--yk-bg); font-family:'Tajawal','Segoe UI',sans-serif; font-size:.88rem;
        transition:border-color var(--yk-transition),box-shadow var(--yk-transition),background-color var(--yk-transition);
    }
.filter-input:focus,.filter-select:focus{ border-color:var(--yk-gold); background:var(--yk-surface); box-shadow:0 0 0 3px var(--yk-primary-ring); }
.filter-input::placeholder{ color:var(--yk-text-3); }
.search-wrap{ position:relative; width:100%; min-width:0; }
.search-ico{ position:absolute; top:50%; right:.85rem; transform:translateY(-50%); color:var(--yk-gold-dark); pointer-events:none; }
.search-wrap .filter-input{ padding-right:2.4rem; }
.filter-body .btn-primary-modern{ width:100%; min-height:41px; justify-content:center; padding:.6rem 1.1rem; font-family:'Tajawal','Segoe UI',sans-serif; }
.table-card-header{ display:flex; align-items:center; justify-content:space-between; padding:.9rem 1.4rem; }
.table-card-title{ display:flex; align-items:center; gap:.5rem; font-size:.9rem; font-weight:700; }
.count-badge{ white-space:nowrap; background:var(--yk-gold-10); color:var(--yk-gold-dark); font-size:.75rem; font-weight:700; padding:.2rem .65rem; border-radius:20px; }
.table-scroll{ overflow-x:auto; overscroll-behavior-x:contain; }
.pb-table{ width:100%; min-width:1220px; border-collapse:collapse; background:var(--yk-surface); }
.pb-table thead th{
        padding:.85rem 1rem; color:var(--yk-text-2); background:#f8f6f0;
        border-bottom:2px solid var(--yk-border-gold); font-size:.76rem; font-weight:700;
        letter-spacing:.02em; white-space:nowrap; text-align:right;
    }
.pb-table thead th.tc,.pb-table tbody td.tc{ text-align:center; }
.pb-table thead th.tr,.pb-table tbody td.tr{ text-align:left; }
.pb-table tbody tr{ border-bottom:1px solid var(--yk-border); transition:background-color .15s ease; }
.pb-table tbody tr:last-child{ border-bottom:0; }
.pb-table tbody tr:hover{ background:var(--yk-gold-10); }
.pb-table tbody td{ padding:.85rem 1rem; color:var(--yk-text); border-bottom:1px solid #f0ede5; font-size:.875rem; vertical-align:middle; }
.code-chip{ display:inline-flex; align-items:center; padding:.2rem .55rem; border:1px solid var(--yk-border-gold); border-radius:6px; background:var(--yk-gold-10); color:var(--yk-gold-dark); font-family:'Courier New',monospace; font-size:.82rem; font-weight:700; white-space:nowrap; }
.date-txt{ color:var(--yk-text-2); font-size:.85rem; white-space:nowrap; }
.order-chip{ color:var(--yk-gold-dark); font-size:.85rem; font-weight:700; white-space:nowrap; }
.prod-name{ color:var(--yk-text); font-weight:700; }
.prod-code{ margin-top:.15rem; color:var(--yk-text-3); font-size:.72rem; direction:ltr; text-align:right; }
.good-val{ color:var(--yk-success); font-weight:800; font-variant-numeric:tabular-nums; }
.rejected-val{ color:var(--yk-danger); font-weight:800; font-variant-numeric:tabular-nums; }
.waste-chip{ display:inline-flex; justify-content:center; min-width:54px; padding:.2rem .55rem; border:1px solid var(--yk-warning-soft); border-radius:20px; background:var(--yk-warning-soft); color:var(--yk-text); font-size:.75rem; font-weight:700; font-variant-numeric:tabular-nums; }
.cost-val{ color:var(--yk-success); font-weight:800; direction:ltr; display:inline-block; font-variant-numeric:tabular-nums; }
.status-chip{ display:inline-flex; align-items:center; gap:.35rem; padding:.28rem .75rem; border:1px solid var(--yk-border-gold); border-radius:20px; font-size:.75rem; font-weight:700; white-space:nowrap; }
.status-chip::before{ content:''; width:6px; height:6px; flex:0 0 6px; border-radius:50%; display:inline-block; }
.s-draft{ color:var(--yk-text-2); background:var(--yk-bg); }
.s-draft::before{ background:var(--yk-text-3); }
.s-work{ color:var(--yk-text); background:var(--yk-warning-soft); }
.s-work::before{ background:var(--yk-warning); }
.s-done{ color:var(--yk-gold-dark); background:var(--yk-gold-10); }
.s-done::before{ background:var(--yk-gold); }
.s-qc{ color:var(--yk-text-2); background:var(--yk-info-soft); }
.s-qc::before{ background:var(--yk-info); }
.s-accepted{ color:var(--yk-success); background:var(--yk-success-soft); }
.s-accepted::before{ background:var(--yk-success); }
.s-rejected{ color:var(--yk-danger); background:var(--yk-danger-soft); }
.s-rejected::before{ background:var(--yk-danger); }
.actions-wrap{ display:flex; align-items:center; justify-content:center; gap:.4rem; }
.ico-btn{ position:relative; width:32px; height:32px; border:0; border-radius:8px; background:transparent; display:inline-flex; align-items:center; justify-content:center; cursor:pointer; transition:all .2s; }
.ico-btn:hover{ transform:scale(1.12); }
.ico-btn::after{ content:attr(title); position:absolute; bottom:calc(100% + 8px); left:50%; transform:translateX(-50%) scale(.9); padding:.3rem .6rem; border-radius:6px; background:var(--yk-black3); color:#fff; font-size:.7rem; font-weight:600; white-space:nowrap; opacity:0; pointer-events:none; transition:all .2s; z-index:10; }
.ico-btn:hover::after{ opacity:1; transform:translateX(-50%) scale(1); }
.edit-btn,.print-btn{ color:var(--yk-gold-dark); }
.edit-btn:hover,.print-btn:hover{ background:var(--yk-gold-10); }
.view-btn{ color:var(--yk-info); }
.view-btn:hover{ background:var(--yk-info-soft); }
.ico-btn:focus-visible{ outline:2px solid var(--yk-gold); outline-offset:2px; }
.state-box{ display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1rem; padding:4rem 2rem; text-align:center; }
.state-text{ color:var(--yk-text-3); font-size:.9rem; font-weight:500; }
.spinner-md{ width:44px; height:44px; border:3px solid var(--yk-border); border-top-color:var(--yk-gold); border-radius:50%; animation:pbSpin .7s linear infinite; }
.spinner-tiny{ width:14px; height:14px; border:2px solid rgba(255,255,255,.35); border-top-color:#fff; border-radius:50%; animation:pbSpin .6s linear infinite; display:inline-block; }
.empty-icon-circle{ width:80px; height:80px; border-radius:50%; display:flex; align-items:center; justify-content:center; background:var(--yk-gold-10); color:var(--yk-gold-dark); font-size:2rem; }
.empty-title{ margin:0; color:var(--yk-text); font-size:1.05rem; font-weight:700; }
.empty-sub{ margin:0; color:var(--yk-text-3); font-size:.85rem; }
</style>

@code {
    private List<ProductionBatchListDto> batches = new();
    private bool isLoading = true;
    private bool isExporting = false;
    private ModulePermissionDto? permissions;
    private ModulePermissionDto Perms => permissions!;

    private string? searchQuery;
    private string? statusFilter;
    private DateTime? fromDate;
    private DateTime? toDate;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_BATCH");

        if (permissions is not null && Perms.CanView)
            await LoadData();
        else
            isLoading = false;
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            int? status = int.TryParse(statusFilter, out var s) ? s : null;
            batches = await BatchService.GetListAsync(searchQuery, status, fromDate, toDate);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadData();
    }

    private void NavigateToAdd() => NavigationManager.NavigateTo("/production-batches/edit/0");
    private void NavigateToEdit(int id) => NavigationManager.NavigateTo($"/production-batches/edit/{id}");

    private string GetStatusClass(int status) => status switch
    {
        1 => "s-draft",
        2 => "s-work",
        3 => "s-done",
        4 => "s-qc",
        5 => "s-accepted",
        6 => "s-rejected",
        _ => "s-draft"
    };

    private async Task ExportToExcel()
    {
        if (!Perms.CanExport) return;

        isExporting = true;
        try
        {
            var fileBytes = await BatchService.ExportToExcelAsync(batches, UserSession.UserID);
            var fileName = $"ProductionBatches_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            var base64 = Convert.ToBase64String(fileBytes);

            await JS.InvokeVoidAsync("downloadFile", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
        }
        finally
        {
            isExporting = false;
        }
    }

    private async Task PrintBatch(int batchId)
{
    if (!Perms.CanPrint) return;

    var batch = await BatchService.GetByIdAsync(batchId);
    if (batch is null) return;

    var stages = await BatchService.GetStagesAsync(batchId);

    var rowsBuilder = new System.Text.StringBuilder();

    for (int i = 0; i < stages.Count; i++)
    {
        var s = stages[i];

        rowsBuilder.Append("<tr>");
        rowsBuilder.Append($"<td style='padding:10px;border-bottom:1px solid #e8e2d0;text-align:center'>{i + 1}</td>");
        rowsBuilder.Append($"<td style='padding:10px;border-bottom:1px solid #e8e2d0'>{s.StageName}</td>");
        rowsBuilder.Append($"<td style='padding:10px;border-bottom:1px solid #e8e2d0;text-align:center'>{s.StageStatusName}</td>");
        rowsBuilder.Append($"<td style='padding:10px;border-bottom:1px solid #e8e2d0;text-align:center'>{(s.StartTime?.ToString("dd/MM HH:mm") ?? "—")}</td>");
        rowsBuilder.Append($"<td style='padding:10px;border-bottom:1px solid #e8e2d0;text-align:center'>{(s.EndTime?.ToString("dd/MM HH:mm") ?? "—")}</td>");
        rowsBuilder.Append("</tr>");
    }

    var html =
        "<!DOCTYPE html>" +
        "<html lang='ar' dir='rtl'>" +
        "<head>" +
        "<meta charset='UTF-8'>" +
        $"<title>دفعة إنتاج - {batch.BatchNumber}</title>" +
        "<style>" +
        "body{font-family:'Tajawal','Segoe UI',sans-serif;direction:rtl;padding:30px;color:#0A0F1E;background:#fff}" +
        "table{width:100%;border-collapse:collapse;margin-top:20px}" +
        "th{background:#f8f6f0;padding:10px;text-align:right;border-bottom:2px solid rgba(212,175,55,.25)}" +
        ".no-print{margin-bottom:20px;display:flex;gap:10px;justify-content:flex-end}" +
        "@media print{.no-print{display:none!important}}" +
        "</style>" +
        "</head>" +
        "<body>" +
        "<div class='no-print'>" +
        "<button onclick='window.print()' style='background:linear-gradient(135deg,#D4AF37,#9C7C2E);color:#0A0F1E;border:1px solid #D4AF37;padding:10px 20px;border-radius:8px;cursor:pointer;font-weight:800;'>طباعة</button>" +
        "<button onclick='window.close()' style='background:#0A0F1E;color:#F5E6C8;border:1px solid rgba(212,175,55,.35);padding:10px 20px;border-radius:8px;cursor:pointer;'>إغلاق</button>" +
        "</div>" +
        $"<h2 style='color:#0A0F1E;border-bottom:3px solid #D4AF37;padding-bottom:10px'>دفعة إنتاج رقم {batch.BatchNumber}</h2>" +
        "<div style='display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:20px 0'>" +
        $"<div><strong>أمر التصنيع:</strong> {batch.ProductionOrderNumber}</div>" +
        $"<div><strong>المنتج:</strong> {batch.ProductName}</div>" +
        $"<div><strong>تاريخ الباتش:</strong> {batch.BatchDate:dd/MM/yyyy}</div>" +
        $"<div><strong>الحالة:</strong> {GetStatusName(batch.BatchStatus)}</div>" +
        $"<div><strong>الكمية المخططة:</strong> {batch.PlannedQty:N2} {batch.UnitName}</div>" +
        $"<div><strong>الكمية الصالحة:</strong> {batch.GoodQty:N2}</div>" +
        $"<div><strong>التكلفة:</strong> {batch.TotalCost:N2}</div>" +
        $"<div><strong>المخزن:</strong> {batch.TargetWarehouseName}</div>" +
        "</div>" +
        "<table>" +
        "<thead><tr><th>#</th><th>المرحلة</th><th>الحالة</th><th>البداية</th><th>النهاية</th></tr></thead>" +
        $"<tbody>{rowsBuilder}</tbody>" +
        "</table>" +
        "</body></html>";

    await JS.InvokeVoidAsync("printHtml", html);
}

    private string GetStatusName(int status) => status switch
    {
        1 => "مسودة",
        2 => "قيد التصنيع",
        3 => "اكتمل التصنيع",
        4 => "في فحص الجودة",
        5 => "مقبول",
        6 => "مرفوض",
        _ => "—"
    };
}"مرفوض",
        _ => "—"
    };
}