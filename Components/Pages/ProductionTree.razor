@page "/production-tree"
@using YKCoatings.Models
@using YKCoatings.Services
@inject ProductionTreeService ProductionTreeService
@inject PermissionService PermissionService
@inject UserSessionService UserSession
@inject NavigationManager Navigation

<PageTitle>شجرة الإنتاج - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="tree-denied" dir="rtl"><h3>يجب تسجيل الدخول أولاً</h3><button @onclick='() => Navigation.NavigateTo("/login")'>تسجيل الدخول</button></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="tree-denied" dir="rtl"><h3>ليس لديك صلاحية عرض وصفات التصنيع</h3><button @onclick='() => Navigation.NavigateTo("/boms")'>العودة إلى وصفات التصنيع</button></div>
}
else
{
    <div class="production-tree-page yk-gold-page" dir="rtl">
        <header class="tree-header">
            <div class="tree-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v5m0 0H6v5m6-5h6v5M6 13v7m6-7v7m6-7v7"/><circle cx="12" cy="3" r="2"/><circle cx="6" cy="13" r="2"/><circle cx="18" cy="13" r="2"/><circle cx="6" cy="20" r="2"/><circle cx="12" cy="20" r="2"/><circle cx="18" cy="20" r="2"/></svg></div>
            <div class="tree-header-copy">
                <span>التصنيع · عرض فقط</span>
                <h1>شجرة الإنتاج</h1>
                <p>توسيع المكونات المرتبطة بوصفة نشطة ومعتمدة دون تعديل أو ترحيل.</p>
            </div>
            <button class="tree-back" @onclick='() => Navigation.NavigateTo("/boms")'>إدارة الوصفات</button>
        </header>

        <section class="tree-selector-card">
            <div class="selector-heading">
                <h2>اختر وصفة المنتج الجذر</h2>
                <p>@approvedBoms.Count وصفة نشطة ومعتمدة متاحة حسب صلاحية SCR_BOM.</p>
            </div>
            <div class="selector-row">
                <select class="tree-select" value="@selectedBomId" @onchange="OnBomSelected" disabled="@isLoading">
                    <option value="0">اختر المنتج والوصفة</option>
                    @foreach (var bom in approvedBoms)
                    {
                        <option value="@bom.BOMID">@bom.ProductCode — @bom.ProductName · @bom.BOMCode · نسخة @bom.BOMVersion</option>
                    }
                </select>
                <button class="tree-refresh" @onclick="LoadOptions" disabled="@isLoading">تحديث القائمة</button>
            </div>
        </section>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="tree-message @(messageIsError ? "error" : "info")">@message</div>
        }
        @if (isLoading)
        {
            <div class="tree-loading"><span></span><p>جارٍ تحميل الوصفة وشجرتها...</p></div>
        }
        else if (tree is not null)
        {
            <section class="tree-view-card">
                <div class="tree-view-heading">
                    <div>
                        <h2>@tree.Root.ItemName <span class="root-code">@tree.Root.ItemCode</span></h2>
                        <p>الوصفة @tree.Root.BOMCode · النسخة @tree.Root.BOMVersion</p>
                    </div>
                    <div class="tree-toolbar">
                        <button @onclick="ExpandAll" disabled="@(tree.Root.Components.Count == 0)">توسيع كل الفروع</button>
                        <span class="readonly-badge">قراءة فقط</span>
                    </div>
                </div>
                <div class="tree-scope-note">@tree.QuantityScopeNote</div>
                <div class="tree-content">
                    <ProductionTreeNode Node="tree.Root" Level="0" ExpandSignal="@expandSignal" />
                </div>
            </section>
        }
        else if (approvedBoms.Count == 0 && !isLoading)
        {
            <div class="tree-empty">لا توجد وصفات نشطة ومعتمدة للعرض.</div>
        }
        else if (selectedBomId == 0)
        {
            <div class="tree-empty">اختر وصفة من القائمة لعرض مكوناتها المتداخلة.</div>
        }
    </div>
}

@code {
    private ModulePermissionDto? permissions;
    private List<ProductionTreeBOMOptionDto> approvedBoms = new();
    private ProductionTreeResult? tree;
    private int selectedBomId;
    private bool isLoading;
    private int expandSignal;
    private string message = "";
    private bool messageIsError;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_BOM");
        if (permissions?.CanView == true)
            await LoadOptions();
    }

    private async Task LoadOptions()
    {
        isLoading = true;
        message = "";
        try
        {
            approvedBoms = await ProductionTreeService.GetApprovedActiveBomsAsync(UserSession.UserID);
            if (selectedBomId > 0 && !approvedBoms.Any(x => x.BOMID == selectedBomId))
            {
                selectedBomId = 0;
                tree = null;
            }
        }
        catch (Exception ex)
        {
            message = "تعذر تحميل الوصفات: " + ex.Message;
            messageIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnBomSelected(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out selectedBomId) || selectedBomId <= 0)
        {
            selectedBomId = 0;
            tree = null;
            message = "";
            return;
        }
        await LoadSelectedTree();
    }

    private async Task LoadSelectedTree()
    {
        if (selectedBomId <= 0)
        {
            tree = null;
            return;
        }

        isLoading = true;
        message = "";
        messageIsError = false;
        try
        {
            tree = await ProductionTreeService.GetTreeAsync(selectedBomId, UserSession.UserID);
            expandSignal++;
        }
        catch (Exception ex)
        {
            tree = null;
            message = "تعذر تحميل الشجرة: " + ex.Message;
            messageIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ExpandAll()
    {
        // Incrementing the signal resets every recursive node to its expanded state.
        expandSignal++;
    }
}

<style>
.production-tree-page{max-width:1450px;margin:0 auto;padding:18px 20px 42px;color:#162033;font-family:'Tajawal','Segoe UI',sans-serif}
.tree-header{display:flex;align-items:center;gap:15px;padding:21px 23px;margin-bottom:17px;border-radius:18px;background:linear-gradient(125deg,#080d17,#151c2a 67%,#242116);border:1px solid rgba(212,175,55,.38);box-shadow:0 14px 30px rgba(7,11,20,.13);position:relative;overflow:hidden}
.tree-header:before{content:'';position:absolute;top:0;right:0;left:0;height:3px;background:linear-gradient(90deg,transparent,#d4af37,#f0d67c,transparent)}
.tree-mark{display:flex;align-items:center;justify-content:center;flex:0 0 48px;width:48px;height:48px;border:1px solid rgba(212,175,55,.34);border-radius:14px;background:rgba(212,175,55,.09);color:#d7b549}
.tree-mark svg{width:25px;height:25px}
.tree-header-copy{flex:1}
.tree-header-copy>span{color:#d4af37;font-size:.67rem;font-weight:900;letter-spacing:.1em}
.tree-header-copy h1{font-size:1.25rem;font-weight:900;color:#f5e6c8;margin:4px 0}
.tree-header-copy p{font-size:.76rem;color:#aeb6c3;margin:0}
.tree-back,.tree-refresh,.tree-toolbar button{border:1px solid rgba(212,175,55,.45);border-radius:9px;background:transparent;color:#f1dfaa;padding:9px 13px;font:700 .74rem 'Tajawal','Segoe UI',sans-serif;cursor:pointer}
.tree-back:hover,.tree-refresh:hover,.tree-toolbar button:hover{background:rgba(212,175,55,.1)}
.tree-selector-card,.tree-view-card{background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:18px 20px;margin-bottom:16px;box-shadow:0 6px 18px rgba(10,15,30,.035)}
.selector-heading{display:flex;align-items:baseline;justify-content:space-between;gap:12px;margin-bottom:12px}
.selector-heading h2,.tree-view-heading h2{font-size:.95rem;font-weight:900;color:#182131;margin:0}
.selector-heading p,.tree-view-heading p{font-size:.72rem;color:#737d8c;margin:0}
.selector-row{display:flex;gap:10px;align-items:center}
.tree-select{flex:1;min-width:0;height:42px;padding:0 12px;border:1px solid #ded7c5;border-radius:10px;background:#fff;font:700 .76rem 'Tajawal','Segoe UI',sans-serif;color:#182131}
.tree-refresh{background:#111827;color:#e7d494}
.tree-message{padding:11px 14px;border-radius:10px;margin-bottom:14px;font-size:.76rem}
.tree-message.info{background:#fbf7e9;color:#665313;border:1px solid #eee1b3}
.tree-message.error{background:#fff1f0;color:#9b2b21;border:1px solid #f0cbc5}
.tree-loading,.tree-empty{padding:30px;text-align:center;border:1px dashed #ded7c5;border-radius:14px;background:#fff;color:#737d8c;font-size:.78rem}
.tree-loading>span{display:block;width:26px;height:26px;margin:0 auto 9px;border:2px solid rgba(212,175,55,.25);border-top-color:#c9a12a;border-radius:50%;animation:treeSpin .7s linear infinite}
.tree-view-heading{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-bottom:13px;border-bottom:1px solid #eee8d8}
.tree-view-heading p{margin-top:4px}
.root-code{font:800 .72rem Consolas,monospace;color:#927212;direction:ltr;margin-right:6px}
.tree-toolbar{display:flex;align-items:center;gap:8px}
.tree-toolbar button{background:#111827;color:#e7d494}
.readonly-badge{padding:6px 9px;border:1px solid #d9e8dc;border-radius:999px;background:#eff8f1;color:#28623a;font-size:.67rem;font-weight:800;white-space:nowrap}
.tree-scope-note{margin:12px 0;padding:10px 12px;border-radius:9px;background:#fbf8ed;border:1px solid #eee5c8;color:#68561f;font-size:.71rem;line-height:1.7}
.tree-content{padding:5px 0}
.tree-denied{direction:rtl;max-width:600px;margin:50px auto;padding:24px;background:#101725;color:#f5e6c8;border:1px solid #d4af37;border-radius:16px;text-align:center}
.tree-denied button{padding:9px 14px;border:1px solid #d4af37;border-radius:9px;background:#d4af37;color:#111;font-weight:800}
</style>
