@code {
    private List<SupplierListDto>? suppliers;
    private List<SupplierListDto> filtered = new();
    private ModulePermissionDto? permissions;
    private string searchText = "";
    private int filterType = 0, filterRating = 0;
    private bool isExporting = false;
    private string toast = ""; private bool toastOk = true;
    private bool showDeleteDialog = false;
    private SupplierListDto? deleteItem; private string deleteMsg = "";
    private string viewMode = "cards";

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_SUPPLIERS");
        if (permissions != null && permissions.CanView) await LoadData();
    }

    private async Task LoadData() { suppliers = await SupService.GetSuppliersListAsync(); Filter(); }
    private void Filter()
    {
        if (suppliers == null) return;
        filtered = suppliers.Where(s =>
            (filterType == 0 || s.SupplierType == filterType) &&
            (filterRating == 0 || s.Rating == filterRating) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(s.SupplierCode, searchText) ||
             ArabicSearchHelper.Contains(s.SupplierNameAr, searchText) ||
             ArabicSearchHelper.Contains(s.City, searchText) ||
             ArabicSearchHelper.Contains(s.Phone1, searchText))
        ).ToList();
    }
    private void ClearSearch() { searchText = ""; Filter(); }
    private int GetCreditPercent(SupplierListDto s)
    {
        if (s.CreditLimit <= 0) return 0;
        var used = s.CurrentBalance / s.CreditLimit * 100;
        return Math.Clamp((int)used, 0, 100);
    }
    private async Task PrintCard(int id)
    {
        try { var html = await SupService.GenerateSupplierCardHtmlAsync(id, UserSession.UserID); await JS.InvokeVoidAsync("printHtml", html); }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
    }
    private async Task ExportExcel()
    {
        if (!filtered.Any()) return; isExporting = true; StateHasChanged();
        try { var b = await SupService.ExportToExcelAsync(filtered, UserSession.UserID);
            await JS.InvokeVoidAsync("downloadFile", $"Suppliers_{DateTime.Now:yyyyMMdd}.xlsx","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(b));
            toast = "تم التصدير ✅"; toastOk = true; }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isExporting = false; StateHasChanged(); }
    }
    private void ShowDelete(SupplierListDto s) { deleteItem = s; deleteMsg = ""; showDeleteDialog = true; }
    private async Task ConfirmDelete()
    {
        if (deleteItem == null) return;
        var r = await SupService.DeleteSupplierAsync(deleteItem.SupplierID, UserSession.UserID);
        if (r.Success) { toast = r.Message + " ✅"; toastOk = true; showDeleteDialog = false; await LoadData(); }
        else { deleteMsg = r.Message; }
    }
}
