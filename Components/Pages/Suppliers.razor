@page "/suppliers"
@page "/supplier"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject SupplierService SupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>الموردين - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{ <div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div> }
else if (permissions == null || !permissions.CanView)
{ <div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div> }
else
{
    <div class="luxury-page" dir="rtl">
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">الموردين</h2><p class="lh-subtitle">إدارة بيانات الموردين والتعاملات - تتبع ذكي للأرصدة والتقييمات</p></div>
                </div>
                <div class="lh-actions">
                    <span class="lh-badge"><span class="lh-dot"></span>@filtered.Count مورد</span>
                    @if (permissions.CanPrint)
                    {
                        <button class="btn-luxury btn-export-luxury" @onclick="ExportExcel" disabled="@isExporting">
                            @if(isExporting){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>}
                            Excel
                        </button>
                    }
                    @if (permissions.CanAdd)
                    { <button class="btn-luxury btn-primary-luxury" @onclick='() => Navigation.NavigateTo("/suppliers/new")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>مورد جديد</button> }
                </div>
            </div>
        </div>

        @if (suppliers != null)
        {
            <div class="stats-luxury">
                <div class="stat-luxury"><div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div><div class="st-info"><span class="st-value">@suppliers.Count</span><span class="st-label">إجمالي الموردين</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg></div><div class="st-info"><span class="st-value">@suppliers.Count(s => s.SupplierType == 1)</span><span class="st-label">خامات</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/></svg></div><div class="st-info"><span class="st-value">@suppliers.Count(s => s.SupplierType == 2)</span><span class="st-label">تعبئة</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@suppliers.Sum(s => s.CurrentBalance).ToString("#,##0")</span><span class="st-label">إجمالي الأرصدة</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><div class="st-info"><span class="st-value">@suppliers.Sum(s => s.UnpaidInvoices)</span><span class="st-label">فواتير معلقة</span></div><div class="st-gold-line"></div></div>
            </div>
        }

        <div class="filter-luxury">
            <div class="search-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="بحث بالاسم أو الكود أو المدينة..." @bind="searchText" @bind:event="oninput" @onkeyup="Filter" />
                @if (!string.IsNullOrEmpty(searchText)) { <button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button> }
            </div>
            <div class="select-wrap-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>
                <select @bind="filterType" @bind:after="Filter">
                    <option value="0">كل الأنواع</option>
                    <option value="1">مورد خامات</option>
                    <option value="2">مورد تعبئة</option>
                    <option value="3">مورد خدمات</option>
                    <option value="4">مورد عام</option>
                </select>
                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <div class="select-wrap-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                <select @bind="filterRating" @bind:after="Filter">
                    <option value="0">كل التقييمات</option>
                    <option value="5">⭐⭐⭐⭐⭐ ممتاز</option>
                    <option value="4">⭐⭐⭐⭐ جيد جداً</option>
                    <option value="3">⭐⭐⭐ جيد</option>
                    <option value="2">⭐⭐ مقبول</option>
                    <option value="1">⭐ ضعيف</option>
                </select>
                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <div class="view-toggle-luxury">
                <button class="vt-btn @(viewMode=="cards"?"active":"")" @onclick='() => viewMode="cards"'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></button>
                <button class="vt-btn @(viewMode=="table"?"active":"")" @onclick='() => viewMode="table"'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3h18v18H3z"/><path d="M9 3v18"/><path d="M3 9h18"/></svg></button>
            </div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        @if (suppliers == null)
        { <div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل الموردين...</p></div> }
        else if (!filtered.Any())
        { <div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><h4>لا يوجد موردين</h4><p>جرب تغيير معايير البحث</p></div> }
        else
        {
            @if (viewMode == "cards")
            {
                <div class="sup-grid-luxury">
                    @foreach (var s in filtered)
                    {
                        <div class="sup-card-luxury">
                            <div class="sup-gold-line"></div>
                            <div class="sup-header">
                                <div class="sup-avatar type-@s.SupplierType"><span>@(s.SupplierNameAr?.FirstOrDefault().ToString() ?? "M")</span></div>
                                <div class="sup-info"><strong>@s.SupplierNameAr</strong><code>@s.SupplierCode</code><div class="sup-meta"><span class="type-badge-luxury" style="--tc:@SupplierService.GetTypeColor(s.SupplierType)">@(s.SupplierTypeName ?? SupplierService.GetTypeName(s.SupplierType))</span><span class="rating-gold">@(new string('★', s.Rating))<span class="rating-empty">@(new string('★', 5-s.Rating))</span></span></div></div>
                                @if (s.UnpaidInvoices > 0){<span class="unpaid-badge-luxury">@s.UnpaidInvoices فاتورة</span>}
                            </div>
                            <div class="sup-body">
                                <div class="sup-row"><span class="sup-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>الهاتف</span><span class="sup-value" dir="ltr">@(s.Phone1 ?? s.Mobile ?? "—")</span></div>
                                <div class="sup-row"><span class="sup-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>المدينة</span><span class="sup-value">@(s.City ?? "—")</span></div>
                                <div class="sup-row"><span class="sup-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/></svg>الأصناف</span><span class="sup-value"><span class="cnt-badge-luxury">@s.ItemCount صنف</span></span></div>
                                <div class="sup-row"><span class="sup-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>الرصيد</span><span class="sup-value @(s.CurrentBalance>0?"bal-danger":"bal-ok")">@s.CurrentBalance.ToString("#,##0.00") ج.م</span></div>
                                <div class="sup-row"><span class="sup-label">حد الائتمان</span><span class="sup-value">@s.CreditLimit.ToString("#,##0.00")</span></div>
                            </div>
                            <div class="sup-footer">
                                <div class="credit-bar"><div class="credit-fill" style="width:@(GetCreditPercent(s))%"></div></div>
                                <div class="sup-actions">
                                    <button class="act-btn view" title="عرض" @onclick='() => Navigation.NavigateTo($"/suppliers/view/{s.SupplierID}")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
                                    @if (permissions.CanEdit){<button class="act-btn edit" title="تعديل" @onclick='() => Navigation.NavigateTo($"/suppliers/edit/{s.SupplierID}")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                    @if (permissions.CanPrint){<button class="act-btn print" title="طباعة" @onclick='() => PrintCard(s.SupplierID)'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg></button>}
                                    @if (permissions.CanDelete){<button class="act-btn delete" title="حذف" @onclick="() => ShowDelete(s)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="table-card-luxury"><div class="table-responsive"><table class="table-luxury">
                    <thead><tr><th class="th-num">#</th><th>الكود</th><th>المورد</th><th>النوع</th><th>الهاتف</th><th>المدينة</th><th class="th-center">أصناف</th><th>حد الائتمان</th><th>الرصيد</th><th class="th-center">فواتير</th><th class="th-center">التقييم</th><th class="th-actions">إجراءات</th></tr></thead>
                    <tbody>
                        @{int n=0;}
                        @foreach (var s in filtered){n++;
                            <tr>
                                <td class="td-num">@n</td>
                                <td><span class="code-luxury">@s.SupplierCode</span></td>
                                <td class="td-name">@s.SupplierNameAr</td>
                                <td><span class="type-badge-luxury" style="--tc:@SupplierService.GetTypeColor(s.SupplierType)">@(s.SupplierTypeName ?? SupplierService.GetTypeName(s.SupplierType))</span></td>
                                <td class="td-muted" dir="ltr">@(s.Phone1 ?? s.Mobile ?? "—")</td>
                                <td class="td-muted">@(s.City ?? "—")</td>
                                <td class="td-center"><span class="cnt-badge-luxury">@s.ItemCount</span></td>
                                <td class="num-cell">@s.CreditLimit.ToString("#,##0.00")</td>
                                <td class="num-cell @(s.CurrentBalance>0?"bal-danger":"")"><strong>@s.CurrentBalance.ToString("#,##0.00")</strong></td>
                                <td class="td-center">@if(s.UnpaidInvoices>0){<span class="unpaid-badge-luxury">@s.UnpaidInvoices</span>}else{<span class="no-val">0</span>}</td>
                                <td class="td-center"><span class="rating-gold">@(new string('★', s.Rating))</span></td>
                                <td class="td-actions"><div class="actions-wrap-luxury">
                                    <button class="act-btn view" @onclick='() => Navigation.NavigateTo($"/suppliers/view/{s.SupplierID}")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
                                    @if (permissions.CanEdit){<button class="act-btn edit" @onclick='() => Navigation.NavigateTo($"/suppliers/edit/{s.SupplierID}")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                    @if (permissions.CanDelete){<button class="act-btn delete" @onclick="() => ShowDelete(s)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table></div></div>
            }
        }
    </div>

    @if (showDeleteDialog)
    {
        <div class="modal-overlay-luxury" @onclick="() => showDeleteDialog = false"><div class="modal-card-luxury small" @onclick:stopPropagation="true">
            <div class="ml-gold-line danger"></div>
            <div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div>
            <h4>حذف المورد</h4><p>هل تريد حذف: <strong class="delete-name">@deleteItem?.SupplierNameAr</strong>؟</p>
            @if (!string.IsNullOrEmpty(deleteMsg)) { <div class="msg-luxury msg-error">@deleteMsg</div> }
            <div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDelete">حذف</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showDeleteDialog = false">إلغاء</button></div>
        </div></div>
    }

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast = ""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.2rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.74rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-luxury:disabled{opacity:.6;cursor:not-allowed}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-primary-luxury:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(212,175,55,.35)}.btn-export-luxury{background:linear-gradient(135deg,#059669,#10b981);color:#fff}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-ghost-luxury:hover{background:#fcfaf6;border-color:var(--gold)}.btn-danger-luxury{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}.btn-luxury svg{width:14px;height:14px}.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
.st-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.st-icon.dark{background:linear-gradient(135deg,var(--black2),var(--black3));color:var(--gold);border:1px solid var(--border-gold)}.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.st-icon.cyan{background:#ecfeff;color:#0891b2;border:1px solid #a5f3fc}.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.15)}.st-icon.red{background:#fef2f2;color:#ef4444;border:1px solid #fecaca}.st-icon svg{width:18px;height:18px}.st-info{display:flex;flex-direction:column}.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}.st-gold-line{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}.stat-luxury:hover .st-gold-line{opacity:.8}
