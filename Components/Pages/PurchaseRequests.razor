@page "/purchase-requests"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PurchaseRequestService PrService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>طلبات الشراء - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول أولاً</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4><button class="btn-luxury btn-ghost-luxury" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة للرئيسية</button></div>}
else
{
    <div class="luxury-page" dir="rtl">
        <div class="luxury-header-hybrid" style="overflow:visible !important">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content" style="overflow:visible !important">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">طلبات الشراء</h2><p class="lh-subtitle">بداية دورة المشتريات - طلب احتياج من الأقسام للاعتماد</p></div>
                </div>
                <div class="lh-actions" style="overflow:visible !important">
                    <span class="lh-badge"><span class="lh-dot"></span>@filtered.Count طلب</span>
                    @if (permissions.CanExport)
                    {
                        <button class="btn-luxury btn-export-luxury" @onclick="ExportExcel" disabled="@isExporting">
                            @if (isExporting){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>}
                            Excel
                        </button>
                    }
                    @if (permissions.CanAdd)
                    {
                        <button class="btn-luxury btn-primary-luxury" @onclick="AddNew">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>طلب جديد
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="workflow-luxury">
            <div class="wf-step active"><span class="wf-num">1</span><span>طلب شراء</span><div class="wf-line"></div></div>
            <div class="wf-step @(ordersCount>0?"done":"")"><span class="wf-num">2</span><span>أمر شراء</span><div class="wf-line"></div></div>
            <div class="wf-step"><span class="wf-num">3</span><span>استلام</span><div class="wf-line"></div></div>
            <div class="wf-step"><span class="wf-num">4</span><span>فاتورة</span><div class="wf-line"></div></div>
            <div class="wf-step"><span class="wf-num">5</span><span>مرتجع</span></div>
        </div>

        @if (requests != null)
        {
            <div class="stats-luxury">
                <div class="stat-luxury"><div class="st-icon gray"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/></svg></div><div class="st-info"><span class="st-value">@requests.Count(r => r.RequestStatus == 1)</span><span class="st-label">مسودة</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><div class="st-info"><span class="st-value">@requests.Count(r => r.RequestStatus == 2)</span><span class="st-label">انتظار اعتماد</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div class="st-info"><span class="st-value">@requests.Count(r => r.RequestStatus == 3)</span><span class="st-label">معتمد</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div><div class="st-info"><span class="st-value">@requests.Count(r => r.RequestStatus == 4)</span><span class="st-label">مرفوض</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div class="st-info"><span class="st-value">@requests.Count(r => r.RequestStatus == 5)</span><span class="st-label">تم التنفيذ</span></div><div class="st-gold-line"></div></div>
            </div>
        }

        <div class="filter-luxury">
            <div class="search-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input type="text" placeholder="بحث برقم الطلب أو الطالب أو القسم..." @bind="searchText" @bind:event="oninput" @onkeyup="Filter" />@if (!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}</div>
            <div class="select-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M7 12h10"/><path d="M10 18h4"/></svg><select @bind="filterStatus" @bind:after="Filter"><option value="0">كل الحالات</option><option value="1">مسودة</option><option value="2">انتظار اعتماد</option><option value="3">معتمد</option><option value="4">مرفوض</option><option value="5">تم التنفيذ</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><select @bind="filterPriority" @bind:after="Filter"><option value="0">كل الأولويات</option><option value="1">عاجل</option><option value="2">عادي</option><option value="3">غير عاجل</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        @if (requests == null)
        {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else if (!filtered.Any())
        {<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h4>لا توجد طلبات شراء</h4><p style="font-size:.82rem;color:#8B95A5">ابدأ بإنشاء طلب جديد لبدء دورة المشتريات</p></div>}
        else
        {
            <div class="table-card-luxury">
                <div class="table-responsive">
                    <table class="table-luxury">
                        <thead><tr><th class="th-num">#</th><th>رقم الطلب</th><th>التاريخ</th><th>مطلوب بتاريخ</th><th>الطالب</th><th>القسم</th><th class="th-center">أصناف</th><th class="th-center">الأولوية</th><th class="th-center">الحالة</th><th class="th-actions">إجراءات</th></tr></thead>
                        <tbody>
                            @{int n=0;}
                            @foreach (var req in filtered){n++;
                                <tr class="@(req.RequestStatus==1?"row-draft":"")">
                                    <td class="td-num">@n</td>
                                    <td><span class="doc-num-luxury" @onclick="() => ViewRequest(req.RequestID)">@req.RequestNumber</span></td>
                                    <td class="td-muted">@req.RequestDate.ToString("dd/MM/yyyy")</td>
                                    <td class="td-muted">@(req.RequiredDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td class="td-name">@(req.RequestedByName ?? "—")</td>
                                    <td class="td-muted">@(req.DepartmentName ?? "—")</td>
                                    <td class="td-center"><span class="cnt-badge-luxury">@req.ItemCount</span></td>
                                    <td class="td-center"><span class="priority-dot" style="--pc:@PurchaseRequestService.GetPriorityColor(req.Priority)">@PurchaseRequestService.GetPriorityName(req.Priority)</span></td>
                                    <td class="td-center"><span class="status-badge-luxury" style="--sc:@PurchaseRequestService.GetStatusColor(req.RequestStatus)">@PurchaseRequestService.GetStatusName(req.RequestStatus)</span></td>
                                    <td class="td-center"><div class="actions-wrap-luxury">
                                        @if (permissions.CanEdit && req.RequestStatus == 1){<button class="act-btn edit" title="تعديل" @onclick="() => EditRequest(req.RequestID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                        else{<button class="act-btn view" title="عرض" @onclick="() => ViewRequest(req.RequestID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>}
                                        @if (permissions.CanPrint){<button class="act-btn print" title="طباعة" @onclick="() => PrintRequest(req.RequestID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg></button>}
                                        @if (permissions.CanApprove && req.RequestStatus == 2){<button class="act-btn approve" title="اعتماد" @onclick="() => ViewRequest(req.RequestID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></button>}
                                        @if (permissions.CanDelete && req.RequestStatus == 1){<button class="act-btn delete" title="حذف" @onclick="() => ShowDeleteDialog(req)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}
                                    </div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    @if (showDeleteDialog)
    {
        <div class="modal-overlay-luxury" @onclick="CloseDeleteDialog"><div class="modal-card-luxury small" @onclick:stopPropagation="true">
            <div class="ml-gold-line danger"></div>
            <div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div>
            <h4>تأكيد الحذف</h4><p>هل أنت متأكد من حذف الطلب: <strong class="delete-name">@deleteRequest?.RequestNumber</strong>؟</p>
            @if (!string.IsNullOrEmpty(deleteMsg)){<div class="msg-luxury msg-error">@deleteMsg</div>}
            <div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDelete">تأكيد الحذف</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseDeleteDialog">إلغاء</button></div>
        </div></div>
    }

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast = ""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto;position:relative}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:visible !important;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25);z-index:5}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;overflow:visible !important}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.2rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.74rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;overflow:visible !important}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-luxury:disabled{opacity:.6;cursor:not-allowed}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-primary-luxury:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(212,175,55,.35)}.btn-export-luxury{background:linear-gradient(135deg,#059669,#10b981);color:#fff}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-ghost-luxury:hover{background:#fcfaf6;border-color:var(--gold)}.btn-danger-luxury{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}.btn-luxury svg{width:14px;height:14px}.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.workflow-luxury{display:flex;align-items:center;gap:0;background:#fff;border:1px solid #e8e2d0;border-radius:14px;padding:10px 16px;overflow-x:auto}
.wf-step{display:flex;align-items:center;gap:8px;font-size:.78rem;font-weight:700;color:#9ca3af;white-space:nowrap}
.wf-step.active{color:var(--gold-dark)}.wf-step.done{color:#059669}
.wf-num{width:24px;height:24px;border-radius:50%;background:#f3f4f6;border:1px solid #e5e7eb;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:900}
.wf-step.active .wf-num{background:rgba(212,175,55,.15);border-color:rgba(212,175,55,.25);color:var(--gold-dark)}
.wf-step.done .wf-num{background:#ecfdf5;border-color:#a7f3d0;color:#059669}
.wf-line{width:24px;height:2px;background:#e5e7eb;margin:0 8px}.wf-step.done .wf-line{background:#a7f3d0}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
.st-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.st-icon.gray{background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb}.st-icon.amber{background:#fef3c7;color:#d97706;border:1px solid #fde68a}.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.st-icon.red{background:#fef2f2;color:#ef4444;border:1px solid #fecaca}.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.st-icon svg{width:18px;height:18px}.st-info{display:flex;flex-direction:column}.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}.st-gold-line{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}.stat-luxury:hover .st-gold-line{opacity:.8}
.filter-luxury{display:flex;gap:10px;flex-wrap:wrap;align-items:center;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:12px}
.search-luxury{flex:1;min-width:260px;position:relative;display:flex;align-items:center}.search-luxury svg{position:absolute;right:12px;width:16px;height:16px;color:#9ca3af;pointer-events:none}.search-luxury input{width:100%;height:40px;padding:0 40px 0 36px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.86rem;font-family:'Tajawal';outline:none;background:#fcfaf6;transition:.2s}.search-luxury input:focus{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.clear-search-luxury{position:absolute;left:8px;width:24px;height:24px;border-radius:50%;border:none;background:#f3f4f6;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.clear-search-luxury svg{width:10px;height:10px}
.select-wrap-luxury{position:relative;display:flex;align-items:center}.select-wrap-luxury svg:first-child{position:absolute;right:10px;width:14px;height:14px;color:#9ca3af;pointer-events:none;z-index:1}.select-wrap-luxury select{height:40px;padding:0 34px 0 28px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.82rem;font-family:'Tajawal';background:#fff;appearance:none;cursor:pointer;outline:none;min-width:130px}.select-wrap-luxury select:focus{border-color:var(--gold)}.select-wrap-luxury .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.table-luxury{width:100%;border-collapse:collapse;min-width:900px}.table-luxury thead{background:linear-gradient(135deg,#fcfaf6,#f8f6f0)}.table-luxury th{padding:12px 14px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;white-space:nowrap}.table-luxury td{padding:12px 14px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}.table-luxury tbody tr:hover{background:rgba(212,175,55,.03)}.table-luxury .row-draft{opacity:.8}.th-num{width:45px;text-align:center}.th-center{text-align:center}.th-actions{text-align:center;width:160px}.td-num{text-align:center;color:#9ca3af;font-size:.78rem}.td-center{text-align:center}.td-name{font-weight:700;color:#0A0F1E}.td-muted{color:#9ca3af;font-size:.82rem}
.doc-num-luxury{color:var(--gold-dark);font-weight:800;font-size:.86rem;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:8px;cursor:pointer;transition:.2s}.doc-num-luxury:hover{background:rgba(212,175,55,.15);border-color:var(--gold)}
.cnt-badge-luxury{background:#f1f5f9;color:#475569;padding:3px 10px;border-radius:6px;font-size:.74rem;font-weight:700}
