<script>
    window.downloadFile = (fileName, mimeType, base64Data) => {
        const link = document.createElement('a');
        link.download = fileName;
        link.href = `data:${mimeType};base64,${base64Data}`;
        link.click();
    };
    
    window.printHtml = (html) => {
        const printWindow = window.open('', '_blank');
        printWindow.document.write(html);
        printWindow.document.close();
        printWindow.print();
    };
    
    window.generateBarcode = (code, elementId) => {
        // Use JsBarcode library if available
        if (typeof JsBarcode !== 'undefined') {
            JsBarcode(`#${elementId}`, code, {
                format: "CODE128",
                lineColor: "#0f172a",
                width: 1.5,
                height: 40,
                displayValue: true,
                fontSize: 12,
                margin: 10
            });
        }
    };
</script>

@code {
    private List<ItemListDto>? items;
    private List<ItemListDto> filteredItems = new();
    private ModulePermissionDto? permissions;
    
    // Filters
    private string searchText = "";
    private int filterType = 0;
    private string sortColumn = "ItemNameAr";
    private bool sortAsc = true;
    
    // Bulk actions
    private HashSet<int> selectedItems = new();
    
    // Export
    private bool isExporting = false;
    
    // Dropdown
    private int? activeDropdownId = null;
    
    // Barcode modal
    private bool showBarcodeModal = false;
    private ItemListDto? barcodeItem;
    
    // Action modal (delete/deactivate)
    private bool showActionModal = false;
    private bool isDeactivateAction = false;
    private bool isBulkAction = false;
    private int? actionItemId;
    private string actionItemName = "";
    private string deactivateReason = "";
    private string actionModalError = "";
    private bool isActionLoading = false;
    
    // Notification
    private string resultMessage = "";
    private bool resultIsError = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_ITEMS");

        if (permissions != null && permissions.CanView)
        {
            await LoadItems();
        }
    }

    private async Task LoadItems()
    {
        items = await ItemService.GetItemsListAsync();
        Search();
    }

    private void Search()
    {
        if (items == null) return;

        var result = items.Where(i =>
            (filterType == 0 || i.ItemType == filterType) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(i.ItemNameAr, searchText) ||
             ArabicSearchHelper.Contains(i.ItemNameEn, searchText) ||
             ArabicSearchHelper.Contains(i.ItemCode, searchText))
        );

        filteredItems = ApplySort(result).ToList();
    }

    private IEnumerable<ItemListDto> ApplySort(IEnumerable<ItemListDto> data)
    {
        return sortColumn switch
        {
            "ItemCode" => sortAsc ? data.OrderBy(i => i.ItemCode) : data.OrderByDescending(i => i.ItemCode),
            "ItemNameAr" => sortAsc ? data.OrderBy(i => i.ItemNameAr) : data.OrderByDescending(i => i.ItemNameAr),
            "AverageCost" => sortAsc ? data.OrderBy(i => i.AverageCost) : data.OrderByDescending(i => i.AverageCost),
            _ => data.OrderBy(i => i.ItemNameAr)
        };
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
        Search();
    }

    private string SortIcon(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? "▲" : "▼";
    }

    private void ClearSearch()
    {
        searchText = "";
        Search();
    }

    private void ClearAllFilters()
    {
        searchText = "";
        filterType = 0;
        Search();
    }

    private bool HasActiveFilters()
    {
        return filterType > 0 || !string.IsNullOrEmpty(searchText);
    }

    private string GetTypeName(int type) => type switch
    {
        1 => "مواد خام",
        2 => "مواد تعبئة",
        3 => "نصف مصنع",
        4 => "منتج تام",
        _ => "غير محدد"
    };

    private string GetTypeClass(int type) => type switch
    {
        1 => "type-raw",
        2 => "type-pkg",
        3 => "type-semi",
        4 => "type-fin",
        _ => ""
    };

    // ========== Bulk Actions ==========
    private void ToggleSelection(int itemId, bool isSelected)
    {
        if (isSelected)
            selectedItems.Add(itemId);
        else
            selectedItems.Remove(itemId);
        StateHasChanged();
    }

    private void ToggleSelectAll()
    {
        if (selectedItems.Count == filteredItems.Count)
            selectedItems.Clear();
        else
            selectedItems = new HashSet<int>(filteredItems.Select(i => i.ItemID));
        StateHasChanged();
    }

    private void ClearSelection()
    {
        selectedItems.Clear();
        StateHasChanged();
    }

    private void ShowBulkDeactivateConfirm()
    {
        isDeactivateAction = true;
        isBulkAction = true;
        actionItemName = $"{selectedItems.Count} صنف";
        showActionModal = true;
        deactivateReason = "";
        actionModalError = "";
    }

    private void ShowBulkDeleteConfirm()
    {
        isDeactivateAction = false;
        isBulkAction = true;
        actionItemName = $"{selectedItems.Count} صنف";
        showActionModal = true;
        actionModalError = "";
    }

    // ========== Single Actions ==========
    private void ShowDeactivateConfirm(int itemId, string itemName)
    {
        isDeactivateAction = true;
        isBulkAction = false;
        actionItemId = itemId;
        actionItemName = itemName;
        showActionModal = true;
        deactivateReason = "";
        actionModalError = "";
    }

    private void ShowDeleteConfirm(int itemId, string itemName, bool isBulk = false)
    {
        isDeactivateAction = false;
        isBulkAction = isBulk;
        actionItemId = itemId;
        actionItemName = itemName;
        showActionModal = true;
        actionModalError = "";
    }

    private async Task ConfirmAction()
    {
        isActionLoading = true;
        actionModalError = "";
        
        try
        {
            if (isBulkAction)
            {
                if (isDeactivateAction)
                {
                    foreach (var id in selectedItems)
                    {
                        await ItemService.DeactivateItemAsync(id, UserSession.UserID);
                    }
                    resultMessage = $"تم تعطيل {selectedItems.Count} صنف بنجاح ✅";
                    resultIsError = false;
                }
                else
                {
                    var deleted = 0;
                    var deactivated = 0;
                    foreach (var id in selectedItems)
                    {
                        var result = await ItemService.DeleteItemAsync(id, UserSession.UserID);
                        if (result) deleted++;
                        else deactivated++;
                    }
                    resultMessage = $"تم حذف {deleted} صنف، وتعطيل {deactivated} صنف (مرتبط بحركات)";
                    resultIsError = false;
                }
                ClearSelection();
            }
            else
            {
                if (actionItemId.HasValue)
                {
                    if (isDeactivateAction)
                    {
                        await ItemService.DeactivateItemAsync(actionItemId.Value, UserSession.UserID);
                        resultMessage = $"تم تعطيل الصنف: {actionItemName} ✅";
                        resultIsError = false;
                    }
                    else
                    {
                        var deleted = await ItemService.DeleteItemAsync(actionItemId.Value, UserSession.UserID);
                        resultMessage = deleted
                            ? $"تم حذف الصنف: {actionItemName} ✅"
                            : $"الصنف مرتبط بحركات - تم إيقاف تنشيطه بدلاً من الحذف ⚠️";
                        resultIsError = false;
                    }
                }
            }
            
            await LoadItems();
            showActionModal = false;
        }
        catch (Exception ex)
        {
            actionModalError = "خطأ: " + ex.Message;
        }
        finally
        {
            isActionLoading = false;
        }
    }

    private void CloseActionModal()
    {
        showActionModal = false;
        actionItemId = null;
        actionItemName = "";
        deactivateReason = "";
        actionModalError = "";
        isActionLoading = false;
    }

    // ========== Dropdown ==========
    private void ToggleDropdown(int itemId)
    {
        activeDropdownId = activeDropdownId == itemId ? null : itemId;
    }

    // ========== Navigation ==========
    private void AddNewItem() => Navigation.NavigateTo("/items/new");
    private void EditItem(int itemId) => Navigation.NavigateTo($"/items/edit/{itemId}");
    
    // ========== Barcode ==========
    private async Task ShowBarcodeModal(ItemListDto item)
    {
        barcodeItem = item;
        showBarcodeModal = true;
        await Task.Delay(100);
        await JS.InvokeVoidAsync("generateBarcode", item.ItemCode, "barcodeSvg");
    }
    
    private void CloseBarcodeModal()
    {
        showBarcodeModal = false;
        barcodeItem = null;
    }
    
    private async Task PrintBarcode()
    {
        var html = $@"
        <html dir='rtl'>
        <head><title>باركود {barcodeItem?.ItemNameAr}</title></head>
        <body style='text-align:center;padding:20px;font-family:sans-serif'>
            <h3>{barcodeItem?.ItemNameAr}</h3>
            <div style='font-size:24px;font-family:monospace;margin:20px'>{barcodeItem?.ItemCode}</div>
            <div id='barcode'></div>
            <script>
                var JsBarcode = window.parent.JsBarcode;
                JsBarcode('#barcode', '{barcodeItem?.ItemCode}', {{ format: 'CODE128', width: 2, height: 50 }});
            </script>
        </body>
        </html>";
        await JS.InvokeVoidAsync("printHtml", html);
    }

    // ========== Print & Export ==========
    private async Task PrintItem(int itemId)
    {
        try
        {
            var html = await ItemService.GenerateItemReportHtmlAsync(itemId, UserSession.UserID);
            await JS.InvokeVoidAsync("printHtml", html);
        }
        catch (Exception ex)
        {
            resultMessage = "خطأ في الطباعة: " + ex.Message;
            resultIsError = true;
        }
    }

    private async Task ExportToExcel()
    {
        if (filteredItems == null || !filteredItems.Any()) return;

        isExporting = true;
        StateHasChanged();

        try
        {
            var itemsToExport = selectedItems.Any() ? filteredItems.Where(i => selectedItems.Contains(i.ItemID)).ToList() : filteredItems;
            var fileBytes = await ItemService.ExportItemsToExcelAsync(itemsToExport, UserSession.UserID);
            var base64 = Convert.ToBase64String(fileBytes);
            await JS.InvokeVoidAsync("downloadFile", $"Items_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
            resultMessage = $"تم تصدير {itemsToExport.Count} صنف بنجاح ✅";
            resultIsError = false;
        }
        catch (Exception ex)
        {
            resultMessage = "خطأ في التصدير: " + ex.Message;
            resultIsError = true;
        }
        finally
        {
            isExporting = false;
        }
    }
}