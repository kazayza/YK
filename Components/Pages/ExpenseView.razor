.expense-hero{position:relative;overflow:hidden;padding:22px 26px 18px;border:1px solid rgba(212,175,55,.22);border-radius:24px;background:radial-gradient(ellipse at 12% 20%,rgba(212,175,55,.16),transparent 34%),linear-gradient(130deg,#070B14 0%,#0A0F1E 57%,#172033 100%);color:#F5E6C8;box-shadow:0 20px 48px rgba(7,11,20,.12)}
.expense-hero:before{content:"";position:absolute;inset:0 0 auto;height:2px;background:linear-gradient(90deg,transparent 4%,#8f722b 32%,#f0d477 50%,#8f722b 68%,transparent 96%)}
.expense-hero:after{content:"";position:absolute;width:330px;height:330px;border:1px solid rgba(212,175,55,.08);border-radius:50%;top:18px;left:-155px;box-shadow:0 0 0 28px rgba(212,175,55,.025),0 0 0 58px rgba(212,175,55,.018);pointer-events:none}
.hero-topline,.hero-main,.hero-bottomline{position:relative;z-index:1}.hero-topline{display:flex;justify-content:space-between;align-items:center;gap:12px;padding-bottom:18px;border-bottom:1px solid rgba(255,255,255,.09)}
.brand-lockup{display:flex;align-items:center;gap:11px}.brand-monogram,.footer-mark{display:grid;place-items:center;width:42px;height:42px;border:1px solid rgba(212,175,55,.35);border-radius:14px;background:linear-gradient(145deg,rgba(212,175,55,.18),rgba(212,175,55,.04));color:var(--gold);font:900 .86rem 'Tajawal',sans-serif;letter-spacing:.06em}
.brand-copy{display:flex;flex-direction:column;gap:2px}.brand-copy strong{color:#f4e2b5;font-size:.75rem;letter-spacing:.14em}.brand-copy small{color:#8290a4;font-size:.58rem;letter-spacing:.11em;font-weight:800}
.readonly-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid rgba(255,255,255,.14);border-radius:999px;background:rgba(255,255,255,.045);color:#d8dce4;font-size:.72rem;font-weight:800}.readonly-dot{width:7px;height:7px;border-radius:50%;background:#8dd7b0;box-shadow:0 0 0 4px rgba(141,215,176,.1)}
.hero-main{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,340px);align-items:center;gap:22px;padding:24px 0 20px}.hero-eyebrow{display:block;color:var(--gold);font-size:.7rem;font-weight:900;letter-spacing:.09em}.hero-heading h1{margin:7px 0 17px;color:#fff;font-size:clamp(1.55rem,3vw,2.05rem);font-weight:900;letter-spacing:-.025em}.hero-document-number{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.hero-document-number span{color:#8993a3;font-size:.72rem;font-weight:700}.hero-document-number strong{padding:6px 11px;border:1px solid rgba(212,175,55,.22);border-radius:9px;background:rgba(212,175,55,.08);color:#f2dc9a;font-size:.82rem;letter-spacing:.03em}
