@page "/expenses/view/{Id:int}"
@using YKCoatings.Models
@using YKCoatings.Services
@inject AccountingService AccountingService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>عرض المصروف - Gold Edition Pro</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="expense-view-message" dir="rtl"><h4>يجب تسجيل الدخول</h4><p>سجّل الدخول لعرض تفاصيل المصروف.</p></div>
}
else if (!permissionsChecked)
{
    <div class="expense-view-message" dir="rtl"><span class="message-eyebrow">GOLD EDITION</span><h4>التحقق من الصلاحيات</h4><p>جارٍ تجهيز العرض الآمن للمصروف...</p></div>
}
else if (!canViewExpenses)
{
    <div class="expense-view-message" dir="rtl"><span class="message-eyebrow">ACCESS CONTROL</span><h4>لا تتوفر صلاحية عرض المصروفات</h4><p>هذه الصفحة للقراءة فقط وتتطلب صلاحية عرض المصروفات.</p></div>
}
else if (isLoading)
{
    <div class="expense-view-message" dir="rtl"><span class="message-loader"></span><h4>جارٍ تحميل المصروف</h4><p>نحمّل تفاصيل المستند وسجله المحاسبي.</p></div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="expense-view-message error" dir="rtl"><span class="message-eyebrow">LOAD ERROR</span><h4>تعذر تحميل المصروف</h4><p>@errorMessage</p><button class="expense-action quiet" @onclick='() => Navigation.NavigateTo("/expenses")'>العودة إلى المصروفات</button></div>
}
else if (expense is null)
{
    <div class="expense-view-message" dir="rtl"><span class="message-eyebrow">DOCUMENT NOT FOUND</span><h4>المصروف غير موجود</h4><p>قد يكون رقم المستند غير صحيح أو لا يتوفر ضمن السجلات المسموح بعرضها.</p><button class="expense-action quiet" @onclick='() => Navigation.NavigateTo("/expenses")'>العودة إلى المصروفات</button></div>
}
else
{
    <main class="yk-gold-page expense-view-page" dir="rtl">
        <header class="expense-hero">
            <div class="hero-topline">
                <div class="brand-lockup">
                    <span class="brand-monogram" aria-hidden="true">YK</span>
                    <span class="brand-copy"><strong>GOLD EDITION</strong><small>ACCOUNTING DOCUMENT</small></span>
                </div>
                <span class="readonly-badge"><span class="readonly-dot"></span>عرض للقراءة فقط</span>
            </div>

            <div class="hero-main">
                <div class="hero-heading">
                    <span class="hero-eyebrow">تفاصيل المستند المالي</span>
                    <h1>عرض المصروف</h1>
                    <div class="hero-document-number"><span>رقم المصروف</span><strong>@(expense.ExpenseNumber ?? "—")</strong></div>
                </div>
                <div class="hero-amount-card">
                    <span class="hero-amount-label">إجمالي المصروف</span>
                    <strong class="hero-amount-value">@expense.Amount.ToString("#,##0.00") <small>ج.م</small></strong>
                    <span class="status-pill @GetStatusClass(expense.ExpenseStatus)">@GetStatusName(expense.ExpenseStatus)</span>
                </div>
            </div>
            <div class="hero-bottomline">
                <span class="hero-note">بيانات هذا المستند معروضة فقط؛ لا تتوفر هنا عمليات تعديل أو حفظ.</span>
                <button class="hero-back-button" @onclick='() => Navigation.NavigateTo("/expenses")'>العودة إلى المصروفات</button>
            </div>
        </header>

        <section class="expense-section-grid" aria-label="تفاصيل المصروف">
            <article class="detail-card">
                <div class="section-heading">
                    <span class="section-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M7 3.75h7l4.25 4.3v12.2H7a2 2 0 0 1-2-2v-12.5a2 2 0 0 1 2-2Z"/><path d="M14 3.9v4.5h4.2M8.5 12h7M8.5 15.5h7"/></svg>
                    </span>
                    <div><h2>بيانات المستند</h2><p>التاريخ والفترة والمرجع</p></div>
                </div>
                <div class="detail-list">
                    <div class="detail-row"><span>تاريخ المصروف</span><strong>@expense.ExpenseDate.ToString("dd/MM/yyyy")</strong></div>
                    <div class="detail-row"><span>الفترة المالية</span><strong>@(expense.PeriodName ?? "—")</strong></div>
                    <div class="detail-row"><span>السنة المالية</span><strong>@(expense.FiscalYearName ?? "—")</strong></div>
                    <div class="detail-row"><span>رقم المرجع</span><strong>@(expense.Reference ?? "—")</strong></div>
                </div>
            </article>

            <article class="detail-card">
                <div class="section-heading">
                    <span class="section-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M4 7.5h16M6.5 4.5v6M17.5 4.5v6M5.5 20h13a1.5 1.5 0 0 0 1.5-1.5V7.5H4v11A1.5 1.5 0 0 0 5.5 20Z"/><path d="m8.5 14 2.2 2.2 4.8-4.8"/></svg>
                    </span>
                    <div><h2>التوجيه المحاسبي</h2><p>الحسابات ومركز التكلفة</p></div>
                </div>
                <div class="detail-list">
                    <div class="detail-row account-row"><span>حساب المصروف</span><strong>@(expense.ExpenseAccountNameAr ?? "—")</strong><small>@(expense.ExpenseAccountCode ?? "")</small></div>
                    <div class="detail-row account-row"><span>الحساب الدائن</span><strong>@(expense.CreditAccountNameAr ?? expense.CashBoxNameAr ?? expense.BankName ?? "—")</strong><small>@(expense.CreditAccountCode ?? "")</small></div>
                    <div class="detail-row"><span>مركز التكلفة</span><strong>@(expense.CostCenterNameAr ?? "—")</strong></div>
                    <div class="detail-row"><span>رقم القيد</span><strong class="reference-value">@(expense.JournalNumber ?? "—")</strong></div>
                </div>
            </article>

            <article class="detail-card">
                <div class="section-heading">
                    <span class="section-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="14" rx="2"/><path d="M3.5 9h17M7 14h3M15 14h2"/></svg>
                    </span>
                    <div><h2>وسيلة السداد</h2><p>مصدر السداد المرتبط بالمصروف</p></div>
                </div>
                <div class="detail-list">
                    <div class="detail-row"><span>طريقة الدفع</span><strong>@GetPaymentMethodName(expense.PaymentMethod)</strong></div>
                    <div class="detail-row"><span>الخزينة</span><strong>@(expense.CashBoxNameAr ?? "—")</strong></div>
                    <div class="detail-row"><span>البنك</span><strong>@(expense.BankName ?? "—")</strong></div>
                </div>
                @if (expense.CashBoxID.HasValue && PermissionService.CanViewCashBoxStatement)
                {
                    <button class="inline-link-button" @onclick='() => Navigation.NavigateTo($"/cash-box-statement?cashBoxId={expense.CashBoxID.Value}")'>فتح كشف حركات الخزينة <span aria-hidden="true">←</span></button>
                }
            </article>

            <article class="detail-card audit-card">
                <div class="section-heading">
                    <span class="section-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.25"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0M19 4.5v4M17 6.5h4"/></svg>
                    </span>
                    <div><h2>سجل المستند</h2><p>معلومات الإنشاء والاعتماد</p></div>
                </div>
                <div class="detail-list">
                    <div class="detail-row"><span>أُنشئ بواسطة</span><strong>@(expense.CreatedByName ?? "—")</strong></div>
                    <div class="detail-row"><span>تاريخ الإنشاء</span><strong>@expense.CreatedDate.ToString("dd/MM/yyyy · HH:mm")</strong></div>
                    <div class="detail-row"><span>تاريخ الاعتماد</span><strong>@(expense.ApprovedDate?.ToString("dd/MM/yyyy · HH:mm") ?? "—")</strong></div>
                </div>
            </article>
        </section>

        <section class="narrative-card">
            <div class="narrative-heading"><span class="narrative-overline">DOCUMENT NARRATIVE</span><h2>البيان والملاحظات</h2></div>
            <div class="narrative-content">
                <div><span>البيان</span><p>@(string.IsNullOrWhiteSpace(expense.Description) ? "لا يوجد بيان مسجل لهذا المصروف." : expense.Description)</p></div>
                @if (!string.IsNullOrWhiteSpace(expense.Notes))
                {
                    <div class="notes-block"><span>ملاحظات إضافية</span><p>@expense.Notes</p></div>
                }
            </div>
        </section>

        <footer class="expense-view-footer">
            <div class="footer-caption"><span class="footer-mark" aria-hidden="true">YK</span><span><strong>سجل مصروف</strong><small>واجهة عرض آمنة — لا تغيّر بيانات المستند</small></span></div>
            <div class="footer-actions">
                @if (expense.JournalID.HasValue && PermissionService.CanView("SCR_JV"))
                {
                    <button class="expense-action primary" @onclick='() => Navigation.NavigateTo($"/journal-entries/{expense.JournalID.Value}")'>عرض القيد المرتبط</button>
                }
                <button class="expense-action quiet" @onclick='() => Navigation.NavigateTo("/expenses")'>العودة إلى المصروفات</button>
            </div>
        </footer>
    </main>
}

<style>
:root{--gold:#D4AF37;--gold-deep:#9C7C2E;--ink:#070B14;--ink-soft:#111827;--muted:#737b88;--line:#e9e2d2;--paper:#fff;--paper-warm:#fcfaf5;--gold-wash:rgba(212,175,55,.10)}
