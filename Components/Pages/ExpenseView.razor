.detail-list{display:flex;flex-direction:column}.detail-row{display:grid;grid-template-columns:minmax(105px,.72fr) minmax(0,1.28fr);align-items:center;gap:10px;padding:10px 2px;border-bottom:1px solid #f3f0e9}.detail-row:last-child{border-bottom:0}.detail-row>span{color:#818895;font-size:.72rem;font-weight:700}.detail-row>strong{color:#202635;font-size:.78rem;font-weight:800;text-align:left;overflow-wrap:anywhere}.detail-row.account-row{grid-template-columns:minmax(105px,.72fr) minmax(0,1.28fr);row-gap:3px}.detail-row.account-row strong{grid-column:2}.detail-row.account-row small{grid-column:2;color:#9b8a59;font-size:.67rem;text-align:left;direction:ltr}
.reference-value{color:var(--gold-deep)!important}.inline-link-button{display:flex;align-items:center;justify-content:space-between;width:100%;margin-top:12px;padding:10px 12px;border:1px solid rgba(212,175,55,.2);border-radius:11px;background:var(--paper-warm);color:#80651f;text-align:right;font:800 .72rem 'Tajawal',sans-serif;cursor:pointer;transition:background .18s ease,border .18s ease}.inline-link-button:hover{background:#f8f1dc;border-color:rgba(212,175,55,.42)}.inline-link-button span{font-size:1rem}
.narrative-card{display:grid;grid-template-columns:minmax(170px,.34fr) minmax(0,1fr);overflow:hidden}.narrative-heading{padding:20px;background:linear-gradient(145deg,#0A0F1E,#121b2b);color:#f5e6c8}.narrative-overline{color:var(--gold);font-size:.58rem;letter-spacing:.11em;font-weight:900}.narrative-heading h2{margin:6px 0 0;font-size:.95rem;font-weight:900}.narrative-content{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;padding:18px 20px}.narrative-content>div{min-width:0}.narrative-content span{color:#8a909a;font-size:.68rem;font-weight:800}.narrative-content p{margin:6px 0 0;color:#303744;font-size:.8rem;font-weight:600;line-height:1.8;white-space:pre-line;overflow-wrap:anywhere}.notes-block{padding-right:14px;border-right:2px solid rgba(212,175,55,.38)}
.expense-view-footer{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;padding:13px 16px;border:1px solid var(--line);border-radius:17px;background:var(--paper-warm)}.footer-caption{display:flex;align-items:center;gap:10px}.footer-mark{width:36px;height:36px;border-radius:12px;font-size:.7rem}.footer-caption>span:last-child{display:flex;flex-direction:column;gap:2px}.footer-caption strong{color:#263041;font-size:.75rem;font-weight:900}.footer-caption small{color:#9298a2;font-size:.64rem}.footer-actions{display:flex;gap:8px;flex-wrap:wrap}.expense-action{border-radius:10px;padding:9px 13px;font:800 .72rem 'Tajawal',sans-serif;cursor:pointer;transition:transform .18s ease,box-shadow .18s ease}.expense-action:hover{transform:translateY(-1px)}.expense-action.primary{border:1px solid #927426;background:linear-gradient(135deg,#dfc15e,#b89532);color:#111827;box-shadow:0 5px 12px rgba(156,124,46,.14)}.expense-action.quiet{border:1px solid #e2dccf;background:#fff;color:#384151}
.expense-view-message{max-width:680px;margin:36px auto;padding:32px 26px;border:1px solid var(--line);border-radius:20px;background:linear-gradient(145deg,#fff,#fcfaf5);text-align:center;color:#374151;font-family:'Tajawal',sans-serif;box-shadow:0 14px 35px rgba(15,23,42,.05)}.expense-view-message h4{margin:10px 0 5px;color:#111827;font-weight:900}.expense-view-message p{margin:0 0 12px;color:#737b88;font-size:.84rem;line-height:1.7}.message-eyebrow{color:var(--gold-deep);font-size:.62rem;font-weight:900;letter-spacing:.12em}.message-loader{display:block;width:28px;height:28px;margin:0 auto;border:2px solid #eee8d8;border-top-color:var(--gold);border-radius:50%;animation:expense-spin .7s linear infinite}@@keyframes expense-spin{to{transform:rotate(360deg)}}.expense-view-message.error{border-color:#efd0c8;background:#fff9f7}
@@media(max-width:760px){.expense-view-page{gap:13px;padding:0 0 20px}.expense-hero{padding:17px 16px 15px;border-radius:19px}.hero-topline{padding-bottom:14px}.brand-monogram{width:37px;height:37px}.readonly-badge{font-size:.64rem;padding:7px 9px}.hero-main{grid-template-columns:1fr;gap:14px;padding:19px 0 15px}.hero-amount-card{padding:14px 16px}.hero-bottomline{align-items:flex-start}.hero-note{max-width:100%;line-height:1.65}.expense-section-grid{grid-template-columns:1fr;gap:12px}.detail-card{padding:15px}.narrative-card{grid-template-columns:1fr}.narrative-heading{padding:14px 16px}.narrative-content{padding:15px 16px}.expense-view-footer{align-items:flex-start}.footer-actions{width:100%}.footer-actions .expense-action{flex:1}.detail-row{grid-template-columns:minmax(94px,.72fr) minmax(0,1.28fr)}}
@@media(max-width:420px){.hero-heading h1{font-size:1.45rem}.brand-copy small{font-size:.52rem}.detail-row>span{font-size:.67rem}.detail-row>strong{font-size:.73rem}.hero-document-number{gap:7px}}
</style>

@code {
    [Parameter] public int Id { get; set; }

    private static readonly string[] ExpenseModuleCodes =
    {
        "SCR_EXPENSES", "SCR_EXPENSE", "SCR_OVERHEAD", "SCR_OVERHEAD_EXPENSES"
    };

    private ExpenseListDto? expense;
    private bool permissionsChecked;
    private bool canViewExpenses;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            permissionsChecked = true;
            isLoading = false;
            return;
        }

        try
        {
            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(UserSession.UserID);

            canViewExpenses = PermissionService.Permissions.Any(p =>
                ExpenseModuleCodes.Contains(p.ModuleCode, StringComparer.OrdinalIgnoreCase) && p.CanView);
            permissionsChecked = true;
            if (!canViewExpenses) return;

            expense = (await AccountingService.GetExpensesAsync(expenseId: Id))
                .FirstOrDefault();
        }
        catch (UnauthorizedAccessException)
        {
            canViewExpenses = false;
            permissionsChecked = true;
        }
        catch (Exception ex)
        {
            permissionsChecked = true;
            errorMessage = $"تعذر تحميل تفاصيل المصروف: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string GetStatusName(int status) => status switch
    {
        1 => "مسودة",
        2 => "معتمد",
        3 => "ملغي",
        _ => "غير محدد"
    };

    private static string GetStatusClass(int status) => status switch
    {
        1 => "status-draft",
        2 => "status-approved",
        3 => "status-cancelled",
        _ => "status-unknown"
    };

    private static string GetPaymentMethodName(int? method) => method switch
    {
        1 => "نقدي — خزينة",
        2 => "بنك",
        3 => "آجل — مستحق",
        _ => "—"
    };
}
