.hero-bottomline{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;padding-top:14px;border-top:1px solid rgba(255,255,255,.09)}.hero-note{color:#8e98a8;font-size:.7rem}.hero-back-button{border:1px solid rgba(212,175,55,.34);border-radius:10px;padding:8px 12px;background:rgba(212,175,55,.09);color:#efd98c;font:800 .73rem 'Tajawal',sans-serif;cursor:pointer;transition:background .18s ease,transform .18s ease}.hero-back-button:hover{background:rgba(212,175,55,.16);transform:translateY(-1px)}
