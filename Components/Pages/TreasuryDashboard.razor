@page "/treasury-dashboard"
@page "/treasury"
@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject TreasuryService TreasuryService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<TreasuryDashboard> Logger

<PageTitle>لوحة تحكم الخزينة</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><h4>يجب تسجيل الدخول</h4></div>}
else if (permissionLoadFailed)
{<div class="no-access-luxury" dir="rtl" role="alert"><h4>@permissionLoadError</h4><button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadDashboardPermissionsAsync" disabled="@isLoadingPermissions">إعادة المحاولة</button></div>}
else if (permissionLoadDenied)
{<div class="no-access-luxury" dir="rtl" role="alert"><h4>@permissionLoadError</h4><a class="btn-luxury btn-ghost-luxury" href="/login">تسجيل الدخول مجددًا</a></div>}
else if (!permissionsChecked)
{<div class="loading-luxury" dir="rtl"><p>جاري التحقق من صلاحيات لوحة الخزينة...</p></div>}
else if (dashboardLoadDenied)
{<div class="no-access-luxury" dir="rtl" role="alert"><h4>@dashboardLoadError</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><h4>يلزمك إذن SCR_TREASURY لعرض لوحة الخزينة.</h4></div>}
else
{
    <div class="luxury-page" dir="rtl">
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right"><div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div><div class="lh-text"><h2 class="lh-title">خزينة واي كي —   </h2><p class="lh-subtitle">أرصدة لحظية • سندات قبض/صرف • تحويلات • قيد أوتوماتيك — على الجداول الفعلية</p></div></div>
                <div class="lh-actions">
                    <span class="lh-badge"><span class="lh-dot"></span>@(dashboard is null ? (dashboardLoadFailed ? "غير متاح" : "جارٍ") : dashboard.CashBoxesCount) خزينة</span>
                    @if (CanViewCashBoxes)
                    {
                        <button class="btn-luxury btn-primary-luxury" @onclick='() => Navigation.NavigateTo("/cash-boxes")'>إدارة الخزائن</button>
                    }
                </div>
            </div>
        </div>

        @if (dashboardLoadFailed && dashboard == null)
        {
            <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:12px">
                <span>@dashboardLoadError</span>
                <button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadDashboardAsync" disabled="@isLoadingDashboard">@(isLoadingDashboard ? "جارٍ..." : "إعادة محاولة تحميل لوحة الخزينة")</button>
            </div>
        }
        else if (dashboard == null)
        {
            <div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل أرصدة الخزينة...</p></div>
        }
        else
        {
            @if (dashboardLoadFailed)
            {
                <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:12px">
                    <span>@dashboardLoadError</span>
                    <button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadDashboardAsync" disabled="@isLoadingDashboard">@(isLoadingDashboard ? "جارٍ..." : "إعادة محاولة تحديث اللوحة")</button>
                </div>
            }
            else if (isLoadingDashboard)
            {
                <div class="msg-luxury" role="status">جارٍ تحديث لوحة الخزينة؛ البيانات السابقة ما زالت معروضة.</div>
            }
            <div class="stats-luxury">
                <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></div><div class="st-info"><span class="st-value">@dashboard.TotalCashBalance.ToString("#,##0.00")</span><span class="st-label">إجمالي الأرصدة</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@dashboard.TodayReceipts.ToString("#,##0.00")</span><span class="st-label">مقبوضات اليوم</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@dashboard.TodayPayments.ToString("#,##0.00")</span><span class="st-label">مدفوعات اليوم</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon @(dashboard.TodayNet >=0 ? "green" : "red")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg></div><div class="st-info"><span class="st-value" style="color:@(dashboard.TodayNet>=0?"#059669":"#dc2626")">@dashboard.TodayNet.ToString("#,##0.00")</span><span class="st-label">صافي اليوم</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><div class="st-info"><span class="st-value">@dashboard.PendingVouchers</span><span class="st-label">معلق</span></div><div class="st-gold-line"></div></div>
            </div>

            <div class="treasury-grid">
                <div class="table-card-luxury">
                    <div class="card-head-luxury"><h3>أرصدة الخزائن (فعلي: CashBoxes.CurrentBalance)</h3>@if(CanViewCashBoxes){<button class="btn-luxury btn-ghost-luxury small" @onclick='() => Navigation.NavigateTo("/cash-boxes")'>عرض الكل</button>}</div>
                    <div class="table-responsive"><table class="table-luxury">
                        <thead><tr><th>#</th><th>كود</th><th>الخزينة</th><th>النوع</th><th>الرصيد المحسوب</th><th>مقبوضات</th><th>مدفوعات</th><th>حالة</th></tr></thead>
                        <tbody>
                            @{int n=0;}
                            @foreach(var cb in dashboard.CashBoxes){n++;
                                <tr><td class="td-num">@n</td><td><span class="doc-num-luxury">@cb.CashBoxCode</span></td><td class="td-name">@cb.CashBoxNameAr</td><td><span class="source-badge-luxury" style="--sc:@GetBoxTypeColor(cb.CashBoxType)">@cb.CashBoxTypeName</span></td><td><span class="amount-luxury">@cb.CurrentBalance.ToString("#,##0.00")</span></td><td><span class="amount-luxury paid">@cb.TotalReceipts.ToString("#,##0.00")</span></td><td><span class="amount-luxury remaining">@cb.TotalPayments.ToString("#,##0.00")</span></td><td><span class="status-badge-luxury" style="--sc:@(cb.IsActive?"#10b981":"#6b7280")">@(cb.IsActive?"نشطة":"موقوفة")</span></td></tr>
                            }
                        </tbody>
                    </table></div>
                </div>

                <div class="side-cards">
                    <div class="table-card-luxury">
                        <div class="card-head-luxury"><h3>آخر سندات قبض (ReceiptID/ReceiptNumber)</h3>@if(CanViewReceipts){<button class="btn-luxury btn-ghost-luxury small" @onclick='() => Navigation.NavigateTo("/accounting-vouchers?type=receipt")'>الكل</button>}</div>
                        <div class="mini-list">
                            @foreach(var rv in dashboard.RecentReceipts){
                                <div class="mini-item" style='@(CanViewReceipts ? "cursor:pointer" : "cursor:default")' @onclick='() => OpenReceipt(rv.ReceiptID)'>
                                    <div class="mini-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                                    <div class="mini-info"><span class="mini-title">@rv.ReceiptNumber</span><span class="mini-sub">@(rv.EntityName ?? rv.ReceivedFrom ?? "—") • @rv.ReceiptDate.ToString("dd/MM")</span></div>
                                    <span class="mini-amount green">@rv.Amount.ToString("#,##0.00")</span>
                                </div>
                            }
                            @if(!dashboard.RecentReceipts.Any()){<div class="empty-mini">لا توجد سندات</div>}
                        </div>
                    </div>

                    <div class="table-card-luxury">
                        <div class="card-head-luxury"><h3>آخر سندات صرف (PaymentID/PaymentNumber)</h3>@if(CanViewPayments){<button class="btn-luxury btn-ghost-luxury small" @onclick='() => Navigation.NavigateTo("/accounting-vouchers?type=payment")'>الكل</button>}</div>
                        <div class="mini-list">
                            @foreach(var pv in dashboard.RecentPayments){
                                <div class="mini-item" style='@(CanViewPayments ? "cursor:pointer" : "cursor:default")' @onclick='() => OpenPayment(pv.PaymentID)'>
                                    <div class="mini-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                                    <div class="mini-info"><span class="mini-title">@pv.PaymentNumber</span><span class="mini-sub">@(pv.EntityName ?? pv.PaidTo ?? "—") • @pv.PaymentDate.ToString("dd/MM")</span></div>
                                    <span class="mini-amount red">@pv.Amount.ToString("#,##0.00")</span>
                                </div>
                            }
                            @if(!dashboard.RecentPayments.Any()){<div class="empty-mini">لا توجد سندات</div>}
                        </div>
                    </div>

                    <div class="quick-actions-luxury">
                        @if (PermissionService.CanAdd("SCR_RECV"))
                        {
                            <button class="qact green" @onclick='() => Navigation.NavigateTo("/accounting-vouchers/new/receipt")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg>سند قبض جديد</button>
                        }
                        @if (PermissionService.CanAdd("SCR_PAYV"))
                        {
                            <button class="qact red" @onclick='() => Navigation.NavigateTo("/accounting-vouchers/new/payment")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg>سند صرف جديد</button>
                        }
                        @if (PermissionService.CanAdd("SCR_CASHTRANS"))
                        {
                            <button class="qact gold" @onclick='() => Navigation.NavigateTo("/cash-transfers/new")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3v6H3"/><path d="M7 21v-6h14"/></svg>تحويل بين خزائن</button>
                        }
                        @if (PermissionService.CanViewCashBoxStatement)
                        {
                            <button class="qact blue" @onclick='() => Navigation.NavigateTo("/cash-box-statement")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>كشف حساب خزينة</button>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-logo{width:26px;height:26px;object-fit:contain}
.btn-luxury.small{padding:6px 12px;font-size:.74rem}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.2)}
.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}
.st-icon.red{background:#fef2f2;color:#ef4444;border:1px solid #fecaca}
.st-icon.amber{background:#fef3c7;color:#d97706;border:1px solid #fde68a}
.st-info{display:flex;flex-direction:column}
.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}
.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}
.treasury-grid{display:grid;grid-template-columns:1.6fr .9fr;gap:16px}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}
.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.card-head-luxury{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8}
.card-head-luxury h3{font-size:.92rem;font-weight:800;color:#0A0F1E;display:flex;align-items:center;gap:8px;margin:0}
.card-head-luxury h3 svg{width:16px;height:16px;color:var(--gold-dark)}
.table-responsive{overflow-x:auto}
.table-luxury{width:100%;border-collapse:collapse;min-width:600px}
.table-luxury th{padding:12px 14px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;white-space:nowrap;background:#fcfaf6}
.table-luxury td{padding:12px 14px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6}
.doc-num-luxury{color:var(--gold-dark);font-weight:800;font-size:.86rem;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:8px}
.amount-luxury{font-family:monospace;font-weight:800;color:#0A0F1E;background:#f8f6f0;padding:4px 10px;border-radius:8px;border:1px solid #e8e2d0}
.amount-luxury.paid{background:#ecfdf5;color:#059669;border-color:#a7f3d0}
.amount-luxury.remaining{background:#fef2f2;color:#dc2626;border-color:#fecaca}
.source-badge-luxury{display:inline-block;padding:3px 10px;border-radius:8px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,white)}
.side-cards{display:flex;flex-direction:column;gap:16px}
.mini-list{display:flex;flex-direction:column}
.mini-item{display:flex;align-items:center;gap:10px;padding:12px 16px;border-bottom:1px solid #f3f4f6;cursor:pointer;transition:.15s}
.mini-item:hover{background:#fcfaf6}
.mini-icon{width:36px;height:36px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.mini-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}
.mini-icon.red{background:#fef2f2;color:#ef4444;border:1px solid #fecaca}
.mini-icon svg{width:16px;height:16px}
.mini-info{display:flex;flex-direction:column;flex:1}
.mini-title{font-weight:800;font-size:.84rem;color:#0A0F1E}
.mini-sub{font-size:.7rem;color:#9ca3af}
.mini-amount{font-family:monospace;font-weight:800;padding:4px 8px;border-radius:8px;font-size:.82rem}
.mini-amount.green{background:#ecfdf5;color:#059669}
.mini-amount.red{background:#fef2f2;color:#dc2626}
.empty-mini{text-align:center;padding:20px;color:#9ca3af;font-size:.82rem}
.quick-actions-luxury{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.qact{display:flex;align-items:center;gap:8px;padding:12px;border-radius:14px;border:1.5px solid;font-weight:700;font-size:.82rem;cursor:pointer;font-family:'Tajawal';transition:.2s}
.qact.green{background:#ecfdf5;color:#065f46;border-color:#a7f3d0}
.qact.red{background:#fef2f2;color:#991b1b;border-color:#fecaca}
.qact.gold{background:rgba(212,175,55,.1);color:#9C7C2E;border-color:rgba(212,175,55,.2)}
.qact.blue{background:#eff6ff;color:#1e40af;border-color:#bfdbfe}
.qact:hover{transform:translateY(-1px)}
.qact svg{width:16px;height:16px}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}
.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}
</style>

@code {
    private TreasuryDashboardDto? dashboard;
    private ModulePermissionDto? permissions;
    private bool permissionsChecked;
    private bool isLoadingPermissions;
    private bool permissionLoadFailed, permissionLoadDenied;
    private long permissionRequestVersion;
    private string permissionLoadError = string.Empty;
    private bool isLoadingDashboard;
    private bool dashboardLoadFailed;
    private bool dashboardLoadDenied;
    private string dashboardLoadError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            permissionsChecked = true;
            Navigation.NavigateTo("/login");
            return;
        }

        if (await LoadDashboardPermissionsAsync() && permissions?.CanView == true)
            await LoadDashboardAsync();
    }

    private async Task<bool> LoadDashboardPermissionsAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return false;
        }
        if (isLoadingPermissions) return false;

        var requestVersion = ++permissionRequestVersion;
        var userId = UserSession.UserID;
        isLoadingPermissions = true;
        permissionsChecked = false;
        permissions = null;
        permissionLoadFailed = false;
        permissionLoadDenied = false;
        permissionLoadError = string.Empty;
        StateHasChanged();

        try
        {
            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(userId);

            if (!IsCurrentDashboardPermissionRequest(requestVersion, userId))
            {
                if (requestVersion == permissionRequestVersion && UserSession.IsLoggedIn)
                {
                    permissionLoadFailed = true;
                    permissionLoadError = "تغيرت الجلسة أثناء التحقق من الصلاحيات. أعد المحاولة.";
                }
                return false;
            }

            permissions = PermissionService.GetModule("SCR_TREASURY");
            permissionsChecked = true;
            return true;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied while loading treasury-dashboard permissions for user {UserID}.", userId);
            if (!IsCurrentDashboardPermissionRequest(requestVersion, userId))
            {
                if (requestVersion == permissionRequestVersion && UserSession.IsLoggedIn)
                {
                    permissionLoadFailed = true;
                    permissionLoadError = "تغيرت الجلسة أثناء التحقق من الصلاحيات. أعد المحاولة.";
                }
                return false;
            }
            permissionLoadDenied = true;
            permissionLoadError = "تعذر التحقق من صلاحيات الجلسة. سجّل الدخول مجددًا.";
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load treasury-dashboard permissions for user {UserID}.", userId);
            if (!IsCurrentDashboardPermissionRequest(requestVersion, userId))
            {
                if (requestVersion == permissionRequestVersion && UserSession.IsLoggedIn)
                {
                    permissionLoadFailed = true;
                    permissionLoadError = "تغيرت الجلسة أثناء التحقق من الصلاحيات. أعد المحاولة.";
                }
                return false;
            }
            permissionLoadFailed = true;
            permissionLoadError = "تعذر تحميل صلاحيات لوحة الخزينة. أعد المحاولة.";
            return false;
        }
        finally
        {
            if (requestVersion == permissionRequestVersion)
            {
                isLoadingPermissions = false;
                StateHasChanged();
            }
        }
    }

    private bool IsCurrentDashboardPermissionRequest(long requestVersion, int userId) =>
        requestVersion == permissionRequestVersion && UserSession.IsLoggedIn && UserSession.UserID == userId;

    private async Task RetryLoadDashboardPermissionsAsync()
    {
        if (isLoadingPermissions || !permissionLoadFailed) return;
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (await LoadDashboardPermissionsAsync() && permissions?.CanView == true)
            await LoadDashboardAsync();
    }

    private Task RetryLoadDashboardAsync() => LoadDashboardAsync();

    private async Task LoadDashboardAsync()
    {
        if (permissions?.CanView != true || isLoadingDashboard) return;

        isLoadingDashboard = true;
        dashboardLoadFailed = false;
        dashboardLoadDenied = false;
        dashboardLoadError = string.Empty;
        StateHasChanged();
        try
        {
            var loadedDashboard = await TreasuryService.GetDashboardAsync();
            dashboard = loadedDashboard;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied while loading the treasury dashboard for user {UserID}.", UserSession.UserID);
            dashboard = null;
            dashboardLoadDenied = true;
            dashboardLoadError = "ليس لديك صلاحية عرض لوحة الخزينة.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the treasury dashboard for user {UserID}.", UserSession.UserID);
            dashboardLoadFailed = true;
            dashboardLoadError = dashboard == null
                ? "تعذر تحميل لوحة الخزينة. أعد المحاولة."
                : "تعذر تحديث لوحة الخزينة؛ ما زالت آخر بيانات ناجحة معروضة. أعد المحاولة.";
        }
        finally
        {
            isLoadingDashboard = false;
        }
    }

    private bool CanViewCashBoxes => PermissionService.CanView("SCR_BANKS")
        || PermissionService.CanView("SCR_CASHBOX")
        || PermissionService.CanView("SCR_CASHBOXES");
    private bool CanViewReceipts => PermissionService.CanView("SCR_RECV");
    private bool CanViewPayments => PermissionService.CanView("SCR_PAYV");

    private void OpenReceipt(int receiptId)
    {
        if (CanViewReceipts)
            Navigation.NavigateTo($"/accounting-vouchers/receipt/view/{receiptId}");
    }

    private void OpenPayment(int paymentId)
    {
        if (CanViewPayments)
            Navigation.NavigateTo($"/accounting-vouchers/payment/view/{paymentId}");
    }

    private string GetBoxTypeColor(int type) => type switch { 1 => "#D4AF37", 2 => "#2563eb", 3 => "#059669", 4 => "#7c3aed", _ => "#6b7280" };
}