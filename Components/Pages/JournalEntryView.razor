@page "/journal-entries/{Id:int}"
@page "/journal-entries/view/{Id:int}"
@using YKCoatings.Services
@using YKCoatings.Models
@inject AccountingService AccountingService
@inject UserSessionService UserSession
@inject NavigationManager Navigation

<PageTitle>عرض قيد محاسبي - @Id</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><h4>يجب تسجيل الدخول</h4></div>}
else
{
<div class="luxury-page" dir="rtl">
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-content">
            <div class="lh-right">
                <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                <div class="lh-text">
                    <h2 class="lh-title">عرض قيد محاسبي #@Id</h2>
                    <p class="lh-subtitle">Gold Edition Pro — عرض تفصيلي للقيد وأطرافه</p>
                </div>
            </div>
            <div class="lh-actions">
                <button class="btn-luxury btn-ghost-luxury" @onclick='()=>Navigation.NavigateTo("/journal-entries")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>رجوع للقيود</button>
                @if(journal!=null && journal.JournalStatus==1){
                    <button class="btn-luxury btn-primary-luxury" @onclick='()=>Navigation.NavigateTo($"/journal-entries/edit/{Id}")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>تعديل</button>
                }
            </div>
        </div>
    </div>

    @if (isLoading)
    {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل القيد...</p></div>}
    else if (journal==null)
    {<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h4>القيد غير موجود</h4><p class="empty-sub">ID=@Id غير موجود أو تم حذفه</p><button class="btn-luxury btn-ghost-luxury" @onclick='()=>Navigation.NavigateTo("/journal-entries")' style="margin-top:12px">رجوع</button></div>}
    else
    {
        <div class="form-card-luxury">
            <div class="fc-gold-line"></div>
            <div class="fc-header"><h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>بيانات القيد — @journal.JournalNumber</h3>
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    <span class="doc-num-luxury">@journal.JournalNumber</span>
                    <span class="level-badge">@journal.JournalDate.ToString("dd/MM/yyyy")</span>
                    @if(journal.JournalStatus==1){<span class="status-badge-luxury" style="--sc:#6b7280"><span class="status-dot" style="--sc:#6b7280"></span>مسودة</span>}
                    else if(journal.JournalStatus==2){<span class="status-badge-luxury" style="--sc:#10b981"><span class="status-dot" style="--sc:#10b981"></span>مرحل</span>}
                    else{<span class="status-badge-luxury" style="--sc:#dc2626"><span class="status-dot" style="--sc:#dc2626"></span>ملغي</span>}
                    @if(journal.IsAutoGenerated){<span class="coa-detail group">أوتوماتيك — @journal.SourceDocType @journal.SourceDocNumber</span>}
                </div>
            </div>
            <div class="fc-body">
                <div class="form-grid-luxury">
                    <div class="fg"><label>رقم القيد</label><input type="text" value="@journal.JournalNumber" readonly class="readonly" /></div>
                    <div class="fg"><label>التاريخ</label><input type="text" value="@journal.JournalDate.ToString("dd/MM/yyyy")" readonly class="readonly" /></div>
                    <div class="fg"><label>المرجع</label><input type="text" value="@journal.Reference" readonly class="readonly" /></div>
                    <div class="fg"><label>المصدر</label>
                        <div style="height:40px;display:flex;align-items:center;gap:8px;padding:0 12px;border:1.5px solid #e8e2d0;border-radius:10px;background:#fcfaf6">
                            <span class="coa-type type-1">@GetSourceNameAr(journal.SourceDocType)</span>
                            <span style="font-family:monospace;font-weight:700">@journal.SourceDocNumber</span>
                        </div>
                    </div>
                    <div class="fg"><label>السنة المالية</label>
                        <div style="height:40px;display:flex;align-items:center;padding:0 12px;border:1.5px solid #e8e2d0;border-radius:10px;background:#fff">
                            <span style="font-weight:800;color:#0A0F1E">@(journal.FiscalYearName ?? "—")</span>
                            @if(journal.FiscalYearID.HasValue){<span style="font-family:monospace;font-size:.7rem;color:#8B95A5;margin-right:8px">ID:@journal.FiscalYearID</span>}
                        </div>
                    </div>
                    <div class="fg"><label>الفترة المحاسبية</label>
                        <div style="height:40px;display:flex;align-items:center;padding:0 12px;border:1.5px solid #e8e2d0;border-radius:10px;background:#fff">
                            <span style="font-weight:800">@(journal.PeriodName ?? "—")</span>
                            @if(journal.PeriodID.HasValue){<span style="font-family:monospace;font-size:.7rem;color:#8B95A5;margin-right:8px">ID:@journal.PeriodID</span>}
                        </div>
                    </div>
                    <div class="fg full"><label>البيان</label>
                        <div style="border:1.5px solid #e8e2d0;border-radius:12px;padding:12px;background:#fcfaf6">
                            <div style="font-weight:800;color:#0A0F1E;font-size:.92rem">@journal.Description</div>
                            @if(!string.IsNullOrEmpty(journal.SourceDocNumber)){
                                <div style="margin-top:6px;display:flex;gap:8px;align-items:center">
                                    <span style="font-size:.7rem;color:#8B95A5">المرجع الأصلي:</span>
                                    <span class="doc-num-luxury" style="font-size:.75rem">@journal.SourceDocNumber</span>
                                    <span style="font-size:.7rem;color:#9ca3af">@journal.SourceDocType</span>
                                </div>
                            }
                            @if(!string.IsNullOrEmpty(journal.Reference)){
                                <div style="margin-top:4px;font-size:.75rem;color:#6b7280">مرجع: @journal.Reference</div>
                            }
                        </div>
                    </div>
                </div>
                <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-top:16px">
                    <div style="background:#fcfaf6;border:1px solid #e8e2d0;border-radius:12px;padding:12px;text-align:center"><div style="font-size:.7rem;color:#8B95A5">إجمالي مدين</div><div style="font-weight:900;color:#2563eb;font-family:monospace">@journal.TotalDebit.ToString("#,##0.00")</div></div>
                    <div style="background:#fcfaf6;border:1px solid #e8e2d0;border-radius:12px;padding:12px;text-align:center"><div style="font-size:.7rem;color:#8B95A5">إجمالي دائن</div><div style="font-weight:900;color:#d97706;font-family:monospace">@journal.TotalCredit.ToString("#,##0.00")</div></div>
                    <div style="background:#fcfaf6;border:1px solid #e8e2d0;border-radius:12px;padding:12px;text-align:center"><div style="font-size:.7rem;color:#8B95A5">عدد الأسطر</div><div style="font-weight:900">@journal.Details.Count</div></div>
                    <div style="background:#fcfaf6;border:1px solid #e8e2d0;border-radius:12px;padding:12px;text-align:center"><div style="font-size:.7rem;color:#8B95A5">الحالة</div><div style="font-weight:800">@(journal.StatusName ?? (journal.JournalStatus==1?"مسودة":"مرحل"))</div></div>
                </div>
            </div>
        </div>

        <div class="table-card-luxury">
            <div class="card-head-luxury"><h3>تفاصيل القيد — @journal.Details.Count سطر</h3></div>
            <div class="table-responsive">
                <table class="table-luxury">
                    <thead><tr><th class="th-num">#</th><th>الحساب</th><th>البيان</th><th>مدين</th><th>دائن</th><th>مركز تكلفة</th></tr></thead>
                    <tbody>
                        @foreach(var d in journal.Details.OrderBy(x=>x.LineNumber)){
                            <tr><td class="td-num">@d.LineNumber</td><td><span class="doc-num-luxury" style="font-size:.74rem">@d.AccountCode</span><br/><span style="font-weight:800;font-size:.86rem">@d.AccountNameAr</span></td><td class="td-muted">@d.Description</td><td><span class="amount-luxury">@(d.DebitAmount>0?d.DebitAmount.ToString("#,##0.00"):"—")</span></td><td><span class="amount-luxury">@(d.CreditAmount>0?d.CreditAmount.ToString("#,##0.00"):"—")</span></td><td class="td-muted">@(d.CostCenterNameAr ?? "—")</td></tr>
                        }
                        <tr style="background:linear-gradient(135deg,#fcfaf6,#f8f6f0);font-weight:900"><td></td><td colspan="2" style="text-align:left">الإجمالي</td><td><span class="amount-luxury" style="background:#eff6ff;color:#2563eb;border-color:#dbeafe">@journal.TotalDebit.ToString("#,##0.00")</span></td><td><span class="amount-luxury" style="background:#fef3c7;color:#d97706;border-color:#fde68a">@journal.TotalCredit.ToString("#,##0.00")</span></td><td></td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="actions-bar-luxury">
            <button class="btn-luxury btn-ghost-luxury" @onclick='()=>Navigation.NavigateTo("/journal-entries")'>رجوع للقيود</button>
            @if(journal.SourceDocType=="OverheadExpense" && !string.IsNullOrEmpty(journal.SourceDocID)){
                <button class="btn-luxury" style="background:#fff7ed;border:1.5px solid #fed7aa;color:#ea580c" @onclick='()=>Navigation.NavigateTo($"/expenses/edit/{journal.SourceDocID}")'>عرض المصروف #@journal.SourceDocID</button>
            }
            @if(journal.JournalStatus==1){
                <button class="btn-luxury" style="background:#10b981;color:#fff" @onclick="PostJournal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg>ترحيل القيد</button>
            }
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='()=>toast=""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1100px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,#121A2E 100%);border-radius:20px;padding:18px 22px;border:1px solid rgba(212,175,55,.18)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:rgba(212,175,55,.15);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px}
.lh-title{font-size:1.25rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.72rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;font-family:'Tajawal'}.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2)}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}
.form-card-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:20px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.06)}.fc-gold-line{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent)}
.fc-header{padding:16px 20px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}.fc-header h3{margin:0;font-size:.92rem;font-weight:800;color:#0A0F1E}
.fc-body{padding:20px}.form-grid-luxury{display:grid;grid-template-columns:1fr 1fr;gap:14px}.fg.full{grid-column:1/-1}.fg label{font-size:.78rem;font-weight:700;color:#374151;margin-bottom:6px;display:block}.fg input,.fg textarea{width:100%;height:40px;padding:0 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.84rem;font-family:'Tajawal';outline:none;background:#fcfaf6}.fg textarea{height:auto;padding:10px 12px}.fg input.readonly{background:#f3f4f6;color:#6b7280}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.card-head-luxury{padding:14px 18px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8}.card-head-luxury h3{margin:0;font-size:.9rem;font-weight:800;color:#0A0F1E}
.table-responsive{overflow-x:auto}.table-luxury{width:100%;border-collapse:collapse;min-width:800px}.table-luxury th{padding:12px 14px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;white-space:nowrap;background:linear-gradient(135deg,#fcfaf6,#f8f6f0)}.table-luxury td{padding:12px 14px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}
.th-num{width:45px;text-align:center}.td-num{text-align:center;color:#9ca3af;font-size:.78rem}.td-muted{color:#6b7280;font-size:.82rem}
.doc-num-luxury{color:var(--gold-dark);font-weight:800;font-size:.82rem;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:8px}
.level-badge{font-family:monospace;font-weight:700;background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb;padding:3px 8px;border-radius:999px;font-size:.72rem}
.coa-detail{font-size:.68rem;padding:3px 8px;border-radius:6px;font-weight:800;border:1px solid}.coa-detail.group{background:rgba(212,175,55,.1);color:#9C7C2E;border-color:rgba(212,175,55,.2)}
.amount-luxury{font-family:monospace;font-weight:800;color:#0A0F1E;background:#f8f6f0;padding:4px 10px;border-radius:8px;border:1px solid #e8e2d0}
.status-badge-luxury{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,white)}.status-dot{width:6px;height:6px;border-radius:50%;background:var(--sc)}
.actions-bar-luxury{display:flex;gap:10px;justify-content:flex-end;align-items:center;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px 18px;box-shadow:0 4px 16px rgba(0,0,0,.04)}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}@@keyframes spin{to{transform:rotate(360deg)}}
.empty-luxury{text-align:center;padding:60px 20px;background:#fff;border-radius:18px;border:1px solid #e8e2d0}.empty-icon-luxury{width:56px;height:56px;margin:0 auto 12px;border-radius:14px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.empty-icon-luxury svg{width:28px;height:28px}.empty-sub{color:#9ca3af;font-size:.82rem;margin-top:6px}.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}
.toast-luxury{position:fixed;bottom:20px;left:20px;z-index:1050;animation:toastIn .35s ease}.toast-card-luxury{display:flex;align-items:center;gap:10px;padding:12px 18px;border-radius:14px;min-width:280px;font-weight:600;font-size:.84rem;box-shadow:0 12px 32px rgba(0,0,0,.12)}.toast-card-luxury.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.toast-card-luxury.error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.toast-card-luxury button{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-right:auto}
@@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
</style>

@code {
    [Parameter] public int Id { get; set; }
    private JournalEntryDto? journal = null;
    private bool isLoading = true;
    private string toast = "";
    private bool toastOk = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            journal = await AccountingService.GetJournalByIdAsync(Id);
        }
        catch (Exception ex) { toast = ex.Message; toastOk = false; }
        finally { isLoading = false; }
    }

    private string GetSourceNameAr(string? code) => code switch
    {
        "OverheadExpense" => "مصروف",
        "ReceiptVoucher" => "سند قبض",
        "PaymentVoucher" => "سند صرف",
        "CashTransfer" => "تحويل خزينة",
        "BankTransfer" => "تحويل بنكي",
        "OpeningBalance" => "رصيد افتتاحي",
        "SalesInvoice" => "فاتورة مبيعات",
        "PurchaseInvoice" => "فاتورة مشتريات",
        null or "" => "يدوي",
        _ => code
    };

    private async Task PostJournal()
    {
        if (journal==null) return;
        try
        {
            await AccountingService.PostJournalAsync(journal.JournalID, UserSession.UserID);
            toast = "تم ترحيل القيد ✅"; toastOk = true;
            journal = await AccountingService.GetJournalByIdAsync(Id);
        }
        catch (Exception ex) { toast = ex.Message; toastOk = false; }
    }
}
