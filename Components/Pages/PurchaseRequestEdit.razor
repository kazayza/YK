</style>

@code {
    [Parameter] public int RequestId { get; set; }

    private PurchaseRequestHeaderDto header = new() { RequestDate = DateTime.Today, Priority = 2 };
    private List<PurchaseRequestDetailDto> details = new();
    private ModulePermissionDto? permissions;
    private List<LookupDto>? employees;
    private List<LookupDto>? departments;
    private List<LookupDto>? units;
    private List<SearchableItem>? purchaseItems;

    private bool isLoading = true;
    private bool isSaving = false;
    private string toast = "";
    private bool toastOk = true;

    private bool showLineForm = false;
    private bool isEditLine = false;
    private PurchaseRequestDetailEditDto editLine = new();
    private bool isSavingLine = false;
    private string lineMsg = "";
    private bool lineMsgOk = true;

    private bool showRejectDialog = false;
    private string rejectReason = "";
    private string rejectMsg = "";

    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => RequestId == 0;
    private bool isApprovalMode => !isNewMode && !isViewMode && header.RequestStatus == 2 && (permissions?.CanApprove ?? false);
    private bool isReadOnly
    {
        get
        {
            if (isViewMode) return true;
            if (isNewMode) return false;
            if (isApprovalMode) return true;
            return header.RequestStatus != 1;
        }
    }
    private string pageTitle
    {
        get
        {
            if (isNewMode) return "طلب شراء جديد";
            if (isViewMode) return "عرض طلب شراء";
            if (isApprovalMode) return "اعتماد طلب شراء";
            return "تعديل طلب شراء";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!UserSession.IsLoggedIn){ Navigation.NavigateTo("/login"); return; }
            if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_PR");
            if (permissions == null || !permissions.CanView) return;
            await LoadLookups();
            if (RequestId > 0) await LoadRequestData();
        }
        catch (Exception ex){ await ShowToastAsync("خطأ في تحميل الصفحة: " + ex.Message, false); }
        finally{ isLoading = false; StateHasChanged(); }
    }

    private async Task LoadLookups()
    {
        employees = await LookupService.GetEmployeesAsync();
        departments = await LookupService.GetDepartmentsAsync();
        units = await LookupService.GetUnitsAsync();
        purchaseItems = await LookupService.GetItemsForPurchaseSearchableAsync();
    }

    private async Task LoadRequestData()
    {
        var loaded = await PrService.GetRequestByIdAsync(RequestId);
        if (loaded != null)
        {
            header = loaded;
            details = await PrService.GetRequestDetailsAsync(RequestId);
            if (isApprovalMode)
            {
                foreach (var d in details){ if (d.ApprovedQty == null || d.ApprovedQty == 0) d.ApprovedQty = d.RequestedQty; }
            }
        }
        else{ await ShowToastAsync("الطلب غير موجود", false); }
    }

    private async Task OnEmployeeChanged()
    {
        if (header.RequestedBy > 0)
        {
            var deptId = await LookupService.GetEmployeeDepartmentAsync(header.RequestedBy.Value);
            if (deptId > 0){ header.DepartmentID = deptId; StateHasChanged(); }
        }
    }

    private async Task OnItemSelected(SearchableItem? item)
    {
        if (item != null)
        {
            editLine.ItemID = item.Id;
            var info = await LookupService.GetItemQuickInfoAsync(item.Id);
            if (info != null)
            {
                if (info.UnitID > 0) { editLine.UnitID = info.UnitID; }
                if (info.EstimatedPrice > 0) { editLine.EstimatedPrice = info.EstimatedPrice; }
                StateHasChanged();
            }
        }
    }

    private async Task SaveHeader()
    {
        if (header.RequestDate == default){ await ShowToastAsync("حدد تاريخ الطلب", false); return; }
        isSaving = true; StateHasChanged();
        try
        {
            if (isNewMode)
            {
                header.RequestNumber = await PrService.GenerateRequestNumberAsync();
                header.RequestStatus = 1;
                var newId = await PrService.InsertRequestAsync(header, UserSession.UserID);
                RequestId = newId;
                details = await PrService.GetRequestDetailsAsync(newId);
                await ShowToastAsync($"تم إنشاء الطلب: {header.RequestNumber} ✅");
                Navigation.NavigateTo($"/purchase-requests/edit/{newId}", forceLoad: false);
            }
            else
            {
                await PrService.UpdateRequestAsync(header, UserSession.UserID);
                await ShowToastAsync("تم حفظ التعديلات ✅");
            }
        }
        catch (Exception ex){ await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally{ isSaving = false; }
    }

    private async Task SubmitForApproval()
    {
        if (!details.Any()){ await ShowToastAsync("أضف أصناف أولاً", false); return; }
        isSaving = true; StateHasChanged();
        try
        {
            await PrService.ChangeStatusAsync(RequestId, 2, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            header.RequestStatus = 2;
            await ShowToastAsync("تم الإرسال للاعتماد ✅");
        }
        catch (Exception ex){ await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally{ isSaving = false; }
    }

    private async Task ExecuteQuickApprove()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "هل تريد الاعتماد السريع؟ سيتم اعتماد جميع الكميات المطلوبة.\n\nاستخدم الاعتماد التفصيلي إذا أردت تعديل الكميات.");
        if (!confirmed) return;
        isSaving = true; StateHasChanged();
        try
        {
            await PrService.QuickApproveAsync(RequestId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            header.RequestStatus = 3;
            details = await PrService.GetRequestDetailsAsync(RequestId);
            await ShowToastAsync("تم الاعتماد السريع ✅");
            await Task.Delay(1500);
            Navigation.NavigateTo("/purchase-requests");
        }
        catch (Exception ex){ await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally{ isSaving = false; }
    }

    private async Task ExecuteDetailedApprove()
    {
        isSaving = true; StateHasChanged();
        try
        {
            var approved = details.Select(d => new ApprovedQtyDto{ DetailID = d.RequestDetailID, ApprovedQty = d.ApprovedQty ?? d.RequestedQty }).ToList();
            await PrService.ApproveWithQuantitiesAsync(RequestId, approved, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            header.RequestStatus = 3;
            details = await PrService.GetRequestDetailsAsync(RequestId);
            await ShowToastAsync("تم الاعتماد التفصيلي ✅");
            await Task.Delay(1500);
            Navigation.NavigateTo("/purchase-requests");
        }
        catch (Exception ex){ await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally{ isSaving = false; }
    }

    private void DoShowReject(){ rejectReason = ""; rejectMsg = ""; showRejectDialog = true; }

    private async Task ConfirmReject()
    {
        if (string.IsNullOrWhiteSpace(rejectReason)){ rejectMsg = "أدخل سبب الرفض"; return; }
        try
        {
            await PrService.ChangeStatusAsync(RequestId, 4, UserSession.CurrentUserID, UserSession.CurrentEmployeeID, rejectReason);
            header.RequestStatus = 4;
            header.RejectionReason = rejectReason;
            showRejectDialog = false;
            await ShowToastAsync("تم رفض الطلب", false);
            await Task.Delay(1500);
            Navigation.NavigateTo("/purchase-requests");
        }
        catch (Exception ex){ rejectMsg = "خطأ: " + ex.Message; }
    }

    private void ShowAddLine(){ isEditLine = false; editLine = new() { RequestID = RequestId }; lineMsg = ""; showLineForm = true; }
    private void ShowEditLine(PurchaseRequestDetailDto line)
    {
        isEditLine = true;
        editLine = new(){ RequestDetailID = line.RequestDetailID, RequestID = line.RequestID, ItemID = line.ItemID, UnitID = line.UnitID, RequestedQty = line.RequestedQty, EstimatedPrice = line.EstimatedPrice, Purpose = line.Purpose, Notes = line.Notes };
        lineMsg = ""; showLineForm = true;
    }
    private void CloseLineForm(){ showLineForm = false; lineMsg = ""; }

    private async Task SaveLine()
    {
        lineMsg = "";
        if (editLine.ItemID == 0) { lineMsg = "اختر الصنف"; lineMsgOk = false; return; }
        if (editLine.UnitID == 0) { lineMsg = "اختر الوحدة"; lineMsgOk = false; return; }
        if (editLine.RequestedQty <= 0) { lineMsg = "أدخل الكمية"; lineMsgOk = false; return; }
        if (isNewMode){ await SaveHeader(); if (RequestId == 0) return; editLine.RequestID = RequestId; }
        isSavingLine = true; StateHasChanged();
        try
        {
            if (isEditLine) await PrService.UpdateDetailAsync(editLine, UserSession.UserID);
            else await PrService.InsertDetailAsync(editLine, UserSession.UserID);
            details = await PrService.GetRequestDetailsAsync(RequestId);
            showLineForm = false;
            await ShowToastAsync(isEditLine ? "تم التحديث ✅" : "تم الإضافة ✅");
        }
        catch (Exception ex){ lineMsg = "خطأ: " + ex.Message; lineMsgOk = false; }
        finally{ isSavingLine = false; }
    }

    private async Task DeleteLine(int detailId)
    {
        try{ await PrService.DeleteDetailAsync(detailId, UserSession.UserID); details = await PrService.GetRequestDetailsAsync(RequestId); await ShowToastAsync("تم الحذف ✅"); }
        catch (Exception ex){ await ShowToastAsync("خطأ: " + ex.Message, false); }
    }

    private async Task PrintDoc()
    {
        try{ var html = await PrService.GenerateReportHtmlAsync(RequestId, UserSession.UserID); await JS.InvokeVoidAsync("printHtml", html); }
        catch (Exception ex){ await ShowToastAsync("خطأ: " + ex.Message, false); }
    }

    private void GoBack() => Navigation.NavigateTo("/purchase-requests");

    private async Task ShowToastAsync(string message, bool ok = true)
    {
        toast = message; toastOk = ok; StateHasChanged();
        await Task.Delay(4000); toast = ""; StateHasChanged();
    }
}
