@page "/purchase-requests/new"
@page "/purchase-requests/edit/{RequestId:int}"
@page "/purchase-requests/view/{RequestId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PurchaseRequestService PrService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div>}
else
{
    <div class="luxury-doc-page" dir="rtl">
        <!-- Luxury Header -->
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <button class="btn-luxury btn-back-luxury" @onclick="GoBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19 7-7-7-7"/></svg>رجوع</button>
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">@pageTitle</h2><div class="lh-meta">@if (!string.IsNullOrEmpty(header.RequestNumber)){<code class="doc-num-luxury">@header.RequestNumber</code><span class="status-badge-luxury" style="--sc:@PurchaseRequestService.GetStatusColor(header.RequestStatus)">@PurchaseRequestService.GetStatusName(header.RequestStatus)</span>}</div></div>
                </div>
                <div class="lh-actions">
                    <div class="workflow-mini"><span class="wm-dot active">1 طلب</span><span class="wm-line"></span><span class="wm-dot">2 أمر</span><span class="wm-line"></span><span class="wm-dot">3 استلام</span><span class="wm-line"></span><span class="wm-dot">4 فاتورة</span><span class="wm-line"></span><span class="wm-dot">5 مرتجع</span></div>
                    @if (permissions.CanPrint && RequestId > 0)
                    {<button class="btn-luxury btn-ghost-luxury" @onclick="PrintDoc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>طباعة</button>}
                </div>
            </div>
        </div>

        @if (isApprovalMode)
        {
            <div class="approval-bar-luxury">
                <div class="ml-gold-line green"></div>
                <div class="appr-left"><div class="appr-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg></div><div><div class="appr-title">بانتظار اعتمادك</div><div class="appr-sub">يمكنك اعتماد جميع الكميات أو تعديلها قبل الاعتماد</div></div></div>
                <div class="appr-actions">
                    <button class="btn-luxury btn-approve-quick" @onclick="ExecuteQuickApprove" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg>}اعتماد سريع</button>
                    <button class="btn-luxury btn-approve-detail" @onclick="ExecuteDetailedApprove" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>}اعتماد تفصيلي</button>
                    <button class="btn-luxury btn-reject-luxury" @onclick="DoShowReject" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>رفض</button>
                </div>
            </div>
        }

        @if (isLoading)
        {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else
        {
            <!-- بيانات الطلب -->
            <div class="doc-section-luxury">
                <div class="ml-gold-line"></div>
                <div class="sec-head-luxury"><div class="sec-icon-luxury blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h3 class="sec-title-luxury">بيانات الطلب</h3><span class="sec-badge-luxury">@pageTitle</span></div>
                <div class="form-grid-luxury c4">
                    <div class="f-field-luxury"><label class="f-label-luxury">رقم الطلب</label><input type="text" class="f-input-luxury readonly" value="@(header.RequestNumber ?? "تلقائي")" disabled /></div>
                    <div class="f-field-luxury"><label class="f-label-luxury required">تاريخ الطلب</label><input type="date" class="f-input-luxury" @bind="header.RequestDate" disabled="@isReadOnly" /></div>
                    <div class="f-field-luxury"><label class="f-label-luxury">مطلوب بتاريخ</label><input type="date" class="f-input-luxury" @bind="header.RequiredDate" disabled="@isReadOnly" /></div>
                    <div class="f-field-luxury"><label class="f-label-luxury required">الأولوية</label><select class="f-input-luxury" @bind="header.Priority" disabled="@isReadOnly"><option value="1">🔴 عاجل</option><option value="2">🔵 عادي</option><option value="3">⚪ غير عاجل</option></select></div>
                    <div class="f-field-luxury"><label class="f-label-luxury">طالب الشراء</label><select class="f-input-luxury" @bind="header.RequestedBy" @bind:after="OnEmployeeChanged" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (employees != null){@foreach (var e in employees){<option value="@e.Id">@e.Name</option>}}</select></div>
                    <div class="f-field-luxury"><label class="f-label-luxury">القسم</label><select class="f-input-luxury" @bind="header.DepartmentID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (departments != null){@foreach (var d in departments){<option value="@d.Id">@d.Name</option>}}</select></div>
                    <div class="f-field-luxury c2"><label class="f-label-luxury">ملاحظات</label><input type="text" class="f-input-luxury" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات..." /></div>
                </div>
                @if (header.RequestStatus == 4 && !string.IsNullOrEmpty(header.RejectionReason))
                {<div class="rejection-box-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg><strong>سبب الرفض:</strong> @header.RejectionReason</div>}
            </div>

            <!-- الأصناف -->
            <div class="doc-section-luxury">
                <div class="ml-gold-line"></div>
                <div class="sec-head-luxury"><div class="sec-icon-luxury green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96L12 12.01l8.73-5.05"/><path d="M12 22.08V12"/></svg></div><h3 class="sec-title-luxury">الأصناف المطلوبة</h3><span class="sec-badge-luxury">@details.Count صنف</span><span class="total-mini-luxury">@details.Sum(d => d.RequestedQty * d.EstimatedPrice).ToString("#,##0.00") ج.م</span>
                    @if (!isReadOnly && !isApprovalMode && permissions.CanAdd){<button class="btn-luxury btn-primary-luxury btn-sm-luxury" style="margin-right:auto;" @onclick="ShowAddLine"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة صنف</button>}
                </div>

                @if (!details.Any() && !showLineForm)
                {<div class="empty-lines-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><p>لا توجد أصناف. اضغط "إضافة صنف" للبدء.</p></div>}
                else
                {
                    <div class="tbl-card-luxury"><div class="table-responsive"><table class="tbl-luxury"><thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="tc">المطلوب</th><th class="tc">المعتمد</th><th class="tl">السعر التقديري</th><th class="tl">الإجمالي</th><th>الغرض</th>@if (!isReadOnly || isApprovalMode){<th class="tc">إجراءات</th>}</tr></thead>
                        <tbody>
                            @{int n=0;}
                            @foreach (var line in details){n++;
                                <tr>
                                    <td class="td-n">@n</td>
                                    <td><code class="code-tag-luxury">@line.ItemCode</code></td>
                                    <td class="td-bold">@line.ItemNameAr</td>
                                    <td class="td-muted">@line.UnitName</td>
                                    <td class="tc">@line.RequestedQty.ToString("#,##0.##")</td>
                                    <td class="tc">@if (isApprovalMode){<input type="number" class="approve-input-luxury" @bind="line.ApprovedQty" step="0.01" />}else{@(line.ApprovedQty?.ToString("#,##0.##") ?? "—")}</td>
                                    <td class="tl num-cell">@line.EstimatedPrice.ToString("#,##0.00")</td>
                                    <td class="tl num-cell">@((line.RequestedQty * line.EstimatedPrice).ToString("#,##0.00"))</td>
                                    <td class="td-muted">@(line.Purpose ?? "—")</td>
                                    @if (!isReadOnly && !isApprovalMode)
                                    {<td class="tc"><div class="line-actions-luxury">@if (permissions.CanEdit){<button class="act-btn-luxury edit" @onclick="() => ShowEditLine(line)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}@if (permissions.CanDelete){<button class="act-btn-luxury del" @onclick="() => DeleteLine(line.RequestDetailID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}</div></td>}
                                    @if (isApprovalMode){<td></td>}
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr class="total-row-luxury"><td colspan="7" class="tl"><strong>الإجمالي التقديري</strong></td><td class="tl num-cell"><strong>@details.Sum(d => d.RequestedQty * d.EstimatedPrice).ToString("#,##0.00") ج.م</strong></td><td colspan="@(!isReadOnly || isApprovalMode ? "2" : "1")"></td></tr></tfoot>
                    </table></div></div>
                }

                @if (showLineForm)
                {
                    <div class="line-form-luxury">
                        <div class="ml-gold-line"></div>
                        <div class="line-form-head-luxury"><h4>@(isEditLine ? "تعديل صنف" : "إضافة صنف")</h4><button class="btn-close-x-luxury" @onclick="CloseLineForm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
                        <div class="form-grid-luxury c3">
                            <div class="f-field-luxury"><label class="f-label-luxury required">الصنف</label><SearchableSelect Items="@purchaseItems" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث بالاسم أو الكود..." IsDisabled="@isEditLine" /></div>
                            <div class="f-field-luxury"><label class="f-label-luxury required">الوحدة</label><select class="f-input-luxury" @bind="editLine.UnitID"><option value="0">-- اختر --</option>@if (units != null){@foreach (var u in units){<option value="@u.Id">@u.Name</option>}}</select></div>
                            <div class="f-field-luxury"><label class="f-label-luxury required">الكمية المطلوبة</label><input type="number" class="f-input-luxury" @bind="editLine.RequestedQty" step="0.01" /></div>
                            <div class="f-field-luxury"><label class="f-label-luxury">السعر التقديري</label><input type="number" class="f-input-luxury" @bind="editLine.EstimatedPrice" step="0.01" /></div>
                            <div class="f-field-luxury"><label class="f-label-luxury">الغرض</label><input type="text" class="f-input-luxury" @bind="editLine.Purpose" placeholder="الغرض من الطلب" /></div>
                            <div class="f-field-luxury"><label class="f-label-luxury">ملاحظات</label><input type="text" class="f-input-luxury" @bind="editLine.Notes" placeholder="ملاحظات..." /></div>
                        </div>
                        @if (!string.IsNullOrEmpty(lineMsg)){<div class="form-msg-luxury @(lineMsgOk?"ok":"err")">@lineMsg</div>}
                        <div class="line-form-btns-luxury"><button class="btn-luxury btn-primary-luxury" @onclick="SaveLine" disabled="@isSavingLine">@if (isSavingLine){<div class="btn-spinner-sm"></div>}@(isEditLine ? "تحديث" : "إضافة")</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseLineForm">إلغاء</button></div>
                    </div>
                }
            </div>

            @if (!isViewMode && !isApprovalMode)
            {
                <div class="doc-actions-luxury">
                    <div class="ml-gold-line"></div>
                    <div class="doc-actions-right">@if (!isReadOnly){<button class="btn-luxury btn-primary-luxury" @onclick="SaveHeader" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21V13H7v8"/></svg>}@(isNewMode ? "حفظ الطلب" : "حفظ التعديلات")</button>@if (RequestId > 0 && header.RequestStatus == 1 && details.Any()){<button class="btn-luxury btn-warning-luxury" @onclick="SubmitForApproval" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m22 2-7 20-4-9-9-4 20-7z"/></svg>إرسال للاعتماد</button>}}</div>
                    <button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">رجوع</button>
                </div>
            }
        }
    </div>

    @if (showRejectDialog)
    {
        <div class="modal-overlay-luxury" @onclick="() => showRejectDialog = false"><div class="modal-card-luxury" @onclick:stopPropagation="true"><div class="ml-gold-line danger"></div><div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div><h4>رفض الطلب</h4><p>أدخل سبب الرفض:</p><textarea class="f-input-luxury" rows="3" @bind="rejectReason" placeholder="سبب الرفض..."></textarea>@if (!string.IsNullOrEmpty(rejectMsg)){<div class="form-msg-luxury err">@rejectMsg</div>}<div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmReject">تأكيد الرفض</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showRejectDialog = false">إلغاء</button></div></div></div>
    }

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast = ""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-doc-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1300px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25);overflow:hidden}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.15rem;font-weight:900;color:#F5E6C8;margin:0}.lh-meta{display:flex;gap:8px;align-items:center;margin-top:5px;flex-wrap:wrap}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-luxury:disabled{opacity:.6;cursor:not-allowed}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-primary-luxury:hover{transform:translateY(-1px)}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-ghost-luxury:hover{background:#fcfaf6;border-color:var(--gold)}.btn-back-luxury{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:#F5E6C8}.btn-back-luxury:hover{background:rgba(255,255,255,.12)}.btn-danger-luxury{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}.btn-warning-luxury{background:linear-gradient(135deg,#d97706,#f59e0b);color:#fff}.btn-approve-quick{background:linear-gradient(135deg,#059669,#10b981);color:#fff;box-shadow:0 4px 12px rgba(16,185,129,.25)}.btn-approve-detail{background:linear-gradient(135deg,#1e40af,#2563eb);color:#fff;box-shadow:0 4px 12px rgba(37,99,235,.2)}.btn-reject-luxury{background:#fff;border:1.5px solid #fecaca;color:#dc2626}.btn-luxury svg{width:14px;height:14px}.btn-sm-luxury{padding:7px 14px;font-size:.78rem}
.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.doc-num-luxury{background:rgba(212,175,55,.15);border:1px solid rgba(212,175,55,.25);color:var(--gold);padding:4px 10px;border-radius:8px;font-weight:800;font-size:.84rem}.status-badge-luxury{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 18%,rgba(255,255,255,.08));color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,transparent)}.workflow-mini{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);padding:6px 12px;border-radius:999px}.wm-dot{font-size:.66rem;font-weight:700;color:#8B95A5}.wm-dot.active{color:var(--gold)}.wm-line{width:10px;height:1px;background:rgba(255,255,255,.15)}
.approval-bar-luxury{position:relative;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:16px 20px;overflow:hidden;flex-wrap:wrap}.appr-left{display:flex;align-items:center;gap:12px}.appr-icon{width:44px;height:44px;border-radius:12px;background:#ecfdf5;border:1px solid #a7f3d0;display:flex;align-items:center;justify-content:center;color:#059669}.appr-icon svg{width:22px;height:22px}.appr-title{font-weight:800;color:#065f46;font-size:.9rem}.appr-sub{font-size:.76rem;color:#6b7280;margin-top:2px}.appr-actions{display:flex;gap:8px;flex-wrap:wrap}
.doc-section-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:18px;padding:22px;box-shadow:0 4px 16px rgba(0,0,0,.04);overflow:hidden}.sec-head-luxury{display:flex;align-items:center;gap:10px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid #f1efe8;flex-wrap:wrap}.sec-icon-luxury{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center}.sec-icon-luxury.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.sec-icon-luxury.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.sec-icon-luxury svg{width:18px;height:18px}.sec-title-luxury{font-weight:800;color:#0A0F1E;margin:0;font-size:.96rem}.sec-badge-luxury{background:#f1f5f9;color:#475569;padding:4px 12px;border-radius:999px;font-size:.74rem;font-weight:700}.total-mini-luxury{margin-right:auto;background:#fcfaf6;border:1px solid #e8e2d0;padding:4px 10px;border-radius:8px;font-weight:800;font-size:.8rem;color:#0A0F1E}
