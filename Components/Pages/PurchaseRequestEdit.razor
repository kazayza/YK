@page "/purchase-requests/new"
@page "/purchase-requests/edit/{RequestId:int}"
@page "/purchase-requests/view/{RequestId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PurchaseRequestService PrService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access"><div class="na-icon">🔒</div><h4>يجب تسجيل الدخول</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access"><div class="na-icon">⛔</div><h4>ليس لديك صلاحية</h4></div>
}
else
{
    <div class="doc-page" dir="rtl">

        <!-- Header -->
        <div class="doc-header">
            <div class="doc-header-right">
                <button class="btn-m btn-ghost" @onclick="GoBack">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5"/><path d="m12 19 7-7-7-7"/>
                    </svg> رجوع
                </button>
                <div>
                    <h2 class="doc-title">@pageTitle</h2>
                    @if (!string.IsNullOrEmpty(header.RequestNumber))
                    {
                        <div class="doc-num-wrap">
                            <code class="doc-number">@header.RequestNumber</code>
                            <span class="status-chip" style="--sc:@PurchaseRequestService.GetStatusColor(header.RequestStatus)">
                                @PurchaseRequestService.GetStatusName(header.RequestStatus)
                            </span>
                        </div>
                    }
                </div>
            </div>
            <div class="doc-header-left">
                @if (permissions.CanPrint && RequestId > 0)
                {
                    <button class="btn-m btn-outline" @onclick="PrintDoc">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 6 2 18 2 18 9"/>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                            <rect x="6" y="14" width="12" height="8"/>
                        </svg> طباعة
                    </button>
                }
            </div>
        </div>

        <!-- Approval Bar - يظهر فقط في وضع الاعتماد -->
        @if (isApprovalMode)
        {
            <div class="approval-bar">
                <span class="approval-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 12l2 2 4-4"/>
                        <path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
                    </svg>
                    بانتظار اعتمادك
                </span>
                <button type="button" class="appr-btn appr-quick" @onclick="ExecuteQuickApprove" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <div class="btn-spin"></div>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                            <polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                    }
                    اعتماد سريع
                </button>
                <button type="button" class="appr-btn appr-detail" @onclick="ExecuteDetailedApprove" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <div class="btn-spin"></div>
                    }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="9" y="9" width="13" height="13" rx="2"/>
                            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                        </svg>
                    }
                    اعتماد تفصيلي
                </button>
                <button type="button" class="appr-btn appr-reject" @onclick="DoShowReject" disabled="@isSaving">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="m15 9-6 6"/><path d="m9 9 6 6"/>
                    </svg>
                    رفض
                </button>
            </div>
        }

        @if (isLoading)
        {
            <div class="loading-st"><div class="loader"></div><p>جاري التحميل...</p></div>
        }
        else
        {
            <!-- بيانات الطلب -->
            <div class="doc-section">
                <div class="sec-head">
                    <div class="sec-icon blue">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                        </svg>
                    </div>
                    <h3 class="sec-title">بيانات الطلب</h3>
                </div>
                <div class="form-grid c4">
                    <div class="f-field">
                        <label class="f-label">رقم الطلب</label>
                        <input type="text" class="f-input readonly" value="@(header.RequestNumber ?? "تلقائي")" disabled />
                    </div>
                    <div class="f-field">
                        <label class="f-label required">تاريخ الطلب</label>
                        <input type="date" class="f-input" @bind="header.RequestDate" disabled="@isReadOnly" />
                    </div>
                    <div class="f-field">
                        <label class="f-label">مطلوب بتاريخ</label>
                        <input type="date" class="f-input" @bind="header.RequiredDate" disabled="@isReadOnly" />
                    </div>
                    <div class="f-field">
                        <label class="f-label required">الأولوية</label>
                        <select class="f-input" @bind="header.Priority" disabled="@isReadOnly">
                            <option value="1">🔴 عاجل</option>
                            <option value="2">🔵 عادي</option>
                            <option value="3">⚪ غير عاجل</option>
                        </select>
                    </div>
                    <div class="f-field">
                        <label class="f-label">طالب الشراء</label>
                        <select class="f-input" @bind="header.RequestedBy" @bind:after="OnEmployeeChanged" disabled="@isReadOnly">
                            <option value="0">-- اختر --</option>
                            @if (employees != null)
                            {
                                @foreach (var e in employees)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="f-field">
                        <label class="f-label">القسم</label>
                        <select class="f-input" @bind="header.DepartmentID" disabled="@isReadOnly">
                            <option value="0">-- اختر --</option>
                            @if (departments != null)
                            {
                                @foreach (var d in departments)
                                {
                                    <option value="@d.Id">@d.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="f-field c2">
                        <label class="f-label">ملاحظات</label>
                        <input type="text" class="f-input" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات..." />
                    </div>
                </div>

                @if (header.RequestStatus == 4 && !string.IsNullOrEmpty(header.RejectionReason))
                {
                    <div class="rejection-box">❌ <strong>سبب الرفض:</strong> @header.RejectionReason</div>
                }
            </div>

            <!-- الأصناف -->
            <div class="doc-section">
                <div class="sec-head">
                    <div class="sec-icon green">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                        </svg>
                    </div>
                    <h3 class="sec-title">الأصناف المطلوبة</h3>
                    <span class="sec-badge">@details.Count صنف</span>
                    @if (!isReadOnly && !isApprovalMode && permissions.CanAdd)
                    {
                        <button class="btn-m btn-primary btn-sm" @onclick="ShowAddLine" style="margin-right:auto;">
                            + إضافة صنف
                        </button>
                    }
                </div>

                @if (!details.Any() && !showLineForm)
                {
                    <div class="empty-lines"><p>لا توجد أصناف. اضغط "إضافة صنف" للبدء.</p></div>
                }
                else
                {
                    <div class="tbl-card">
                        <table class="tbl">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>الكود</th>
                                    <th>الصنف</th>
                                    <th>الوحدة</th>
                                    <th class="tc">المطلوب</th>
                                    <th class="tc">المعتمد</th>
                                    <th class="tl">السعر التقديري</th>
                                    <th class="tl">الإجمالي</th>
                                    <th>الغرض</th>
                                    @if (!isReadOnly || isApprovalMode)
                                    {
                                        <th class="tc">إجراءات</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{ int n = 0; }
                                @foreach (var line in details)
                                {
                                    n++;
                                    <tr>
                                        <td class="td-n">@n</td>
                                        <td><code class="code-tag">@line.ItemCode</code></td>
                                        <td class="td-bold">@line.ItemNameAr</td>
                                        <td>@line.UnitName</td>
                                        <td class="tc">@line.RequestedQty.ToString("#,##0.##")</td>
                                        <td class="tc">
                                            @if (isApprovalMode)
                                            {
                                                <input type="number" class="approve-input" @bind="line.ApprovedQty" step="0.01" />
                                            }
                                            else
                                            {
                                                @(line.ApprovedQty?.ToString("#,##0.##") ?? "—")
                                            }
                                        </td>
                                        <td class="tl num-cell">@line.EstimatedPrice.ToString("#,##0.00")</td>
                                        <td class="tl num-cell">@((line.RequestedQty * line.EstimatedPrice).ToString("#,##0.00"))</td>
                                        <td class="td-muted">@(line.Purpose ?? "—")</td>
                                        @if (!isReadOnly && !isApprovalMode)
                                        {
                                            <td class="tc">
                                                <div class="line-actions">
                                                    @if (permissions.CanEdit)
                                                    {
                                                        <button class="act-btn edit" @onclick="() => ShowEditLine(line)">
                                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                                            </svg>
                                                        </button>
                                                    }
                                                    @if (permissions.CanDelete)
                                                    {
                                                        <button class="act-btn del" @onclick="() => DeleteLine(line.RequestDetailID)">
                                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                                            </svg>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        }
                                        @if (isApprovalMode)
                                        {
                                            <td></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="total-row">
                                    <td colspan="7" class="tl"><strong>الإجمالي التقديري</strong></td>
                                    <td class="tl num-cell">
                                        <strong>@details.Sum(d => d.RequestedQty * d.EstimatedPrice).ToString("#,##0.00") ج.م</strong>
                                    </td>
                                    <td colspan="@(!isReadOnly || isApprovalMode ? "2" : "1")"></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }

                @if (showLineForm)
                {
                    <div class="line-form">
                        <div class="line-form-head">
                            <h4>@(isEditLine ? "تعديل صنف" : "إضافة صنف")</h4>
                            <button class="btn-close-x" @onclick="CloseLineForm">✕</button>
                        </div>
                        <div class="form-grid c3">
                            <div class="f-field">
                                <label class="f-label required">الصنف</label>
                                <SearchableSelect Items="@purchaseItems" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث بالاسم أو الكود..." IsDisabled="@isEditLine" />
                            </div>
                            <div class="f-field">
                                <label class="f-label required">الوحدة</label>
                                <select class="f-input" @bind="editLine.UnitID">
                                    <option value="0">-- اختر --</option>
                                    @if (units != null)
                                    {
                                        @foreach (var u in units)
                                        {
                                            <option value="@u.Id">@u.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="f-field">
                                <label class="f-label required">الكمية المطلوبة</label>
                                <input type="number" class="f-input" @bind="editLine.RequestedQty" step="0.01" />
                            </div>
                            <div class="f-field">
                                <label class="f-label">السعر التقديري</label>
                                <input type="number" class="f-input" @bind="editLine.EstimatedPrice" step="0.01" />
                            </div>
                            <div class="f-field">
                                <label class="f-label">الغرض</label>
                                <input type="text" class="f-input" @bind="editLine.Purpose" placeholder="الغرض من الطلب" />
                            </div>
                            <div class="f-field">
                                <label class="f-label">ملاحظات</label>
                                <input type="text" class="f-input" @bind="editLine.Notes" placeholder="ملاحظات..." />
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(lineMsg))
                        {
                            <div class="form-msg @(lineMsgOk ? "msg-ok" : "msg-err")">@lineMsg</div>
                        }
                        <div class="line-form-btns">
                            <button class="btn-m btn-primary" @onclick="SaveLine" disabled="@isSavingLine">
                                @if (isSavingLine) { <div class="btn-spin"></div> }
                                @(isEditLine ? "تحديث" : "إضافة")
                            </button>
                            <button class="btn-m btn-ghost" @onclick="CloseLineForm">إلغاء</button>
                        </div>
                    </div>
                }
            </div>

            <!-- أزرار الحفظ -->
            @if (!isViewMode && !isApprovalMode)
            {
                <div class="doc-actions">
                    <div class="doc-actions-right">
                        @if (!isReadOnly)
                        {
                            <button class="btn-m btn-primary" @onclick="SaveHeader" disabled="@isSaving">
                                @if (isSaving) { <div class="btn-spin"></div> }
                                @(isNewMode ? "حفظ الطلب" : "حفظ التعديلات")
                            </button>
                            @if (RequestId > 0 && header.RequestStatus == 1 && details.Any())
                            {
                                <button class="btn-m btn-warning" @onclick="SubmitForApproval" disabled="@isSaving">
                                    📤 إرسال للاعتماد
                                </button>
                            }
                        }
                    </div>
                    <button class="btn-m btn-ghost" @onclick="GoBack">رجوع</button>
                </div>
            }
        }
    </div>

    <!-- Reject Dialog -->
    @if (showRejectDialog)
    {
        <div class="modal-ov" @onclick="() => showRejectDialog = false">
            <div class="modal-box" @onclick:stopPropagation="true">
                <h4>رفض الطلب</h4>
                <p>أدخل سبب الرفض:</p>
                <textarea class="f-input" rows="3" @bind="rejectReason" placeholder="سبب الرفض..."></textarea>
                @if (!string.IsNullOrEmpty(rejectMsg))
                {
                    <div class="form-msg msg-err">@rejectMsg</div>
                }
                <div class="modal-btns-row">
                    <button class="btn-m btn-danger-solid" @onclick="ConfirmReject">تأكيد الرفض</button>
                    <button class="btn-m btn-ghost" @onclick="() => showRejectDialog = false">إلغاء</button>
                </div>
            </div>
        </div>
    }

    <!-- Toast -->
    @if (!string.IsNullOrEmpty(toast))
    {
        <div class="toast-wrap">
            <div class="toast @(toastOk ? "t-ok" : "t-err")">
                <span>@toast</span>
                <button @onclick='() => toast = ""'>✕</button>
            </div>
        </div>
    }
}

<style>
    .doc-page { display:flex; flex-direction:column; gap:18px; max-width:1200px; }
    .doc-header { display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:14px; }
    .doc-header-right { display:flex; align-items:flex-start; gap:14px; }
    .doc-header-left { display:flex; gap:8px; flex-wrap:wrap; }
    .doc-title { font-weight:800; color:#0f172a; margin:0; font-size:1.2rem; }
    .doc-num-wrap { display:flex; align-items:center; gap:10px; margin-top:6px; }
    .doc-number { background:#f1f5f9; padding:4px 14px; border-radius:8px; font-size:.88rem; color:#2563eb; font-weight:700; }
    .status-chip { display:inline-block; padding:4px 12px; border-radius:999px; font-size:.75rem; font-weight:700; background:color-mix(in srgb, var(--sc) 12%, white); color:var(--sc); }

    /* ===== Approval Bar ===== */
    .approval-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        background: linear-gradient(135deg, #ecfdf5, #f0fdf4);
        border: 1.5px solid #a7f3d0;
        border-radius: 14px;
        flex-wrap: wrap;
    }
    .approval-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .82rem;
        font-weight: 700;
        color: #065f46;
        padding-left: 10px;
        border-left: 2px solid #a7f3d0;
        margin-left: 4px;
    }
    .appr-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 18px;
        border-radius: 10px;
        border: none;
        font-weight: 700;
        font-size: .84rem;
        cursor: pointer;
        transition: all .2s;
        white-space: nowrap;
    }
    .appr-btn:disabled { opacity: .6; cursor: not-allowed; }
    .appr-quick {
        background: linear-gradient(135deg, #059669, #10b981);
        color: white;
        box-shadow: 0 4px 12px rgba(16,185,129,.3);
    }
    .appr-quick:hover:not(:disabled) {
        background: linear-gradient(135deg, #047857, #059669);
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(16,185,129,.4);
    }
    .appr-detail {
        background: linear-gradient(135deg, #1e40af, #2563eb);
        color: white;
        box-shadow: 0 4px 12px rgba(37,99,235,.25);
    }
    .appr-detail:hover:not(:disabled) {
        background: linear-gradient(135deg, #1e3a8a, #1e40af);
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(37,99,235,.35);
    }
    .appr-reject {
        background: white;
        color: #dc2626;
        border: 1.5px solid #fecaca;
        box-shadow: 0 2px 8px rgba(239,68,68,.1);
    }
    .appr-reject:hover:not(:disabled) {
        background: #fef2f2;
        border-color: #ef4444;
        transform: translateY(-1px);
    }

    .doc-section { background:white; border:1px solid #e2e8f0; border-radius:18px; padding:22px; box-shadow:0 4px 16px rgba(15,23,42,.04); }
    .sec-head { display:flex; align-items:center; gap:12px; margin-bottom:20px; padding-bottom:14px; border-bottom:1px solid #f1f5f9; flex-wrap:wrap; }
    .sec-icon { width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .sec-icon.blue { background:#eff6ff; color:#2563eb; }
    .sec-icon.green { background:#ecfdf5; color:#10b981; }
    .sec-title { font-weight:800; color:#0f172a; margin:0; font-size:.98rem; }
    .sec-badge { background:#f1f5f9; color:#475569; padding:4px 12px; border-radius:999px; font-size:.78rem; font-weight:700; }
    .form-grid { display:grid; gap:14px; }
    .c4 { grid-template-columns:repeat(4,1fr); }
    .c3 { grid-template-columns:repeat(3,1fr); }
    .c2 { grid-column:span 2; }
    .f-field { display:flex; flex-direction:column; gap:5px; }
    .f-label { font-size:.8rem; font-weight:700; color:#334155; }
    .required::after { content:' *'; color:#ef4444; }
    .f-input { padding:9px 12px; border:1.5px solid #e2e8f0; border-radius:10px; font-size:.88rem; background:white; outline:none; transition:.2s; width:100%; }
    .f-input:focus { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.1); }
    .f-input.readonly, .f-input:disabled { background:#f8fafc; color:#64748b; }
    .rejection-box { margin-top:14px; padding:12px 16px; background:#fef2f2; border:1px solid #fecaca; border-radius:10px; color:#dc2626; font-size:.86rem; }
    .tbl-card { border:1px solid #e2e8f0; border-radius:14px; overflow:hidden; overflow-x:auto; }
    .tbl { width:100%; border-collapse:collapse; min-width:800px; }
    .tbl thead { background:#f8fafc; }
    .tbl th { padding:11px 12px; font-size:.78rem; font-weight:700; color:#64748b; text-align:right; border-bottom:2px solid #e2e8f0; white-space:nowrap; }
    .tbl td { padding:10px 12px; font-size:.84rem; color:#334155; border-bottom:1px solid #f1f5f9; }
    .tbl tbody tr:hover { background:#f8fafc; }
    .tc { text-align:center; }
    .tl { text-align:left; }
    .td-n { text-align:center; color:#94a3b8; font-size:.78rem; }
    .td-bold { font-weight:700; color:#0f172a; }
    .td-muted { color:#64748b; font-size:.82rem; }
    .num-cell { font-family:monospace; font-weight:600; }
    .code-tag { background:#f1f5f9; padding:2px 8px; border-radius:6px; font-size:.78rem; color:#2563eb; font-weight:600; }
    .total-row { background:#f8fafc !important; }
    .total-row td { border-top:2px solid #e2e8f0; padding:12px; }
    .approve-input { width:90px; padding:6px 8px; border:1.5px solid #a7f3d0; border-radius:8px; font-size:.86rem; text-align:center; outline:none; background:#ecfdf5; }
    .approve-input:focus { border-color:#10b981; box-shadow:0 0 0 2px rgba(16,185,129,.15); }
    .empty-lines { text-align:center; padding:30px 20px; color:#94a3b8; }
    .line-actions { display:flex; gap:4px; justify-content:center; }
