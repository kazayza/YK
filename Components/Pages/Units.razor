@code {
    private List<UnitListDto>? units;
    private List<UnitListDto> filteredUnits = new();
    private List<UnitConversionDto> conversions = new();
    private ModulePermissionDto? permissions;
    private string searchText = "";
    private string filterType = "";
    private string activeTab = "units";

    private bool showFormDialog = false;
    private bool isEditMode = false;
    private UnitEditDto editItem = new();
    private bool isSaving = false;
    private string formMessage = "";
    private bool formSuccess = true;

    private bool showDeleteDialog = false;
    private UnitListDto? deleteUnit;
    private string deleteMessage = "";

    private int convFromUnitId = 0;
    private int convToUnitId = 0;
    private decimal convFactor = 0;

    private string resultMessage = "";
    private bool resultSuccess = true;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_UNITS");
        if (permissions != null && permissions.CanView) await LoadData();
    }

    private async Task LoadData()
    {
        units = await UnitService.GetUnitsListAsync();
        Search();
    }

    private async void LoadConversions()
    {
        conversions = await UnitService.GetConversionsAsync();
        StateHasChanged();
    }

    private void Search()
    {
        if (units == null) return;
        filteredUnits = units.Where(u =>
            (string.IsNullOrEmpty(filterType) || u.UnitType == filterType) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(u.UnitNameAr, searchText) ||
             ArabicSearchHelper.Contains(u.UnitNameEn, searchText) ||
             ArabicSearchHelper.Contains(u.UnitCode, searchText))
        ).ToList();
    }

    private void ClearSearch() { searchText = ""; Search(); }

    private void ShowAddDialog()
    {
        isEditMode = false;
        editItem = new UnitEditDto();
        formMessage = "";
        showFormDialog = true;
    }

    private void ShowEditDialog(UnitListDto unit)
    {
        isEditMode = true;
        editItem = new UnitEditDto
        {
            UnitID = unit.UnitID,
            UnitCode = unit.UnitCode,
            UnitNameAr = unit.UnitNameAr,
            UnitNameEn = unit.UnitNameEn,
            UnitType = unit.UnitType
        };
        formMessage = "";
        showFormDialog = true;
    }

    private void CloseDialog() { showFormDialog = false; formMessage = ""; }

    private async Task SaveUnit()
    {
        formMessage = "";
        if (string.IsNullOrWhiteSpace(editItem.UnitCode)){ formMessage = "يجب إدخال كود الوحدة"; formSuccess = false; return; }
        if (string.IsNullOrWhiteSpace(editItem.UnitNameAr)){ formMessage = "يجب إدخال اسم الوحدة"; formSuccess = false; return; }
        if (string.IsNullOrWhiteSpace(editItem.UnitType)){ formMessage = "يجب اختيار نوع الوحدة"; formSuccess = false; return; }
        isSaving = true; StateHasChanged();
        try
        {
            if (isEditMode){await UnitService.UpdateUnitAsync(editItem, UserSession.UserID);resultMessage="تم تعديل الوحدة بنجاح ✅";}
            else{await UnitService.InsertUnitAsync(editItem, UserSession.UserID);resultMessage="تم إضافة الوحدة بنجاح ✅";}
            resultSuccess = true;showFormDialog = false;await LoadData();
        }catch (Exception ex) { formMessage = "خطأ: " + ex.Message; formSuccess = false; }
        finally { isSaving = false; }
    }

    private void ShowDeleteConfirm(UnitListDto unit){ deleteUnit = unit; deleteMessage = ""; showDeleteDialog = true; }
    private void CloseDeleteDialog() { showDeleteDialog = false; deleteMessage = ""; }
    private async Task ConfirmDelete()
    {
        if (deleteUnit == null) return;
        try
        {
            var result = await UnitService.DeleteUnitAsync(deleteUnit.UnitID, UserSession.UserID);
            if (result.Success){ resultMessage = result.Message + " ✅"; resultSuccess = true; showDeleteDialog = false; await LoadData(); }
            else { deleteMessage = result.Message; }
        }catch (Exception ex) { deleteMessage = "خطأ: " + ex.Message; }
    }

    private async Task AddConversion()
    {
        if (convFromUnitId == 0 || convToUnitId == 0 || convFactor <= 0){ resultMessage = "يجب اختيار الوحدتين وإدخال معامل التحويل"; resultSuccess = false; return; }
        if (convFromUnitId == convToUnitId){ resultMessage = "لا يمكن التحويل من وحدة لنفسها"; resultSuccess = false; return; }
        try
        {
            await UnitService.InsertConversionAsync(convFromUnitId, convToUnitId, convFactor, UserSession.UserID);
            resultMessage = "تم إضافة التحويل بنجاح ✅"; resultSuccess = true;
            convFromUnitId = 0; convToUnitId = 0; convFactor = 0;
            LoadConversions();await LoadData();
        }catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
    }

    private async Task DeleteConversion(int conversionId)
    {
        try{await UnitService.DeleteConversionAsync(conversionId, UserSession.UserID);resultMessage="تم حذف التحويل ✅";resultSuccess=true;LoadConversions();}
        catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
    }

    private async Task ExportToExcel()
    {
        if (filteredUnits == null || !filteredUnits.Any()) return;
        isExporting = true; StateHasChanged();
        try
        {
            var fileBytes = await UnitService.ExportUnitsToExcelAsync(filteredUnits, UserSession.UserID);
            var base64 = Convert.ToBase64String(fileBytes);
            await JS.InvokeVoidAsync("downloadFile", $"Units_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
        }catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
        finally { isExporting = false; }
    }
}
