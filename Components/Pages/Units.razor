@page "/units"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject UnitService UnitService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>وحدات القياس - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول أولاً</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4><button class="btn-luxury btn-secondary-luxury" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة</button></div>
}
else
{
    <div class="luxury-page" dir="rtl">

        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">وحدات القياس</h2><p class="lh-subtitle">إدارة وحدات القياس وتحويلاتها - نظام تحويل ذكي</p></div>
                </div>
                <div class="lh-actions">
                    <span class="lh-badge"><span class="lh-dot"></span>@filteredUnits.Count وحدة</span>
                    @if (permissions.CanExport)
                    {
                        <button class="btn-luxury btn-export-luxury" @onclick="ExportToExcel" disabled="@isExporting">
                            @if (isExporting){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>}
                            تصدير
                        </button>
                    }
                    @if (permissions.CanAdd)
                    {
                        <button class="btn-luxury btn-primary-luxury" @onclick="ShowAddDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة وحدة</button>
                    }
                </div>
            </div>
        </div>

        @if (units != null)
        {
            <div class="stats-luxury">
                <div class="stat-luxury"><div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></div><div class="st-info"><span class="st-value">@units.Count</span><span class="st-label">إجمالي الوحدات</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg></div><div class="st-info"><span class="st-value">@units.Count(u => u.UnitType == "Weight")</span><span class="st-label">وزن</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/></svg></div><div class="st-info"><span class="st-value">@units.Count(u => u.UnitType == "Volume")</span><span class="st-label">حجم</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg></div><div class="st-info"><span class="st-value">@units.Count(u => u.UnitType == "Count")</span><span class="st-label">عدد</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><div class="st-info"><span class="st-value">@conversions.Count</span><span class="st-label">تحويلات</span></div><div class="st-gold-line"></div></div>
            </div>
        }

        <div class="filter-luxury">
            <div class="search-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="بحث بالاسم أو الكود..." @bind="searchText" @bind:event="oninput" @onkeyup="Search" />
                @if (!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}
            </div>
            <div class="select-wrap-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>
                <select @bind="filterType" @bind:after="Search">
                    <option value="">كل الأنواع</option>
                    <option value="Weight">وزن</option>
                    <option value="Volume">حجم</option>
                    <option value="Count">عدد</option>
                    <option value="Length">طول</option>
                </select>
                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        <!-- MUDTABS LUXURY -->
        <div class="mudtabs-luxury">
            <div class="mudtabs-header-luxury">
                <button class="mudtab-btn-luxury @(activeTab=="units"?"active":"")" @onclick='() => activeTab="units"'>
                    <span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></span>
                    وحدات القياس
                    <span class="mt-count">@filteredUnits.Count</span>
                </button>
                <button class="mudtab-btn-luxury @(activeTab=="conversions"?"active":"")" @onclick='() => { activeTab="conversions"; LoadConversions(); }'>
                    <span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 16V4m0 0L3 8m4-4l4 4"/><path d="M17 8v12m0 0 4-4m-4 4-4-4"/></svg></span>
                    التحويلات
                    <span class="mt-count gold">@conversions.Count</span>
                </button>
                <div class="mudtab-indicator-luxury" style="--tab:@(activeTab=="units"?0:1)"></div>
            </div>

            <div class="mudtabs-body-luxury">
                @if (activeTab == "units")
                {
                    @if (units == null)
                    {
                        <div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل الوحدات...</p></div>
                    }
                    else if (!filteredUnits.Any())
                    {
                        <div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg></div><h4>لا توجد وحدات</h4></div>
                    }
                    else
                    {
                        <div class="units-grid-luxury">
                            @foreach (var unit in filteredUnits)
                            {
                                <div class="unit-card-luxury">
                                    <div class="uc-header">
                                        <div class="uc-icon type-@unit.UnitType?.ToLower()"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg></div>
                                        <div class="uc-info"><strong>@unit.UnitNameAr</strong><code>@unit.UnitCode</code></div>
                                        <span class="type-badge-luxury type-@unit.UnitType?.ToLower()">@UnitService.GetUnitTypeName(unit.UnitType)</span>
                                    </div>
                                    <div class="uc-body">
                                        <div class="uc-row"><span class="uc-label">الإنجليزي</span><span class="uc-value">@unit.UnitNameEn</span></div>
                                        <div class="uc-row"><span class="uc-label">عدد الأصناف</span><span class="uc-value"><span class="count-badge-luxury">@unit.ItemCount</span></span></div>
                                        <div class="uc-row"><span class="uc-label">التحويلات</span><span class="uc-value">@unit.ConversionCount تحويل</span></div>
                                    </div>
                                    <div class="uc-actions">
                                        @if (permissions.CanEdit){<button class="act-btn edit" @onclick="() => ShowEditDialog(unit)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                        @if (permissions.CanDelete){<button class="act-btn delete" @onclick="() => ShowDeleteConfirm(unit)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}
                                    </div>
                                    <div class="uc-gold-line"></div>
                                </div>
                            }
                        </div>

                        <!-- TABLE VIEW ALTERNATIVE -->
                        <div class="table-card-luxury" style="margin-top:16px">
                            <div class="table-responsive">
                                <table class="table-luxury">
                                    <thead><tr><th class="th-num">#</th><th>الكود</th><th>الاسم عربي</th><th>إنجليزي</th><th class="th-center">النوع</th><th class="th-center">أصناف</th><th class="th-center">تحويلات</th><th class="th-actions">إجراءات</th></tr></thead>
                                    <tbody>
                                        @{int rn=0;}
                                        @foreach (var unit in filteredUnits){rn++;
                                            <tr>
                                                <td class="td-num">@rn</td>
                                                <td><span class="code-luxury">@unit.UnitCode</span></td>
                                                <td class="td-name">@unit.UnitNameAr</td>
                                                <td class="td-muted">@unit.UnitNameEn</td>
                                                <td class="td-center"><span class="type-badge-luxury type-@unit.UnitType?.ToLower()">@UnitService.GetUnitTypeName(unit.UnitType)</span></td>
                                                <td class="td-center"><span class="count-badge-luxury">@unit.ItemCount</span></td>
                                                <td class="td-center">@unit.ConversionCount</td>
                                                <td class="td-actions">
                                                    @if (permissions.CanEdit){<button class="act-btn edit" @onclick="() => ShowEditDialog(unit)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                                    @if (permissions.CanDelete){<button class="act-btn delete" @onclick="() => ShowDeleteConfirm(unit)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="conversion-section-luxury">
                        @if (permissions.CanAdd)
                        {
                            <div class="conv-form-luxury">
                                <div class="cf-gold-line"></div>
                                <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg>إضافة تحويل جديد</h4>
                                <div class="cf-grid">
                                    <div class="field-luxury">
                                        <label class="fl-label">من وحدة</label>
                                        <div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg><select @bind="convFromUnitId"><option value="0">-- اختر --</option>@if (units!=null){@foreach(var u in units){<option value="@u.UnitID">@u.UnitNameAr (@u.UnitCode)</option>}}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
                                    </div>
                                    <div class="cf-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></div>
                                    <div class="field-luxury">
                                        <label class="fl-label">إلى وحدة</label>
                                        <div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg><select @bind="convToUnitId"><option value="0">-- اختر --</option>@if (units!=null){@foreach(var u in units){<option value="@u.UnitID">@u.UnitNameAr (@u.UnitCode)</option>}}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
                                    </div>
                                    <div class="field-luxury">
                                        <label class="fl-label">المعامل</label>
                                        <div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M7 16V4m0 0L3 8m4-4l4 4"/><path d="M17 8v12m0 0 4-4m-4 4-4-4"/></svg><input type="number" @bind="convFactor" step="0.000001" placeholder="1.5" /></div>
                                    </div>
                                    <button class="btn-luxury btn-primary-luxury" @onclick="AddConversion"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة</button>
                                </div>
                                <div class="cf-preview">
                                    @if (convFromUnitId>0 && convToUnitId>0 && convFactor>0)
                                    {
                                        var fromU = units?.FirstOrDefault(u=>u.UnitID==convFromUnitId);
                                        var toU = units?.FirstOrDefault(u=>u.UnitID==convToUnitId);
                                        <span>1 @fromU?.UnitNameAr = @convFactor.ToString("#,##0.######") @toU?.UnitNameAr</span>
                                    }
                                    else{<span class="no-val">اختر الوحدات والمعامل لمعاينة التحويل</span>}
                                </div>
                            </div>
                        }

                        <div class="table-card-luxury">
                            <div class="table-responsive">
                                <table class="table-luxury">
                                    <thead><tr><th class="th-num">#</th><th>من وحدة</th><th class="th-center">→</th><th>إلى وحدة</th><th class="th-center">المعامل</th><th class="th-center">مثال</th>@if (permissions.CanDelete){<th class="th-actions">حذف</th>}</tr></thead>
                                    <tbody>
                                        @{int cNum=0;}
                                        @foreach (var conv in conversions){cNum++;
                                            <tr>
                                                <td class="td-num">@cNum</td>
                                                <td><strong>@conv.FromUnitName</strong> <span class="code-luxury">@conv.FromUnitCode</span></td>
                                                <td class="td-center"><span class="conv-arrow-luxury">→</span></td>
                                                <td><strong>@conv.ToUnitName</strong> <span class="code-luxury">@conv.ToUnitCode</span></td>
                                                <td class="td-center"><span class="factor-badge">@conv.ConversionFactor.ToString("#,##0.######")</span></td>
                                                <td class="td-center" style="color:#6b7280;font-size:.82rem">1 @conv.FromUnitName = @conv.ConversionFactor.ToString("#,##0.######") @conv.ToUnitName</td>
                                                @if (permissions.CanDelete){<td class="td-actions"><button class="act-btn delete" @onclick="() => DeleteConversion(conv.ConversionID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button></td>}
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (showFormDialog)
    {
        <div class="modal-overlay-luxury" @onclick="CloseDialog">
            <div class="modal-card-luxury" @onclick:stopPropagation="true">
                <div class="ml-gold-line"></div>
                <div class="ml-header">
                    <div class="ml-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg></div>
                    <div class="ml-text"><h3>@(isEditMode?"تعديل وحدة قياس":"إضافة وحدة قياس")</h3><p>@(isEditMode?"تحديث بيانات الوحدة":"أدخل بيانات الوحدة الجديدة")</p></div>
                    <button class="ml-close" @onclick="CloseDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>
                </div>
                <div class="ml-body">
                    <div class="form-grid-luxury cols-2">
                        <div class="field-luxury"><label class="fl-label required">كود الوحدة</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6"/><path d="M9 15h6"/></svg><input type="text" @bind="editItem.UnitCode" placeholder="KG" dir="ltr" /></div></div>
                        <div class="field-luxury"><label class="fl-label required">النوع</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg><select @bind="editItem.UnitType"><option value="">-- اختر النوع --</option><option value="Weight">وزن</option><option value="Volume">حجم</option><option value="Count">عدد</option><option value="Length">طول</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                    </div>
                    <div class="form-grid-luxury cols-2">
                        <div class="field-luxury"><label class="fl-label required">اسم الوحدة (عربي)</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" @bind="editItem.UnitNameAr" placeholder="كيلو جرام" /></div></div>
                        <div class="field-luxury"><label class="fl-label">اسم الوحدة (إنجليزي)</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" @bind="editItem.UnitNameEn" placeholder="Kilogram" dir="ltr" /></div></div>
                    </div>
                    <div class="preview-card-luxury"><h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>معاينة</h4><div class="pc-body"><span class="code-luxury">@(string.IsNullOrWhiteSpace(editItem.UnitCode)?"CODE":editItem.UnitCode)</span><strong>@(string.IsNullOrWhiteSpace(editItem.UnitNameAr)?"اسم الوحدة":editItem.UnitNameAr)</strong><span class="type-badge-luxury type-@editItem.UnitType?.ToLower()">@(string.IsNullOrEmpty(editItem.UnitType)?"النوع":UnitService.GetUnitTypeName(editItem.UnitType))</span></div></div>
                    @if (!string.IsNullOrEmpty(formMessage)){<div class="msg-luxury @(formSuccess?"msg-success":"msg-error")">@formMessage</div>}
                </div>
                <div class="ml-footer">
                    <button class="btn-luxury btn-primary-luxury" @onclick="SaveUnit" disabled="@isSaving">@if (isSaving){<div class="btn-spinner-sm"></div><span>جاري الحفظ...</span>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H6v8"/></svg><span>@(isEditMode?"حفظ التعديلات":"حفظ")</span>}</button>
                    <button class="btn-luxury btn-ghost-luxury" @onclick="CloseDialog">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (showDeleteDialog)
    {
        <div class="modal-overlay-luxury" @onclick="CloseDeleteDialog">
            <div class="modal-card-luxury small" @onclick:stopPropagation="true">
                <div class="ml-gold-line danger"></div>
                <div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div>
                <h4>تأكيد الحذف</h4><p>هل أنت متأكد من حذف الوحدة: <strong class="delete-name">@deleteUnit?.UnitNameAr</strong>؟</p>
                @if (!string.IsNullOrEmpty(deleteMessage)){<div class="msg-luxury msg-error">@deleteMessage</div>}
                <div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDelete">تأكيد الحذف</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseDeleteDialog">إلغاء</button></div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultMessage)){<div class="toast-luxury"><div class="toast-card-luxury @(resultSuccess?"success":"error")"><span>@resultMessage</span><button @onclick='() => resultMessage=""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
