@page "/cheques"
@using YKCoatings.Services
@using YKCoatings.Models
@inject TreasuryService TreasuryService
@inject LookupService LookupService
@inject UserSessionService UserSession

<PageTitle>إدارة الشيكات - Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><h4>يجب تسجيل الدخول</h4></div>}
else
{
<div class="luxury-page" dir="rtl">
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-content">
            <div class="lh-right">
                <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                <div class="lh-text">
                    <h2 class="lh-title">إدارة الشيكات</h2>
                    <p class="lh-subtitle">شيكات وارده وصادره</p>
                </div>
            </div>
            <div class="lh-actions">
                <span class="lh-badge"><span class="lh-dot"></span>@filteredList.Count شيك</span>
                <span class="lh-badge" style="background:rgba(16,185,129,.1);color:#059669;border-color:rgba(16,185,129,.15)">محصلة: @filteredList.Where(c=>c.ChequeStatus==3).Sum(c=>c.Amount).ToString("#,##0")</span>
                <span class="lh-badge" style="background:rgba(239,68,68,.08);color:#dc2626;border-color:rgba(239,68,68,.15)">مرتجعة: @filteredList.Count(c=>c.ChequeStatus==4)</span>
                <button class="btn-luxury btn-primary-luxury" @onclick="ShowAdd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>شيك جديد</button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل الشيكات...</p></div>}
    else
    {
        <div class="stats-luxury">
            <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><div class="st-info"><span class="st-value">@allList.Count</span><span class="st-label">إجمالي الشيكات</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><div class="st-info"><span class="st-value">@allList.Count(c=>c.ChequeType==1)</span><span class="st-label">واردة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><div class="st-info"><span class="st-value">@allList.Count(c=>c.ChequeType==2)</span><span class="st-label">صادرة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@allList.Where(c=>c.ChequeStatus==3).Sum(c=>c.Amount).ToString("#,##0")</span><span class="st-label">محصلة</span></div><div class="st-gold-line"></div></div>
        </div>

        <div class="filter-luxury">
            <div class="search-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="بحث برقم الشيك، البنك، العميل..." @bind="searchText" @bind:event="oninput" @onkeyup="ApplyFilter" />
                @if(!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}
            </div>
            <div class="select-wrap-luxury"><select @bind="filterType" @bind:after="ApplyFilter"><option value="0">كل الأنواع</option><option value="1">وارد</option><option value="2">صادر</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><select @bind="filterStatus" @bind:after="ApplyFilter"><option value="0">كل الحالات</option><option value="1">بالحافظة</option><option value="2">مقدم للبنك</option><option value="3">محصل</option><option value="4">مرتجع</option><option value="5">ملغي</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><input type="date" @bind="filterFrom" @bind:after="LoadFiltered" style="height:42px;border:1.5px solid #e8e2d0;border-radius:12px;padding:0 12px;font-family:'Tajawal';font-size:.82rem" /></div>
            <div class="select-wrap-luxury"><input type="date" @bind="filterTo" @bind:after="LoadFiltered" style="height:42px;border:1.5px solid #e8e2d0;border-radius:12px;padding:0 12px;font-family:'Tajawal';font-size:.82rem" /></div>
        </div>

        <div class="table-card-luxury">
            <div class="card-head-luxury">
                <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>الشيكات — @filteredList.Count شيك</h3>
                <div style="display:flex;gap:8px;align-items:center"><span class="legend-dot" style="--c:#2563eb"></span><span style="font-size:.7rem;color:#6b7280;font-weight:700">وارد</span><span class="legend-dot" style="--c:#dc2626"></span><span style="font-size:.7rem;color:#6b7280;font-weight:700">صادر</span></div>
            </div>
            <div class="table-responsive">
                <table class="table-luxury detailed">
                    <thead>
                        <tr>
                            <th class="th-num">#</th>
                            <th>رقم الشيك</th>
                            <th>النوع</th>
                            <th>التواريخ (تحرير / استحقاق)</th>
                            <th>البنك / الفرع</th>
                            <th>المبلغ</th>
                            <th>العميل / المورد</th>
                            <th>الحساب البنكي</th>
                            <th>الحالة</th>
                            <th>سند مرتبط</th>
                            <th class="th-actions">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int n=0;}
                        @foreach(var ch in filteredList.OrderByDescending(c=>c.DueDate)){n++;
                            <tr @key="ch.ChequeID">
                                <td class="td-num">@n</td>
                                <td><span class="doc-num-luxury">@ch.ChequeNumber</span></td>
                                <td>@if(ch.ChequeType==1){<span class="coa-type type-1">وارد</span>}else{<span class="coa-type type-6">صادر</span>}</td>
                                <td>
                                    <div style="display:flex;flex-direction:column;gap:2px;font-size:.78rem">
                                        <span>تحرير: @ch.ChequeDate.ToString("dd/MM/yyyy")</span>
                                        <span style="font-weight:800;color:@(ch.DueDate < DateTime.Today && ch.ChequeStatus==1 ? "#dc2626" : "#0A0F1E")">استحقاق: @ch.DueDate.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="acc-cell">
                                        <div class="acc-icon type-@(ch.ChequeType==1?1:6)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 6h14a2 2 0 0 1 2 2v8"/><path d="M9 21V10"/></svg></div>
                                        <div class="acc-info"><span class="acc-name">@ch.BankName</span><span class="acc-name-en">@ch.BranchName</span></div>
                                    </div>
                                </td>
                                <td><span class="amount-luxury">@ch.Amount.ToString("#,##0.00")</span><br/><span class="level-badge">@(ch.CurrencyCode ?? "EGP")</span></td>
                                <td class="td-muted">@(ch.EntityName ?? "—")</td>
                                <td class="td-muted">@(ch.BankAccountName ?? "—")</td>
                                <td>
                                    @if(ch.ChequeStatus==1){<span class="status-badge-luxury" style="--sc:#6b7280"><span class="status-dot" style="--sc:#6b7280"></span>بالحافظة</span>}
                                    else if(ch.ChequeStatus==2){<span class="status-badge-luxury" style="--sc:#2563eb"><span class="status-dot" style="--sc:#2563eb"></span>مقدم للبنك</span>}
                                    else if(ch.ChequeStatus==3){<span class="status-badge-luxury" style="--sc:#10b981"><span class="status-dot" style="--sc:#10b981"></span>محصل</span>}
                                    else if(ch.ChequeStatus==4){<span class="status-badge-luxury" style="--sc:#dc2626"><span class="status-dot" style="--sc:#dc2626"></span>مرتجع</span>}
                                    else{<span class="status-badge-luxury" style="--sc:#9ca3af"><span class="status-dot" style="--sc:#9ca3af"></span>ملغي</span>}
                                    @if(ch.ChequeStatus==4 && !string.IsNullOrEmpty(ch.BounceReason)){<div style="font-size:.68rem;color:#dc2626;margin-top:4px">@ch.BounceReason</div>}
                                </td>
                                <td class="td-muted">@(ch.ReceiptNumber ?? ch.PaymentNumber ?? "—")</td>
                                <td class="td-center"><div class="actions-wrap-luxury">
                                    @if(ch.ChequeStatus==1){<button class="act-btn add" title="تحصيل" @onclick="()=>Collect(ch.ChequeID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 6L9 17l-5-5"/></svg></button>}
                                    @if(ch.ChequeStatus==1 || ch.ChequeStatus==2){<button class="act-btn" style="color:#dc2626;border-color:#fecaca" title="ارتجاع" @onclick="()=>Bounce(ch.ChequeID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg></button>}
                                    <button class="act-btn edit" title="تعديل" @onclick="()=>ShowEdit(ch.ChequeID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (showEdit)
{
    <div class="modal-overlay-luxury" @onclick="CloseEdit"><div class="modal-card-luxury large" @onclick:stopPropagation="true">
        <div class="ml-gold-line"></div>
        <div class="ml-header"><h3>@(editDto.ChequeID==0?"شيك جديد":"تعديل شيك") — Cheques 25 عمود فعلي</h3><button class="btn-close-x" @onclick="CloseEdit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
        <div class="ml-body">
            <div class="form-grid-luxury">
                <div class="fg"><label>رقم الشيك *</label><input type="text" @bind="editDto.ChequeNumber" /></div>
                <div class="fg"><label>النوع</label><select @bind="editDto.ChequeType"><option value="1">وارد</option><option value="2">صادر</option></select></div>
                <div class="fg"><label>تاريخ التحرير</label><input type="date" @bind="editDto.ChequeDate" /></div>
                <div class="fg"><label>تاريخ الاستحقاق *</label><input type="date" @bind="editDto.DueDate" /></div>
                <div class="fg"><label>المبلغ *</label><input type="number" @bind="editDto.Amount" step="0.01" /></div>
                <div class="fg"><label>العملة</label><select @bind="editDto.CurrencyID"><option value="0">— اختر —</option>@foreach(var cur in currencies){<option value="@cur.Id">@cur.Name</option>}</select></div>
                <div class="fg full"><label>البنك</label><input type="text" @bind="editDto.BankName" /></div>
                <div class="fg"><label>الفرع</label><input type="text" @bind="editDto.BranchName" /></div>
                <div class="fg"><label>الحساب البنكي</label><select @bind="editDto.BankAccountID"><option value="0">— اختر —</option>@foreach(var ba in bankAccounts){<option value="@ba.Id">@ba.Name</option>}</select></div>
                <div class="fg"><label>نوع الجهة</label><select @bind="editDto.EntityType"><option value="1">عميل</option><option value="2">مورد</option><option value="3">أخرى</option></select></div>
                <div class="fg"><label>الجهة</label><input type="text" @bind="editDto.EntityName" placeholder="اسم العميل/المورد" /></div>
                <div class="fg"><label>الحالة</label><select @bind="editDto.ChequeStatus"><option value="1">بالحافظة</option><option value="2">مقدم للبنك</option><option value="3">محصل</option><option value="4">مرتجع</option><option value="5">ملغي</option></select></div>
                <div class="fg full"><label>ملاحظات</label><textarea @bind="editDto.Notes" rows="2"></textarea></div>
            </div>
            @if(!string.IsNullOrEmpty(editMsg)){<div class="msg-luxury @(editOk?"msg-success":"msg-error")">@editMsg</div>}
        </div>
        <div class="ml-footer"><button class="btn-luxury btn-primary-luxury" @onclick="Save" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}حفظ</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseEdit">إلغاء</button></div>
    </div></div>
}

@if (showBounce)
{
    <div class="modal-overlay-luxury" @onclick="()=>showBounce=false"><div class="modal-card-luxury" @onclick:stopPropagation="true">
        <div class="ml-gold-line"></div>
        <div class="ml-header"><h3>ارتجاع شيك</h3><button class="btn-close-x" @onclick="()=>showBounce=false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
        <div class="ml-body"><div class="fg full"><label>سبب الارتجاع *</label><textarea @bind="bounceReason" rows="3" placeholder="مثال: عدم كفاية رصيد"></textarea></div></div>
        <div class="ml-footer"><button class="btn-luxury btn-primary-luxury" style="background:#dc2626" @onclick="ConfirmBounce">تأكيد الارتجاع</button><button class="btn-luxury btn-ghost-luxury" @onclick="()=>showBounce=false">إلغاء</button></div>
    </div></div>
}

@if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='()=>toast=""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,#121A2E 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain}
.lh-title{font-size:1.25rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.72rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:.2s;font-family:'Tajawal'}.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-luxury svg{width:14px;height:14px}.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
.st-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.2)}.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.st-icon.purple{background:#f5f3ff;color:#7c3aed;border:1px solid #ddd6fe}.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.st-icon svg{width:18px;height:18px}.st-info{display:flex;flex-direction:column}.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}.st-gold-line{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}.stat-luxury:hover .st-gold-line{opacity:.8}
.filter-luxury{display:flex;gap:10px;flex-wrap:wrap;align-items:center;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:12px}
.search-luxury{flex:1;min-width:280px;position:relative;display:flex;align-items:center}.search-luxury svg{position:absolute;right:12px;width:16px;height:16px;color:#9ca3af;pointer-events:none}.search-luxury input{width:100%;height:42px;padding:0 40px 0 36px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.86rem;font-family:'Tajawal';outline:none;background:#fcfaf6;transition:.2s}.search-luxury input:focus{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.clear-search-luxury{position:absolute;left:8px;width:26px;height:26px;border-radius:50%;border:none;background:#f3f4f6;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.clear-search-luxury svg{width:10px;height:10px}
.select-wrap-luxury{position:relative;display:flex;align-items:center}.select-wrap-luxury select{height:42px;padding:0 28px 0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.82rem;font-family:'Tajawal';background:#fff;appearance:none;cursor:pointer;outline:none;min-width:130px}.select-wrap-luxury .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.card-head-luxury{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8;flex-wrap:wrap;gap:8px}.card-head-luxury h3{font-size:.9rem;font-weight:800;color:#0A0F1E;display:flex;align-items:center;gap:8px;margin:0}.card-head-luxury h3 svg{width:16px;height:16px;color:var(--gold-dark)}.legend-dot{width:8px;height:8px;border-radius:50%;background:var(--c);box-shadow:0 0 0 3px color-mix(in srgb,var(--c) 15%,transparent);display:inline-block}
.table-responsive{overflow-x:auto}.table-luxury{width:100%;border-collapse:collapse;min-width:1300px}.table-luxury thead{background:linear-gradient(135deg,#fcfaf6,#f8f6f0)}.table-luxury th{padding:12px 14px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;white-space:nowrap}.table-luxury td{padding:12px 14px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}.table-luxury tbody tr:hover{background:rgba(212,175,55,.03)}
.th-num{width:45px;text-align:center}.th-actions{text-align:center;width:120px}.td-num{text-align:center;color:#9ca3af;font-size:.78rem}.td-center{text-align:center}.td-muted{color:#6b7280;font-size:.82rem}
.doc-num-luxury{color:var(--gold-dark);font-weight:800;font-size:.82rem;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:8px}
