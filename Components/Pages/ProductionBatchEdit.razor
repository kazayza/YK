@page "/production-batches/edit/{Id:int}"
@using YKCoatings.Services
@using YKCoatings.Models
@inject ProductionBatchService BatchService
@inject NavigationManager NavigationManager
@inject UserSessionService UserSession
@inject PermissionService PermissionService

<PageTitle>@(Id == 0 ? "دفعة إنتاج جديدة" : isViewMode ? "عرض دفعة الإنتاج" : "تعديل دفعة الإنتاج") - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card"><div class="no-access-icon">🔒</div><h4>يجب تسجيل الدخول أولاً</h4></div>
}
else if (permissions is null || !Perms.CanView)
{
    <div class="no-access-card">
        <div class="no-access-icon">⛔</div>
        <h4>ليس لديك صلاحية لعرض هذه الشاشة</h4>
        <button class="btn-back-dash" @onclick='() => NavigationManager.NavigateTo("/dashboard")'>العودة للرئيسية</button>
    </div>
}
else if (isLoading)
{
    <div class="loading-page"><div class="spinner-lg"></div><span>جاري التحميل...</span></div>
}
else
{
    <div class="batch-edit-page">

        <div class="page-header">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="bi bi-layers-fill"></i>
                    @if (Id == 0)
                    {
                        <span>إنشاء دفعة إنتاج جديدة</span>
                    }
                    else if (isViewMode)
                    {
                        <span>عرض دفعة الإنتاج</span>
                    }
                    else
                    {
                        <span>تعديل دفعة الإنتاج</span>
                    }
                </h1>
                @if (Id > 0)
                {
                    <p class="header-subtitle">
                        رقم الباتش: @batch.BatchNumber
                        <span class="status-chip-header @GetStatusClass(batch.BatchStatus)">
                            @GetStatusName(batch.BatchStatus)
                        </span>
                    </p>
                }
            </div>
            <div class="header-actions">
                <button class="btn-outline-light" @onclick="GoBack"><i class="bi bi-arrow-right"></i><span>رجوع</span></button>
            </div>
        </div>

        <div class="tabs-bar">
            <button class="tab-btn @(activeTab == "main" ? "active" : "")" @onclick='() => activeTab = "main"'>
                <i class="bi bi-info-circle-fill"></i> البيانات الأساسية
            </button>
            <button class="tab-btn @(activeTab == "stages" ? "active" : "")" @onclick="LoadStagesTab">
                <i class="bi bi-list-ol"></i> المراحل
            </button>
            <button class="tab-btn @(activeTab == "qc" ? "active" : "")" @onclick='() => activeTab = "qc"'>
                <i class="bi bi-shield-check"></i> الجودة
            </button>
            
            @if (Id > 0)
            {
                <button class="tab-btn @(activeTab == "audit" ? "active" : "")" @onclick="LoadAuditTab">
                    <i class="bi bi-clock-history"></i> معلومات النظام
                </button>
            }
        </div>

        @if (activeTab == "main")
        {
            <div class="form-card">
                <div class="form-card-header"><i class="bi bi-info-circle-fill"></i> بيانات دفعة الإنتاج</div>
                <div class="form-card-body">

                    <div class="form-row">
                        <div class="form-group col-4">
                            <label class="form-lbl required">أمر التصنيع</label>
                            <select class="form-ctrl"
                                    @bind="batch.ProductionOrderID"
                                    @bind:after="OnOrderChanged"
                                    disabled="@(isViewMode || Id > 0)">
                                <option value="0">— اختر أمر التصنيع —</option>
                                @foreach (var o in orderLookup)
                                {
                                    <option value="@o.Id">@o.Name</option>
                                }
                            </select>
                            @if (errors.ContainsKey("ProductionOrderID"))
                            {
                                <span class="field-error">@errors["ProductionOrderID"]</span>
                            }
                        </div>
                        <div class="form-group col-4">
                            <label class="form-lbl">المنتج</label>
                            <input class="form-ctrl readonly-field" value="@batch.ProductName" readonly />
                        </div>
                        <div class="form-group col-4">
                            <label class="form-lbl">رقم أمر التصنيع</label>
                            <input class="form-ctrl readonly-field" value="@batch.ProductionOrderNumber" readonly />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl">تاريخ الباتش</label>
                            <input type="date" class="form-ctrl" @bind="batch.BatchDate" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">تاريخ الصلاحية</label>
                            <input type="date" class="form-ctrl" @bind="batch.ExpiryDate" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl required">الكمية المخططة</label>
                            <input type="number" class="form-ctrl" step="0.01" min="0.01"
                                   @bind="batch.PlannedQty" disabled="@isViewMode" />
                            @if (errors.ContainsKey("PlannedQty"))
                            {
                                <span class="field-error">@errors["PlannedQty"]</span>
                            }
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl required">الوحدة</label>
                            <input class="form-ctrl readonly-field" value="@batch.UnitName" readonly />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl">إنتاج فعلي</label>
                            <input type="number" class="form-ctrl" step="0.01" @bind="batch.ProducedQty" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">صالح</label>
                            <input type="number" class="form-ctrl" step="0.01" @bind="batch.GoodQty" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">مرفوض</label>
                            <input type="number" class="form-ctrl" step="0.01" @bind="batch.RejectedQty" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">هالك</label>
                            <input type="number" class="form-ctrl" step="0.01" @bind="batch.WasteQty" disabled="@isViewMode" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl">عينات</label>
                            <input type="number" class="form-ctrl" step="0.01" @bind="batch.SampleQty" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">المخزن المستهدف</label>
                            <select class="form-ctrl" @bind="batch.TargetWarehouseID" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var w in warehouseLookup)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">أُنتج بواسطة</label>
                            <select class="form-ctrl" @bind="batch.ProducedBy" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var e in employeeLookup)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">المشرف</label>
                            <select class="form-ctrl" @bind="batch.SupervisorID" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var e in employeeLookup)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl">بداية التشغيل</label>
                            <input type="datetime-local" class="form-ctrl" @bind="batch.StartTime" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">نهاية التشغيل</label>
                            <input type="datetime-local" class="form-ctrl" @bind="batch.EndTime" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">تكلفة المواد</label>
                            <input type="number" class="form-ctrl" step="0.01" @bind="batch.MaterialCost" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">تكلفة العمالة</label>
                            <input type="number" class="form-ctrl" step="0.01" @bind="batch.LaborCost" disabled="@isViewMode" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl">مصاريف غير مباشرة</label>
                            <input type="number" class="form-ctrl" step="0.01" @bind="batch.OverheadCost" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">الإجمالي</label>
                            <input class="form-ctrl readonly-field" value="@CurrentTotalCost.ToString("N2")" readonly />
                        </div>
                        <div class="form-group col-12">
                            <label class="form-lbl">ملاحظات</label>
                            <textarea class="form-ctrl textarea-ctrl" rows="3" @bind="batch.Notes" disabled="@isViewMode"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (activeTab == "stages")
        {
    <div class="form-card">
        <div class="form-card-header">
            <div style="display:flex;align-items:center;gap:.5rem;">
                <i class="bi bi-list-ol"></i>
                مراحل الدفعة
                <span class="count-badge">@stages.Count مرحلة</span>
            </div>

            @if (Id > 0 && batch.BatchStatus <= 2 && Perms.CanEdit)
            {
                <button class="btn-stage-load" @onclick="ReloadStagesFromBom" disabled="@isSaving">
                    <i class="bi bi-arrow-repeat"></i>
                    إعادة تحميل المراحل
                </button>
            }
        </div>

        @if (stagesLoading)
        {
            <div class="state-box">
                <div class="spinner-md"></div>
                <span class="state-text">جاري تحميل المراحل...</span>
            </div>
        }
        else
        {
            <div class="stage-toolbar">
                <div class="form-group col-3">
                    <label class="form-lbl">الحرارة</label>
                    <input class="form-ctrl" @bind="stageTemperature" placeholder="مثال: 70°C" />
                </div>
                <div class="form-group col-3">
                    <label class="form-lbl">السرعة</label>
                    <input class="form-ctrl" @bind="stageSpeed" placeholder="مثال: 120 RPM" />
                </div>
                <div class="form-group col-3">
                    <label class="form-lbl">المشغل</label>
                    <select class="form-ctrl" @bind="stageOperatorId">
                        <option value="">— اختر —</option>
                        @foreach (var e in employeeLookup)
                        {
                            <option value="@e.Id">@e.Name</option>
                        }
                    </select>
                </div>
            </div>

            @if (!stages.Any())
            {
                <div class="state-box">
                    <div class="empty-icon-circle"><i class="bi bi-inbox"></i></div>
                    <p class="empty-title">لا توجد مراحل</p>
                    <p class="empty-sub">يمكن تحميل المراحل من الوصفة</p>
                </div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="stage-table">
                        <thead>
                            <tr>
                                <th style="width:50px;">#</th>
                                <th>المرحلة</th>
                                <th class="tc">الحالة</th>
                                <th class="tc">البداية</th>
                                <th class="tc">النهاية</th>
                                <th class="tc">المدة</th>
                                <th class="tc">المشغل</th>
                                <th class="tc">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < stages.Count; i++)
                            {
                                var s = stages[i];
                                <tr>
                                    <td class="tc">@(i + 1)</td>
                                    <td>@s.StageName</td>
                                    <td class="tc">
                                        <span class="stage-chip @GetStageStatusClass(s.StageStatus)">
                                            @s.StageStatusName
                                        </span>
                                    </td>
                                    <td class="tc">@(s.StartTime?.ToString("dd/MM HH:mm") ?? "—")</td>
                                    <td class="tc">@(s.EndTime?.ToString("dd/MM HH:mm") ?? "—")</td>
                                    <td class="tc">@(s.Duration.HasValue ? $"{s.Duration} د" : "—")</td>
                                    <td class="tc">@(!string.IsNullOrWhiteSpace(s.OperatorName) ? s.OperatorName : "—")</td>
                                    <td class="tc">
                                        <div class="stage-actions">
                                            @if (batch.BatchStatus <= 2 && Perms.CanEdit)
                                            {
                                                @if (s.StageStatus == 1 || s.StageStatus == 4)
                                                {
                                                    <button class="ico-btn start-stage-btn"
                                                            title="بدء المرحلة"
                                                            @onclick="() => StartStage(s.BatchStageID)">
                                                        <i class="bi bi-play-fill"></i>
                                                    </button>
                                                }
                                                @if (s.StageStatus == 2)
                                                {
                                                    <button class="ico-btn end-stage-btn"
                                                            title="إنهاء المرحلة"
                                                            @onclick="() => EndStage(s.BatchStageID)">
                                                        <i class="bi bi-stop-fill"></i>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
}


        @if (activeTab == "qc")
        {
            <div class="form-card">
                <div class="form-card-header"><i class="bi bi-shield-check"></i> بيانات الجودة</div>
                <div class="form-card-body">
                    <div class="form-row">
                        <div class="form-group col-4">
                            <label class="form-lbl">مفتش الجودة</label>
                            <select class="form-ctrl" @bind="batch.QCInspectedBy" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var e in employeeLookup)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-4">
                            <label class="form-lbl">تاريخ الفحص</label>
                            <input type="datetime-local" class="form-ctrl" @bind="batch.QCInspectionDate" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-4">
                            <label class="form-lbl">نتيجة الفحص</label>
                            <select class="form-ctrl" @bind="batch.QCResult" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                <option value="1">ناجح</option>
                                <option value="2">فاشل</option>
                                <option value="3">ناجح بتحفظ</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-12">
                            <label class="form-lbl">ملاحظات الجودة</label>
                            <textarea class="form-ctrl textarea-ctrl" rows="4" @bind="batch.QCNotes" disabled="@isViewMode"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        }

        

        @if (activeTab == "audit" && Id > 0)
        {
            <div class="form-card">
                <div class="form-card-header"><i class="bi bi-clock-history"></i> معلومات النظام</div>
                <div class="form-card-body">
                    @if (auditInfo is null)
                    {
                        <div class="state-box"><div class="spinner-md"></div></div>
                    }
                    else
                    {
                        <div class="audit-grid">
                            <div class="audit-item"><strong>أنشأ بواسطة:</strong> @auditInfo.CreatedByName</div>
                            <div class="audit-item"><strong>تاريخ الإنشاء:</strong> @(auditInfo.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                            <div class="audit-item"><strong>آخر تعديل:</strong> @auditInfo.ModifiedByName</div>
                            <div class="audit-item"><strong>تاريخ التعديل:</strong> @(auditInfo.ModifiedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                            <div class="audit-item"><strong>أنتج بواسطة:</strong> @auditInfo.ProducedByName</div>
                            <div class="audit-item"><strong>المشرف:</strong> @auditInfo.SupervisorName</div>
                            <div class="audit-item"><strong>فحص الجودة:</strong> @auditInfo.QCInspectedByName</div>
                            <div class="audit-item"><strong>تاريخ الفحص:</strong> @(auditInfo.QCInspectionDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="action-bar">
    <div class="action-bar-start">
        @if (Id > 0 && batch.BatchStatus == 1 && Perms.CanApprove)
        {
            <button class="btn-action start" @onclick="StartProduction" disabled="@isSaving">
                <i class="bi bi-play-circle-fill"></i> بدء التصنيع
            </button>
        }

        @if (Id > 0 && batch.BatchStatus == 2 && Perms.CanApprove)
        {
            <button class="btn-action done" @onclick="CompleteProduction" disabled="@isSaving">
                <i class="bi bi-check2-circle"></i> اكتمال التصنيع
            </button>
        }

        @if (Id > 0 && (batch.BatchStatus == 3 || batch.BatchStatus == 4) && Perms.CanApprove)
        {
            <button class="btn-action qc" @onclick="ApplyQc" disabled="@isSaving">
                <i class="bi bi-shield-check"></i> تسجيل نتيجة الجودة
            </button>
        }

        @if (Id > 0 && batch.BatchStatus == 5 && !inventoryAdded && Perms.CanApprove)
        {
            <button class="btn-action accept" @onclick="AddToInventory" disabled="@isSaving">
                <i class="bi bi-box-seam"></i> إدخال المخزن
            </button>
        }

        @if (Id > 0 && batch.BatchStatus == 5 && inventoryAdded)
        {
            <span class="inventory-done-chip">
                <i class="bi bi-check-circle-fill"></i>
                تم إدخال الدفعة إلى المخزون
            </span>
        }
    </div>

    <div class="action-bar-end">
        @if (!isViewMode)
        {
            <button class="btn-save" @onclick="SaveBatch" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-tiny"></span><span>جاري الحفظ...</span>
                }
                else
                {
                    <i class="bi bi-check-lg"></i><span>@(Id == 0 ? "حفظ الدفعة" : "حفظ التعديلات")</span>
                }
            </button>
        }
        <button class="btn-back" @onclick="GoBack"><i class="bi bi-arrow-right"></i><span>رجوع</span></button>
    </div>
</div>
    </div>
}

@if (!string.IsNullOrEmpty(resultMessage))
{
    <div class="toast-msg @(isSuccess ? "toast-success" : "toast-error")">
        <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
        @resultMessage
    </div>
}

<style>
    :root {
        --c-primary:#0f766e; --c-primary-lt:#f0fdfa; --c-primary-dk:#115e59;
        --c-success:#10b981; --c-success-lt:#ecfdf5;
        --c-warning:#f59e0b; --c-warning-lt:#fffbeb;
        --c-danger:#ef4444; --c-danger-lt:#fef2f2;
        --c-info:#0ea5e9; --c-info-lt:#f0f9ff;
        --c-secondary:#64748b; --c-secondary-lt:#f1f5f9;
        --c-surface:#fff; --c-bg:#f8fafc; --c-border:#e2e8f0;
        --c-text:#0f172a; --c-text-2:#64748b; --c-text-3:#94a3b8;
        --r-sm:8px; --r-md:12px; --r-lg:16px; --r-xl:20px;
        --sh-sm:0 1px 3px rgba(0,0,0,.06); --sh-md:0 4px 16px rgba(0,0,0,.08);
    }

    .batch-edit-page { direction:rtl; padding:1.75rem 1.5rem; background:var(--c-bg); min-height:100vh; font-family:'Segoe UI',system-ui,sans-serif; display:flex; flex-direction:column; gap:1.25rem; }
    .no-access-card { text-align:center; padding:80px 20px; background:white; border-radius:var(--r-xl); border:1px solid var(--c-border); max-width:480px; margin:80px auto; box-shadow:var(--sh-sm); }
    .no-access-icon { font-size:3.5rem; margin-bottom:16px; }
    .btn-back-dash { background:var(--c-secondary-lt); color:var(--c-secondary); border:none; padding:.6rem 1.4rem; border-radius:var(--r-sm); font-weight:600; cursor:pointer; }

    .loading-page { display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:60vh; gap:1rem; color:var(--c-text-3); }
    .spinner-lg { width:56px; height:56px; border:4px solid var(--c-border); border-top-color:var(--c-primary); border-radius:50%; animation:spin .7s linear infinite; }

    .page-header { background:linear-gradient(135deg,var(--c-primary),var(--c-primary-dk)); border-radius:var(--r-xl); padding:1.5rem 2rem; display:flex; justify-content:space-between; align-items:center; box-shadow:0 8px 32px rgba(15,118,110,.25); position:relative; overflow:hidden; flex-wrap:wrap; gap:1rem; }
    .page-header::before { content:''; position:absolute; top:-40px; left:-40px; width:180px; height:180px; background:rgba(255,255,255,.06); border-radius:50%; }
    .header-content { position:relative; z-index:1; }
    .header-actions {position: relative;z-index: 1;}
    .header-title { color:#fff; font-size:1.35rem; font-weight:700; margin:0 0 .2rem; display:flex; gap:.5rem; align-items:center; }
    .header-subtitle { color:rgba(255,255,255,.8); font-size:.85rem; margin:0; display:flex; align-items:center; gap:.6rem; }
    .status-chip-header { display:inline-flex; align-items:center; gap:.3rem; padding:.2rem .6rem; border-radius:20px; font-size:.72rem; font-weight:700; }
    .btn-outline-light { background:rgba(255,255,255,.15); color:#fff; border:1px solid rgba(255,255,255,.3); padding:.5rem 1rem; border-radius:var(--r-sm); font-weight:600; cursor:pointer; display:flex; align-items:center; gap:.4rem; }

    .tabs-bar { display:flex; gap:.5rem; background:var(--c-surface); padding:.5rem; border-radius:var(--r-md); border:1px solid var(--c-border); box-shadow:var(--sh-sm); flex-wrap:wrap; }
    .tab-btn { background:transparent; border:none; padding:.6rem 1.2rem; border-radius:var(--r-sm); font-size:.85rem; font-weight:600; color:var(--c-text-2); cursor:pointer; display:flex; align-items:center; gap:.4rem; }
    .tab-btn:hover { background:var(--c-primary-lt); color:var(--c-primary); }
    .tab-btn.active { background:var(--c-primary); color:#fff; }

