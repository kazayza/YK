@page "/production-batches/edit/{Id:int}"
@using YKCoatings.Services
@using YKCoatings.Models
@inject ProductionBatchService BatchService
@inject NavigationManager NavigationManager
@inject UserSessionService UserSession
@inject PermissionService PermissionService

<PageTitle>@(Id == 0 ? "دفعة إنتاج جديدة" : isViewMode ? "عرض دفعة الإنتاج" : "تعديل دفعة الإنتاج") - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="pb-no-access-card"><div class="pb-no-access-icon"><i class="bi bi-lock-fill"></i></div><h4>يجب تسجيل الدخول أولاً</h4></div>
}
else if (permissions is null || !Perms.CanView)
{
    <div class="pb-no-access-card">
        <div class="pb-no-access-icon"><i class="bi bi-shield-lock-fill"></i></div>
        <h4>ليس لديك صلاحية لعرض هذه الشاشة</h4>
        <button class="pb-btn-back-dash" @onclick='() => NavigationManager.NavigateTo("/dashboard")'>العودة للرئيسية</button>
    </div>
}
else if (isLoading)
{
    <div class="pb-loading-page"><div class="pb-spinner-lg"></div><span>جاري التحميل...</span></div>
}
else
{
    <div class="batch-edit-page">

        <div class="page-header">
            <div class="header-content">
                <div class="header-eyebrow"><i class="bi bi-diagram-3"></i> التصنيع <span>/</span> دفعات الإنتاج</div>
                <h1 class="header-title">
                    <i class="bi bi-layers-fill"></i>
                    @if (Id == 0)
                    {
                        <span>إنشاء دفعة إنتاج</span>
                    }
                    else if (isViewMode)
                    {
                        <span>عرض دفعة الإنتاج</span>
                    }
                    else
                    {
                        <span>تعديل دفعة الإنتاج</span>
                    }
                </h1>
                @if (Id > 0)
                {
                    <p class="header-subtitle">
                        <span class="batch-number-chip">@batch.BatchNumber</span>
                        <span class="header-separator">·</span>
                        <span>@batch.ProductionOrderNumber</span>
                        <span class="header-separator">·</span>
                        <span>@batch.ProductName</span>
                        <span class="status-chip-header @GetStatusClass(batch.BatchStatus)">@GetStatusName(batch.BatchStatus)</span>
                    </p>
                }
                else
                {
                    <p class="header-subtitle">سجّل دفعة جديدة مرتبطة بأمر تصنيع قائم؛ لن يبدأ التشغيل عند الحفظ.</p>
                }
            </div>
            <div class="header-actions">
                <button class="btn-outline-light" @onclick="GoBack"><i class="bi bi-arrow-right"></i><span>رجوع للقائمة</span></button>
            </div>
        </div>

        @if (Id > 0)
        {
            <div class="batch-overview-grid">
                <div class="batch-overview-card"><span class="overview-icon"><i class="bi bi-clipboard2-check"></i></span><div><small>أمر التصنيع</small><strong>@batch.ProductionOrderNumber</strong></div></div>
                <div class="batch-overview-card"><span class="overview-icon"><i class="bi bi-bullseye"></i></span><div><small>الكمية المخططة</small><strong>@batch.PlannedQty.ToString("N4") <em>@batch.UnitName</em></strong></div></div>
                <div class="batch-overview-card"><span class="overview-icon"><i class="bi bi-gear-wide-connected"></i></span><div><small>الإنتاج الفعلي</small><strong>@batch.ProducedQty.ToString("N4") <em>@batch.UnitName</em></strong></div></div>
                <div class="batch-overview-card"><span class="overview-icon"><i class="bi bi-box-seam"></i></span><div><small>مخزن المنتج</small><strong>@(string.IsNullOrWhiteSpace(batch.TargetWarehouseName) ? "غير محدد" : batch.TargetWarehouseName)</strong></div></div>
            </div>
        }

        <div class="tabs-bar">
            <button class="tab-btn @(activeTab == "main" ? "active" : "")" @onclick='() => activeTab = "main"'>
                <i class="bi bi-info-circle-fill"></i> البيانات الأساسية
            </button>
            <button class="tab-btn @(activeTab == "stages" ? "active" : "")" @onclick="LoadStagesTab">
                <i class="bi bi-list-ol"></i> المراحل
            </button>
            <button class="tab-btn @(activeTab == "qc" ? "active" : "")" @onclick='() => activeTab = "qc"'>
                <i class="bi bi-shield-check"></i> الجودة
            </button>
            
            @if (Id > 0)
            {
                <button class="tab-btn @(activeTab == "audit" ? "active" : "")" @onclick="LoadAuditTab">
                    <i class="bi bi-clock-history"></i> معلومات النظام
                </button>
            }
        </div>

        @if (activeTab == "main")
        {
            <div class="form-card">
                <div class="form-card-header"><i class="bi bi-info-circle-fill"></i> بيانات دفعة الإنتاج</div>
                <div class="form-card-body">

                    <div class="form-row">
                        <div class="form-group col-4">
                            <label class="form-lbl required">أمر التصنيع</label>
                            <select class="form-ctrl"
                                    @bind="batch.ProductionOrderID"
                                    @bind:after="OnOrderChanged"
                                    disabled="@(isViewMode || Id > 0)">
                                <option value="0">— اختر أمر التصنيع —</option>
                                @foreach (var o in orderLookup)
                                {
                                    <option value="@o.Id">@o.Name</option>
                                }
                            </select>
                            @if (errors.ContainsKey("ProductionOrderID"))
                            {
                                <span class="field-error">@errors["ProductionOrderID"]</span>
                            }
                        </div>
                        <div class="form-group col-4">
                            <label class="form-lbl">المنتج</label>
                            <input class="form-ctrl readonly-field" value="@batch.ProductName" readonly />
                        </div>
                        <div class="form-group col-4">
                            <label class="form-lbl">رقم أمر التصنيع</label>
                            <input class="form-ctrl readonly-field" value="@batch.ProductionOrderNumber" readonly />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl">تاريخ الباتش</label>
                            <input type="date" class="form-ctrl" @bind="batch.BatchDate" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">تاريخ الصلاحية</label>
                            <input type="date" class="form-ctrl" @bind="batch.ExpiryDate" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl required">الكمية المخططة</label>
                            <input type="number" class="form-ctrl" step="0.01" min="0.01"
                                   @bind="batch.PlannedQty" disabled="@isViewMode" />
                            @if (errors.ContainsKey("PlannedQty"))
                            {
                                <span class="field-error">@errors["PlannedQty"]</span>
                            }
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl required">الوحدة</label>
                            <input class="form-ctrl readonly-field" value="@batch.UnitName" readonly />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl">إنتاج فعلي قبل الجودة</label>
                            <input type="number" class="form-ctrl" step="0.0001" min="0"
                                   @bind="batch.ProducedQty" disabled="@isViewMode" />
                            <small class="form-hint">إجمالي الناتج من التشغيل؛ سيُقسّم في تبويب الجودة إلى صالح ومرفوض وعينات وهالك.</small>
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">المخزن المستهدف</label>
                            <select class="form-ctrl" @bind="batch.TargetWarehouseID" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var w in warehouseLookup)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">أُنتج بواسطة</label>
                            <select class="form-ctrl" @bind="batch.ProducedBy" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var e in employeeLookup)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">المشرف</label>
                            <select class="form-ctrl" @bind="batch.SupervisorID" disabled="@isViewMode">
                                <option value="">— اختر —</option>
                                @foreach (var e in employeeLookup)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl">بداية التشغيل</label>
                            <input type="datetime-local" class="form-ctrl" @bind="batch.StartTime" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">نهاية التشغيل</label>
                            <input type="datetime-local" class="form-ctrl" @bind="batch.EndTime" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">تكلفة المواد</label>
                            <input type="number" class="form-ctrl" step="0.01" @bind="batch.MaterialCost" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">تكلفة العمالة</label>
                            <input type="number" class="form-ctrl" step="0.01" @bind="batch.LaborCost" disabled="@isViewMode" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-3">
                            <label class="form-lbl">مصاريف غير مباشرة</label>
                            <input type="number" class="form-ctrl" step="0.01" min="0" @bind="batch.OverheadCost" disabled="@isViewMode" />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">الإجمالي المسجل للدفعة</label>
                            <input class="form-ctrl readonly-field" value="@CurrentTotalCost.ToString("N2")" readonly />
                        </div>
                        <div class="form-group col-3">
                            <label class="form-lbl">تكلفة وحدة المنتج للترحيل (@batch.UnitName)</label>
                            <input type="number" class="form-ctrl" step="0.0001" min="0"
                                   @bind="batch.UnitCost" disabled="@(!CanEditUnitCost)" />
                            <small class="form-hint">تُدخل يدوياً بعد الجودة؛ تكلفة أذون الصرف لا تنتقل تلقائياً إلى «تكلفة المواد»، ولا تُوزّع التكلفة على الصالح والهالك/المرفوض تلقائياً.</small>
                            @if (CanSetOutputUnitCost)
                            {
                                <button type="button" class="btn-stage-load" @onclick="SaveOutputUnitCost" disabled="@isSaving">
                                    <i class="bi bi-save"></i> حفظ تكلفة الوحدة
                                </button>
                            }
                        </div>
                        <div class="form-group col-12">
                            <label class="form-lbl">ملاحظات</label>
                            <textarea class="form-ctrl textarea-ctrl" rows="3" @bind="batch.Notes" disabled="@isViewMode"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        }
        @if (activeTab == "stages")
        {
            <div class="form-card stage-panel">
                <div class="form-card-header stage-panel-header">
                    <div class="stage-panel-title">
                        <span class="stage-panel-icon"><i class="bi bi-list-ol"></i></span>
                        <div>
                            <strong>مراحل تنفيذ الدفعة</strong>
                            <small>التعليمات، قراءات التشغيل، المشغّل، والفحص المطلوب لكل مرحلة</small>
                        </div>
                        <span class="count-badge">@stages.Count مرحلة</span>
                    </div>
                    <div class="stage-panel-actions">
                        <span class="stage-summary-chip">@CompletedStageCount / @stages.Count مكتملة</span>
                        @if (Id > 0 && batch.BatchStatus == 1 && Perms.CanEdit && !stages.Any(x => !string.IsNullOrWhiteSpace(x.QualityResult)))
                        {
                            <button type="button" class="btn-stage-load" @onclick="ReloadStagesFromBom" disabled="@isSaving">
                                <i class="bi bi-arrow-repeat"></i> إعادة تحميل الوصفة
                            </button>
                        }
                    </div>
                </div>

                <div class="form-card-body">
                    <div class="stage-overview">
                        <div>
                            <strong>متابعة تسلسل التشغيل</strong>
                            <p>لا يمكن بدء مرحلة قبل اكتمال المراحل السابقة. بدء المرحلة وتسجيل نتيجتها إجراءان منفصلان.</p>
                        </div>
                        <div class="stage-progress-wrap">
                            <div class="stage-progress-track"><span style="@($"width:{StageCompletionPercent}%")"></span></div>
                            <b>@StageCompletionPercent%</b>
                        </div>
                    </div>

                    @if (stagesLoading)
                    {
                        <div class="state-box"><div class="spinner-md"></div><span class="state-text">جاري تحميل المراحل...</span></div>
                    }
                    else if (!stages.Any())
                    {
                        <div class="state-box">
                            <div class="empty-icon-circle"><i class="bi bi-inbox"></i></div>
                            <p class="empty-title">لا توجد مراحل مرتبطة بهذه الدفعة</p>
                            <p class="empty-sub">تحقق من مراحل الوصفة أو أعد تحميلها إذا كانت الدفعة ما تزال مسودة.</p>
                        </div>
                    }
                    else
                    {
                        <div class="stage-table-wrap">
                            <table class="stage-table">
                                <thead>
                                    <tr>
                                        <th scope="col" class="tc">#</th>
                                        <th scope="col">المرحلة</th>
                                        <th scope="col" class="tc">الحالة</th>
                                        <th scope="col" class="tc">فحص المرحلة</th>
                                        <th scope="col" class="tc">البداية</th>
                                        <th scope="col" class="tc">النهاية</th>
                                        <th scope="col" class="tc">مدة التنفيذ</th>
                                        <th scope="col" class="tc">مدة الوصفة</th>
                                        <th scope="col" class="tc">المشغّل</th>
                                        <th scope="col" class="tc">إجراء</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in stages.OrderBy(x => x.StageOrder))
                                    {
                                        var startFields = GetStageStartFields(s);
                                        var canStartStage = CanStartStage(s);
                                        <tr class="stage-main-row">
                                            <td class="tc stage-number-cell">@s.StageOrder</td>
                                            <td class="stage-name-cell">
                                                <strong>@s.StageName</strong>
                                                @if (!string.IsNullOrWhiteSpace(s.Instructions))
                                                {
                                                    <small>@s.Instructions</small>
                                                }
                                            </td>
                                            <td class="tc">
                                                <span class="stage-chip @GetStageStatusClass(s.StageStatus)">@s.StageStatusName</span>
                                            </td>
                                            <td class="tc">
                                                @if (s.QualityCheck)
                                                {
                                                    <span class="stage-qc-required"><i class="bi bi-shield-check"></i> مطلوب</span>
                                                }
                                                else
                                                {
                                                    <span class="stage-qc-not-required">غير مطلوب</span>
                                                }
                                            </td>
                                            <td class="tc">@(s.StartTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                            <td class="tc">@(s.EndTime?.ToString("dd/MM/yyyy HH:mm") ?? "—")</td>
                                            <td class="tc">@(s.Duration.HasValue ? $"{s.Duration} دقيقة" : "—")</td>
                                            <td class="tc stage-planned-duration">@FormatPlannedDuration(s.PlannedDuration)</td>
                                            <td class="tc">@(!string.IsNullOrWhiteSpace(s.OperatorName) ? s.OperatorName : "—")</td>
                                            <td class="tc stage-actions-cell">
                                                @if (batch.BatchStatus <= 2 && Perms.CanEdit && (s.StageStatus == 1 || s.StageStatus == 4))
                                                {
                                                    <button type="button" class="stage-icon-action stage-icon-start"
                                                            title="@(canStartStage ? "بدء تشغيل المرحلة" : "أكمل المرحلة السابقة أولاً")"
                                                            aria-label="بدء تشغيل المرحلة"
                                                            @onclick="() => StartStage(s)" disabled="@(!canStartStage || isSaving)">
                                                        <i class="bi bi-play-circle-fill"></i>
                                                    </button>
                                                }
                                                else if (batch.BatchStatus <= 2 && Perms.CanEdit && s.StageStatus == 2)
                                                {
                                                    <button type="button" class="stage-icon-action stage-icon-stop"
                                                            title="إنهاء تشغيل المرحلة" aria-label="إنهاء تشغيل المرحلة"
                                                            @onclick="() => EndStage(s.BatchStageID)" disabled="@isSaving">
                                                        <i class="bi bi-stop-circle-fill"></i>
                                                    </button>
                                                }
                                                else if (s.StageStatus == 3)
                                                {
                                                    <span class="stage-completed-icon" title="المرحلة مكتملة"><i class="bi bi-check-circle-fill"></i></span>
                                                }
                                                else
                                                {
                                                    <span class="stage-empty-action">—</span>
                                                }
                                            </td>
                                        </tr>
                                        <tr class="stage-detail-row">
                                            <td colspan="10">
                                                <div class="stage-detail-content">
                                                    <div class="stage-detail-heading">
                                                        <i class="bi bi-sliders"></i><strong>قراءات وتفاصيل المرحلة</strong>
                                                    </div>
                                                    <div class="stage-details-grid">
                                                        <div class="stage-detail-item"><span>الحرارة</span><strong>@(string.IsNullOrWhiteSpace(s.Temperature) ? "—" : s.Temperature)</strong></div>
                                                        <div class="stage-detail-item"><span>السرعة</span><strong>@(string.IsNullOrWhiteSpace(s.Speed) ? "—" : s.Speed)</strong></div>
                                                        <div class="stage-detail-item"><span>الرطوبة</span><strong>@(string.IsNullOrWhiteSpace(s.Humidity) ? "—" : s.Humidity)</strong></div>
                                                        <div class="stage-detail-item"><span>المشغّل</span><strong>@(!string.IsNullOrWhiteSpace(s.OperatorName) ? s.OperatorName : "—")</strong></div>
                                                    </div>

                                                    @if (!string.IsNullOrWhiteSpace(s.Notes) || (s.QualityCheck && !string.IsNullOrWhiteSpace(s.QualityCheckNotes)))
                                                    {
                                                        <div class="stage-notes-grid">
                                                            @if (!string.IsNullOrWhiteSpace(s.Notes))
                                                            {
                                                                <div class="stage-note-box"><strong><i class="bi bi-info-circle"></i> ملاحظات المرحلة</strong><span>@s.Notes</span></div>
                                                            }
                                                            @if (s.QualityCheck && !string.IsNullOrWhiteSpace(s.QualityCheckNotes))
                                                            {
                                                                <div class="stage-note-box stage-quality-instructions"><strong><i class="bi bi-clipboard-check"></i> تعليمات الفحص</strong><span>@s.QualityCheckNotes</span></div>
                                                            }
                                                        </div>
                                                    }

                                                    @if (s.QualityCheck)
                                                    {
                                                        <div class="stage-quality-panel">
                                                            <div class="stage-quality-copy">
                                                                <strong><i class="bi bi-shield-check"></i> نتيجة فحص المرحلة</strong>
                                                                <span>@(!string.IsNullOrWhiteSpace(s.QualityResult) ? s.QualityResult : "لم تُسجّل نتيجة بعد")</span>
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(s.QualityResult))
                                                            {
                                                                <span class="stage-quality-locked" title="نتيجة فحص المرحلة مثبتة بعد الحفظ">
                                                                    <i class="bi bi-lock-fill"></i><span>النتيجة مثبتة</span>
                                                                </span>
                                                            }
                                                            else if (batch.BatchStatus == 5 || batch.BatchStatus == 6)
                                                            {
                                                                <span class="stage-quality-locked" title="أُغلق سجل المراحل بعد قرار الجودة النهائي">
                                                                    <i class="bi bi-lock-fill"></i><span>أُغلق سجل الفحص</span>
                                                                </span>
                                                            }
                                                            else if (batch.BatchStatus == 1 || s.StageStatus == 1)
                                                            {
                                                                <span class="stage-quality-pending"><i class="bi bi-hourglass-split"></i> يظهر التسجيل بعد بدء المرحلة</span>
                                                            }
                                                            else if (Perms.CanApprove)
                                                            {
                                                                <div class="stage-quality-entry">
                                                                    <input class="form-ctrl stage-quality-result" @bind="s.QualityResult"
                                                                           placeholder="اكتب النتيجة الفعلية" disabled="@isSaving" />
                                                                    <button type="button" class="btn-stage-quality-save" title="حفظ نتيجة فحص المرحلة"
                                                                            @onclick="() => SaveStageQualityResult(s.BatchStageID, s.QualityResult)" disabled="@isSaving">
                                                                        <i class="bi bi-save-fill"></i><span>حفظ نتيجة الفحص</span>
                                                                    </button>
                                                                </div>
                                                            }
                                                        </div>
                                                    }

                                                    @if (batch.BatchStatus <= 2 && Perms.CanEdit && (s.StageStatus == 1 || s.StageStatus == 4))
                                                    {
                                                        <div class="stage-start-panel">
                                                            <div class="stage-start-heading">
                                                                <strong><i class="bi bi-sliders"></i> بيانات بدء هذه المرحلة</strong>
                                                                <span>أدخل أو راجع القراءات الفعلية قبل بدء التشغيل.</span>
                                                            </div>
                                                            <div class="stage-start-grid">
                                                                <div class="form-group">
                                                                    <label class="form-lbl">الحرارة</label>
                                                                    <input class="form-ctrl" @bind="startFields.Temperature" placeholder="مثال: 70°C" disabled="@isSaving" />
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="form-lbl">السرعة</label>
                                                                    <input class="form-ctrl" @bind="startFields.Speed" placeholder="مثال: 120 RPM" disabled="@isSaving" />
                                                                </div>
                                                                <div class="form-group">
                                                                    <label class="form-lbl">المشغّل</label>
                                                                    <select class="form-ctrl" @bind="startFields.OperatorID" disabled="@isSaving">
                                                                        <option value="">— اختر —</option>
                                                                        @foreach (var e in employeeLookup)
                                                                        {
                                                                            <option value="@e.Id">@e.Name</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                            @if (canStartStage)
                                                            {
                                                                <span class="stage-start-hint"><i class="bi bi-info-circle"></i> راجع البيانات ثم استخدم أيقونة التشغيل في صف المرحلة.</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="stage-blocked-note"><i class="bi bi-lock"></i> أكمل المرحلة السابقة أو أنهِ المرحلة الجارية أولًا.</span>
                                                            }
                                                        </div>
                                                    }
                                                    else if (batch.BatchStatus <= 2 && Perms.CanEdit && s.StageStatus == 2)
                                                    {
                                                        <div class="stage-running-note"><i class="bi bi-play-circle-fill"></i> هذه المرحلة قيد التنفيذ؛ استخدم أيقونة الإيقاف في صف المرحلة عند اكتمالها.</div>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        @if (activeTab == "qc")
        {
            <div class="form-card qc-panel">
                <div class="form-card-header qc-panel-header">
                    <div><i class="bi bi-shield-check"></i><strong>فحص جودة الدفعة</strong></div>
                    @if (Id > 0)
                    {
                        <span class="status-chip-header @GetStatusClass(batch.BatchStatus)">@GetStatusName(batch.BatchStatus)</span>
                    }
                </div>
                <div class="form-card-body">
                    <div class="qc-quantity-summary">
                        <div class="qc-summary-item"><span>الإنتاج الفعلي</span><strong>@batch.ProducedQty.ToString("N4") @batch.UnitName</strong></div>
                        <div class="qc-summary-item"><span>إجمالي الكميات المصنفة</span><strong>@QcClassifiedQty.ToString("N4") @batch.UnitName</strong></div>
                        <div class="qc-summary-item"><span>المتبقي للتصنيف</span><strong class="@(QcRemainingQty == 0 ? "qc-balanced" : "qc-unbalanced")">@QcRemainingQty.ToString("N4") @batch.UnitName</strong></div>
                    </div>
                    <div class="qc-balance-message @(QcQuantitiesMatch ? "is-balanced" : "is-unbalanced")">
                        <i class="bi @(QcQuantitiesMatch ? "bi-check-circle-fill" : "bi-exclamation-circle-fill")"></i>
                        @if (batch.ProducedQty <= 0)
                        {
                            <span>أدخل كمية الإنتاج الفعلية أولًا قبل تسجيل نتيجة الجودة.</span>
                        }
                        else if (QcQuantitiesMatch)
                        {
                            <span>توزيع الكميات يساوي الإنتاج الفعلي.</span>
                        }
                        else
                        {
                            <span>يجب أن يساوي مجموع الصالح والمرفوض والعينات والهالك كمية الإنتاج الفعلية.</span>
                        }
                    </div>

                    <div class="form-row">
                        <div class="form-group col-4">
                            <label class="form-lbl">مفتش الجودة</label>
                            <select class="form-ctrl" @bind="batch.QCInspectedBy" disabled="@(!CanEditQcData)">
                                <option value="">— اختر —</option>
                                @foreach (var e in employeeLookup)
                                {
                                    <option value="@e.Id">@e.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group col-4">
                            <label class="form-lbl">تاريخ الفحص</label>
                            <input type="datetime-local" class="form-ctrl" @bind="batch.QCInspectionDate" disabled="true" />
                        </div>
                        <div class="form-group col-4">
                            <label class="form-lbl">نتيجة الفحص</label>
                            <select class="form-ctrl" @bind="batch.QCResult" disabled="@(!CanEditQcData)">
                                <option value="">— اختر —</option>
                                <option value="1">ناجح</option>
                                <option value="2">فاشل</option>
                                <option value="3">ناجح بتحفظ (حجز)</option>
                            </select>
                        </div>
                    </div>

                    <div class="qc-classification-title">
                        <div><i class="bi bi-boxes"></i><strong>تصنيف الناتج بعد الفحص</strong></div>
                        <span>الوحدة: @batch.UnitName</span>
                    </div>
                    <div class="qc-quantity-grid">
                        <div class="qc-quantity-card qc-good">
                            <label class="form-lbl">صالح</label>
                            <input type="number" class="form-ctrl" min="0" step="0.0001" @bind="batch.GoodQty" disabled="@(!CanEditQcData)" />
                        </div>
                        <div class="qc-quantity-card qc-rejected">
                            <label class="form-lbl">مرفوض</label>
                            <input type="number" class="form-ctrl" min="0" step="0.0001" @bind="batch.RejectedQty" disabled="@(!CanEditQcData)" />
                        </div>
                        <div class="qc-quantity-card qc-sample">
                            <label class="form-lbl">عينات</label>
                            <input type="number" class="form-ctrl" min="0" step="0.0001" @bind="batch.SampleQty" disabled="@(!CanEditQcData)" />
                        </div>
                        <div class="qc-quantity-card qc-waste">
                            <label class="form-lbl">هالك</label>
                            <input type="number" class="form-ctrl" min="0" step="0.0001" @bind="batch.WasteQty" disabled="@(!CanEditQcData)" />
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group col-12">
                            <label class="form-lbl">ملاحظات الجودة</label>
                            <textarea class="form-ctrl textarea-ctrl" rows="4" @bind="batch.QCNotes" disabled="@(!CanEditQcData)"></textarea>
                            <small class="form-hint">«ناجح بتحفظ» يُبقي الدفعة محجوزة في فحص الجودة. لا تُرحّل للمخزون حتى تُعاد وتُسجّل لها نتيجة قبول صريحة.</small>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (activeTab == "audit" && Id > 0)
        {
            <div class="form-card">
                <div class="form-card-header"><i class="bi bi-clock-history"></i> معلومات النظام</div>
                <div class="form-card-body">
                    @if (auditInfo is null)
                    {
                        <div class="state-box"><div class="spinner-md"></div></div>
                    }
                    else
                    {
                        <div class="audit-grid">
                            <div class="audit-item"><strong>أنشأ بواسطة:</strong> @auditInfo.CreatedByName</div>
                            <div class="audit-item"><strong>تاريخ الإنشاء:</strong> @(auditInfo.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                            <div class="audit-item"><strong>آخر تعديل:</strong> @auditInfo.ModifiedByName</div>
                            <div class="audit-item"><strong>تاريخ التعديل:</strong> @(auditInfo.ModifiedDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                            <div class="audit-item"><strong>أنتج بواسطة:</strong> @auditInfo.ProducedByName</div>
                            <div class="audit-item"><strong>المشرف:</strong> @auditInfo.SupervisorName</div>
                            <div class="audit-item"><strong>فحص الجودة:</strong> @auditInfo.QCInspectedByName</div>
                            <div class="audit-item"><strong>تاريخ الفحص:</strong> @(auditInfo.QCInspectionDate?.ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="action-bar">
    <div class="action-bar-start">
        @if (Id > 0 && batch.BatchStatus == 1 && Perms.CanEdit)
        {
            <button class="btn-action start" @onclick="StartProduction" disabled="@isSaving">
                <i class="bi bi-play-circle-fill"></i> بدء التصنيع
            </button>
        }

        @if (Id > 0 && batch.BatchStatus == 2 && Perms.CanEdit)
        {
            <button class="btn-action done" @onclick="CompleteProduction" disabled="@isSaving">
                <i class="bi bi-check2-circle"></i> اكتمال التصنيع
            </button>
        }

        @if (Id > 0 && (batch.BatchStatus == 3 || batch.BatchStatus == 4) && Perms.CanApprove)
        {
            <button class="btn-action qc" @onclick="ApplyQc" disabled="@(isSaving || !QcQuantitiesMatch)"
                    title="@(QcQuantitiesMatch ? "تسجيل نتيجة الجودة" : "طابق مجموع تصنيفات الجودة مع كمية الإنتاج الفعلية أولاً")">
                <i class="bi bi-shield-check"></i> تسجيل نتيجة الجودة
            </button>
        }

        @if (Id > 0 && batch.BatchStatus == 5 && !inventoryAdded && Perms.CanPost)
        {
            <button class="btn-action accept" @onclick="AddToInventory" disabled="@isSaving">
                <i class="bi bi-box-seam"></i> إدخال المخزن
            </button>
        }

        @if (Id > 0 && batch.BatchStatus == 5 && inventoryAdded)
        {
            <span class="inventory-done-chip">
                <i class="bi bi-check-circle-fill"></i>
                تم إدخال الدفعة إلى المخزون
            </span>
        }
    </div>

    <div class="action-bar-end">
        @if (!isViewMode)
        {
            <button class="btn-save" @onclick="SaveBatch" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-tiny"></span><span>جاري الحفظ...</span>
                }
                else
                {
                    <i class="bi bi-check-lg"></i><span>@(Id == 0 ? "حفظ الدفعة" : "حفظ التعديلات")</span>
                }
            </button>
        }
        <button class="btn-back" @onclick="GoBack"><i class="bi bi-arrow-right"></i><span>رجوع</span></button>
    </div>
</div>
    </div>
}

@if (!string.IsNullOrEmpty(resultMessage))
{
    <div class="pb-toast-msg @(isSuccess ? "pb-toast-success" : "pb-toast-error")">
        <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
        @resultMessage
    </div>
}

<style>
.batch-edit-page {
    --pb-gold: #c6a34a;
    --pb-gold-dark: #9d7a2c;
    --pb-gold-soft: #f7f1df;
    --pb-ink: #141922;
    --pb-ink-2: #303847;
    --pb-text: #202735;
    --pb-muted: #687386;
    --pb-border: #e4e0d5;
    --pb-surface: #ffffff;
    --pb-canvas: #f6f5f1;
    --pb-green: #19744d;
    --pb-red: #ad3434;
    --pb-orange: #a85814;
    direction: rtl;
    min-height: 100vh;
    padding: clamp(1rem, 2vw, 1.8rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: radial-gradient(circle at 90% 0%, #eee8d8 0, transparent 26rem), var(--pb-canvas);
    color: var(--pb-text);
    font-family: 'Tajawal', 'Segoe UI', system-ui, sans-serif;
}
.batch-edit-page * { box-sizing: border-box; }
.pb-no-access-card { text-align: center; padding: 4rem 1.25rem; background: #fff; border-radius: 18px; border: 1px solid #e4e0d5; max-width: 480px; margin: 5rem auto; box-shadow: 0 10px 30px rgba(20,25,34,.08); }
.pb-no-access-icon { color: #9d7a2c; font-size: 3.5rem; margin-bottom: 1rem; }
.pb-btn-back-dash { background: #f7f1df; color: #5f4b21; border: 1px solid #e7d8ae; padding: .65rem 1.35rem; border-radius: 9px; font-weight: 700; cursor: pointer; }
.pb-loading-page { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 60vh; gap: 1rem; color: #687386; font-family: 'Tajawal','Segoe UI',sans-serif; }
.pb-spinner-lg { width: 56px; height: 56px; border: 4px solid #e4e0d5; border-top-color: #c6a34a; border-radius: 50%; animation: pb-spin .7s linear infinite; }

.batch-edit-page .page-header { background: linear-gradient(118deg, #11151c 0%, #1d2530 62%, #57451f 100%); border-radius: 18px; padding: 1.5rem clamp(1.2rem, 3vw, 2rem); display: flex; justify-content: space-between; align-items: center; box-shadow: 0 12px 30px rgba(17,21,28,.16); position: relative; overflow: hidden; flex-wrap: wrap; gap: 1rem; }
.batch-edit-page .page-header::before { content: ''; position: absolute; inset: auto auto -105px -60px; width: 240px; height: 240px; border: 1px solid rgba(226,196,119,.22); border-radius: 50%; box-shadow: 0 0 0 28px rgba(226,196,119,.035), 0 0 0 58px rgba(226,196,119,.025); }
.batch-edit-page .header-content, .batch-edit-page .header-actions { position: relative; z-index: 1; }
.batch-edit-page .header-eyebrow { display: flex; align-items: center; gap: .45rem; margin-bottom: .45rem; color: #e5cb85; font-size: .76rem; font-weight: 700; letter-spacing: .02em; }
.batch-edit-page .header-eyebrow span { opacity: .6; }
.batch-edit-page .header-title { color: #fff; font-size: clamp(1.25rem,2vw,1.65rem); font-weight: 800; margin: 0 0 .4rem; display: flex; gap: .6rem; align-items: center; }
.batch-edit-page .header-title > i { color: #e2bd5f; }
.batch-edit-page .header-subtitle { color: rgba(255,255,255,.78); font-size: .87rem; margin: 0; display: flex; align-items: center; gap: .55rem; flex-wrap: wrap; }
.batch-edit-page .batch-number-chip { color: #f4dfaa; background: rgba(198,163,74,.16); border: 1px solid rgba(226,196,119,.35); border-radius: 7px; padding: .15rem .55rem; font-weight: 800; direction: ltr; }
.batch-edit-page .header-separator { color: #d4b55f; font-weight: 800; }
.batch-edit-page .status-chip-header { display: inline-flex; align-items: center; gap: .3rem; padding: .25rem .7rem; border-radius: 999px; font-size: .72rem; font-weight: 800; }
.batch-edit-page .status-chip-header.s-draft { background: #edf0f3; color: #4b5563; }
.batch-edit-page .status-chip-header.s-work { background: #fff0cf; color: #85520d; }
.batch-edit-page .status-chip-header.s-done { background: #e8efff; color: #3756a2; }
.batch-edit-page .status-chip-header.s-qc { background: #efeaff; color: #55428e; }
.batch-edit-page .status-chip-header.s-accepted { background: #e4f4eb; color: #176a45; }
.batch-edit-page .status-chip-header.s-rejected { background: #fbe9e8; color: #9e3333; }
.batch-edit-page .btn-outline-light { background: rgba(255,255,255,.08); color: #fff; border: 1px solid rgba(255,255,255,.24); padding: .62rem 1rem; border-radius: 9px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: .45rem; transition: .18s ease; }
.batch-edit-page .btn-outline-light:hover { background: rgba(198,163,74,.18); border-color: rgba(226,196,119,.65); }

.batch-edit-page .batch-overview-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: .75rem; }
.batch-edit-page .batch-overview-card { min-width: 0; display: flex; align-items: center; gap: .8rem; padding: .9rem 1rem; background: #fff; border: 1px solid var(--pb-border); border-radius: 13px; box-shadow: 0 3px 12px rgba(20,25,34,.035); }
.batch-edit-page .overview-icon { flex: 0 0 40px; height: 40px; display: grid; place-items: center; border-radius: 11px; background: var(--pb-gold-soft); color: var(--pb-gold-dark); font-size: 1.1rem; }
.batch-edit-page .batch-overview-card div { min-width: 0; display: flex; flex-direction: column; gap: .18rem; }
.batch-edit-page .batch-overview-card small { color: var(--pb-muted); font-size: .72rem; font-weight: 700; }
.batch-edit-page .batch-overview-card strong { color: var(--pb-ink); font-size: .95rem; overflow-wrap: anywhere; }
.batch-edit-page .batch-overview-card em { color: var(--pb-muted); font-size: .73rem; font-style: normal; }

.batch-edit-page .tabs-bar { display: flex; gap: .4rem; background: var(--pb-surface); padding: .45rem; border-radius: 12px; border: 1px solid var(--pb-border); box-shadow: 0 3px 12px rgba(20,25,34,.035); flex-wrap: wrap; }
.batch-edit-page .tab-btn { background: transparent; border: 1px solid transparent; padding: .65rem 1.05rem; border-radius: 9px; font-family: inherit; font-size: .86rem; font-weight: 800; color: #667085; cursor: pointer; display: flex; align-items: center; gap: .45rem; transition: .16s ease; }
.batch-edit-page .tab-btn:hover { background: #faf7ec; color: #80621f; }
.batch-edit-page .tab-btn.active { background: #171c24; color: #f2d47e; border-color: #171c24; box-shadow: 0 4px 10px rgba(17,21,28,.14); }

.batch-edit-page .form-card { background: var(--pb-surface); border-radius: 13px; box-shadow: 0 3px 12px rgba(20,25,34,.035); border: 1px solid var(--pb-border); overflow: hidden; }
.batch-edit-page .form-card-header { min-height: 52px; padding: .85rem 1.25rem; background: linear-gradient(90deg,#fbfaf6,#f7f5ef); border-bottom: 1px solid var(--pb-border); font-size: .92rem; font-weight: 800; color: var(--pb-ink); display: flex; align-items: center; gap: .55rem; }
.batch-edit-page .form-card-header > i { color: var(--pb-gold-dark); }
.batch-edit-page .form-card-body { padding: clamp(1rem,2vw,1.45rem); }
.batch-edit-page .form-row { display: flex; gap: 1rem; margin-bottom: 1rem; flex-wrap: wrap; }
.batch-edit-page .form-group { display: flex; flex-direction: column; gap: .35rem; min-width: 0; }
.batch-edit-page .col-3 { flex: 1 1 calc(25% - .75rem); min-width: 180px; }
.batch-edit-page .col-4 { flex: 1 1 calc(33.33% - .67rem); min-width: 210px; }
.batch-edit-page .col-12 { flex: 1 1 100%; }
.batch-edit-page .form-lbl { font-size: .8rem; font-weight: 800; color: #596476; }
.batch-edit-page .form-lbl.required::after { content: ' *'; color: #b74343; }
.batch-edit-page .form-ctrl { border: 1px solid #d9dce2; border-radius: 8px; padding: .62rem .8rem; font-family: inherit; font-size: .88rem; color: var(--pb-text); background: #fff; outline: none; width: 100%; transition: .16s ease; }
.batch-edit-page .form-ctrl:focus { border-color: var(--pb-gold); box-shadow: 0 0 0 3px rgba(198,163,74,.16); }
.batch-edit-page .form-ctrl:disabled { background: #f4f5f6; color: #747d8c; cursor: not-allowed; }
.batch-edit-page .readonly-field { background: #f7f6f2 !important; color: #667085 !important; }
.batch-edit-page .textarea-ctrl { resize: vertical; min-height: 74px; }
.batch-edit-page .form-hint { display: block; margin-top: .25rem; color: #737c8b; font-size: .75rem; line-height: 1.5; }
.batch-edit-page .field-error { font-size: .75rem; color: #b42323; font-weight: 700; }

.batch-edit-page .count-badge { background: var(--pb-gold-soft); color: #73591e; font-size: .73rem; font-weight: 800; padding: .25rem .65rem; border-radius: 999px; white-space: nowrap; }
.batch-edit-page .state-box { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2.5rem 1.5rem; gap: .8rem; text-align: center; }
.batch-edit-page .spinner-md { width: 40px; height: 40px; border: 3px solid var(--pb-border); border-top-color: var(--pb-gold-dark); border-radius: 50%; animation: pb-spin .7s linear infinite; }
.batch-edit-page .spinner-tiny { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.4); border-top-color: #fff; border-radius: 50%; animation: pb-spin .6s linear infinite; display: inline-block; }
.batch-edit-page .empty-icon-circle { width: 62px; height: 62px; background: var(--pb-gold-soft); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; color: var(--pb-gold-dark); }
.batch-edit-page .state-text, .batch-edit-page .empty-sub { color: #737c8b; font-size: .84rem; }
.batch-edit-page .empty-title { font-size: 1rem; font-weight: 800; color: var(--pb-ink); margin: 0; }

.batch-edit-page .stage-panel-header { justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
.batch-edit-page .stage-panel-title { display: flex; align-items: center; gap: .75rem; min-width: 0; }
.batch-edit-page .stage-panel-title > div { display: flex; flex-direction: column; gap: .15rem; }
.batch-edit-page .stage-panel-title strong { font-size: .95rem; }
.batch-edit-page .stage-panel-title small { color: var(--pb-muted); font-size: .74rem; font-weight: 500; }
.batch-edit-page .stage-panel-icon { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px; background: var(--pb-gold-soft); color: var(--pb-gold-dark); font-size: 1.1rem; }
.batch-edit-page .stage-panel-actions { display: flex; align-items: center; gap: .55rem; flex-wrap: wrap; }
.batch-edit-page .stage-summary-chip { border: 1px solid #e6dfca; background: #fffdf7; color: #6c5928; border-radius: 999px; padding: .3rem .7rem; font-size: .75rem; font-weight: 800; }
.batch-edit-page .btn-stage-load { background: #fff; color: #70591d; border: 1px solid #dfd1a6; border-radius: 8px; padding: .48rem .8rem; font-family: inherit; font-size: .78rem; font-weight: 800; cursor: pointer; display: inline-flex; align-items: center; gap: .35rem; transition: .15s ease; }
.batch-edit-page .btn-stage-load:hover { background: var(--pb-gold-soft); }
.batch-edit-page .btn-stage-load:disabled { opacity: .55; cursor: not-allowed; }
.batch-edit-page .stage-overview { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .9rem 1rem; margin-bottom: 1rem; border: 1px solid #e9e1ca; background: linear-gradient(100deg,#fffdf8,#faf8f1); border-radius: 11px; }
.batch-edit-page .stage-overview strong { color: var(--pb-ink); font-size: .87rem; }
.batch-edit-page .stage-overview p { color: var(--pb-muted); font-size: .77rem; margin: .25rem 0 0; line-height: 1.5; }
.batch-edit-page .stage-progress-wrap { display: flex; align-items: center; gap: .65rem; flex: 0 0 min(260px,35%); }
.batch-edit-page .stage-progress-wrap b { color: #71591c; font-size: .78rem; min-width: 36px; }
.batch-edit-page .stage-progress-track { height: 8px; flex: 1; border-radius: 99px; background: #e9e7e0; overflow: hidden; }
.batch-edit-page .stage-progress-track span { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg,#d8bd72,#a9842c); transition: width .3s ease; }
.batch-edit-page .stage-table-wrap { width: 100%; overflow-x: auto; border: 1px solid #e1e3e7; border-radius: 11px; background: #fff; -webkit-overflow-scrolling: touch; }
.batch-edit-page .stage-table { width: 100%; min-width: 1120px; border-collapse: separate; border-spacing: 0; color: var(--pb-ink-2); font-size: .77rem; }
.batch-edit-page .stage-table th, .batch-edit-page .stage-table td { padding: .72rem .65rem; border-bottom: 1px solid #eceef1; vertical-align: middle; }
.batch-edit-page .stage-table th { position: sticky; top: 0; z-index: 1; background: #f7f7f4; color: #586273; font-size: .72rem; font-weight: 900; white-space: nowrap; }
.batch-edit-page .stage-table .tc { text-align: center; }
.batch-edit-page .stage-main-row > td { background: #fff; }
.batch-edit-page .stage-main-row:hover > td { background: #fdfcf8; }
