@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "tab")]
    private string? QueryTab { get; set; }
    [SupplyParameterFromQuery(Name = "orderId")]
    private int? QueryOrderId { get; set; }

    private ProductionBatchEditDto batch = new();
    private ProductionBatchAuditDto? auditInfo;
    private List<ProductionBatchStageDto> stages = new();
    private bool inventoryAdded = false;
    private readonly Dictionary<int, StageStartFields> stageStartFields = new();

    private sealed class StageStartFields
    {
        public string? Temperature { get; set; }
        public string? Speed { get; set; }
        public int? OperatorID { get; set; }
    }

    private ModulePermissionDto? permissions;
    private ModulePermissionDto Perms => permissions!;

    private List<ProductionLookupDto> orderLookup = new();
    private List<ProductionLookupDto> warehouseLookup = new();
    private List<ProductionLookupDto> employeeLookup = new();

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isViewMode = false;
    private bool stagesLoading = false;

    private string activeTab = "main";
    private Dictionary<string, string> errors = new();

    private string? resultMessage;
    private bool isSuccess;

    private decimal CurrentTotalCost => isViewMode
        ? batch.TotalCost
        : batch.MaterialCost + batch.LaborCost + batch.OverheadCost;
    private decimal QcClassifiedQty => batch.GoodQty + batch.RejectedQty + batch.SampleQty + batch.WasteQty;
    private decimal QcRemainingQty => batch.ProducedQty - QcClassifiedQty;
    private bool QcQuantitiesMatch => batch.ProducedQty > 0 && Math.Abs(QcRemainingQty) <= 0.0001m;
    private int CompletedStageCount => stages.Count(x => x.StageStatus == 3);
    private int StageCompletionPercent => stages.Count == 0 ? 0 : (int)Math.Round(CompletedStageCount * 100m / stages.Count);

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_BATCH");
        if (permissions is null || !Perms.CanView)
        {
            isLoading = false;
            return;
        }

        try
        {
            orderLookup = await BatchService.GetProductionOrdersLookupAsync();
            warehouseLookup = await BatchService.GetWarehousesLookupAsync();
            employeeLookup = await BatchService.GetEmployeesLookupAsync();

            if (Id > 0)
            {
                var existing = await BatchService.GetByIdAsync(Id);
                if (existing is null)
                {
                    NavigationManager.NavigateTo("/production-batches");
                    return;
                }

                batch = existing;
                isViewMode = batch.BatchStatus >= 3 || !Perms.CanEdit;
                if (!string.IsNullOrWhiteSpace(batch.BatchNumber))
                    inventoryAdded = await BatchService.HasInventoryEntryAsync(batch.BatchID);
            }
            else
            {
                if (!Perms.CanAdd)
                {
                    NavigationManager.NavigateTo("/production-batches");
                    return;
                }

                batch = new ProductionBatchEditDto { BatchDate = DateTime.Today };
                inventoryAdded = false;

                if (QueryOrderId is > 0 && orderLookup.Any(x => x.Id == QueryOrderId.Value))
                {
                    batch.ProductionOrderID = QueryOrderId.Value;
                    await OnOrderChanged();
                }
            }

            if (QueryTab == "qc")
                activeTab = "qc";
            else if (QueryTab == "audit" && Id > 0)
                activeTab = "audit";
        }
        finally
        {
            isLoading = false;
            if (QueryTab == "stages" && Id > 0)
                await LoadStagesTab();
        }
    }

    private async Task OnOrderChanged()
{
    if (batch.ProductionOrderID <= 0)
        return;

    var info = await BatchService.GetOrderInfoAsync(batch.ProductionOrderID);
    if (info is null)
        return;

    batch.ProductionOrderNumber = info.OrderNumber;
    batch.ProductItemID = info.ProductItemID;
    batch.ProductName = $"{info.ProductCode} - {info.ProductName}";
    batch.UnitID = info.PlannedUnitID;
    batch.UnitName = info.UnitName;
    batch.TargetWarehouseID = info.TargetWarehouseID;
    batch.TargetWarehouseName = info.TargetWarehouseName;

    if (Id == 0)
    {
        batch.PlannedQty = await BatchService.GetSuggestedBatchQtyAsync(batch.ProductionOrderID, Id);
    }
}

    private async Task LoadStagesTab()
    {
        activeTab = "stages";
        if (Id <= 0) return;

        stagesLoading = true;
        try
        {
            stages = await BatchService.GetStagesAsync(Id);
        }
        finally
        {
            stagesLoading = false;
        }
    }
    private async Task ReloadStagesFromBom()
{
    if (Id <= 0) return;

    isSaving = true;
    try
    {
        var result = await BatchService.LoadStagesFromBomAsync(Id, UserSession.UserID, true);
        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            stageStartFields.Clear();
            stages = await BatchService.GetStagesAsync(Id);
            activeTab = "stages";
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task StartProduction()
{
    if (Id <= 0) return;

    isSaving = true;
    try
    {
        var result = await BatchService.StartProductionAsync(Id, UserSession.UserID);
        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            var refreshed = await BatchService.GetByIdAsync(Id);
            if (refreshed is not null)
            {
                batch = refreshed;
                isViewMode = batch.BatchStatus >= 3 || !Perms.CanEdit;
            }
            await LoadStagesTab();
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task CompleteProduction()
{
    if (Id <= 0) return;

    isSaving = true;
    try
    {
        var result = await BatchService.CompleteProductionAsync(Id, UserSession.UserID);
        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            var refreshed = await BatchService.GetByIdAsync(Id);
            if (refreshed is not null)
            {
                batch = refreshed;
                isViewMode = batch.BatchStatus >= 3 || !Perms.CanEdit;
            }
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task ApplyQc()
{
    if (Id <= 0) return;

    isSaving = true;
    try
    {
        var result = await BatchService.ApplyQcAsync(
            batchId: Id,
            qcResult: batch.QCResult ?? 0,
            qcInspectedBy: batch.QCInspectedBy ?? 0,
            qcNotes: batch.QCNotes,
            goodQty: batch.GoodQty,
            rejectedQty: batch.RejectedQty,
            sampleQty: batch.SampleQty,
            wasteQty: batch.WasteQty,
            userId: UserSession.UserID);

        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            var refreshed = await BatchService.GetByIdAsync(Id);
            if (refreshed is not null)
            {
                batch = refreshed;
                isViewMode = batch.BatchStatus >= 3 || !Perms.CanEdit;
            }
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private bool CanEditQcData => Perms.CanApprove && (batch.BatchStatus == 3 || batch.BatchStatus == 4);
private bool CanSetOutputUnitCost => Id > 0 && batch.BatchStatus == 5 && batch.QCResult == 1 && !inventoryAdded && Perms.CanPost;
private bool CanEditUnitCost => CanSetOutputUnitCost;

private async Task SaveOutputUnitCost()
{
    if (!CanSetOutputUnitCost) return;
    isSaving = true;
    try
    {
        var result = await BatchService.SetOutputUnitCostAsync(Id, batch.UnitCost, UserSession.UserID);
        isSuccess = result.Success;
        resultMessage = result.Message;
        if (result.Success)
        {
            var refreshed = await BatchService.GetByIdAsync(Id);
            if (refreshed is not null) batch = refreshed;
        }
    }
    catch (Exception ex)
    {
        isSuccess = false;
        resultMessage = $"تعذر حفظ تكلفة الوحدة: {ex.Message}";
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}

private async Task AddToInventory()
{
    if (Id <= 0) return;

    isSaving = true;
    try
    {
        var result = await BatchService.AddToInventoryAsync(Id, UserSession.UserID);
        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            inventoryAdded = true;

            var refreshed = await BatchService.GetByIdAsync(Id);
            if (refreshed is not null)
            {
                batch = refreshed;
                isViewMode = batch.BatchStatus >= 3 || !Perms.CanEdit;
            }
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private StageStartFields GetStageStartFields(ProductionBatchStageDto stage)
{
    if (!stageStartFields.TryGetValue(stage.BatchStageID, out var fields))
    {
        fields = new StageStartFields
        {
            Temperature = stage.Temperature,
            Speed = stage.Speed,
            OperatorID = stage.OperatorID
        };
        stageStartFields[stage.BatchStageID] = fields;
    }

    return fields;
}

private bool CanStartStage(ProductionBatchStageDto stage) =>
    (batch.BatchStatus == 1 || batch.BatchStatus == 2) &&
    Perms.CanEdit &&
    (stage.StageStatus == 1 || stage.StageStatus == 4) &&
    !stages.Any(x => x.StageOrder < stage.StageOrder && x.StageStatus != 3) &&
    !stages.Any(x => x.BatchStageID != stage.BatchStageID && x.StageStatus == 2);

private async Task StartStage(ProductionBatchStageDto stage)
{
    var fields = GetStageStartFields(stage);
    isSaving = true;
    try
    {
        var result = await BatchService.StartStageAsync(
            stage.BatchStageID,
            fields.Temperature,
            fields.Speed,
            fields.OperatorID,
            UserSession.UserID);

        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            stages = await BatchService.GetStagesAsync(Id);
            var refreshed = await BatchService.GetByIdAsync(Id);
            if (refreshed is not null)
            {
                batch = refreshed;
                isViewMode = batch.BatchStatus >= 3 || !Perms.CanEdit;
            }
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task EndStage(int batchStageId)
{
    isSaving = true;
    try
    {
        var result = await BatchService.EndStageAsync(batchStageId, UserSession.UserID);
        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            stages = await BatchService.GetStagesAsync(Id);
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task SaveStageQualityResult(int batchStageId, string? qualityResult)
{
    if (!Perms.CanApprove) return;

    isSaving = true;
    try
    {
        var saveResult = await BatchService.SaveStageQualityResultAsync(
            batchStageId, qualityResult, UserSession.UserID);
        isSuccess = saveResult.Success;
        resultMessage = saveResult.Message;

        // Refresh on failure too, so a result saved by another user appears locked locally.
        stages = await BatchService.GetStagesAsync(Id);
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}

    private async Task LoadAuditTab()
    {
        activeTab = "audit";
        if (Id > 0 && auditInfo is null)
        {
            auditInfo = await BatchService.GetAuditAsync(Id);
        }
    }

    private async Task SaveBatch()
    {
        if (!Validate()) return;

        isSaving = true;
        try
        {
            batch.TotalCost = CurrentTotalCost;

            if (Id == 0)
            {
                var newId = await BatchService.InsertAsync(batch, UserSession.UserID);
                isSuccess = true;
                resultMessage = "تم حفظ دفعة الإنتاج بنجاح";
                NavigationManager.NavigateTo($"/production-batches/edit/{newId}");
            }
            else
            {
                await BatchService.UpdateAsync(batch, UserSession.UserID);
                isSuccess = true;
                resultMessage = "تم حفظ التعديلات بنجاح";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            resultMessage = $"خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            _ = ClearMessage();
        }
    }

    private bool Validate()
    {
        errors.Clear();

        if (batch.ProductionOrderID <= 0)
            errors["ProductionOrderID"] = "يجب اختيار أمر التصنيع";

        if (batch.PlannedQty <= 0)
            errors["PlannedQty"] = "الكمية المخططة يجب أن تكون أكبر من صفر";

        return !errors.Any();
    }

    private async Task ChangeStatus(int newStatus)
    {
        if (Id <= 0) return;

        isSaving = true;
        try
        {
            var result = await BatchService.ChangeStatusAsync(Id, newStatus, UserSession.UserID);
            isSuccess = result.Success;
            resultMessage = result.Message;

            if (result.Success)
            {
                var refreshed = await BatchService.GetByIdAsync(Id);
                if (refreshed is not null)
                {
                    batch = refreshed;
                    isViewMode = batch.BatchStatus >= 3 || !Perms.CanEdit;
                }

                if (activeTab == "stages")
                    stages = await BatchService.GetStagesAsync(Id);
            }
        }
        finally
        {
            isSaving = false;
            _ = ClearMessage();
        }
    }

