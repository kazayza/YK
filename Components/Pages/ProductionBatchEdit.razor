    private static string FormatPlannedDuration(decimal? plannedDurationHours)
    {
        if (!plannedDurationHours.HasValue)
            return "—";

        var hours = plannedDurationHours.Value;
        if (hours == 1m)
            return "ساعة واحدة";
        if (hours == 2m)
            return "ساعتان";

        var amount = hours.ToString("0.##");
        var unit = hours == decimal.Truncate(hours) && hours >= 3m && hours <= 10m
            ? "ساعات"
            : "ساعة";
        return $"{amount} {unit}";
    }

