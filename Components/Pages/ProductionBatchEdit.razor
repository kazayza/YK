@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery(Name = "tab")]
    private string? QueryTab { get; set; }

    private ProductionBatchEditDto batch = new();
    private ProductionBatchAuditDto? auditInfo;
    private List<ProductionBatchStageDto> stages = new();
    private bool inventoryAdded = false;
    private string? stageTemperature;
    private string? stageSpeed;
    private int? stageOperatorId;

    private ModulePermissionDto? permissions;
    private ModulePermissionDto Perms => permissions!;

    private List<ProductionLookupDto> orderLookup = new();
    private List<ProductionLookupDto> warehouseLookup = new();
    private List<ProductionLookupDto> employeeLookup = new();

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isViewMode = false;
    private bool stagesLoading = false;

    private string activeTab = "main";
    private Dictionary<string, string> errors = new();

    private string? resultMessage;
    private bool isSuccess;

    private decimal CurrentTotalCost => batch.MaterialCost + batch.LaborCost + batch.OverheadCost;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_BATCH");

        if (permissions is null || !Perms.CanView)
        {
            isLoading = false;
            return;
        }

        try
        {
            orderLookup = await BatchService.GetProductionOrdersLookupAsync();
            warehouseLookup = await BatchService.GetWarehousesLookupAsync();
            employeeLookup = await BatchService.GetEmployeesLookupAsync();

            if (Id > 0)
{
    var existing = await BatchService.GetByIdAsync(Id);
    if (existing is null)
    {
        NavigationManager.NavigateTo("/production-batches");
        return;
    }

    batch = existing;
    isViewMode = (batch.BatchStatus == 5 || batch.BatchStatus == 6) || !Perms.CanEdit;

    if (!string.IsNullOrWhiteSpace(batch.BatchNumber))
        inventoryAdded = await BatchService.HasInventoryEntryAsync(batch.BatchNumber);
}
else
{
    if (!Perms.CanAdd)
    {
        NavigationManager.NavigateTo("/production-batches");
        return;
    }

    batch = new ProductionBatchEditDto
    {
        BatchDate = DateTime.Today
    };

    inventoryAdded = false;
}
        }
        finally
        {
            isLoading = false;
            if (!string.IsNullOrWhiteSpace(QueryTab) && QueryTab == "stages" && Id > 0)
            {
                await LoadStagesTab();
            }
        }
    }

    private async Task OnOrderChanged()
{
    if (batch.ProductionOrderID <= 0)
        return;

    var info = await BatchService.GetOrderInfoAsync(batch.ProductionOrderID);
    if (info is null)
        return;

    batch.ProductionOrderNumber = info.OrderNumber;
    batch.ProductItemID = info.ProductItemID;
    batch.ProductName = $"{info.ProductCode} - {info.ProductName}";
    batch.UnitID = info.PlannedUnitID;
    batch.UnitName = info.UnitName;
    batch.TargetWarehouseID = info.TargetWarehouseID;
    batch.TargetWarehouseName = info.TargetWarehouseName;

    if (Id == 0)
    {
        batch.PlannedQty = await BatchService.GetSuggestedBatchQtyAsync(batch.ProductionOrderID, Id);
    }
}

    private async Task LoadStagesTab()
    {
        activeTab = "stages";
        if (Id <= 0) return;

        stagesLoading = true;
        try
        {
            stages = await BatchService.GetStagesAsync(Id);
        }
        finally
        {
            stagesLoading = false;
        }
    }
    private async Task ReloadStagesFromBom()
{
    if (Id <= 0) return;

    isSaving = true;
    try
    {
        var result = await BatchService.LoadStagesFromBomAsync(Id, UserSession.UserID, true);
        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            stages = await BatchService.GetStagesAsync(Id);
            activeTab = "stages";
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task StartProduction()
{
    if (Id <= 0) return;

    isSaving = true;
    try
    {
        var result = await BatchService.StartProductionAsync(Id, UserSession.UserID);
        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            var refreshed = await BatchService.GetByIdAsync(Id);
            if (refreshed is not null)
            {
                batch = refreshed;
                isViewMode = (batch.BatchStatus == 5 || batch.BatchStatus == 6) || !Perms.CanEdit;
            }
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task CompleteProduction()
{
    if (Id <= 0) return;

    isSaving = true;
    try
    {
        var result = await BatchService.CompleteProductionAsync(Id, UserSession.UserID);
        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            var refreshed = await BatchService.GetByIdAsync(Id);
            if (refreshed is not null)
            {
                batch = refreshed;
                isViewMode = (batch.BatchStatus == 5 || batch.BatchStatus == 6) || !Perms.CanEdit;
            }
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task ApplyQc()
{
    if (Id <= 0) return;

    isSaving = true;
    try
    {
        var result = await BatchService.ApplyQcAsync(
            batchId: Id,
            qcResult: batch.QCResult ?? 0,
            qcInspectedBy: batch.QCInspectedBy ?? 0,
            qcNotes: batch.QCNotes,
            goodQty: batch.GoodQty,
            rejectedQty: batch.RejectedQty,
            sampleQty: batch.SampleQty,
            userId: UserSession.UserID);

        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            var refreshed = await BatchService.GetByIdAsync(Id);
            if (refreshed is not null)
            {
                batch = refreshed;
                isViewMode = (batch.BatchStatus == 5 || batch.BatchStatus == 6) || !Perms.CanEdit;
            }
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task AddToInventory()
{
    if (Id <= 0) return;

    isSaving = true;
    try
    {
        var result = await BatchService.AddToInventoryAsync(Id, UserSession.UserID);
        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            inventoryAdded = true;

            var refreshed = await BatchService.GetByIdAsync(Id);
            if (refreshed is not null)
            {
                batch = refreshed;
                isViewMode = (batch.BatchStatus == 5 || batch.BatchStatus == 6) || !Perms.CanEdit;
            }
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task StartStage(int batchStageId)
{
    isSaving = true;
    try
    {
        var result = await BatchService.StartStageAsync(
            batchStageId,
            stageTemperature,
            stageSpeed,
            stageOperatorId,
            UserSession.UserID);

        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            stages = await BatchService.GetStagesAsync(Id);
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}
private async Task EndStage(int batchStageId)
{
    isSaving = true;
    try
    {
        var result = await BatchService.EndStageAsync(batchStageId, UserSession.UserID);
        isSuccess = result.Success;
        resultMessage = result.Message;

        if (result.Success)
        {
            stages = await BatchService.GetStagesAsync(Id);
        }
    }
    finally
    {
        isSaving = false;
        _ = ClearMessage();
    }
}

    private async Task LoadAuditTab()
    {
        activeTab = "audit";
        if (Id > 0 && auditInfo is null)
        {
            auditInfo = await BatchService.GetAuditAsync(Id);
        }
    }

    private async Task SaveBatch()
    {
        if (!Validate()) return;

        isSaving = true;
        try
        {
            batch.TotalCost = CurrentTotalCost;

            if (Id == 0)
            {
                var newId = await BatchService.InsertAsync(batch, UserSession.UserID);
                isSuccess = true;
                resultMessage = "تم حفظ دفعة الإنتاج بنجاح";
                NavigationManager.NavigateTo($"/production-batches/edit/{newId}");
            }
            else
            {
                await BatchService.UpdateAsync(batch, UserSession.UserID);
                isSuccess = true;
                resultMessage = "تم حفظ التعديلات بنجاح";
            }
        }
        catch (Exception ex)
        {
            isSuccess = false;
            resultMessage = $"خطأ: {ex.Message}";
        }
        finally
        {
            isSaving = false;
            _ = ClearMessage();
        }
    }

    private bool Validate()
    {
        errors.Clear();

        if (batch.ProductionOrderID <= 0)
            errors["ProductionOrderID"] = "يجب اختيار أمر التصنيع";

        if (batch.PlannedQty <= 0)
            errors["PlannedQty"] = "الكمية المخططة يجب أن تكون أكبر من صفر";

        return !errors.Any();
    }

    private async Task ChangeStatus(int newStatus)
    {
        if (Id <= 0) return;

        isSaving = true;
        try
        {
            var result = await BatchService.ChangeStatusAsync(Id, newStatus, UserSession.UserID);
            isSuccess = result.Success;
            resultMessage = result.Message;

            if (result.Success)
            {
                var refreshed = await BatchService.GetByIdAsync(Id);
                if (refreshed is not null)
                {
                    batch = refreshed;
                    isViewMode = (batch.BatchStatus == 5 || batch.BatchStatus == 6) || !Perms.CanEdit;
                }

                if (activeTab == "stages")
                    stages = await BatchService.GetStagesAsync(Id);
            }
        }
        finally
        {
            isSaving = false;
            _ = ClearMessage();
        }
    }

    private void GoBack() => NavigationManager.NavigateTo("/production-batches");

    private async Task ClearMessage()
    {
        await Task.Delay(4000);
        resultMessage = null;
        StateHasChanged();
    }

    private string GetStatusName(int status) => status switch
    {
        1 => "مسودة",
        2 => "قيد التصنيع",
        3 => "اكتمل التصنيع",
        4 => "في فحص الجودة",
        5 => "مقبول",
        6 => "مرفوض",
        _ => "—"
    };

    private string GetStatusClass(int status) => status switch
    {
        1 => "s-draft",
        2 => "s-work",
        3 => "s-done",
        4 => "s-qc",
        5 => "s-accepted",
        6 => "s-rejected",
        _ => "s-draft"
    };

    private string GetStageStatusClass(int status) => status switch
    {
        1 => "st-pending",
        2 => "st-running",
        3 => "st-done",
        4 => "st-problem",
        _ => "st-pending"
    };
}