@page "/users/new"
@page "/users/edit/{Id:int}"
@using YKCoatings.Models
@using YKCoatings.Services
@inject UserService UserService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation

<!-- ===== التحقق من الصلاحية ===== -->
@if (!_authorized)
{
    <div></div>
}
else
{
    <!-- ===== شريط العنوان ===== -->
    <div class="page-header">
        <div class="page-header-right">
            <button class="btn-back" @onclick="GoBack" title="رجوع">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5"/>
                    <path d="M12 19l7-7-7-7"/>
                </svg>
            </button>
            <h2 class="page-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="title-icon">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                @(_isNew ? "إضافة مستخدم جديد" : "تعديل المستخدم")
            </h2>
            @if (!_isNew)
            {
                <span class="edit-badge">@_dto.Username</span>
            }
        </div>
        <div class="page-header-left">
            <button class="btn-action btn-cancel-page" @onclick="GoBack">
                <span>إلغاء</span>
            </button>
            <button class="btn-action btn-save-page" @onclick="SaveUser" disabled="@_saving">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                    <polyline points="17 21 17 13 7 13 7 21"/>
                    <polyline points="7 3 7 8 15 8"/>
                </svg>
                <span>@(_saving ? "جاري الحفظ..." : "حفظ")</span>
            </button>
        </div>
    </div>

    <!-- ===== رسالة النجاح/الخطأ ===== -->
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert-msg @(_isError ? "alert-error" : "alert-success")">
            <span>@_message</span>
            <button class="alert-close" @onclick="@(() => _message = "")">✕</button>
        </div>
    }

    <!-- ===== التبويبات ===== -->
    <div class="tabs-header">
        <button class="tab-btn @(_activeTab == 1 ? "active" : "")" @onclick="@(() => _activeTab = 1)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            <span>البيانات الأساسية</span>
        </button>
        <button class="tab-btn @(_activeTab == 2 ? "active" : "")" @onclick="@(() => _activeTab = 2)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>الأمان</span>
        </button>
        <button class="tab-btn @(_activeTab == 3 ? "active" : "")" @onclick="@(() => _activeTab = 3)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
            </svg>
            <span>الإعدادات</span>
        </button>
                @if (!_isNew)
        {
            <button class="tab-btn @(_activeTab == 5 ? "active" : "")" @onclick="@(() => { _activeTab = 5; LoadPermissionsIfNeeded(); })">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <path d="M9 12l2 2 4-4"/>
                </svg>
                <span>صلاحيات خاصة</span>
                @if (_userPermissions.Any(p => p.CanView != null || p.CanAdd != null || p.CanEdit != null || p.CanDelete != null))
                {
                    <span class="tab-override-count">●</span>
                }
            </button>
        }
        @if (_isNew)
        {
            <button class="tab-btn @(_activeTab == 4 ? "active" : "")" @onclick="@(() => _activeTab = 4)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                </svg>
                <span>كلمة المرور</span>
            </button>
        }
        
    </div>

    <!-- ===== محتوى التبويبات ===== -->
    <div class="tab-content">

        <!-- ────────── تبويب 1: البيانات الأساسية ────────── -->
        @if (_activeTab == 1)
        {
            <div class="form-card">
                <div class="form-card-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                    البيانات الأساسية
                </div>

                <div class="form-grid">

                    <!-- اسم المستخدم -->
                    <div class="form-group">
                        <label class="form-label">اسم المستخدم <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_dto.Username"
                               placeholder="اسم المستخدم (بالإنجليزية)" />
                    </div>

                    <!-- الاسم الكامل -->
                    <div class="form-group">
                        <label class="form-label">الاسم الكامل <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_dto.FullName"
                               placeholder="الاسم الكامل بالعربية" />
                    </div>

                    <!-- البريد الإلكتروني -->
                    <div class="form-group">
                        <label class="form-label">البريد الإلكتروني</label>
                        <input type="email" class="form-input" @bind="_dto.Email"
                               placeholder="example@email.com" />
                    </div>

                    <!-- الهاتف -->
                    <div class="form-group">
                        <label class="form-label">الهاتف</label>
                        <input type="text" class="form-input" @bind="_dto.Phone"
                               placeholder="رقم الهاتف" />
                    </div>

                    <!-- الدور -->
                    <div class="form-group">
                        <label class="form-label">الدور <span class="required">*</span></label>
                        <select class="form-input" @bind="_dto.RoleID">
                            <option value="0">— اختر الدور —</option>
                            @foreach (var role in _rolesLookup)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        </select>
                    </div>

                    <!-- الموظف المرتبط -->
                    <div class="form-group">
                        <label class="form-label">الموظف المرتبط</label>
                        <select class="form-input" @bind="_dto.EmployeeID">
                            <option value="">— بدون ربط بموظف —</option>
                            @foreach (var emp in _employeesLookup)
                            {
                                <option value="@emp.Id">@emp.Name</option>
                            }
                        </select>
                    </div>

                    <!-- نشط -->
                    <div class="form-group">
                        <label class="form-label">الحالة</label>
                        <div class="toggle-wrap">
                            <label class="toggle-label">
                                <input type="checkbox" @bind="_dto.IsActive" />
                                <span class="toggle-switch"></span>
                                <span class="toggle-text">@(_dto.IsActive ? "نشط" : "غير نشط")</span>
                            </label>
                        </div>
                    </div>

                </div>
            </div>
        }
                <!-- ────────── تبويب 2: الأمان ────────── -->
        @if (_activeTab == 2)
        {
            <div class="form-card">
                <div class="form-card-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                    إعدادات الأمان
                </div>

                <div class="form-grid">

                    <!-- يجب تغيير كلمة المرور -->
                    <div class="form-group">
                        <label class="form-label">تغيير كلمة المرور</label>
                        <div class="toggle-wrap">
                            <label class="toggle-label">
                                <input type="checkbox" @bind="_dto.MustChangePassword" />
                                <span class="toggle-switch"></span>
                                <span class="toggle-text">@(_dto.MustChangePassword ? "يجب التغيير عند الدخول" : "لا يلزم التغيير")</span>
                            </label>
                        </div>
                    </div>

                    <!-- الحد الأقصى لمحاولات الدخول الفاشلة -->
                    <div class="form-group">
                        <label class="form-label">الحد الأقصى لمحاولات الدخول الفاشلة</label>
                        <input type="number" class="form-input" @bind="_dto.MaxFailedAttempts" min="1" max="20" />
                    </div>

                    <!-- مدة صلاحية كلمة المرور -->
                    <div class="form-group">
                        <label class="form-label">مدة صلاحية كلمة المرور (بالأيام)</label>
                        <input type="number" class="form-input" @bind="_dto.PasswordExpiryDays" min="0" max="365" />
                        <span class="form-hint">0 = بدون انتهاء</span>
                    </div>

                    @if (!_isNew)
                    {
                        <!-- حالة الحظر (عرض فقط) -->
                        <div class="form-group">
                            <label class="form-label">حالة الحظر</label>
                            <div class="info-box @(_dto.IsLocked ? "info-danger" : "info-success")">
                                @if (_dto.IsLocked)
                                {
                                    <span>🔒 محظور</span>
                                    @if (_dto.LockoutEnd.HasValue)
                                    {
                                        <span class="info-sub">ينتهي الحظر: @_dto.LockoutEnd.Value.ToString("dd/MM/yyyy hh:mm tt")</span>
                                    }
                                }
                                else
                                {
                                    <span>🔓 غير محظور</span>
                                }
                            </div>
                        </div>

                        <!-- محاولات الدخول الفاشلة (عرض فقط) -->
                        <div class="form-group">
                            <label class="form-label">محاولات الدخول الفاشلة</label>
                            <div class="info-box">
                                <span>@_dto.FailedLoginAttempts من @_dto.MaxFailedAttempts</span>
                            </div>
                        </div>

                        <!-- آخر تغيير لكلمة المرور (عرض فقط) -->
                        <div class="form-group">
                            <label class="form-label">آخر تغيير لكلمة المرور</label>
                            <div class="info-box">
                                @if (_dto.PasswordChangedDate.HasValue)
                                {
                                    <span>@_dto.PasswordChangedDate.Value.ToString("dd/MM/yyyy hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="cell-empty">لم يتم التغيير</span>
                                }
                            </div>
                        </div>
                    }

                </div>
            </div>

            <!-- معلومات آخر دخول -->
            @if (!_isNew)
            {
                <div class="form-card" style="margin-top:16px">
                    <div class="form-card-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        آخر دخول
                    </div>
                    <div class="form-grid form-grid-3">
                        <div class="form-group">
                            <label class="form-label">تاريخ آخر دخول</label>
                            <div class="info-box">
                                @if (_dto.LastLoginDate.HasValue)
                                {
                                    <span>@_dto.LastLoginDate.Value.ToString("dd/MM/yyyy hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="cell-empty">لم يسجل دخول</span>
                                }
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">عنوان IP</label>
                            <div class="info-box">
                                <span>@(string.IsNullOrEmpty(_dto.LastLoginIP) ? "—" : _dto.LastLoginIP)</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">اسم الجهاز</label>
                            <div class="info-box">
                                <span>@(string.IsNullOrEmpty(_dto.LastLoginMachine) ? "—" : _dto.LastLoginMachine)</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- ────────── تبويب 3: الإعدادات الافتراضية ────────── -->
        @if (_activeTab == 3)
        {
            <div class="form-card">
                <div class="form-card-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                    الإعدادات الافتراضية
                </div>

                <div class="form-grid">

                    <!-- اللغة الافتراضية -->
                    <div class="form-group">
                        <label class="form-label">اللغة الافتراضية</label>
                        <select class="form-input" @bind="_dto.DefaultLanguage">
                            <option value="ar">العربية</option>
                            <option value="en">English</option>
                        </select>
                    </div>

                    <!-- المخزن الافتراضي -->
                    <div class="form-group">
                        <label class="form-label">المخزن الافتراضي</label>
                        <select class="form-input" @bind="_dto.DefaultWarehouseID">
                            <option value="">— بدون —</option>
                            @foreach (var wh in _warehousesLookup)
                            {
                                <option value="@wh.Id">@wh.Name</option>
                            }
                        </select>
                    </div>

                    <!-- الصندوق الافتراضي -->
                    <div class="form-group">
                        <label class="form-label">الصندوق الافتراضي</label>
                        <select class="form-input" @bind="_dto.DefaultCashBoxID">
                            <option value="">— بدون —</option>
                            @foreach (var cb in _cashBoxesLookup)
                            {
                                <option value="@cb.Id">@cb.Name</option>
                            }
                        </select>
                    </div>

                    <!-- ملاحظات -->
                    <div class="form-group form-full">
                        <label class="form-label">ملاحظات</label>
                        <textarea class="form-input form-textarea" @bind="_dto.Notes"
                                  placeholder="ملاحظات إضافية..." rows="3"></textarea>
                    </div>

                </div>
            </div>

            <!-- معلومات التسجيل -->
            @if (!_isNew && _dto.CreatedDate.HasValue)
            {
                <div class="form-card" style="margin-top:16px">
                    <div class="form-card-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                        </svg>
                        معلومات التسجيل
                    </div>
                    <div class="form-grid form-grid-2">
                        <div class="form-group">
                            <label class="form-label">تاريخ الإنشاء</label>
                            <div class="info-box">
                                <span>@_dto.CreatedDate?.ToString("dd/MM/yyyy hh:mm tt")</span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">آخر تعديل</label>
                            <div class="info-box">
                                @if (_dto.ModifiedDate.HasValue)
                                {
                                    <span>@_dto.ModifiedDate.Value.ToString("dd/MM/yyyy hh:mm tt")</span>
                                }
                                else
                                {
                                    <span class="cell-empty">لم يتم التعديل</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- ────────── تبويب 4: كلمة المرور (إنشاء فقط) ────────── -->
        @if (_activeTab == 4 && _isNew)
        {
            <div class="form-card">
                <div class="form-card-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                    </svg>
                    كلمة المرور
                </div>

                <div class="form-grid">

                    <!-- كلمة المرور -->
                    <div class="form-group">
                        <label class="form-label">كلمة المرور <span class="required">*</span></label>
                        <input type="password" class="form-input" @bind="_newPassword"
                               placeholder="أدخل كلمة المرور (6 أحرف على الأقل)" />
                    </div>

                    <!-- تأكيد كلمة المرور -->
                    <div class="form-group">
                        <label class="form-label">تأكيد كلمة المرور <span class="required">*</span></label>
                        <input type="password" class="form-input" @bind="_confirmPassword"
                               placeholder="أعد إدخال كلمة المرور" />
                    </div>

                    <!-- يجب التغيير -->
                    <div class="form-group">
                        <label class="form-label">عند أول دخول</label>
                        <div class="toggle-wrap">
                            <label class="toggle-label">
                                <input type="checkbox" @bind="_dto.MustChangePassword" />
                                <span class="toggle-switch"></span>
                                <span class="toggle-text">@(_dto.MustChangePassword ? "يجب تغيير كلمة المرور" : "لا يلزم التغيير")</span>
                            </label>
                        </div>
                    </div>

                </div>

                <div class="pwd-hints">
                    <p class="pwd-hint-title">متطلبات كلمة المرور:</p>
                    <ul class="pwd-hint-list">
                        <li class="@(_newPassword.Length >= 6 ? "hint-ok" : "")">6 أحرف على الأقل</li>
                        <li class="@(_newPassword == _confirmPassword && !string.IsNullOrEmpty(_newPassword) ? "hint-ok" : "")">كلمة المرور وتأكيدها متطابقتين</li>
                    </ul>
                </div>
            </div>
        }
                <!-- ────────── تبويب 5: صلاحيات خاصة ────────── -->
        @if (_activeTab == 5 && !_isNew)
        {
            <div class="form-card perm-card-user">

                <!-- شريط أدوات -->
                <div class="perm-toolbar">
                    <div class="perm-toolbar-right">
                        <div class="form-card-title" style="margin:0;padding:0;border:none">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2"/>
                                <path d="M9 12l2 2 4-4"/>
                            </svg>
                            صلاحيات خاصة بالمستخدم
                        </div>
                    </div>
                    <div class="perm-toolbar-left">
                        <button class="btn-toolbar btn-toolbar-danger" @onclick="ClearAllOverrides" title="مسح كل الـ Override">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                                <path d="M3 3v5h5"/>
                            </svg>
                            <span>إعادة تعيين للدور</span>
                        </button>
                        <button class="btn-toolbar" @onclick="SavePermissions" disabled="@_savingPerms">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                                <polyline points="17 21 17 13 7 13 7 21"/>
                            </svg>
                            <span>@(_savingPerms ? "جاري الحفظ..." : "حفظ الصلاحيات")</span>
                        </button>
                    </div>
                </div>

                <!-- الدليل -->
                <div class="perm-legend">
                    <div class="legend-item">
                        <span class="legend-dot legend-null"></span>
                        <span>يتبع الدور</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-dot legend-allow"></span>
                        <span>سماح إضافي</span>
                    </div>
                    <div class="legend-item">
                        <span class="legend-dot legend-deny"></span>
                        <span>منع خاص</span>
                    </div>
                </div>

                <!-- الجدول -->
                <div class="perm-table-wrap-user">
                    @if (_loadingPerms)
                    {
                        <div class="loading-container" style="padding:40px">
                            <div class="loading-spinner"></div>
                            <span>جاري تحميل الصلاحيات...</span>
                        </div>
                    }
                    else
                    {
                        <table class="perm-table-user">
                            <thead>
                                <tr>
                                    <th class="perm-th-module-u">الشاشة</th>
                                    <th class="perm-th-role">الدور</th>
                                    <th class="perm-th-check-u">عرض</th>
                                    <th class="perm-th-check-u">إضافة</th>
                                    <th class="perm-th-check-u">تعديل</th>
                                    <th class="perm-th-check-u">حذف</th>
                                    <th class="perm-th-check-u">طباعة</th>
                                    <th class="perm-th-check-u">تصدير</th>
                                    <th class="perm-th-check-u">اعتماد</th>
                                    <th class="perm-th-check-u">ترحيل</th>
                                    <th class="perm-th-check-u">إلغاء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var perm in _userPermissions)
                                {
                                    <tr class="perm-row-user">
                                        <td class="perm-td-module-u">
                                            <span class="perm-module-name-u">@perm.ModuleNameAr</span>
                                        </td>
                                        <td class="perm-td-role-summary">
                                            <span class="role-perm-dots">
                                                @if (perm.RoleCanView == true) { <span class="rpd on">ع</span> }
                                                @if (perm.RoleCanAdd == true) { <span class="rpd on">ض</span> }
                                                @if (perm.RoleCanEdit == true) { <span class="rpd on">ت</span> }
                                                @if (perm.RoleCanDelete == true) { <span class="rpd on">ح</span> }
                                            </span>
                                        </td>
                                        <td class="perm-td-check-u">@TriStateBtn(perm, "View")</td>
                                        <td class="perm-td-check-u">@TriStateBtn(perm, "Add")</td>
