@code {
    // ===== المعاملات =====
    [Parameter] public int Id { get; set; }

    // ===== الحالة =====
    private bool _authorized = false;
    private bool _isNew => Id == 0;
    private bool _saving = false;
    private string _message = "";
    private bool _isError = false;
    private int _activeTab = 1;

    // ===== البيانات =====
    private UserEditDto _dto = new();
    private string _newPassword = "";
    private string _confirmPassword = "";

    // ===== Lookups =====
    private List<LookupDto> _rolesLookup = new();
    private List<LookupDto> _employeesLookup = new();
    private List<LookupDto> _warehousesLookup = new();
    private List<LookupDto> _cashBoxesLookup = new();
        // ===== صلاحيات خاصة =====
    private List<UserPermissionEditDto> _userPermissions = new();
    private bool _loadingPerms = false;
    private bool _savingPerms = false;
    private bool _permsLoaded = false;

    // ══════════════════════════════════════
    // التهيئة
    // ══════════════════════════════════════
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // التحقق من تسجيل الدخول
            if (!UserSession.IsLoggedIn)
            {
                var restored = await UserSession.TryRestoreSessionAsync();
                if (!restored)
                {
                    Navigation.NavigateTo("/login");
                    return;
                }
                if (!PermissionService.IsLoaded)
                    await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            }

            // التحقق من الصلاحية
            if (_isNew && !PermissionService.CanAdd("SCR_USERS"))
            {
                Navigation.NavigateTo("/access-denied");
                return;
            }
            if (!_isNew && !PermissionService.CanEdit("SCR_USERS"))
            {
                Navigation.NavigateTo("/access-denied");
                return;
            }

            _authorized = true;

            // تحميل الـ Lookups
            await LoadLookups();

            // تحميل بيانات المستخدم (في حالة التعديل)
            if (!_isNew)
                await LoadUser();

            StateHasChanged();
        }
    }

    // ══════════════════════════════════════
    // تحميل البيانات
    // ══════════════════════════════════════
    private async Task LoadLookups()
    {
        try
        {
            _rolesLookup = await UserService.GetRolesLookupAsync();
            _employeesLookup = await UserService.GetAvailableEmployeesLookupAsync(
                _isNew ? null : _dto.EmployeeID);
            _warehousesLookup = await UserService.GetWarehousesLookupAsync();
            _cashBoxesLookup = await UserService.GetCashBoxesLookupAsync();
        }
        catch (Exception ex)
        {
            ShowError("خطأ في تحميل البيانات المساعدة: " + ex.Message);
        }
    }

    private async Task LoadUser()
    {
        try
        {
            var user = await UserService.GetByIdAsync(Id);
            if (user == null)
            {
                ShowError("المستخدم غير موجود");
                return;
            }
            _dto = user;

            // تحديث قائمة الموظفين لتشمل الموظف الحالي
            _employeesLookup = await UserService.GetAvailableEmployeesLookupAsync(_dto.EmployeeID);
        }
        catch (Exception ex)
        {
            ShowError("خطأ في تحميل بيانات المستخدم: " + ex.Message);
        }
    }

    // ══════════════════════════════════════
    // الحفظ
    // ══════════════════════════════════════
    private async Task SaveUser()
    {
        try
        {
            _saving = true;
            _message = "";
            StateHasChanged();

            // التحقق من البيانات الإلزامية
            if (string.IsNullOrWhiteSpace(_dto.Username))
            {
                ShowError("اسم المستخدم مطلوب");
                _activeTab = 1;
                return;
            }

            if (string.IsNullOrWhiteSpace(_dto.FullName))
            {
                ShowError("الاسم الكامل مطلوب");
                _activeTab = 1;
                return;
            }

            if (_dto.RoleID == 0)
            {
                ShowError("يجب اختيار الدور");
                _activeTab = 1;
                return;
            }

            // التحقق من كلمة المرور عند الإنشاء
            if (_isNew)
            {
                if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 6)
                {
                    ShowError("كلمة المرور يجب أن تكون 6 أحرف على الأقل");
                    _activeTab = 4;
                    return;
                }

                if (_newPassword != _confirmPassword)
                {
                    ShowError("كلمة المرور وتأكيدها غير متطابقتين");
                    _activeTab = 4;
                    return;
                }
            }

            if (_isNew)
            {
                // إنشاء
                var newId = await UserService.CreateAsync(_dto, _newPassword, UserSession.CurrentUserID);
                ShowSuccess("تم إنشاء المستخدم بنجاح");

                // الانتقال لصفحة التعديل
                await Task.Delay(500);
                Navigation.NavigateTo($"/users/edit/{newId}");
            }
            else
            {
                // تعديل
                var result = await UserService.UpdateAsync(_dto, UserSession.CurrentUserID);
                if (result)
                    ShowSuccess("تم حفظ التعديلات بنجاح");
                else
                    ShowError("فشل في حفظ التعديلات");
            }
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    // ══════════════════════════════════════
    // التنقل
    // ══════════════════════════════════════
    private void GoBack()
    {
        Navigation.NavigateTo("/users");
    }
        // ══════════════════════════════════════
    // صلاحيات المستخدم الخاصة
    // ══════════════════════════════════════
    private async void LoadPermissionsIfNeeded()
    {
        if (_permsLoaded) return;

        try
        {
            _loadingPerms = true;
            StateHasChanged();

            _userPermissions = await UserService.GetUserPermissionsAsync(Id);
            _permsLoaded = true;
        }
        catch (Exception ex)
        {
            ShowError("خطأ في تحميل الصلاحيات: " + ex.Message);
        }
        finally
        {
            _loadingPerms = false;
            StateHasChanged();
        }
    }

    private async Task SavePermissions()
    {
        try
        {
            _savingPerms = true;
            StateHasChanged();

            await UserService.SaveUserPermissionsAsync(Id, _userPermissions);
            ShowSuccess("تم حفظ الصلاحيات الخاصة بنجاح");
        }
        catch (Exception ex)
        {
            ShowError("خطأ: " + ex.Message);
        }
        finally
        {
            _savingPerms = false;
        }
    }

    private async Task ClearAllOverrides()
    {
        foreach (var perm in _userPermissions)
        {
            perm.CanView = null;
            perm.CanAdd = null;
            perm.CanEdit = null;
            perm.CanDelete = null;
            perm.CanPrint = null;
            perm.CanExport = null;
            perm.CanApprove = null;
            perm.CanPost = null;
            perm.CanCancel = null;
        }

        await SavePermissions();
        ShowSuccess("تم إعادة تعيين الصلاحيات للدور الأصلي");
    }

    private void ToggleTriState(UserPermissionEditDto perm, string field)
    {
        // Cycle: null → true → false → null
        bool? current = field switch
        {
            "View"    => perm.CanView,
            "Add"     => perm.CanAdd,
            "Edit"    => perm.CanEdit,
            "Delete"  => perm.CanDelete,
            "Print"   => perm.CanPrint,
            "Export"  => perm.CanExport,
            "Approve" => perm.CanApprove,
            "Post"    => perm.CanPost,
            "Cancel"  => perm.CanCancel,
            _ => null
        };

        bool? next = current switch
        {
            null  => true,
            true  => false,
            false => null,
            
        };

        switch (field)
        {
            case "View":    perm.CanView    = next; break;
            case "Add":     perm.CanAdd     = next; break;
            case "Edit":    perm.CanEdit    = next; break;
            case "Delete":  perm.CanDelete  = next; break;
            case "Print":   perm.CanPrint   = next; break;
            case "Export":  perm.CanExport  = next; break;
            case "Approve": perm.CanApprove = next; break;
            case "Post":    perm.CanPost    = next; break;
            case "Cancel":  perm.CanCancel  = next; break;
        }
    }

    private RenderFragment TriStateBtn(UserPermissionEditDto perm, string field) => builder =>
    {
        bool? val = field switch
        {
            "View"    => perm.CanView,
            "Add"     => perm.CanAdd,
            "Edit"    => perm.CanEdit,
            "Delete"  => perm.CanDelete,
            "Print"   => perm.CanPrint,
            "Export"  => perm.CanExport,
            "Approve" => perm.CanApprove,
            "Post"    => perm.CanPost,
            "Cancel"  => perm.CanCancel,
            _ => null
        };

        string cssClass = val switch
        {
            null  => "tri-btn tri-null",
            true  => "tri-btn tri-allow",
            false => "tri-btn tri-deny",
            
        };

        string label = val switch
        {
            null  => "—",
            true  => "✓",
            false => "✕",
            
        };

        string title = val switch
        {
            null  => "يتبع الدور (اضغط للسماح)",
            true  => "سماح إضافي (اضغط للمنع)",
            false => "منع خاص (اضغط للإعادة للدور)",
            
        };

        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", cssClass);
        builder.AddAttribute(2, "title", title);
        builder.AddAttribute(3, "onclick",
            Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this,
                () => ToggleTriState(perm, field)));
        builder.AddContent(4, label);
        builder.CloseElement();
    };

    // ══════════════════════════════════════
    // الرسائل
    // ══════════════════════════════════════
    private void ShowSuccess(string msg) { _message = msg; _isError = false; }
    private void ShowError(string msg) { _message = msg; _isError = true; }
}