@page "/users/new"
@page "/users/edit/{Id:int}"
@using YKCoatings.Models
@using YKCoatings.Services
@inject UserService UserService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>@(_isNew ? "إضافة مستخدم" : "تعديل مستخدم")</PageTitle>

@if (!_authorized)
{<div class="no-access-luxury" dir="rtl"><h4>جاري التحقق...</h4></div>}
else
{
<div class="luxury-page full-width" dir="rtl">
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
        <div class="lh-content">
            <div class="lh-right">
                <button class="btn-back-luxury" @onclick="GoBack" title="رجوع"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="M12 19l7-7-7-7"/></svg></button>
                <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                <div class="lh-text">
                    <h2 class="lh-title">@(_isNew ? "إضافة مستخدم جديد" : $"تعديل المستخدم — {_dto.Username}")</h2>
                </div>
            </div>
            <div class="lh-actions">
                <button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">إلغاء</button>
                <button class="btn-luxury btn-primary-luxury" @onclick="SaveUser" disabled="@_saving">
                    @if(_saving){<div class="btn-spinner-sm"></div><span>جاري الحفظ...</span>}
                    else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg><span>حفظ</span>}
                </button>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {<div class="msg-luxury @(_isError ? "msg-error" : "msg-success")">@_message <button @onclick='()=>_message=""' style="margin-right:auto;background:none;border:none;cursor:pointer">✕</button></div>}

    <div class="mudtabs-luxury">
        <div class="mudtabs-header-luxury">
            <button class="mudtab-btn-luxury @(_activeTab==1?"active":"")" @onclick="()=>_activeTab=1">
                <span class="mt-icon" style="background:#eff6ff;color:#2563eb;border:1px solid #dbeafe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></span>
                البيانات الأساسية
            </button>
            <button class="mudtab-btn-luxury @(_activeTab==2?"active":"")" @onclick="()=>_activeTab=2">
                <span class="mt-icon" style="background:#fef2f2;color:#ef4444;border:1px solid #fecaca"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                الأمان
            </button>
            <button class="mudtab-btn-luxury @(_activeTab==3?"active":"")" @onclick="()=>_activeTab=3">
                <span class="mt-icon" style="background:#f5f3ff;color:#7c3aed;border:1px solid #ddd6fe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></span>
                الإعدادات
            </button>
            @if (!_isNew)
            {
                <button class="mudtab-btn-luxury @(_activeTab==5?"active":"")" @onclick="()=>{ _activeTab=5; LoadPermissionsIfNeeded(); }">
                    <span class="mt-icon" style="background:rgba(212,175,55,.1);color:#9C7C2E;border:1px solid rgba(212,175,55,.2)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 12l2 2 4-4"/></svg></span>
                    صلاحيات خاصة
                    @if (_userPermissions.Any(p => p.CanView != null || p.CanAdd != null || p.CanEdit != null || p.CanDelete != null))
                    {<span class="mt-count changed">مخصص</span>}
                </button>
            }
            @if (_isNew)
            {
                <button class="mudtab-btn-luxury @(_activeTab==4?"active":"")" @onclick="()=>_activeTab=4">
                    <span class="mt-icon" style="background:#ecfdf5;color:#059669;border:1px solid #a7f3d0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg></span>
                    كلمة المرور
                </button>
            }
        </div>

        <div class="mudtabs-body-luxury">
            @if (_activeTab == 1)
            {
                <div class="form-grid-luxury cols-2">
                    <div class="field-luxury"><label class="fl-label required">اسم المستخدم</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" @bind="_dto.Username" placeholder="بالإنجليزية" /></div></div>
                    <div class="field-luxury"><label class="fl-label required">الاسم الكامل</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" @bind="_dto.FullName" placeholder="الاسم الكامل" /></div></div>
                    <div class="field-luxury"><label class="fl-label">البريد الإلكتروني</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg><input type="email" @bind="_dto.Email" placeholder="example@email.com" /></div></div>
                    <div class="field-luxury"><label class="fl-label">الهاتف</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><input type="text" @bind="_dto.Phone" placeholder="رقم الهاتف" /></div></div>
                    <div class="field-luxury"><label class="fl-label required">الدور</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><select @bind="_dto.RoleID"><option value="0">— اختر الدور —</option>@foreach(var role in _rolesLookup){<option value="@role.Id">@role.Name</option>}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                    <div class="field-luxury"><label class="fl-label">الموظف المرتبط</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><select @bind="_dto.EmployeeID"><option value="">— بدون —</option>@foreach(var emp in _employeesLookup){<option value="@emp.Id">@emp.Name</option>}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                    <div class="field-luxury"><label class="fl-label">الحالة</label><div style="height:42px;display:flex;align-items:center"><label class="switch-luxury"><input type="checkbox" @bind="_dto.IsActive" /><span></span></label><span style="margin-right:10px;font-weight:700;color:@(_dto.IsActive?"#059669":"#6b7280")">@(_dto.IsActive?"نشط":"غير نشط")</span></div></div>
                </div>
            }
            @if (_activeTab == 2)
            {
                <div class="form-grid-luxury cols-2">
                    <div class="field-luxury"><label class="fl-label">يجب تغيير كلمة المرور</label><div style="height:42px;display:flex;align-items:center"><label class="switch-luxury"><input type="checkbox" @bind="_dto.MustChangePassword" /><span></span></label><span style="margin-right:10px;font-weight:700">@(_dto.MustChangePassword?"يجب التغيير عند الدخول":"لا يلزم")</span></div></div>
                    <div class="field-luxury"><label class="fl-label">الحد الأقصى لمحاولات فاشلة</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg><input type="number" @bind="_dto.MaxFailedAttempts" min="1" max="20" /></div></div>
                    <div class="field-luxury"><label class="fl-label">مدة صلاحية كلمة المرور (أيام)</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><input type="number" @bind="_dto.PasswordExpiryDays" min="0" max="365" /></div><span class="form-hint">0 = بدون انتهاء</span></div>
                    @if (!_isNew)
                    {
                        <div class="field-luxury"><label class="fl-label">حالة الحظر</label><div class="info-box @( _dto.IsLocked ? "info-danger" : "info-success")"><span>@(_dto.IsLocked?"محظور":"غير محظور")</span>@if(_dto.IsLocked && _dto.LockoutEnd.HasValue){<small>ينتهي: @_dto.LockoutEnd.Value.ToString("dd/MM/yyyy hh:mm tt")</small>}</div></div>
                        <div class="field-luxury"><label class="fl-label">محاولات فاشلة</label><div class="info-box"><span>@_dto.FailedLoginAttempts من @_dto.MaxFailedAttempts</span></div></div>
                    }
                </div>
            }
            @if (_activeTab == 3)
            {
                <div class="form-grid-luxury cols-2">
                    <div class="field-luxury"><label class="fl-label">اللغة الافتراضية</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg><select @bind="_dto.DefaultLanguage"><option value="ar">العربية</option><option value="en">English</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                    <div class="field-luxury"><label class="fl-label">المخزن الافتراضي</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><select @bind="_dto.DefaultWarehouseID"><option value="">— بدون —</option>@foreach(var wh in _warehousesLookup){<option value="@wh.Id">@wh.Name</option>}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                    <div class="field-luxury"><label class="fl-label">الصندوق الافتراضي</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg><select @bind="_dto.DefaultCashBoxID"><option value="">— بدون —</option>@foreach(var cb in _cashBoxesLookup){<option value="@cb.Id">@cb.Name</option>}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                    <div class="field-luxury full"><label class="fl-label">ملاحظات</label><textarea class="form-textarea-luxury" @bind="_dto.Notes" placeholder="ملاحظات..." rows="3"></textarea></div>
                </div>
            }
            @if (_activeTab == 4 && _isNew)
            {
                <div class="form-grid-luxury cols-2">
                    <div class="field-luxury"><label class="fl-label required">كلمة المرور</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><input type="password" @bind="_newPassword" placeholder="6 أحرف على الأقل" /></div></div>
                    <div class="field-luxury"><label class="fl-label required">تأكيد كلمة المرور</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><input type="password" @bind="_confirmPassword" placeholder="أعد الإدخال" /></div></div>
                    <div class="field-luxury"><label class="fl-label">عند أول دخول</label><div style="height:42px;display:flex;align-items:center"><label class="switch-luxury"><input type="checkbox" @bind="_dto.MustChangePassword" /><span></span></label><span style="margin-right:10px;font-weight:700">@(_dto.MustChangePassword?"يجب تغيير":"لا يلزم")</span></div></div>
                </div>
                <div class="pwd-hints-luxury">
                    <p class="pwd-hint-title">متطلبات:</p>
                    <ul class="pwd-hint-list">
                        <li class="@(_newPassword.Length >= 6 ? "hint-ok" : "")">6 أحرف على الأقل</li>
                        <li class="@(_newPassword == _confirmPassword && !string.IsNullOrEmpty(_newPassword) ? "hint-ok" : "")">متطابقتين</li>
                    </ul>
                </div>
            }
            @if (_activeTab == 5 && !_isNew)
            {
                <div class="perm-section-luxury">
                    <div class="perm-toolbar"><div class="perm-toolbar-right"><strong>صلاحيات خاصة بالمستخدم</strong></div><div class="perm-toolbar-left"><button class="btn-luxury btn-ghost-luxury" style="border-color:#fecaca;color:#dc2626" @onclick="ClearAllOverrides">إعادة تعيين للدور</button><button class="btn-luxury btn-primary-luxury" @onclick="SavePermissions" disabled="@_savingPerms">@(_savingPerms?"جاري الحفظ...":"حفظ الصلاحيات")</button></div></div>
                    <div class="perm-legend"><div class="legend-item"><span class="legend-dot legend-null"></span><span>يتبع الدور</span></div><div class="legend-item"><span class="legend-dot legend-allow"></span><span>سماح</span></div><div class="legend-item"><span class="legend-dot legend-deny"></span><span>منع</span></div></div>
                    <div class="perm-table-wrap-user">
                        @if (_loadingPerms){<div class="loading-luxury"><div class="loader-luxury"></div></div>}
                        else
                        {
                            <table class="perm-table-user">
                                <thead><tr><th class="perm-th-module-u">الشاشة</th><th>الدور</th><th>عرض</th><th>إضافة</th><th>تعديل</th><th>حذف</th><th>طباعة</th><th>تصدير</th><th>اعتماد</th><th>ترحيل</th><th>إلغاء</th></tr></thead>
                                <tbody>
                                    @foreach(var perm in _userPermissions){
                                        <tr>
                                            <td><span class="perm-module-name-u">@perm.ModuleNameAr</span></td>
                                            <td class="perm-td-role-summary"><span class="role-perm-dots">@if (perm.RoleCanView == true){<span class="rpd on">ع</span>} @if (perm.RoleCanAdd == true){<span class="rpd on">ض</span>} @if (perm.RoleCanEdit == true){<span class="rpd on">ت</span>} @if (perm.RoleCanDelete == true){<span class="rpd on">ح</span>}</span></td>
                                            <td>@TriStateBtn(perm, "View")</td><td>@TriStateBtn(perm, "Add")</td><td>@TriStateBtn(perm, "Edit")</td><td>@TriStateBtn(perm, "Delete")</td><td>@TriStateBtn(perm, "Print")</td><td>@TriStateBtn(perm, "Export")</td><td>@TriStateBtn(perm, "Approve")</td><td>@TriStateBtn(perm, "Post")</td><td>@TriStateBtn(perm, "Cancel")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;margin:0 auto}.luxury-page.full-width{max-width:100%;width:100%}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.2rem;font-weight:900;color:#F5E6C8;margin:0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-luxury svg{width:14px;height:14px}.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.btn-back-luxury{width:40px;height:40px;border:1px solid rgba(212,175,55,.2);background:rgba(212,175,55,.08);border-radius:10px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:var(--gold);transition:.2s}.btn-back-luxury:hover{background:rgba(212,175,55,.15)}.btn-back-luxury svg{width:18px;height:18px}
.msg-luxury{padding:12px 16px;border-radius:12px;font-size:.84rem;font-weight:600;display:flex;align-items:center;gap:8px}.msg-success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.msg-error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
.mudtabs-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}
.mudtabs-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5;z-index:2}
.mudtabs-header-luxury{position:relative;display:flex;gap:0;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #e8e2d0;padding:0 8px;overflow-x:auto;scrollbar-width:none}.mudtabs-header-luxury::-webkit-scrollbar{display:none}
.mudtab-btn-luxury{position:relative;display:flex;align-items:center;gap:8px;padding:14px 20px;background:transparent;border:none;border-bottom:2px solid transparent;font-family:'Tajawal';font-size:.84rem;font-weight:800;color:#8B95A5;cursor:pointer;transition:all .25s;white-space:nowrap;flex-shrink:0}
.mudtab-btn-luxury:hover{background:rgba(212,175,55,.05);color:#0A0F1E}.mudtab-btn-luxury.active{color:var(--gold-dark);background:rgba(212,175,55,.08);border-bottom-color:var(--gold)}
.mudtab-btn-luxury .mt-icon{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.mt-icon svg{width:14px;height:14px}
.mt-count{background:#f3f4f6;color:#6b7280;padding:2px 8px;border-radius:999px;font-size:.68rem;font-weight:800}.mt-count.changed{background:#fef3c7;color:#b45309;border:1px solid #fde68a}
.mudtabs-body-luxury{padding:20px;background:#fff;min-height:400px}
.form-grid-luxury{display:grid;gap:14px}.form-grid-luxury.cols-2{grid-template-columns:repeat(2,1fr)}.form-grid-luxury .full{grid-column:1/-1}
.field-luxury{display:flex;flex-direction:column;gap:6px}.fl-label{font-size:.78rem;font-weight:700;color:#374151}.fl-label.required::after{content:' *';color:#ef4444}
.input-wrap-luxury{position:relative;display:flex;align-items:center}.input-wrap-luxury svg{position:absolute;right:10px;width:14px;height:14px;color:#9ca3af;pointer-events:none;z-index:1}.input-wrap-luxury input{width:100%;height:42px;padding:0 34px 0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.86rem;font-family:'Tajawal';outline:none;background:#fff;transition:.2s}.input-wrap-luxury input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.select-wrap-luxury-input{position:relative;display:flex;align-items:center}.select-wrap-luxury-input svg:first-child{position:absolute;right:10px;width:14px;height:14px;color:#9ca3af;pointer-events:none;z-index:1}.select-wrap-luxury-input select{width:100%;height:42px;padding:0 32px 0 28px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.86rem;font-family:'Tajawal';background:#fff;appearance:none;cursor:pointer;outline:none}.select-wrap-luxury-input select:focus{border-color:var(--gold)}.select-wrap-luxury-input .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.form-textarea-luxury{width:100%;min-height:80px;padding:12px;border:1.5px solid #e8e2d0;border-radius:12px;font-family:'Tajawal';font-size:.86rem;outline:none;background:#fff;resize:vertical}.form-textarea-luxury:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.form-hint{font-size:.7rem;color:#9ca3af}
.info-box{display:flex;flex-direction:column;gap:4px;padding:10px 14px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;font-size:.84rem;color:#334155;font-weight:600}.info-danger{background:#fef2f2;border-color:#fecaca;color:#dc2626}.info-success{background:#f0fdf4;border-color:#bbf7d0;color:#166534}
.switch-luxury{position:relative;display:inline-block;width:44px;height:24px;flex-shrink:0}.switch-luxury input{opacity:0;width:0;height:0}.switch-luxury span{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#e5e7eb;border-radius:999px;transition:.2s}.switch-luxury span:before{position:absolute;content:"";height:18px;width:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.15)}.switch-luxury input:checked+span{background:var(--gold)}.switch-luxury input:checked+span:before{transform:translateX(20px)}
.pwd-hints-luxury{margin-top:16px;padding:12px;background:#fcfaf6;border:1px solid #e8e2d0;border-radius:12px}.pwd-hint-title{font-size:.8rem;font-weight:800;color:#374151;margin-bottom:6px}.pwd-hint-list{list-style:none;padding:0;margin:0}.pwd-hint-list li{font-size:.78rem;color:#9ca3af;padding:3px 0}.pwd-hint-list li.hint-ok{color:#059669}
.perm-section-luxury{display:flex;flex-direction:column;gap:12px}
.perm-toolbar{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #f1efe8;flex-wrap:wrap;gap:8px}.perm-legend{display:flex;gap:16px;padding:10px 0}.legend-item{display:flex;align-items:center;gap:6px;font-size:.76rem;color:#64748b;font-weight:600}.legend-dot{width:14px;height:14px;border-radius:4px;border:2px solid}.legend-null{border-color:#cbd5e1;background:#f8fafc}.legend-allow{border-color:#22c55e;background:#f0fdf4}.legend-deny{border-color:#ef4444;background:#fef2f2}
.perm-table-wrap-user{overflow-x:auto;max-height:60vh;overflow-y:auto;border:1px solid #e8e2d0;border-radius:12px}.perm-table-user{width:100%;border-collapse:collapse;min-width:900px}.perm-table-user thead{background:#f1f5f9;position:sticky;top:0;z-index:10}.perm-table-user th{padding:10px 8px;font-size:.78rem;font-weight:800;color:#334155;text-align:center;white-space:nowrap;background:#f1f5f9;border-bottom:2px solid #e2e8d0}.perm-table-user td{padding:8px;text-align:center;border-bottom:1px solid #f1f5f9}.perm-module-name-u{font-size:.82rem;font-weight:700;color:#0A0F1E}.role-perm-dots{display:flex;gap:2px;justify-content:center}.rpd{width:18px;height:18px;border-radius:4px;font-size:.6rem;font-weight:800;display:inline-flex;align-items:center;justify-content:center;background:#f1f5f9;color:#94a3b8}.rpd.on{background:#dbeafe;color:#1d4ed8}
.tri-btn{width:30px;height:30px;border-radius:6px;border:2px solid;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;font-size:.7rem;font-weight:800;transition:all .15s}.tri-null{border-color:#cbd5e1;background:#f8fafc;color:#94a3b8}.tri-allow{border-color:#22c55e;background:#f0fdf4;color:#22c55e}.tri-deny{border-color:#ef4444;background:#fef2f2;color:#ef4444}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}
.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}
@@media(max-width:900px){.form-grid-luxury.cols-2{grid-template-columns:1fr}}
</style>

@code {
    [Parameter] public int Id { get; set; }
    private bool _authorized = false;
    private bool _isNew => Id == 0;
    private bool _saving = false;
    private string _message = "";
    private bool _isError = false;
    private int _activeTab = 1;
    private UserEditDto _dto = new();
    private string _newPassword = "";
    private string _confirmPassword = "";
    private List<LookupDto> _rolesLookup = new();
    private List<LookupDto> _employeesLookup = new();
    private List<LookupDto> _warehousesLookup = new();
    private List<LookupDto> _cashBoxesLookup = new();
    private List<UserPermissionEditDto> _userPermissions = new();
    private bool _loadingPerms = false;
    private bool _savingPerms = false;
    private bool _permsLoaded = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!UserSession.IsLoggedIn){var restored=await UserSession.TryRestoreSessionAsync(); if(!restored){Navigation.NavigateTo("/login"); return;} if(!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);}
            if (_isNew && !PermissionService.CanAdd("SCR_USERS")){Navigation.NavigateTo("/access-denied"); return;}
            if (!_isNew && !PermissionService.CanEdit("SCR_USERS")){Navigation.NavigateTo("/access-denied"); return;}
            _authorized = true;
            await LoadLookups();
            if (!_isNew) await LoadUser();
            StateHasChanged();
        }
    }

    private async Task LoadLookups()
    {
        try
        {
            _rolesLookup = await UserService.GetRolesLookupAsync();
            _employeesLookup = await UserService.GetAvailableEmployeesLookupAsync(_isNew ? null : _dto.EmployeeID);
            _warehousesLookup = await UserService.GetWarehousesLookupAsync();
            _cashBoxesLookup = await UserService.GetCashBoxesLookupAsync();
        }
        catch (Exception ex){ShowError("خطأ في تحميل البيانات المساعدة: " + ex.Message);}
    }

    private async Task LoadUser()
    {
        try
        {
            var user = await UserService.GetByIdAsync(Id);
            if (user == null){ShowError("المستخدم غير موجود"); return;}
            _dto = user;
            _employeesLookup = await UserService.GetAvailableEmployeesLookupAsync(_dto.EmployeeID);
        }
        catch (Exception ex){ShowError("خطأ في تحميل بيانات المستخدم: " + ex.Message);}
    }

    private async Task SaveUser()
    {
        try
        {
            _saving = true; _message = ""; StateHasChanged();
            if (string.IsNullOrWhiteSpace(_dto.Username)){ShowError("اسم المستخدم مطلوب"); _activeTab = 1; return;}
            if (string.IsNullOrWhiteSpace(_dto.FullName)){ShowError("الاسم الكامل مطلوب"); _activeTab = 1; return;}
            if (_dto.RoleID == 0){ShowError("يجب اختيار الدور"); _activeTab = 1; return;}
            if (_isNew)
            {
                if (string.IsNullOrWhiteSpace(_newPassword) || _newPassword.Length < 6){ShowError("كلمة المرور يجب أن تكون 6 أحرف على الأقل"); _activeTab = 4; return;}
                if (_newPassword != _confirmPassword){ShowError("كلمة المرور وتأكيدها غير متطابقتين"); _activeTab = 4; return;}
            }
            if (_isNew)
            {
                var newId = await UserService.CreateAsync(_dto, _newPassword, UserSession.CurrentUserID);
                ShowSuccess("تم إنشاء المستخدم بنجاح");
                await Task.Delay(500);
                Navigation.NavigateTo($"/users/edit/{newId}");
            }
            else
            {
                var result = await UserService.UpdateAsync(_dto, UserSession.CurrentUserID);
                if (result) ShowSuccess("تم حفظ التعديلات بنجاح"); else ShowError("فشل في حفظ التعديلات");
            }
        }
        catch (Exception ex){ShowError(ex.Message);}
        finally{_saving = false;}
    }

    private void GoBack(){Navigation.NavigateTo("/users");}
    private async void LoadPermissionsIfNeeded()
    {
        if (_permsLoaded) return;
        try{_loadingPerms = true; StateHasChanged(); _userPermissions = await UserService.GetUserPermissionsAsync(Id); _permsLoaded = true;}
        catch (Exception ex){ShowError("خطأ في تحميل الصلاحيات: " + ex.Message);}
        finally{_loadingPerms = false; StateHasChanged();}
    }

    private async Task SavePermissions()
    {
        try{_savingPerms = true; StateHasChanged(); await UserService.SaveUserPermissionsAsync(Id, _userPermissions); ShowSuccess("تم حفظ الصلاحيات الخاصة بنجاح");}
        catch (Exception ex){ShowError("خطأ: " + ex.Message);}
        finally{_savingPerms = false;}
    }

    private async Task ClearAllOverrides()
    {
        foreach (var perm in _userPermissions){perm.CanView = null; perm.CanAdd = null; perm.CanEdit = null; perm.CanDelete = null; perm.CanPrint = null; perm.CanExport = null; perm.CanApprove = null; perm.CanPost = null; perm.CanCancel = null;}
        await SavePermissions(); ShowSuccess("تم إعادة تعيين الصلاحيات للدور الأصلي");
    }

    private void ToggleTriState(UserPermissionEditDto perm, string field)
    {
        bool? current = field switch{"View"=>perm.CanView,"Add"=>perm.CanAdd,"Edit"=>perm.CanEdit,"Delete"=>perm.CanDelete,"Print"=>perm.CanPrint,"Export"=>perm.CanExport,"Approve"=>perm.CanApprove,"Post"=>perm.CanPost,"Cancel"=>perm.CanCancel,_=>null};
        bool? next = current switch{null=>true,true=>false,false=>null};
        switch (field){case "View":perm.CanView=next; break; case "Add":perm.CanAdd=next; break; case "Edit":perm.CanEdit=next; break; case "Delete":perm.CanDelete=next; break; case "Print":perm.CanPrint=next; break; case "Export":perm.CanExport=next; break; case "Approve":perm.CanApprove=next; break; case "Post":perm.CanPost=next; break; case "Cancel":perm.CanCancel=next; break;}
    }

    private RenderFragment TriStateBtn(UserPermissionEditDto perm, string field) => builder =>
    {
        bool? val = field switch{"View"=>perm.CanView,"Add"=>perm.CanAdd,"Edit"=>perm.CanEdit,"Delete"=>perm.CanDelete,"Print"=>perm.CanPrint,"Export"=>perm.CanExport,"Approve"=>perm.CanApprove,"Post"=>perm.CanPost,"Cancel"=>perm.CanCancel,_=>null};
        string cssClass = val switch{null=>"tri-btn tri-null",true=>"tri-btn tri-allow",false=>"tri-btn tri-deny"};
        string label = val switch{null=>"—",true=>"✓",false=>"✕"};
        string title = val switch{null=>"يتبع الدور",true=>"سماح إضافي",false=>"منع خاص"};
        builder.OpenElement(0, "button"); builder.AddAttribute(1, "class", cssClass); builder.AddAttribute(2, "title", title);
        builder.AddAttribute(3, "onclick", Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ToggleTriState(perm, field)));
        builder.AddContent(4, label); builder.CloseElement();
    };

    private void ShowSuccess(string msg){_message=msg; _isError=false;}
    private void ShowError(string msg){_message=msg; _isError=true;}
}
