@using YKCoatings.Models
@using YKCoatings.Services
@implements IAsyncDisposable
@inject DashboardService DashboardService
@inject ModuleAuthorizationService AuthorizationService
@inject UserSessionService UserSession
@inject NavigationManager NavigationManager

<div class="live-prod-card">
    <div class="live-prod-header">
        <div class="live-prod-title">
            <i class="bi bi-activity"></i>
            أوامر التصنيع الحالية
            @if (!isLoading)
            {
                <span class="live-count">@items.Count</span>
            }
        </div>

        <div class="live-prod-actions">
            <button class="btn-live-refresh" @onclick="LoadData" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-mini"></span>
                }
                else
                {
                    <i class="bi bi-arrow-clockwise"></i>
                }
            </button>
        </div>
    </div>

    @if (accessDenied)
    {
        <div class="live-state-box live-access-denied">
            <div class="live-empty-icon"><i class="bi bi-shield-lock"></i></div>
            <div>لا تملك صلاحية عرض متابعة التصنيع</div>
        </div>
    }
    else if (loadError && !isLoading)
    {
        <div class="live-load-error" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            تعذر تحديث متابعة التصنيع؛ أعد المحاولة.
        </div>
    }

    @if (!accessDenied && isLoading)
    {
        <div class="live-state-box">
            <div class="spinner-md"></div>
            <span>جاري تحميل المتابعة اللحظية...</span>
        </div>
    }
    else if (!accessDenied && !isLoading && loadError && !items.Any())
    {
        <div class="live-state-box">
            <div class="live-empty-icon"><i class="bi bi-arrow-repeat"></i></div>
            <div>لا تتوفر بيانات متابعة حالياً؛ أعد المحاولة</div>
        </div>
    }
    else if (!accessDenied && !isLoading && !loadError && !items.Any())
    {
        <div class="live-state-box">
            <div class="live-empty-icon"><i class="bi bi-check2-circle"></i></div>
            <div>لا توجد أوامر تصنيع حالية</div>
        </div>
    }
    else if (!accessDenied && !isLoading)
    {
        <div class="live-prod-list">
            @foreach (var item in items)
            {
                var stages = GetStagesForOrder(item.ProductionOrderID);

                                <div class="live-order-item" @onclick="() => OpenOrder(item.ProductionOrderID, item.CurrentBatchID)">
                    <div class="live-order-top">
                        <div>
                            <div class="live-order-number">@item.OrderNumber</div>
                            <div class="live-product-name">@item.ProductName</div>
                        </div>
                        <span class="live-order-status @GetOrderStatusClass(item.OrderStatus)">
                            @item.OrderStatusName
                        </span>
                    </div>

                    <div class="live-order-mid">
                        <div class="live-line">
                            <span class="live-label">الباتش:</span>
                            <span class="live-value">
                                @(string.IsNullOrWhiteSpace(item.CurrentBatchNumber) ? "—" : item.CurrentBatchNumber)
                            </span>
                        </div>

                        <div class="live-line">
                            <span class="live-label">المرحلة:</span>
                            <span class="live-stage-name">
                                @(string.IsNullOrWhiteSpace(item.CurrentStageName) ? "لا توجد مرحلة نشطة" : item.CurrentStageName)
                            </span>
                        </div>

                        @if (item.StageStartTime.HasValue)
                        {
                            <div class="live-line">
                                <span class="live-label">بدأت:</span>
                                <span class="live-value">@item.StageStartTime.Value.ToString("dd/MM hh:mm tt")</span>
                            </div>
                        }

                        @if (item.ElapsedMinutes > 0)
                        {
                            <div class="live-line">
                                <span class="live-label">المنقضي:</span>
                                <span class="live-elapsed">@item.ElapsedText</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(item.OperatorName))
                        {
                            <div class="live-line">
                                <span class="live-label">المشغل:</span>
                                <span class="live-value">@item.OperatorName</span>
                            </div>
                        }
                    </div>

                                        @if (stages.Any())
                    {
                        <div class="htl-wrap">
                            <div class="htl-header">
                                <span>المراحل</span>
                                <span class="htl-count">@item.CompletedStages / @item.TotalStages</span>
                            </div>

                            <div class="htl-scroll">
                                <div class="htl-track">
                                    @foreach (var stage in stages)
                                    {
                                        <div class="htl-step @GetStageTimelineClass(stage.StageStatus)">
                                            <div class="htl-top-row">
                                                <div class="htl-dot"></div>
                                                @if (stage.StageOrder < stages.Last().StageOrder)
                                                {
                                                    <div class="htl-line @GetHLineClass(stage.StageStatus)"></div>
                                                }
                                            </div>
                                            <div class="htl-content">
                                                <div class="htl-name">@stage.StageName</div>
                                                @if (stage.StageStatus == 3)
                                                {
                                                    <div class="htl-meta htl-meta-done">
                                                        <span class="htl-badge-done"><i class="bi bi-check2"></i> تمت</span>
                                                        @if (!string.IsNullOrWhiteSpace(stage.DurationText))
                                                        {
                                                            <span class="htl-dur"><i class="bi bi-clock"></i> @stage.DurationText</span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(stage.OperatorName))
                                                    {
                                                        <div class="htl-op"><i class="bi bi-person"></i> @stage.OperatorName</div>
                                                    }
                                                }
                                                else if (stage.StageStatus == 2)
                                                {
                                                    <div class="htl-meta htl-meta-run">
                                                        <span class="htl-badge-run"><i class="bi bi-play-circle"></i> جارية</span>
                                                        @if (!string.IsNullOrWhiteSpace(stage.DurationText))
                                                        {
                                                            <span class="htl-dur"><i class="bi bi-clock"></i> منذ @stage.DurationText</span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(stage.OperatorName))
                                                    {
                                                        <div class="htl-op"><i class="bi bi-person"></i> @stage.OperatorName</div>
                                                    }
                                                }
                                                else if (stage.StageStatus == 4)
                                                {
                                                    <div class="htl-meta htl-meta-err">
                                                        <span class="htl-badge-err"><i class="bi bi-exclamation-circle"></i> مشكلة</span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="htl-meta htl-meta-wait">
                                                        <span>في الانتظار</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }

                    @if (item.ActiveBatchCount > 1)
                    {
                        <div class="live-batch-badge">
                            <i class="bi bi-layers"></i>
                            @item.ActiveBatchCount دفعات نشطة
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

<style>
    .live-prod-card {
        background: var(--yk-surface);
        border: 1px solid var(--yk-border);
        border-radius: 18px;
        box-shadow: var(--yk-shadow);
        overflow: hidden;
    }

    .live-prod-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--yk-bg);
        background: linear-gradient(135deg, var(--yk-black), var(--yk-black3));
        border-bottom: 1px solid var(--yk-gold-20);
    }

    .live-prod-title {
        display: flex;
        align-items: center;
        gap: .55rem;
        color: var(--yk-surface);
        font-weight: 800;
        font-size: .95rem;
    }

    .live-prod-title i { font-size: 1rem; }

    .live-count {
        background: var(--yk-gold-15);
        color: var(--yk-gold-light);
        padding: .15rem .55rem;
        border-radius: 999px;
        font-size: .75rem;
        font-weight: 700;
    }

    .btn-live-refresh {
        width: 36px; height: 36px;
        border: 1px solid rgba(255,255,255,.25);
        background: rgba(255,255,255,.12);
        color: var(--yk-surface);
        border-radius: 10px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
    }

    .btn-live-refresh:hover:not(:disabled) {
        background: rgba(255,255,255,.2);
        transform: rotate(20deg);
    }

    .btn-live-refresh:disabled { opacity: .75; cursor: not-allowed; }

    .live-state-box {
        padding: 2.2rem 1.25rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .85rem;
        color: var(--yk-text-2);
        font-weight: 600;
    }

    .live-empty-icon {
        width: 62px; height: 62px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--yk-success-soft);
        color: var(--yk-success);
        font-size: 1.55rem;
    }

    .live-load-error {
        margin: .8rem 1rem 0;
        border: 1px solid var(--yk-gold-20);
        border-radius: 10px;
        background: var(--yk-warning-soft);
        color: var(--yk-gold-dark);
        padding: .65rem .8rem;
        font-size: .84rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .live-access-denied { color: var(--yk-text-2); }
    .live-access-denied .live-empty-icon { color: var(--yk-gold-dark); }

    .live-prod-list {
        padding: 1rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
        gap: 1rem;
    }

    .live-order-item {
        border: 1px solid var(--yk-border);
        border-radius: 16px;
        padding: 1rem;
        background: var(--yk-bg);
        transition: .2s;
        cursor: pointer;
    }

    .live-order-item:hover {
        transform: translateY(-2px);
        box-shadow: var(--yk-shadow);
        border-color: var(--yk-border-gold);
    }

    .live-order-top {
        display: flex;
        justify-content: space-between;
        align-items: start;
        gap: .75rem;
        margin-bottom: .85rem;
    }

    .live-order-number {
        font-weight: 800;
        color: var(--yk-text);
        font-size: .95rem;
    }

    .live-product-name {
        color: var(--yk-text-2);
        font-size: .83rem;
        margin-top: .15rem;
    }

    .live-order-status {
        font-size: .72rem;
        font-weight: 700;
        padding: .25rem .65rem;
        border-radius: 999px;
        white-space: nowrap;
    }

    .los-prepare { background: var(--yk-warning-soft); color: var(--yk-text); }
    .los-work    { background: var(--yk-gold-10); color: var(--yk-gold-dark); }
    .los-qc      { background: var(--yk-info-soft); color: var(--yk-text); }

    .live-order-mid {
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    .live-line {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
        font-size: .83rem;
    }

    .live-label {
        color: var(--yk-text-2);
        font-weight: 700;
        min-width: 72px;
    }

    .live-value {
        color: var(--yk-text);
        font-weight: 600;
    }

    .live-stage-name {
        color: var(--yk-gold-dark);
        font-weight: 800;
    }

    .live-elapsed {
        color: var(--yk-danger);
        font-weight: 800;
    }

    /* ===== TIMELINE ===== */
        /* ===== HORIZONTAL TIMELINE ===== */
    .htl-wrap {
        margin-top: .9rem;
        border-top: 1px solid var(--yk-border);
        padding-top: .75rem;
    }

    .htl-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: .78rem;
        font-weight: 700;
        color: var(--yk-text-2);
        margin-bottom: .7rem;
    }

    .htl-count {
        background: var(--yk-gold-10);
        color: var(--yk-gold-dark);
        padding: .12rem .5rem;
        border-radius: 999px;
        font-size: .72rem;
    }

    .htl-scroll {
        overflow-x: auto;
        padding-bottom: .5rem;
    }

    .htl-track {
        display: flex;
        gap: 0;
        min-width: max-content;
    }

    .htl-step {
        display: flex;
        flex-direction: column;
        min-width: 120px;
        max-width: 160px;
        flex: 1;
    }

    .htl-top-row {
        display: flex;
        align-items: center;
        height: 18px;
    }

    .htl-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        border: 2.5px solid var(--yk-border);
        background: var(--yk-surface);
        flex-shrink: 0;
    }

    .htl-line {
        height: 2.5px;
        flex: 1;
        background: var(--yk-border);
        margin: 0 2px;
    }

    .htl-line.hline-done { background: var(--yk-success); }
    .htl-line.hline-running { background: linear-gradient(to right, var(--yk-warning), var(--yk-border)); }

    /* dot states */
    .htl-step.tl-done .htl-dot {
        background: var(--yk-success);
        border-color: var(--yk-success);
    }

    .htl-step.tl-running .htl-dot {
        background: var(--yk-surface);
        border-color: var(--yk-warning);
        box-shadow: 0 0 0 3px var(--yk-warning-soft);
        animation: pulse-ring 1.5s infinite;
    }

    .htl-step.tl-problem .htl-dot {
        background: var(--yk-danger);
        border-color: var(--yk-danger);
    }

    .htl-step.tl-waiting .htl-dot {
        background: var(--yk-surface);
        border-color: var(--yk-border);
    }

    .htl-content {
        padding-top: .5rem;
    }

    .htl-name {
        font-weight: 800;
        font-size: .84rem;
        color: var(--yk-text);
        margin-bottom: .3rem;
        line-height: 1.3;
    }

    .htl-step.tl-done .htl-name { color: var(--yk-text); }
    .htl-step.tl-running .htl-name { color: var(--yk-text); }
    .htl-step.tl-problem .htl-name { color: var(--yk-danger); }
    .htl-step.tl-waiting .htl-name { color: var(--yk-text-3); }

    .htl-meta {
        display: flex;
        flex-direction: column;
        gap: .2rem;
    }

    .htl-badge-done {
        display: inline-block;
        background: var(--yk-success-soft);
        color: var(--yk-text);
        font-size: .7rem;
        font-weight: 800;
        padding: .15rem .45rem;
        border-radius: 999px;
    }

    .htl-badge-run {
        display: inline-block;
        background: var(--yk-warning-soft);
        color: var(--yk-text);
        font-size: .7rem;
        font-weight: 800;
        padding: .15rem .45rem;
        border-radius: 999px;
        animation: pulse-ring 1.5s infinite;
    }

    .htl-badge-err {
        display: inline-block;
        background: var(--yk-danger-soft);
        color: var(--yk-danger);
        font-size: .7rem;
        font-weight: 800;
        padding: .15rem .45rem;
        border-radius: 999px;
    }

    .htl-dur {
        font-size: .76rem;
        font-weight: 800;
        color: var(--yk-text-2);
    }

    .htl-step.tl-done .htl-dur { color: var(--yk-text-2); }
    .htl-step.tl-running .htl-dur { color: var(--yk-text-2); }

    .htl-op {
        font-size: .74rem;
        font-weight: 700;
        color: var(--yk-text-2);
    }

    .htl-step.tl-done .htl-op { color: var(--yk-text-2); }
    .htl-step.tl-running .htl-op { color: var(--yk-text-2); }

    .htl-meta-wait {
        font-size: .74rem;
        font-weight: 700;
        color: var(--yk-text-3);
    }

    .live-batch-badge {
        margin-top: .6rem;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        background: var(--yk-info-soft);
        color: var(--yk-text);
        border: 1px solid var(--yk-info-soft);
        padding: .28rem .6rem;
        border-radius: 999px;
        font-size: .74rem;
        font-weight: 700;
    }

    .spinner-md, .spinner-mini {
        border-radius: 50%;
        border-style: solid;
        animation: liveSpin .8s linear infinite;
    }

    .spinner-md {
        width: 38px; height: 38px;
        border-width: 3px;
        border-color: var(--yk-info-soft);
        border-top-color: var(--yk-gold);
    }

    .spinner-mini {
        width: 14px; height: 14px;
        border-width: 2px;
        border-color: rgba(255,255,255,.35);
        border-top-color: var(--yk-surface);
    }

    @@keyframes liveSpin { to { transform: rotate(360deg); } }

    @@keyframes pulse-ring {
        0%   { box-shadow: 0 0 0 0 var(--yk-warning-soft); }
        70%  { box-shadow: 0 0 0 6px transparent; }
        100% { box-shadow: 0 0 0 0 transparent; }
    }

    @@media (max-width: 768px) {
        .live-prod-list {
            grid-template-columns: 1fr;
            padding: .85rem;
        }
    }
</style>

@code {
    private List<CurrentProductionOrderDto> items = new();
    private List<StageTimelineItemDto> allStages = new();
    private bool isLoading = true;
    private bool loadError;
    private bool accessDenied;
    private bool canViewOrders;
    private bool canViewBatches;
    private bool _loadInProgress;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            accessDenied = true;
            isLoading = false;
            return;
        }

        try
        {
            canViewOrders = await AuthorizationService.HasCurrentUserPermissionAsync(
                "SCR_PRODORD", p => p.CanView);
            canViewBatches = await AuthorizationService.HasCurrentUserPermissionAsync(
                "SCR_BATCH", p => p.CanView);
            accessDenied = !canViewOrders || !canViewBatches;
        }
        catch (UnauthorizedAccessException)
        {
            accessDenied = true;
        }

        if (!accessDenied)
        {
            await LoadData();
            StartAutoRefresh();
        }
        else
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        if (_loadInProgress || accessDenied) return;
        _loadInProgress = true;
        isLoading = true;
        loadError = false;
        try
        {
            if (!UserSession.IsLoggedIn)
            {
                accessDenied = true;
                items.Clear();
                allStages.Clear();
                return;
            }

            var refreshedItems = await DashboardService.GetCurrentProductionTrackingAsync(UserSession.UserID, 8);
            var batchIds = refreshedItems
                .Where(x => x.CurrentBatchID.HasValue && x.CurrentBatchID.Value > 0)
                .Select(x => x.CurrentBatchID!.Value)
                .Distinct()
                .ToList();
            var refreshedStages = batchIds.Count > 0
                ? await DashboardService.GetActiveBatchesStagesAsync(UserSession.UserID, batchIds)
                : new List<StageTimelineItemDto>();

            items = refreshedItems;
            allStages = refreshedStages;
        }
        catch (UnauthorizedAccessException)
        {
            accessDenied = true;
            items.Clear();
            allStages.Clear();
        }
        catch
        {
            loadError = true;
        }
        finally
        {
            isLoading = false;
            _loadInProgress = false;
        }
    }

    private List<StageTimelineItemDto> GetStagesForOrder(int productionOrderId)
    {
        return allStages
            .Where(s => s.ProductionOrderID == productionOrderId)
            .OrderBy(s => s.StageOrder)
            .ToList();
    }

        private void OpenOrder(int productionOrderId, int? batchId)
    {
        if (!canViewOrders || !canViewBatches) return;
        if (batchId.HasValue && batchId.Value > 0)
        {
            NavigationManager.NavigateTo($"/production-batches/edit/{batchId.Value}?tab=stages");
        }
        else
        {
            NavigationManager.NavigateTo($"/production-orders/edit/{productionOrderId}");
        }
    }

    private void StartAutoRefresh()
    {
        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = AutoRefreshLoop();
    }

    private async Task AutoRefreshLoop()
    {
        try
        {
            while (_timer is not null && await _timer.WaitForNextTickAsync(_cts!.Token))
            {
                await InvokeAsync(async () =>
                {
                    await LoadData();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            _cts?.Cancel();
            if (_timer is not null)
                _timer.Dispose();
            _cts?.Dispose();
        }
        catch
        {
        }

        await Task.CompletedTask;
    }

    private string GetOrderStatusClass(int status) => status switch
    {
        3 => "los-prepare",
        4 => "los-work",
        5 => "los-qc",
        _ => "los-prepare"
    };

    private string GetStageTimelineClass(int stageStatus) => stageStatus switch
    {
        3 => "tl-done",
        2 => "tl-running",
        4 => "tl-problem",
        _ => "tl-waiting"
    };

        private string GetLineClass(int stageStatus) => stageStatus switch
    {
        3 => "line-done",
        2 => "line-running",
        _ => ""
    };

    private string GetHLineClass(int stageStatus) => stageStatus switch
    {
        3 => "hline-done",
        2 => "hline-running",
        _ => ""
    };
}