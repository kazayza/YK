@page "/expenses/new"
@page "/expenses/edit/{Id:int}"
@using YKCoatings.Services
@using YKCoatings.Models
@inject AccountingService AccountingService
@inject TreasuryService TreasuryService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Logging.ILogger<ExpenseEdit> Logger

<PageTitle>@(Id==0?"مصروف جديد":"تعديل مصروف")</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><h4>يجب تسجيل الدخول</h4></div>}
else if (!permissionsLoaded)
{<div class="loading-luxury" dir="rtl"><p>جاري التحقق من صلاحيات المصروفات...</p></div>}
else if (!CanUseExpenseEditor)
{<div class="no-access-luxury" dir="rtl"><h4>ليس لديك صلاحية تنفيذ هذه العملية على المصروفات</h4></div>}
else
{
<div class="luxury-page" dir="rtl">
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-content">
            <div class="lh-right">
                <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                <div class="lh-text">
                    <h2 class="lh-title">@(Id==0?"مصروف جديد":"تعديل مصروف")</h2>
                    <p class="lh-subtitle">   Pro — مركز تكلفة اختياري + فترة محاسبية + قيد أوتوماتيك</p>
                </div>
            </div>
            <div class="lh-actions">
                <button class="btn-luxury btn-ghost-luxury" @onclick='()=>Navigation.NavigateTo("/expenses")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>رجوع</button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
    else if (Id != 0 && isLoadingExpenseDetail)
    {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل تفاصيل المصروف...</p></div>}
    else if (Id != 0 && expenseDetailReadFailed)
    {
        <div class="expense-detail-read-state" role="alert">
            <p>تعذر تحميل بيانات المصروف. لم يُفتح نموذج التعديل.</p>
            <button class="btn-luxury btn-ghost-luxury" @onclick="RetryExpenseDetailLoadAsync" disabled="@isLoadingExpenseDetail">
                @(isLoadingExpenseDetail ? "جاري إعادة المحاولة..." : "إعادة محاولة تحميل المصروف")
            </button>
        </div>
    }
    else if (Id != 0 && expenseDetailReadDenied)
    {
        <div class="expense-detail-read-state" role="alert">
            <p>ليس لديك صلاحية عرض بيانات هذا المصروف.</p>
            <button class="btn-luxury btn-ghost-luxury" @onclick='()=>Navigation.NavigateTo("/expenses")'>العودة إلى قائمة المصروفات</button>
        </div>
    }
    else if (Id != 0 && expenseDetailNotFound)
    {
        <div class="expense-detail-read-state" role="status">
            <p>المصروف غير موجود.</p>
            <button class="btn-luxury btn-ghost-luxury" @onclick='()=>Navigation.NavigateTo("/expenses")'>العودة إلى قائمة المصروفات</button>
        </div>
    }
    else
    {
        <div class="form-card-luxury">
            <div class="fc-gold-line"></div>
            <div class="fc-header"><h3>بيانات المصروف — @(hasLoadedExpenseAccounts ? $"{expenseAccounts.Count} حساب متاح" : "خيارات الحسابات غير متاحة")</h3></div>
            <div class="fc-body">
                <div class="form-grid-luxury">
                    <div class="fg"><label>رقم المصروف (تلقائي)</label><input type="text" @bind="dto.ExpenseNumber" readonly class="readonly" placeholder="يُخصص عند الحفظ" /></div>
                    <div class="fg"><label>تاريخ المصروف *</label><input type="date" @bind="dto.ExpenseDate" @bind:after="OnDateChanged" /></div>
                    <div class="fg"><label>السنة المالية</label>
                        <select @bind="fiscalYearSelected" @bind:after="OnFiscalYearChanged" disabled="@(isLoadingFiscalYearOptions || fiscalYearOptionsReadDenied)">
                            <option value="0">— تلقائي من التاريخ —</option>
                            @foreach(var fy in fiscalYears){<option value="@fy.FiscalYearID">@fy.YearName (@fy.StartDate.ToString("yyyy") ) - @fy.StatusName</option>}
                        </select>
                        @if (fiscalYearOptionsReadFailed)
                        {
                            <div class="expense-lookup-read-alert" role="alert">
                                <span>تعذر تحميل خيارات السنوات المالية.@(hasLoadedFiscalYearOptions ? " المعروض هو آخر تحميل ناجح." : " لا توجد خيارات سابقة.")</span>
                                <button class="btn-luxury btn-ghost-luxury" @onclick="RetryFiscalYearOptionsAsync" disabled="@isLoadingFiscalYearOptions">
                                    @(isLoadingFiscalYearOptions ? "جاري إعادة المحاولة..." : "إعادة محاولة تحميل السنوات")
                                </button>
                            </div>
                        }
                        else if (fiscalYearOptionsReadDenied)
                        {
                            <small role="alert" style="color:#dc2626;font-weight:700">ليس لديك صلاحية عرض السنوات المالية.</small>
                        }
                        else if (hasLoadedFiscalYearOptions && !fiscalYears.Any())
                        {
                            <small style="color:#dc2626;font-weight:700">لا توجد سنة مالية. أنشئها من شاشة إدارة السنوات المالية ثم أعد تحميل الصفحة.</small>
                        }
                    </div>
                    <div class="fg"><label>الفترة المحاسبية *</label>
                        <select @bind="dto.PeriodID" disabled="@(isLoadingAccountingPeriods || accountingPeriodsReadDenied)">
                            <option value="0">— اختر الفترة —</option>
                            @foreach(var p in filteredPeriods){<option value="@p.PeriodID">@p.PeriodName (@p.StartDate.ToString("MMM yyyy"))</option>}
                        </select>
                        @if (accountingPeriodsReadFailed)
                        {
                            <div class="expense-lookup-read-alert" role="alert">
                                <span>تعذر تحميل خيارات الفترات المحاسبية.@(hasLoadedAccountingPeriods ? " المعروض هو آخر تحميل ناجح." : " لا توجد خيارات سابقة.")</span>
                                <button class="btn-luxury btn-ghost-luxury" @onclick="RetryAccountingPeriodOptionsAsync" disabled="@isLoadingAccountingPeriods">
                                    @(isLoadingAccountingPeriods ? "جاري إعادة المحاولة..." : "إعادة محاولة تحميل الفترات")
                                </button>
                            </div>
                        }
                        else if (accountingPeriodsReadDenied)
                        {
                            <small role="alert" style="color:#dc2626;font-weight:700">ليس لديك صلاحية عرض الفترات المحاسبية.</small>
                        }
                        else if (hasLoadedAccountingPeriods)
                        {
                            <small style="color:@(filteredPeriods.Any()? "#8B95A5" : "#dc2626")">@(filteredPeriods.Any() ? $"{filteredPeriods.Count} فترة متاحة" : " لا توجد فترات - تأكد من السنة المالية")</small>
                        }
                    </div>

                    <div class="fg full" style="grid-column:1/-1;height:1px;background:#e8e2d0;margin:8px 0"></div>

                    <div class="fg"><label>حساب المصروف (مدين) * — @(hasLoadedExpenseAccounts ? $"{expenseAccounts.Count} متاح من {allAccounts.Count}" : "خيارات الحسابات غير متاحة")</label>
                        <select @bind="dto.AccountID" disabled="@(isLoadingExpenseAccountOptions || expenseAccountOptionsReadDenied)">
                            <option value="0">— اختر حساب —</option>
                            @foreach(var acc in expenseAccounts){<option value="@acc.AccountID">@acc.AccountCode - @acc.AccountNameAr (@acc.AccountTypeName)</option>}
                        </select>
                        @if (expenseAccountOptionsReadFailed)
                        {
                            <div class="expense-lookup-read-alert" role="alert">
                                <span>تعذر تحميل خيارات حسابات المصروف.@(hasLoadedExpenseAccounts ? " المعروض آخر تحميل ناجح." : " لا توجد خيارات سابقة.")</span>
                                <button class="btn-luxury btn-ghost-luxury" @onclick="RetryExpenseAccountOptionsAsync" disabled="@isLoadingExpenseAccountOptions">
                                    @(isLoadingExpenseAccountOptions ? "جاري إعادة المحاولة..." : "إعادة محاولة تحميل الحسابات")
                                </button>
                            </div>
                        }
                        else if (expenseAccountOptionsReadDenied)
                        {
                            <small role="alert" style="color:#dc2626;font-weight:700">ليس لديك صلاحية عرض حسابات المصروفات.</small>
                        }
                        else if (hasLoadedExpenseAccounts && !expenseAccounts.Any())
                        {
                            <small style="color:#dc2626;font-weight:700"><i class=bi-exclamation-triangle-fill></i> لا توجد حسابات مصروف نشطة ضمن النتائج المحمّلة. راجع شجرة الحسابات.</small>
                        }
                    </div>
                    @if (dto.PaymentMethod == 3)
                    {
                        <div class="fg"><label>حساب الالتزام (آجل) *</label>
                            <select @bind="creditSelected" disabled="@(isLoadingExpenseAccountOptions || expenseAccountOptionsReadDenied)">
                                <option value="0">— اختر حساب التزام تفصيلي —</option>
                                @foreach(var acc in creditAccounts){<option value="@acc.AccountID">@acc.AccountCode - @acc.AccountNameAr</option>}
                            </select>
                        </div>
                    }

                    <div class="fg"><label>مركز التكلفة (إذا كان مطلوبًا للحساب)</label>
                        <select @bind="costCenterSelected" disabled="@(isLoadingCostCenters || costCenterOptionsReadDenied)">
                            <option value="0">— بدون —</option>
                            @foreach(var cc in costCenters){<option value="@cc.CostCenterID">@cc.CostCenterCode - @cc.CostCenterNameAr</option>}
                        </select>
                        @if (costCenterOptionsReadFailed)
                        {
                            <div class="expense-lookup-read-alert" role="alert">
                                <span>تعذر تحميل خيارات مراكز التكلفة.@(hasLoadedCostCenters ? " المعروض آخر تحميل ناجح." : " لا توجد خيارات سابقة.")</span>
                                <button class="btn-luxury btn-ghost-luxury" @onclick="RetryCostCenterOptionsAsync" disabled="@isLoadingCostCenters">
                                    @(isLoadingCostCenters ? "جاري إعادة المحاولة..." : "إعادة محاولة تحميل مراكز التكلفة")
                                </button>
                            </div>
                        }
                        else if (costCenterOptionsReadDenied)
                        {
                            <small role="alert" style="color:#dc2626;font-weight:700">ليس لديك صلاحية عرض خيارات مراكز التكلفة.</small>
                        }
                        else if (hasLoadedCostCenters && !costCenters.Any())
                        {
                            <small style="color:#8B95A5">لا توجد مراكز تكلفة متاحة؛ يظل هذا الحقل اختياريًا.</small>
                        }
                    </div>
                    <div class="fg"><label>المبلغ *</label><input type="number" step="0.01" @bind="dto.Amount" /></div>

                    <div class="fg"><label>طريقة الدفع</label>
                        <select @bind="dto.PaymentMethod" @bind:after="OnPaymentMethodChanged">
                            <option value="">— اختر طريقة الدفع —</option>
                            <option value="1">نقدي - خزينة</option>
                            <option value="2">بنك</option>
                            <option value="3">آجل - مستحق</option>
                        </select>
                    </div>
                    @if (dto.PaymentMethod == 1)
                    {
                        <div class="fg"><label>الخزينة * (مصدر الدفع)</label>
                            <select @bind="cashBoxSelected" disabled="@(isLoadingCashBoxOptions || cashBoxOptionsReadDenied)" style="border-color:@(cashBoxSelected==0 ? "#ef4444" : "#e8e2d0")">
                                <option value="0">— اختر الخزينة —</option>
                                @foreach(var cb in cashBoxes){<option value="@cb.CashBoxID">@GetCashBoxOptionLabel(cb)</option>}
                            </select>
                            @if (cashBoxOptionsReadFailed)
                            {
                                <div class="expense-lookup-read-alert" role="alert">
                                    <span>تعذر تحميل خيارات الخزائن.@(hasLoadedCashBoxes ? " المعروض آخر تحميل ناجح." : " لا توجد خيارات سابقة.")</span>
                                    <button class="btn-luxury btn-ghost-luxury" @onclick="RetryCashBoxOptionsAsync" disabled="@isLoadingCashBoxOptions">
                                        @(isLoadingCashBoxOptions ? "جاري إعادة المحاولة..." : "إعادة محاولة تحميل الخزائن")
                                    </button>
                                </div>
                            }
                            else if (cashBoxOptionsReadDenied)
                            {
                                <small role="alert" style="color:#dc2626;font-weight:700">ليس لديك صلاحية عرض خيارات الخزائن.</small>
                            }
                            else if (hasLoadedCashBoxes && !cashBoxes.Any())
                            {
                                <small style="color:#b45309">لا توجد خزائن نشطة متاحة.</small>
                            }
                            <small style="color:@(canViewCashBoxBalances ? "#059669" : "#8B95A5")">@(canViewCashBoxBalances ? (cashBalanceReadFailed ? "المعروض آخر رصيد ناجح؛ سيُحدّث عند اعتماد المصروف." : "سيُحدّث الرصيد عند اعتماد المصروف.") : cashBalanceReadDenied ? "ليس لديك صلاحية عرض الرصيد الفعلي." : CanReadCashBoxBalances ? "الرصيد الفعلي غير متاح حاليًا؛ لن يُعرض الصفر كرصيد." : "الرصيد غير متاح لهذا المستخدم؛ لن يُعرض الصفر على أنه رصيد فعلي.")</small>
                            @if (cashBalanceReadFailed)
                            {
                                <div class="expense-lookup-read-alert" role="alert">
                                    <span>@cashBalanceLoadMessage</span>
                                    <button class="btn-luxury btn-ghost-luxury" @onclick="RetryCashBoxBalanceLoadAsync" disabled="@isLoadingCashBoxBalances">
                                        @(isLoadingCashBoxBalances ? "جاري إعادة المحاولة..." : "إعادة محاولة تحميل الرصيد")
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    else if (dto.PaymentMethod == 2)
                    {
                        <div class="fg"><label>الحساب البنكي * (مصدر الدفع)</label>
                            <select @bind="bankAccountSelected" disabled="@(isLoadingBankAccounts || bankAccountOptionsReadDenied)" style="border-color:@(bankAccountSelected==0 ? "#ef4444" : "#e8e2d0")">
                                <option value="0">— اختر الحساب البنكي —</option>
                                @foreach(var bank in bankAccounts){<option value="@bank.BankAccountID">@bank.BankName - @bank.AccountNumber</option>}
                            </select>
                            @if (bankAccountOptionsReadFailed)
                            {
                                <div class="expense-lookup-read-alert" role="alert">
                                    <span>تعذر تحميل خيارات الحسابات البنكية.@(hasLoadedBankAccounts ? " المعروض آخر تحميل ناجح." : " لا توجد خيارات سابقة.")</span>
                                    <button class="btn-luxury btn-ghost-luxury" @onclick="RetryBankAccountOptionsAsync" disabled="@isLoadingBankAccounts">
                                        @(isLoadingBankAccounts ? "جاري إعادة المحاولة..." : "إعادة محاولة تحميل الحسابات البنكية")
                                    </button>
                                </div>
                            }
                            else if (bankAccountOptionsReadDenied)
                            {
                                <small role="alert" style="color:#dc2626;font-weight:700">ليس لديك صلاحية عرض الحسابات البنكية.</small>
                            }
                            else if (hasLoadedBankAccounts && !bankAccounts.Any())
                            {
                                <small style="color:#b45309">لا يوجد حساب بنكي نشط متاح.</small>
                            }
                        </div>
                    }

                    <div class="fg full"><label>البيان *</label><textarea @bind="dto.Description" rows="2" placeholder="مصاريف صيانة..."></textarea></div>
                    <div class="fg"><label>مرجع</label><input type="text" @bind="dto.Reference" /></div>
                    <div class="fg"><label>ملاحظات</label><input type="text" @bind="dto.Notes" /></div>
                </div>

                @if (!string.IsNullOrEmpty(msg))
                {<div class="msg-luxury @(isError?"msg-error":"msg-success")" style="margin-top:16px">@msg</div>}

                <div class="journal-preview" style="margin-top:20px;background:#fcfaf6;border:1px solid #e8e2d0;border-radius:14px;padding:14px">
                    <h4 style="margin:0 0 10px;font-size:.9rem;color:#0A0F1E">معاينة القيد التلقائي</h4>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;font-size:.82rem">
                        <div style="background:#fff;border:1px solid #e8e2d0;border-radius:10px;padding:10px">
                            <div style="color:#8B95A5;font-size:.7rem">مدين</div>
                            <div style="font-weight:800">@GetAccountName(dto.AccountID)</div>
                            <div style="color:#dc2626;font-weight:800;margin-top:4px">@dto.Amount.ToString("#,##0.00")</div>
                            @if(costCenterSelected!=0){<div style="margin-top:4px"><span class="coa-type type-3">@GetCostCenterName(costCenterSelected)</span></div>}
                        </div>
                        <div style="background:#fff;border:1px solid #e8e2d0;border-radius:10px;padding:10px">
                            <div style="color:#8B95A5;font-size:.7rem">دائن</div>
                            <div style="font-weight:800">@GetCreditPreviewName()</div>
                            <div style="color:#059669;font-weight:800;margin-top:4px">@dto.Amount.ToString("#,##0.00")</div>
                            <div style="color:#8B95A5;font-size:.7rem;margin-top:4px">الفترة: @GetPeriodName(dto.PeriodID)</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="fc-footer">
                <button class="btn-luxury btn-primary-luxury" @onclick="Save" disabled="@isSaving">
                    @if(isSaving){<div class="btn-spinner-sm"></div>}
                    @(Id==0?"حفظ + قيد تلقائي":"تحديث")
                </button>
                <button class="btn-luxury btn-ghost-luxury" @onclick='()=>Navigation.NavigateTo("/expenses")'>إلغاء</button>
                @if(Id!=0 && dto.JournalID!=null)
                {
                    <button class="btn-luxury" style="background:#eff6ff;border:1.5px solid #bfdbfe;color:#2563eb" @onclick="ViewJournal">عرض القيد @dto.JournalID</button>
                }
            </div>
        </div>
    }
</div>
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1100px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,#121A2E 100%);border-radius:20px;padding:18px 22px;border:1px solid rgba(212,175,55,.18)}
.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:rgba(212,175,55,.15);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}
.lh-logo{width:26px;height:26px}
.lh-title{font-size:1.25rem;font-weight:900;color:#F5E6C8;margin:0}
.lh-subtitle{font-size:.72rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;font-family:'Tajawal'}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2)}
.form-card-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:20px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.06)}
.fc-gold-line{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent)}
.fc-header{padding:16px 20px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8}
.fc-header h3{margin:0;font-size:.92rem;font-weight:800;color:#0A0F1E}
.fc-body{padding:20px}
.form-grid-luxury{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.fg.full{grid-column:1/-1}
.fg label{font-size:.78rem;font-weight:700;color:#374151;margin-bottom:6px;display:block}
.fg input,.fg select,.fg textarea{width:100%;height:40px;padding:0 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.84rem;font-family:'Tajawal';outline:none;background:#fcfaf6}
.fg textarea{height:auto;padding:10px 12px}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--gold);background:#fff}
.fg input.readonly{background:#f3f4f6;color:#6b7280}
.coa-type{font-size:.68rem;padding:3px 8px;border-radius:6px;font-weight:800;border:1px solid}
.type-3{background:#f5f3ff;color:#7c3aed;border-color:#ddd6fe}
.fc-footer{display:flex;gap:8px;padding:14px 20px;border-top:1px solid #f1efe8;background:#fcfaf6;justify-content:flex-end;flex-wrap:wrap}
.msg-luxury{padding:10px 14px;border-radius:12px;font-size:.82rem;font-weight:600}
.msg-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
.expense-lookup-read-alert{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:8px;padding:8px 10px;border-radius:10px;background:#fef2f2;color:#991b1b;border:1px solid #fecaca;font-size:.76rem;font-weight:700}
.expense-lookup-read-alert .btn-luxury:disabled{opacity:.55;cursor:not-allowed}
.expense-detail-read-state{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap;padding:14px 16px;border-radius:12px;background:#fef2f2;color:#991b1b;border:1px solid #fecaca;font-size:.84rem;font-weight:700}
.expense-detail-read-state p{margin:0}
.expense-detail-read-state .btn-luxury:disabled{opacity:.55;cursor:not-allowed}
.msg-success{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}
.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}
</style>

@code {
    [Parameter] public int Id { get; set; }
    private ExpenseDto dto = new();
    private List<ChartOfAccountDto> allAccounts = new();
    private List<ChartOfAccountDto> expenseAccounts = new();
    private List<ChartOfAccountDto> creditAccounts = new();
    private List<CostCenterListDto> costCenters = new();
    private List<FiscalYearListDto> fiscalYears = new();
    private List<AccountingPeriodListDto> allPeriods = new();
    private List<AccountingPeriodListDto> filteredPeriods = new();
    private List<CashBoxListDto> cashBoxes = new();
    private bool isLoadingCashBoxOptions;
    private bool hasLoadedCashBoxes;
    private bool cashBoxOptionsReadFailed;
    private bool cashBoxOptionsReadDenied;
    private List<BankAccountListDto> bankAccounts = new();
    private bool isLoading = true;
    private bool isLoadingFiscalYearOptions;
    private bool hasLoadedFiscalYearOptions;
    private bool fiscalYearOptionsReadFailed;
    private bool fiscalYearOptionsReadDenied;
    private bool isLoadingAccountingPeriods;
    private bool hasLoadedAccountingPeriods;
    private bool accountingPeriodsReadFailed;
    private bool accountingPeriodsReadDenied;
    private bool isLoadingCostCenters;
    private bool hasLoadedCostCenters;
    private bool costCenterOptionsReadFailed;
    private bool costCenterOptionsReadDenied;
    private bool isLoadingExpenseAccountOptions;
    private bool hasLoadedExpenseAccounts;
    private bool expenseAccountOptionsReadFailed;
    private bool expenseAccountOptionsReadDenied;
    private bool isLoadingBankAccounts;
    private bool hasLoadedBankAccounts;
    private bool bankAccountOptionsReadFailed;
    private bool bankAccountOptionsReadDenied;
    private bool isLoadingExpenseDetail;
    private bool expenseDetailReadFailed;
    private bool expenseDetailReadDenied;
    private bool expenseDetailNotFound;
    private bool expenseEditorInitialized;
    private bool isSaving = false;
    private string msg = "";
    private bool isError = true;
    private ModulePermissionDto? permissions;
    private bool permissionsLoaded;
    private bool canViewCashBoxBalances;
    private bool isLoadingCashBoxBalances;
    private bool hasLoadedCashBoxBalances;
    private bool cashBalanceReadFailed;
    private bool cashBalanceReadDenied;
    private string cashBalanceLoadMessage = "";

    private bool CanReadCashBoxBalances => PermissionService.CanView("SCR_CASHSTAT")
        || PermissionService.CanView("SCR_TREASURY")
        || PermissionService.CanView("SCR_BANKS")
        || PermissionService.CanView("SCR_CASHBOX")
        || PermissionService.CanView("SCR_CASHBOXES");

    private bool CanUseExpenseEditor
    {
        get
        {
            if (permissions is null || !permissions.CanView) return false;
            if (Id == 0) return permissions.CanAdd;
            if (!permissions.CanEdit || dto.ExpenseStatus != 1) return false;
            if (dto.JournalID.HasValue) return permissions.CanApprove;
            return !dto.IsPosted;
        }
    }

    private int fiscalYearSelected = 0;
    private int creditSelected = 0;
    private int costCenterSelected = 0;
    private int cashBoxSelected = 0;
    private int bankAccountSelected = 0;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            permissionsLoaded = true;
            isLoading = false;
            return;
        }

        isLoading = true;
        try
        {
            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(UserSession.UserID);

            var expensePermissions = PermissionService.Permissions
                .Where(p => p.ModuleCode.Equals("SCR_EXPENSES", StringComparison.OrdinalIgnoreCase)
                         || p.ModuleCode.Equals("SCR_EXPENSE", StringComparison.OrdinalIgnoreCase)
                         || p.ModuleCode.Equals("SCR_OVERHEAD", StringComparison.OrdinalIgnoreCase)
                         || p.ModuleCode.Equals("SCR_OVERHEAD_EXPENSES", StringComparison.OrdinalIgnoreCase))
                .ToList();
            permissions = expensePermissions.Count == 0 ? null : new ModulePermissionDto
            {
                CanView = expensePermissions.Any(p => p.CanView),
                CanAdd = expensePermissions.Any(p => p.CanAdd),
                CanEdit = expensePermissions.Any(p => p.CanEdit),
                CanDelete = expensePermissions.Any(p => p.CanDelete),
                CanPrint = expensePermissions.Any(p => p.CanPrint),
                CanExport = expensePermissions.Any(p => p.CanExport),
                CanApprove = expensePermissions.Any(p => p.CanApprove),
                CanPost = expensePermissions.Any(p => p.CanPost),
                CanCancel = expensePermissions.Any(p => p.CanCancel)
            };
            permissionsLoaded = true;
            if (!CanUseExpenseEditor)
            {
                isLoading = false;
                return;
            }

            await LoadExpenseAccountOptionsAsync();

            await LoadCostCenterOptionsAsync();
            await LoadFiscalYearOptionsAsync();
            await LoadAccountingPeriodOptionsAsync();
            await LoadCashBoxOptionsAsync();
            await LoadBankAccountOptionsAsync();
            if (CanReadCashBoxBalances)
                await LoadCashBoxBalanceOptionsAsync();

            // لا تنشئ سنة مالية أو فتراتها كأثر جانبي لفتح شاشة المصروفات.
            if (hasLoadedFiscalYearOptions && !fiscalYearOptionsReadFailed && !fiscalYearOptionsReadDenied && !accountingPeriodsReadFailed && !accountingPeriodsReadDenied && !fiscalYears.Any())
            {
                msg = "لا توجد سنة مالية أو فترات محاسبية. أنشئها صراحةً من شاشة إدارة السنوات المالية قبل تسجيل المصروف.";
                isError = true;
            }

            if (Id != 0)
            {
                await LoadExpenseDetailAsync();
            }
            else
            {
                // يُخصص رقم المصروف عند الحفظ داخل المعاملة، لا عند فتح النموذج.
                dto.ExpenseNumber = string.Empty;
                dto.ExpenseDate = DateTime.Today;
                // اختر أول سنة مالية حالية تلقائياً
                var currentFY = fiscalYears.FirstOrDefault(f => f.IsCurrent) ?? fiscalYears.FirstOrDefault();
                if (currentFY != null) fiscalYearSelected = currentFY.FiscalYearID;
                OnDateChanged();
            }
            FilterPeriods();
            // لو لسه مفيش فترة بعد الفلترة، اختر أول فترة متاحة
            if (dto.PeriodID == 0 && filteredPeriods.Any())
                dto.PeriodID = filteredPeriods.First().PeriodID;
            // اختيار خزينة افتراضية عند الدفع النقدي فقط؛ لا تُربط مصروفات البنك أو الآجل بخزينة افتراضية.
            if (dto.PaymentMethod == 1 && cashBoxSelected==0 && cashBoxes.Any())
            {
                var def = cashBoxes.FirstOrDefault(c=>c.IsDefault) ?? cashBoxes.First();
                cashBoxSelected = def.CashBoxID;
            }

            if (Id == 0)
                expenseEditorInitialized = true;
        }
        catch (Exception ex)
        {
            permissions = null;
            permissionsLoaded = true;
            msg = $"خطأ تحميل: {ex.Message}";
            isError = true;
        }
        finally { isLoading = false; }
    }

    private Task RetryExpenseAccountOptionsAsync() => LoadExpenseAccountOptionsAsync();

    private async Task LoadExpenseAccountOptionsAsync()
    {
        if (isLoadingExpenseAccountOptions) return;

        isLoadingExpenseAccountOptions = true;
        expenseAccountOptionsReadDenied = false;
        try
        {
            var loadedAccounts = await AccountingService.GetExpenseAccountLookupsAsync();
            // لا تعرض إلا الحسابات النشطة التفصيلية؛ لا تُوسّع الاختيار إلى حسابات عشوائية عند غياب المطابقة.
            var loadedExpenseAccounts = loadedAccounts.Where(a => a.IsActive && a.IsDetailAccount
                && (a.AccountType == 5 || a.AccountType == 6)).ToList();
            var loadedCreditAccounts = loadedAccounts.Where(a => a.IsActive && a.IsDetailAccount && a.AccountType == 2).ToList();

            allAccounts = loadedAccounts;
            expenseAccounts = loadedExpenseAccounts;
            creditAccounts = loadedCreditAccounts;
            hasLoadedExpenseAccounts = true;
            expenseAccountOptionsReadFailed = false;
        }
        catch (UnauthorizedAccessException)
        {
            allAccounts = new();
            expenseAccounts = new();
            creditAccounts = new();
            hasLoadedExpenseAccounts = false;
            expenseAccountOptionsReadFailed = false;
            expenseAccountOptionsReadDenied = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load expense account options for the expense editor.");
            expenseAccountOptionsReadFailed = true;
        }
        finally
        {
            isLoadingExpenseAccountOptions = false;
        }
    }

    private Task RetryCostCenterOptionsAsync() => LoadCostCenterOptionsAsync();

    private async Task LoadCostCenterOptionsAsync()
    {
        if (isLoadingCostCenters) return;

        isLoadingCostCenters = true;
        costCenterOptionsReadDenied = false;
        try
        {
            var loadedCostCenters = await TreasuryService.GetCostCentersForExpenseEditAsync();
            costCenters = loadedCostCenters;
            hasLoadedCostCenters = true;
            costCenterOptionsReadFailed = false;
        }
        catch (UnauthorizedAccessException)
        {
            costCenters = new();
            hasLoadedCostCenters = false;
            costCenterOptionsReadFailed = false;
            costCenterOptionsReadDenied = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load cost-center options for the expense editor.");
            costCenterOptionsReadFailed = true;
        }
        finally
        {
            isLoadingCostCenters = false;
        }
    }

    private Task RetryCashBoxOptionsAsync() => LoadCashBoxOptionsAsync();

    private async Task LoadCashBoxOptionsAsync()
    {
        if (isLoadingCashBoxOptions) return;

        isLoadingCashBoxOptions = true;
        cashBoxOptionsReadDenied = false;
        try
        {
            var previousBalances = canViewCashBoxBalances
                ? cashBoxes.ToDictionary(box => box.CashBoxID, box => box.CurrentBalance)
                : null;
            var loadedCashBoxes = await TreasuryService.GetCashBoxLookupsAsync();
            if (previousBalances is not null)
            {
                foreach (var box in loadedCashBoxes)
                    if (previousBalances.TryGetValue(box.CashBoxID, out var balance)) box.CurrentBalance = balance;

                if (loadedCashBoxes.Any(box => !previousBalances.ContainsKey(box.CashBoxID)))
                {
                    canViewCashBoxBalances = false;
                    cashBalanceReadFailed = true;
                    cashBalanceReadDenied = false;
                    cashBalanceLoadMessage = "تغيرت خيارات الخزائن؛ أعد تحميل الأرصدة قبل عرضها.";
                }
            }

            cashBoxes = loadedCashBoxes;
            hasLoadedCashBoxes = true;
            cashBoxOptionsReadFailed = false;

            if (expenseEditorInitialized && dto.PaymentMethod == 1 && cashBoxSelected == 0 && cashBoxes.Any())
            {
                var defaultBox = cashBoxes.FirstOrDefault(box => box.IsDefault) ?? cashBoxes.First();
                cashBoxSelected = defaultBox.CashBoxID;
            }
        }
        catch (UnauthorizedAccessException)
        {
            cashBoxes = new();
            hasLoadedCashBoxes = false;
            cashBoxOptionsReadFailed = false;
            cashBoxOptionsReadDenied = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load cash-box options for the expense editor.");
            cashBoxOptionsReadFailed = true;
        }
        finally
        {
            isLoadingCashBoxOptions = false;
        }
    }

    private Task RetryBankAccountOptionsAsync() => LoadBankAccountOptionsAsync();

    private async Task LoadBankAccountOptionsAsync()
    {
        if (isLoadingBankAccounts) return;

        isLoadingBankAccounts = true;
        bankAccountOptionsReadDenied = false;
        try
        {
            var loadedBankAccounts = await TreasuryService.GetBankAccountLookupsAsync();
            bankAccounts = loadedBankAccounts;
            hasLoadedBankAccounts = true;
            bankAccountOptionsReadFailed = false;
        }
        catch (UnauthorizedAccessException)
        {
            bankAccounts = new();
            hasLoadedBankAccounts = false;
            bankAccountOptionsReadFailed = false;
            bankAccountOptionsReadDenied = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load bank-account options for the expense editor.");
            bankAccountOptionsReadFailed = true;
        }
        finally
        {
            isLoadingBankAccounts = false;
        }
    }

    private Task RetryExpenseDetailLoadAsync() => LoadExpenseDetailAsync();

    private async Task LoadExpenseDetailAsync()
    {
        if (Id == 0 || isLoadingExpenseDetail) return;

        isLoadingExpenseDetail = true;
        expenseDetailReadDenied = false;
        try
        {
            var existing = await AccountingService.GetExpenseByIdAsync(Id);
            if (existing is null)
            {
                expenseDetailReadFailed = false;
                expenseDetailNotFound = true;
                return;
            }

            dto = existing;
            fiscalYearSelected = dto.FiscalYearID ?? 0;
            creditSelected = dto.CreditAccountID ?? 0;
            costCenterSelected = dto.CostCenterID ?? 0;
            cashBoxSelected = dto.CashBoxID ?? 0;
            bankAccountSelected = dto.BankAccountID ?? 0;
            expenseDetailReadFailed = false;
            expenseDetailReadDenied = false;
            expenseDetailNotFound = false;
            FilterPeriods();
            if (dto.PeriodID == 0 && filteredPeriods.Any())
                dto.PeriodID = filteredPeriods.First().PeriodID;
            expenseEditorInitialized = true;
        }
        catch (UnauthorizedAccessException)
        {
            expenseDetailReadFailed = false;
            expenseDetailNotFound = false;
            expenseDetailReadDenied = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load expense {ExpenseID} for editing.", Id);
            expenseDetailReadFailed = true;
            expenseDetailReadDenied = false;
            expenseDetailNotFound = false;
        }
        finally
        {
            isLoadingExpenseDetail = false;
        }
    }

    private Task RetryCashBoxBalanceLoadAsync() => LoadCashBoxBalanceOptionsAsync();

    private async Task LoadCashBoxBalanceOptionsAsync()
    {
        if (!CanReadCashBoxBalances || isLoadingCashBoxBalances) return;

        isLoadingCashBoxBalances = true;
        cashBalanceReadDenied = false;
        try
        {
            var loadedBalances = await TreasuryService.GetCashBoxBalanceLookupsAsync();
            var balancesById = loadedBalances.ToDictionary(x => x.CashBoxID, x => x.CurrentBalance);
            if (cashBoxes.Any(box => !balancesById.ContainsKey(box.CashBoxID)))
            {
                Logger.LogWarning("The cash-box balance lookup omitted one or more available cash boxes; balances were not applied.");
                cashBalanceReadFailed = true;
                cashBalanceLoadMessage = hasLoadedCashBoxBalances
                    ? "تعذر تحديث بعض الأرصدة؛ المعروض آخر تحميل ناجح."
                    : "تعذر تحميل أرصدة جميع الخزائن؛ لم يُعرض صفر افتراضي بدلاً منه.";
                return;
            }

            foreach (var box in cashBoxes)
                if (balancesById.TryGetValue(box.CashBoxID, out var balance)) box.CurrentBalance = balance;
            canViewCashBoxBalances = true;
            hasLoadedCashBoxBalances = true;
            cashBalanceReadFailed = false;
            cashBalanceReadDenied = false;
            cashBalanceLoadMessage = "";
        }
        catch (UnauthorizedAccessException)
        {
            canViewCashBoxBalances = false;
            cashBalanceReadFailed = false;
            cashBalanceReadDenied = true;
            cashBalanceLoadMessage = "";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load actual cash-box balances for the expense editor.");
            cashBalanceReadFailed = true;
            cashBalanceReadDenied = false;
            cashBalanceLoadMessage = hasLoadedCashBoxBalances
                ? "تعذر تحديث الرصيد الفعلي؛ المعروض آخر تحميل ناجح."
                : "تعذر تحميل الرصيد الفعلي؛ لم يُعرض صفر افتراضي بدلاً منه.";
        }
        finally
        {
            isLoadingCashBoxBalances = false;
        }
    }

    private Task RetryFiscalYearOptionsAsync() => LoadFiscalYearOptionsAsync();

    private async Task LoadFiscalYearOptionsAsync()
    {
        if (isLoadingFiscalYearOptions) return;

        isLoadingFiscalYearOptions = true;
        fiscalYearOptionsReadDenied = false;
        try
        {
            var loadedFiscalYears = await AccountingService.GetFiscalYearsForExpenseEditAsync();
            fiscalYears = loadedFiscalYears;
            hasLoadedFiscalYearOptions = true;
            fiscalYearOptionsReadFailed = false;

            if (expenseEditorInitialized)
            {
                if (Id == 0)
                    OnDateChanged();
                else
                    FilterPeriods();
            }
        }
        catch (UnauthorizedAccessException)
        {
            fiscalYears = new();
            hasLoadedFiscalYearOptions = false;
            fiscalYearOptionsReadFailed = false;
            fiscalYearOptionsReadDenied = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load fiscal-year options for the expense editor.");
            fiscalYearOptionsReadFailed = true;
        }
        finally
        {
            isLoadingFiscalYearOptions = false;
        }
    }

    private Task RetryAccountingPeriodOptionsAsync() => LoadAccountingPeriodOptionsAsync();

    private async Task LoadAccountingPeriodOptionsAsync()
    {
        if (isLoadingAccountingPeriods) return;

        isLoadingAccountingPeriods = true;
        accountingPeriodsReadDenied = false;
        try
        {
            var loadedPeriods = await AccountingService.GetAccountingPeriodsForExpenseEditAsync();
            allPeriods = loadedPeriods;
            hasLoadedAccountingPeriods = true;
            accountingPeriodsReadFailed = false;

            if (expenseEditorInitialized)
            {
                if (Id == 0)
                    OnDateChanged();
                else
                    FilterPeriods();

                if (dto.PeriodID == 0 && filteredPeriods.Any())
                    dto.PeriodID = filteredPeriods.First().PeriodID;
            }
        }
        catch (UnauthorizedAccessException)
        {
            allPeriods = new();
            filteredPeriods = new();
            hasLoadedAccountingPeriods = false;
            accountingPeriodsReadFailed = false;
            accountingPeriodsReadDenied = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load accounting-period options for the expense editor.");
            accountingPeriodsReadFailed = true;
        }
        finally
        {
            isLoadingAccountingPeriods = false;
        }
    }

    private void OnDateChanged()
    {
        var period = allPeriods.FirstOrDefault(p => dto.ExpenseDate >= p.StartDate && dto.ExpenseDate <= p.EndDate);
        if (period != null)
        {
            dto.PeriodID = period.PeriodID;
            dto.FiscalYearID = period.FiscalYearID;
            fiscalYearSelected = period.FiscalYearID;
        }
        else
        {
            var fy = fiscalYears.FirstOrDefault(f => dto.ExpenseDate >= f.StartDate && dto.ExpenseDate <= f.EndDate);
            if (fy != null)
            {
                dto.FiscalYearID = fy.FiscalYearID;
                fiscalYearSelected = fy.FiscalYearID;
            }
        }
        FilterPeriods();
    }

    private void OnFiscalYearChanged()
    {
        dto.FiscalYearID = fiscalYearSelected == 0 ? null : fiscalYearSelected;
        FilterPeriods();
        if (fiscalYearSelected != 0 && !filteredPeriods.Any(p => p.PeriodID == dto.PeriodID))
            dto.PeriodID = 0;
    }

    private void FilterPeriods()
    {
        if (fiscalYearSelected != 0)
            filteredPeriods = allPeriods.Where(p => p.FiscalYearID == fiscalYearSelected).OrderBy(p => p.PeriodNumber).ToList();
        else
            filteredPeriods = allPeriods.OrderByDescending(p => p.StartDate).Take(24).OrderBy(p => p.StartDate).ToList();
    }

    private void OnPaymentMethodChanged()
    {
        if (dto.PaymentMethod != 1) cashBoxSelected = 0;
        if (dto.PaymentMethod != 2) bankAccountSelected = 0;
        if (dto.PaymentMethod != 3) creditSelected = 0;
    }

    private async Task Save()
    {
        if (!CanUseExpenseEditor) return;

        if (!dto.PaymentMethod.HasValue || dto.PaymentMethod.Value < 1 || dto.PaymentMethod.Value > 3)
        {
            msg = "اختر طريقة دفع صحيحة للمصروف"; isError = true; return;
        }
        var paymentMethod = dto.PaymentMethod.Value;
        dto.FiscalYearID = fiscalYearSelected == 0 ? null : fiscalYearSelected;
        dto.CostCenterID = costCenterSelected == 0 ? null : costCenterSelected;

        if (dto.PeriodID == 0) { msg = "يجب اختيار الفترة المحاسبية"; isError = true; return; }
        if (dto.AccountID == 0 || !expenseAccounts.Any(a => a.AccountID == dto.AccountID)) { msg = "اختر حساب مصروف نشطًا وتفصيليًا"; isError = true; return; }
        if (dto.Amount <= 0) { msg = "المبلغ يجب أن يكون أكبر من صفر"; isError = true; return; }
        if (string.IsNullOrWhiteSpace(dto.Description)) { msg = "أدخل بيان المصروف"; isError = true; return; }

        if (paymentMethod == 1)
        {
            if (cashBoxSelected == 0)
            {
                var defaultBox = cashBoxes.FirstOrDefault(c => c.IsDefault) ?? cashBoxes.FirstOrDefault();
                if (defaultBox != null) cashBoxSelected = defaultBox.CashBoxID;
            }
            if (cashBoxSelected == 0) { msg = "اختر خزينة نشطة لمصدر الدفع"; isError = true; return; }
            dto.CashBoxID = cashBoxSelected;
            dto.BankAccountID = null;
            dto.CreditAccountID = null;
        }
        else if (paymentMethod == 2)
        {
            if (bankAccountSelected == 0 || !bankAccounts.Any(b => b.BankAccountID == bankAccountSelected)) { msg = "اختر حسابًا بنكيًا نشطًا لمصدر الدفع"; isError = true; return; }
            dto.CashBoxID = null;
            dto.BankAccountID = bankAccountSelected;
            dto.CreditAccountID = null;
        }
        else if (paymentMethod == 3)
        {
            if (creditSelected == 0 || !creditAccounts.Any(a => a.AccountID == creditSelected)) { msg = "اختر حساب التزام نشطًا وتفصيليًا للدفع الآجل"; isError = true; return; }
            dto.CashBoxID = null;
            dto.BankAccountID = null;
            dto.CreditAccountID = creditSelected;
        }
        else
        {
            msg = "طريقة الدفع غير صحيحة"; isError = true; return;
        }

        isSaving = true; msg = ""; StateHasChanged();
        try
        {
            if (Id == 0)
            {
                var newId = await AccountingService.InsertExpenseAsync(dto, UserSession.UserID);
                Navigation.NavigateTo("/expenses");
            }
            else
            {
                await AccountingService.UpdateExpenseAsync(dto, UserSession.UserID);
                msg = "تم تحديث المصروف "; isError = false;
            }
        }
        catch (Exception ex) { msg = ex.Message; isError = true; }
        finally { isSaving = false; }
    }

    private void ViewJournal()
    {
        if (dto.JournalID.HasValue)
            Navigation.NavigateTo($"/journal-entries/{dto.JournalID.Value}");
    }

    private string GetAccountName(int id) => allAccounts.FirstOrDefault(a => a.AccountID == id)?.AccountNameAr ?? "— اختر حساب —";
    private string GetCreditAccountName(int id) => allAccounts.FirstOrDefault(a => a.AccountID == id)?.AccountNameAr ?? "";
    private string GetCostCenterName(int id) => costCenters.FirstOrDefault(c => c.CostCenterID == id)?.CostCenterNameAr ?? "";
    private string GetPeriodName(int id) => allPeriods.FirstOrDefault(p => p.PeriodID == id)?.PeriodName ?? "—";
    private string GetCashBoxOptionLabel(CashBoxListDto box) => canViewCashBoxBalances
        ? $"{box.CashBoxNameAr} - رصيد: {box.CurrentBalance:#,##0.00}"
        : $"{box.CashBoxNameAr} - الرصيد غير متاح";

    private string GetCreditPreviewName() => dto.PaymentMethod switch
    {
        1 => cashBoxes.FirstOrDefault(c => c.CashBoxID == cashBoxSelected)?.CashBoxNameAr ?? "اختر الخزينة",
        2 => bankAccounts.FirstOrDefault(b => b.BankAccountID == bankAccountSelected) is { } bank
            ? $"{bank.BankName} - {bank.AccountNumber}" : "اختر الحساب البنكي",
        3 => creditSelected == 0 ? "اختر حساب الالتزام" : GetCreditAccountName(creditSelected),
        _ => "مصدر دفع غير محدد"
    };
}
