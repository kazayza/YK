@page "/currencies"

@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject CurrencyService CurService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>العملات - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{ <div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div> }
else if (perms == null || !perms.CanView)
{ <div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div> }
else
{
    <div class="luxury-page" dir="rtl">

        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">العملات وأسعار الصرف</h2><p class="lh-subtitle">إدارة العملات وأسعار الصرف - تحديث تلقائي مع السوق</p></div>
                </div>
                <div class="lh-actions">
                    <span class="lh-badge"><span class="lh-dot"></span>@filtered.Count عملة</span>
                    @if (perms.CanExport)
                    {
                        <button class="btn-luxury btn-export-luxury" @onclick="ExportToExcel" disabled="@isExporting">
                            @if (isExporting){<div class="btn-spinner-sm"></div><span>جاري...</span>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg><span>تصدير</span>}
                        </button>
                    }
                    @if (perms.CanAdd){ <button class="btn-luxury btn-primary-luxury" @onclick="ShowAdd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>عملة جديدة</button> }
                </div>
            </div>
        </div>

        <div class="stats-luxury">
            <div class="stat-luxury"><div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@currencies.Count</span><span class="st-label">إجمالي العملات</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div class="st-info"><span class="st-value">@currencies.Count(c => c.IsActive)</span><span class="st-label">نشطة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div><div class="st-info"><span class="st-value">@currencies.Count(c => !c.IsActive)</span><span class="st-label">غير نشطة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></div><div class="st-info"><span class="st-value">@currencies.Count(c => c.IsDefault)</span><span class="st-label">افتراضية</span></div><div class="st-gold-line"></div></div>
        </div>

        <!-- RATES CARDS LUXURY GOLD -->
        @if (currencies.Any(x => x.IsActive))
        {
            <div class="rates-luxury">
                @foreach (var c in currencies.Where(x => x.IsActive).Take(8))
                {
                    <div class="rate-card-luxury @(c.IsDefault ? "default" : "")">
                        <div class="rc-gold-line"></div>
                        <div class="rc-top">
                            <div class="rc-flag">
                                @if (c.CurrencyCode == "EGP"){<span>🇪🇬</span>}
                                else if (c.CurrencyCode == "USD"){<span>🇺🇸</span>}
                                else if (c.CurrencyCode == "EUR"){<span>🇪🇺</span>}
                                else if (c.CurrencyCode == "SAR"){<span>🇸🇦</span>}
                                else if (c.CurrencyCode == "AED"){<span>🇦🇪</span>}
                                else{<span>@c.Symbol</span>}
                            </div>
                            <div class="rc-info"><strong>@c.CurrencyNameAr</strong><code>@c.CurrencyCode</code></div>
                            @if (c.IsDefault){<span class="rc-badge">افتراضية</span>}
                        </div>
                        <div class="rc-rate">@c.ExchangeRate.ToString("#,##0.######")<span class="rc-symbol">@c.Symbol</span></div>
                        <div class="rc-footer">
                            <span class="rc-status"><span class="dot green"></span>نشط</span>
                            <span class="rc-en">@c.CurrencyNameEn</span>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="filter-luxury">
            <div class="search-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="بحث بالاسم أو الكود..." @bind="searchText" @bind:event="oninput" @bind:after="ApplyFilter" />
                @if (!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick='() => { searchText = ""; ApplyFilter(); }'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}
            </div>
            <div class="select-wrap-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M7 12h10"/><path d="M10 18h4"/></svg>
                <select @bind="statusFilter" @bind:after="ApplyFilter">
                    <option value="all">الكل</option>
                    <option value="active">نشطة فقط</option>
                    <option value="inactive">غير نشطة فقط</option>
                </select>
                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        @if (currencies == null)
        { <div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل العملات...</p></div> }
        else if (!filtered.Any())
        { <div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><h4>لا توجد عملات</h4></div> }
        else
        {
            <div class="table-card-luxury">
                <div class="table-responsive">
                    <table class="table-luxury">
                        <thead><tr><th class="th-num">#</th><th>الكود</th><th>الاسم عربي</th><th>الاسم إنجليزي</th><th>الرمز</th><th class="th-center">سعر الصرف</th><th class="th-center">افتراضية</th><th class="th-center">الحالة</th>@if (perms.CanEdit || perms.CanDelete){<th class="th-actions">إجراءات</th>}</tr></thead>
                        <tbody>
                            @{int n=0;}
                            @foreach (var c in filtered){n++;
                                <tr class="@(c.IsDefault?"row-gold":"")">
                                    <td class="td-num">@n</td>
                                    <td><span class="code-luxury">@c.CurrencyCode</span></td>
                                    <td class="td-name"><div class="cur-name-wrap"><span class="cur-flag-sm">@c.Symbol</span><strong>@c.CurrencyNameAr</strong></div></td>
                                    <td class="td-muted">@(c.CurrencyNameEn ?? "—")</td>
                                    <td><span class="sym-badge-luxury">@c.Symbol</span></td>
                                    <td class="td-center"><span class="rate-val-luxury">@c.ExchangeRate.ToString("#,##0.######")</span></td>
                                    <td class="td-center">@if(c.IsDefault){<span class="default-star"><svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>}else{<span class="no-val">—</span>}</td>
                                    <td class="td-center"><span class="status-dot-luxury @(c.IsActive?"green":"red")"></span><span class="status-text-luxury">@(c.IsActive?"نشط":"غير نشط")</span></td>
                                    @if (perms.CanEdit || perms.CanDelete){
                                        <td class="td-actions"><div class="actions-wrap-luxury">
                                            @if (perms.CanEdit){<button class="act-btn edit" @onclick="() => ShowEdit(c)" title="تعديل"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                            @if (!c.IsActive && perms.CanEdit){<button class="act-btn activate" @onclick="() => ActivateCurrency(c)" title="تفعيل"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></button>}
                                            @if (perms.CanDelete && !c.IsDefault && c.IsActive){<button class="act-btn delete" @onclick="() => ShowDel(c)" title="تعطيل"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></button>}
                                        </div></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    @if (showForm)
    {
        <div class="modal-overlay-luxury" @onclick="() => showForm=false">
            <div class="modal-card-luxury" @onclick:stopPropagation="true">
                <div class="ml-gold-line"></div>
                <div class="ml-header">
                    <div class="ml-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                    <div class="ml-text"><h3>@(editItem.CurrencyID==0?"إضافة عملة":"تعديل عملة")</h3><p>@(editItem.CurrencyID==0?"أدخل بيانات العملة الجديدة":"تحديث بيانات العملة")</p></div>
                    <button class="ml-close" @onclick="() => showForm=false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>
                </div>
                <div class="ml-body">
                    <div class="form-grid-luxury cols-2">
                        <div class="field-luxury"><label class="fl-label required">كود العملة</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6"/><path d="M9 15h6"/></svg><input type="text" @bind="editItem.CurrencyCode" placeholder="EGP, USD..." maxlength="10" dir="ltr" /></div><span class="fl-hint">ISO 4217 - 3 حروف</span></div>
                        <div class="field-luxury"><label class="fl-label">الرمز</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><input type="text" @bind="editItem.Symbol" placeholder="ج.م, $, €..." maxlength="10" /></div></div>
                    </div>
                    <div class="form-grid-luxury cols-2">
                        <div class="field-luxury"><label class="fl-label required">الاسم (عربي)</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" @bind="editItem.CurrencyNameAr" placeholder="جنيه مصري..." /></div></div>
                        <div class="field-luxury"><label class="fl-label">الاسم (إنجليزي)</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" @bind="editItem.CurrencyNameEn" placeholder="Egyptian Pound..." dir="ltr" /></div></div>
                    </div>
                    <div class="form-grid-luxury cols-2">
                        <div class="field-luxury"><label class="fl-label required">سعر الصرف</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg><input type="number" @bind="editItem.ExchangeRate" step="0.000001" placeholder="1.000000" /></div><span class="fl-hint">مقابل العملة الافتراضية</span></div>
                        <div class="field-luxury"><label class="fl-label">عملة افتراضية</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><select @bind="editItem.IsDefault"><option value="false">لا</option><option value="true">نعم - افتراضية</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                    </div>

                    <div class="preview-card-luxury">
                        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>معاينة العملة</h4>
                        <div class="pc-body">
                            <span class="code-luxury">@(string.IsNullOrWhiteSpace(editItem.CurrencyCode)?"CODE":editItem.CurrencyCode)</span>
                            <strong>@(string.IsNullOrWhiteSpace(editItem.CurrencyNameAr)?"اسم العملة":editItem.CurrencyNameAr)</strong>
                            <span class="sym-badge-luxury">@(string.IsNullOrWhiteSpace(editItem.Symbol)?"$":editItem.Symbol)</span>
                            <span class="rate-val-luxury">@editItem.ExchangeRate.ToString("#,##0.######")</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(formMsg)){<div class="msg-luxury msg-error">@formMsg</div>}
                </div>
                <div class="ml-footer">
                    <button class="btn-luxury btn-primary-luxury" @onclick="Save" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}حفظ</button>
                    <button class="btn-luxury btn-ghost-luxury" @onclick="() => showForm=false">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (showDelete)
    {
        <div class="modal-overlay-luxury" @onclick="() => showDelete=false">
            <div class="modal-card-luxury small" @onclick:stopPropagation="true">
                <div class="ml-gold-line danger"></div>
                <div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div>
                <h4>تعطيل العملة</h4>
                <p>هل تريد تعطيل العملة: <strong class="delete-name">@deleteItem?.CurrencyNameAr</strong>؟</p>
                <p class="delete-hint">سيتم إيقاف تنشيط العملة فقط، ويمكن تفعيلها لاحقاً</p>
                @if (!string.IsNullOrEmpty(delMsg)){<div class="msg-luxury msg-error">@delMsg</div>}
                <div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDelete" disabled="@isDeleting">@if(isDeleting){<div class="btn-spinner-sm"></div>}تعطيل</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showDelete=false">إلغاء</button></div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast=""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.2rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.74rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-luxury:disabled{opacity:.6;cursor:not-allowed}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-primary-luxury:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(212,175,55,.35)}.btn-export-luxury{background:linear-gradient(135deg,#059669,#10b981);color:#fff}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-ghost-luxury:hover{background:#fcfaf6;border-color:var(--gold)}.btn-danger-luxury{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}.btn-luxury svg{width:14px;height:14px}.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
.st-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.st-icon.dark{background:linear-gradient(135deg,var(--black2),var(--black3));color:var(--gold);border:1px solid var(--border-gold)}.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.st-icon.red{background:#fef2f2;color:#ef4444;border:1px solid #fecaca}.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.15)}.st-icon svg{width:18px;height:18px}.st-info{display:flex;flex-direction:column}.st-value{font-size:1.2rem;font-weight:900;color:#0A0F1E;line-height:1}.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}.st-gold-line{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}.stat-luxury:hover .st-gold-line{opacity:.8}
