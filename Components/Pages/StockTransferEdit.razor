    @@media(max-width:768px){.c4,.c3{grid-template-columns:1fr}.f-field.c3{grid-column:span 1}.doc-header{flex-direction:column}.approval-bar{flex-direction:column}}
</style>

@code {
    [Parameter] public int TransferId { get; set; }

    private StockTransferHeaderDto header = new() { TransferDate = DateTime.Today };
    private List<StockTransferDetailDto> details = new();
    private ModulePermissionDto? permissions;
    private List<LookupDto>? warehouses, employees, units;
    private List<SearchableItem>? allItems;
    private List<SearchableItem>? warehouseItems;
    private bool isLoading = true, isSaving = false;
    private string toast = ""; private bool toastOk = true;
    private bool showLineForm = false;
    private StockTransferDetailEditDto editLine = new();
    private bool isSavingLine = false;
    private string lineMsg = ""; private bool lineMsgOk = true;

    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => TransferId == 0;
    private bool canApprove => !isNewMode && !isViewMode && header.TransferStatus == 1 && details.Any() && (permissions?.CanApprove ?? false);
    private bool isReadOnly => isViewMode || (!isNewMode && header.TransferStatus != 1);
    private string pageTitle => isNewMode ? "تحويل مخزني جديد" : isViewMode ? "عرض تحويل" : canApprove ? "اعتماد تحويل" : "تعديل تحويل";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
            if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_TRANSFER");
            if (permissions == null || !permissions.CanView) return;
            warehouses = await LookupService.GetWarehousesAsync();
            employees = await LookupService.GetEmployeesAsync();
            units = await LookupService.GetUnitsAsync();
            allItems = await LookupService.GetItemsSearchableAsync();
            if (TransferId > 0)
            {
                var loaded = await InvService.GetTransferByIdAsync(TransferId);
                if (loaded != null) { header = loaded; details = await InvService.GetTransferDetailsAsync(TransferId); }
                else { toast = "التحويل غير موجود"; toastOk = false; }
            }
            if (header.FromWarehouseID > 0)
    warehouseItems = await LookupService.GetWarehouseItemsSearchableAsync(header.FromWarehouseID);
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task OnItemSelected(SearchableItem? item)
    {
        if (item == null) return; editLine.ItemID = item.Id;
        var info = await LookupService.GetItemQuickInfoAsync(item.Id);
        if (info != null && info.UnitID > 0) editLine.UnitID = info.UnitID;
        StateHasChanged();
    }
    private async Task OnFromWarehouseChanged()
{
    if (header.FromWarehouseID > 0)
        warehouseItems = await LookupService.GetWarehouseItemsSearchableAsync(header.FromWarehouseID);
    else
        warehouseItems = null;
    StateHasChanged();
}

    private async Task SaveTransfer()
    {
        if (header.FromWarehouseID <= 0) { toast = "اختر المخزن المصدر"; toastOk = false; StateHasChanged(); return; }
        if (header.ToWarehouseID <= 0) { toast = "اختر المخزن المستقبل"; toastOk = false; StateHasChanged(); return; }
        if (header.FromWarehouseID == header.ToWarehouseID) { toast = "المخزن المصدر لازم يختلف عن المستقبل"; toastOk = false; StateHasChanged(); return; }

        isSaving = true; StateHasChanged();
        try
        {
            if (isNewMode)
            {
                header.TransferNumber = await InvService.GenerateTransferNumberAsync();
                var newId = await InvService.InsertTransferAsync(header, UserSession.UserID);
                TransferId = newId; header.TransferID = newId;
                toast = $"تم الإنشاء: {header.TransferNumber} ✅"; toastOk = true;
                Navigation.NavigateTo($"/stock-transfers/edit/{newId}", forceLoad: false);
            }
            else
            {
                await InvService.UpdateTransferAsync(header, UserSession.UserID);
                toast = "تم الحفظ ✅"; toastOk = true;
            }
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task ExecuteApprove()
    {
        try { var c = await JS.InvokeAsync<bool>("confirm", "هل تريد اعتماد وتنفيذ التحويل؟\n\nسيتم نقل الأصناف من المخزن المصدر إلى المستقبل."); if (!c) return; } catch { return; }
        isSaving = true; toast = ""; StateHasChanged();
        try
        {
            await InvService.ApproveAndExecuteTransferAsync(TransferId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            header = await InvService.GetTransferByIdAsync(TransferId) ?? header;
            details = await InvService.GetTransferDetailsAsync(TransferId);
            isSaving = false; toast = "تم الاعتماد والتنفيذ ✅"; toastOk = true; StateHasChanged();
            await Task.Delay(2000); Navigation.NavigateTo("/stock-transfers");
        }
        catch (Exception ex) { isSaving = false; toast = "خطأ: " + ex.Message; toastOk = false; StateHasChanged(); }
    }

    private void ShowAddLine() { editLine = new() { TransferID = TransferId }; lineMsg = ""; showLineForm = true; }

    private async Task SaveLine()
    {
        lineMsg = "";
        if (editLine.ItemID == 0) { lineMsg = "اختر الصنف"; lineMsgOk = false; return; }
        if (editLine.UnitID == 0) { lineMsg = "اختر الوحدة"; lineMsgOk = false; return; }
        if (editLine.Quantity <= 0) { lineMsg = "أدخل الكمية"; lineMsgOk = false; return; }

        if (isNewMode && TransferId == 0) { await SaveTransfer(); if (TransferId == 0) return; editLine.TransferID = TransferId; }

        isSavingLine = true; StateHasChanged();
        try
        {
            await InvService.InsertTransferDetailAsync(editLine, UserSession.UserID);
            details = await InvService.GetTransferDetailsAsync(TransferId);
            showLineForm = false; toast = "تم الإضافة ✅"; toastOk = true;
        }
        catch (Exception ex) { lineMsg = "خطأ: " + ex.Message; lineMsgOk = false; }
        finally { isSavingLine = false; StateHasChanged(); }
    }

    private async Task DeleteLine(int id)
    {
        try { await InvService.DeleteTransferDetailAsync(id, UserSession.UserID);
            details = await InvService.GetTransferDetailsAsync(TransferId); toast = "تم الحذف ✅"; toastOk = true; }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        StateHasChanged();
    }

    private void GoBack() => Navigation.NavigateTo("/stock-transfers");
}

