@page "/stock-transfers/new"
@page "/stock-transfers/edit/{TransferId:int}"
@page "/stock-transfers/view/{TransferId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject InventoryService InvService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div>}
else
{
    <div class="luxury-doc-page" dir="rtl">
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <button class="btn-luxury btn-back-luxury" @onclick="GoBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19 7-7-7-7"/></svg>رجوع</button>
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">@pageTitle</h2><div class="lh-meta">@if (!string.IsNullOrEmpty(header.TransferNumber)){<code class="doc-num-luxury">@header.TransferNumber</code><span class="status-badge-luxury" style="--sc:@InventoryService.GetTransferStatusColor(header.TransferStatus)">@InventoryService.GetTransferStatusName(header.TransferStatus)</span>}</div></div>
                </div>
                <div class="lh-actions">
                    <div class="workflow-mini"><span class="wm-dot">رصيد</span><span class="wm-line"></span><span class="wm-dot active">تحويل</span><span class="wm-line"></span><span class="wm-dot">جرد</span><span class="wm-line"></span><span class="wm-dot">حركة</span></div>
                </div>
            </div>
        </div>

        @if (canApprove)
        {
            <div class="approval-bar-luxury"><div class="ml-gold-line green"></div><div class="appr-left"><div class="appr-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 3h5v5"/><path d="M4 8a2 2 0 0 0 0 4h8"/><path d="M8 21H3v-5"/><path d="M20 16a2 2 0 0 1 0 4h-8"/></svg></div><div><div class="appr-title">تحويل مخزني جاهز للاعتماد والتنفيذ</div><div class="appr-sub">سيتم نقل الأصناف من @header.FromWarehouseID إلى @header.ToWarehouseID</div></div></div><div class="appr-actions"><button class="btn-luxury btn-approve-quick" @onclick="ExecuteApprove" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg>}اعتماد وتنفيذ</button></div></div>
        }

        @if (isLoading){<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else
        {
            <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/><path d="M3 9V7a2 2 0 0 1 2-2h2"/><path d="M19 9V7a2 2 0 0 0-2-2h-2"/></svg></div><h3 class="sec-title-luxury">بيانات التحويل</h3></div>
                <div class="form-grid-luxury c4">
                    <div class="f-field-luxury"><label class="f-label-luxury">الرقم</label><input type="text" class="f-input-luxury readonly" value="@(header.TransferNumber ?? "تلقائي")" disabled /></div>
                    <div class="f-field-luxury"><label class="f-label-luxury required">التاريخ</label><input type="date" class="f-input-luxury" @bind="header.TransferDate" disabled="@isReadOnly" /></div>
                    <div class="f-field-luxury"><label class="f-label-luxury required">من مخزن</label><select class="f-input-luxury" @bind="header.FromWarehouseID" @bind:after="OnFromWarehouseChanged" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (warehouses != null){@foreach (var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select></div>
                    <div class="f-field-luxury"><label class="f-label-luxury required">إلى مخزن</label><select class="f-input-luxury" @bind="header.ToWarehouseID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (warehouses != null){@foreach (var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select></div>
                    <div class="f-field-luxury"><label class="f-label-luxury">الطالب</label><select class="f-input-luxury" @bind="header.RequestedBy" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (employees != null){@foreach (var e in employees){<option value="@e.Id">@e.Name</option>}}</select></div>
                    <div class="f-field-luxury c3"><label class="f-label-luxury">السبب / الملاحظات</label><input type="text" class="f-input-luxury" @bind="header.TransferReason" disabled="@isReadOnly" placeholder="سبب التحويل..." /></div>
                </div>
            </div>

            @if (TransferId > 0 || header.FromWarehouseID > 0)
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><h3 class="sec-title-luxury">الأصناف</h3><span class="sec-badge-luxury">@details.Count صنف</span><span class="total-mini-luxury">@details.Sum(d=>d.TotalCost).ToString("#,##0.00") ج.م</span>
                    @if (!isReadOnly && permissions.CanAdd){<button class="btn-luxury btn-primary-luxury btn-sm-luxury" style="margin-right:auto;" @onclick="ShowAddLine"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة</button>}
                </div>
                    @if (!details.Any() && !showLineForm){<div class="empty-lines-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><p>لا توجد أصناف</p></div>}
                    else
                    {
                        <div class="tbl-card-luxury"><div class="table-responsive"><table class="tbl-luxury"><thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="tc">الكمية</th><th class="tl">التكلفة</th><th class="tl">الإجمالي</th><th>الباتش</th><th class="tc">المتاح</th>@if (!isReadOnly){<th class="tc">إجراءات</th>}</tr></thead><tbody>@{int n=0;}@foreach (var d in details){n++;<tr><td class="td-n">@n</td><td><code class="code-tag-luxury">@d.ItemCode</code></td><td class="td-bold">@d.ItemNameAr</td><td class="td-muted">@d.UnitName</td><td class="tc num-cell">@d.Quantity.ToString("#,##0.##")</td><td class="tl num-cell">@d.UnitCost.ToString("#,##0.00")</td><td class="tl num-cell"><strong>@d.TotalCost.ToString("#,##0.00")</strong></td><td class="td-muted">@(d.BatchNumber ?? "—")</td><td class="tc">@d.AvailableQty.ToString("#,##0.##")</td>@if (!isReadOnly){<td class="tc"><div class="line-actions-luxury">@if (permissions.CanDelete){<button class="act-btn-luxury del" @onclick="() => DeleteLine(d.TransferDetailID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}</div></td>}</tr>}</tbody><tfoot><tr class="total-row-luxury"><td colspan="6" class="tl"><strong>الإجمالي</strong></td><td class="tl num-cell"><strong>@details.Sum(d => d.TotalCost).ToString("#,##0.00") ج.م</strong></td><td colspan="@(!isReadOnly ? 3 : 2)"></td></tr></tfoot></table></div></div>
                    }

                    @if (showLineForm)
                    {
                        <div class="line-form-luxury"><div class="ml-gold-line"></div><div class="line-form-head-luxury"><h4>إضافة صنف</h4><button class="btn-close-x-luxury" @onclick="() => showLineForm = false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
                            <div class="form-grid-luxury c3">
                                <div class="f-field-luxury"><label class="f-label-luxury required">الصنف</label><SearchableSelect Items="@(warehouseItems ?? allItems)" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث..." /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">الوحدة</label><select class="f-input-luxury" @bind="editLine.UnitID"><option value="0">--</option>@if (units != null){@foreach (var u in units){<option value="@u.Id">@u.Name</option>}}</select></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">الكمية</label><input type="number" class="f-input-luxury" @bind="editLine.Quantity" step="0.01" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">الباتش</label><input type="text" class="f-input-luxury" @bind="editLine.BatchNumber" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">الصلاحية</label><input type="date" class="f-input-luxury" @bind="editLine.ExpiryDate" /></div>
                            </div>
                            @if (!string.IsNullOrEmpty(lineMsg)){<div class="form-msg-luxury @(lineMsgOk?"ok":"err")">@lineMsg</div>}
                            <div class="line-form-btns-luxury"><button class="btn-luxury btn-primary-luxury" @onclick="SaveLine" disabled="@isSavingLine">@if(isSavingLine){<div class="btn-spinner-sm"></div>}إضافة</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showLineForm = false">إلغاء</button></div>
                        </div>
                    }
                </div>
            }

            @if (!isViewMode && !canApprove)
            {
                <div class="doc-actions-luxury"><div class="ml-gold-line"></div><div class="doc-actions-right">@if (!isReadOnly){<button class="btn-luxury btn-primary-luxury" @onclick="SaveTransfer" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21V13H7v8"/></svg>}@(isNewMode ? "حفظ" : "حفظ التعديلات")</button>}</div><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">رجوع</button></div>
            }
        }
    </div>

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast = ""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--border-gold:rgba(212,175,55,.18)}
.luxury-doc-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1300px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,#121A2E 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25);overflow:hidden}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.15rem;font-weight:900;color:#F5E6C8;margin:0}.lh-meta{display:flex;gap:8px;align-items:center;margin-top:5px;flex-wrap:wrap}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:.2s;font-family:'Tajawal'}.btn-luxury:disabled{opacity:.6}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-back-luxury{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:#F5E6C8}.btn-luxury svg{width:14px;height:14px}.btn-sm-luxury{padding:7px 14px;font-size:.78rem}
.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.doc-num-luxury{background:rgba(212,175,55,.15);border:1px solid rgba(212,175,55,.25);color:var(--gold);padding:4px 10px;border-radius:8px;font-weight:800;font-size:.84rem}.status-badge-luxury{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 18%,rgba(255,255,255,.08));color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,transparent)}.workflow-mini{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);padding:6px 12px;border-radius:999px}.wm-dot{font-size:.66rem;font-weight:700;color:#8B95A5}.wm-dot.active{color:var(--gold)}.wm-line{width:10px;height:1px;background:rgba(255,255,255,.15)}
.approval-bar-luxury{position:relative;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:16px 20px;overflow:hidden;flex-wrap:wrap}.appr-left{display:flex;align-items:center;gap:12px}.appr-icon{width:44px;height:44px;border-radius:12px;background:#ecfdf5;border:1px solid #a7f3d0;display:flex;align-items:center;justify-content:center;color:#059669}.appr-icon svg{width:22px;height:22px}.appr-title{font-weight:800;color:#065f46;font-size:.9rem}.appr-sub{font-size:.76rem;color:#6b7280;margin-top:2px}.appr-actions{display:flex;gap:8px;flex-wrap:wrap}
.doc-section-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:18px;padding:22px;box-shadow:0 4px 16px rgba(0,0,0,.04);overflow:hidden}.sec-head-luxury{display:flex;align-items:center;gap:10px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid #f1efe8;flex-wrap:wrap}.sec-icon-luxury{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center}.sec-icon-luxury.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.sec-icon-luxury.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.sec-icon-luxury svg{width:18px;height:18px}.sec-title-luxury{font-weight:800;color:#0A0F1E;margin:0;font-size:.96rem}.sec-badge-luxury{background:#f1f5f9;color:#475569;padding:4px 12px;border-radius:999px;font-size:.74rem;font-weight:700}.total-mini-luxury{margin-right:auto;background:#fcfaf6;border:1px solid #e8e2d0;padding:4px 10px;border-radius:8px;font-weight:800;font-size:.8rem;color:#0A0F1E}
.form-grid-luxury{display:grid;gap:14px}.c4{grid-template-columns:repeat(4,1fr)}.c3{grid-template-columns:repeat(3,1fr)}.f-field-luxury{display:flex;flex-direction:column;gap:5px}.f-field-luxury.c3{grid-column:span 3}.f-label-luxury{font-size:.78rem;font-weight:700;color:#374151}.required::after{content:' *';color:#ef4444}.f-input-luxury{padding:9px 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.86rem;background:#fff;outline:none;transition:.2s;width:100%;font-family:'Tajawal'}.f-input-luxury:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}.f-input-luxury.readonly,.f-input-luxury:disabled{background:#f8fafc;color:#9ca3af}
.tbl-card-luxury{border:1px solid #e8e2d0;border-radius:14px;overflow:hidden}.tbl-luxury{width:100%;border-collapse:collapse;min-width:900px}.tbl-luxury thead{background:linear-gradient(135deg,#fcfaf6,#f8f6f0)}.tbl-luxury th{padding:11px 12px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e2e2d0;white-space:nowrap}.tbl-luxury td{padding:10px 12px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6}.tbl-luxury tbody tr:hover{background:rgba(212,175,55,.03)}.tc{text-align:center}.tl{text-align:left}.td-n{text-align:center;color:#9ca3af}.td-bold{font-weight:700;color:#0A0F1E}.td-muted{color:#9ca3af}.num-cell{font-family:monospace;font-weight:600}.code-tag-luxury{background:#f1f5f9;padding:2px 8px;border-radius:6px;font-size:.76rem;color:#2563eb;font-weight:600}.total-row-luxury{background:#fcfaf6 !important}.total-row-luxury td{border-top:2px solid #e2e8f0;padding:12px}
.empty-lines-luxury{text-align:center;padding:36px 20px;color:#9ca3af}.empty-icon-luxury{width:52px;height:52px;margin:0 auto 10px;border-radius:12px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.empty-icon-luxury svg{width:26px;height:26px}
.line-actions-luxury{display:flex;gap:4px;justify-content:center}.act-btn-luxury{width:28px;height:28px;border-radius:8px;border:1.5px solid;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:.2s}.act-btn-luxury.del{color:#ef4444;border-color:#fecaca}.act-btn-luxury svg{width:13px;height:13px}
.line-form-luxury{position:relative;margin-top:16px;padding:20px;background:#fcfaf6;border:1px solid #e8e2d0;border-radius:16px;overflow:hidden}.line-form-head-luxury{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.line-form-head-luxury h4{font-weight:800;color:#0A0F1E;margin:0}.btn-close-x-luxury{width:28px;height:28px;border-radius:8px;border:1px solid #e8e2d0;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.btn-close-x-luxury svg{width:12px;height:12px}
.line-form-btns-luxury{display:flex;gap:8px;margin-top:14px}.form-msg-luxury{padding:10px 14px;border-radius:10px;font-size:.82rem;font-weight:600;margin-top:10px}.form-msg-luxury.ok{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}.form-msg-luxury.err{background:#fef2f2;color:#dc2626;border:1px solid #fecaca}
.doc-actions-luxury{position:relative;display:flex;justify-content:space-between;align-items:center;padding:18px 22px;background:#fff;border:1px solid #e8e2d0;border-radius:16px;overflow:hidden}.doc-actions-right{display:flex;gap:10px}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}.no-access-luxury .na-icon{width:64px;height:64px;margin:0 auto 16px;border-radius:16px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.no-access-luxury .na-icon svg{width:32px;height:32px}
.toast-luxury{position:fixed;bottom:20px;left:20px;z-index:1050;animation:toastIn .35s ease}.toast-card-luxury{display:flex;align-items:center;gap:10px;padding:12px 18px;border-radius:14px;min-width:280px;font-weight:600;font-size:.84rem;box-shadow:0 12px 32px rgba(0,0,0,.12)}.toast-card-luxury.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.toast-card-luxury.error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.toast-card-luxury button{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-right:auto}
.ml-gold-line{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent);z-index:2}.ml-gold-line.green{background:linear-gradient(90deg,transparent,#10b981,#059669,transparent)}
@@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@@media(max-width:768px){.c4,.c3{grid-template-columns:1fr}.f-field-luxury.c3{grid-column:span 1}.lh-content{flex-direction:column;align-items:flex-start}.doc-actions-luxury{flex-direction:column;gap:10px}}
</style>

@code {
    [Parameter] public int TransferId { get; set; }

    private StockTransferHeaderDto header = new() { TransferDate = DateTime.Today };
    private List<StockTransferDetailDto> details = new();
    private ModulePermissionDto? permissions;
    private List<LookupDto>? warehouses, employees, units;
    private List<SearchableItem>? allItems;
    private List<SearchableItem>? warehouseItems;
    private bool isLoading = true, isSaving = false;
    private string toast = ""; private bool toastOk = true;
    private bool showLineForm = false;
    private StockTransferDetailEditDto editLine = new();
    private bool isSavingLine = false;
    private string lineMsg = ""; private bool lineMsgOk = true;

    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => TransferId == 0;
    private bool canApprove => !isNewMode && !isViewMode && header.TransferStatus == 1 && details.Any() && (permissions?.CanApprove ?? false);
    private bool isReadOnly => isViewMode || (!isNewMode && header.TransferStatus != 1);
    private string pageTitle => isNewMode ? "تحويل مخزني جديد" : isViewMode ? "عرض تحويل" : canApprove ? "اعتماد تحويل" : "تعديل تحويل";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
            if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_TRANSFER");
            if (permissions == null || !permissions.CanView) return;
            warehouses = await LookupService.GetWarehousesAsync();
            employees = await LookupService.GetEmployeesAsync();
            units = await LookupService.GetUnitsAsync();
            allItems = await LookupService.GetItemsSearchableAsync();
            if (TransferId > 0)
            {
                var loaded = await InvService.GetTransferByIdAsync(TransferId);
                if (loaded != null) { header = loaded; details = await InvService.GetTransferDetailsAsync(TransferId); }
                else { toast = "التحويل غير موجود"; toastOk = false; }
            }
            if (header.FromWarehouseID > 0)
    warehouseItems = await LookupService.GetWarehouseItemsSearchableAsync(header.FromWarehouseID);
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task OnItemSelected(SearchableItem? item)
    {
        if (item == null) return; editLine.ItemID = item.Id;
        var info = await LookupService.GetItemQuickInfoAsync(item.Id);
        if (info != null && info.UnitID > 0) editLine.UnitID = info.UnitID;
        StateHasChanged();
    }
    private async Task OnFromWarehouseChanged()
{
    if (header.FromWarehouseID > 0)
        warehouseItems = await LookupService.GetWarehouseItemsSearchableAsync(header.FromWarehouseID);
    else
        warehouseItems = null;
    StateHasChanged();
}

    private async Task SaveTransfer()
    {
        if (header.FromWarehouseID <= 0) { toast = "اختر المخزن المصدر"; toastOk = false; StateHasChanged(); return; }
        if (header.ToWarehouseID <= 0) { toast = "اختر المخزن المستقبل"; toastOk = false; StateHasChanged(); return; }
        if (header.FromWarehouseID == header.ToWarehouseID) { toast = "المخزن المصدر لازم يختلف عن المستقبل"; toastOk = false; StateHasChanged(); return; }

        isSaving = true; StateHasChanged();
        try
        {
            if (isNewMode)
            {
                header.TransferNumber = await InvService.GenerateTransferNumberAsync();
                var newId = await InvService.InsertTransferAsync(header, UserSession.UserID);
                TransferId = newId; header.TransferID = newId;
                toast = $"تم الإنشاء: {header.TransferNumber} ✅"; toastOk = true;
                Navigation.NavigateTo($"/stock-transfers/edit/{newId}", forceLoad: false);
            }
            else
            {
                await InvService.UpdateTransferAsync(header, UserSession.UserID);
                toast = "تم الحفظ ✅"; toastOk = true;
            }
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task ExecuteApprove()
    {
        try { var c = await JS.InvokeAsync<bool>("confirm", "هل تريد اعتماد وتنفيذ التحويل؟\n\nسيتم نقل الأصناف من المخزن المصدر إلى المستقبل."); if (!c) return; } catch { return; }
        isSaving = true; toast = ""; StateHasChanged();
        try
        {
            await InvService.ApproveAndExecuteTransferAsync(TransferId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            header = await InvService.GetTransferByIdAsync(TransferId) ?? header;
            details = await InvService.GetTransferDetailsAsync(TransferId);
            isSaving = false; toast = "تم الاعتماد والتنفيذ ✅"; toastOk = true; StateHasChanged();
            await Task.Delay(2000); Navigation.NavigateTo("/stock-transfers");
        }
        catch (Exception ex) { isSaving = false; toast = "خطأ: " + ex.Message; toastOk = false; StateHasChanged(); }
    }

    private void ShowAddLine() { editLine = new() { TransferID = TransferId }; lineMsg = ""; showLineForm = true; }

    private async Task SaveLine()
    {
        lineMsg = "";
        if (editLine.ItemID == 0) { lineMsg = "اختر الصنف"; lineMsgOk = false; return; }
        if (editLine.UnitID == 0) { lineMsg = "اختر الوحدة"; lineMsgOk = false; return; }
        if (editLine.Quantity <= 0) { lineMsg = "أدخل الكمية"; lineMsgOk = false; return; }

        if (isNewMode && TransferId == 0) { await SaveTransfer(); if (TransferId == 0) return; editLine.TransferID = TransferId; }

        isSavingLine = true; StateHasChanged();
        try
        {
            await InvService.InsertTransferDetailAsync(editLine, UserSession.UserID);
            details = await InvService.GetTransferDetailsAsync(TransferId);
            showLineForm = false; toast = "تم الإضافة ✅"; toastOk = true;
        }
        catch (Exception ex) { lineMsg = "خطأ: " + ex.Message; lineMsgOk = false; }
        finally { isSavingLine = false; StateHasChanged(); }
    }

    private async Task DeleteLine(int id)
    {
        try { await InvService.DeleteTransferDetailAsync(id, UserSession.UserID);
            details = await InvService.GetTransferDetailsAsync(TransferId); toast = "تم الحذف ✅"; toastOk = true; }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        StateHasChanged();
    }

    private void GoBack() => Navigation.NavigateTo("/stock-transfers");
}
