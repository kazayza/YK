    .empty-lines{text-align:center;padding:30px;color:#94a3b8}.line-actions{display:flex;gap:4px;justify-content:center}.act-btn{width:28px;height:28px;border-radius:7px;border:1px solid #e2e8f0;background:transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.8rem}.act-btn:hover{background:#f8fafc}
    .line-form{margin-top:16px;padding:18px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:14px}.line-form-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.line-form-head h4{font-weight:800;margin:0}.btn-close-x{background:none;border:none;font-size:1.1rem;cursor:pointer;color:#94a3b8}.line-form-btns{display:flex;gap:8px;margin-top:14px}.form-msg{padding:8px 12px;border-radius:8px;font-size:.82rem;font-weight:600;margin-top:10px}.msg-ok{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}.msg-err{background:#fef2f2;color:#dc2626;border:1px solid #fecaca}
    .doc-actions{display:flex;justify-content:space-between;align-items:center;padding:18px 22px;background:white;border:1px solid #e2e8f0;border-radius:16px}.doc-actions-right{display:flex;gap:10px}
    .btn-m{display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:12px;border:none;font-weight:700;font-size:.86rem;cursor:pointer}.btn-m:disabled{opacity:.6}.btn-m.btn-sm{padding:7px 14px;font-size:.82rem}.btn-primary{background:linear-gradient(135deg,#1e40af,#2563eb);color:white}.btn-ghost{background:transparent;color:#64748b;border:1.5px solid #e2e8f0}.btn-spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:white;border-radius:50%;animation:spin .6s linear infinite}
