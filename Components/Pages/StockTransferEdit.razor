@page "/stock-transfers/new"
@page "/stock-transfers/edit/{TransferId:int}"
@page "/stock-transfers/view/{TransferId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject InventoryService InvService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{ <div class="no-access"><div class="na-icon">🔒</div><h4>يجب تسجيل الدخول</h4></div> }
else if (permissions == null || !permissions.CanView)
{ <div class="no-access"><div class="na-icon">⛔</div><h4>ليس لديك صلاحية</h4></div> }
else
{
    <div class="doc-page" dir="rtl">
        <div class="doc-header">
            <div class="doc-header-right">
                <button class="btn-m btn-ghost" @onclick="GoBack">→ رجوع</button>
                <div>
                    <h2 class="doc-title">@pageTitle</h2>
                    @if (!string.IsNullOrEmpty(header.TransferNumber))
                    {
                        <div class="doc-num-wrap">
                            <code class="doc-number">@header.TransferNumber</code>
                            <span class="status-chip" style="--sc:@InventoryService.GetTransferStatusColor(header.TransferStatus)">
                                @InventoryService.GetTransferStatusName(header.TransferStatus)
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (canApprove)
        {
            <div class="approval-bar">
                <span class="approval-label">📦 تحويل مخزني جاهز للاعتماد والتنفيذ</span>
                <button type="button" class="appr-btn appr-quick" @onclick="ExecuteApprove" disabled="@isSaving">
                    @if (isSaving) { <div class="btn-spin"></div> } else { <span>✅</span> }
                    اعتماد وتنفيذ
                </button>
            </div>
        }

        @if (isLoading)
        { <div class="loading-st"><div class="loader"></div></div> }
        else
        {
            <div class="doc-section">
                <div class="sec-head"><div class="sec-icon blue">📦</div><h3 class="sec-title">بيانات التحويل</h3></div>
                <div class="form-grid c4">
                    <div class="f-field"><label class="f-label">الرقم</label>
                        <input type="text" class="f-input" value="@(header.TransferNumber ?? "تلقائي")" disabled /></div>
                    <div class="f-field"><label class="f-label required">التاريخ</label>
                        <input type="date" class="f-input" @bind="header.TransferDate" disabled="@isReadOnly" /></div>
                    <div class="f-field"><label class="f-label required">من مخزن</label>
                        <select class="f-input" @bind="header.FromWarehouseID" @bind:after="OnFromWarehouseChanged" disabled="@isReadOnly">
                            <option value="0">-- اختر --</option>
                            @if (warehouses != null) { @foreach (var w in warehouses) { <option value="@w.Id">@w.Name</option> } }
                        </select></div>
                    <div class="f-field"><label class="f-label required">إلى مخزن</label>
                        <select class="f-input" @bind="header.ToWarehouseID" disabled="@isReadOnly">
                            <option value="0">-- اختر --</option>
                            @if (warehouses != null) { @foreach (var w in warehouses) { <option value="@w.Id">@w.Name</option> } }
                        </select></div>
                    <div class="f-field"><label class="f-label">الطالب</label>
                        <select class="f-input" @bind="header.RequestedBy" disabled="@isReadOnly">
                            <option value="0">-- اختر --</option>
                            @if (employees != null) { @foreach (var e in employees) { <option value="@e.Id">@e.Name</option> } }
                        </select></div>
                    <div class="f-field c3"><label class="f-label">السبب / الملاحظات</label>
                        <input type="text" class="f-input" @bind="header.TransferReason" disabled="@isReadOnly" placeholder="سبب التحويل..." /></div>
                </div>
            </div>

            @if (TransferId > 0 || header.FromWarehouseID > 0)
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon green">📋</div><h3 class="sec-title">الأصناف</h3>
                        <span class="sec-badge">@details.Count صنف</span>
                        @if (!isReadOnly && permissions.CanAdd)
                        { <button class="btn-m btn-primary btn-sm" @onclick="ShowAddLine" style="margin-right:auto;">+ إضافة</button> }
                    </div>

                    @if (!details.Any() && !showLineForm)
                    { <div class="empty-lines"><p>لا توجد أصناف</p></div> }
                    else
                    {
                        <div class="tbl-card"><table class="tbl">
                            <thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>الوحدة</th>
                                <th class="tc">الكمية</th><th class="tl">التكلفة</th><th class="tl">الإجمالي</th>
                                <th>الباتش</th><th class="tc">المتاح</th>
                                @if (!isReadOnly) { <th class="tc">إجراءات</th> }
                            </tr></thead>
                            <tbody>
                                @{ int n = 0; }
                                @foreach (var d in details)
                                {
                                    n++;
                                    <tr>
                                        <td class="td-n">@n</td>
                                        <td><code class="code-tag">@d.ItemCode</code></td>
                                        <td class="td-bold">@d.ItemNameAr</td>
                                        <td>@d.UnitName</td>
                                        <td class="tc num-cell">@d.Quantity.ToString("#,##0.##")</td>
                                        <td class="tl num-cell">@d.UnitCost.ToString("#,##0.00")</td>
                                        <td class="tl num-cell"><strong>@d.TotalCost.ToString("#,##0.00")</strong></td>
                                        <td class="td-muted">@(d.BatchNumber ?? "—")</td>
                                        <td class="tc">@d.AvailableQty.ToString("#,##0.##")</td>
                                        @if (!isReadOnly)
                                        {
                                            <td class="tc"><div class="line-actions">
                                                @if (permissions.CanDelete) { <button class="act-btn" @onclick="() => DeleteLine(d.TransferDetailID)">🗑️</button> }
                                            </div></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot><tr class="total-row">
                                <td colspan="6" class="tl"><strong>الإجمالي</strong></td>
                                <td class="tl num-cell"><strong>@details.Sum(d => d.TotalCost).ToString("#,##0.00") ج.م</strong></td>
                                <td colspan="@(!isReadOnly ? 3 : 2)"></td>
                            </tr></tfoot>
                        </table></div>
                    }

                    @if (showLineForm)
                    {
                        <div class="line-form">
                            <div class="line-form-head"><h4>إضافة صنف</h4><button class="btn-close-x" @onclick="() => showLineForm = false">✕</button></div>
                            <div class="form-grid c3">
                                <div class="f-field"><label class="f-label required">الصنف</label>
                                    <SearchableSelect Items="@(warehouseItems ?? allItems)" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث..." /></div>
                                <div class="f-field"><label class="f-label required">الوحدة</label>
                                    <select class="f-input" @bind="editLine.UnitID"><option value="0">--</option>
                                        @if (units != null) { @foreach (var u in units) { <option value="@u.Id">@u.Name</option> } }</select></div>
                                <div class="f-field"><label class="f-label required">الكمية</label>
                                    <input type="number" class="f-input" @bind="editLine.Quantity" step="0.01" /></div>
                                <div class="f-field"><label class="f-label">الباتش</label>
                                    <input type="text" class="f-input" @bind="editLine.BatchNumber" /></div>
                                <div class="f-field"><label class="f-label">الصلاحية</label>
                                    <input type="date" class="f-input" @bind="editLine.ExpiryDate" /></div>
                            </div>
                            @if (!string.IsNullOrEmpty(lineMsg)) { <div class="form-msg @(lineMsgOk ? "msg-ok" : "msg-err")">@lineMsg</div> }
                            <div class="line-form-btns">
                                <button class="btn-m btn-primary" @onclick="SaveLine" disabled="@isSavingLine">@if (isSavingLine) { <div class="btn-spin"></div> } إضافة</button>
                                <button class="btn-m btn-ghost" @onclick="() => showLineForm = false">إلغاء</button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (!isViewMode && !canApprove)
            {
                <div class="doc-actions">
                    <div class="doc-actions-right">
                        @if (!isReadOnly)
                        {
                            <button class="btn-m btn-primary" @onclick="SaveTransfer" disabled="@isSaving">
                                @if (isSaving) { <div class="btn-spin"></div> } @(isNewMode ? "حفظ" : "حفظ التعديلات")
                            </button>
                        }
                    </div>
                    <button class="btn-m btn-ghost" @onclick="GoBack">رجوع</button>
                </div>
            }
        }
    </div>

    @if (!string.IsNullOrEmpty(toast))
    { <div class="toast-wrap"><div class="toast @(toastOk ? "t-ok" : "t-err")"><span>@toast</span><button @onclick='() => toast = ""'>✕</button></div></div> }
}

