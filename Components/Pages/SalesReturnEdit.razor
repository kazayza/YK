.toast button svg{width:14px;height:14px}
</style>

@code {
    [Parameter] public int ReturnId { get; set; }

    private SalesReturnHeaderDto header = new() { ReturnDate = DateTime.Today, ReturnType = 1, ReturnStatus = 1 };
    private ModulePermissionDto? permissions;
    private List<LookupDto>? warehouses;
    private List<SearchableItem> eligibleInvoices = new();
    private List<SalesReturnInvoiceLineDto> invoiceLines = new();
    private List<SalesReturnDetailDto> details = new();
    private SalesReturnInvoiceContextDto? invoiceContext;
    private int selectedInvoiceId;
    private bool isLoading = true;
    private bool isSaving;
    private bool showRejectDialog;
    private string rejectReason = string.Empty;
    private string rejectError = string.Empty;
    private string toast = string.Empty;
    private bool toastOk = true;
    private string sourceWarning = string.Empty;

    private List<SalesReturnDetailDto> unsupportedDetails => invoiceContext == null
        ? (ReturnId > 0 ? details : new List<SalesReturnDetailDto>())
        : details.Where(x => x.InvoiceDetailID <= 0 ||
            !invoiceLines.Any(line => line.InvoiceDetailID == x.InvoiceDetailID) ||
            details.Count(other => other.InvoiceDetailID == x.InvoiceDetailID) > 1).ToList();

    private bool isNewMode => ReturnId == 0;
    private bool isViewMode => Navigation.Uri.Contains("/view/", StringComparison.OrdinalIgnoreCase);
    private bool isApprovalMode => !isNewMode && !isViewMode && header.ReturnStatus == 2 && permissions?.CanApprove == true;
    private bool canEditCurrent => isNewMode
        ? permissions?.CanAdd == true
        : (header.ReturnStatus is 1 or 4) &&
          (permissions?.CanEdit == true || (permissions?.CanAdd == true && header.CreatedBy == UserSession.UserID));
    private bool isReadOnly => isViewMode || (isNewMode ? permissions?.CanAdd != true : !canEditCurrent);
    private string pageTitle => isNewMode ? "مرتجع مبيعات جديد" : isViewMode ? "عرض مرتجع مبيعات" : isApprovalMode ? "اعتماد مرتجع مبيعات" : "مرتجع مبيعات";
    private int SelectedLineCount => invoiceLines.Count(x => x.IsSelected && x.ReturnQuantity > 0);

    private decimal previewSubtotal => decimal.Round(
        invoiceLines.Where(x => x.IsSelected && x.ReturnQuantity > 0)
            .Sum(x => decimal.Round(x.EffectiveReturnUnitPrice * x.ReturnQuantity, 2, MidpointRounding.AwayFromZero)),
        2, MidpointRounding.AwayFromZero);
    private decimal previewTax => decimal.Round(
        invoiceLines.Where(x => x.IsSelected && x.ReturnQuantity > 0 && x.InvoiceQuantity > 0)
            .Sum(x => decimal.Round(x.OriginalTaxAmount * x.ReturnQuantity / x.InvoiceQuantity, 2, MidpointRounding.AwayFromZero)),
        2, MidpointRounding.AwayFromZero);
    private decimal previewTotal => decimal.Round(previewSubtotal + previewTax, 2, MidpointRounding.AwayFromZero);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!UserSession.IsLoggedIn)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_SRET");
            if (permissions?.CanView != true) return;

            warehouses = await LookupService.GetWarehousesAsync();
            if (isNewMode)
            {
                if (permissions.CanAdd)
                    eligibleInvoices = await ReturnService.GetEligibleInvoicesAsync(UserSession.CurrentUserID);
            }
            else
            {
                await LoadReturnAsync();
            }
        }
        catch (Exception ex)
        {
            toast = "تعذر تحميل البيانات: " + ex.Message;
            toastOk = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadReturnAsync()
    {
        sourceWarning = string.Empty;
        var loaded = await ReturnService.GetReturnByIdAsync(ReturnId, UserSession.CurrentUserID);
        if (loaded == null)
        {
            toast = "مرتجع المبيعات غير موجود.";
            toastOk = false;
            return;
        }
        header = loaded;
        details = await ReturnService.GetReturnDetailsAsync(ReturnId, UserSession.CurrentUserID);
        selectedInvoiceId = header.InvoiceID.GetValueOrDefault();
        invoiceContext = null;
        invoiceLines.Clear();
        if (selectedInvoiceId <= 0)
        {
            sourceWarning = "المستند لا يرتبط بفاتورة أصلية؛ نعرض السطور المحفوظة للقراءة فقط ولا نسمح بترحيلها.";
            return;
        }

        try
        {
            invoiceContext = await ReturnService.GetInvoiceContextAsync(selectedInvoiceId, UserSession.CurrentUserID);
            invoiceLines = await ReturnService.GetInvoiceReturnLinesAsync(
                selectedInvoiceId, UserSession.CurrentUserID, ReturnId);
            ApplyCurrentDetailsToInvoiceLines();
            if (unsupportedDetails.Count > 0)
                sourceWarning = "يوجد سطر قديم غير قابل للربط الفريد بفاتورته الأصلية. نعرضه كما هو، ونمنع حفظ المسودة أو اعتمادها حتى لا تُفقد بياناته.";
        }
        catch (Exception ex)
        {
            invoiceContext = null;
            invoiceLines.Clear();
            sourceWarning = "تعذر إعادة بناء بيانات الفاتورة الأصلية؛ نعرض السطور المحفوظة فقط ولا نسمح بتعديلها أو اعتمادها. " + ex.Message;
        }
    }

    private async Task OnInvoiceSelected(SearchableItem? item)
    {
        sourceWarning = string.Empty;
        if (item == null || item.Id <= 0)
        {
            selectedInvoiceId = 0;
            invoiceContext = null;
            invoiceLines.Clear();
            header.InvoiceID = null;
            header.CustomerID = 0;
            header.CustomerNameAr = null;
            header.SalesRepID = null;
            return;
        }

        isLoading = true;
        try
        {
            selectedInvoiceId = item.Id;
            header.InvoiceID = item.Id;
            invoiceContext = await ReturnService.GetInvoiceContextAsync(item.Id, UserSession.CurrentUserID);
            header.CustomerID = invoiceContext.CustomerID;
            header.CustomerNameAr = invoiceContext.CustomerNameAr;
            header.InvoiceNumber = invoiceContext.InvoiceNumber;
            header.SalesRepID = invoiceContext.SalesRepID;
            if (header.WarehouseID <= 0 && invoiceContext.WarehouseID.HasValue)
                header.WarehouseID = invoiceContext.WarehouseID.Value;

            invoiceLines = await ReturnService.GetInvoiceReturnLinesAsync(item.Id, UserSession.CurrentUserID);
            foreach (var line in invoiceLines)
            {
                line.IsSelected = false;
                line.ReturnQuantity = 0m;
                line.ItemCondition = 1;
            }
        }
        catch (Exception ex)
        {
            invoiceContext = null;
            invoiceLines.Clear();
            toast = "تعذر تحميل أصناف الفاتورة: " + ex.Message;
            toastOk = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyCurrentDetailsToInvoiceLines()
    {
        foreach (var line in invoiceLines)
        {
            var current = details.FirstOrDefault(x => x.InvoiceDetailID == line.InvoiceDetailID);
            if (current == null) continue;
            line.IsSelected = true;
            line.ReturnQuantity = current.Quantity;
            line.ItemCondition = current.ItemCondition;
            line.ReturnReason = current.ReturnReason;
        }
    }

    private SalesReturnSaveDto BuildSaveRequest()
    {
        var currentByInvoiceLine = details
            .Where(x => x.InvoiceDetailID > 0)
            .GroupBy(x => x.InvoiceDetailID)
            .ToDictionary(x => x.Key, x => x.First());
        return new SalesReturnSaveDto
        {
            ReturnID = ReturnId,
            ReturnDate = header.ReturnDate,
            ReturnType = header.ReturnType is >= 1 and <= 4 ? header.ReturnType : 1,
            WarehouseID = header.WarehouseID,
            ReturnReason = header.ReturnReason,
            Notes = header.Notes,
            Details = invoiceLines
                .Where(x => x.IsSelected && x.ReturnQuantity > 0)
                .Select(x =>
                {
                    currentByInvoiceLine.TryGetValue(x.InvoiceDetailID, out var current);
                    return new SalesReturnDetailSaveDto
                    {
                        ReturnDetailID = current?.ReturnDetailID ?? 0,
                        InvoiceDetailID = x.InvoiceDetailID,
                        Quantity = x.ReturnQuantity,
                        ItemCondition = x.ItemCondition,
                        ReturnReason = x.ReturnReason,
                        Notes = current?.Notes
                    };
                })
                .ToList()
        };
    }

    private async Task SaveReturn()
    {
        if (unsupportedDetails.Count > 0)
        {
            toast = "يوجد سطر قديم غير مرتبط بفاتورة؛ لا نحفظ فوقه حتى لا نفقده.";
            toastOk = false;
            return;
        }
        if (invoiceContext == null || selectedInvoiceId <= 0)
        {
            toast = "اختر فاتورة أصلية معتمدة أولاً.";
            toastOk = false;
            return;
        }
        if (header.WarehouseID <= 0)
        {
            toast = "اختر مخزن الاستلام.";
            toastOk = false;
            return;
        }
        if (SelectedLineCount == 0)
        {
            toast = "حدد صنفاً واحداً وأدخل كمية مرتجعة أكبر من صفر.";
            toastOk = false;
            return;
        }

        isSaving = true;
        try
        {
            var request = BuildSaveRequest();
            if (isNewMode)
            {
                var newId = await ReturnService.CreateDraftAsync(
                    selectedInvoiceId, request, UserSession.CurrentUserID);
                ReturnId = newId;
                await LoadReturnAsync();
                toast = "تم إنشاء مسودة المرتجع.";
                toastOk = true;
                Navigation.NavigateTo($"/sales-returns/edit/{newId}", forceLoad: false);
                return;
            }

            await ReturnService.SaveDraftAsync(request, UserSession.CurrentUserID);
            await LoadReturnAsync();
            toast = "تم حفظ تعديلات المسودة.";
            toastOk = true;
        }
        catch (Exception ex)
        {
            toast = "تعذر حفظ المرتجع: " + ex.Message;
            toastOk = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SubmitForApproval()
    {
        if (unsupportedDetails.Count > 0)
        {
            toast = "يوجد سطر قديم غير مرتبط بفاتورة؛ لا يمكن إرساله للاعتماد.";
            toastOk = false;
            return;
        }
        if (ReturnId <= 0 || SelectedLineCount == 0)
        {
            toast = "احفظ المسودة وبها سطر واحد على الأقل قبل الإرسال.";
            toastOk = false;
            return;
        }

        isSaving = true;
        try
        {
            await ReturnService.SubmitForApprovalAsync(ReturnId, UserSession.CurrentUserID);
            await LoadReturnAsync();
            toast = "تم إرسال المرتجع للاعتماد وإشعار المعتمدين.";
            toastOk = true;
        }
        catch (Exception ex)
        {
            toast = "تعذر إرسال المرتجع: " + ex.Message;
            toastOk = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ApproveReturn()
    {
        if (invoiceContext == null || unsupportedDetails.Count > 0)
        {
            toast = "لا يمكن اعتماد مستند تعذر ربطه بالكامل بسطور الفاتورة الأصلية.";
            toastOk = false;
            return;
        }
        if (!await ConfirmActionAsync(
                "اعتماد المرتجع؟\n\nسيُنشأ إشعار دائن للعميل دون رد نقدي آلي. تعاد الأصناف السليمة فقط للمخزون، وتُستعاد تكلفتها من حركات FIFO للفاتورة."))
            return;

        isSaving = true;
        try
        {
            await ReturnService.ApproveAsync(
                ReturnId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            await LoadReturnAsync();
            toast = "تم اعتماد المرتجع وتحديث الأرصدة والقيد المحاسبي.";
            toastOk = true;
        }
        catch (Exception ex)
        {
            toast = "تعذر اعتماد المرتجع: " + ex.Message;
            toastOk = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task<bool> ConfirmActionAsync(string message)
    {
        try { return await JS.InvokeAsync<bool>("confirm", message); }
        catch { return false; }
    }

    private void OpenRejectDialog()
    {
        rejectReason = string.Empty;
        rejectError = string.Empty;
        showRejectDialog = true;
    }

    private void CloseRejectDialog()
    {
        showRejectDialog = false;
        rejectError = string.Empty;
    }

    private async Task ConfirmReject()
    {
        if (string.IsNullOrWhiteSpace(rejectReason))
        {
            rejectError = "أدخل سبب الرفض.";
            return;
        }

        isSaving = true;
        rejectError = string.Empty;
        try
        {
            await ReturnService.RejectAsync(
                ReturnId, rejectReason, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            showRejectDialog = false;
            await LoadReturnAsync();
            toast = "تم رفض المرتجع وإشعار منشئه بالسبب.";
            toastOk = true;
        }
        catch (Exception ex)
        {
            rejectError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task PrintReturn()
    {
        try
        {
            var html = await ReturnService.GenerateReturnHtmlAsync(ReturnId, UserSession.CurrentUserID);
            await JS.InvokeVoidAsync("printHtml", html);
        }
        catch (Exception ex)
        {
            toast = "تعذرت الطباعة: " + ex.Message;
            toastOk = false;
        }
    }

    private void GoBack() => Navigation.NavigateTo("/sales-returns");
}
