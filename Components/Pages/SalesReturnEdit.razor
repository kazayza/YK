.reject-input{width:100%;margin-top:12px;padding:10px;border:1px solid var(--line);border-radius:10px;outline:0;font:500 .8rem 'Tajawal',sans-serif;resize:vertical}
.reject-input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.error-box{margin-top:10px;padding:9px 11px;border:1px solid #fecaca;border-radius:9px;background:#fef2f2;color:#991b1b;font-size:.75rem;text-align:right}
.modal-actions{display:flex;justify-content:center;gap:9px;margin-top:16px}
.toast-wrap{position:fixed;left:20px;bottom:20px;z-index:1100}
.toast{display:flex;align-items:center;gap:13px;min-width:280px;max-width:min(550px,calc(100vw - 40px));padding:12px 14px;border:1px solid;border-radius:12px;box-shadow:0 12px 34px rgba(15,23,42,.17);font-size:.8rem;font-weight:700}
.toast.success{color:#065f46;background:#ecfdf5;border-color:#a7f3d0}
.toast.error{color:#991b1b;background:#fef2f2;border-color:#fecaca}
