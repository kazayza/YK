@page "/sales-returns/new"
@page "/sales-returns/edit/{ReturnId:int}"
@page "/sales-returns/view/{ReturnId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject SalesReturnService ReturnService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج   </PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="access-state" dir="rtl"><div class="access-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="access-state" dir="rtl"><div class="access-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6m0-6 6 6"/></svg></div><h4>ليس لديك صلاحية عرض مرتجعات المبيعات</h4><button class="btn btn-secondary" @onclick="GoBack">رجوع</button></div>
}
else
{
    <main class="return-editor" dir="rtl">
        <header class="editor-hero">
            <div class="gold-rule"></div>
            <div class="hero-watermark"><img src="/images/yk-icon-gold.png" alt="" /></div>
            <div class="hero-line">
                <div class="hero-heading">
                    <button class="back-button" title="العودة للقائمة" @onclick="GoBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5m0 0 7-7m-7 7 7 7"/></svg></button>
                    <div class="brand-mark"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
                    <div>
                        <h1>@pageTitle</h1>
                        <div class="hero-meta">
                            @if (ReturnId > 0 && !string.IsNullOrWhiteSpace(header.ReturnNumber))
                            {
                                <code class="doc-code">@header.ReturnNumber</code>
                                <span class="status-chip" style="--status-color:@SalesReturnService.GetReturnStatusColor(header.ReturnStatus)">@SalesReturnService.GetReturnStatusName(header.ReturnStatus)</span>
                            }
                            <span class="source-chip"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16h16V8z"/><path d="M14 2v6h6M8 13h8M8 17h6"/></svg>فاتورة معتمدة</span>
                        </div>
                    </div>
                </div>
                <div class="hero-tools">
                    <div class="workflow-mini"><span class="done">عرض سعر</span><i></i><span class="done">أمر بيع</span><i></i><span class="done">فاتورة</span><i></i><span class="active">مرتجع</span></div>
                    @if (ReturnId > 0 && permissions.CanPrint)
                    {
                        <button class="btn btn-secondary" @onclick="PrintReturn"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9V3h12v6"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v7H6z"/></svg>طباعة</button>
                    }
                </div>
            </div>
        </header>

        @if (isLoading)
        {
            <section class="loading-card"><span class="spinner"></span><p>جاري تحميل بيانات المرتجع...</p></section>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(sourceWarning))
            {
                <section class="rejection-note"><span class="note-sign"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7v5m0 4h.01"/></svg></span><div><strong>تعذر التحقق من المصدر</strong><p>@sourceWarning</p></div></section>
            }

            @if (isApprovalMode)
            {
                <section class="approval-panel">
                    <div class="approval-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
                    <div class="approval-copy"><strong>المرتجع بانتظار اعتمادك</strong><span>الاعتماد يحدّث رصيد العميل، ويعكس تكلفة FIFO للمقبول للمخزون، وينشئ قيداً محاسبياً متوازناً.</span></div>
                    <div class="approval-actions"><button class="btn btn-approve" @onclick="ApproveReturn" disabled="@isSaving || invoiceContext == null || unsupportedDetails.Count > 0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 4 4L19 6"/></svg>@(isSaving ? "جارٍ الاعتماد..." : "اعتماد")</button><button class="btn btn-reject" @onclick="OpenRejectDialog" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m7 7 10 10M17 7 7 17"/></svg>رفض مع سبب</button></div>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(header.RejectionReason) && (header.ReturnStatus is 1 or 4))
            {
                <section class="rejection-note"><span class="note-sign"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M12 7v5m0 4h.01"/></svg></span><div><strong>سبب الرفض السابق</strong><p>@header.RejectionReason</p></div></section>
            }

            @if (isNewMode)
            {
                <section class="panel invoice-source-panel">
                    <div class="panel-title"><span class="section-icon cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v18h16V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg></span><div><h2>الفاتورة الأصلية</h2><p>تظهر الفواتير المعتمدة ذات حركة FIFO أصلية فقط، وبعملة النظام ومن دون شحن أو تكاليف إضافية.</p></div></div>
                    <div class="form-grid two-col">
                        <div class="field"><label class="required">اختيار الفاتورة</label><SearchableSelect Items="@eligibleInvoices" @bind-SelectedId="selectedInvoiceId" OnSelected="OnInvoiceSelected" Placeholder="ابحث برقم الفاتورة أو العميل..." IsDisabled="@isSaving" /></div>
                        @if (invoiceContext != null)
                        {
                            <div class="invoice-facts"><div><small>رقم الفاتورة</small><strong>@invoiceContext.InvoiceNumber</strong></div><div><small>تاريخ الفاتورة</small><strong>@invoiceContext.InvoiceDate.ToString("dd/MM/yyyy")</strong></div><div><small>العميل</small><strong>@invoiceContext.CustomerNameAr</strong></div><div><small>إجمالي الفاتورة</small><strong>@invoiceContext.TotalAmount.ToString("#,##0.00") ج.م</strong></div></div>
                        }
                    </div>
                </section>
            }

            @if (invoiceContext != null || ReturnId > 0)
            {
                <section class="panel">
                    <div class="panel-title"><span class="section-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5h16M4 12h16M4 19h16"/><circle cx="8" cy="5" r="1"/><circle cx="14" cy="12" r="1"/></svg></span><div><h2>بيانات المرتجع</h2><p>كود نوع المرتجع محفوظ كما في المخطط؛ معناه التجاري غير موثق، لذلك لا نعرض تصنيفاً تخمينياً.</p></div></div>
                    <div class="form-grid four-col">
                        <div class="field"><label>رقم المرتجع</label><input class="readonly" value="@(string.IsNullOrWhiteSpace(header.ReturnNumber) ? "يُنشأ عند الحفظ" : header.ReturnNumber)" disabled /></div>
                        <div class="field"><label class="required">تاريخ المرتجع</label><input type="date" @bind="header.ReturnDate" disabled="@isReadOnly" /></div>
                        <div class="field"><label>العميل</label><input class="readonly" value="@(header.CustomerNameAr ?? invoiceContext?.CustomerNameAr ?? "—")" disabled /></div>
                        <div class="field"><label class="required">مخزن الاستلام</label><select @bind="header.WarehouseID" disabled="@isReadOnly"><option value="0">اختر مخزناً نشطاً</option>@if (warehouses != null){@foreach (var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select></div>
                        <div class="field span-four"><label>السبب العام</label><input @bind="header.ReturnReason" disabled="@isReadOnly" maxlength="500" placeholder="سبب الإرجاع أو رقم طلب العميل..." /></div>
                    </div>
                    <div class="field notes-field"><label>ملاحظات</label><textarea rows="2" @bind="header.Notes" disabled="@isReadOnly" placeholder="معلومات داخلية توضح حالة المرتجع أو طريقة المعالجة..."></textarea></div>
                    <div class="policy-inline"><span class="policy-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3v18M3 12h18"/><circle cx="12" cy="12" r="9"/></svg></span><span>يُنشأ إشعار دائن للعميل عند الاعتماد؛ لا يتضمن هذا المسار صرف نقدية. السليم فقط يعود إلى المخزون المتاح.</span></div>
                </section>
            }

            @if (invoiceContext != null && invoiceLines.Count > 0)
            {
                <section class="panel lines-panel">
                    <div class="panel-title lines-heading"><span class="section-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m3 7 9-4 9 4-9 5-9-5Z"/><path d="m3 12 9 5 9-5M3 17l9 5 9-5"/></svg></span><div><h2>الأصناف والكميات</h2><p>حدد الصنف وأدخل الكمية الفعلية المستلمة. الأسعار والضريبة مأخوذة من الفاتورة ولا يمكن تحريرها.</p></div><span class="selected-count">@SelectedLineCount سطر مختار</span></div>
                    <div class="table-scroll">
                        <table class="line-table">
                            <thead><tr><th class="center">اختيار</th><th>الصنف</th><th>الوحدة</th><th class="num">كمية الفاتورة</th><th class="num">مرتجع/محجوز سابقاً</th><th class="num">المتاح</th><th class="num">سعر المرتجع</th><th class="center">الكمية المرتجعة</th><th>حالة الصنف</th><th>سبب السطر</th></tr></thead>
                            <tbody>
                                @foreach (var line in invoiceLines)
                                {
                                    <tr class="@(line.IsSelected ? "selected-line" : "")">
                                        <td class="center"><input type="checkbox" class="check" @bind="line.IsSelected" disabled="@isReadOnly" aria-label="اختيار @line.ItemNameAr" /></td>
                                        <td><div class="item-name"><code>@(line.ItemCode ?? "—")</code><strong>@line.ItemNameAr</strong></div></td>
                                        <td class="muted">@line.UnitName</td>
                                        <td class="num">@line.InvoiceQuantity.ToString("#,##0.####")</td>
                                        <td class="num">@line.PreviouslyReturnedQuantity.ToString("#,##0.####")</td>
                                        <td class="num available">@line.RemainingReturnQuantity.ToString("#,##0.####")</td>
                                        <td class="num">@line.EffectiveReturnUnitPrice.ToString("#,##0.00")</td>
                                        <td class="center"><input class="qty-input" type="number" min="0" max="@line.RemainingReturnQuantity" step="0.0001" @bind="line.ReturnQuantity" disabled="@(!line.IsSelected || isReadOnly)" aria-label="الكمية المرتجعة" /></td>
                                        <td><select class="condition-select" @bind="line.ItemCondition" disabled="@(!line.IsSelected || isReadOnly)"><option value="1">سليم</option><option value="2">تالف</option><option value="3">منتهي الصلاحية</option></select></td>
                                        <td><input class="reason-input" @bind="line.ReturnReason" maxlength="200" disabled="@(!line.IsSelected || isReadOnly)" placeholder="اختياري" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="stock-explainer"><span class="condition-dot good"></span><span>السليم يعاد للمخزون بتكلفة FIFO من حركة البيع الأصلية.</span><span class="condition-dot bad"></span><span>التالف والمنتهي لا يعادان للمخزون المتاح ولا يعكسان تكلفة المبيعات.</span></div>
                </section>
            }

            @if (unsupportedDetails.Count > 0)
            {
                <section class="panel">
                    <div class="panel-title"><span class="section-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3 2.8 20h18.4L12 3Z"/><path d="M12 9v5m0 3h.01"/></svg></span><div><h2>سطور محفوظة غير قابلة للربط التلقائي</h2><p>نعرض البيانات كما هي ولا نعيد تسعيرها أو ترحيلها من دون مرجع فاتورة صالح.</p></div></div>
                    <div class="table-scroll"><table class="line-table"><thead><tr><th>الصنف</th><th>الوحدة</th><th class="num">الكمية</th><th class="num">سعر السطر</th><th class="num">الإجمالي</th><th>الحالة</th></tr></thead><tbody>
                        @foreach (var detail in unsupportedDetails)
                        {
                            <tr><td>@detail.ItemNameAr</td><td>@detail.UnitName</td><td class="num">@detail.Quantity.ToString("#,##0.####")</td><td class="num">@detail.UnitPrice.ToString("#,##0.00")</td><td class="num">@detail.LineTotalWithTax.ToString("#,##0.00")</td><td>@SalesReturnService.GetConditionName(detail.ItemCondition)</td></tr>
                        }
                    </tbody></table></div>
                </section>
            }

            @if (invoiceContext != null && invoiceLines.Count > 0)
            {
                <section class="totals-panel">
                    <div class="total-item"><small>قبل الضريبة</small><strong>@previewSubtotal.ToString("#,##0.00")</strong></div>
                    <div class="total-item"><small>الضريبة</small><strong>@previewTax.ToString("#,##0.00")</strong></div>
                    <div class="total-item grand"><small>إجمالي الإشعار الدائن</small><strong>@previewTotal.ToString("#,##0.00") ج.م</strong></div>
                </section>
            }
            else if (ReturnId > 0 && details.Count > 0)
            {
                <section class="totals-panel"><div class="total-item"><small>قبل الضريبة</small><strong>@header.SubTotal.ToString("#,##0.00")</strong></div><div class="total-item"><small>الضريبة</small><strong>@header.TaxAmount.ToString("#,##0.00")</strong></div><div class="total-item grand"><small>إجمالي الإشعار الدائن</small><strong>@header.TotalAmount.ToString("#,##0.00") ج.م</strong></div></section>
            }

            @if (!isViewMode && !isApprovalMode && canEditCurrent)
            {
                <footer class="form-actions">
                    <div class="primary-actions">
                        <button class="btn btn-primary" @onclick="SaveReturn" disabled="@isSaving || invoiceContext == null || unsupportedDetails.Count > 0">
                            @if (isSaving) { <span class="spinner small dark"></span> }
                            else { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v13Z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg> }
                            @(isNewMode ? "حفظ كمسودة" : "حفظ التعديلات")
                        </button>
                        @if (ReturnId > 0 && header.ReturnStatus == 1 && SelectedLineCount > 0 && unsupportedDetails.Count == 0)
                        {
                            <button class="btn btn-submit" @onclick="SubmitForApproval" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m22 2-7 20-4-9-9-4 20-7Z"/><path d="M22 2 11 13"/></svg>إرسال للاعتماد</button>
                        }
                    </div>
                    <button class="btn btn-secondary" @onclick="GoBack">إلغاء / رجوع</button>
                </footer>
            }

            @if (isViewMode || (ReturnId > 0 && !canEditCurrent && !isApprovalMode))
            {
                <footer class="form-actions read-only-actions"><span>هذا المستند للعرض فقط.</span><button class="btn btn-secondary" @onclick="GoBack">رجوع للقائمة</button></footer>
            }
        }
    </main>

    @if (showRejectDialog)
    {
        <div class="modal-backdrop" @onclick="CloseRejectDialog">
            <section class="modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="reject-title">
                <div class="modal-rule danger"></div>
                <div class="modal-icon danger"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M12 7v5m0 4h.01"/></svg></div>
                <h3 id="reject-title">رفض مرتجع المبيعات</h3>
                <p>سبب الرفض سيُحفظ في ملاحظات المستند ويُرسل لمنشئه. لا تتغير أرصدة المخزون أو العميل.</p>
                <textarea class="reject-input" rows="4" maxlength="1000" @bind="rejectReason" placeholder="اكتب سبباً واضحاً للرفض"></textarea>
                @if (!string.IsNullOrWhiteSpace(rejectError)) { <div class="error-box">@rejectError</div> }
                <div class="modal-actions"><button class="btn btn-danger" @onclick="ConfirmReject" disabled="@isSaving">@(isSaving ? "جارٍ الحفظ..." : "تأكيد الرفض")</button><button class="btn btn-secondary" @onclick="CloseRejectDialog">إلغاء</button></div>
            </section>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(toast))
    {
        <div class="toast-wrap"><div class="toast @(toastOk ? "success" : "error")"><span>@toast</span><button title="إغلاق الإشعار" @onclick="() => toast = string.Empty"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 6 12 12M18 6 6 18"/></svg></button></div></div>
    }
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--ink:#070B14;--ink2:#0A0F1E;--line:#e8e2d0;--cream:#fcfaf6}
.return-editor{max-width:1370px;margin:0 auto;display:flex;flex-direction:column;gap:15px;font-family:'Tajawal',sans-serif;color:#111827}
.editor-hero{position:relative;overflow:hidden;border-radius:20px;padding:18px 22px;background:linear-gradient(135deg,var(--ink),var(--ink2) 55%,#121a2e);border:1px solid rgba(212,175,55,.2);box-shadow:0 8px 30px rgba(0,0,0,.2)}
.gold-rule{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent)}
.hero-watermark{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}
.hero-watermark img{width:95px;height:95px;object-fit:contain}
.hero-line{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.hero-heading{display:flex;align-items:center;gap:10px}
.back-button{width:34px;height:34px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.14);border-radius:10px;background:rgba(255,255,255,.07);color:#f5e6c8;cursor:pointer}
.back-button svg{width:16px;height:16px}
.brand-mark{width:42px;height:42px;border:1px solid rgba(212,175,55,.22);border-radius:12px;background:rgba(212,175,55,.08);display:grid;place-items:center}
.brand-mark img{width:26px;height:26px;object-fit:contain}
.hero-heading h1{margin:0;color:#f5e6c8;font-size:1.15rem;font-weight:900}
.hero-meta{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:5px}
.doc-code{padding:4px 9px;border:1px solid rgba(212,175,55,.3);border-radius:7px;background:rgba(212,175,55,.12);color:var(--gold);font:700 .79rem ui-monospace,monospace}
.status-chip{padding:4px 10px;border-radius:999px;color:var(--status-color);border:1px solid color-mix(in srgb,var(--status-color) 35%,transparent);background:color-mix(in srgb,var(--status-color) 17%,transparent);font-size:.68rem;font-weight:900}
.source-chip{display:inline-flex;align-items:center;gap:5px;padding:4px 9px;border:1px solid rgba(255,255,255,.1);border-radius:999px;color:#aab4c2;background:rgba(255,255,255,.05);font-size:.68rem;font-weight:700}
.source-chip svg{width:13px;height:13px;color:var(--gold)}
.hero-tools{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.workflow-mini{display:flex;align-items:center;gap:7px;padding:7px 11px;border:1px solid rgba(255,255,255,.1);border-radius:999px;background:rgba(255,255,255,.05);font-size:.66rem;font-weight:800;color:#6f7b8c}
.workflow-mini span.done{color:#10b981}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:9px 14px;border:1px solid transparent;border-radius:10px;font:800 .79rem 'Tajawal',sans-serif;cursor:pointer;transition:transform .16s,box-shadow .16s,background .16s}
.btn:hover:not(:disabled){transform:translateY(-1px)}
.btn:disabled{opacity:.55;cursor:not-allowed}
.btn svg{width:15px;height:15px}
.btn-primary{color:#171307;background:linear-gradient(135deg,#e4c25d,var(--gold-dark));box-shadow:0 3px 12px rgba(212,175,55,.2)}
.btn-secondary{color:#475569;background:#fff;border-color:var(--line)}
.btn-secondary:hover{border-color:var(--gold);background:var(--cream)}
.btn-submit{color:#fff;background:linear-gradient(135deg,#d97706,#f59e0b)}
.btn-approve{color:#fff;background:linear-gradient(135deg,#059669,#10b981)}
.btn-reject,.btn-danger{color:#fff;background:linear-gradient(135deg,#ef4444,#b91c1c)}
.panel{position:relative;overflow:hidden;padding:20px 21px;border:1px solid var(--line);border-radius:17px;background:#fff;box-shadow:0 4px 16px rgba(15,23,42,.03)}
.invoice-source-panel{overflow:visible}
.panel:before{position:absolute;content:'';top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.6}
.panel-title{display:flex;align-items:center;gap:10px;margin-bottom:17px;padding-bottom:13px;border-bottom:1px solid #f1efe8}
.panel-title h2{margin:0;color:#111827;font-size:.94rem;font-weight:900}
.panel-title p{margin:3px 0 0;color:#8993a2;font-size:.73rem;line-height:1.5}
.section-icon{width:37px;height:37px;flex:0 0 auto;display:grid;place-items:center;border-radius:10px}
.section-icon svg{width:18px;height:18px}
.section-icon.cyan{color:#0891b2;background:#ecfeff;border:1px solid #a5f3fc}
.section-icon.gold{color:var(--gold-dark);background:#fcfaf2;border:1px solid #ead8a2}
.section-icon.green{color:#059669;background:#ecfdf5;border:1px solid #a7f3d0}
.form-grid{display:grid;gap:13px}
