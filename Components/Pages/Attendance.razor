@code {
    private ModulePermissionDto? permissions;
    private AttendanceFilterDto filters = new() { PageNumber = 1, PageSize = 20, DateFrom = DateTime.Today.AddDays(-7), DateTo = DateTime.Today };
    private AttendancePagedResult pagedResult = new();
    private AttendanceStatsDto stats = new();
    private List<LookupDto>? departments;
    private bool isLoading = true, isExporting = false;
    private string resultMessage = "";
    private bool resultSuccess = true;
    
    private bool showImportDialog = false;
    private bool isImporting = false;
    private string importMessage = "";
    private bool importSuccess = true;
    private IBrowserFile? importFile;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_ATTEND");
        if (permissions == null || !permissions.CanView) { isLoading = false; return; }
        departments = await LookupService.GetDepartmentsLookupAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try 
        { 
            stats = await AttendanceService.GetAttendanceStatsAsync(filters.DateFrom, filters.DateTo); 
            pagedResult = await AttendanceService.GetAttendancePagedAsync(filters); 
        }
        catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
        finally { isLoading = false; }
    }

    private async Task SearchData() { filters.PageNumber = 1; await LoadData(); }
    private async Task ClearFilters() { filters = new() { PageNumber = 1, PageSize = 20, DateFrom = DateTime.Today.AddDays(-7), DateTo = DateTime.Today }; await LoadData(); }
    private async Task PreviousPage() { if (pagedResult.HasPrevious) { filters.PageNumber--; await LoadData(); } }
    private async Task NextPage() { if (pagedResult.HasNext) { filters.PageNumber++; await LoadData(); } }

    private void GoToAdd() => Navigation.NavigateTo("/attendance/new");
    private void GoToEdit(int id) => Navigation.NavigateTo($"/attendance/edit/{id}");
    private void GoToView(int id) => Navigation.NavigateTo($"/attendance/view/{id}");

    private async Task ExportData()
    {
        isExporting = true;
        try
        {
            var exportFilter = new AttendanceFilterDto
            {
                SearchText = filters.SearchText,
                DepartmentID = filters.DepartmentID,
                AttendanceStatus = filters.AttendanceStatus,
                DateFrom = filters.DateFrom,
                DateTo = filters.DateTo,
                PageNumber = 1,
                PageSize = 10000
            };
            var exportResult = await AttendanceService.GetAttendancePagedAsync(exportFilter);

            if (exportResult.Items == null || !exportResult.Items.Any())
            {
                resultMessage = "لا توجد بيانات للتصدير"; resultSuccess = false;
                isExporting = false; return;
            }

            var bytes = await AttendanceService.ExportAttendanceToExcelAsync(exportResult.Items, UserSession.UserID);
            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", $"Attendance_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
            resultMessage = $"تم تصدير {exportResult.Items.Count} سجل ✅"; resultSuccess = true;
        }
        catch (Exception ex) { resultMessage = "خطأ في التصدير: " + ex.Message; resultSuccess = false; }
        finally { isExporting = false; }
    }

    private void ShowImportDialog() { showImportDialog = true; importMessage = ""; importFile = null; }
    private void CloseImportDialog() { showImportDialog = false; importMessage = ""; importFile = null; }

    private void HandleImportFile(InputFileChangeEventArgs e)
{
    importFile = e.FileCount > 0 ? e.GetMultipleFiles(1)[0] : null;
    importMessage = importFile != null 
        ? $"تم اختيار الملف: {importFile.Name} ({importFile.Size} bytes)" 
        : "لم يتم اختيار ملف";
    importSuccess = true;
    StateHasChanged();
}

    private async Task ProcessImport()
{
    if (importFile == null)
    {
        importMessage = "لم يتم اختيار ملف";
        importSuccess = false;
        StateHasChanged();
        return;
    }

    isImporting = true;
    importMessage = "";
    StateHasChanged();

    try
    {
        // خطوة 1: قراءة الملف
        importMessage = $"جاري قراءة: {importFile.Name} ({importFile.Size} bytes)";
        StateHasChanged();
        await Task.Delay(300);

        using var memStream = new MemoryStream();
        using var fileStream = importFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
        await fileStream.CopyToAsync(memStream);
        memStream.Position = 0;

        importMessage = "تم قراءة الملف، جاري فتح Excel...";
        StateHasChanged();
        await Task.Delay(300);

        // خطوة 2: فتح Excel
        using var workbook = new ClosedXML.Excel.XLWorkbook(memStream);
        var ws = workbook.Worksheet(1);

        importMessage = "تم فتح Excel، جاري قراءة العناوين...";
        StateHasChanged();
        await Task.Delay(300);

        // خطوة 3: قراءة العناوين
        var headers = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        var lastCol = ws.Row(1).LastCellUsed()?.Address.ColumnNumber ?? 0;

        for (int col = 1; col <= lastCol; col++)
        {
            var header = ws.Cell(1, col).GetString().Trim();
            if (!string.IsNullOrWhiteSpace(header))
                headers[header] = col;
        }

        importMessage = $"تم قراءة {headers.Count} عمود: {string.Join(", ", headers.Keys)}";
        StateHasChanged();
        await Task.Delay(500);

        // خطوة 4: التحقق من الأعمدة الإلزامية
        if (!headers.ContainsKey("EmployeeCode"))
        {
            importMessage = "الملف لا يحتوي على عمود EmployeeCode";
            importSuccess = false;
            isImporting = false;
            StateHasChanged();
            return;
        }

        if (!headers.ContainsKey("AttendanceDate"))
        {
            importMessage = "الملف لا يحتوي على عمود AttendanceDate";
            importSuccess = false;
            isImporting = false;
            StateHasChanged();
            return;
        }

        // خطوة 5: قراءة الصفوف
        var lastRow = ws.LastRowUsed()?.RowNumber() ?? 1;
        importMessage = $"عدد الصفوف: {lastRow - 1}، جاري المعالجة...";
        StateHasChanged();
        await Task.Delay(300);

        var records = new List<FingerprintRecord>();
        var skippedRows = new List<string>();

        for (int row = 2; row <= lastRow; row++)
        {
            try
            {
                var empCode = ws.Cell(row, headers["EmployeeCode"]).GetString().Trim();
                if (string.IsNullOrWhiteSpace(empCode))
                {
                    skippedRows.Add($"صف {row}: كود فارغ");
                    continue;
                }

                // قراءة التاريخ
                var dateCell = ws.Cell(row, headers["AttendanceDate"]);
                DateTime attendanceDate;

                if (dateCell.DataType == ClosedXML.Excel.XLDataType.DateTime)
                {
                    attendanceDate = dateCell.GetDateTime().Date;
                }
                else
                {
                    var dateStr = dateCell.GetString().Trim();
                    if (!TryParseDate(dateStr, out attendanceDate))
                    {
                        skippedRows.Add($"صف {row}: تاريخ غير صحيح");
                        continue;
                    }
                }

                var empId = await GetEmployeeIdByCode(empCode);
                if (empId <= 0)
                {
                    skippedRows.Add($"صف {row}: كود ({empCode}) غير موجود");
                    continue;
                }

                // قراءة الأوقات
                TimeSpan? actualIn = headers.ContainsKey("ActualIn") ? ParseTimeCell(ws.Cell(row, headers["ActualIn"])) : null;
                TimeSpan? actualOut = headers.ContainsKey("ActualOut") ? ParseTimeCell(ws.Cell(row, headers["ActualOut"])) : null;
                TimeSpan? scheduledIn = headers.ContainsKey("ScheduledIn") ? ParseTimeCell(ws.Cell(row, headers["ScheduledIn"])) : null;
                TimeSpan? scheduledOut = headers.ContainsKey("ScheduledOut") ? ParseTimeCell(ws.Cell(row, headers["ScheduledOut"])) : null;

                // الحالة
                int status = 0;
                if (headers.ContainsKey("AttendanceStatus"))
                {
                    var statusStr = ws.Cell(row, headers["AttendanceStatus"]).GetString().Trim();
                    if (int.TryParse(statusStr, out var ps) && ps >= 1 && ps <= 7)
                        status = ps;
                }

                if (status == 0)
                {
                    if (actualIn.HasValue)
                        status = (scheduledIn.HasValue && actualIn.Value > scheduledIn.Value) ? 5 : 1;
                    else
                        status = 2;
                }

                // الأوفرتايم
                decimal overtimeHours = 0;
                if (headers.ContainsKey("OvertimeHours"))
                {
                    var otStr = ws.Cell(row, headers["OvertimeHours"]).GetString().Trim();
                    if (decimal.TryParse(otStr, out var pot))
                        overtimeHours = pot;
                }

                if (overtimeHours == 0 && actualIn.HasValue && actualOut.HasValue
                    && scheduledIn.HasValue && scheduledOut.HasValue)
                {
                    var workedMin = (actualOut.Value - actualIn.Value).TotalMinutes;
                    var scheduledMin = (scheduledOut.Value - scheduledIn.Value).TotalMinutes;
                    if (workedMin > scheduledMin)
                        overtimeHours = Math.Round((decimal)(workedMin - scheduledMin) / 60m, 2);
                }

                // الملاحظات
                string? notes = headers.ContainsKey("Notes") ? ws.Cell(row, headers["Notes"]).GetString().Trim() : null;

                records.Add(new FingerprintRecord
                {
                    EmployeeID = empId,
                    AttendanceDate = attendanceDate,
                    ActualIn = actualIn,
                    ActualOut = actualOut,
                    ScheduledIn = scheduledIn,
                    ScheduledOut = scheduledOut,
                    AttendanceStatus = status,
                    OvertimeHours = overtimeHours,
                    Notes = notes
                });
            }
            catch (Exception rowEx)
            {
                skippedRows.Add($"صف {row}: {rowEx.Message}");
            }
        }

        importMessage = $"تم قراءة {records.Count} سجل صحيح، {skippedRows.Count} مرفوض";
        StateHasChanged();
        await Task.Delay(500);

        if (!records.Any())
        {
            var details = skippedRows.Any()
                ? "\n" + string.Join("\n", skippedRows.Take(10))
                : "";
            importMessage = $"لم يتم قراءة أي سجلات صحيحة{details}";
            importSuccess = false;
            isImporting = false;
            StateHasChanged();
            return;
        }

        // الاستيراد
        importMessage = "جاري حفظ البيانات...";
        StateHasChanged();

        var count = await AttendanceService.ImportFromFingerprintAsync(records, UserSession.UserID);

        var resultMsg = $"تم استيراد {count} سجل بنجاح ✅";
        if (skippedRows.Any())
            resultMsg += $"\nتم تجاهل {skippedRows.Count} سجل";

        importMessage = resultMsg;
        importSuccess = true;
        StateHasChanged();

        await LoadData();
        await Task.Delay(3000);
        CloseImportDialog();
    }
    catch (Exception ex)
    {
        importMessage = $"خطأ: {ex.Message}";
        importSuccess = false;
        StateHasChanged();
    }
    finally
    {
        isImporting = false;
        StateHasChanged();
    }
}

// دالة مساعدة لقراءة الوقت من خلية Excel
private TimeSpan? ParseTimeCell(ClosedXML.Excel.IXLCell cell)
{
    try
    {
        if (cell == null || cell.IsEmpty()) return null;

        // لو الخلية DateTime
        if (cell.DataType == ClosedXML.Excel.XLDataType.DateTime)
        {
            var dt = cell.GetDateTime();
            return dt.TimeOfDay;
        }

        // لو TimeSpan
        if (cell.DataType == ClosedXML.Excel.XLDataType.TimeSpan)
            return cell.GetTimeSpan();

        // لو نص
        var timeStr = cell.GetString().Trim();
        if (string.IsNullOrWhiteSpace(timeStr)) return null;

        // دعم صيغ متعددة: HH:mm أو HH:mm:ss
        if (TimeSpan.TryParseExact(timeStr, new[] { @"hh\:mm", @"hh\:mm\:ss", @"h\:mm", @"h\:mm\:ss" },
            null, out var ts))
            return ts;

        if (TimeSpan.TryParse(timeStr, out var ts2))
            return ts2;

        return null;
    }
    catch
    {
        return null;
    }
}

// دالة مساعدة لتحليل التاريخ بصيغ متعددة
private bool TryParseDate(string dateStr, out DateTime result)
{
    result = default;
    if (string.IsNullOrWhiteSpace(dateStr)) return false;

    var formats = new[]
    {
        "dd/MM/yyyy",
        "d/M/yyyy",
        "yyyy-MM-dd",
        "MM/dd/yyyy",
        "dd-MM-yyyy",
        "yyyy/MM/dd"
    };

    if (DateTime.TryParseExact(dateStr, formats,
        System.Globalization.CultureInfo.InvariantCulture,
        System.Globalization.DateTimeStyles.None, out result))
        return true;

    return DateTime.TryParse(dateStr,
        System.Globalization.CultureInfo.InvariantCulture,
        System.Globalization.DateTimeStyles.None, out result);
}

    private async Task<int> GetEmployeeIdByCode(string code)
    {
        return await LookupService.GetEmployeeIdByCodeAsync(code);
    }
}