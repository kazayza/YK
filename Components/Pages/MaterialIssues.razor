@code {
    private List<MaterialIssueListDto> issues = new();
    private bool isLoading = true;
    private bool isExporting = false;
    private bool isProcessing = false;
    private ModulePermissionDto? permissions;
    private ModulePermissionDto Perms => permissions!;

    private string? searchQuery;
    private string? statusFilter;
    private DateTime? fromDate;
    private DateTime? toDate;

    private bool showApproveDialog = false;
    private bool showCancelDialog = false;
    private MaterialIssueListDto? selectedIssue;

    private string? resultMessage;
    private bool isSuccess;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { NavigationManager.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_MATISS");
        if (permissions is not null && Perms.CanView)
            await LoadData();
        else
            isLoading = false;
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            int? status = int.TryParse(statusFilter, out var s) ? s : null;
            issues = await IssueService.GetListAsync(searchQuery, status, fromDate, toDate);
        }
        finally { isLoading = false; }
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadData();
    }

    private void NavigateToAdd() => NavigationManager.NavigateTo("/material-issues/edit/0");
    private void NavigateToEdit(int id) => NavigationManager.NavigateTo($"/material-issues/edit/{id}");

    private void ApproveIssue(MaterialIssueListDto issue) { selectedIssue = issue; showApproveDialog = true; }
    private void CancelIssue(MaterialIssueListDto issue) { selectedIssue = issue; showCancelDialog = true; }
    private void CloseDialogs() { showApproveDialog = false; showCancelDialog = false; selectedIssue = null; }

    private async Task ConfirmApprove()
    {
        if (selectedIssue == null) return;
        isProcessing = true;
        try
        {
            var result = await IssueService.ApproveAsync(selectedIssue.MaterialIssueID, UserSession.UserID);
            isSuccess = result.Success; resultMessage = result.Message;
            if (result.Success) { showApproveDialog = false; await LoadData(); }
        }
        finally { isProcessing = false; _ = ClearMessage(); }
    }

    private async Task ConfirmCancel()
    {
        if (selectedIssue == null) return;
        isProcessing = true;
        try
        {
            var result = await IssueService.CancelAsync(selectedIssue.MaterialIssueID, UserSession.UserID);
            isSuccess = result.Success; resultMessage = result.Message;
            if (result.Success) { showCancelDialog = false; await LoadData(); }
        }
        finally { isProcessing = false; _ = ClearMessage(); }
    }

    private async Task PrintIssue(int id)
    {
        if (!Perms.CanPrint) return;
        var issue = await IssueService.GetByIdAsync(id);
        if (issue == null) return;
        var details = await IssueService.GetDetailsAsync(id);
        var html = BuildPrintHtml(issue, details);
        await JS.InvokeVoidAsync("printHtml", html);
    }

    private async Task ExportToExcel()
    {
        if (!Perms.CanExport) return;
        isExporting = true;
        try
        {
            var bytes = await IssueService.ExportToExcelAsync(issues, UserSession.UserID);
            var fileName = $"MaterialIssues_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            await JS.InvokeVoidAsync("downloadFile", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        finally { isExporting = false; }
    }

    private async Task ClearMessage() { await Task.Delay(4000); resultMessage = null; StateHasChanged(); }

    private string GetStatusClass(int s) => s switch { 1 => "s-draft", 2 => "s-issued", 3 => "s-cancelled", _ => "s-draft" };

    private string BuildPrintHtml(MaterialIssueEditDto issue, List<MaterialIssueDetailDto> details)
    {
        var thStyle = "padding:11px 14px;text-align:right;font-weight:700;color:#374151;border-bottom:2px solid #e5e7eb;font-size:13px;";
        var tdStyle = "padding:10px 14px;border-bottom:1px solid #f3f4f6;font-size:13px;";
        var rows = new System.Text.StringBuilder();
        int n = 1;
        foreach (var d in details)
        {
            rows.Append($@"<tr>
                <td style='{tdStyle}text-align:center;color:#94a3b8;'>{n++}</td>
                <td style='{tdStyle}font-family:monospace;color:#4f46e5;font-weight:700;'>{d.ItemCode}</td>
                <td style='{tdStyle}font-weight:600;'>{d.ItemName}</td>
                <td style='{tdStyle}text-align:center;font-weight:600;'>{d.RequiredQty:N3}</td>
                <td style='{tdStyle}text-align:center;color:#10b981;font-weight:700;'>{d.IssueQty:N3}</td>
                <td style='{tdStyle}text-align:center;color:#64748b;'>{d.UnitName}</td>
                <td style='{tdStyle}text-align:left;font-weight:700;color:#10b981;'>{d.LineCost:N2}</td>
            </tr>");
        }
        return $@"<!DOCTYPE html><html lang='ar' dir='rtl'><head><meta charset='UTF-8'>
<title>إذن صرف - {issue.IssueNumber}</title>
<style>*{{margin:0;padding:0;box-sizing:border-box;}}body{{font-family:'Segoe UI',sans-serif;direction:rtl;background:#fff;color:#1f2937;padding:30px;font-size:14px;line-height:1.6;}}.no-print{{}}@media print{{.no-print{{display:none!important;}}body{{padding:15px;}}}}</style>
</head><body>
<div class='no-print' style='margin-bottom:24px;display:flex;gap:10px;justify-content:flex-end;'>
<button onclick='window.print()' style='background:#4f46e5;color:#fff;border:none;padding:10px 24px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;'>🖨️ طباعة</button>
<button onclick='window.close()' style='background:#6b7280;color:#fff;border:none;padding:10px 24px;border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;'>✕ إغلاق</button>
</div>
<div style='text-align:center;border-bottom:3px solid #4f46e5;padding-bottom:20px;margin-bottom:28px;'>
<div style='font-size:2.2rem;margin-bottom:8px;'>📦</div>
<h1 style='font-size:1.7rem;font-weight:800;color:#1f2937;margin:0;'>واي كي كوتينج ERP</h1>
<p style='color:#6b7280;margin:6px 0 0;'>إذن صرف خامات (Material Issue)</p>
</div>
<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px 32px;background:#f9fafb;padding:20px;border-radius:12px;margin-bottom:28px;border:1px solid #e5e7eb;'>
<div style='display:flex;gap:10px;'><span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>رقم الإذن:</span><span style='font-weight:800;color:#4f46e5;font-size:13px;'>{issue.IssueNumber}</span></div>
<div style='display:flex;gap:10px;'><span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>التاريخ:</span><span style='font-size:13px;'>{issue.IssueDate:dd/MM/yyyy}</span></div>
<div style='display:flex;gap:10px;'><span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>أمر التصنيع:</span><span style='font-size:13px;'>{issue.OrderNumber}</span></div>
<div style='display:flex;gap:10px;'><span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>المنتج:</span><span style='font-size:13px;'>{issue.ProductName}</span></div>
<div style='display:flex;gap:10px;'><span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>المخزن:</span><span style='font-size:13px;'>{issue.WarehouseName}</span></div>
<div style='display:flex;gap:10px;'><span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>عدد الأصناف:</span><span style='font-size:13px;'>{issue.TotalItems}</span></div>
</div>
<table style='width:100%;border-collapse:collapse;border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;margin-bottom:8px;'>
<thead><tr style='background:#f8fafc;'>
<th style='{thStyle}text-align:center;width:40px;'>#</th><th style='{thStyle}'>كود الصنف</th><th style='{thStyle}'>اسم الصنف</th>
<th style='{thStyle}text-align:center;'>المطلوب</th><th style='{thStyle}text-align:center;'>المصروف</th>
<th style='{thStyle}text-align:center;'>الوحدة</th><th style='{thStyle}text-align:left;'>التكلفة (ج.م)</th>
</tr></thead><tbody>{rows}</tbody>
<tfoot><tr style='background:#f8fafc;'><td colspan='6' style='{tdStyle}font-weight:700;text-align:left;color:#374151;'>الإجمالي</td>
<td style='{tdStyle}text-align:left;font-weight:800;color:#10b981;font-size:14px;'>{issue.TotalCost:N2}</td></tr></tfoot>
</table>
<div style='margin-top:40px;padding-top:18px;border-top:2px solid #e5e7eb;text-align:center;color:#94a3b8;font-size:12px;'>
<p>تاريخ الطباعة: {DateTime.Now:yyyy/MM/dd - hh:mm tt}</p><p style='margin-top:4px;'>واي كي كوتينج ERP — نظام تخطيط موارد المؤسسات</p>
</div></body></html>";
    }
}