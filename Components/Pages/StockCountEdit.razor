@page "/stock-counts/new"
@page "/stock-counts/edit/{CountId:int}"
@page "/stock-counts/view/{CountId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject InventoryService InvService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<StockCountEdit> Logger

<PageTitle>@pageTitle - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>}
else if (isStockCountPermissionsLoading)
{
    <div class="no-access-luxury" dir="rtl" role="status"><div class="loading-luxury"><div class="loader-luxury"></div><p>جارٍ التحقق من صلاحيات الجرد...</p></div></div>
}
else if (stockCountPermissionsLoadFailed)
{
    <div class="no-access-luxury" dir="rtl" role="alert"><h4>@stockCountPermissionsLoadError</h4><button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadStockCountEditPermissionsAsync" disabled="@isStockCountPermissionsLoading">إعادة المحاولة</button></div>
}
else if (stockCountPermissionsLoadDenied)
{
    <div class="no-access-luxury" dir="rtl" role="alert"><h4>@stockCountPermissionsLoadError</h4><button class="btn-luxury btn-ghost-luxury" @onclick="GoToStockCountEditLogin">تسجيل الدخول مجددًا</button></div>
}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div>}
else
{
    <div class="luxury-doc-page" dir="rtl">
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <button class="btn-luxury btn-back-luxury" @onclick="GoBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19 7-7-7-7"/></svg>رجوع</button>
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">@pageTitle</h2><div class="lh-meta">@if (!string.IsNullOrEmpty(header.CountNumber)){<code class="doc-num-luxury">@header.CountNumber</code><span class="status-badge-luxury" style="--sc:@InventoryService.GetCountStatusColor(header.CountStatus)">@InventoryService.GetCountStatusName(header.CountStatus)</span>}</div></div>
                </div>
                <div class="lh-actions"><div class="workflow-mini"><span class="wm-dot">رصيد</span><span class="wm-line"></span><span class="wm-dot">تحويل</span><span class="wm-line"></span><span class="wm-dot active">جرد</span><span class="wm-line"></span><span class="wm-dot">حركة</span></div></div>
            </div>
        </div>

        @if (isRefreshingCountHeader && CountHeaderRefreshForCurrentDocument)
        {
            <div class="loading-luxury" role="status" style="padding:14px">جارٍ تحديث بيانات رأس الجرد بعد العملية...</div>
        }
        else if (countHeaderRefreshFailed && CountHeaderRefreshForCurrentDocument)
        {
            <div class="msg-luxury msg-error" role="alert">@countHeaderRefreshError <button class="btn-luxury btn-ghost-luxury" @onclick="RetryCountHeaderRefreshAsync" disabled="@(isRefreshingCountHeader || isSaving)">إعادة المحاولة</button></div>
        }

        @if (isLoadingInitialCountHeader && InitialCountHeaderLoadForCurrentDocument)
        {
            <div class="loading-luxury" role="status" style="padding:14px">جارٍ تحميل رأس الجرد...</div>
        }
        else if (initialCountHeaderLoadFailed && InitialCountHeaderLoadForCurrentDocument)
        {
            <div class="msg-luxury msg-error" role="alert">@initialCountHeaderLoadError <button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadInitialCountHeaderAsync" disabled="@isLoadingInitialCountHeader">إعادة المحاولة</button></div>
        }

        @if (isRefreshingCountDetails && CountDetailsRefreshForCurrentDocument)
        {
            <div class="loading-luxury" role="status" style="padding:14px">جارٍ تحديث تفاصيل أصناف الجرد بعد العملية...</div>
        }
        else if (countDetailsRefreshFailed && CountDetailsRefreshForCurrentDocument)
        {
            <div class="msg-luxury msg-error" role="alert">@countDetailsRefreshError <button class="btn-luxury btn-ghost-luxury" @onclick="RetryCountDetailsRefreshAsync" disabled="@(isRefreshingCountDetails || isSaving)">إعادة المحاولة</button></div>
        }

        @if (isLoadingInitialCountDetails && InitialCountDetailsLoadForCurrentDocument)
        {
            <div class="loading-luxury" role="status" style="padding:14px">جارٍ تحميل تفاصيل أصناف الجرد...</div>
        }
        else if (initialCountDetailsLoadFailed && InitialCountDetailsLoadForCurrentDocument)
        {
            <div class="msg-luxury msg-error" role="alert">@initialCountDetailsLoadError <button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadInitialCountDetailsAsync" disabled="@isLoadingInitialCountDetails">إعادة المحاولة</button></div>
        }

        @if (countHeaderRefreshDenied && CountHeaderRefreshForCurrentDocument)
        {
            <div class="no-access-luxury" dir="rtl" role="alert"><h4>@countHeaderRefreshError</h4><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">العودة لأوامر الجرد</button></div>
        }
        else if (countDetailsRefreshDenied && CountDetailsRefreshForCurrentDocument)
        {
            <div class="no-access-luxury" dir="rtl" role="alert"><h4>@countDetailsRefreshError</h4><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">العودة لأوامر الجرد</button></div>
        }
        else if (initialCountHeaderLoadDenied && InitialCountHeaderLoadForCurrentDocument)
        {
            <div class="no-access-luxury" dir="rtl" role="alert"><h4>@initialCountHeaderLoadError</h4><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">العودة لأوامر الجرد</button></div>
        }
        else if (initialCountHeaderNotFound && InitialCountHeaderLoadForCurrentDocument)
        {
            <div class="no-access-luxury" dir="rtl" role="alert"><h4>@initialCountHeaderLoadError</h4><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">العودة لأوامر الجرد</button></div>
        }
        else if (initialCountDetailsLoadDenied && InitialCountDetailsLoadForCurrentDocument)
        {
            <div class="no-access-luxury" dir="rtl" role="alert"><h4>@initialCountDetailsLoadError</h4><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">العودة لأوامر الجرد</button></div>
        }
        else if (isLoading) { <div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div> }
        else if (CountHeaderRefreshBlocksDocument || CountDetailsRefreshBlocksDocument || InitialCountHeaderLoadBlocksDocument || InitialCountDetailsLoadBlocksDocument)
        {
            <div class="loading-luxury" role="status"><p>لن تُعرض بيانات الجرد حتى تكتمل قراءتها؛ أعد المحاولة قبل المتابعة.</p></div>
        }
        else
        {
            <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h3 class="sec-title-luxury">بيانات الجرد</h3></div>
                <div class="form-grid-luxury c4">
                    <div class="f-field-luxury"><label class="f-label-luxury">الرقم</label><input type="text" class="f-input-luxury readonly" value="@(header.CountNumber ?? "تلقائي")" disabled /></div>
                    <div class="f-field-luxury"><label class="f-label-luxury required">التاريخ</label><input type="date" class="f-input-luxury" @bind="header.CountDate" disabled="@isReadOnly" /></div>
                    <div class="f-field-luxury"><label class="f-label-luxury required">المخزن</label><select class="f-input-luxury" @bind="header.WarehouseID" disabled="@(isReadOnly || CountId > 0)"><option value="0">-- اختر --</option>@if (WarehousesLoadedForCurrentUser){@foreach (var w in warehouses!){<option value="@w.Id">@w.Name</option>}}</select>@if (isLoadingWarehouses){<small role="status">جارٍ تحميل خيارات المخازن...</small>}else if(warehousesLoadFailed){<div class="msg-luxury msg-error" role="alert">@warehousesLoadError <button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadCountWarehousesAsync" disabled="@isLoadingWarehouses">إعادة المحاولة</button></div>}else if(warehousesLoadDenied){<div class="msg-luxury msg-error" role="alert">@warehousesLoadError</div>}</div>
                    <div class="f-field-luxury"><label class="f-label-luxury required">النوع</label><select class="f-input-luxury" @bind="header.CountType" disabled="@(isReadOnly || CountId > 0)"><option value="1">جرد شامل</option><option value="2">جرد جزئي</option><option value="3">جرد عشوائي</option></select></div>
                    @if (header.CountType == 2)
                    {
                        <div class="f-field-luxury"><label class="f-label-luxury">التصنيف</label><select class="f-input-luxury" @bind="header.CategoryID" disabled="@(isReadOnly || CountId > 0)"><option value="0">الكل</option>@if (CategoriesLoadedForCurrentUser){@foreach (var c in categories!){<option value="@c.Id">@c.Name</option>}}</select></div>
                    }
                    <div class="f-field-luxury"><label class="f-label-luxury">القائم بالعد والجرد</label><select class="f-input-luxury" @bind="header.CountedBy" disabled="@isReadOnly"><option value="0">--</option>@if (EmployeesLoadedForCurrentUser){@foreach (var e in employees!){<option value="@e.Id">@e.Name</option>}}</select></div>
                    <div class="f-field-luxury"><label class="f-label-luxury">المشرف</label><select class="f-input-luxury" @bind="header.SupervisorID" disabled="@isReadOnly"><option value="0">--</option>@if (EmployeesLoadedForCurrentUser){@foreach (var e in employees!){<option value="@e.Id">@e.Name</option>}}</select>@if (isLoadingEmployees){<small role="status">جارٍ تحميل خيارات الموظفين...</small>}else if(employeesLoadFailed){<div class="msg-luxury msg-error" role="alert">@employeesLoadError <button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadCountEmployeesAsync" disabled="@isLoadingEmployees">إعادة المحاولة</button></div>}else if(employeesLoadDenied){<div class="msg-luxury msg-error" role="alert">@employeesLoadError</div>}</div>
                    <div class="f-field-luxury"><label class="f-label-luxury">ملاحظات</label><input type="text" class="f-input-luxury" @bind="header.Notes" disabled="@isReadOnly" /></div>
                </div>
            </div>

            @if (isLoadingCategories)
            {
                <div class="loading-luxury" role="status"><p>جارٍ تحميل خيارات تصنيفات الجرد...</p></div>
            }
            else if (categoriesLoadFailed)
            {
                <div class="msg-luxury msg-error" role="alert">@categoriesLoadError <button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadCountCategoriesAsync" disabled="@isLoadingCategories">إعادة المحاولة</button></div>
            }
            else if (categoriesLoadDenied)
            {
                <div class="msg-luxury msg-error" role="alert">@categoriesLoadError</div>
            }

            @if (CountId > 0 && details.Any())
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><h3 class="sec-title-luxury">أصناف الجرد</h3><span class="sec-badge-luxury">@details.Count سطر | تم جرد @details.Count(d => d.CountedQty.HasValue)</span><span class="total-mini-luxury">فرق: @details.Sum(d=>d.VarianceValue).ToString("#,##0.00")</span></div>
                    <div class="tbl-card-luxury"><div class="table-responsive"><table class="tbl-luxury"><thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th>الباتش</th><th class="tc">الدفتري</th><th class="tc">الفعلي</th><th class="tc">الفرق</th><th class="tl">قيمة الفرق</th>@if (header.CountStatus == 3 && permissions.CanApprove){<th class="tc">اعتماد</th>}</tr></thead><tbody>@{int n=0;}@foreach (var d in details){n++;var variance=(d.CountedQty ?? 0)-d.SystemQty;<tr class="@(variance!=0?(variance>0?"row-surplus":"row-shortage"):"")"><td class="td-n">@n</td><td><code class="code-tag-luxury">@d.ItemCode</code></td><td class="td-bold">@d.ItemNameAr</td><td class="td-muted">@d.UnitName</td><td class="td-muted">@(string.IsNullOrWhiteSpace(d.BatchNumber) ? "—" : d.BatchNumber)</td><td class="tc num-cell">@d.SystemQty.ToString("#,##0.##")</td><td class="tc">@if (!isReadOnly && permissions.CanEdit && header.CountStatus <= 2){<input type="number" class="count-input-luxury" value="@d.CountedQty" @onchange="(e) => OnCountedQtyChanged(d.CountDetailID, e)" step="0.01" />}else{<span class="num-cell">@(d.CountedQty?.ToString("#,##0.##") ?? "—")</span>}</td><td class="tc num-cell">@if (d.CountedQty.HasValue){<strong class="@(variance>0?"var-surplus":variance<0?"var-shortage":"")">@variance.ToString("+#,##0.##;-#,##0.##;0")</strong>}else{<span>—</span>}</td><td class="tl num-cell">@(d.CountedQty.HasValue ? d.VarianceValue.ToString("#,##0.00") : "—")</td>@if (header.CountStatus == 3 && permissions.CanApprove){<td class="tc">@if (variance != 0){<label class="chk-luxury"><input type="checkbox" checked="@d.AdjustmentApproved" @onchange="(e) => OnApprovalChanged(d.CountDetailID, e)" /><span class="chk-box"></span></label>}</td>}</tr>}</tbody><tfoot><tr class="total-row-luxury"><td colspan="7" class="tl"><strong>الإجمالي</strong></td><td class="tc num-cell"><strong>@details.Where(d => d.CountedQty.HasValue).Sum(d => (d.CountedQty ?? 0) - d.SystemQty).ToString("+#,##0.##;-#,##0.##;0")</strong></td><td class="tl num-cell"><strong>@details.Sum(d => d.VarianceValue).ToString("#,##0.00") ج.م</strong></td>@if (header.CountStatus == 3 && permissions.CanApprove){<td></td>}</tr></tfoot></table></div></div>
                </div>
            }

            <div class="doc-actions-luxury"><div class="ml-gold-line"></div><div class="doc-actions-right">
                @if (isNewMode && permissions.CanAdd){<button class="btn-luxury btn-primary-luxury" @onclick="CreateCount" disabled="@(isSaving || CountHeaderRefreshFailedForCurrentDocument || CountDetailsRefreshFailedForCurrentDocument)">@if(isSaving){<div class="btn-spinner-sm"></div>}إنشاء وتحميل الأصناف</button>}
                else if (!isNewMode && header.CountStatus <= 2 && !isViewMode && permissions.CanEdit){<button class="btn-luxury btn-primary-luxury" @onclick="SaveCountedQties" disabled="@(isSaving || CountHeaderRefreshFailedForCurrentDocument || CountDetailsRefreshFailedForCurrentDocument)">@if(isSaving){<div class="btn-spinner-sm"></div>}حفظ الكميات الفعلية</button>}
                else if (header.CountStatus == 3 && permissions.CanApprove && !isViewMode){<button class="btn-luxury btn-approve-quick" @onclick="ApproveAdjustments" disabled="@(isSaving || CountHeaderRefreshFailedForCurrentDocument || CountDetailsRefreshFailedForCurrentDocument)">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg>}اعتماد التسويات</button>}
            </div><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">رجوع</button></div>
        }
    </div>
    @if (!string.IsNullOrEmpty(toast)) { <div class="toast-luxury"><div class="toast-card-luxury @(toastOk ? "success" : "error")"><span>@toast</span><button @onclick='() => toast = ""'><i class=bi-x-lg></i></button></div></div> }
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--border-gold:rgba(212,175,55,.18)}
.luxury-doc-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1300px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,#121A2E 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25);overflow:hidden}
.lh-title{font-size:1.15rem;font-weight:900;color:#F5E6C8;margin:0}
.lh-meta{display:flex;gap:8px;align-items:center;margin-top:5px;flex-wrap:wrap}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:.2s;font-family:'Tajawal'}
.btn-luxury:disabled{opacity:.6}
.btn-back-luxury{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:#F5E6C8}
.btn-approve-quick{background:linear-gradient(135deg,#059669,#10b981);color:#fff;box-shadow:0 3px 12px rgba(16,185,129,.25)}
.doc-num-luxury{background:rgba(212,175,55,.15);border:1px solid rgba(212,175,55,.25);color:var(--gold);padding:4px 10px;border-radius:8px;font-weight:800;font-size:.84rem}
.status-badge-luxury{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 18%,rgba(255,255,255,.08));color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,transparent)}
.wm-dot{font-size:.66rem;font-weight:700;color:#8B95A5}
.wm-dot.active{color:var(--gold)}
.wm-line{width:10px;height:1px;background:rgba(255,255,255,.15)}
.doc-section-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:18px;padding:22px;box-shadow:0 4px 16px rgba(0,0,0,.04);overflow:hidden}
.sec-head-luxury{display:flex;align-items:center;gap:10px;margin-bottom:18px;padding-bottom:14px;border-bottom:1px solid #f1efe8;flex-wrap:wrap}
.sec-icon-luxury{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center}
.sec-icon-luxury.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}
.sec-icon-luxury.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}
.sec-icon-luxury svg{width:18px;height:18px}
.sec-title-luxury{font-weight:800;color:#0A0F1E;margin:0;font-size:.96rem}
.sec-badge-luxury{background:#f1f5f9;color:#475569;padding:4px 12px;border-radius:999px;font-size:.74rem;font-weight:700}
.total-mini-luxury{margin-right:auto;background:#fcfaf6;border:1px solid #e8e2d0;padding:4px 10px;border-radius:8px;font-weight:800;font-size:.8rem;color:#0A0F1E}
.form-grid-luxury{display:grid;gap:14px}
.c4{grid-template-columns:repeat(4,1fr)}
.f-label-luxury{font-size:.78rem;font-weight:700;color:#374151}
.required::after{content:' *';color:#ef4444}
.f-input-luxury{padding:9px 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.86rem;background:#fff;outline:none;transition:.2s;width:100%;font-family:'Tajawal'}
.f-input-luxury:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.f-input-luxury.readonly,.f-input-luxury:disabled{background:#f8fafc;color:#9ca3af}
.tbl-card-luxury{border:1px solid #e8e2d0;border-radius:14px;overflow:hidden}
.tbl-luxury{width:100%;border-collapse:collapse;min-width:900px}
.tbl-luxury thead{background:linear-gradient(135deg,#fcfaf6,#f8f6f0)}
.tbl-luxury th{padding:11px 12px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e2e2d0;white-space:nowrap}
.tbl-luxury td{padding:10px 12px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6}
.tbl-luxury tbody tr:hover{background:rgba(212,175,55,.03)}
.tbl-luxury .row-surplus{background:#ecfdf5 !important}
.tbl-luxury .row-shortage{background:#fef2f2 !important}
.tc{text-align:center}
.tl{text-align:left}
.td-n{text-align:center;color:#9ca3af}
.td-bold{font-weight:700;color:#0A0F1E}
.td-muted{color:#9ca3af}
.num-cell{font-family:monospace;font-weight:600}
.code-tag-luxury{background:#f1f5f9;padding:2px 8px;border-radius:6px;font-size:.76rem;color:#2563eb;font-weight:600}
.total-row-luxury{background:#fcfaf6 !important}
.total-row-luxury td{border-top:2px solid #e2e2d0;padding:12px}
.count-input-luxury{width:110px;padding:6px 10px;border:1.5px solid var(--gold);border-radius:8px;font-size:.86rem;text-align:center;background:#fcfaf6;font-weight:800;font-family:'Tajawal';outline:none;transition:.2s}
.count-input-luxury:focus{border-color:var(--gold-dark);box-shadow:0 0 0 2px rgba(212,175,55,.15);background:#fff}
.var-surplus{color:#059669}
.var-shortage{color:#dc2626}
.chk-luxury{position:relative;display:inline-flex;cursor:pointer}
.chk-luxury input{opacity:0;position:absolute}
.chk-box{width:20px;height:20px;border-radius:6px;border:1.5px solid #e8e2d0;background:#fff;display:inline-flex;align-items:center;justify-content:center;transition:.2s}
.chk-luxury input:checked + .chk-box{background:var(--gold);border-color:var(--gold);box-shadow:0 2px 6px rgba(212,175,55,.25)}
.chk-luxury input:checked + .chk-box::after{content:'<i class=bi-check2></i>';color:#fff;font-weight:800;font-size:.72rem}
.doc-actions-right{display:flex;gap:10px}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}
.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}
.no-access-luxury .na-icon{width:64px;height:64px;margin:0 auto 16px;border-radius:16px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}
.no-access-luxury .na-icon svg{width:32px;height:32px}
</style>

@code {
    [Parameter] public int CountId { get; set; }

    private StockCountHeaderDto header = new() { CountDate = DateTime.Today, CountType = 1 };
    private List<StockCountDetailDto> details = new();
    private ModulePermissionDto? permissions;
    private bool isStockCountPermissionsLoading;
    private bool stockCountPermissionsLoadFailed, stockCountPermissionsLoadDenied;
    private int stockCountPermissionsLoadVersion;
    private string stockCountPermissionsLoadError = string.Empty;
    private List<LookupDto>? warehouses, employees, categories;
    private bool isLoadingEmployees = true;
    private bool employeesLoadFailed, employeesLoadDenied;
    private int employeesLoadVersion;
    private string employeesLoadError = string.Empty;
    private int? employeesLoadedUserId;
    private bool EmployeesLoadedForCurrentUser =>
        UserSession.IsLoggedIn && employees is not null && employeesLoadedUserId == UserSession.UserID;
    private bool isLoadingCategories = true;
    private bool categoriesLoadFailed, categoriesLoadDenied;
    private int categoriesLoadVersion;
    private string categoriesLoadError = string.Empty;
    private int? categoriesLoadedUserId;
    private bool CategoriesLoadedForCurrentUser =>
        UserSession.IsLoggedIn && categories is not null && categoriesLoadedUserId == UserSession.UserID;
    private bool isLoadingWarehouses = true;
    private bool warehousesLoadFailed, warehousesLoadDenied;
    private int warehousesLoadVersion;
    private string warehousesLoadError = string.Empty;
    private int? warehousesLoadedUserId;
    private bool WarehousesLoadedForCurrentUser =>
        UserSession.IsLoggedIn && warehouses is not null && warehousesLoadedUserId == UserSession.UserID;

    private bool isLoading = true, isSaving = false;
    private bool isRefreshingCountHeader;
    private bool countHeaderRefreshFailed, countHeaderRefreshDenied;
    private int countHeaderRefreshVersion;
    private int? countHeaderRefreshCountId, countHeaderRefreshUserId;
    private string countHeaderRefreshError = string.Empty;
    private bool CountHeaderRefreshForCurrentDocument =>
        UserSession.IsLoggedIn && countHeaderRefreshCountId == CountId && countHeaderRefreshUserId == UserSession.UserID;
    private bool CountHeaderRefreshFailedForCurrentDocument =>
        CountHeaderRefreshForCurrentDocument && (countHeaderRefreshFailed || countHeaderRefreshDenied);
    private bool isRefreshingCountDetails;
    private bool countDetailsRefreshFailed, countDetailsRefreshDenied;
    private int countDetailsRefreshVersion;
    private int? countDetailsRefreshCountId, countDetailsRefreshUserId;
    private string countDetailsRefreshError = string.Empty;
    private bool CountDetailsRefreshForCurrentDocument =>
        UserSession.IsLoggedIn && countDetailsRefreshCountId == CountId && countDetailsRefreshUserId == UserSession.UserID;
    private bool CountDetailsRefreshFailedForCurrentDocument =>
        CountDetailsRefreshForCurrentDocument && (countDetailsRefreshFailed || countDetailsRefreshDenied);
    private bool CountHeaderRefreshBlocksDocument =>
        CountHeaderRefreshForCurrentDocument && (isRefreshingCountHeader || countHeaderRefreshFailed || countHeaderRefreshDenied);
    private bool CountDetailsRefreshBlocksDocument =>
        CountDetailsRefreshForCurrentDocument && (isRefreshingCountDetails || countDetailsRefreshFailed || countDetailsRefreshDenied);
    private bool isLoadingInitialCountHeader;
    private bool initialCountHeaderLoadFailed, initialCountHeaderLoadDenied, initialCountHeaderNotFound;
    private int initialCountHeaderLoadVersion;
    private int? initialCountHeaderLoadCountId, initialCountHeaderLoadUserId;
    private string initialCountHeaderLoadError = string.Empty;
    private bool InitialCountHeaderLoadForCurrentDocument =>
        UserSession.IsLoggedIn && initialCountHeaderLoadCountId == CountId && initialCountHeaderLoadUserId == UserSession.UserID;
    private bool InitialCountHeaderLoadBlocksDocument =>
        InitialCountHeaderLoadForCurrentDocument && (isLoadingInitialCountHeader || initialCountHeaderLoadFailed || initialCountHeaderLoadDenied || initialCountHeaderNotFound);
    private bool isLoadingInitialCountDetails;
    private bool initialCountDetailsLoadFailed, initialCountDetailsLoadDenied;
    private int initialCountDetailsLoadVersion;
    private int? initialCountDetailsLoadCountId, initialCountDetailsLoadUserId;
    private string initialCountDetailsLoadError = string.Empty;
    private bool InitialCountDetailsLoadForCurrentDocument =>
        UserSession.IsLoggedIn && initialCountDetailsLoadCountId == CountId && initialCountDetailsLoadUserId == UserSession.UserID;
    private bool InitialCountDetailsLoadBlocksDocument =>
        InitialCountDetailsLoadForCurrentDocument && (isLoadingInitialCountDetails || initialCountDetailsLoadFailed || initialCountDetailsLoadDenied);
    private string toast = ""; private bool toastOk = true;

    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => CountId == 0;
    private bool isReadOnly => isViewMode || header.CountStatus >= 4;
    private string pageTitle => isNewMode ? "جرد جديد" : isViewMode ? "عرض الجرد" : header.CountStatus == 3 ? "اعتماد الجرد" : "إدخال الجرد";

    private Dictionary<int, decimal?> countedChanges = new();
    private HashSet<int> approvedIds = new();

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (await LoadStockCountEditPermissionsAsync() && permissions?.CanView == true)
            await LoadStockCountEditPageDataAsync();
    }

    private async Task<bool> LoadStockCountEditPermissionsAsync()
    {
        if (isStockCountPermissionsLoading) return false;

        var requestVersion = ++stockCountPermissionsLoadVersion;
        var userId = UserSession.UserID;
        var pageUri = Navigation.Uri;
        isStockCountPermissionsLoading = true;
        stockCountPermissionsLoadFailed = false;
        stockCountPermissionsLoadDenied = false;
        stockCountPermissionsLoadError = string.Empty;
        permissions = null;
        StateHasChanged();

        try
        {
            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(userId);

            if (!IsCurrentStockCountEditPermissionsRequest(requestVersion, userId, pageUri)) return false;
            permissions = PermissionService.GetModule("SCR_COUNT");
            return true;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading stock count edit page permissions for user {UserID}.", userId);
            if (!IsCurrentStockCountEditPermissionsRequest(requestVersion, userId, pageUri)) return false;
            stockCountPermissionsLoadDenied = true;
            stockCountPermissionsLoadError = "تعذر التحقق من صلاحيات الجلسة. سجّل الدخول مجددًا.";
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load stock count edit page permissions for user {UserID}.", userId);
            if (!IsCurrentStockCountEditPermissionsRequest(requestVersion, userId, pageUri)) return false;
            stockCountPermissionsLoadFailed = true;
            stockCountPermissionsLoadError = "تعذر تحميل صلاحيات الجرد. أعد المحاولة.";
            return false;
        }
        finally
        {
            if (requestVersion == stockCountPermissionsLoadVersion)
            {
                isStockCountPermissionsLoading = false;
                if (Navigation.Uri == pageUri) StateHasChanged();
            }
        }
    }

    private bool IsCurrentStockCountEditPermissionsRequest(int requestVersion, int userId, string pageUri) =>
        requestVersion == stockCountPermissionsLoadVersion && UserSession.IsLoggedIn &&
        UserSession.UserID == userId && Navigation.Uri == pageUri;

    private async Task RetryLoadStockCountEditPermissionsAsync()
    {
        if (isStockCountPermissionsLoading || !stockCountPermissionsLoadFailed) return;
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (await LoadStockCountEditPermissionsAsync() && permissions?.CanView == true)
            await LoadStockCountEditPageDataAsync();
    }

    private void GoToStockCountEditLogin() => Navigation.NavigateTo("/login", forceLoad: true);

    private async Task LoadStockCountEditPageDataAsync()
    {
        isLoading = true;
        try
        {
            await LoadCountWarehousesAsync();
            await LoadCountEmployeesAsync();
            await LoadCountCategoriesAsync();
            if (CountId > 0)
            {
                var countId = CountId;
                if (await LoadInitialCountHeaderAsync(countId))
                    await LoadInitialCountDetailsAsync(countId);
            }
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task LoadCountWarehousesAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var requestVersion = ++warehousesLoadVersion;
        var userId = UserSession.UserID;
        var pageUri = Navigation.Uri;
        if (warehousesLoadedUserId.HasValue && warehousesLoadedUserId != userId)
        {
            warehouses = null;
            warehousesLoadedUserId = null;
        }

        isLoadingWarehouses = true;
        warehousesLoadFailed = false;
        warehousesLoadDenied = false;
        warehousesLoadError = string.Empty;
        StateHasChanged();

        try
        {
            var result = await LookupService.GetWarehousesAsync();
            if (!IsCurrentCountWarehouseLoad(requestVersion, userId, pageUri)) return;
            warehouses = result;
            warehousesLoadedUserId = userId;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading stock count warehouse options for user {UserID}.", userId);
            if (!IsCurrentCountWarehouseLoad(requestVersion, userId, pageUri)) return;
            warehouses = null;
            warehousesLoadedUserId = null;
            warehousesLoadDenied = true;
            warehousesLoadError = "ليس لديك صلاحية تحميل خيارات المخازن.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load stock count warehouse options for user {UserID}.", userId);
            if (!IsCurrentCountWarehouseLoad(requestVersion, userId, pageUri)) return;
            warehousesLoadFailed = true;
            warehousesLoadError = WarehousesLoadedForCurrentUser
                ? "تعذر تحديث خيارات المخازن؛ آخر الخيارات الناجحة ما زالت متاحة. أعد المحاولة."
                : "تعذر تحميل خيارات المخازن. أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == warehousesLoadVersion)
            {
                isLoadingWarehouses = false;
                if (Navigation.Uri == pageUri) StateHasChanged();
            }
        }
    }

    private bool IsCurrentCountWarehouseLoad(int requestVersion, int userId, string pageUri) =>
        requestVersion == warehousesLoadVersion && UserSession.IsLoggedIn &&
        UserSession.UserID == userId && Navigation.Uri == pageUri;

    private async Task RetryLoadCountWarehousesAsync()
    {
        if (isLoadingWarehouses || !warehousesLoadFailed) return;
        await LoadCountWarehousesAsync();
    }

    private async Task LoadCountEmployeesAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var requestVersion = ++employeesLoadVersion;
        var userId = UserSession.UserID;
        var pageUri = Navigation.Uri;
        if (employeesLoadedUserId.HasValue && employeesLoadedUserId != userId)
        {
            employees = null;
            employeesLoadedUserId = null;
        }

        isLoadingEmployees = true;
        employeesLoadFailed = false;
        employeesLoadDenied = false;
        employeesLoadError = string.Empty;
        StateHasChanged();

        try
        {
            var result = await LookupService.GetEmployeesAsync();
            if (!IsCurrentCountEmployeesLoad(requestVersion, userId, pageUri)) return;
            employees = result;
            employeesLoadedUserId = userId;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading stock count employee options for user {UserID}.", userId);
            if (!IsCurrentCountEmployeesLoad(requestVersion, userId, pageUri)) return;
            employees = null;
            employeesLoadedUserId = null;
            employeesLoadDenied = true;
            employeesLoadError = "ليس لديك صلاحية تحميل خيارات الموظفين.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load stock count employee options for user {UserID}.", userId);
            if (!IsCurrentCountEmployeesLoad(requestVersion, userId, pageUri)) return;
            employeesLoadFailed = true;
            employeesLoadError = EmployeesLoadedForCurrentUser
                ? "تعذر تحديث خيارات الموظفين؛ آخر الخيارات الناجحة ما زالت متاحة. أعد المحاولة."
                : "تعذر تحميل خيارات الموظفين. أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == employeesLoadVersion)
            {
                isLoadingEmployees = false;
                if (Navigation.Uri == pageUri) StateHasChanged();
            }
        }
    }

    private bool IsCurrentCountEmployeesLoad(int requestVersion, int userId, string pageUri) =>
        requestVersion == employeesLoadVersion && UserSession.IsLoggedIn &&
        UserSession.UserID == userId && Navigation.Uri == pageUri;

    private async Task RetryLoadCountEmployeesAsync()
    {
        if (isLoadingEmployees || !employeesLoadFailed) return;
        await LoadCountEmployeesAsync();
    }

    private async Task LoadCountCategoriesAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var requestVersion = ++categoriesLoadVersion;
        var userId = UserSession.UserID;
        var pageUri = Navigation.Uri;
        if (categoriesLoadedUserId.HasValue && categoriesLoadedUserId != userId)
        {
            categories = null;
            categoriesLoadedUserId = null;
        }

        isLoadingCategories = true;
        categoriesLoadFailed = false;
        categoriesLoadDenied = false;
        categoriesLoadError = string.Empty;
        StateHasChanged();

        try
