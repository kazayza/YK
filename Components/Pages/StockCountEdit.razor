            var result = await LookupService.GetCategoriesAsync();
            if (!IsCurrentCountCategoriesLoad(requestVersion, userId, pageUri)) return;
            categories = result;
            categoriesLoadedUserId = userId;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading stock count category options for user {UserID}.", userId);
            if (!IsCurrentCountCategoriesLoad(requestVersion, userId, pageUri)) return;
            categories = null;
            categoriesLoadedUserId = null;
            categoriesLoadDenied = true;
            categoriesLoadError = "ليس لديك صلاحية تحميل خيارات تصنيفات الجرد.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load stock count category options for user {UserID}.", userId);
            if (!IsCurrentCountCategoriesLoad(requestVersion, userId, pageUri)) return;
            categoriesLoadFailed = true;
            categoriesLoadError = CategoriesLoadedForCurrentUser
                ? "تعذر تحديث خيارات التصنيفات؛ آخر الخيارات الناجحة ما زالت متاحة. أعد المحاولة."
                : "تعذر تحميل خيارات تصنيفات الجرد. أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == categoriesLoadVersion)
            {
                isLoadingCategories = false;
                if (Navigation.Uri == pageUri) StateHasChanged();
            }
        }
    }

    private bool IsCurrentCountCategoriesLoad(int requestVersion, int userId, string pageUri) =>
        requestVersion == categoriesLoadVersion && UserSession.IsLoggedIn &&
        UserSession.UserID == userId && Navigation.Uri == pageUri;

    private async Task RetryLoadCountCategoriesAsync()
    {
        if (isLoadingCategories || !categoriesLoadFailed) return;
        await LoadCountCategoriesAsync();
    }

    private void OnCountedQtyChanged(int detailId, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var qty))
        {
            countedChanges[detailId] = qty;
            var item = details.FirstOrDefault(d => d.CountDetailID == detailId);
            if (item != null) { item.CountedQty = qty; item.VarianceValue = (qty - item.SystemQty) * item.UnitCost; }
        }
        else
        {
            countedChanges[detailId] = null;
            var item = details.FirstOrDefault(d => d.CountDetailID == detailId);
            if (item != null) { item.CountedQty = null; item.VarianceValue = 0; }
        }
        StateHasChanged();
    }

    private void OnApprovalChanged(int detailId, ChangeEventArgs e)
    {
        var val = (bool)(e.Value ?? false);
        if (val) approvedIds.Add(detailId); else approvedIds.Remove(detailId);
        var item = details.FirstOrDefault(d => d.CountDetailID == detailId);
        if (item != null) item.AdjustmentApproved = val;
    }

    private async Task<bool> LoadInitialCountHeaderAsync(int countId)
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return false;
        }

        var requestVersion = ++initialCountHeaderLoadVersion;
        var userId = UserSession.UserID;
        var pageUri = Navigation.Uri;
        if (initialCountHeaderLoadCountId != countId || initialCountHeaderLoadUserId != userId)
            header = new StockCountHeaderDto { CountDate = DateTime.Today, CountType = 1 };
        initialCountHeaderLoadCountId = countId;
        initialCountHeaderLoadUserId = userId;
        isLoadingInitialCountHeader = true;
        initialCountHeaderLoadFailed = false;
        initialCountHeaderLoadDenied = false;
        initialCountHeaderNotFound = false;
        initialCountHeaderLoadError = string.Empty;
        StateHasChanged();

        try
        {
            var result = await InvService.GetCountByIdAsync(countId);
            if (!IsCurrentInitialCountHeaderLoad(requestVersion, countId, userId, pageUri)) return false;
            if (result is null)
            {
                initialCountHeaderNotFound = true;
                initialCountHeaderLoadError = "أمر الجرد غير موجود";
                return false;
            }

            header = result;
            return true;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading initial stock count header {CountID} for user {UserID}.", countId, userId);
            if (!IsCurrentInitialCountHeaderLoad(requestVersion, countId, userId, pageUri)) return false;
            initialCountHeaderLoadDenied = true;
            initialCountHeaderLoadError = "ليس لديك صلاحية تحميل بيانات رأس الجرد.";
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load initial stock count header {CountID} for user {UserID}.", countId, userId);
            if (!IsCurrentInitialCountHeaderLoad(requestVersion, countId, userId, pageUri)) return false;
            initialCountHeaderLoadFailed = true;
            initialCountHeaderLoadError = "تعذر تحميل بيانات رأس الجرد. أعد المحاولة.";
            return false;
        }
        finally
        {
            if (requestVersion == initialCountHeaderLoadVersion)
            {
                isLoadingInitialCountHeader = false;
                if (Navigation.Uri == pageUri) StateHasChanged();
            }
        }
    }

    private bool IsCurrentInitialCountHeaderLoad(int requestVersion, int countId, int userId, string pageUri) =>
        requestVersion == initialCountHeaderLoadVersion && CountId == countId && UserSession.IsLoggedIn &&
        UserSession.UserID == userId && Navigation.Uri == pageUri;

    private async Task RetryLoadInitialCountHeaderAsync()
    {
        if (isLoadingInitialCountHeader || !initialCountHeaderLoadFailed || !InitialCountHeaderLoadForCurrentDocument) return;
        var countId = CountId;
        if (await LoadInitialCountHeaderAsync(countId))
            await LoadInitialCountDetailsAsync(countId);
    }

    private async Task LoadInitialCountDetailsAsync(int countId)
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var requestVersion = ++initialCountDetailsLoadVersion;
        var userId = UserSession.UserID;
        var pageUri = Navigation.Uri;
        if (initialCountDetailsLoadCountId != countId || initialCountDetailsLoadUserId != userId)
            details.Clear();
        initialCountDetailsLoadCountId = countId;
        initialCountDetailsLoadUserId = userId;
        isLoadingInitialCountDetails = true;
        initialCountDetailsLoadFailed = false;
        initialCountDetailsLoadDenied = false;
        initialCountDetailsLoadError = string.Empty;
        StateHasChanged();

        try
        {
            var result = await InvService.GetCountDetailsAsync(countId);
            if (!IsCurrentInitialCountDetailsLoad(requestVersion, countId, userId, pageUri)) return;
            details = result;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading initial stock count details {CountID} for user {UserID}.", countId, userId);
            if (!IsCurrentInitialCountDetailsLoad(requestVersion, countId, userId, pageUri)) return;
            details.Clear();
            initialCountDetailsLoadDenied = true;
            initialCountDetailsLoadError = "ليس لديك صلاحية تحميل تفاصيل الجرد.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load initial stock count details {CountID} for user {UserID}.", countId, userId);
            if (!IsCurrentInitialCountDetailsLoad(requestVersion, countId, userId, pageUri)) return;
            initialCountDetailsLoadFailed = true;
            initialCountDetailsLoadError = "تعذر تحميل تفاصيل أصناف الجرد. أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == initialCountDetailsLoadVersion)
            {
                isLoadingInitialCountDetails = false;
                if (Navigation.Uri == pageUri) StateHasChanged();
            }
        }
    }

    private bool IsCurrentInitialCountDetailsLoad(int requestVersion, int countId, int userId, string pageUri) =>
        requestVersion == initialCountDetailsLoadVersion && CountId == countId && UserSession.IsLoggedIn &&
        UserSession.UserID == userId && Navigation.Uri == pageUri;

    private async Task RetryLoadInitialCountDetailsAsync()
    {
        if (isLoadingInitialCountDetails || !initialCountDetailsLoadFailed || !InitialCountDetailsLoadForCurrentDocument) return;
        await LoadInitialCountDetailsAsync(CountId);
    }

    private async Task<bool> RefreshCountHeaderAfterWriteAsync(int countId)
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return false;
        }

        var requestVersion = ++countHeaderRefreshVersion;
        var userId = UserSession.UserID;
        var pageUri = Navigation.Uri;
        countHeaderRefreshCountId = countId;
        countHeaderRefreshUserId = userId;
        isRefreshingCountHeader = true;
        countHeaderRefreshFailed = false;
        countHeaderRefreshDenied = false;
        countHeaderRefreshError = string.Empty;
        StateHasChanged();

        try
        {
            var loaded = await InvService.GetCountByIdAsync(countId);
            if (!IsCurrentCountHeaderRefresh(requestVersion, countId, userId, pageUri)) return false;
            if (loaded is null)
            {
                Logger.LogWarning("Stock count header {CountID} was not found after a successful write for user {UserID}.", countId, userId);
                countHeaderRefreshFailed = true;
                countHeaderRefreshError = "تم تنفيذ العملية، لكن لم يتم العثور على بيانات رأس الجرد لتحديث الصفحة. أعد المحاولة.";
                return false;
            }

            header = loaded;
            return true;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied refreshing stock count header {CountID} for user {UserID}.", countId, userId);
            if (!IsCurrentCountHeaderRefresh(requestVersion, countId, userId, pageUri)) return false;
            countHeaderRefreshDenied = true;
            countHeaderRefreshError = "تم تنفيذ العملية، لكن تعذر تحديث بيانات الجرد بسبب صلاحية الجلسة.";
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh stock count header {CountID} for user {UserID}.", countId, userId);
            if (!IsCurrentCountHeaderRefresh(requestVersion, countId, userId, pageUri)) return false;
            countHeaderRefreshFailed = true;
            countHeaderRefreshError = "تم تنفيذ العملية، لكن تعذر تحديث بيانات الجرد. أعد المحاولة.";
            return false;
        }
        finally
        {
            if (requestVersion == countHeaderRefreshVersion)
            {
                isRefreshingCountHeader = false;
                if (Navigation.Uri == pageUri) StateHasChanged();
            }
        }
    }

    private bool IsCurrentCountHeaderRefresh(int requestVersion, int countId, int userId, string pageUri) =>
        requestVersion == countHeaderRefreshVersion && CountId == countId && UserSession.IsLoggedIn &&
        UserSession.UserID == userId && Navigation.Uri == pageUri;

    private async Task RetryCountHeaderRefreshAsync()
    {
        if (isRefreshingCountHeader || isSaving || !countHeaderRefreshFailed || !CountHeaderRefreshForCurrentDocument) return;
        await RefreshCountHeaderAfterWriteAsync(CountId);
    }

    private async Task<bool> RefreshCountDetailsAfterWriteAsync(int countId)
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return false;
        }

        var requestVersion = ++countDetailsRefreshVersion;
        var userId = UserSession.UserID;
        var pageUri = Navigation.Uri;
        countDetailsRefreshCountId = countId;
        countDetailsRefreshUserId = userId;
        isRefreshingCountDetails = true;
        countDetailsRefreshFailed = false;
        countDetailsRefreshDenied = false;
        countDetailsRefreshError = string.Empty;
        StateHasChanged();

        try
        {
            var result = await InvService.GetCountDetailsAsync(countId);
            if (!IsCurrentCountDetailsRefresh(requestVersion, countId, userId, pageUri)) return false;
            details = result;
            return true;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied refreshing stock count details {CountID} for user {UserID}.", countId, userId);
            if (!IsCurrentCountDetailsRefresh(requestVersion, countId, userId, pageUri)) return false;
            details.Clear();
            countDetailsRefreshDenied = true;
            countDetailsRefreshError = "تم تنفيذ العملية، لكن تعذر تحديث تفاصيل الجرد بسبب صلاحية الجلسة.";
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh stock count details {CountID} for user {UserID}.", countId, userId);
            if (!IsCurrentCountDetailsRefresh(requestVersion, countId, userId, pageUri)) return false;
            countDetailsRefreshFailed = true;
            countDetailsRefreshError = "تم تنفيذ العملية، لكن تعذر تحديث تفاصيل أصناف الجرد. أعد المحاولة.";
            return false;
        }
        finally
        {
            if (requestVersion == countDetailsRefreshVersion)
            {
                isRefreshingCountDetails = false;
                if (Navigation.Uri == pageUri) StateHasChanged();
            }
        }
    }

    private bool IsCurrentCountDetailsRefresh(int requestVersion, int countId, int userId, string pageUri) =>
        requestVersion == countDetailsRefreshVersion && CountId == countId && UserSession.IsLoggedIn &&
        UserSession.UserID == userId && Navigation.Uri == pageUri;

    private async Task RetryCountDetailsRefreshAsync()
    {
        if (isRefreshingCountDetails || isSaving || !countDetailsRefreshFailed || !CountDetailsRefreshForCurrentDocument) return;
        await RefreshCountDetailsAfterWriteAsync(CountId);
    }

    private async Task CreateCount()
    {
        if (header.WarehouseID <= 0) { toast = "اختر المخزن"; toastOk = false; StateHasChanged(); return; }
        isSaving = true; StateHasChanged();
        try
        {
            header.CountNumber = await InvService.GenerateCountNumberAsync();
            var newId = await InvService.InsertCountAsync(header, UserSession.UserID);
            CountId = newId; header.CountID = newId;
            var headerRefreshSucceeded = await RefreshCountHeaderAfterWriteAsync(newId);
            var detailsRefreshSucceeded = false;
            if (!countHeaderRefreshDenied) detailsRefreshSucceeded = await RefreshCountDetailsAfterWriteAsync(newId);
            toast = headerRefreshSucceeded && detailsRefreshSucceeded
                ? $"تم الإنشاء وتحميل {details.Count} صنف "
                : "تم إنشاء أمر الجرد بنجاح؛ راجع تنبيه تحديث البيانات وأعد المحاولة.";
            toastOk = true;
            Navigation.NavigateTo($"/stock-counts/edit/{newId}", forceLoad: false);
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task SaveCountedQties()
    {
        isSaving = true; StateHasChanged();
        try
        {
            var items = details.Select(d => (d.CountDetailID, d.CountedQty)).ToList();
            await InvService.UpdateCountedQtiesBulkAsync(CountId, items, UserSession.UserID);
            await RefreshCountHeaderAfterWriteAsync(CountId);
            if (!countHeaderRefreshDenied) await RefreshCountDetailsAfterWriteAsync(CountId);
            toast = "تم حفظ الكميات "; toastOk = true;
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task ApproveAdjustments()
    {
        var idsToApprove = details
            .Where(d => d.AdjustmentApproved && d.CountedQty.HasValue && ((d.CountedQty ?? 0) - d.SystemQty) != 0)
            .Select(d => d.CountDetailID).ToList();

        if (!idsToApprove.Any()) { toast = "حدد التسويات المطلوب اعتمادها"; toastOk = false; StateHasChanged(); return; }

        try { var c = await JS.InvokeAsync<bool>("confirm", $"هل تريد اعتماد {idsToApprove.Count} تسوية وتحديث الأرصدة؟"); if (!c) return; } catch { return; }

        isSaving = true; toast = ""; StateHasChanged();
        try
        {
            await InvService.ApproveAdjustmentsAsync(CountId, idsToApprove, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            var headerRefreshSucceeded = await RefreshCountHeaderAfterWriteAsync(CountId);
            var detailsRefreshSucceeded = false;
            if (!countHeaderRefreshDenied) detailsRefreshSucceeded = await RefreshCountDetailsAfterWriteAsync(CountId);
            isSaving = false; toast = "تم اعتماد التسويات وتحديث الأرصدة "; toastOk = true; StateHasChanged();
            if (headerRefreshSucceeded && detailsRefreshSucceeded)
            {
                await Task.Delay(2000);
                Navigation.NavigateTo("/stock-counts");
            }
        }
        catch (Exception ex) { isSaving = false; toast = "خطأ: " + ex.Message; toastOk = false; StateHasChanged(); }
    }

    private void GoBack() => Navigation.NavigateTo("/stock-counts");
}