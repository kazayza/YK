@code {
    private List<PurchaseOrderListDto>? orders;
    private List<PurchaseOrderListDto> filtered = new();
    private ModulePermissionDto? permissions;
    private string searchText = "";
    private int filterStatus = 0;
    private int filterSource = 0;
    private bool isExporting = false;
    private string toast = "";
    private bool toastOk = true;

    // Add Menu
    private bool showAddMenu = false;

    // Delete
    private bool showDeleteDialog = false;
    private PurchaseOrderListDto? deleteOrder;
    private string deleteMsg = "";

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_PO");
        if (permissions != null && permissions.CanView) await LoadData();
    }

    private async Task LoadData()
    {
        orders = await PoService.GetOrdersListAsync();
        Filter();
    }

    private void Filter()
    {
        if (orders == null) return;
        filtered = orders.Where(o =>
            (filterStatus == 0 || o.POStatus == filterStatus) &&
            (filterSource == 0 || o.POSource == filterSource) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(o.PONumber, searchText) ||
             ArabicSearchHelper.Contains(o.SupplierNameAr, searchText) ||
             ArabicSearchHelper.Contains(o.LinkedPRNumber, searchText))
        ).ToList();
    }

    private void ClearSearch() { searchText = ""; Filter(); }

    // === Add Menu ===
    private void ToggleAddMenu() { showAddMenu = !showAddMenu; }
    private void CloseAddMenu() { showAddMenu = false; }
    private void AddManual()
    {
        showAddMenu = false;
        Navigation.NavigateTo("/purchase-orders/new?source=manual");
    }
    private void AddFromPR()
    {
        showAddMenu = false;
        Navigation.NavigateTo("/purchase-orders/new?source=pr");
    }

    // === Navigation ===
    private void ViewOrder(int id)
    {
        var po = orders?.FirstOrDefault(o => o.PurchaseOrderID == id);
        if (po != null && po.POStatus == 2 && permissions != null && permissions.CanApprove)
            Navigation.NavigateTo($"/purchase-orders/edit/{id}");
        else
            Navigation.NavigateTo($"/purchase-orders/view/{id}");
    }

    private void EditOrder(int id) => Navigation.NavigateTo($"/purchase-orders/edit/{id}");

    // === Print ===
    private async Task PrintOrder(int id)
    {
        try
        {
            var html = await PoService.GenerateReportHtmlAsync(id, UserSession.UserID);
            await JS.InvokeVoidAsync("printHtml", html);
        }
        catch (Exception ex)
        {
            toast = "خطأ في الطباعة: " + ex.Message;
            toastOk = false;
        }
    }

    // === Export Excel ===
    private async Task ExportExcel()
    {
        if (!filtered.Any()) return;
        isExporting = true; StateHasChanged();
        try
        {
            var bytes = await PoService.ExportToExcelAsync(filtered, UserSession.UserID);
            await JS.InvokeVoidAsync("downloadFile",
                $"PurchaseOrders_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex)
        {
            toast = "خطأ: " + ex.Message;
            toastOk = false;
        }
        finally { isExporting = false; }
    }

    // === Delete ===
    private void ShowDeleteDialog(PurchaseOrderListDto po)
    { deleteOrder = po; deleteMsg = ""; showDeleteDialog = true; }
    private void CloseDeleteDialog() { showDeleteDialog = false; }

    private async Task ConfirmDelete()
    {
        if (deleteOrder == null) return;
        try
        {
            var result = await PoService.DeleteOrderAsync(deleteOrder.PurchaseOrderID, UserSession.UserID);
            if (result.Success)
            {
                toast = result.Message + " ✅";
                toastOk = true;
                showDeleteDialog = false;
                await LoadData();
            }
            else
            {
                deleteMsg = result.Message;
            }
        }
        catch (Exception ex) { deleteMsg = "خطأ: " + ex.Message; }
    }
}