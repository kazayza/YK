@page "/settings/number-sequences"
@using YKCoatings.Models
@using YKCoatings.Services
@inject SequenceService SequenceService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>إدارة تسلسلات الأرقام -   </PageTitle>

@if (!initializationComplete || isLoading)
{
    <div class="sequence-state-card" dir="rtl">
        <span class="sequence-loader"></span>
        <h2>جارٍ تجهيز إدارة التسلسلات</h2>
        <p>نتحقق من جلسة الدخول وصلاحية SCR_SETTINGS، ثم نقرأ الإعدادات دون استهلاك أي رقم.</p>
    </div>
}
else if (!UserSession.IsLoggedIn)
{
    <div class="sequence-state-card" dir="rtl">
        <h2>يلزم تسجيل الدخول</h2>
        <p>سجّل الدخول لعرض إعدادات أرقام المستندات.</p>
        <button class="sequence-button secondary" @onclick='() => Navigation.NavigateTo("/login")'>تسجيل الدخول</button>
    </div>
}
else if (!canView)
{
    <div class="sequence-state-card" dir="rtl">
        <span class="sequence-eyebrow">ACCESS CONTROL</span>
        <h2>لا تتوفر صلاحية عرض الإعدادات</h2>
        <p>تتطلب هذه الشاشة صلاحية العرض على SCR_SETTINGS. تُفحص الصلاحية أيضاً داخل الخدمة قبل قراءة البيانات أو حفظها.</p>
        <button class="sequence-button secondary" @onclick='() => Navigation.NavigateTo("/settings")'>العودة إلى الإعدادات</button>
    </div>
}
else
{
    <main class="yk-gold-page sequence-page" dir="rtl">
        <header class="sequence-hero">
            <div class="sequence-hero-top">
                <div class="sequence-brand">
                    <span class="sequence-monogram">YK</span>
                    <span class="sequence-brand-copy"><strong>  </strong><small>DOCUMENT NUMBERING</small></span>
                </div>
                <button class="sequence-button hero-back" @onclick='() => Navigation.NavigateTo("/settings")'>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18 9 12l6-6"/><path d="M9 12h11"/></svg>
                    العودة إلى الإعدادات
                </button>
            </div>
            <div class="sequence-hero-main">
                <div>
                    <span class="sequence-eyebrow">SCR_SETTINGS · إعدادات النظام</span>
                    <h1>إدارة تسلسلات الأرقام</h1>
                    <p>عرض وضبط قواعد ترقيم المستندات. المعاينة للقراءة فقط ولا تستهلك الرقم التالي.</p>
                </div>
                <div class="sequence-hero-mark" aria-hidden="true"><span>01</span><i></i><span>02</span><i></i><span>03</span></div>
            </div>
            <div class="sequence-hero-bottom"><span>تُولّد الأرقام عبر <bdi>dbo.sp_GetNextNumber</bdi></span><span class="sequence-readonly-pill"><i></i>المعاينة لا تحفظ ولا تزيد العداد</span></div>
        </header>

        <section class="sequence-warning procedure-warning">
            <span class="sequence-warning-icon" aria-hidden="true">!</span>
            <div><strong>تنبيه قبل إيقاف أي تسلسل</strong><p>الإجراء <bdi>sp_GetNextNumber</bdi> المتاح لا يفحص <bdi>IsActive</bdi> ويحدّث كل الصفوف ذات الرمز نفسه. بعض خدمات النظام تستدعيه مباشرةً؛ لذلك يَحمي فحص التفعيل داخل <bdi>SequenceService</bdi> مستهلكيه فقط، ولا يوقف جميع المسارات. أبقِ الرموز فريدة وراجع المستهلكين قبل التعطيل.</p></div>
        </section>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="sequence-alert @(statusIsError ? "error" : "success")" role="status">
                <span class="sequence-alert-mark">@if (statusIsError) { <span>!</span> } else { <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.4 4.4L19 7.5" /></svg> }</span>
                <p>@statusMessage</p>
                <button type="button" aria-label="إغلاق" @onclick="ClearStatus">×</button>
            </div>
        }

        @if (loadError)
        {
            <section class="sequence-warning" role="alert">
                <div><strong>تعذر تحميل التسلسلات</strong><p>@loadErrorMessage</p></div>
                <button class="sequence-button secondary" @onclick="() => ReloadSequencesAsync()" disabled="@isLoading">إعادة المحاولة</button>
            </section>
        }
        else
        {
            @if (!sequences.Any(s => string.Equals(s.SequenceCode, "SQ", StringComparison.OrdinalIgnoreCase)))
            {
                <section class="sequence-warning sq-notice">
                    <span class="sequence-warning-icon" aria-hidden="true">!</span>
                    <div><strong>لم يظهر سجل SQ في إعدادات قاعدة البيانات الحالية</strong><p>لم تتم تهيئته تلقائياً؛ يلزم اعتماد البادئة وقيمة البداية أولاً. لا تحفظ تسلسلاً جديداً قبل تحديدهما.</p></div>
                </section>
            }

            <section class="sequence-stats" aria-label="ملخص التسلسلات">
                <article class="sequence-stat"><span class="stat-caption">إجمالي التسلسلات</span><strong>@sequences.Count</strong><span class="stat-mark">ALL</span></article>
                <article class="sequence-stat"><span class="stat-caption">فعّالة</span><strong>@sequences.Count(s => s.IsActive)</strong><span class="stat-mark gold">LIVE</span></article>
                <article class="sequence-stat"><span class="stat-caption">موقوفة</span><strong>@sequences.Count(s => !s.IsActive)</strong><span class="stat-mark muted">OFF</span></article>
                <article class="sequence-stat"><span class="stat-caption">عداد يحتاج مراجعة</span><strong>@ReviewCount</strong><span class="stat-mark warning">CHECK</span></article>
            </section>

            <section class="sequence-workspace">
                <div class="sequence-toolbar">
                    <div class="sequence-toolbar-heading"><span class="sequence-toolbar-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="M4 5h16M4 12h16M4 19h16"/><circle cx="8" cy="5" r="1.5"/><circle cx="15" cy="12" r="1.5"/><circle cx="10" cy="19" r="1.5"/></svg>
                    </span><div><h2>قواعد الترقيم</h2><p>إعدادات <bdi>dbo.NumberSequences</bdi></p></div></div>
                    <div class="sequence-toolbar-actions">
                        <label class="sequence-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><input type="search" placeholder="بحث بالرمز أو الاسم..." @bind="searchText" @bind:event="oninput" /></label>
                        <select class="sequence-filter" aria-label="تصفية حسب الحالة" @bind="statusFilter">
                            <option value="all">كل الحالات</option><option value="active">فعّال</option><option value="inactive">موقوف</option>
                        </select>
                        <button class="sequence-button refresh-button" @onclick="() => ReloadSequencesAsync()" disabled="@isLoading" title="تحديث القائمة">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5M4 17v-5h5"/><path d="M5.6 9a7 7 0 0 1 11.8-2L20 12M4 12l2.6 5a7 7 0 0 0 11.8-2"/></svg><span>تحديث</span>
                        </button>
                        @if (canAdd)
                        {
                            <button class="sequence-button primary" @onclick="BeginAdd">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg><span>إضافة تسلسل</span>
                            </button>
                        }
                    </div>
                </div>

                @if (FilteredSequences.Count == 0)
                {
                    <div class="sequence-empty"><span class="empty-emblem">YK</span><strong>لا توجد نتائج مطابقة</strong><p>غيّر عبارة البحث أو مرشح الحالة لعرض التسلسلات.</p></div>
                }
                else
                {
                    <div class="sequence-table-wrap">
                        <table class="sequence-table">
                            <thead><tr>
                                <th>الرمز / الاسم</th><th>البادئة</th><th>العداد</th><th>الطول</th><th>السنة</th><th>الحالة</th><th>الرقم التالي — معاينة</th><th>الإجراء</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var item in FilteredSequences)
                                {
                                    <tr @key="item.SequenceID">
                                        <td class="sequence-identity"><strong><bdi>@item.SequenceCode</bdi></strong><span>@item.SequenceName</span>@if (IsDuplicateCode(item.SequenceCode)) { <small class="duplicate-code-warning">رمز مكرر — لا يمكن التوليد بأمان</small> }</td>
                                        <td><span class="sequence-code-chip"><bdi>@(string.IsNullOrWhiteSpace(item.Prefix) ? "—" : item.Prefix)</bdi></span></td>
                                        <td class="sequence-number"><bdi>@(item.CurrentNumber?.ToString("N0") ?? "—")</bdi><small>آخر إعادة: @(item.LastResetYear?.ToString() ?? "—")</small></td>
                                        <td>@(item.NumberLength?.ToString() ?? "—")</td>
                                        <td><span class="year-mode">@(item.IncludeYear ? "يتضمن السنة" : "بدون سنة")</span><small class="reset-mode">@(item.ResetYearly ? "إعادة سنوية" : "عداد مستمر")</small></td>
                                        <td><span class="sequence-status @(item.IsActive ? "on" : "off")"><i></i>@(item.IsActive ? "فعّال" : "موقوف")</span></td>
                                        <td class="next-preview"><bdi>@(string.IsNullOrWhiteSpace(item.NextNumberPreview) ? "غير متاح" : item.NextNumberPreview)</bdi><small>لا يستهلك الرقم</small></td>
                                        <td>
                                            @if (canEdit)
                                            {
                                                <button class="sequence-row-action" title="تعديل الإعداد" aria-label="تعديل @item.SequenceCode" @onclick="() => BeginEdit(item)">
                                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5 5 5M4 20l4.2-.8L19 8.4 15.6 5 4.8 15.8 4 20Z"/><path d="M13 7.5 16.5 11"/></svg><span>تعديل</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="sequence-readonly-label">عرض فقط</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <div class="sequence-table-foot"><span>عدد النتائج <strong>@FilteredSequences.Count</strong></span><span>العداد وقيمة آخر إعادة ضبط للعرض فقط بعد إنشاء التسلسل.</span></div>
            </section>

            <footer class="sequence-page-footer"><span class="footer-signature"><b>YK</b><span><strong>إعدادات ترقيم المستندات</strong><small>صلاحيات القراءة والكتابة محكومة بـ SCR_SETTINGS</small></span></span><span class="footer-procedure">Stored procedure <bdi>sp_GetNextNumber</bdi></span></footer>
        }
    </main>

    @if (showEditor && draft is not null)
    {
        <div class="sequence-modal-backdrop" role="presentation" @onclick="CloseEditor">
            <section class="sequence-modal" role="dialog" aria-modal="true" aria-labelledby="sequence-editor-title" @onclick:stopPropagation="true">
                <div class="sequence-modal-head">
                    <div><span class="sequence-eyebrow">SCR_SETTINGS · CONFIGURATION</span><h2 id="sequence-editor-title">@(isEditing ? "تعديل تسلسل" : "إضافة تسلسل جديد")</h2><p>@(isEditing ? "يمكن تعديل صيغة الرقم وحالة التسلسل؛ لا يمكن تعديل العداد من هذه الشاشة." : "أدخل القيم المعتمدة. لا توجد تهيئة تلقائية لرمز SQ أو لأي بادئة.")</p></div>
                    <button type="button" class="sequence-modal-close" aria-label="إغلاق" @onclick="CloseEditor">×</button>
                </div>
                <form class="sequence-form" @onsubmit="SaveSequenceAsync" @onsubmit:preventDefault="true">
                    <div class="sequence-form-grid">
                        <label class="sequence-field"><span>رمز التسلسل <b>*</b></span><input type="text" maxlength="20" required autocomplete="off" @bind="draft.SequenceCode" disabled="@isEditing" placeholder="مثال: SQ" dir="ltr" /><small>حد الإجراء <bdi>sp_GetNextNumber</bdi> هو 20 حرفاً.</small></label>
                        <label class="sequence-field"><span>اسم التسلسل <b>*</b></span><input type="text" maxlength="200" required autocomplete="off" @bind="draft.SequenceName" placeholder="اسم واضح للمستخدمين" /></label>
                        <label class="sequence-field"><span>البادئة <b>*</b></span><input type="text" maxlength="10" required="@(!isEditing || draft.IsActive)" autocomplete="off" @bind="draft.Prefix" placeholder="أدخل البادئة المعتمدة" dir="ltr" /><small>الإجراء يستخدم أول 10 أحرف فقط.</small></label>
                        <label class="sequence-field"><span>طول الجزء الرقمي <b>*</b></span><input type="number" min="1" max="@GetMaxNumberLength(draft)" required @bind="draft.NumberLength" dir="ltr" /><small>حد الإخراج <bdi>NVARCHAR(50)</bdi> يُحسب حسب البادئة والسنة.</small></label>
                        @if (!isEditing)
                        {
                            <label class="sequence-field"><span>قيمة العداد الابتدائية <b>*</b></span><input type="number" min="0" max="2147483647" required @bind="draft.CurrentNumber" dir="ltr" /><small>القيمة المسجلة؛ أول استخدام قد يزيدها أو يعيدها إلى 1 حسب إعداد السنة.</small></label>
                            <label class="sequence-field"><span>سنة آخر إعادة ضبط <small>(حسب قيمة العداد)</small></span><input type="number" min="1900" @bind="draft.LastResetYear" dir="ltr" /><small>مطلوبة مع عداد غير صفر وإعادة ضبط سنوية؛ السنة الأقدم تجعل أول استخدام يبدأ من 1، والحالية تحفظ قيمة العداد للزيادة التالية.</small></label>
                        }
                        else
                        {
                            <div class="sequence-field readonly-field"><span>قيمة العداد الحالية</span><strong><bdi>@(draft.CurrentNumber?.ToString("N0") ?? "—")</bdi></strong><small>غير قابلة للتحرير لمنع القفز أو إعادة استخدام رقم.</small></div>
                            <div class="sequence-field readonly-field"><span>سنة آخر إعادة ضبط</span><strong><bdi>@(draft.LastResetYear?.ToString() ?? "—")</bdi></strong><small>تُحدّثها قاعدة البيانات عند توليد رقم.</small></div>
                        }
                    </div>

                    <div class="sequence-options">
                        <label class="sequence-toggle"><input type="checkbox" @bind="draft.IncludeYear" /><span class="toggle-track"><i></i></span><span><strong>تضمين السنة</strong><small>تظهر السنة في الرقم الناتج.</small></span></label>
                        <label class="sequence-toggle"><input type="checkbox" @bind="draft.ResetYearly" /><span class="toggle-track"><i></i></span><span><strong>إعادة العداد سنوياً</strong><small>عند التغيير، يبدأ الإجراء من 1 مع السنة الجديدة.</small></span></label>
                        <label class="sequence-toggle active-toggle"><input type="checkbox" @bind="draft.IsActive" /><span class="toggle-track"><i></i></span><span><strong>التسلسل فعال</strong><small>فحص التفعيل داخل SequenceService فقط؛ بعض المسارات تستدعي الإجراء مباشرةً.</small></span></label>
                    </div>
                    @if (draft.ResetYearly && !draft.IncludeYear)
                    {
                        <div class="@(draft.IsActive ? "sequence-inline-error" : "sequence-inline-warning")">لا يمكن إعادة الرقم سنوياً دون تضمين السنة؛ @(draft.IsActive ? "أصلح هذا قبل حفظ التسلسل فعالاً." : "سيبقى التسلسل غير صالح للتفعيل حتى تصحيح الإعداد.")</div>
                    }
                    @if (isEditing && draft.CurrentNumber.GetValueOrDefault() > 0)
                    {
                        <div class="sequence-inline-warning">تغيير البادئة أو طول الرقم أو إعدادات السنة يغيّر شكل الأرقام المستقبلية، وقد يؤثر في التكاملات التي تعتمد على صيغة الرقم.</div>
                    }
                    @if (!isEditing)
                    {
                        <div class="sequence-inline-warning">الحفظ سيضيف إعداداً إلى قاعدة البيانات. لا تُنشئ SQ قبل اعتماد البادئة وقيمة البداية. لم تُنفّذ أي كتابة تلقائية.</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(editorError))
                    {
                        <div class="sequence-inline-error" role="alert">@editorError</div>
                    }
                    <div class="sequence-modal-actions">
                        <button type="button" class="sequence-button secondary" @onclick="CloseEditor" disabled="@isSaving">إلغاء</button>
                        <button type="submit" class="sequence-button primary" disabled="@isSaving">
                            @if (isSaving) { <span class="sequence-button-spinner"></span><span>جارٍ الحفظ...</span> }
                            else { <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5 10 17l9-10"/></svg><span>@(isEditing ? "حفظ التعديلات" : "إضافة التسلسل")</span> }
                        </button>
                    </div>
                </form>
            </section>
        </div>
    }
}

<style>
.sequence-page{--seq-gold:#D4AF37;--seq-gold-dark:#9C7C2E;--seq-ink:#070B14;--seq-ink-soft:#151b28;--seq-line:#e9e2d2;--seq-paper:#fff;--seq-muted:#7f8794;font-family:'Tajawal',sans-serif;color:var(--seq-ink-soft);max-width:1440px;margin:0 auto;padding:6px 0 28px;display:flex;flex-direction:column;gap:17px}
.sequence-hero{position:relative;overflow:hidden;border:1px solid rgba(212,175,55,.22);border-radius:23px;padding:20px 25px 16px;background:radial-gradient(ellipse at 10% 0,rgba(212,175,55,.15),transparent 34%),linear-gradient(132deg,#070B14,#0D1422 61%,#182235);color:#f4e8c7;box-shadow:0 18px 42px rgba(7,11,20,.10)}
.sequence-hero:before{content:"";position:absolute;inset:0 0 auto;height:2px;background:linear-gradient(90deg,transparent,#8e712a,#f2d778,#8e712a,transparent)}
.sequence-hero-top,.sequence-hero-main,.sequence-hero-bottom{position:relative;z-index:1}
.sequence-hero-top{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:14px;border-bottom:1px solid rgba(255,255,255,.09)}
.sequence-brand{display:flex;align-items:center;gap:10px}
.sequence-monogram{display:grid;place-items:center;width:40px;height:40px;border:1px solid rgba(212,175,55,.36);border-radius:13px;background:linear-gradient(145deg,rgba(212,175,55,.17),rgba(212,175,55,.035));color:var(--seq-gold);font-size:.83rem;font-weight:900;letter-spacing:.08em}
.sequence-brand-copy{display:flex;flex-direction:column;gap:2px}
.sequence-brand-copy strong{color:#f0dfa9;font-size:.73rem;letter-spacing:.14em}
.sequence-brand-copy small{color:#8993a2;font-size:.57rem;letter-spacing:.11em;font-weight:800}
.sequence-hero-main{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:23px 0 20px}
.sequence-eyebrow{display:block;color:var(--seq-gold-dark);font-size:.64rem;letter-spacing:.075em;font-weight:900}
.sequence-hero .sequence-eyebrow{color:#d9bb5e}
.sequence-hero h1{margin:6px 0;color:#fff;font-size:clamp(1.45rem,3vw,2rem);font-weight:900}
.sequence-hero-main p{margin:0;color:#a5adba;font-size:.78rem;line-height:1.7}
.sequence-hero-mark{display:flex;align-items:center;gap:8px;color:#cfb75e;font:800 .68rem 'Tajawal',sans-serif;direction:ltr}
.sequence-hero-mark span{display:grid;place-items:center;width:31px;height:31px;border:1px solid rgba(212,175,55,.25);border-radius:50%;background:rgba(212,175,55,.06)}
.sequence-hero-mark i{width:24px;height:1px;background:linear-gradient(90deg,rgba(212,175,55,.18),rgba(212,175,55,.65))}
.sequence-hero-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding-top:12px;border-top:1px solid rgba(255,255,255,.09);color:#949ead;font-size:.67rem}
.sequence-hero-bottom bdi{color:#e1ce90;font-weight:800}
.sequence-readonly-pill{display:inline-flex;align-items:center;gap:7px;padding:6px 10px;border:1px solid rgba(212,175,55,.18);border-radius:99px;background:rgba(212,175,55,.06);color:#d7c68d}
.sequence-readonly-pill i{width:6px;height:6px;border-radius:50%;background:#8fd1a9;box-shadow:0 0 0 4px rgba(143,209,169,.08)}
.sequence-alert,.sequence-warning{display:flex;align-items:center;gap:12px;padding:12px 15px;border:1px solid;border-radius:14px}
.sequence-alert p,.sequence-warning p{margin:3px 0 0;font-size:.75rem;line-height:1.7}
.sequence-alert.success{background:#f0faf4;border-color:#c5ead3;color:#24633d}
.sequence-alert.error{background:#fff4f1;border-color:#efc9bf;color:#8c3728}
.sequence-alert-mark{display:grid;place-items:center;flex:0 0 27px;width:27px;height:27px;border-radius:9px;background:rgba(0,0,0,.05);font-weight:900}
.sequence-alert-mark svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.sequence-alert button{margin-right:auto;border:0;background:transparent;color:inherit;font-size:1.1rem;cursor:pointer}
.sequence-warning{background:#fff9e9;border-color:#f0dfaa;color:#69531b}
.sequence-warning>div{flex:1}
.sequence-warning strong{font-size:.8rem;font-weight:900}
.sequence-warning-icon{display:grid;place-items:center;flex:0 0 30px;width:30px;height:30px;border-radius:10px;background:rgba(212,175,55,.17);color:#8c6b19;font-weight:900}
.sq-notice{border-right:3px solid var(--seq-gold)}
.procedure-warning{align-items:flex-start;border-right:3px solid #bd9634}
.duplicate-code-warning{margin-top:4px!important;color:#a23f30!important;font-size:.6rem!important;font-weight:900!important}
.sequence-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:11px}
.sequence-stat{position:relative;display:flex;flex-direction:column;gap:5px;min-height:88px;padding:14px 16px;border:1px solid var(--seq-line);border-radius:15px;background:linear-gradient(145deg,#fff,#fcfaf5);box-shadow:0 5px 18px rgba(15,23,42,.025)}
