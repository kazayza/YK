</style>

@code {
    private List<NumberSequenceDto> sequences = new();
    private NumberSequenceDto? draft;
    private bool initializationComplete;
    private bool isLoading = true;
    private bool canView;
    private bool canAdd;
    private bool canEdit;
    private bool loadError;
    private bool showEditor;
    private bool isEditing;
    private bool isSaving;
    private bool statusIsError;
    private string? loadErrorMessage;
    private string? editorError;
    private string? statusMessage;
    private string searchText = string.Empty;
    private string statusFilter = "all";

    private List<NumberSequenceDto> FilteredSequences => sequences
        .Where(s => statusFilter == "all" || (statusFilter == "active" && s.IsActive) || (statusFilter == "inactive" && !s.IsActive))
        .Where(s => string.IsNullOrWhiteSpace(searchText)
            || s.SequenceCode.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)
            || s.SequenceName.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)
            || (s.Prefix?.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderBy(s => s.SequenceCode, StringComparer.OrdinalIgnoreCase)
        .ThenBy(s => s.SequenceID)
        .ToList();

    private int ReviewCount => sequences.Count(s => NeedsReview(s) || IsDuplicateCode(s.SequenceCode));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            if (!await UserSession.EnsureRestoredAsync())
            {
                initializationComplete = true;
                isLoading = false;
                Navigation.NavigateTo("/login");
                return;
            }

            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(UserSession.UserID);

            var settingsPermission = PermissionService.GetModule("SCR_SETTINGS");
            canView = settingsPermission?.CanView == true;
            canAdd = settingsPermission?.CanAdd == true;
            canEdit = settingsPermission?.CanEdit == true;
            initializationComplete = true;

            if (!canView)
            {
                isLoading = false;
                return;
            }

            await ReloadSequencesAsync(showSuccess: false);
        }
        catch (UnauthorizedAccessException)
        {
            canView = false;
            initializationComplete = true;
            isLoading = false;
        }
        catch (Exception ex)
        {
            initializationComplete = true;
            isLoading = false;
            loadError = true;
            loadErrorMessage = $"تعذر قراءة الإعدادات. تحقق من وجود dbo.NumberSequences وdbo.sp_GetNextNumber، ثم أعد المحاولة. التفاصيل: {ex.GetBaseException().Message}";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadSequencesAsync(bool showSuccess = true)
    {
        isLoading = true;
        loadError = false;
        loadErrorMessage = null;
        try
        {
            sequences = await SequenceService.GetManagedSequencesAsync(UserSession.UserID);
            if (showSuccess) SetStatus("تم تحديث قائمة التسلسلات دون استهلاك أي رقم.", isError: false);
        }
        catch (UnauthorizedAccessException)
        {
            canView = false;
            loadError = true;
            loadErrorMessage = "لا تتوفر صلاحية عرض التسلسلات على SCR_SETTINGS.";
        }
        catch (Exception ex)
        {
            loadError = true;
            loadErrorMessage = $"تعذر تحميل البيانات. تحقق من مخطط dbo.NumberSequences. التفاصيل: {ex.GetBaseException().Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static int GetMaxNumberLength(NumberSequenceDto sequence)
    {
        var effectivePrefixLength = Math.Min(sequence.Prefix?.Trim().Length ?? 0, 10);
        var fixedPartLength = sequence.IncludeYear ? 6 : 1;
        return Math.Max(1, 50 - effectivePrefixLength - fixedPartLength);
    }

    private bool IsDuplicateCode(string sequenceCode) => sequences.Count(s =>
        string.Equals(s.SequenceCode?.Trim(), sequenceCode?.Trim(), StringComparison.OrdinalIgnoreCase)) > 1;

    private static bool NeedsReview(NumberSequenceDto sequence) =>
        string.IsNullOrWhiteSpace(sequence.Prefix)
        || !sequence.NumberLength.HasValue || sequence.NumberLength.Value < 1
        || sequence.NumberLength.Value > GetMaxNumberLength(sequence)
        || (sequence.ResetYearly && !sequence.IncludeYear)
        || (sequence.IsActive && string.IsNullOrWhiteSpace(sequence.NextNumberPreview));

    private void BeginAdd()
    {
        if (!canAdd) return;
        isEditing = false;
        editorError = null;
        draft = new NumberSequenceDto
        {
            Prefix = string.Empty,
            CurrentNumber = null,
            NumberLength = 6,
            IncludeYear = true,
            ResetYearly = true,
            IsActive = true
        };
        showEditor = true;
    }

    private void BeginEdit(NumberSequenceDto item)
    {
        if (!canEdit) return;
        isEditing = true;
        editorError = null;
        draft = new NumberSequenceDto
        {
            SequenceID = item.SequenceID,
            SequenceCode = item.SequenceCode,
            SequenceName = item.SequenceName,
            Prefix = item.Prefix,
            CurrentNumber = item.CurrentNumber,
            NumberLength = item.NumberLength,
            IncludeYear = item.IncludeYear,
            ResetYearly = item.ResetYearly,
            LastResetYear = item.LastResetYear,
            IsActive = item.IsActive,
            CreatedDate = item.CreatedDate,
            NextNumberPreview = item.NextNumberPreview
        };
        showEditor = true;
    }

    private async Task SaveSequenceAsync()
    {
        if (draft is null || isSaving) return;
        if (isEditing && !canEdit || !isEditing && !canAdd) return;
        editorError = null;

        if (draft.ResetYearly && !draft.IncludeYear && (!isEditing || draft.IsActive))
        {
            editorError = "لا يمكن إعادة العداد سنوياً دون تضمين السنة في رقم المستند؛ أصلح الإعداد قبل تفعيل التسلسل.";
            return;
        }
        if ((!isEditing || draft.IsActive) && string.IsNullOrWhiteSpace(draft.Prefix))
        {
            editorError = "البادئة مطلوبة للتسلسل الجديد أو عند تفعيل التسلسل؛ الإجراء يضمّن شرطة حتى عند خلوها.";
            return;
        }

        if (isEditing && HasFormatChanges(draft))
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm",
                "تغيير البادئة أو طول الرقم أو إعدادات السنة سيؤثر في صيغة الأرقام المستقبلية، وقد يؤثر في التكاملات المرتبطة بها. سيبقى العداد الحالي كما هو. هل تريد المتابعة؟");
            if (!confirmed) return;
        }

        isSaving = true;
        try
        {
            if (isEditing)
            {
                await SequenceService.UpdateManagedSequenceAsync(draft, UserSession.UserID);
                SetStatus($"تم تحديث إعدادات التسلسل {draft.SequenceCode}.", isError: false);
            }
            else
            {
                var createdId = await SequenceService.AddManagedSequenceAsync(draft, UserSession.UserID);
                SetStatus($"تمت إضافة التسلسل {draft.SequenceCode} (رقم الإعداد {createdId}). لم يُنشأ أي مستند.", isError: false);
            }

            showEditor = false;
            draft = null;
            await ReloadSequencesAsync(showSuccess: false);
        }
        catch (UnauthorizedAccessException ex)
        {
            editorError = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            editorError = ex.Message;
        }
        catch (Exception ex)
        {
            editorError = $"تعذر حفظ الإعداد: {ex.GetBaseException().Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool HasFormatChanges(NumberSequenceDto updated)
    {
        var original = sequences.FirstOrDefault(s => s.SequenceID == updated.SequenceID);
        if (original is null || original.CurrentNumber.GetValueOrDefault() <= 0) return false;
        return !string.Equals(original.Prefix?.Trim(), updated.Prefix?.Trim(), StringComparison.Ordinal)
            || original.NumberLength != updated.NumberLength
            || original.IncludeYear != updated.IncludeYear
            || original.ResetYearly != updated.ResetYearly;
    }

    private void CloseEditor()
    {
        if (isSaving) return;
        showEditor = false;
        draft = null;
        editorError = null;
    }

    private void SetStatus(string message, bool isError)
    {
        statusMessage = message;
        statusIsError = isError;
    }

    private void ClearStatus() => statusMessage = null;
}
