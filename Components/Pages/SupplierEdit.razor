troke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/></svg><input type="text" class="field-input @(contactErrors.ContainsKey("Mobile")?"error":"")" @bind="newContact.Mobile" dir="ltr" /></div>@if(contactErrors.ContainsKey("Mobile")){<span class="field-hint error">@contactErrors["Mobile"]</span>}</div><div class="form-field"><label class="field-label">البريد</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/></svg><input type="email" class="field-input @(contactErrors.ContainsKey(nameof(newContact.Email))?"error":"")" @bind="newContact.Email" dir="ltr" /></div>@if(contactErrors.ContainsKey(nameof(newContact.Email))){<span class="field-hint error">@contactErrors[nameof(newContact.Email)]</span>}</div><div class="form-field"><label class="field-label">رئيسي؟</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><select class="field-select" @bind="newContact.IsPrimary"><option value="false">لا</option><option value="true">نعم</option></select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div></div><div class="line-form-btns"><button class="btn-luxury btn-primary-luxury" @onclick="SaveContact"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H6v8"/></svg>حفظ جهة الاتصال</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showContactForm=false">إلغاء</button></div></div>
                            }
