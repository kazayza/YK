iv class="input-with-suffix"><input type="number" class="field-input @(itemErrors.ContainsKey(nameof(newItem.UnitPrice))?"error":"")" @bind="newItem.UnitPrice" step="0.01" /><span class="field-suffix">ج.م</span></div>@if(itemErrors.ContainsKey(nameof(newItem.UnitPrice))){<span class="field-hint error">@itemErrors[nameof(newItem.UnitPrice)]</span>}</div><div class="form-field"><label class="field-label">أقل كمية طلب</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg><input type="number" class="field-input @(itemErrors.ContainsKey(nameof(newItem.MinOrderQty))?"error":"")" @bind="newItem.MinOrderQty" step="0.01" /></div>@if(itemErrors.ContainsKey(nameof(newItem.MinOrderQty))){<span class="field-hint error">@itemErrors[nameof(newItem.MinOrderQty)]</span>}</div><div class="form-field"><label class="field-label">مدة التوريد (يوم)</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><input type="number" class="field-input @(itemErrors.ContainsKey(nameof(newItem.LeadTimeDays))?"error":"")" @bind="newItem.LeadTimeDays" /></div>@if(itemErrors.ContainsKey(nameof(newItem.LeadTimeDays))){<span class="field-hint error">@itemErrors[nameof(newItem.LeadTimeDays)]</span>}</div><div class="form-field"><label class="field-label">مورد رئيسي؟</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><select class="field-select" @bind="newItem.IsPrimary"><option value="false">لا</option><option value="true">نعم</option></select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div></div>}<div class="line-form-btns"><button class="btn-luxury btn-primary-luxury" @onclick="SaveItem" disabled="@isLoadingItems"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H6v8"/></svg>حفظ الصنف</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showItemForm=false">إلغاء</button></div></div>
                            }
