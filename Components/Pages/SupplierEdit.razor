@page "/suppliers/new"
@page "/suppliers/edit/{SupplierId:int}"
@page "/suppliers/view/{SupplierId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@using System.Text.Json
@using System.Text.RegularExpressions
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject SupplierService SupService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div>}
else
{
    <div class="luxury-edit-page" dir="rtl" @onkeydown="OnKeyDown" @onkeydown:preventDefault="shouldPreventDefault">

        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <button class="btn-luxury btn-ghost-dark" @onclick="GoBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>رجوع</button>
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text">
                        <h2 class="lh-title">@pageTitle</h2>
                        <p class="lh-subtitle">
                            @if (!string.IsNullOrEmpty(header.SupplierCode))
                            {
                                <span>كود: <strong class="eh-code">@header.SupplierCode</strong> - @header.SupplierNameAr</span>
                            }
                            else{<span>إدخال بيانات مورد جديد - سيتم توليد الكود تلقائياً</span>}
                        </p>
                    </div>
                </div>
                <div class="lh-actions">
                    @if (!string.IsNullOrEmpty(header.SupplierCode))
                    {
                        <span class="type-chip-luxury" style="--tc:@SupplierService.GetTypeColor(header.SupplierType)">@SupplierService.GetTypeName(header.SupplierType)</span>
                        <span class="rating-chip-luxury">@(new string('★', header.Rating))</span>
                    }
                    <span class="lh-badge"><span class="lh-dot"></span>@(isNewMode?"جديد":isViewMode?"عرض":"تعديل")</span>
                    @if (permissions.CanPrint && SupplierId > 0)
                    {
                        <button class="btn-luxury btn-ghost-dark" @onclick="PrintCard" disabled="@isPrintLoading">@if(isPrintLoading){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>}طباعة</button>
                    }
                </div>
            </div>
        </div>

        @if (isLoading)
        {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل بيانات المورد...</p></div>}
        else
        {
            <div class="mudtabs-luxury">
                <div class="mudtabs-header">
                    <button class="mudtab-btn @(activeTab==0?"active":"")" @onclick="() => SelectTab(0)"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>البيانات الأساسية @if(supplierErrors.Any()){<span class="mt-required"></span>}</button>
                    <button class="mudtab-btn @(activeTab==1?"active":"")" @onclick="() => SelectTab(1)"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>التواصل والموقع</button>
                    <button class="mudtab-btn @(activeTab==2?"active":"")" @onclick="() => SelectTab(2)"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>المالية والقانونية</button>
                    <button class="mudtab-btn @(activeTab==3?"active":"")" @onclick="() => SelectTab(3)"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>البنكية والملاحظات</button>
                    @if (SupplierId > 0)
                    {
                        <button class="mudtab-btn @(activeTab==4?"active":"")" @onclick="() => SelectTab(4)"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>جهات الاتصال <span class="mt-count">@contacts.Count</span></button>
                        <button class="mudtab-btn @(activeTab==5?"active":"")" @onclick="() => SelectTab(5)"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></span>الأصناف <span class="mt-count gold">@supplierItems.Count</span></button>
                        <button class="mudtab-btn @(activeTab==6?"active":"")" @onclick="() => SelectTab(6)"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/></svg></span>كشف الحساب <span class="mt-count">@statement.Count</span></button>
                    }
                    <div class="mudtab-indicator" style="--tab:@activeTab;--total:@(SupplierId>0?7:4)"></div>
                </div>

                <div class="mudtabs-body">
                    @if (activeTab == 0)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div><h3>البيانات الأساسية</h3><p>المعلومات الرئيسية للمورد</p></div></div>
                            <div class="form-grid cols-4">
                                <div class="form-field"><label class="field-label">كود المورد</label><div class="field-input disabled"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6"/><path d="M9 15h6"/></svg><span>@(header.SupplierCode ?? "تلقائي")</span></div><span class="field-hint">اضغط للنسخ عند وجود كود</span></div>
                                <div class="form-field"><label class="field-label required">اسم المورد (عربي)</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" class="field-input @(supplierErrors.ContainsKey(nameof(header.SupplierNameAr))?"error":"")" @bind="header.SupplierNameAr" disabled="@isReadOnly" placeholder="اسم المورد بالعربي..." /></div>@if(supplierErrors.ContainsKey(nameof(header.SupplierNameAr))){<span class="field-hint error">@supplierErrors[nameof(header.SupplierNameAr)]</span>}</div>
                                <div class="form-field"><label class="field-label">اسم المورد (إنجليزي)</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" class="field-input" @bind="header.SupplierNameEn" disabled="@isReadOnly" dir="ltr" placeholder="Supplier name..." /></div></div>
                                <div class="form-field"><label class="field-label required">النوع</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><select class="field-select @(supplierErrors.ContainsKey(nameof(header.SupplierType))?"error":"")" @bind="header.SupplierType" disabled="@isReadOnly"><option value="1">مورد خامات</option><option value="2">مورد تعبئة</option><option value="3">مورد خدمات</option><option value="4">مورد عام</option></select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>@if(supplierErrors.ContainsKey(nameof(header.SupplierType))){<span class="field-hint error">@supplierErrors[nameof(header.SupplierType)]</span>}</div>
                            </div>
                            <div class="form-grid cols-3">
                                <div class="form-field"><label class="field-label">التقييم</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><select class="field-select" @bind="header.Rating" disabled="@isReadOnly">@foreach (SupplierRating rating in Enum.GetValues(typeof(SupplierRating))){<option value="@((int)rating)">@GetRatingName(rating)</option>}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                                <div class="form-field"><label class="field-label">الدولة</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg><input type="text" class="field-input" @bind="header.Country" disabled="@isReadOnly" /></div></div>
                                <div class="form-field"><label class="field-label">المدينة</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><input type="text" class="field-input" @bind="header.City" disabled="@isReadOnly" /></div></div>
                            </div>
                            <div class="preview-card-luxury"><h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>معاينة المورد</h4><div class="pc-body"><span class="code-luxury">@(header.SupplierCode ?? "CODE")</span><strong>@(string.IsNullOrWhiteSpace(header.SupplierNameAr)?"اسم المورد":header.SupplierNameAr)</strong><span class="type-chip-luxury" style="--tc:@SupplierService.GetTypeColor(header.SupplierType)">@SupplierService.GetTypeName(header.SupplierType)</span><span class="rating-chip-luxury">@(new string('★', header.Rating))</span></div></div>
                        </div>
                    }
                    @if (activeTab == 1)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg></div><div><h3>بيانات التواصل والموقع</h3><p>طرق التواصل والعنوان</p></div></div>
                            <div class="form-grid cols-4">
                                <div class="form-field"><label class="field-label">هاتف 1</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/></svg><input type="text" class="field-input @(supplierErrors.ContainsKey("Phone1")?"error":"")" @bind="header.Phone1" disabled="@isReadOnly" dir="ltr" placeholder="رقم الهاتف..." /></div>@if(supplierErrors.ContainsKey("Phone1")){<span class="field-hint error">@supplierErrors["Phone1"]</span>}</div>
                                <div class="form-field"><label class="field-label">هاتف 2</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2"/></svg><input type="text" class="field-input @(supplierErrors.ContainsKey("Phone2")?"error":"")" @bind="header.Phone2" disabled="@isReadOnly" dir="ltr" /></div>@if(supplierErrors.ContainsKey("Phone2")){<span class="field-hint error">@supplierErrors["Phone2"]</span>}</div>
                                <div class="form-field"><label class="field-label">موبايل</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><path d="M12 18h.01"/></svg><input type="text" class="field-input @(supplierErrors.ContainsKey("Mobile")?"error":"")" @bind="header.Mobile" disabled="@isReadOnly" dir="ltr" /></div>@if(supplierErrors.ContainsKey("Mobile")){<span class="field-hint error">@supplierErrors["Mobile"]</span>}</div>
                                <div class="form-field"><label class="field-label">البريد الإلكتروني</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg><input type="email" class="field-input @(supplierErrors.ContainsKey(nameof(header.Email))?"error":"")" @bind="header.Email" disabled="@isReadOnly" dir="ltr" /></div>@if(supplierErrors.ContainsKey(nameof(header.Email))){<span class="field-hint error">@supplierErrors[nameof(header.Email)]</span>}</div>
                            </div>
                            <div class="form-grid cols-2">
                                <div class="form-field"><label class="field-label">الموقع الإلكتروني</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg><input type="text" class="field-input" @bind="header.Website" disabled="@isReadOnly" dir="ltr" placeholder="https://..." /></div></div>
                                <div class="form-field"><label class="field-label">العنوان التفصيلي</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><input type="text" class="field-input" @bind="header.Address" disabled="@isReadOnly" placeholder="العنوان..." /></div></div>
                            </div>
                            <div class="map-placeholder-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>قريباً: عرض موقع المورد على الخريطة وربطه بـ GPS + واتساب مباشر</span></div>
                        </div>
                    }
                    @if (activeTab == 2)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div><h3>البيانات القانونية والمالية</h3><p>الضرائب والائتمان والعملة</p></div></div>
                            <div class="form-grid cols-4">
                                <div class="form-field"><label class="field-label">الرقم الضريبي</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg><input type="text" class="field-input" @bind="header.TaxNumber" disabled="@isReadOnly" dir="ltr" /></div></div>
                                <div class="form-field"><label class="field-label">السجل التجاري</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/></svg><input type="text" class="field-input" @bind="header.CommercialRegister" disabled="@isReadOnly" dir="ltr" /></div></div>
                                <div class="form-field"><label class="field-label">شروط الدفع</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><select class="field-select" @bind="header.PaymentTermID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if(paymentTerms!=null){@foreach(var pt in paymentTerms){<option value="@pt.Id">@pt.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                                <div class="form-field"><label class="field-label">العملة</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><select class="field-select" @bind="header.CurrencyID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if(currencies!=null){@foreach(var c in currencies){<option value="@c.Id">@c.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                            </div>
                            <div class="form-grid cols-3">
                                <div class="form-field"><label class="field-label required">حد الائتمان</label><div class="input-with-suffix"><input type="number" class="field-input @(supplierErrors.ContainsKey(nameof(header.CreditLimit))?"error":"")" @bind="header.CreditLimit" step="0.01" disabled="@isReadOnly" /><span class="field-suffix">ج.م</span></div>@if(supplierErrors.ContainsKey(nameof(header.CreditLimit))){<span class="field-hint error">@supplierErrors[nameof(header.CreditLimit)]</span>}<span class="field-hint">الحد الأقصى للمديونية المسموح بها</span></div>
                                <div class="form-field"><label class="field-label">الرصيد الافتتاحي</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="header.OpeningBalance" step="0.01" disabled="@(isReadOnly || SupplierId>0)" /><span class="field-suffix">ج.م</span></div><span class="field-hint">@(SupplierId>0?"لا يمكن تعديل الافتتاحي بعد الإنشاء":"رصيد بداية التعامل")</span></div>
                                <div class="form-field"><label class="field-label">الرصيد الحالي</label><div class="field-input disabled"><span>@header.CurrentBalance.ToString("#,##0.00") ج.م</span></div><div class="credit-bar-luxury"><div class="credit-fill-luxury" style="width:@(GetCreditPercent())%"></div></div></div>
                            </div>
                        </div>
                    }
                    @if (activeTab == 3)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></div><div><h3>البيانات البنكية والملاحظات</h3><p>الحسابات البنكية وملاحظات عامة</p></div></div>
                            <div class="form-grid cols-3">
                                <div class="form-field"><label class="field-label">اسم البنك</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg><input type="text" class="field-input" @bind="header.BankName" disabled="@isReadOnly" /></div></div>
                                <div class="form-field"><label class="field-label">رقم الحساب</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg><input type="text" class="field-input" @bind="header.BankAccountNumber" disabled="@isReadOnly" dir="ltr" /></div></div>
