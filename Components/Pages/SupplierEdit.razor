                            @if (!statement.Any()){<div class="empty-luxury small"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 3v18h18"/><path d="M18 17V9"/></svg></div><h4>لا توجد حركات</h4></div>}
                            else
                            {
                                <div class="table-card-luxury"><div class="table-responsive"><table class="table-luxury"><thead><tr><th>#</th><th>التاريخ</th><th>النوع</th><th>المستند</th><th>مدين (له)</th><th>دائن (منه)</th><th>الرصيد</th></tr></thead><tbody>@{int stn=0; decimal runBal=0;}@foreach(var st in statement){stn++; runBal+=st.DebitAmount-st.CreditAmount;<tr><td class="td-num">@stn</td><td class="td-muted">@st.TransDate.ToString("dd/MM/yyyy")</td><td>@st.TransType</td><td><span class="code-luxury">@st.DocNumber</span></td><td class="num-cell @(st.DebitAmount>0?"bal-danger":"")">@(st.DebitAmount>0?st.DebitAmount.ToString("#,##0.00"):"—")</td><td class="num-cell @(st.CreditAmount>0?"bal-ok":"")">@(st.CreditAmount>0?st.CreditAmount.ToString("#,##0.00"):"—")</td><td class="num-cell"><strong>@runBal.ToString("#,##0.00")</strong></td></tr>}</tbody><tfoot><tr class="total-row-luxury"><td colspan="4" class="td-name">الإجمالي</td><td class="num-cell bal-danger"><strong>@statement.Sum(s=>s.DebitAmount).ToString("#,##0.00")</strong></td><td class="num-cell bal-ok"><strong>@statement.Sum(s=>s.CreditAmount).ToString("#,##0.00")</strong></td><td class="num-cell"><strong>@runBal.ToString("#,##0.00") ج.م</strong></td></tr></tfoot></table></div></div>
