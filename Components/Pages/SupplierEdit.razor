    @if (showDeleteContactDialog && contactToDelete != null)
    {<div class="modal-overlay-luxury" @onclick="() => showDeleteContactDialog=false"><div class="modal-card-luxury small" @onclick:stopPropagation="true"><div class="ml-gold-line danger"></div><div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div><h4>حذف جهة اتصال</h4><p>هل تريد حذف: <strong class="delete-name">@contactToDelete.ContactName</strong>؟</p><p class="delete-hint">لا يمكن التراجع</p><div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDeleteContact">حذف نهائي</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showDeleteContactDialog=false">إلغاء</button></div></div></div>}

    @if (showDeleteItemDialog && itemToDelete != null)
    {<div class="modal-overlay-luxury" @onclick="() => showDeleteItemDialog=false"><div class="modal-card-luxury small" @onclick:stopPropagation="true"><div class="ml-gold-line danger"></div><div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div><h4>حذف صنف</h4><p>هل تريد حذف: <strong class="delete-name">@itemToDelete.ItemNameAr</strong>؟</p><div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDeleteItem">حذف نهائي</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showDeleteItemDialog=false">إلغاء</button></div></div></div>}

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast=""'>✕</button></div></div>}
}

<style>
