@code {
    private enum SupplierRating{Poor=1,Acceptable=2,Good=3,VeryGood=4,Excellent=5}
    [Parameter] public int SupplierId { get; set; }
    private SupplierEditDto header = new() { SupplierType = 1, Rating = 3, Country = "مصر" };
    private SupplierEditDto? originalHeader;
    private List<SupplierContactDto> contacts = new();
    private List<SupplierItemDto> supplierItems = new();
    private List<SupplierStatementDto> statement = new();
    private ModulePermissionDto? permissions;
    private List<LookupDto>? paymentTerms, currencies;
    private List<SearchableItem>? allItems;
    private int activeTab = 0;
    private bool isLoading = true, isSaving = false, isLoadingItems = false, isPrintLoading = false;
    private string toast = ""; private bool toastOk = true;
    private bool shouldPreventDefault = false;
    private bool showContactForm = false, showDeleteContactDialog = false;
    private SupplierContactDto newContact = new();
    private SupplierContactDto? contactToDelete;
    private Dictionary<string, string> contactErrors = new();
    private bool showItemForm = false, showDeleteItemDialog = false;
    private SupplierItemEditDto newItem = new();
    private SupplierItemDto? itemToDelete;
    private Dictionary<string, string> itemErrors = new();
    private Dictionary<string, string> supplierErrors = new();
    private string createdByName = ""; private string createdDate = ""; private string modifiedByName = ""; private string modifiedDate = "";
    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => SupplierId == 0;
    private bool isReadOnly => isViewMode;
    private string pageTitle => isNewMode ? "مورد جديد" : isViewMode ? "عرض بيانات المورد" : "تعديل المورد";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!UserSession.IsLoggedIn){Navigation.NavigateTo("/login");return;}
            if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_SUPPLIERS");
            if (permissions == null || !permissions.CanView) return;
            if (isViewMode && !permissions.CanView){toast="ليس لديك صلاحية العرض";toastOk=false;return;}
            if (!isViewMode && SupplierId > 0 && !permissions.CanEdit){toast="ليس لديك صلاحية التعديل";toastOk=false;return;}
            if (isNewMode && !permissions.CanAdd){toast="ليس لديك صلاحية الإضافة";toastOk=false;return;}
            paymentTerms = await LookupService.GetPaymentTermsAsync();
            currencies = await LookupService.GetCurrenciesAsync();
            if (SupplierId > 0)
            {
                var loaded = await SupService.GetSupplierByIdAsync(SupplierId);
                if (loaded != null)
                {
                    originalHeader = JsonSerializer.Deserialize<SupplierEditDto>(JsonSerializer.Serialize(loaded)) ?? loaded;
                    header = loaded;
                    contacts = await SupService.GetContactsAsync(SupplierId);
                    supplierItems = await SupService.GetSupplierItemsAsync(SupplierId);
                    statement = await SupService.GetStatementAsync(SupplierId);
                    await LoadAuditInfo();
                }else{await ShowToast("المورد غير موجود", false);}
            }
        }catch (Exception ex){await ShowToast($"خطأ: {ex.Message}", false);}
        finally{isLoading=false;StateHasChanged();}
    }
    private async Task LoadAuditInfo()
    {
        try{
            var audit = await SupService.GetSupplierAuditAsync(SupplierId);
            if (audit != null){createdByName = audit.CreatedByName ?? "غير محدد"; createdDate = audit.CreatedDate?.ToString("dd/MM/yyyy hh:mm tt") ?? ""; modifiedByName = audit.ModifiedByName ?? ""; modifiedDate = audit.ModifiedDate?.ToString("dd/MM/yyyy hh:mm tt") ?? "";}
        }catch{}
    }
    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "s"){if (!isViewMode && !isSaving) await SaveSupplier();}
        if (e.Key == "Escape"){if(showContactForm)showContactForm=false;else if(showItemForm)showItemForm=false;else if(showDeleteContactDialog)showDeleteContactDialog=false;else if(showDeleteItemDialog)showDeleteItemDialog=false;else GoBack();}
        if (e.CtrlKey && e.Key == "p"){if(SupplierId>0 && permissions?.CanPrint==true) await PrintCard();}
    }
    private async Task SelectTab(int tabIndex)
    {
        if (activeTab==0 && HasChanges() && !isViewMode){var confirmed=await JS.InvokeAsync<bool>("confirm","هناك تعديلات غير محفوظة. هل تريد المتابعة؟");if(!confirmed)return;}
        activeTab=tabIndex;StateHasChanged();
    }
    private bool HasChanges(){if(originalHeader==null)return false;return !JsonSerializer.Serialize(header).Equals(JsonSerializer.Serialize(originalHeader));}
    private int GetCreditPercent(){if(header.CreditLimit<=0)return 0;var used=header.CurrentBalance/header.CreditLimit*100;return Math.Clamp((int)used,0,100);}
    private List<string> ValidateSupplier()
    {
        supplierErrors.Clear();var errors=new List<string>();
        if(string.IsNullOrWhiteSpace(header.SupplierNameAr)){errors.Add("اسم المورد (عربي) مطلوب");supplierErrors[nameof(header.SupplierNameAr)]="اسم المورد مطلوب";}
        if(header.SupplierType<1||header.SupplierType>4){errors.Add("نوع المورد غير صحيح");supplierErrors[nameof(header.SupplierType)]="نوع غير صحيح";}
        if(header.CreditLimit<0){errors.Add("حد الائتمان يجب أن يكون موجب أو صفر");supplierErrors[nameof(header.CreditLimit)]="يجب أن يكون موجب";}
        if(!string.IsNullOrEmpty(header.Email)&&!IsValidEmail(header.Email)){errors.Add("البريد الإلكتروني غير صحيح");supplierErrors[nameof(header.Email)]="بريد غير صحيح";}
        if(!string.IsNullOrEmpty(header.Phone1)&&!IsValidPhone(header.Phone1)){errors.Add("رقم الهاتف 1 غير صحيح");supplierErrors["Phone1"]="رقم غير صحيح";}
        if(!string.IsNullOrEmpty(header.Phone2)&&!IsValidPhone(header.Phone2)){errors.Add("رقم الهاتف 2 غير صحيح");supplierErrors["Phone2"]="رقم غير صحيح";}
        if(!string.IsNullOrEmpty(header.Mobile)&&!IsValidPhone(header.Mobile)){errors.Add("رقم الموبايل غير صحيح");supplierErrors["Mobile"]="رقم غير صحيح";}
        return errors;
    }
    private List<string> ValidateContact(){contactErrors.Clear();var errors=new List<string>();if(string.IsNullOrWhiteSpace(newContact.ContactName)){errors.Add("اسم جهة الاتصال مطلوب");contactErrors[nameof(newContact.ContactName)]="مطلوب";}if(!string.IsNullOrEmpty(newContact.Email)&&!IsValidEmail(newContact.Email)){errors.Add("البريد الإلكتروني غير صحيح");contactErrors[nameof(newContact.Email)]="بريد غير صحيح";}if(!string.IsNullOrEmpty(newContact.Phone)&&!IsValidPhone(newContact.Phone)){errors.Add("رقم الهاتف غير صحيح");contactErrors["Phone"]="رقم غير صحيح";}if(!string.IsNullOrEmpty(newContact.Mobile)&&!IsValidPhone(newContact.Mobile)){errors.Add("رقم الموبايل غير صحيح");contactErrors["Mobile"]="رقم غير صحيح";}return errors;}
    private List<string> ValidateItem(){itemErrors.Clear();var errors=new List<string>();if(newItem.ItemID<=0){errors.Add("اختر الصنف");itemErrors[nameof(newItem.ItemID)]="اختياري";}if(newItem.UnitPrice<=0){errors.Add("السعر يجب أن يكون أكبر من صفر");itemErrors[nameof(newItem.UnitPrice)]="يجب أن يكون موجب";}if(newItem.MinOrderQty<0){errors.Add("أقل كمية طلب لا يمكن أن تكون سالبة");itemErrors[nameof(newItem.MinOrderQty)]="لا تكن سالب";}if(newItem.LeadTimeDays<0){errors.Add("مدة التوريد لا يمكن أن تكون سالبة");itemErrors[nameof(newItem.LeadTimeDays)]="لا تكن سالب";}return errors;}
    private bool IsValidEmail(string email){try{var addr=new System.Net.Mail.MailAddress(email);return addr.Address==email;}catch{return false;}}
    private bool IsValidPhone(string phone){return Regex.IsMatch(phone, @"^[\d\s\-\+\(\)]{7,}$");}
    private string GetRatingName(SupplierRating rating)=>rating switch{SupplierRating.Excellent=>"⭐⭐⭐⭐⭐ ممتاز",SupplierRating.VeryGood=>"⭐⭐⭐⭐ جيد جداً",SupplierRating.Good=>"⭐⭐⭐ جيد",SupplierRating.Acceptable=>"⭐⭐ مقبول",SupplierRating.Poor=>"⭐ ضعيف",_=>"غير معروف"};
    private async Task SaveSupplier()
    {
        var errors=ValidateSupplier();if(errors.Any()){await ShowToast(errors.First(), false);StateHasChanged();return;}
        isSaving=true;StateHasChanged();
        try{
            if(isNewMode){header.SupplierCode=await SupService.GenerateSupplierCodeAsync();var newId=await SupService.InsertSupplierAsync(header, UserSession.UserID);SupplierId=newId;header.SupplierID=newId;originalHeader=JsonSerializer.Deserialize<SupplierEditDto>(JsonSerializer.Serialize(header))??header;await ShowToast($"✅ تم إنشاء المورد: {header.SupplierCode}", true);await Task.Delay(1500);Navigation.NavigateTo($"/suppliers/edit/{newId}", forceLoad:false);}
            else{await SupService.UpdateSupplierAsync(header, UserSession.UserID);originalHeader=JsonSerializer.Deserialize<SupplierEditDto>(JsonSerializer.Serialize(header))??header;await ShowToast("✅ تم حفظ التعديلات", true);}
        }catch(Exception ex){await ShowToast($"❌ خطأ: {ex.Message}", false);}
        finally{isSaving=false;StateHasChanged();}
    }
    private void ShowAddContact(){ResetContactForm();showContactForm=true;}
    private void ResetContactForm(){newContact=new(){SupplierID=SupplierId};contactErrors.Clear();}
    private async Task SaveContact()
    {
        var errors=ValidateContact();if(errors.Any()){StateHasChanged();return;}
        try{await SupService.InsertContactAsync(newContact, UserSession.UserID);contacts=await SupService.GetContactsAsync(SupplierId);ResetContactForm();showContactForm=false;await ShowToast("✅ تم إضافة جهة اتصال", true);}
        catch(Exception ex){await ShowToast($"❌ خطأ: {ex.Message}", false);}
    }
    private void ShowDeleteContact(int id){contactToDelete=contacts.FirstOrDefault(c=>c.ContactID==id);showDeleteContactDialog=true;}
    private async Task ConfirmDeleteContact(){if(contactToDelete==null)return;try{await SupService.DeleteContactAsync(contactToDelete.ContactID, UserSession.UserID);contacts=await SupService.GetContactsAsync(SupplierId);showDeleteContactDialog=false;await ShowToast("✅ تم حذف جهة الاتصال", true);}catch(Exception ex){await ShowToast($"❌ خطأ: {ex.Message}", false);}}
    private async Task ShowAddItem()
    {
        if(allItems==null){isLoadingItems=true;StateHasChanged();try{allItems=await LookupService.GetItemsForPurchaseSearchableAsync();}catch(Exception ex){await ShowToast($"❌ خطأ في تحميل الأصناف: {ex.Message}", false);isLoadingItems=false;StateHasChanged();return;}finally{isLoadingItems=false;}}
        newItem=new(){SupplierID=SupplierId};itemErrors.Clear();showItemForm=true;StateHasChanged();
    }
    private void HandleItemSelected(int itemId){newItem.ItemID=itemId;if(itemId>0&&itemErrors.ContainsKey(nameof(newItem.ItemID)))itemErrors.Remove(nameof(newItem.ItemID));StateHasChanged();}
    private async Task SaveItem(){var errors=ValidateItem();if(errors.Any()){StateHasChanged();return;}try{await SupService.InsertSupplierItemAsync(newItem, UserSession.UserID);supplierItems=await SupService.GetSupplierItemsAsync(SupplierId);newItem=new(){SupplierID=SupplierId};showItemForm=false;await ShowToast("✅ تم إضافة صنف", true);}catch(Exception ex){await ShowToast($"❌ خطأ: {ex.Message}", false);}}
    private void ShowDeleteItem(int id){itemToDelete=supplierItems.FirstOrDefault(i=>i.SupplierItemID==id);showDeleteItemDialog=true;}
    private async Task ConfirmDeleteItem(){if(itemToDelete==null)return;try{await SupService.DeleteSupplierItemAsync(itemToDelete.SupplierItemID, UserSession.UserID);supplierItems=await SupService.GetSupplierItemsAsync(SupplierId);showDeleteItemDialog=false;await ShowToast("✅ تم حذف الصنف", true);}catch(Exception ex){await ShowToast($"❌ خطأ: {ex.Message}", false);}}
    private async Task PrintCard(){isPrintLoading=true;StateHasChanged();try{var html=await SupService.GenerateSupplierCardHtmlAsync(SupplierId, UserSession.UserID);await JS.InvokeVoidAsync("printHtml", html);await ShowToast("🖨️ تم الطباعة", true);}catch(Exception ex){await ShowToast($"❌ خطأ: {ex.Message}", false);}finally{isPrintLoading=false;StateHasChanged();}}
    private async Task CopyToClipboard(string text){try{await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);await ShowToast($"📋 تم نسخ: {text}", true);await Task.Delay(2000);toast="";}catch{await ShowToast("❌ خطأ في النسخ", false);}}
    private async Task ShowToast(string message, bool isSuccess=true){toast=message;toastOk=isSuccess;StateHasChanged();await Task.Delay(3000);toast="";StateHasChanged();}
    private void GoBack()=>Navigation.NavigateTo("/suppliers");
}
