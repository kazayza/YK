            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_PRODORD");

        if (permissions != null && permissions.CanView)
            await LoadData();
        else
            isLoading = false;
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            int? status = int.TryParse(statusFilter, out var s) ? s : null;
            int? priority = int.TryParse(priorityFilter, out var p) ? p : null;

            orders = await OrderService.GetOrderListAsync(
                searchQuery, status, priority, fromDate, toDate);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadData();
    }

    private void NavigateToAdd()
    {
        if (permissions?.CanAdd == true)
            NavigationManager.NavigateTo("/production-orders/edit/0");
    }

    private void NavigateToEdit(int orderId)
    {
        NavigationManager.NavigateTo($"/production-orders/edit/{orderId}");
    }

    // ===== Approve =====
    private void ApproveOrder(ProductionOrderListDto order)
    {
        selectedOrder = order;
        showApproveDialog = true;
    }

    private async Task ConfirmApprove()
    {
        if (selectedOrder == null) return;
        isProcessing = true;

        try
        {
            var result = await OrderService.ChangeStatusAsync(
                selectedOrder.ProductionOrderID, 2, UserSession.UserID);

            isSuccess = result.Success;
            resultMessage = result.Message;

            if (result.Success)
            {
                showApproveDialog = false;
                await LoadData();
            }
        }
        finally
        {
            isProcessing = false;
            _ = ClearMessage();
        }
    }

    // ===== Cancel =====
    private void CancelOrder(ProductionOrderListDto order)
    {
        selectedOrder = order;
        showCancelDialog = true;
    }

    private async Task ConfirmCancel()
    {
        if (selectedOrder == null) return;
        isProcessing = true;

        try
        {
            var result = await OrderService.CancelOrderAsync(
                selectedOrder.ProductionOrderID, UserSession.UserID);

            isSuccess = result.Success;
            resultMessage = result.Message;

            if (result.Success)
            {
                showCancelDialog = false;
                await LoadData();
            }
        }
        finally
        {
            isProcessing = false;
            _ = ClearMessage();
        }
    }

    private void CloseDialogs()
    {
        showApproveDialog = false;
        showCancelDialog = false;
        selectedOrder = null;
    }

    // ===== Print =====
    private async Task PrintOrder(int orderId)
    {
        if (permissions?.CanPrint != true) return;

        var order = await OrderService.GetOrderByIdAsync(orderId);
        if (order == null) return;

        var materials = await OrderService.GetOrderMaterialsAsync(orderId);
        var rawMaterials = materials.Where(m => m.MaterialType == 1).ToList();
        var packMaterials = materials.Where(m => m.MaterialType == 2).ToList();

        var html = BuildPrintHtml(order, rawMaterials, packMaterials);
        await JS.InvokeVoidAsync("printHtml", html);
    }

    // ===== Export =====
    private async Task ExportToExcel()
    {
        if (permissions?.CanExport != true) return;
        isExporting = true;
        try
        {
            var fileBytes = await OrderService.ExportToExcelAsync(orders, UserSession.UserID);
            var fileName = $"ProductionOrders_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";
            var base64 = Convert.ToBase64String(fileBytes);
            await JS.InvokeVoidAsync("downloadFile", fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
        }
        finally
        {
            isExporting = false;
        }
    }

    // ===== Message =====
    private async Task ClearMessage()
    {
        await Task.Delay(4000);
        resultMessage = null;
        StateHasChanged();
    }

    // ===== Helpers =====
    private string GetStatusClass(int status) => status switch
    {
        1 => "s-draft",
        2 => "s-approved",
        3 => "s-preparing",
        4 => "s-inprogress",
        5 => "s-qc",
        6 => "s-completed",
        7 => "s-cancelled",
        _ => "s-draft"
    };

    private string GetPriorityClass(int priority) => priority switch
    {
        1 => "p-urgent",
        2 => "p-normal",
        3 => "p-low",
        _ => "p-normal"
    };

        // ===== Live Tracking =====
    private async Task OpenTracking(int orderId, string orderNumber, string productName)
    {
        showTrackingModal = true;
        trackingOrderId = orderId;
        trackingOrderNumber = orderNumber;
        trackingProductName = productName;
        trackingLoading = true;

        try
        {
            trackingBatches = await DashboardService.GetProductionOrderLiveBatchesAsync(orderId);

            var batchIds = trackingBatches
                .Select(b => b.BatchID)
                .Distinct()
                .ToList();

            if (batchIds.Any())
            {
                trackingStages = await DashboardService.GetActiveBatchesStagesAsync(batchIds);
            }
            else
            {
                trackingStages = new List<StageTimelineItemDto>();
            }
        }
        finally
        {
            trackingLoading = false;
        }
    }

    private void CloseTracking()
    {
        showTrackingModal = false;
        trackingBatches = new();
        trackingStages = new();
    }

    private string GetBatchStatusClass(int status) => status switch
    {
        2 => "tbs-running",
        3 => "tbs-complete",
        4 => "tbs-qc",
        _ => "tbs-running"
    };

    private string GetStageTimelineClass(int stageStatus) => stageStatus switch
    {
        3 => "tl-done",
        2 => "tl-running",
        4 => "tl-problem",
        _ => "tl-waiting"
    };

    private string GetHLineClass(int stageStatus) => stageStatus switch
    {
        3 => "hline-done",
        2 => "hline-running",
        _ => ""
    };

    private string GetProgressColor(decimal percent) =>
        percent >= 80 ? "prog-high" :
        percent >= 40 ? "prog-mid" : "prog-low";

    // ===== Print HTML =====
    private string BuildPrintHtml(
        ProductionOrderEditDto order,
        List<ProductionOrderMaterialDto> rawMaterials,
        List<ProductionOrderMaterialDto> packMaterials)
    {
        var thStyle = "padding:11px 14px;text-align:right;font-weight:700;" +
                      "color:#374151;border-bottom:2px solid #e5e7eb;font-size:13px;";
        var tdStyle = "padding:10px 14px;border-bottom:1px solid #f3f4f6;font-size:13px;";

        var rawRows = new System.Text.StringBuilder();
        int i = 1;
        foreach (var m in rawMaterials)
        {
            rawRows.Append($@"
            <tr>
                <td style='{tdStyle}text-align:center;color:#94a3b8;'>{i++}</td>
                <td style='{tdStyle}font-family:monospace;color:#0f766e;font-weight:700;'>{m.ItemCode}</td>
                <td style='{tdStyle}font-weight:600;'>{m.ItemName}</td>
                <td style='{tdStyle}text-align:center;font-weight:600;'>{m.RequiredQty:N3}</td>
                <td style='{tdStyle}text-align:center;color:#64748b;'>{m.UnitName}</td>
                <td style='{tdStyle}text-align:center;'>{m.IssuedQty:N3}</td>
                <td style='{tdStyle}text-align:left;font-weight:700;color:#10b981;'>{m.LineCost:N2}</td>
            </tr>");
        }

        var pkgRows = new System.Text.StringBuilder();
        int j = 1;
        foreach (var m in packMaterials)
        {
            pkgRows.Append($@"
            <tr>
                <td style='{tdStyle}text-align:center;color:#94a3b8;'>{j++}</td>
                <td style='{tdStyle}font-family:monospace;color:#0f766e;font-weight:700;'>{m.ItemCode}</td>
                <td style='{tdStyle}font-weight:600;'>{m.ItemName}</td>
                <td style='{tdStyle}text-align:center;font-weight:600;'>{m.RequiredQty:N3}</td>
                <td style='{tdStyle}text-align:center;color:#64748b;'>{m.UnitName}</td>
                <td style='{tdStyle}text-align:center;'>{m.IssuedQty:N3}</td>
                <td style='{tdStyle}text-align:left;font-weight:700;color:#10b981;'>{m.LineCost:N2}</td>
            </tr>");
        }

        var tHead = $@"
        <thead>
            <tr style='background:#f8fafc;'>
                <th style='{thStyle}text-align:center;width:40px;'>#</th>
                <th style='{thStyle}'>كود الصنف</th>
                <th style='{thStyle}'>اسم الصنف</th>
                <th style='{thStyle}text-align:center;'>الكمية المطلوبة</th>
                <th style='{thStyle}text-align:center;'>الوحدة</th>
                <th style='{thStyle}text-align:center;'>المصروف</th>
                <th style='{thStyle}text-align:left;'>التكلفة (ج.م)</th>
            </tr>
        </thead>";

        var rawSection = rawMaterials.Any() ? $@"
        <h3 style='border-right:4px solid #0f766e;padding-right:12px;
                   margin:28px 0 14px;font-size:.95rem;color:#1f2937;'>
            📦 المواد الخام ({rawMaterials.Count} صنف)
        </h3>
        <table style='width:100%;border-collapse:collapse;border:1px solid #e5e7eb;
                      border-radius:10px;overflow:hidden;margin-bottom:8px;'>
            {tHead}
            <tbody>{rawRows}</tbody>
        </table>" : "";

        var pkgSection = packMaterials.Any() ? $@"
        <h3 style='border-right:4px solid #10b981;padding-right:12px;
                   margin:28px 0 14px;font-size:.95rem;color:#1f2937;'>
            🎁 مواد التعبئة ({packMaterials.Count} صنف)
        </h3>
        <table style='width:100%;border-collapse:collapse;border:1px solid #e5e7eb;
                      border-radius:10px;overflow:hidden;margin-bottom:8px;'>
            {tHead}
            <tbody>{pkgRows}</tbody>
        </table>" : "";

        var statusName = order.OrderStatus switch
        {
            1 => "مسودة", 2 => "معتمد", 3 => "جاري التجهيز",
            4 => "قيد التصنيع", 5 => "فحص الجودة",
            6 => "مكتمل", 7 => "ملغي", _ => "—"
        };

        var priorityName = order.OrderPriority switch
        {
            1 => "🔴 عاجل", 2 => "🟡 عادي", 3 => "🟢 غير عاجل", _ => ""
        };

        return $@"<!DOCTYPE html>
<html lang='ar' dir='rtl'>
<head>
<meta charset='UTF-8'>
<title>أمر تصنيع - {order.OrderNumber}</title>
<style>
    * {{ margin:0; padding:0; box-sizing:border-box; }}
    body {{
        font-family:'Segoe UI',Tahoma,sans-serif;
        direction:rtl; background:#fff; color:#1f2937;
        padding:30px; font-size:14px; line-height:1.6;
    }}
    .no-print {{ }}
    @media print {{ .no-print {{ display:none !important; }} body {{ padding:15px; }} }}
</style>
</head>
<body>
<div class='no-print' style='margin-bottom:24px;display:flex;gap:10px;justify-content:flex-end;'>
    <button onclick='window.print()'
        style='background:#0f766e;color:#fff;border:none;padding:10px 24px;
               border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;'>
        🖨️ طباعة
    </button>
    <button onclick='window.close()'
        style='background:#6b7280;color:#fff;border:none;padding:10px 24px;
               border-radius:8px;font-size:14px;font-weight:700;cursor:pointer;'>
        ✕ إغلاق
    </button>
</div>

<div style='text-align:center;border-bottom:3px solid #0f766e;padding-bottom:20px;margin-bottom:28px;'>
    <div style='font-size:2.2rem;margin-bottom:8px;'>🏭</div>
    <h1 style='font-size:1.7rem;font-weight:800;color:#1f2937;margin:0;'>واي كي كوتينج ERP</h1>
    <p style='color:#6b7280;margin:6px 0 0;'>أمر تصنيع (Production Order)</p>
</div>

<div style='display:grid;grid-template-columns:1fr 1fr;gap:12px 32px;
            background:#f9fafb;padding:20px;border-radius:12px;
            margin-bottom:28px;border:1px solid #e5e7eb;'>
    <div style='display:flex;gap:10px;'>
        <span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>رقم الأمر:</span>
        <span style='font-weight:800;color:#0f766e;font-size:13px;'>{order.OrderNumber}</span>
    </div>
    <div style='display:flex;gap:10px;'>
        <span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>التاريخ:</span>
        <span style='font-size:13px;'>{order.OrderDate:dd/MM/yyyy}</span>
    </div>
    <div style='display:flex;gap:10px;'>
        <span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>الكمية المخططة:</span>
        <span style='font-weight:700;font-size:13px;'>{order.PlannedQty:N2}</span>
    </div>
    <div style='display:flex;gap:10px;'>
        <span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>عدد الدفعات:</span>
        <span style='font-size:13px;'>{order.NumberOfBatches}</span>
    </div>
    <div style='display:flex;gap:10px;'>
        <span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>الحالة:</span>
        <span style='font-size:13px;'>{statusName}</span>
    </div>
    <div style='display:flex;gap:10px;'>
        <span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>الأولوية:</span>
        <span style='font-size:13px;'>{priorityName}</span>
    </div>
    <div style='grid-column:span 2;border-top:2px solid #e5e7eb;padding-top:14px;margin-top:6px;display:flex;gap:10px;'>
        <span style='font-weight:700;min-width:130px;color:#64748b;font-size:13px;'>التكلفة التقديرية:</span>
        <span style='font-weight:800;color:#10b981;font-size:1.1rem;'>{order.EstimatedTotalCost:N2} ج.م</span>
    </div>
</div>

{rawSection}
{pkgSection}

<div style='margin-top:40px;padding-top:18px;border-top:2px solid #e5e7eb;
            text-align:center;color:#94a3b8;font-size:12px;'>
    <p>تاريخ الطباعة: {DateTime.Now:yyyy/MM/dd - hh:mm tt}</p>
    <p style='margin-top:4px;'>واي كي كوتينج ERP — نظام تخطيط موارد المؤسسات</p>
</div>
</body>
</html>";
    }
}