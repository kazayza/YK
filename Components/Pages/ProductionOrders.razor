@page "/production-orders"
@using YKCoatings.Services
@using YKCoatings.Models
@inject ProductionOrderService OrderService
@inject DashboardService DashboardService
@inject NavigationManager NavigationManager
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject IJSRuntime JS

<PageTitle>أوامر التصنيع - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card">
        <div class="no-access-icon">🔒</div>
        <h4>يجب تسجيل الدخول أولاً</h4>
    </div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access-card">
        <div class="no-access-icon">⛔</div>
        <h4>ليس لديك صلاحية لعرض هذه الشاشة</h4>
        <button class="btn-back-dash" @onclick='() => NavigationManager.NavigateTo("/dashboard")'>
            العودة للرئيسية
        </button>
    </div>
}
else
{
    <div class="po-page">

        <!-- ===== Header ===== -->
        <div class="page-header">
            <div class="header-content">
                <h1 class="header-title">
                    <i class="bi bi-gear-wide-connected"></i>
                    أوامر التصنيع
                </h1>
                <p class="header-subtitle">Production Orders Management</p>
            </div>
            <div class="header-actions">
                @if (permissions.CanExport)
                {
                    <button class="btn-success-modern" @onclick="ExportToExcel" disabled="@isExporting">
                        @if (isExporting)
                        {
                            <span class="spinner-tiny"></span>
                            <span>جاري التصدير...</span>
                        }
                        else
                        {
                            <i class="bi bi-file-earmark-excel-fill"></i>
                            <span>تصدير إكسيل</span>
                        }
                    </button>
                }
                @if (permissions.CanAdd)
                {
                    <button class="btn-primary-modern" @onclick="NavigateToAdd">
                        <i class="bi bi-plus-lg"></i>
                        <span>أمر تصنيع جديد</span>
                    </button>
                }
            </div>
        </div>

        <!-- ===== Stats ===== -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-icon-wrap primary"><i class="bi bi-clipboard-data-fill"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@orders.Count</div>
                    <div class="stat-label">إجمالي الأوامر</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon-wrap warning"><i class="bi bi-hourglass-split"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@orders.Count(o => o.OrderStatus == 4)</div>
                    <div class="stat-label">قيد التصنيع</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon-wrap success"><i class="bi bi-check-circle-fill"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@orders.Count(o => o.OrderStatus == 6)</div>
                    <div class="stat-label">مكتمل</div>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon-wrap danger"><i class="bi bi-exclamation-triangle-fill"></i></div>
                <div class="stat-info">
                    <div class="stat-value">@orders.Count(o => o.OrderPriority == 1)</div>
                    <div class="stat-label">عاجل</div>
                </div>
            </div>
        </div>

        <!-- ===== Filters ===== -->
        <div class="filter-card">
            <div class="filter-header">
                <i class="bi bi-funnel-fill"></i>
                خيارات التصفية والبحث
            </div>
            <div class="filter-body">
                <div class="filter-group" style="flex:2; min-width:220px;">
                    <label class="filter-label">بحث سريع</label>
                    <div class="search-wrap">
                        <i class="bi bi-search search-ico"></i>
                        <input type="text"
                               class="filter-input"
                               placeholder="رقم الأمر أو اسم المنتج..."
                               @bind="searchQuery"
                               @bind:event="oninput"
                               @onkeyup="HandleSearch" />
                    </div>
                </div>
                <div class="filter-group" style="flex:1; min-width:140px;">
                    <label class="filter-label">الحالة</label>
                    <select class="filter-select" @bind="statusFilter">
                        <option value="">— الكل —</option>
                        <option value="1">📝 مسودة</option>
                        <option value="2">✅ معتمد</option>
                        <option value="3">⚙️ جاري التجهيز</option>
                        <option value="4">🏭 قيد التصنيع</option>
                        <option value="5">🔬 فحص الجودة</option>
                        <option value="6">✔️ مكتمل</option>
                        <option value="7">❌ ملغي</option>
                    </select>
                </div>
                <div class="filter-group" style="flex:1; min-width:140px;">
                    <label class="filter-label">الأولوية</label>
                    <select class="filter-select" @bind="priorityFilter">
                        <option value="">— الكل —</option>
                        <option value="1">🔴 عاجل</option>
                        <option value="2">🟡 عادي</option>
                        <option value="3">🟢 غير عاجل</option>
                    </select>
                </div>
                <div class="filter-group" style="flex:1; min-width:140px;">
                    <label class="filter-label">من تاريخ</label>
                    <input type="date" class="filter-input" @bind="fromDate" />
                </div>
                <div class="filter-group" style="flex:1; min-width:140px;">
                    <label class="filter-label">إلى تاريخ</label>
                    <input type="date" class="filter-input" @bind="toDate" />
                </div>
                <div class="filter-group" style="flex:.6; min-width:100px; justify-content:flex-end;">
                    <label class="filter-label" style="visibility:hidden;">.</label>
                    <button class="btn-primary-modern" @onclick="LoadData">
                        <i class="bi bi-search"></i>
                        <span>تصفية</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- ===== Table ===== -->
        <div class="table-card">
            <div class="table-card-header">
                <div class="table-card-title">
                    <i class="bi bi-table"></i>
                    قائمة أوامر التصنيع
                    @if (!isLoading)
                    {
                        <span class="count-badge">@orders.Count أمر</span>
                    }
                </div>
            </div>

            @if (isLoading)
            {
                <div class="state-box">
                    <div class="spinner-md"></div>
                    <span class="state-text">جاري تحميل البيانات...</span>
                </div>
            }
            else if (!orders.Any())
            {
                <div class="state-box">
                    <div class="empty-icon-circle">
                        <i class="bi bi-inbox"></i>
                    </div>
                    <p class="empty-title">لا توجد أوامر تصنيع مطابقة</p>
                    <p class="empty-sub">جرّب تغيير معايير البحث أو أضف أمر تصنيع جديد</p>
                    @if (permissions.CanAdd)
                    {
                        <button class="btn-primary-modern" @onclick="NavigateToAdd">
                            <i class="bi bi-plus-lg"></i>
                            <span>أمر تصنيع جديد</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="table-scroll">
                    <table class="po-table">
                        <thead>
                            <tr>
                                <th>رقم الأمر</th>
                                <th>التاريخ</th>
                                <th>المنتج</th>
                                <th class="tc">الأولوية</th>
                                <th class="tc">الكمية المخططة</th>
                                <th class="tc">المنتج فعلياً</th>
                                <th class="tc">الدفعات</th>
                                <th class="tr">التكلفة التقديرية</th>
                                <th class="tc">نسبة الإنجاز</th>
                                <th class="tc">الحالة</th>
                                <th class="tc" style="width:50px;">متابعة</th>
                                <th class="tc">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in orders)
                            {
                                <tr class="@(order.OrderPriority == 1 ? "urgent-row" : "")">
                                    <td>
                                        <span class="code-chip">@order.OrderNumber</span>
                                    </td>
                                    <td>
                                        <span class="date-txt">@order.OrderDate.ToString("dd/MM/yyyy")</span>
                                    </td>
                                    <td>
                                        <div class="prod-name">@order.ProductName</div>
                                        <div class="prod-code">@order.BOMName</div>
                                    </td>
                                    <td class="tc">
                                        <span class="priority-chip @GetPriorityClass(order.OrderPriority)">
                                            @order.PriorityName
                                        </span>
                                    </td>
                                    <td class="tc">
                                        <span class="qty-val">@order.PlannedQty.ToString("N2")</span>
                                        <span class="qty-unit">@order.UnitName</span>
                                    </td>
                                    <td class="tc">
                                        <span class="qty-val @(order.ActualQty > 0 ? "has-value" : "no-value")">
                                            @order.ActualQty.ToString("N2")
                                        </span>
                                    </td>
                                    <td class="tc">
                                        <div class="batch-info">
                                            <span class="batch-done">@order.CompletedBatchCount</span>
                                            <span class="batch-sep">/</span>
                                            <span class="batch-total">@order.BatchCount</span>
                                        </div>
                                    </td>
                                    <td class="tr">
                                        <span class="cost-val">@order.EstimatedTotalCost.ToString("N2")</span>
                                    </td>
                                    <td class="tc">
                                        <div class="progress-wrap">
                                            <div class="progress-bar">
                                                <div class="progress-fill @GetProgressColor(order.CompletionPercent)"
                                                     style="width:@(Math.Min(order.CompletionPercent, 100))%">
                                                </div>
                                            </div>
                                            <span class="progress-text">@order.CompletionPercent%</span>
                                        </div>
                                    </td>
                                    <td class="tc">
                                        <span class="status-chip @GetStatusClass(order.OrderStatus)">
                                            @order.StatusName
                                        </span>
                                    </td>
                                    <td class="tc">
                                        <div class="actions-wrap">
                                            @if (order.OrderStatus == 1 && permissions.CanEdit)
                                            {
                                                <button class="ico-btn edit-btn"
                                                        title="تعديل"
                                                        @onclick="() => NavigateToEdit(order.ProductionOrderID)">
                                                    <i class="bi bi-pencil-fill"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="ico-btn view-btn"
                                                        title="عرض التفاصيل"
                                                        @onclick="() => NavigateToEdit(order.ProductionOrderID)">
                                                    <i class="bi bi-eye-fill"></i>
                                                </button>
                                            }

                                            @if (order.OrderStatus == 1 && permissions.CanApprove)
                                            {
                                                <button class="ico-btn approve-btn"
                                                        title="اعتماد"
                                                        @onclick="() => ApproveOrder(order)">
                                                    <i class="bi bi-check-circle-fill"></i>
                                                </button>
                                            }

                                            @if (order.OrderStatus == 1 && permissions.CanCancel)
                                            {
                                                <button class="ico-btn cancel-btn"
                                                        title="إلغاء"
                                                        @onclick="() => CancelOrder(order)">
                                                    <i class="bi bi-x-circle-fill"></i>
                                                </button>
                                            }

                                            @if (permissions.CanPrint)
                                            {
                                                <button class="ico-btn print-btn"
                                                        title="طباعة"
                                                        @onclick="() => PrintOrder(order.ProductionOrderID)">
                                                    <i class="bi bi-printer-fill"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                    <td class="tc">
    @if (order.OrderStatus == 3 || order.OrderStatus == 4 || order.OrderStatus == 5)
    {
        <button class="btn-track" title="متابعة لحظية" @onclick:stopPropagation @onclick="() => OpenTracking(order.ProductionOrderID, order.OrderNumber, order.ProductName)">
            <i class="bi bi-activity"></i>
        </button>
    }
    else
    {
        <span class="text-muted">—</span>
    }
</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
}

<!-- ===== تأكيد الاعتماد ===== -->
@if (showApproveDialog)
{
    <div class="modal-overlay" @onclick="CloseDialogs">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header approve-header">
                <i class="bi bi-check-circle-fill"></i>
                تأكيد اعتماد أمر التصنيع
            </div>
            <div class="modal-body">
                <p>هل تريد اعتماد أمر التصنيع رقم:</p>
                <div class="modal-highlight">@selectedOrder?.OrderNumber</div>
                <p class="modal-sub">المنتج: @selectedOrder?.ProductName</p>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel-modal" @onclick="CloseDialogs">إلغاء</button>
                <button class="btn-confirm-approve" @onclick="ConfirmApprove" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-tiny"></span>
                    }
                    <span>اعتماد</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- ===== تأكيد الإلغاء ===== -->
@if (showCancelDialog)
{
    <div class="modal-overlay" @onclick="CloseDialogs">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-header cancel-header">
                <i class="bi bi-x-circle-fill"></i>
                تأكيد إلغاء أمر التصنيع
            </div>
            <div class="modal-body">
                <p>هل أنت متأكد من إلغاء أمر التصنيع رقم:</p>
                <div class="modal-highlight danger">@selectedOrder?.OrderNumber</div>
                <p class="modal-warning">⚠️ لا يمكن التراجع عن هذا الإجراء</p>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel-modal" @onclick="CloseDialogs">تراجع</button>
                <button class="btn-confirm-cancel" @onclick="ConfirmCancel" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span class="spinner-tiny"></span>
                    }
                    <span>إلغاء الأمر</span>
                </button>
            </div>
        </div>
    </div>
}

<!-- ===== رسالة النتيجة ===== -->
@if (!string.IsNullOrEmpty(resultMessage))
{
    <div class="toast-msg @(isSuccess ? "toast-success" : "toast-error")">
        <i class="bi @(isSuccess ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
        @resultMessage
    </div>
}
@* ===== LIVE TRACKING MODAL ===== *@
@if (showTrackingModal)
{
    <div class="modal-overlay" @onclick="CloseTracking">
        <div class="modal-track" @onclick:stopPropagation>
            <div class="modal-track-header">
                <div class="modal-track-title">
                    <i class="bi bi-activity"></i>
                    متابعة لحظية
                </div>
                <div class="modal-track-info">
                    <span class="modal-track-order">@trackingOrderNumber</span>
                    <span class="modal-track-product">@trackingProductName</span>
                </div>
                <button class="modal-track-close" @onclick="CloseTracking">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="modal-track-body">
                @if (trackingLoading)
                {
                    <div class="track-state-box">
                        <div class="spinner-md"></div>
                        <span>جاري تحميل البيانات...</span>
                    </div>
                }
                else if (!trackingBatches.Any())
                {
                    <div class="track-state-box">
                        <div class="track-empty-icon"><i class="bi bi-inbox"></i></div>
                        <div>لا توجد دفعات نشطة لهذا الأمر</div>
                    </div>
                }
                else
                {
                    @foreach (var batch in trackingBatches)
                    {
                        var batchStages = trackingStages
                            .Where(s => s.BatchID == batch.BatchID)
                            .OrderBy(s => s.StageOrder)
                            .ToList();

                        <div class="track-batch-card">
                            <div class="track-batch-head">
                                <div>
                                    <span class="track-batch-num">@batch.BatchNumber</span>
                                    <span class="track-batch-status @GetBatchStatusClass(batch.BatchStatus)">
                                        @batch.BatchStatusName
                                    </span>
                                </div>
                                <div class="track-batch-meta">
                                    @if (batch.StageStartTime.HasValue)
                                    {
                                        <span>بدأت: @batch.StageStartTime.Value.ToString("dd/MM hh:mm tt")</span>
                                    }
                                    @if (batch.ElapsedMinutes > 0)
                                    {
                                        <span class="track-elapsed">منذ @batch.ElapsedText</span>
                                    }
                                </div>
                            </div>

                            @if (batchStages.Any())
                            {
                                <div class="track-tl-wrap">
                                    <div class="track-tl-scroll">
                                        <div class="track-tl-track">
                                            @foreach (var stage in batchStages)
                                            {
                                                <div class="htl-step @GetStageTimelineClass(stage.StageStatus)">
                                                    <div class="htl-top-row">
                                                        <div class="htl-dot"></div>
                                                        @if (stage.StageOrder < batchStages.Last().StageOrder)
                                                        {
                                                            <div class="htl-line @GetHLineClass(stage.StageStatus)"></div>
                                                        }
                                                    </div>
                                                    <div class="htl-content">
                                                        <div class="htl-name">@stage.StageName</div>
                                                        @if (stage.StageStatus == 3)
                                                        {
                                                            <div class="htl-meta htl-meta-done">
                                                                <span class="htl-badge-done">✓ تمت</span>
                                                                @if (!string.IsNullOrWhiteSpace(stage.DurationText))
                                                                {
                                                                    <span class="htl-dur">⏱ @stage.DurationText</span>
                                                                }
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(stage.OperatorName))
                                                            {
                                                                <div class="htl-op">👤 @stage.OperatorName</div>
                                                            }
                                                        }
                                                        else if (stage.StageStatus == 2)
                                                        {
                                                            <div class="htl-meta htl-meta-run">
                                                                <span class="htl-badge-run">● جارية</span>
                                                                @if (!string.IsNullOrWhiteSpace(stage.DurationText))
                                                                {
                                                                    <span class="htl-dur">⏱ منذ @stage.DurationText</span>
                                                                }
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(stage.OperatorName))
                                                            {
                                                                <div class="htl-op">👤 @stage.OperatorName</div>
                                                            }
                                                        }
                                                        else if (stage.StageStatus == 4)
                                                        {
                                                            <div class="htl-meta htl-meta-err">
                                                                <span class="htl-badge-err">✗ مشكلة</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="htl-meta htl-meta-wait">
                                                                <span>في الانتظار</span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="track-progress-wrap">
                                    <div class="track-progress-head">
                                        <span>التقدم</span>
                                        <span>@batch.CompletedStages / @batch.TotalStages</span>
                                    </div>
                                    <div class="track-progress-bar">
                                        <div class="track-progress-fill" style="width:@batch.ProgressPercent%"></div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="track-no-stages">لم يتم تحميل مراحل بعد</div>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

<style>
    /* ===== Variables ===== */
    :root {
        --c-primary:      #4f46e5;
        --c-primary-lt:   #eef2ff;
        --c-primary-dk:   #3730a3;
        --c-success:      #10b981;
        --c-success-lt:   #ecfdf5;
        --c-warning:      #f59e0b;
        --c-warning-lt:   #fffbeb;
        --c-danger:       #ef4444;
        --c-danger-lt:    #fef2f2;
        --c-info:         #0ea5e9;
        --c-info-lt:      #f0f9ff;
        --c-secondary:    #64748b;
        --c-secondary-lt: #f1f5f9;
        --c-surface:      #ffffff;
        --c-bg:           #f8fafc;
        --c-border:       #e2e8f0;
        --c-text:         #0f172a;
        --c-text-2:       #64748b;
        --c-text-3:       #94a3b8;
        --r-sm: 8px;
        --r-md: 12px;
        --r-lg: 16px;
        --r-xl: 20px;
        --sh-sm: 0 1px 3px rgba(0,0,0,.06);
        --sh-md: 0 4px 16px rgba(0,0,0,.08);
    }

    /* ===== Page ===== */
    .po-page {
        direction: rtl;
        padding: 1.75rem 1.5rem;
        background: var(--c-bg);
        min-height: 100vh;
        font-family: 'Segoe UI', system-ui, sans-serif;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    /* ===== No Access ===== */
    .no-access-card {
        text-align: center; padding: 80px 20px; background: white;
        border-radius: var(--r-xl); border: 1px solid var(--c-border);
        max-width: 480px; margin: 80px auto; box-shadow: var(--sh-sm);
    }
    .no-access-icon { font-size: 3.5rem; margin-bottom: 16px; }
    .no-access-card h4 { color: var(--c-text); margin-bottom: 20px; }
    .btn-back-dash {
        background: var(--c-secondary-lt); color: var(--c-secondary);
        border: none; padding: .6rem 1.4rem; border-radius: var(--r-sm);
        font-weight: 600; cursor: pointer;
    }

    /* ===== Header ===== */
    .page-header {
        background: linear-gradient(135deg, #0f766e, #115e59);
        border-radius: var(--r-xl); padding: 1.75rem 2rem;
        display: flex; justify-content: space-between; align-items: center;
        box-shadow: 0 8px 32px rgba(15,118,110,.25);
        position: relative; overflow: hidden; flex-wrap: wrap; gap: 1rem;
    }
    .page-header::before {
        content: ''; position: absolute; top: -40px; left: -40px;
        width: 180px; height: 180px; background: rgba(255,255,255,.06);
        border-radius: 50%;
    }
    .header-content { position: relative; z-index: 1; }
    .header-title {
        color: #fff; font-size: 1.5rem; font-weight: 700; margin: 0 0 .25rem;
        display: flex; align-items: center; gap: .6rem;
    }
    .header-title i { font-size: 1.6rem; opacity: .9; }
    .header-subtitle { color: rgba(255,255,255,.7); font-size: .85rem; margin: 0; }
    .header-actions {
        display: flex; gap: .75rem; position: relative; z-index: 1;
        align-items: center; flex-wrap: wrap;
    }

    /* ===== Buttons ===== */
    .btn-primary-modern {
        background: linear-gradient(135deg, var(--c-primary), var(--c-primary-dk));
        color: #fff; border: none; border-radius: var(--r-sm);
        padding: .6rem 1.25rem; font-size: .88rem; font-weight: 600;
