@code {
    [Parameter] public int ReturnId { get; set; }

    private PurchaseReturnHeaderDto header = new() { ReturnDate = DateTime.Today, ReturnType = 1 };
    private List<PurchaseReturnDetailDto> details = new();
    private ModulePermissionDto? permissions;

    private List<LookupDto>? warehouses, units;
    private List<SearchableItem>? suppliersSearchable, purchaseItems, availableInvoices;
    private List<InvoiceLineForReturnDto>? invLines;
    private int selectedInvId;
    private bool isInvLoaded = false, isSourceLocked = false;

    private bool isLoading = true, isSaving = false;
    private string toast = ""; private bool toastOk = true;

    private bool showLineForm = false, isEditLine = false;
    private PurchaseReturnDetailEditDto editLine = new();
    private bool isSavingLine = false;
    private string lineMsg = ""; private bool lineMsgOk = true;

    private bool showRejectDialog = false;
    private string rejectReason = "", rejectMsg = "";

    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => ReturnId == 0;
    private bool isApprovalMode => !isNewMode && !isViewMode && header.ReturnStatus == 2 && (permissions?.CanApprove ?? false);
    private bool isReadOnly { get { if (isViewMode) return true; if (isNewMode) return false; return header.ReturnStatus != 1; } }
    private string pageTitle => isNewMode ? "مرتجع مشتريات جديد" : isViewMode ? "عرض مرتجع" : isApprovalMode ? "اعتماد مرتجع" : "تعديل مرتجع";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
            if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_PRET");
            if (permissions == null || !permissions.CanView) return;
            warehouses = await LookupService.GetReceivingWarehousesAsync();
            units = await LookupService.GetUnitsAsync();
            suppliersSearchable = await LookupService.GetSuppliersSearchableAsync();
            purchaseItems = await LookupService.GetItemsForPurchaseSearchableAsync();
            if (ReturnId > 0) { var l = await RetService.GetReturnByIdAsync(ReturnId); if (l != null) { header = l; details = await RetService.GetReturnDetailsAsync(ReturnId); isSourceLocked = true; isInvLoaded = true; } else { toast = "المرتجع غير موجود"; toastOk = false; } }
            else { var uri = Navigation.ToAbsoluteUri(Navigation.Uri); var q = System.Web.HttpUtility.ParseQueryString(uri.Query);
                if (q["source"] == "invoice") { header.ReturnSource = 1; availableInvoices = await LookupService.GetInvoicesForReturnSearchableAsync(); }
                else if (q["source"] == "direct") { header.ReturnSource = 2; isSourceLocked = true; } }
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isLoading = false; StateHasChanged(); }
    }

    private void SelectInvoiceSource() { header.ReturnSource = 1; _ = Task.Run(async () => { availableInvoices = await LookupService.GetInvoicesForReturnSearchableAsync(); await InvokeAsync(StateHasChanged); }); }
    private void SelectDirectSource() { header.ReturnSource = 2; isSourceLocked = true; invLines = null; selectedInvId = 0; }

    private async Task OnInvoiceSelected(SearchableItem? item)
    {
        if (item == null || item.Id == 0) { invLines = null; return; }
        selectedInvId = item.Id; header.InvoiceID = item.Id;
        try
        {
            invLines = await LookupService.GetInvoiceLinesForReturnAsync(item.Id);
            foreach (var l in invLines) { l.IsSelected = true; l.ReturnQty = l.Quantity; l.ItemCondition = 1; }
            var info = await LookupService.GetInvoiceQuickInfoForReturnAsync(item.Id);
            if (info != null) { header.SupplierID = info.SupplierID; header.SupplierNameAr = info.SupplierNameAr; if (info.WarehouseID.HasValue) header.WarehouseID = info.WarehouseID.Value; }
            var si = await LookupService.GetSupplierQuickInfoAsync(header.SupplierID);
            if (si != null) { header.SupplierNameAr = si.SupplierNameAr; header.SupplierCode = si.SupplierCode; }
            StateHasChanged();
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; StateHasChanged(); }
    }

    private async Task OnSupplierSelected(SearchableItem? item) { if (item != null) { header.SupplierID = item.Id; var si = await LookupService.GetSupplierQuickInfoAsync(item.Id); if (si != null) { header.SupplierNameAr = si.SupplierNameAr; } StateHasChanged(); } }

    private void ToggleAllLines(ChangeEventArgs e) { if (invLines == null) return; var v = (bool)(e.Value ?? false); foreach (var l in invLines) l.IsSelected = v; }

    private async Task OnItemSelected(SearchableItem? item)
    { if (item == null) return; editLine.ItemID = item.Id; var info = await LookupService.GetItemQuickInfoAsync(item.Id);
      if (info != null) { if (info.UnitID > 0) editLine.UnitID = info.UnitID; if (info.EstimatedPrice > 0) editLine.UnitPrice = info.EstimatedPrice; } StateHasChanged(); }

    private async Task SaveReturn()
    {
        if (header.SupplierID <= 0) { toast = "اختر المورد"; toastOk = false; StateHasChanged(); return; }
        if (header.WarehouseID <= 0) { toast = "اختر المخزن"; toastOk = false; StateHasChanged(); return; }
        isSaving = true; StateHasChanged();
        try
        {
            if (isNewMode)
            {
                header.ReturnNumber = await RetService.GenerateReturnNumberAsync(); header.ReturnStatus = 1;
                var nid = await RetService.InsertReturnAsync(header, UserSession.UserID);
                ReturnId = nid; header.ReturnID = nid;
                if (header.ReturnSource == 1 && invLines != null)
                { var sel = invLines.Where(l => l.IsSelected && l.ReturnQty > 0).ToList();
                  if (sel.Any()) { var imp = await RetService.ImportLinesFromInvoiceAsync(nid, sel, UserSession.UserID); toast = $"تم الإنشاء وتحميل {imp} صنف ✅"; }
                  else toast = $"تم الإنشاء: {header.ReturnNumber} ✅"; }
                else toast = $"تم الإنشاء: {header.ReturnNumber} ✅";
                toastOk = true; isSourceLocked = true; isInvLoaded = true;
                details = await RetService.GetReturnDetailsAsync(nid); header = await RetService.GetReturnByIdAsync(nid) ?? header;
                Navigation.NavigateTo($"/purchase-returns/edit/{nid}", forceLoad: false);
            }
            else { await RetService.UpdateReturnAsync(header, UserSession.UserID); header = await RetService.GetReturnByIdAsync(ReturnId) ?? header; details = await RetService.GetReturnDetailsAsync(ReturnId); toast = "تم الحفظ ✅"; toastOk = true; }
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task SubmitForApproval()
    {
        if (!details.Any()) { toast = "أضف أصناف أولاً"; toastOk = false; StateHasChanged(); return; }
        isSaving = true; StateHasChanged();
        try { await RetService.SubmitForApprovalAsync(ReturnId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID); header.ReturnStatus = 2; toast = "تم الإرسال للاعتماد ✅"; toastOk = true; }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task ExecuteApprove()
{
    if (!details.Any())
    {
        toast = "لا يمكن اعتماد مرتجع بدون أصناف";
        toastOk = false;
        StateHasChanged();
        return;
    }

    try
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "هل تريد اعتماد المرتجع؟\n\nسيتم:\n• خصم من المخزون\n• تحديث رصيد المورد\n• إنشاء القيد المحاسبي");
        if (!confirmed) return;
    }
    catch { return; }

    isSaving = true;
    toast = "";
    StateHasChanged();

    try
    {
        await RetService.ApproveAsync(
            ReturnId,
            UserSession.CurrentUserID,
            UserSession.CurrentEmployeeID);

        header = await RetService.GetReturnByIdAsync(ReturnId) ?? header;
        details = await RetService.GetReturnDetailsAsync(ReturnId);

        isSaving = false;
        toast = "تم اعتماد المرتجع بنجاح ✅";
        toastOk = true;
        StateHasChanged();

        await Task.Delay(2000);
        Navigation.NavigateTo("/purchase-returns");
    }
    catch (Exception ex)
    {
        isSaving = false;
        toast = "خطأ في الاعتماد: " + ex.Message;
        toastOk = false;
        StateHasChanged();
    }
}

    private void DoShowReject() { rejectReason = ""; rejectMsg = ""; showRejectDialog = true; }
    private async Task ConfirmReject()
    { if (string.IsNullOrWhiteSpace(rejectReason)) { rejectMsg = "أدخل سبب الرفض"; return; }
      try { await RetService.RejectAsync(ReturnId, rejectReason, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
          header.ReturnStatus = 1; header.RejectionReason = rejectReason; showRejectDialog = false; toast = "تم رفض المرتجع"; toastOk = false; StateHasChanged();
          await Task.Delay(1500); Navigation.NavigateTo("/purchase-returns"); }
      catch (Exception ex) { rejectMsg = "خطأ: " + ex.Message; } }

    private void ShowAddLine() { isEditLine = false; editLine = new() { ReturnID = ReturnId, TaxRate = 14, ItemCondition = 1 }; lineMsg = ""; showLineForm = true; }
    private void ShowEditLine(PurchaseReturnDetailDto l)
    { isEditLine = true; editLine = new() { ReturnDetailID = l.ReturnDetailID, ReturnID = l.ReturnID, ItemID = l.ItemID, UnitID = l.UnitID,
        Quantity = l.Quantity, UnitPrice = l.UnitPrice,  TaxRate = l.TaxRate,
        BatchNumber = l.BatchNumber, ReturnReason = l.ReturnReason, ItemCondition = l.ItemCondition,
        InvoiceDetailID = l.InvoiceDetailID, Notes = l.Notes }; lineMsg = ""; showLineForm = true; }
    private void CloseLineForm() { showLineForm = false; lineMsg = ""; }

    private async Task SaveLine()
    { lineMsg = "";
      if (editLine.ItemID == 0) { lineMsg = "اختر الصنف"; lineMsgOk = false; return; }
      if (editLine.UnitID == 0) { lineMsg = "اختر الوحدة"; lineMsgOk = false; return; }
      if (editLine.Quantity <= 0) { lineMsg = "أدخل الكمية"; lineMsgOk = false; return; }
      if (isNewMode && ReturnId == 0) { await SaveReturn(); if (ReturnId == 0) return; editLine.ReturnID = ReturnId; }
      isSavingLine = true; StateHasChanged();
      try { if (isEditLine) await RetService.UpdateDetailAsync(editLine, UserSession.UserID); else await RetService.InsertDetailAsync(editLine, UserSession.UserID);
          details = await RetService.GetReturnDetailsAsync(ReturnId); header = await RetService.GetReturnByIdAsync(ReturnId) ?? header;
          showLineForm = false; toast = isEditLine ? "تم التحديث ✅" : "تم الإضافة ✅"; toastOk = true; }
      catch (Exception ex) { lineMsg = "خطأ: " + ex.Message; lineMsgOk = false; }
      finally { isSavingLine = false; StateHasChanged(); } }

    private async Task DeleteLine(int id)
    { try { await RetService.DeleteDetailAsync(id, UserSession.UserID); details = await RetService.GetReturnDetailsAsync(ReturnId);
          header = await RetService.GetReturnByIdAsync(ReturnId) ?? header; toast = "تم الحذف ✅"; toastOk = true; }
      catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; } StateHasChanged(); }

    private async Task PrintDoc()
    { try { var h = await RetService.GenerateReportHtmlAsync(ReturnId, UserSession.UserID); await JS.InvokeVoidAsync("printHtml", h); }
      catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; StateHasChanged(); } }

    private void GoBack() => Navigation.NavigateTo("/purchase-returns");
}