    .totals-bar{display:flex;justify-content:flex-end;gap:20px;flex-wrap:wrap;padding:18px 22px;background:white;border:1px solid #e2e8f0;border-radius:16px}.total-item{display:flex;flex-direction:column;align-items:center;gap:2px;min-width:100px}.total-label{font-size:.72rem;color:#64748b;font-weight:600}.total-value{font-size:1rem;font-weight:800;color:#0f172a;font-family:monospace}.total-grand{padding:8px 16px;background:linear-gradient(135deg,#dc2626,#ef4444);border-radius:12px}.total-grand .total-label{color:rgba(255,255,255,.8)}.total-grand .total-value{color:white;font-size:1.1rem}
    .empty-lines{text-align:center;padding:30px;color:#94a3b8}.line-actions{display:flex;gap:4px;justify-content:center}.act-btn{width:28px;height:28px;border-radius:7px;border:1px solid #e2e8f0;background:transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:.8rem}.act-btn:hover{background:#f8fafc}
