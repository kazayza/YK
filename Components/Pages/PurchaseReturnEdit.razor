    .form-msg{padding:8px 12px;border-radius:8px;font-size:.82rem;font-weight:600;margin-top:10px}.msg-ok{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}.msg-err{background:#fef2f2;color:#dc2626;border:1px solid #fecaca}
