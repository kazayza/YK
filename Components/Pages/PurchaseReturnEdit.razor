@page "/purchase-returns/new"
@page "/purchase-returns/edit/{ReturnId:int}"
@page "/purchase-returns/view/{ReturnId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PurchaseReturnService RetService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div>}
else
{
    <div class="luxury-doc-page" dir="rtl">
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <button class="btn-luxury btn-back-luxury" @onclick="GoBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19 7-7-7-7"/></svg>رجوع</button>
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">@pageTitle</h2><div class="lh-meta">@if (!string.IsNullOrEmpty(header.ReturnNumber)){<code class="doc-num-luxury">@header.ReturnNumber</code><span class="status-badge-luxury" style="--sc:@PurchaseReturnService.GetStatusColor(header.ReturnStatus)">@PurchaseReturnService.GetStatusName(header.ReturnStatus)</span><span class="type-badge-luxury" style="--tc:@PurchaseReturnService.GetReturnTypeColor(header.ReturnType)">@PurchaseReturnService.GetReturnTypeName(header.ReturnType)</span>}</div></div>
                </div>
                <div class="lh-actions">
                    <div class="workflow-mini"><span class="wm-dot done">1 طلب</span><span class="wm-line done"></span><span class="wm-dot done">2 أمر</span><span class="wm-line done"></span><span class="wm-dot done">3 استلام</span><span class="wm-line done"></span><span class="wm-dot done">4 فاتورة</span><span class="wm-line done"></span><span class="wm-dot active">5 مرتجع</span></div>
                    @if (permissions.CanPrint && ReturnId > 0){<button class="btn-luxury btn-ghost-luxury" @onclick="PrintDoc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>طباعة</button>}
                </div>
            </div>
        </div>

        @if (isApprovalMode)
        {
            <div class="approval-bar-luxury"><div class="ml-gold-line green"></div><div class="appr-left"><div class="appr-icon" style="background:#fef2f2;border-color:#fecaca;color:#ef4444"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a2.5 2.5 0 0 1 0 5H11"/></svg></div><div><div class="appr-title">مرتجع بانتظار اعتمادك</div><div class="appr-sub">سيتم خصم المخزون وتحديث رصيد المورد بعد الاعتماد</div></div></div><div class="appr-actions"><button class="btn-luxury btn-approve-quick" @onclick="ExecuteApprove" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg>}اعتماد</button><button class="btn-luxury btn-reject-luxury" @onclick="DoShowReject" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>رفض</button></div></div>
        }

        @if (isLoading){<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else
        {
            @if (isNewMode && !isSourceLocked)
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a2.5 2.5 0 0 1 0 5H11"/></svg></div><h3 class="sec-title-luxury">مصدر المرتجع</h3></div>
                    <div class="source-cards-luxury">
                        <div class="source-card-luxury @(header.ReturnSource == 1 ? "active" : "")" @onclick="SelectInvoiceSource"><div class="source-card-icon-luxury" style="background:#ecfeff;color:#0891b2;border:1px solid #a5f3fc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/></svg></div><div class="source-card-title-luxury">من فاتورة مشتريات</div><div class="source-card-desc-luxury">مرتجع بناءً على فاتورة معتمدة - إشعار دائن</div><div class="source-check-luxury">@if(header.ReturnSource==1){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5l10-10"/></svg>}</div></div>
                        <div class="source-card-luxury @(header.ReturnSource == 2 ? "active" : "")" @onclick="SelectDirectSource"><div class="source-card-icon-luxury" style="background:rgba(212,175,55,.1);color:#9C7C2E;border:1px solid rgba(212,175,55,.18)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></div><div class="source-card-title-luxury">مرتجع مباشر</div><div class="source-card-desc-luxury">مرتجع بدون فاتورة مسبقة</div><div class="source-check-luxury">@if(header.ReturnSource==2){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5l10-10"/></svg>}</div></div>
                    </div>
                </div>
            }

            @if (header.ReturnSource == 1 && isNewMode && !isInvLoaded)
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h3 class="sec-title-luxury">اختيار الفاتورة</h3></div>
                    <div class="form-grid-luxury c2"><div class="f-field-luxury"><label class="f-label-luxury required">الفاتورة</label><SearchableSelect Items="@availableInvoices" @bind-SelectedId="selectedInvId" OnSelected="OnInvoiceSelected" Placeholder="ابحث برقم الفاتورة..." /></div></div>
                    @if (invLines != null && invLines.Any())
                    {
                        <div style="margin-top:16px"><h4 class="po-lines-title-luxury">أصناف الفاتورة (@invLines.Count(l=>l.IsSelected) مختار)</h4>
                            <div class="tbl-card-luxury" style="margin-top:10px"><div class="table-responsive"><table class="tbl-luxury"><thead><tr><th class="tc" style="width:40px"><input type="checkbox" checked="@invLines.All(l => l.IsSelected)" @onchange="ToggleAllLines" /></th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="tc">الكمية</th><th class="tl">السعر</th><th class="tc">كمية المرتجع</th><th class="tc">حالة الصنف</th><th>السبب</th></tr></thead><tbody>@foreach (var l in invLines){<tr class="@(!l.IsSelected?"tr-deselected":"")"><td class="tc"><input type="checkbox" @bind="l.IsSelected" /></td><td><code class="code-tag-luxury">@l.ItemCode</code></td><td class="td-bold">@l.ItemNameAr</td><td class="td-muted">@l.UnitName</td><td class="tc">@l.Quantity.ToString("#,##0.##")</td><td class="tl num-cell">@l.UnitPrice.ToString("#,##0.00")</td><td class="tc"><input type="number" class="inline-input-luxury" @bind="l.ReturnQty" step="0.01" max="@l.Quantity" disabled="@(!l.IsSelected)" /></td><td class="tc"><select class="inline-input-luxury" style="width:100px" @bind="l.ItemCondition" disabled="@(!l.IsSelected)"><option value="1">سليم</option><option value="2">تالف</option><option value="3">منتهي</option></select></td><td><input type="text" class="inline-input-luxury" style="width:120px" @bind="l.ReturnReason" placeholder="السبب..." disabled="@(!l.IsSelected)" /></td></tr>}</tbody></table></div></div>
                        </div>
                    }
                </div>
            }

            @if (header.ReturnSource > 0 || !isNewMode)
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h3 class="sec-title-luxury">بيانات المرتجع</h3></div>
                    <div class="form-grid-luxury c4">
                        <div class="f-field-luxury"><label class="f-label-luxury">رقم المرتجع</label><input type="text" class="f-input-luxury readonly" value="@(header.ReturnNumber ?? "تلقائي")" disabled /></div>
                        <div class="f-field-luxury"><label class="f-label-luxury required">التاريخ</label><input type="date" class="f-input-luxury" @bind="header.ReturnDate" disabled="@isReadOnly" /></div>
                        <div class="f-field-luxury"><label class="f-label-luxury required">المورد</label>@if (header.ReturnSource == 1 && header.SupplierID > 0){<input type="text" class="f-input-luxury readonly" value="@header.SupplierNameAr" disabled />}else{<SearchableSelect Items="@suppliersSearchable" @bind-SelectedId="header.SupplierID" OnSelected="OnSupplierSelected" Placeholder="اختر المورد..." IsDisabled="@isReadOnly" />}</div>
                        <div class="f-field-luxury"><label class="f-label-luxury required">المخزن</label><select class="f-input-luxury" @bind="header.WarehouseID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (warehouses != null){@foreach (var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select></div>
                        <div class="f-field-luxury"><label class="f-label-luxury required">نوع المرتجع</label><select class="f-input-luxury" @bind="header.ReturnType" disabled="@isReadOnly"><option value="1">🔴 معيب - Defective</option><option value="2">🟡 غير مطابق - Non-conforming</option><option value="3">🔵 زيادة - Excess</option></select></div>
                        <div class="f-field-luxury c3"><label class="f-label-luxury">سبب الإرجاع</label><input type="text" class="f-input-luxury" @bind="header.ReturnReason" disabled="@isReadOnly" placeholder="سبب الإرجاع بالتفصيل..." /></div>
                    </div>
                    <div class="form-grid-luxury c1" style="margin-top:14px"><div class="f-field-luxury"><label class="f-label-luxury">ملاحظات</label><input type="text" class="f-input-luxury" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات..." /></div></div>
                    @if (header.ReturnStatus == 1 && !string.IsNullOrEmpty(header.RejectionReason)){<div class="rejection-box-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg><strong>سبب الرفض:</strong> @header.RejectionReason</div>}
                </div>
            }

            @if ((header.ReturnSource > 0 || !isNewMode) && (ReturnId > 0 || isSourceLocked))
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96L12 12.01l8.73-5.05"/><path d="M12 22.08V12"/></svg></div><h3 class="sec-title-luxury">أصناف المرتجع</h3><span class="sec-badge-luxury">@details.Count صنف</span><span class="total-mini-luxury">@details.Sum(d=>d.LineTotalWithTax).ToString("#,##0.00") ج.م</span>
                    @if (!isReadOnly && !isApprovalMode && permissions.CanAdd){<button class="btn-luxury btn-primary-luxury btn-sm-luxury" style="margin-right:auto;" @onclick="ShowAddLine"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة صنف</button>}
                </div>
                    @if (!details.Any() && !showLineForm){<div class="empty-lines-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M9 14 4 9l5-5"/><path d="M4 9h10.5a2.5 2.5 0 0 1 0 5H11"/></svg></div><p>لا توجد أصناف.</p></div>}
                    else
                    {
                        <div class="tbl-card-luxury"><div class="table-responsive"><table class="tbl-luxury"><thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="tc">الكمية</th><th class="tl">السعر</th><th class="tc">ضريبة%</th><th class="tl">الإجمالي</th><th class="tc">الحالة</th><th>السبب</th>@if (!isReadOnly && !isApprovalMode){<th class="tc">إجراءات</th>}</tr></thead><tbody>@{int n=0;}@foreach (var line in details){n++;<tr><td class="td-n">@n</td><td><code class="code-tag-luxury">@line.ItemCode</code></td><td class="td-bold">@line.ItemNameAr</td><td class="td-muted">@line.UnitName</td><td class="tc">@line.Quantity.ToString("#,##0.##")</td><td class="tl num-cell">@line.UnitPrice.ToString("#,##0.00")</td><td class="tc">@line.TaxRate.ToString("#,##0.##")</td><td class="tl num-cell"><strong>@line.LineTotalWithTax.ToString("#,##0.00")</strong></td><td class="tc"><span class="cond-badge-luxury" style="--cc:@(line.ItemCondition == 1 ? "#10b981" : line.ItemCondition == 2 ? "#ef4444" : "#f59e0b")">@PurchaseReturnService.GetConditionName(line.ItemCondition)</span></td><td class="td-muted">@(line.ReturnReason ?? "—")</td>@if (!isReadOnly && !isApprovalMode){<td class="tc"><div class="line-actions-luxury">@if (permissions.CanEdit){<button class="act-btn-luxury edit" @onclick="() => ShowEditLine(line)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}@if (permissions.CanDelete){<button class="act-btn-luxury del" @onclick="() => DeleteLine(line.ReturnDetailID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}</div></td>}</tr>}</tbody><tfoot><tr class="total-row-luxury"><td colspan="7" class="tl"><strong>الإجمالي</strong></td><td class="tl num-cell"><strong>@details.Sum(d => d.LineTotalWithTax).ToString("#,##0.00") ج.م</strong></td><td colspan="@(!isReadOnly && !isApprovalMode ? 3 : 2)"></td></tr></tfoot></table></div></div>
                    }

                    @if (showLineForm)
                    {
                        <div class="line-form-luxury"><div class="ml-gold-line"></div><div class="line-form-head-luxury"><h4>@(isEditLine ? "تعديل" : "إضافة") صنف</h4><button class="btn-close-x-luxury" @onclick="CloseLineForm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
                            <div class="form-grid-luxury c3">
                                <div class="f-field-luxury"><label class="f-label-luxury required">الصنف</label><SearchableSelect Items="@purchaseItems" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث..." IsDisabled="@isEditLine" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">الوحدة</label><select class="f-input-luxury" @bind="editLine.UnitID"><option value="0">-- اختر --</option>@if (units != null){@foreach (var u in units){<option value="@u.Id">@u.Name</option>}}</select></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">الكمية</label><input type="number" class="f-input-luxury" @bind="editLine.Quantity" step="0.01" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">السعر</label><input type="number" class="f-input-luxury" @bind="editLine.UnitPrice" step="0.01" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">ضريبة %</label><input type="number" class="f-input-luxury" @bind="editLine.TaxRate" step="0.01" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">حالة الصنف</label><select class="f-input-luxury" @bind="editLine.ItemCondition"><option value="1">سليم</option><option value="2">تالف</option><option value="3">منتهي الصلاحية</option></select></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">السبب</label><input type="text" class="f-input-luxury" @bind="editLine.ReturnReason" placeholder="سبب الإرجاع..." /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">ملاحظات</label><input type="text" class="f-input-luxury" @bind="editLine.Notes" /></div>
                            </div>
                            <div class="line-calc-bar-luxury"><span>الإجمالي: <strong>@editLine.LineTotalWithTax.ToString("#,##0.00") ج.م</strong></span></div>
                            @if (!string.IsNullOrEmpty(lineMsg)){<div class="form-msg-luxury @(lineMsgOk?"ok":"err")">@lineMsg</div>}
                            <div class="line-form-btns-luxury"><button class="btn-luxury btn-primary-luxury" @onclick="SaveLine" disabled="@isSavingLine">@if(isSavingLine){<div class="btn-spinner-sm"></div>}@(isEditLine ? "تحديث" : "إضافة")</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseLineForm">إلغاء</button></div>
                        </div>
                    }
                </div>
            }

            @if (ReturnId > 0 && details.Any())
            {
                <div class="totals-bar-luxury"><div class="ml-gold-line"></div><div class="total-item-luxury"><span class="total-label-luxury">الإجمالي</span><span class="total-value-luxury">@header.SubTotal.ToString("#,##0.00")</span></div><div class="total-item-luxury"><span class="total-label-luxury">الضريبة</span><span class="total-value-luxury">@header.TaxAmount.ToString("#,##0.00")</span></div><div class="total-item-luxury total-grand-luxury" style="background:linear-gradient(135deg,#7f1d1d,#dc2626)"><span class="total-label-luxury">الإجمالي الكلي</span><span class="total-value-luxury">@header.TotalAmount.ToString("#,##0.00") ج.م</span></div></div>
            }

            @if (!isViewMode && !isApprovalMode)
            {
                <div class="doc-actions-luxury"><div class="ml-gold-line"></div><div class="doc-actions-right">@if (!isReadOnly){<button class="btn-luxury btn-primary-luxury" @onclick="SaveReturn" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21V13H7v8"/></svg>}@(isNewMode ? "حفظ المرتجع" : "حفظ التعديلات")</button>@if (ReturnId > 0 && header.ReturnStatus == 1 && details.Any()){<button class="btn-luxury btn-warning-luxury" @onclick="SubmitForApproval" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m22 2-7 20-4-9-9-4 20-7z"/></svg>إرسال للاعتماد</button>}}</div><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">رجوع</button></div>
            }
        }
    </div>

    @if (showRejectDialog)
    {
        <div class="modal-overlay-luxury" @onclick="() => showRejectDialog = false"><div class="modal-card-luxury" @onclick:stopPropagation="true"><div class="ml-gold-line danger"></div><div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div><h4>رفض المرتجع</h4><p>أدخل سبب الرفض:</p><textarea class="f-input-luxury" rows="3" @bind="rejectReason" placeholder="سبب الرفض..."></textarea>@if (!string.IsNullOrEmpty(rejectMsg)){<div class="form-msg-luxury err">@rejectMsg</div>}<div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmReject">تأكيد الرفض</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showRejectDialog = false">إلغاء</button></div></div></div>
    }

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast = ""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-doc-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1300px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25);overflow:hidden}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
