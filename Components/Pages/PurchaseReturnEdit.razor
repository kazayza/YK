@page "/purchase-returns/new"
@page "/purchase-returns/edit/{ReturnId:int}"
@page "/purchase-returns/view/{ReturnId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PurchaseReturnService RetService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{ <div class="no-access"><div class="na-icon">🔒</div><h4>يجب تسجيل الدخول</h4></div> }
else if (permissions == null || !permissions.CanView)
{ <div class="no-access"><div class="na-icon">⛔</div><h4>ليس لديك صلاحية</h4></div> }
else
{
    <div class="doc-page" dir="rtl">
        <div class="doc-header">
            <div class="doc-header-right">
                <button class="btn-m btn-ghost" @onclick="GoBack">→ رجوع</button>
                <div>
                    <h2 class="doc-title">@pageTitle</h2>
                    
                    @if (!string.IsNullOrEmpty(header.ReturnNumber))
                    {
                        <div class="doc-num-wrap">
                            <code class="doc-number">@header.ReturnNumber</code>
                            <span class="status-chip" style="--sc:@PurchaseReturnService.GetStatusColor(header.ReturnStatus)">@PurchaseReturnService.GetStatusName(header.ReturnStatus)</span>
                        </div>
                    }
                </div>
            </div>
            @if (permissions.CanPrint && ReturnId > 0)
            { <button class="btn-m btn-outline" @onclick="PrintDoc">🖨️ طباعة</button> }
        </div>

        @if (isApprovalMode)
        {
            <div class="approval-bar">
                <span class="approval-label">📦 مرتجع بانتظار اعتمادك</span>
                <button type="button" class="appr-btn appr-quick" @onclick="ExecuteApprove" disabled="@isSaving">@if (isSaving) { <div class="btn-spin"></div> } else { <span>✅</span> } اعتماد</button>
                <button type="button" class="appr-btn appr-reject" @onclick="DoShowReject" disabled="@isSaving">❌ رفض</button>
            </div>
        }

        @if (isLoading)
        { <div class="loading-st"><div class="loader"></div><p>جاري التحميل...</p></div> }
        else
        {
            @if (isNewMode && !isSourceLocked)
            {
                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon purple">📦</div><h3 class="sec-title">مصدر المرتجع</h3></div>
                    <div class="source-cards">
                        <div class="source-card @(header.ReturnSource == 1 ? "active" : "")" @onclick="SelectInvoiceSource">
                            <div class="source-card-icon" style="background:#ecfeff;color:#0891b2;">📄</div>
                            <div class="source-card-title">من فاتورة مشتريات</div>
                            <div class="source-card-desc">مرتجع بناءً على فاتورة</div>
                        </div>
                        <div class="source-card @(header.ReturnSource == 2 ? "active" : "")" @onclick="SelectDirectSource">
                            <div class="source-card-icon" style="background:#fff7ed;color:#f97316;">✏️</div>
                            <div class="source-card-title">مرتجع مباشر</div>
                            <div class="source-card-desc">مرتجع بدون فاتورة</div>
                        </div>
                    </div>
                </div>
            }

            @if (header.ReturnSource == 1 && isNewMode && !isInvLoaded)
            {
                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon cyan">📄</div><h3 class="sec-title">اختيار الفاتورة</h3></div>
                    <div class="form-grid c2">
                        <div class="f-field"><label class="f-label required">الفاتورة</label>
                            <SearchableSelect Items="@availableInvoices" @bind-SelectedId="selectedInvId" OnSelected="OnInvoiceSelected" Placeholder="ابحث برقم الفاتورة..." />
                        </div>
                    </div>
                    @if (invLines != null && invLines.Any())
                    {
                        <div style="margin-top:16px;">
                            <h4 style="font-weight:700;font-size:.88rem;margin-bottom:10px;">أصناف الفاتورة</h4>
                            <div class="tbl-card"><table class="tbl">
                                <thead><tr>
                                    <th class="tc" style="width:40px;"><input type="checkbox" checked="@invLines.All(l => l.IsSelected)" @onchange="ToggleAllLines" /></th>
                                    <th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="tc">الكمية</th><th class="tl">السعر</th>
                                    <th class="tc">كمية المرتجع</th><th class="tc">حالة الصنف</th><th>السبب</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var l in invLines)
                                    {
                                        <tr class="@(!l.IsSelected ? "tr-deselected" : "")">
                                            <td class="tc"><input type="checkbox" @bind="l.IsSelected" /></td>
                                            <td><code class="code-tag">@l.ItemCode</code></td>
                                            <td class="td-bold">@l.ItemNameAr</td><td>@l.UnitName</td>
                                            <td class="tc">@l.Quantity.ToString("#,##0.##")</td>
                                            <td class="tl num-cell">@l.UnitPrice.ToString("#,##0.00")</td>
                                            <td class="tc"><input type="number" class="inline-input" @bind="l.ReturnQty" step="0.01" max="@l.Quantity" disabled="@(!l.IsSelected)" /></td>
                                            <td class="tc"><select class="inline-input" style="width:100px" @bind="l.ItemCondition" disabled="@(!l.IsSelected)">
                                                <option value="1">سليم</option><option value="2">تالف</option><option value="3">منتهي</option>
                                            </select></td>
                                            <td><input type="text" class="inline-input" style="width:120px" @bind="l.ReturnReason" placeholder="السبب..." disabled="@(!l.IsSelected)" /></td>
                                        </tr>
                                    }
                                </tbody>
                            </table></div>
                        </div>
                    }
                </div>
            }

            @if (header.ReturnSource > 0 || !isNewMode)
            {
                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon blue">📝</div><h3 class="sec-title">بيانات المرتجع</h3></div>
                    <div class="form-grid c4">
                        <div class="f-field"><label class="f-label">رقم المرتجع</label><input type="text" class="f-input readonly" value="@(header.ReturnNumber ?? "تلقائي")" disabled /></div>
                        <div class="f-field"><label class="f-label required">التاريخ</label><input type="date" class="f-input" @bind="header.ReturnDate" disabled="@isReadOnly" /></div>
                        <div class="f-field"><label class="f-label required">المورد</label>
                            @if (header.ReturnSource == 1 && header.SupplierID > 0)
                            { <input type="text" class="f-input readonly" value="@header.SupplierNameAr" disabled /> }
                            else
                            { <SearchableSelect Items="@suppliersSearchable" @bind-SelectedId="header.SupplierID" OnSelected="OnSupplierSelected" Placeholder="اختر المورد..." IsDisabled="@isReadOnly" /> }
                        </div>
                        <div class="f-field"><label class="f-label required">المخزن</label>
                            <select class="f-input" @bind="header.WarehouseID" disabled="@isReadOnly">
                                <option value="0">-- اختر --</option>
                                @if (warehouses != null) { @foreach (var w in warehouses) { <option value="@w.Id">@w.Name</option> } }
                            </select>
                        </div>
                        <div class="f-field"><label class="f-label required">نوع المرتجع</label>
                            <select class="f-input" @bind="header.ReturnType" disabled="@isReadOnly">
                                <option value="1">🔴 معيب</option><option value="2">🟡 غير مطابق</option><option value="3">🔵 زيادة</option>
                            </select>
                        </div>
                        <div class="f-field c3"><label class="f-label">سبب الإرجاع</label><input type="text" class="f-input" @bind="header.ReturnReason" disabled="@isReadOnly" placeholder="سبب الإرجاع..." /></div>
                    </div>
                    <div class="form-grid c1" style="margin-top:14px;">
                        <div class="f-field"><label class="f-label">ملاحظات</label><input type="text" class="f-input" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات..." /></div>
                    </div>
                    @if (header.ReturnStatus == 1 && !string.IsNullOrEmpty(header.RejectionReason))
                    { <div class="rejection-box">❌ <strong>سبب الرفض:</strong> @header.RejectionReason</div> }
                </div>
            }

            @if ((header.ReturnSource > 0 || !isNewMode) && (ReturnId > 0 || isSourceLocked))
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon green">📦</div><h3 class="sec-title">أصناف المرتجع</h3>
                        <span class="sec-badge">@details.Count صنف</span>
                        @if (!isReadOnly && !isApprovalMode && permissions.CanAdd)
                        { <button class="btn-m btn-primary btn-sm" @onclick="ShowAddLine" style="margin-right:auto;">+ إضافة صنف</button> }
                    </div>
                    @if (!details.Any() && !showLineForm) { <div class="empty-lines"><p>لا توجد أصناف.</p></div> }
                    else
                    {
                        <div class="tbl-card"><table class="tbl">
                            <thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="tc">الكمية</th><th class="tl">السعر</th><th class="tc">ضريبة%</th><th class="tl">الإجمالي</th><th class="tc">الحالة</th><th>السبب</th>
                            @if (!isReadOnly && !isApprovalMode) { <th class="tc">إجراءات</th> }</tr></thead>
                            <tbody>
                                @{ int n = 0; }
                                @foreach (var line in details)
                                { n++;
                                    <tr><td class="td-n">@n</td><td><code class="code-tag">@line.ItemCode</code></td><td class="td-bold">@line.ItemNameAr</td><td>@line.UnitName</td>
                                    <td class="tc">@line.Quantity.ToString("#,##0.##")</td><td class="tl num-cell">@line.UnitPrice.ToString("#,##0.00")</td>
                                    <td class="tc">@line.TaxRate.ToString("#,##0.##")</td><td class="tl num-cell"><strong>@line.LineTotalWithTax.ToString("#,##0.00")</strong></td>
                                    <td class="tc"><span class="cond-badge" style="--cc:@(line.ItemCondition == 1 ? "#10b981" : line.ItemCondition == 2 ? "#ef4444" : "#f59e0b")">@PurchaseReturnService.GetConditionName(line.ItemCondition)</span></td>
                                    <td class="td-muted">@(line.ReturnReason ?? "—")</td>
                                    @if (!isReadOnly && !isApprovalMode)
                                    { <td class="tc"><div class="line-actions">
                                        @if (permissions.CanEdit) { <button class="act-btn edit" @onclick="() => ShowEditLine(line)">✏️</button> }
                                        @if (permissions.CanDelete) { <button class="act-btn del" @onclick="() => DeleteLine(line.ReturnDetailID)">🗑️</button> }
                                    </div></td> } </tr> }
                            </tbody>
                            <tfoot><tr class="total-row"><td colspan="7" class="tl"><strong>الإجمالي</strong></td><td class="tl num-cell"><strong>@details.Sum(d => d.LineTotalWithTax).ToString("#,##0.00") ج.م</strong></td><td colspan="@(!isReadOnly && !isApprovalMode ? 3 : 2)"></td></tr></tfoot>
                        </table></div>
                    }

                    @if (showLineForm)
                    {
                        <div class="line-form">
                            <div class="line-form-head"><h4>@(isEditLine ? "تعديل" : "إضافة") صنف</h4><button class="btn-close-x" @onclick="CloseLineForm">✕</button></div>
                            <div class="form-grid c3">
                                <div class="f-field"><label class="f-label required">الصنف</label><SearchableSelect Items="@purchaseItems" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث..." IsDisabled="@isEditLine" /></div>
                                <div class="f-field"><label class="f-label required">الوحدة</label><select class="f-input" @bind="editLine.UnitID"><option value="0">-- اختر --</option>@if (units != null) { @foreach (var u in units) { <option value="@u.Id">@u.Name</option> } }</select></div>
                                <div class="f-field"><label class="f-label required">الكمية</label><input type="number" class="f-input" @bind="editLine.Quantity" step="0.01" /></div>
                                <div class="f-field"><label class="f-label required">السعر</label><input type="number" class="f-input" @bind="editLine.UnitPrice" step="0.01" /></div>
                                <div class="f-field"><label class="f-label">ضريبة %</label><input type="number" class="f-input" @bind="editLine.TaxRate" step="0.01" /></div>
                                <div class="f-field"><label class="f-label">حالة الصنف</label><select class="f-input" @bind="editLine.ItemCondition"><option value="1">سليم</option><option value="2">تالف</option><option value="3">منتهي الصلاحية</option></select></div>
                                <div class="f-field"><label class="f-label">السبب</label><input type="text" class="f-input" @bind="editLine.ReturnReason" placeholder="سبب الإرجاع..." /></div>
                                <div class="f-field"><label class="f-label">ملاحظات</label><input type="text" class="f-input" @bind="editLine.Notes" /></div>
                            </div>
                            <div class="line-calc-bar"><span>الإجمالي: <strong>@editLine.LineTotalWithTax.ToString("#,##0.00") ج.م</strong></span></div>
                            @if (!string.IsNullOrEmpty(lineMsg)) { <div class="form-msg @(lineMsgOk ? "msg-ok" : "msg-err")">@lineMsg</div> }
                            <div class="line-form-btns">
                                <button class="btn-m btn-primary" @onclick="SaveLine" disabled="@isSavingLine">@if (isSavingLine) { <div class="btn-spin"></div> } @(isEditLine ? "تحديث" : "إضافة")</button>
                                <button class="btn-m btn-ghost" @onclick="CloseLineForm">إلغاء</button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (ReturnId > 0 && details.Any())
            {
                <div class="totals-bar">
                    <div class="total-item"><span class="total-label">الإجمالي</span><span class="total-value">@header.SubTotal.ToString("#,##0.00")</span></div>
                    <div class="total-item"><span class="total-label">الضريبة</span><span class="total-value">@header.TaxAmount.ToString("#,##0.00")</span></div>
                    <div class="total-item total-grand"><span class="total-label">الإجمالي الكلي</span><span class="total-value">@header.TotalAmount.ToString("#,##0.00") ج.م</span></div>
                </div>
            }

            @if (!isViewMode && !isApprovalMode)
            {
                <div class="doc-actions">
                    <div class="doc-actions-right">
                        @if (!isReadOnly)
                        {
                            <button class="btn-m btn-primary" @onclick="SaveReturn" disabled="@isSaving">@if (isSaving) { <div class="btn-spin"></div> } @(isNewMode ? "حفظ المرتجع" : "حفظ التعديلات")</button>
                            @if (ReturnId > 0 && header.ReturnStatus == 1 && details.Any())
                            { <button class="btn-m btn-warning" @onclick="SubmitForApproval" disabled="@isSaving">📤 إرسال للاعتماد</button> }
                        }
                    </div>
                    <button class="btn-m btn-ghost" @onclick="GoBack">رجوع</button>
                </div>
            }
        }
    </div>

    @if (showRejectDialog)
    {
        <div class="modal-ov" @onclick="() => showRejectDialog = false">
            <div class="modal-box" @onclick:stopPropagation="true">
                <h4>رفض المرتجع</h4><p>أدخل سبب الرفض:</p>
                <textarea class="f-input" rows="3" @bind="rejectReason" placeholder="سبب الرفض..."></textarea>
                @if (!string.IsNullOrEmpty(rejectMsg)) { <div class="form-msg msg-err">@rejectMsg</div> }
                <div class="modal-btns-row"><button class="btn-m btn-danger-solid" @onclick="ConfirmReject">تأكيد الرفض</button><button class="btn-m btn-ghost" @onclick="() => showRejectDialog = false">إلغاء</button></div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(toast))
    { <div class="toast-wrap"><div class="toast @(toastOk ? "t-ok" : "t-err")"><span>@toast</span><button @onclick='() => toast = ""'>✕</button></div></div> }
}

<style>
    .doc-page{display:flex;flex-direction:column;gap:18px;max-width:1200px}.doc-header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:14px}.doc-header-right{display:flex;align-items:flex-start;gap:14px}.doc-title{font-weight:800;color:#0f172a;margin:0;font-size:1.2rem}.doc-num-wrap{display:flex;align-items:center;gap:10px;margin-top:6px;flex-wrap:wrap}.doc-number{background:#f1f5f9;padding:4px 14px;border-radius:8px;font-size:.88rem;color:#2563eb;font-weight:700}.status-chip{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.75rem;font-weight:700;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc)}
