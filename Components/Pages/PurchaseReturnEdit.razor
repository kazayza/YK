    .source-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.source-card{padding:20px;border:2px solid #e2e8f0;border-radius:16px;cursor:pointer;transition:.2s;text-align:center}.source-card:hover{border-color:#2563eb;background:#f8fafc}.source-card.active{border-color:#2563eb;background:#eff6ff}.source-card-icon{width:48px;height:48px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;font-size:1.4rem;margin-bottom:10px}.source-card-title{font-weight:800;font-size:.92rem;color:#0f172a;margin-bottom:4px}.source-card-desc{font-size:.78rem;color:#64748b}
    .tr-deselected{opacity:.4}.inline-input{width:90px;padding:6px 8px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.82rem;text-align:center}.inline-input:focus{border-color:#2563eb}
    .doc-section{background:white;border:1px solid #e2e8f0;border-radius:18px;padding:22px}.sec-head{display:flex;align-items:center;gap:12px;margin-bottom:20px;padding-bottom:14px;border-bottom:1px solid #f1f5f9;flex-wrap:wrap}.sec-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.2rem}.sec-icon.blue{background:#eff6ff}.sec-icon.green{background:#ecfdf5}.sec-icon.purple{background:#f5f3ff}.sec-icon.cyan{background:#ecfeff}.sec-title{font-weight:800;color:#0f172a;margin:0;font-size:.98rem}.sec-badge{background:#f1f5f9;color:#475569;padding:4px 12px;border-radius:999px;font-size:.78rem;font-weight:700}
    .form-grid{display:grid;gap:14px}.c4{grid-template-columns:repeat(4,1fr)}.c3{grid-template-columns:repeat(3,1fr)}.c2{grid-template-columns:repeat(2,1fr)}.c1{grid-template-columns:1fr}.f-field{display:flex;flex-direction:column;gap:5px}.f-field.c3{grid-column:span 3}.f-label{font-size:.8rem;font-weight:700;color:#334155}.required::after{content:' *';color:#ef4444}.f-input{padding:9px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.88rem;background:white;outline:none;width:100%}.f-input:focus{border-color:#2563eb}.f-input.readonly,.f-input:disabled{background:#f8fafc;color:#64748b}
