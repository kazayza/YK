.v-table-card,.v-form-card{background:#fff;border:1px solid #e8e2d0;border-radius:16px;overflow:hidden;box-shadow:0 4px 17px rgba(15,23,42,.045)}.v-table-card{position:relative}.v-table-card:before,.v-form-card:before{content:'';display:block;height:2px;background:linear-gradient(90deg,transparent,#D4AF37,transparent);opacity:.65}.v-table{width:100%;border-collapse:collapse;min-width:1050px}.v-table th{background:#fcfaf6;color:#667085;font-size:.73rem;font-weight:800;text-align:right;padding:12px 11px;border-bottom:1px solid #eee9dc;white-space:nowrap}.v-table td{padding:11px;border-bottom:1px solid #f1efe8;font-size:.8rem;color:#263244;vertical-align:middle}.v-table tbody tr:hover{background:#fffdf8}.v-muted{color:#7b8493!important}.v-kind,.v-status,.v-journal{display:inline-flex;align-items:center;border-radius:7px;padding:4px 8px;font-size:.7rem;font-weight:800;white-space:nowrap}.v-kind.receipt{background:#e9f7f1;color:#08734f;border:1px solid #c8eadb}.v-kind.payment{background:#fff0ef;color:#a3332e;border:1px solid #f3d1ce}.v-status{background:color-mix(in srgb,var(--status-color) 10%,white);color:var(--status-color);border:1px solid color-mix(in srgb,var(--status-color) 22%,white)}.v-journal{background:#edf7f2;color:#08734f;border:1px solid #c8eadb}.v-number{border:0;background:transparent;color:#8a6c23;font:800 .82rem 'Tajawal',sans-serif;cursor:pointer;text-decoration:underline;text-underline-offset:3px}.v-amount{font-variant-numeric:tabular-nums;font-weight:800;white-space:nowrap}.v-row-actions{display:flex;align-items:center;justify-content:center;gap:4px}.v-icon-btn{display:grid;place-items:center;width:30px;height:30px;border:1px solid #d9e2ec;background:#fff;border-radius:8px;color:#2563eb;cursor:pointer}.v-icon-btn svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.v-icon-btn.approve{color:#08734f;border-color:#b7e5d1}.v-icon-btn.delete{color:#b42318;border-color:#f2c6c3}
