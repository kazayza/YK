background:#fbf7e9;color:#9c7c2e;border:1px solid #eee2b9}.v-empty-icon svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.5}.v-modal-backdrop{position:fixed;inset:0;background:rgba(7,11,20,.54);display:grid;place-items:center;padding:18px;z-index:1200}.v-modal{width:min(100%,470px);background:#fff;border:1px solid rgba(212,175,55,.38);border-radius:16px;padding:22px;box-shadow:0 22px 65px rgba(0,0,0,.28);font-family:'Tajawal',sans-serif}.v-modal h2{font-size:1rem;color:#101828;margin:0 0 7px}.v-modal p{font-size:.82rem;color:#667085;margin:0 0 18px}.v-modal-actions{display:flex;gap:8px;justify-content:flex-start;flex-wrap:wrap}.v-toast{position:fixed;left:24px;bottom:24px;z-index:1300;display:flex;align-items:center;gap:12px;max-width:min(500px,calc(100vw - 32px));padding:12px 15px;background:#101828;color:#f5e6c8;border:1px solid rgba(212,175,55,.35);border-radius:11px;box-shadow:0 12px 30px rgba(0,0,0,.22);font:700 .82rem 'Tajawal',sans-serif}.v-toast button{border:0;background:transparent;color:inherit;font-size:1.2rem;cursor:pointer}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
