.v-stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.v-stat{background:linear-gradient(145deg,#fff,#fcfaf6);border:1px solid #e8e2d0;border-radius:13px;padding:13px 15px;display:flex;align-items:center;justify-content:space-between;gap:10px}.v-stat-label{color:#737b89;font-size:.75rem;font-weight:700}.v-stat strong{color:#101828;font-size:1.08rem;font-variant-numeric:tabular-nums}
