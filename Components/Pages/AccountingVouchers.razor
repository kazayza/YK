</style>

@code {
    [Parameter] public string? Type { get; set; }
    [Parameter] public int? Id { get; set; }
    [Parameter] public int? ViewId { get; set; }
    [SupplyParameterFromQuery(Name = "type")] public string? QueryType { get; set; }

    private List<ReceiptVoucherListDto> receiptVouchers = new();
    private List<PaymentVoucherListDto> paymentVouchers = new();
    private List<VoucherRow> allRows = new();
    private List<SearchableItem> cashBoxes = new();
    private List<SearchableItem> bankAccounts = new();
    private List<SearchableItem> customers = new();
    private List<SearchableItem> suppliers = new();
    private List<VoucherInvoiceAllocationDto> salesSettlementInvoices = new();
    private List<VoucherInvoiceAllocationDto> purchaseSettlementInvoices = new();
    private bool isLoadingSettlementInvoices;
    private string settlementLookupError = "";
    private List<SearchableItem> revenueAccounts = new();
    private List<SearchableItem> expenseAccounts = new();
    private List<LookupDto> costCenters = new();
    private List<LookupDto> currencies = new();
    private ModulePermissionDto? receiptPermissions;
    private ModulePermissionDto? paymentPermissions;
    private ReceiptVoucherDto receiptDto = new();
    private PaymentVoucherDto paymentDto = new();
    private bool isLoading = true;
    private bool formAccessGranted;
    private bool currentVoucherLoaded;
    private bool isNewVoucherSaved;
    private bool isSaving;
    private bool isApproving;
    private bool isDeleting;
    private bool isRefreshing;
    private bool voucherListsLoaded;
    private bool voucherListsLoadFailed;
    private string voucherListsLoadError = string.Empty;
    private bool isExporting;
    private bool showNewTypeDialog;
    private bool showDeleteDialog;
    private string? selectedTabValue;
    private string searchText = "";
    private int filterStatus;
    private int filterCashBox;
    private string cashBoxLookupError = "";
    private string pageError = "";
    private string formError = "";
    private string formSuccess = "";
    private string toast = "";
    private VoucherRow? deleteTarget;
    private string deleteError = "";
    private string? loadedRouteKey;

    private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/');
    private bool IsNewRoute => CurrentPath.StartsWith("/accounting-vouchers/new/", StringComparison.OrdinalIgnoreCase);
    private bool IsEditRoute => Id.HasValue && Id.Value > 0;
    private bool IsViewRoute => ViewId.HasValue && ViewId.Value > 0;
    private bool IsFormRoute => IsNewRoute || IsEditRoute || IsViewRoute;
    private bool currentIsReceipt => string.Equals(Type, "receipt", StringComparison.OrdinalIgnoreCase);
    private bool currentIsPayment => string.Equals(Type, "payment", StringComparison.OrdinalIgnoreCase);
    private bool isViewRoute => IsViewRoute || isNewVoucherSaved || !currentVoucherLoaded || CurrentStatus != 1 || (IsEditRoute && (currentIsReceipt ? receiptPermissions?.CanEdit != true : currentIsPayment && paymentPermissions?.CanEdit != true));
    private bool CanViewReceipt => receiptPermissions?.CanView == true;
    private bool CanViewPayment => paymentPermissions?.CanView == true;
    private bool CanViewAny => CanViewReceipt || CanViewPayment;
    private bool CanAddReceipt => receiptPermissions?.CanAdd == true;
    private bool CanAddPayment => paymentPermissions?.CanAdd == true;
    private bool CanAddAny => CanAddReceipt || CanAddPayment;
    private bool CanAddExpense => PermissionService.CanAdd("SCR_EXPENSES") || PermissionService.CanAdd("SCR_EXPENSE") || PermissionService.CanAdd("SCR_OVERHEAD") || PermissionService.CanAdd("SCR_OVERHEAD_EXPENSES");
    private bool CanViewSalesInvoices => PermissionService.GetModule("SCR_SINV")?.CanView == true;
    private bool CanViewPurchaseInvoices => PermissionService.GetModule("SCR_PINV")?.CanView == true;
    private bool CanSaveCurrent => formAccessGranted && currentVoucherLoaded && !isNewVoucherSaved && IsFormRoute && !IsViewRoute && (currentIsReceipt ? (IsNewRoute ? CanAddReceipt : receiptPermissions?.CanEdit == true) : currentIsPayment && (IsNewRoute ? CanAddPayment : paymentPermissions?.CanEdit == true)) && CurrentStatus == 1 && (currentIsReceipt ? (!receiptDto.IsInvoiceSettlement || CanViewSalesInvoices) : (!paymentDto.IsInvoiceSettlement || CanViewPurchaseInvoices));
    private bool CanApproveCurrent => formAccessGranted && currentVoucherLoaded && IsEditRoute && CurrentStatus == 1 && (currentIsReceipt ? receiptPermissions?.CanApprove == true : currentIsPayment && paymentPermissions?.CanApprove == true) && (currentIsReceipt ? (!receiptDto.IsInvoiceSettlement || CanViewSalesInvoices) : (!paymentDto.IsInvoiceSettlement || CanViewPurchaseInvoices));
    private string CurrentTab => selectedTabValue ?? NormalizeTab(QueryType);
    private string VoucherListCountText => voucherListsLoaded
        ? $"{filteredRows.Count} سند"
        : voucherListsLoadFailed ? "غير متاح" : "جارٍ التحميل";
    private int CurrentStatus => currentIsReceipt ? receiptDto.ReceiptStatus : paymentDto.PaymentStatus;
    private decimal ReceiptAllocationTotal => receiptDto.InvoiceAllocations?.Sum(x => x.AppliedAmount) ?? 0m;
    private decimal PaymentAllocationTotal => paymentDto.InvoiceAllocations?.Sum(x => x.AppliedAmount) ?? 0m;
    private string CurrentStatusName => currentIsReceipt ? receiptDto.StatusName : paymentDto.StatusName;
    private int? CurrentJournalId => currentIsReceipt ? receiptDto.JournalID : paymentDto.JournalID;
    private string FormTitle => IsNewRoute
        ? (currentIsReceipt ? "سند قبض جديد" : "سند صرف جديد")
        : IsEditRoute
            ? isViewRoute
                ? (currentIsReceipt ? "عرض سند قبض" : "عرض سند صرف")
                : (currentIsReceipt ? $"تعديل سند القبض {receiptDto.ReceiptNumber}" : $"تعديل سند الصرف {paymentDto.PaymentNumber}")
            : (currentIsReceipt ? "عرض سند قبض" : "عرض سند صرف");
    private string FormSubtitle => currentIsReceipt ? "تحصيل مبلغ وإثبات قيده على الحساب المناسب" : "صرف مبلغ وإثبات قيده على الحساب المناسب";
    private string FormSectionTitle => currentIsReceipt ? "بيانات سند القبض" : "بيانات سند الصرف";

    private List<VoucherRow> filteredRows => allRows
        .Where(x => CurrentTab == "all" || (CurrentTab == "receipt" && x.IsReceipt) || (CurrentTab == "payment" && !x.IsReceipt))
        .Where(x => filterStatus == 0 || x.Status == filterStatus)
        .Where(x => filterCashBox == 0 || x.CashBoxId == filterCashBox)
        .Where(x => string.IsNullOrWhiteSpace(searchText)
            || ArabicSearchHelper.Contains(x.Number, searchText)
            || ArabicSearchHelper.Contains(x.Party, searchText)
            || ArabicSearchHelper.Contains(x.CashBox, searchText)
            || ArabicSearchHelper.Contains(x.JournalNumber, searchText))
        .OrderByDescending(x => x.Date).ThenByDescending(x => x.Id).ToList();

    protected override async Task OnParametersSetAsync()
    {
        var routeKey = $"{CurrentPath}|{Type}|{Id}|{ViewId}|{QueryType}";
        if (string.Equals(routeKey, loadedRouteKey, StringComparison.Ordinal)) return;
        loadedRouteKey = routeKey;
        isLoading = true;
        formAccessGranted = false;
        currentVoucherLoaded = false;
        isNewVoucherSaved = false;
        pageError = formError = formSuccess = "";

        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            receiptPermissions = PermissionService.GetModule("SCR_RECV");
            paymentPermissions = PermissionService.GetModule("SCR_PAYV");

            if (IsFormRoute)
            {
                if (!currentIsReceipt && !currentIsPayment)
                {
                    formError = "نوع السند في الرابط غير صحيح.";
                    isLoading = false;
                    return;
                }
                var allowed = currentIsReceipt
                    ? (IsNewRoute ? CanAddReceipt : CanViewReceipt)
                    : (IsNewRoute ? CanAddPayment : CanViewPayment);
                if (!allowed) throw new UnauthorizedAccessException("ليس لديك صلاحية لهذا النوع من السندات.");
                formAccessGranted = true;

                await LoadFormLookupsAsync();
                if (IsNewRoute) await InitializeNewVoucherAsync();
                else await LoadCurrentVoucherAsync();
                currentVoucherLoaded = true;
            }
            else
            {
                var requestedTab = NormalizeTab(QueryType);
                selectedTabValue = requestedTab == "receipt" && !CanViewReceipt || requestedTab == "payment" && !CanViewPayment
                    ? "all" : requestedTab;
                if (!CanViewAny) throw new UnauthorizedAccessException("ليس لديك صلاحية عرض سندات القبض أو الصرف.");
                await LoadListsAsync();
            }
        }
        catch (Exception ex)
        {
            if (IsFormRoute) formError = ex.Message;
            else pageError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadFormLookupsAsync()
    {
        cashBoxes = (await TreasuryService.GetCashBoxLookupsAsync())
            .Select(x => new SearchableItem { Id = x.CashBoxID, Name = x.CashBoxNameAr ?? "", Code = x.CashBoxCode }).ToList();
        bankAccounts = (await TreasuryService.GetBankAccountLookupsAsync())
            .Select(x => new SearchableItem { Id = x.BankAccountID, Name = $"{x.BankName} - {x.AccountNumber}", Code = x.BankAccountCode }).ToList();
        customers = await LookupService.GetCustomersSearchableAsync();
        suppliers = await LookupService.GetSuppliersSearchableAsync();
        currencies = await LookupService.GetCurrenciesAsync();
        costCenters = (await TreasuryService.GetCostCentersFlatAsync())
            .Select(x => new LookupDto { Id = x.CostCenterID, Name = x.CostCenterNameAr, Code = x.CostCenterCode }).ToList();
        if (currentIsReceipt) revenueAccounts = await LookupService.GetRevenueAccountsSearchableAsync();
        else expenseAccounts = await LookupService.GetExpenseAccountsSearchableAsync();
    }

    private Task InitializeNewVoucherAsync()
    {
        if (currentIsReceipt)
        {
            receiptDto = new ReceiptVoucherDto
            {
                // لا نستهلك تسلسل RV بمجرد فتح النموذج؛ خدمة الحفظ تولّد الرقم عند الإنشاء.
                ReceiptDate = DateTime.Today,
                EntityType = 1,
                PaymentMethod = 1,
                ExchangeRate = 1,
                ReceiptStatus = 1,
                CashBoxID = cashBoxes.FirstOrDefault()?.Id ?? 0
            };
            CalcReceiptLocal();
        }
        else
        {
            paymentDto = new PaymentVoucherDto
            {
                // لا نستهلك تسلسل PV بمجرد فتح النموذج؛ خدمة الحفظ تولّد الرقم عند الإنشاء.
                PaymentDate = DateTime.Today,
                EntityType = 1,
                PaymentMethod = 1,
                ExchangeRate = 1,
                PaymentStatus = 1,
                CashBoxID = cashBoxes.FirstOrDefault()?.Id ?? 0
            };
            CalcPaymentLocal();
        }

        return Task.CompletedTask;
    }

    private async Task LoadCurrentVoucherAsync()
    {
        if (currentIsReceipt)
        {
            var data = await TreasuryService.GetReceiptByIdAsync(IsViewRoute ? ViewId!.Value : Id!.Value);
            if (data is null) throw new InvalidOperationException("سند القبض غير موجود.");
            receiptDto = data;
            await RefreshReceiptInvoicesAsync();
        }
        else
        {
            var data = await TreasuryService.GetPaymentByIdAsync(IsViewRoute ? ViewId!.Value : Id!.Value);
            if (data is null) throw new InvalidOperationException("سند الصرف غير موجود.");
            paymentDto = data;
            await RefreshPaymentInvoicesAsync();
        }
    }

    private async Task LoadListsAsync()
    {
        try
        {
            var receiptTask = CanViewReceipt ? TreasuryService.GetReceiptVouchersAsync() : Task.FromResult(new List<ReceiptVoucherListDto>());
            var paymentTask = CanViewPayment ? TreasuryService.GetPaymentVouchersAsync() : Task.FromResult(new List<PaymentVoucherListDto>());
            await Task.WhenAll(receiptTask, paymentTask);
            var loadedReceipts = await receiptTask;
            var loadedPayments = await paymentTask;
            var loadedRows = new List<VoucherRow>();
            loadedRows.AddRange(loadedReceipts.Select(x => new VoucherRow
            {
                IsReceipt = true, Id = x.ReceiptID, Number = x.ReceiptNumber ?? "", Date = x.ReceiptDate,
                Party = x.EntityName ?? x.ReceivedFrom ?? "—", CashBox = x.CashBoxNameAr ?? "—", CashBoxId = x.CashBoxID,
                Amount = x.Amount, AmountLocal = x.AmountLocal, CurrencyCode = x.CurrencyCode ?? "", Method = x.PaymentMethodName ?? "—",
                Status = x.ReceiptStatus, StatusName = x.StatusName ?? "غير محدد", IsPosted = x.IsPosted, JournalId = x.JournalID, JournalNumber = x.JournalNumber
            }));
            loadedRows.AddRange(loadedPayments.Select(x => new VoucherRow
            {
                IsReceipt = false, Id = x.PaymentID, Number = x.PaymentNumber ?? "", Date = x.PaymentDate,
                Party = x.EntityName ?? x.PaidTo ?? "—", CashBox = x.CashBoxNameAr ?? "—", CashBoxId = x.CashBoxID,
                Amount = x.Amount, AmountLocal = x.AmountLocal, CurrencyCode = x.CurrencyCode ?? "", Method = x.PaymentMethodName ?? "—",
                Status = x.PaymentStatus, StatusName = x.StatusName ?? "غير محدد", IsPosted = x.IsPosted, JournalId = x.JournalID
            }));

            receiptVouchers = loadedReceipts;
            paymentVouchers = loadedPayments;
            allRows = loadedRows;
            voucherListsLoaded = true;
            voucherListsLoadFailed = false;
            voucherListsLoadError = string.Empty;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load receipt and payment voucher lists.");
            voucherListsLoadFailed = true;
            voucherListsLoadError = voucherListsLoaded
                ? "تعذر تحديث قائمة السندات؛ ما زالت آخر قائمة محمّلة ظاهرة. أعد المحاولة."
                : "تعذر تحميل قائمة سندات القبض والصرف. أعد المحاولة.";
            return;
        }

        if (cashBoxes.Count == 0)
        {
            try
            {
                cashBoxes = (await TreasuryService.GetCashBoxLookupsAsync())
                    .Select(x => new SearchableItem { Id = x.CashBoxID, Name = x.CashBoxNameAr ?? "", Code = x.CashBoxCode })
                    .ToList();
                cashBoxLookupError = string.Empty;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex,
                    "Failed to load cash-box lookup for receipt/payment voucher list filters.");
                cashBoxes = new List<SearchableItem>();
                cashBoxLookupError = "تعذر تحميل خيارات الخزائن؛ ما زالت قائمة السندات متاحة. أعد المحاولة من هنا أو زر التحديث.";
            }
        }
        else
        {
            cashBoxLookupError = string.Empty;
        }
    }

    private async Task ReloadListsAsync()
    {
        if (isRefreshing) return;
        isRefreshing = true;
        pageError = "";
        try { await LoadListsAsync(); }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh receipt and payment voucher lists.");
            voucherListsLoadFailed = true;
            voucherListsLoadError = voucherListsLoaded
                ? "تعذر تحديث قائمة السندات؛ ما زالت آخر قائمة محمّلة ظاهرة. أعد المحاولة."
                : "تعذر تحميل قائمة سندات القبض والصرف. أعد المحاولة.";
        }
        finally { isRefreshing = false; }
    }

    private void SelectTab(string tab)
    {
        if (tab == "receipt" && !CanViewReceipt || tab == "payment" && !CanViewPayment) return;
        selectedTabValue = tab;
        filterStatus = 0;
        filterCashBox = 0;
    }

    private void OpenNewExpense() => Navigation.NavigateTo("/expenses/new");

    private void BeginNewVoucher()
    {
        if (CurrentTab == "receipt" && CanAddReceipt) { NavigateNew("receipt"); return; }
        if (CurrentTab == "payment" && CanAddPayment) { NavigateNew("payment"); return; }
        if (CanAddReceipt && !CanAddPayment) { NavigateNew("receipt"); return; }
        if (CanAddPayment && !CanAddReceipt) { NavigateNew("payment"); return; }
        showNewTypeDialog = true;
    }

    private void NavigateNew(string type)
    {
        showNewTypeDialog = false;
        Navigation.NavigateTo($"/accounting-vouchers/new/{type}");
    }

    private void BackToList() => Navigation.NavigateTo($"/accounting-vouchers?type={(currentIsReceipt ? "receipt" : "payment")}");
    private void CloseNewTypeDialog() => showNewTypeDialog = false;
    private void CloseDeleteDialog() { showDeleteDialog = false; deleteTarget = null; deleteError = ""; }

    private void OpenEdit(VoucherRow row) => Navigation.NavigateTo($"/accounting-vouchers/{(row.IsReceipt ? "receipt" : "payment")}/edit/{row.Id}");
    private void OpenView(VoucherRow row) => Navigation.NavigateTo($"/accounting-vouchers/{(row.IsReceipt ? "receipt" : "payment")}/view/{row.Id}");
    private void RequestDelete(VoucherRow row) { deleteTarget = row; deleteError = ""; showDeleteDialog = true; }

    private async Task SaveCurrentAsync()
    {
        formError = formSuccess = "";
        if (currentIsReceipt)
        {
            if (receiptDto.CashBoxID <= 0) { formError = "اختر الخزينة."; return; }
            if (receiptDto.Amount <= 0) { formError = "أدخل مبلغاً أكبر من صفر."; return; }
            if (receiptDto.CurrencyID.HasValue && receiptDto.ExchangeRate <= 0) { formError = "أدخل سعر صرف موجباً للعملة المختارة."; return; }
            if (receiptDto.IsInvoiceSettlement)
            {
                if (receiptDto.InvoiceAllocations.Count == 0) { formError = "اختر فاتورة واحدة على الأقل للتسوية."; return; }
                if (ReceiptAllocationTotal != receiptDto.Amount) { formError = "يجب أن يساوي مبلغ السند مجموع تخصيصات الفواتير."; return; }
                if (receiptDto.InvoiceAllocations.Any(x => !IsReceiptInvoiceCompatible(x))) { formError = "عملة أو سعر صرف إحدى الفواتير لا يطابق السند؛ أزلها أو اضبط العملة أولاً."; return; }
            }
        }
        else
        {
            if (paymentDto.CashBoxID <= 0) { formError = "اختر الخزينة."; return; }
            if (paymentDto.Amount <= 0) { formError = "أدخل مبلغاً أكبر من صفر."; return; }
            if (paymentDto.CurrencyID.HasValue && paymentDto.ExchangeRate <= 0) { formError = "أدخل سعر صرف موجباً للعملة المختارة."; return; }
            if (paymentDto.IsInvoiceSettlement)
            {
                if (paymentDto.InvoiceAllocations.Count == 0) { formError = "اختر فاتورة واحدة على الأقل للتسوية."; return; }
                if (PaymentAllocationTotal != paymentDto.Amount) { formError = "يجب أن يساوي مبلغ السند مجموع تخصيصات الفواتير."; return; }
                if (paymentDto.InvoiceAllocations.Any(x => !IsPaymentInvoiceCompatible(x))) { formError = "عملة أو سعر صرف إحدى الفواتير لا يطابق السند؛ أزلها أو اضبط العملة أولاً."; return; }
            }
        }

        isSaving = true;
        try
        {
            if (currentIsReceipt)
            {
                if (IsEditRoute) await TreasuryService.UpdateReceiptAsync(receiptDto, UserSession.UserID);
                else
                {
                    var newId = await TreasuryService.InsertReceiptAsync(receiptDto, UserSession.UserID);
                    receiptDto.ReceiptID = newId;
                    toast = "تم حفظ مسودة سند القبض وإشعار أصحاب صلاحية الاعتماد.";
                    if (CanViewReceipt) Navigation.NavigateTo($"/accounting-vouchers/receipt/edit/{newId}");
                    else
                    {
                        isNewVoucherSaved = true;
                        formSuccess = "تم حفظ مسودة سند القبض؛ لا تتوفر لك صلاحية العرض بعد الحفظ.";
                    }
                    return;
                }
                formSuccess = "تم حفظ مسودة سند القبض.";
            }
            else
            {
                if (IsEditRoute) await TreasuryService.UpdatePaymentAsync(paymentDto, UserSession.UserID);
                else
                {
                    var newId = await TreasuryService.InsertPaymentAsync(paymentDto, UserSession.UserID);
                    paymentDto.PaymentID = newId;
                    toast = "تم حفظ مسودة سند الصرف وإشعار أصحاب صلاحية الاعتماد.";
                    if (CanViewPayment) Navigation.NavigateTo($"/accounting-vouchers/payment/edit/{newId}");
                    else
                    {
                        isNewVoucherSaved = true;
                        formSuccess = "تم حفظ مسودة سند الصرف؛ لا تتوفر لك صلاحية العرض بعد الحفظ.";
                    }
                    return;
                }
                formSuccess = "تم حفظ مسودة سند الصرف.";
            }
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { isSaving = false; }
    }

    private async Task ApproveCurrentAsync()
    {
        if (!CanApproveCurrent) return;
        isApproving = true;
        formError = formSuccess = "";
        try
        {
            if (currentIsReceipt) await TreasuryService.ApproveReceiptAsync(receiptDto.ReceiptID, UserSession.UserID);
            else await TreasuryService.ApprovePaymentAsync(paymentDto.PaymentID, UserSession.UserID);
            await LoadCurrentVoucherAsync();
            formSuccess = "تم الاعتماد عبر إجراء الترحيل الحالي.";
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { isApproving = false; }
    }

    private async Task ApproveRowAsync(VoucherRow row)
    {
        try
        {
            if (row.IsReceipt) await TreasuryService.ApproveReceiptAsync(row.Id, UserSession.UserID);
            else await TreasuryService.ApprovePaymentAsync(row.Id, UserSession.UserID);
            toast = $"تم اعتماد سند {(row.IsReceipt ? "القبض" : "الصرف")} {row.Number} عبر إجراء الترحيل الحالي.";
            await ReloadListsAsync();
        }
        catch (Exception ex) { pageError = ex.Message; }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deleteTarget is null) return;
        isDeleting = true;
        deleteError = "";
        try
        {
            if (deleteTarget.IsReceipt) await TreasuryService.DeleteReceiptAsync(deleteTarget.Id, UserSession.UserID);
            else await TreasuryService.DeletePaymentAsync(deleteTarget.Id, UserSession.UserID);
            toast = "تم حذف المسودة.";
            CloseDeleteDialog();
            await ReloadListsAsync();
        }
        catch (Exception ex) { deleteError = ex.Message; }
        finally { isDeleting = false; }
    }

    private async Task ExportReceiptsAsync()
    {
        if (receiptPermissions?.CanExport != true || CurrentTab != "receipt") return;
        isExporting = true;
        pageError = "";
        try
        {
            var visible = filteredRows.Where(x => x.IsReceipt).Select(x => receiptVouchers.First(v => v.ReceiptID == x.Id)).ToList();
            if (visible.Count == 0) return;
            var bytes = await TreasuryService.ExportReceiptsToExcelAsync(visible, UserSession.UserID);
            await JS.InvokeVoidAsync("downloadFile", $"ReceiptVouchers_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { pageError = ex.Message; }
        finally { isExporting = false; }
    }

