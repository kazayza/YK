.v-btn{min-height:38px;border:1px solid transparent;border-radius:10px;padding:8px 14px;font:700 .82rem 'Tajawal',sans-serif;cursor:pointer;transition:transform .15s,box-shadow .15s,background .15s}.v-btn:hover{transform:translateY(-1px)}.v-btn:disabled{opacity:.6;cursor:wait;transform:none}.v-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;vertical-align:middle;margin-left:6px}.v-btn-gold{background:linear-gradient(135deg,#E2C45E,#B08C2F);color:#121212;box-shadow:0 4px 12px rgba(212,175,55,.18)}.v-btn-ghost{background:#fff;color:#243044;border-color:#e5e7eb}.v-btn-approve,.v-btn-receipt{background:linear-gradient(135deg,#16856a,#0c6954);color:#fff}.v-btn-payment{background:linear-gradient(135deg,#9f3434,#7b2020);color:#fff}.v-btn-danger{background:#b42318;color:#fff}
