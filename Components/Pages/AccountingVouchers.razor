    private async Task RefreshReceiptInvoicesAsync()
    {
        salesSettlementInvoices = new List<VoucherInvoiceAllocationDto>();
        settlementLookupError = "";
        if (!CanViewSalesInvoices || receiptDto.EntityType != 1 || receiptDto.EntityID.GetValueOrDefault() <= 0) return;

        isLoadingSettlementInvoices = true;
        try
        {
            salesSettlementInvoices = await TreasuryService.GetSalesInvoicesForSettlementAsync(
                receiptDto.EntityID!.Value, receiptDto.ReceiptID > 0 ? receiptDto.ReceiptID : null);
            foreach (var allocation in receiptDto.InvoiceAllocations)
                if (!salesSettlementInvoices.Any(x => x.InvoiceID == allocation.InvoiceID))
                    salesSettlementInvoices.Add(allocation);
            salesSettlementInvoices = salesSettlementInvoices.OrderBy(x => x.InvoiceDate).ThenBy(x => x.InvoiceID).ToList();
        }
        catch (Exception ex) { settlementLookupError = ex.Message; }
        finally { isLoadingSettlementInvoices = false; }
    }

    private async Task RefreshPaymentInvoicesAsync()
    {
        purchaseSettlementInvoices = new List<VoucherInvoiceAllocationDto>();
        settlementLookupError = "";
        if (!CanViewPurchaseInvoices || paymentDto.EntityType != 1 || paymentDto.EntityID.GetValueOrDefault() <= 0) return;

        isLoadingSettlementInvoices = true;
        try
        {
            purchaseSettlementInvoices = await TreasuryService.GetPurchaseInvoicesForSettlementAsync(
                paymentDto.EntityID!.Value, paymentDto.PaymentID > 0 ? paymentDto.PaymentID : null);
            foreach (var allocation in paymentDto.InvoiceAllocations)
                if (!purchaseSettlementInvoices.Any(x => x.InvoiceID == allocation.InvoiceID))
                    purchaseSettlementInvoices.Add(allocation);
            purchaseSettlementInvoices = purchaseSettlementInvoices.OrderBy(x => x.InvoiceDate).ThenBy(x => x.InvoiceID).ToList();
        }
        catch (Exception ex) { settlementLookupError = ex.Message; }
        finally { isLoadingSettlementInvoices = false; }
    }

    private bool IsReceiptInvoiceCompatible(VoucherInvoiceAllocationDto invoice) =>
        (invoice.CurrencyID ?? 0) == (receiptDto.CurrencyID ?? 0) &&
        Math.Abs(invoice.ExchangeRate - (receiptDto.ExchangeRate <= 0 ? 1 : receiptDto.ExchangeRate)) <= 0.000001m;

    private bool IsPaymentInvoiceCompatible(VoucherInvoiceAllocationDto invoice) =>
        (invoice.CurrencyID ?? 0) == (paymentDto.CurrencyID ?? 0) &&
        Math.Abs(invoice.ExchangeRate - (paymentDto.ExchangeRate <= 0 ? 1 : paymentDto.ExchangeRate)) <= 0.000001m;

    private async Task ToggleReceiptInvoiceAsync(VoucherInvoiceAllocationDto invoice, ChangeEventArgs args)
    {
        var selected = args.Value is bool value ? value : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        var existing = receiptDto.InvoiceAllocations.FirstOrDefault(x => x.InvoiceID == invoice.InvoiceID);
        if (selected && existing is null && IsReceiptInvoiceCompatible(invoice))
        {
            receiptDto.InvoiceAllocations.Add(new VoucherInvoiceAllocationDto
            {
                InvoiceID = invoice.InvoiceID, InvoiceNumber = invoice.InvoiceNumber, InvoiceDate = invoice.InvoiceDate,
                PartyID = invoice.PartyID, PartyName = invoice.PartyName, TotalAmount = invoice.TotalAmount,
                PaidAmount = invoice.PaidAmount, RemainingAmount = invoice.RemainingAmount,
                CurrencyID = invoice.CurrencyID, ExchangeRate = invoice.ExchangeRate,
                CurrencyCode = invoice.CurrencyCode, AppliedAmount = invoice.RemainingAmount
            });
            receiptDto.RevenueAccountID = null;
            receiptDto.RevenueAccountNameAr = null;
        }
        else if (!selected && existing is not null)
        {
            receiptDto.InvoiceAllocations.Remove(existing);
        }
        RecalculateReceiptSettlement();
        await Task.CompletedTask;
    }

    private async Task TogglePaymentInvoiceAsync(VoucherInvoiceAllocationDto invoice, ChangeEventArgs args)
    {
        var selected = args.Value is bool value ? value : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
        var existing = paymentDto.InvoiceAllocations.FirstOrDefault(x => x.InvoiceID == invoice.InvoiceID);
        if (selected && existing is null && IsPaymentInvoiceCompatible(invoice))
        {
            paymentDto.InvoiceAllocations.Add(new VoucherInvoiceAllocationDto
            {
                InvoiceID = invoice.InvoiceID, InvoiceNumber = invoice.InvoiceNumber, InvoiceDate = invoice.InvoiceDate,
                PartyID = invoice.PartyID, PartyName = invoice.PartyName, TotalAmount = invoice.TotalAmount,
                PaidAmount = invoice.PaidAmount, RemainingAmount = invoice.RemainingAmount,
                CurrencyID = invoice.CurrencyID, ExchangeRate = invoice.ExchangeRate,
                CurrencyCode = invoice.CurrencyCode, AppliedAmount = invoice.RemainingAmount
            });
            paymentDto.ExpenseAccountID = null;
            paymentDto.ExpenseAccountNameAr = null;
        }
        else if (!selected && existing is not null)
        {
            paymentDto.InvoiceAllocations.Remove(existing);
        }
        RecalculatePaymentSettlement();
        await Task.CompletedTask;
    }

    private void RecalculateReceiptSettlement()
    {
        receiptDto.IsInvoiceSettlement = receiptDto.InvoiceAllocations.Count > 0;
        if (receiptDto.IsInvoiceSettlement)
            receiptDto.Amount = ReceiptAllocationTotal;
        else
        {
            receiptDto.RevenueAccountID = null;
            receiptDto.RevenueAccountNameAr = null;
        }
        CalcReceiptLocal();
    }

    private void RecalculatePaymentSettlement()
    {
        paymentDto.IsInvoiceSettlement = paymentDto.InvoiceAllocations.Count > 0;
        if (paymentDto.IsInvoiceSettlement)
            paymentDto.Amount = PaymentAllocationTotal;
        else
        {
            paymentDto.ExpenseAccountID = null;
            paymentDto.ExpenseAccountNameAr = null;
        }
        CalcPaymentLocal();
    }

    private void CalcReceiptLocal() => receiptDto.AmountLocal = receiptDto.Amount * (receiptDto.ExchangeRate <= 0 ? 1 : receiptDto.ExchangeRate);
    private void CalcPaymentLocal() => paymentDto.AmountLocal = paymentDto.Amount * (paymentDto.ExchangeRate <= 0 ? 1 : paymentDto.ExchangeRate);
    private static string NormalizeTab(string? value) => value?.Trim().ToLowerInvariant() switch { "receipt" or "قبض" => "receipt", "payment" or "صرف" => "payment", _ => "all" };
    private static string StatusColor(int status) => status switch { 1 => "#667085", 2 => "#08734f", 3 => "#b42318", _ => "#667085" };
    private static string JournalLabel(VoucherRow row) => !string.IsNullOrWhiteSpace(row.JournalNumber) ? row.JournalNumber! : $"#{row.JournalId}";

