@page "/accounting-vouchers"
@page "/accounting-vouchers/new/{Type}"
@page "/accounting-vouchers/{Type}/edit/{Id:int}"
@page "/accounting-vouchers/{Type}/view/{ViewId:int}"
@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject TreasuryService TreasuryService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<AccountingVouchers> Logger

<PageTitle>@(IsFormRoute ? FormTitle : "سندات القبض والصرف")</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-luxury" dir="rtl"><h4>يجب تسجيل الدخول</h4></div>
}
else if (isLoading)
{
    <div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>
}
else if (IsFormRoute && !formAccessGranted)
{
    <div class="no-access-luxury" dir="rtl"><h4>@(string.IsNullOrWhiteSpace(formError) ? "ليس لديك صلاحية لهذا النوع من السندات" : formError)</h4></div>
}
else if (!IsFormRoute && !CanViewAny)
{
    <div class="no-access-luxury" dir="rtl"><h4>ليس لديك صلاحية عرض سندات القبض أو الصرف</h4></div>
}
else
{
    <div class="yk-gold-page voucher-page" dir="rtl">
        <header class="voucher-hero">
            <div class="voucher-hero-line"></div>
            <div class="voucher-hero-content">
                <div class="voucher-brand">
                    <span class="voucher-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></span>
                    <div>
                        <h1>@(IsFormRoute ? FormTitle : "سندات القبض والصرف")</h1>
                        <p>@(IsFormRoute ? FormSubtitle : "إدارة القبض والصرف والقيود المرتبطة بهما")</p>
                    </div>
                </div>
                <div class="voucher-hero-actions">
                    @if (IsFormRoute)
                    {
                        <button class="v-btn v-btn-ghost" @onclick="BackToList">رجوع للقائمة</button>
                        @if (CanSaveCurrent)
                        {
                            <button class="v-btn v-btn-gold" @onclick="SaveCurrentAsync" disabled="@isSaving">@(isSaving ? "جارٍ الحفظ..." : "حفظ مسودة")</button>
                        }
                        @if (CanApproveCurrent)
                        {
                            <button class="v-btn v-btn-approve" @onclick="ApproveCurrentAsync" disabled="@isApproving">@(isApproving ? "جارٍ الاعتماد..." : "اعتماد وترحيل")</button>
                        }
                    }
                    else
                    {
                        <span class="v-count">@VoucherListCountText</span>
                        @if (CanAddExpense)
                        {
                            <button class="v-btn v-btn-ghost" @onclick="OpenNewExpense">مصروف جديد</button>
                        }
                        @if (CanAddAny)
                        {
                            <button class="v-btn v-btn-gold" @onclick="BeginNewVoucher">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                                سند جديد
                            </button>
                        }
                    }
                </div>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(pageError))
        {
            <div class="v-alert v-alert-error" role="alert">@pageError</div>
        }
        @if (!IsFormRoute && voucherListsLoadFailed)
        {
            <div class="v-alert v-alert-error" role="alert">
                <span>@(isRefreshing ? "جارٍ إعادة تحميل قائمة السندات..." : voucherListsLoadError)</span>
                <button type="button" class="v-btn v-btn-ghost" @onclick="ReloadListsAsync" disabled="@isRefreshing">@(isRefreshing ? "جارٍ..." : "إعادة محاولة تحميل السندات")</button>
            </div>
        }

        @if (!IsFormRoute)
        {
            <section class="v-tabs" aria-label="نوع السند">
                <button class="v-tab @(CurrentTab == "all" ? "active" : "")" @onclick='() => SelectTab("all")'>الكل</button>
                @if (CanViewReceipt)
                {
                    <button class="v-tab @(CurrentTab == "receipt" ? "active" : "")" @onclick='() => SelectTab("receipt")'>القبض</button>
                }
                @if (CanViewPayment)
                {
                    <button class="v-tab @(CurrentTab == "payment" ? "active" : "")" @onclick='() => SelectTab("payment")'>الصرف</button>
                }
            </section>

            @if (voucherListsLoaded)
            {
                <section class="v-stats">
                    <article class="v-stat"><span class="v-stat-label">مسودات</span><strong>@filteredRows.Count(x => x.Status == 1)</strong></article>
                    <article class="v-stat"><span class="v-stat-label">معتمدة</span><strong>@filteredRows.Count(x => x.Status == 2)</strong></article>
                    <article class="v-stat"><span class="v-stat-label">إجمالي المعروض</span><strong>@filteredRows.Sum(x => x.AmountLocal).ToString("#,##0.00")</strong></article>
                </section>
            }

            <section class="v-filters" aria-label="تصفية السندات">
                <label class="v-search">
                    <span class="sr-only">بحث في السندات</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
                    <input type="search" placeholder="بحث برقم السند أو الجهة أو الخزينة" @bind="searchText" @bind:event="oninput" />
                </label>
                <select class="v-filter" @bind="filterStatus">
                    <option value="0">كل الحالات</option><option value="1">مسودة</option><option value="2">معتمد</option><option value="3">ملغي</option>
                </select>
                <select class="v-filter" @bind="filterCashBox">
                    <option value="0">كل الخزائن</option>
                    @foreach (var box in cashBoxes)
                    {
                        <option value="@box.Id">@box.Name</option>
                    }
                </select>
                <button class="v-btn v-btn-ghost" @onclick="ReloadListsAsync" disabled="@isRefreshing">@(isRefreshing ? "جارٍ التحديث..." : "تحديث")</button>
                @if (CurrentTab == "receipt" && receiptPermissions?.CanExport == true)
                {
                    <button class="v-btn v-btn-ghost" @onclick="ExportReceiptsAsync" disabled="@isExporting">@(isExporting ? "جارٍ التصدير..." : "تصدير قبض Excel")</button>
                }
            </section>

            @if (!string.IsNullOrWhiteSpace(cashBoxLookupError))
            {
                <div class="v-alert v-alert-error" role="alert">
                    @cashBoxLookupError
                    <button class="v-btn v-btn-ghost" @onclick="ReloadListsAsync" disabled="@isRefreshing">
                        @(isRefreshing ? "جارٍ التحديث..." : "إعادة محاولة تحميل الخزائن")
                    </button>
                </div>
            }

            @if (voucherListsLoaded && filteredRows.Count == 0)
            {
                <section class="v-empty">
                    <span class="v-empty-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" /></svg></span>
                    <h2>لا توجد سندات مطابقة</h2>
                    <p>غيّر عوامل البحث أو أنشئ سنداً جديداً.</p>
                </section>
            }
            else if (voucherListsLoaded && filteredRows.Count > 0)
            {
                <section class="v-table-card">
                    <div class="table-responsive">
                        <table class="v-table">
                            <thead>
                                <tr><th>#</th><th>النوع</th><th>رقم السند</th><th>التاريخ</th><th>الجهة</th><th>الخزينة</th><th>المبلغ المحلي</th><th>طريقة الدفع</th><th>القيد</th><th>الحالة</th><th>إجراءات</th></tr>
                            </thead>
                            <tbody>
                                @{ var rowNo = 0; }
                                @foreach (var row in filteredRows)
                                {
                                    rowNo++;
                                    var canEdit = row.IsReceipt ? receiptPermissions?.CanEdit == true : paymentPermissions?.CanEdit == true;
                                    var canApprove = row.IsReceipt ? receiptPermissions?.CanApprove == true : paymentPermissions?.CanApprove == true;
                                    var canDelete = row.IsReceipt ? receiptPermissions?.CanDelete == true : paymentPermissions?.CanDelete == true;
                                    <tr>
                                        <td class="v-muted">@rowNo</td>
                                        <td><span class="v-kind @(row.IsReceipt ? "receipt" : "payment")">@(row.IsReceipt ? "قبض" : "صرف")</span></td>
                                        <td><button class="v-number" @onclick="() => OpenView(row)">@row.Number</button></td>
                                        <td class="v-muted">@row.Date.ToString("dd/MM/yyyy")</td>
                                        <td>@row.Party</td>
                                        <td>@row.CashBox</td>
                                        <td class="v-amount">@row.AmountLocal.ToString("#,##0.00")</td>
                                        <td class="v-muted">@row.Method</td>
                                        <td>@if (row.JournalId.HasValue || !string.IsNullOrWhiteSpace(row.JournalNumber)){<span class="v-journal">@JournalLabel(row)</span>}else{<span class="v-muted">غير مرحل</span>}</td>
                                        <td><span class="v-status" style="--status-color:@StatusColor(row.Status)">@row.StatusName</span></td>
                                        <td><div class="v-row-actions">
                                            @if (row.Status == 1 && canEdit)
                                            {
                                                <button class="v-icon-btn" title="تعديل المسودة" aria-label="تعديل المسودة" @onclick="() => OpenEdit(row)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m16 4 4 4M4 20l4-.8L20 7.2 16.8 4 4.8 16z" /></svg></button>
                                            }
                                            else
                                            {
                                                <button class="v-icon-btn" title="عرض" aria-label="عرض" @onclick="() => OpenView(row)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></svg></button>
                                            }
                                            @if (row.Status == 1 && canApprove)
                                            {
                                                <button class="v-icon-btn approve" title="اعتماد وترحيل" aria-label="اعتماد وترحيل" @onclick="() => ApproveRowAsync(row)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg></button>
                                            }
                                            @if (row.Status == 1 && canDelete)
                                            {
                                                <button class="v-icon-btn delete" title="حذف المسودة" aria-label="حذف المسودة" @onclick="() => RequestDelete(row)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6m4-6v6M6 7l1 14h10l1-14M9 7V4h6v3" /></svg></button>
                                            }
                                        </div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        }
        else
        {
            <section class="v-form-card">
                <div class="v-card-head">
                    <div><h2>@FormSectionTitle</h2><p>احفظ المسودة أولاً، ثم اعتمدها عبر إجراء الترحيل الحالي.</p></div>
                    <span class="v-status" style="--status-color:@StatusColor(CurrentStatus)">@CurrentStatusName</span>
                </div>
                <p class="v-form-note">اختر فاتورة أو أكثر بعد تحديد العميل أو المورد لتخصيص المبلغ عليها؛ لا تُرحّل التسوية إلا على حساب الذمم وتُحدّث مدفوعات الفواتير عند الاعتماد. إذا لم تختر فاتورة يبقى السند عملية عامة. @if (currentIsPayment){<span> للمصروف الجديد المدفوع مباشرة، استخدم «مصروف جديد» من شاشة المصروفات؛ لا تنشئ سند صرف إضافياً للمصروف نفسه.</span>}</p>

                @if (currentIsReceipt)
                {
                    <div class="v-form-grid">
                        <label class="v-field"><span>رقم السند</span><input value="@receiptDto.ReceiptNumber" placeholder="يُحدّد عند حفظ المسودة" disabled /></label>
                        <label class="v-field"><span>تاريخ السند <b>*</b></span><input type="date" @bind="receiptDto.ReceiptDate" disabled="@isViewRoute" /></label>
                        <label class="v-field"><span>الخزينة <b>*</b></span><select @bind="receiptDto.CashBoxID" disabled="@isViewRoute"><option value="0">اختر الخزينة</option>@foreach (var box in cashBoxes){<option value="@box.Id">@box.Name (@box.Code)</option>}</select></label>
                        <label class="v-field"><span>حساب البنك</span><select @bind="receiptDto.BankAccountID" disabled="@isViewRoute"><option value="0">غير محدد</option>@foreach (var bank in bankAccounts){<option value="@bank.Id">@bank.Name</option>}</select></label>
                        <label class="v-field"><span>نوع الجهة</span><select @bind="receiptDto.EntityType" @bind:after="ReceiptEntityTypeChanged" disabled="@isViewRoute"><option value="1">عميل</option><option value="2">مورد</option><option value="3">جهة أخرى</option></select></label>
                        <label class="v-field"><span>الجهة</span><select @bind="receiptDto.EntityID" @bind:after="ReceiptEntityChanged" disabled="@isViewRoute"><option value="0">@(receiptDto.EntityType == 3 ? "بدون معرف — اكتب الاسم أدناه" : "اختر الجهة")</option>@if(receiptDto.EntityType==1){@foreach(var x in customers){<option value="@x.Id">@x.Name (@x.Code)</option>}}else if(receiptDto.EntityType==2){@foreach(var x in suppliers){<option value="@x.Id">@x.Name (@x.Code)</option>}}</select></label>
                        <label class="v-field v-field-wide"><span>المستلم من</span><input @bind="receiptDto.ReceivedFrom" disabled="@isViewRoute" placeholder="يُستكمل من الجهة أو يُكتب يدوياً" /></label>
                        <label class="v-field"><span>المبلغ <b>*</b></span><input type="number" min="0" step="0.01" @bind="receiptDto.Amount" @bind:after="CalcReceiptLocal" disabled="@isViewRoute" /></label>
                        <label class="v-field"><span>العملة</span><select @bind="receiptDto.CurrencyID" @bind:after="CalcReceiptLocal" disabled="@isViewRoute"><option value="0">العملة الافتراضية</option>@foreach(var cur in currencies){<option value="@cur.Id">@cur.Name</option>}</select></label>
                        <label class="v-field"><span>سعر الصرف</span><input type="number" min="0.000001" step="0.000001" @bind="receiptDto.ExchangeRate" @bind:after="CalcReceiptLocal" disabled="@isViewRoute" /></label>
                        <label class="v-field"><span>المبلغ بالعملة المحلية</span><input value="@receiptDto.AmountLocal.ToString("#,##0.00")" disabled /></label>
                        <label class="v-field"><span>طريقة القبض</span><select @bind="receiptDto.PaymentMethod" disabled="@isViewRoute"><option value="1">نقدي</option><option value="2">تحويل بنكي</option><option value="3">شيك</option><option value="4">بطاقة</option></select></label>
                        @if (receiptDto.PaymentMethod == 3)
                        {
                            <label class="v-field"><span>رقم الشيك</span><input @bind="receiptDto.ChequeNumber" disabled="@isViewRoute" /></label>
                            <label class="v-field"><span>تاريخ الشيك</span><input type="date" @bind="receiptDto.ChequeDate" disabled="@isViewRoute" /></label>
                            <label class="v-field"><span>بنك الشيك</span><input @bind="receiptDto.ChequeBankName" disabled="@isViewRoute" /></label>
                        }
                        @if (receiptDto.PaymentMethod == 2)
                        {
                            <label class="v-field"><span>مرجع التحويل</span><input @bind="receiptDto.TransferRef" disabled="@isViewRoute" /></label>
                        }
                        @if (receiptDto.IsInvoiceSettlement)
                        {
                            <div class="v-field v-field-wide v-settlement-account">
                                <strong>حساب ذمم العميل</strong>
                                <span>@(receiptDto.RevenueAccountNameAr ?? "سيُحدّد من قيد الفاتورة المعتمد عند حفظ المسودة")</span>
                            </div>
                        }
                        else
                        {
                            <label class="v-field"><span>حساب الإيراد</span><select @bind="receiptDto.RevenueAccountID" disabled="@isViewRoute"><option value="0">اختر الحساب المعتمد</option>@foreach(var acc in revenueAccounts){<option value="@acc.Id">@acc.Name (@acc.Code)</option>}</select></label>
                        }
                        <label class="v-field"><span>مركز التكلفة</span><select @bind="receiptDto.CostCenterID" disabled="@isViewRoute"><option value="0">بدون مركز تكلفة</option>@foreach(var cc in costCenters){<option value="@cc.Id">@cc.Name</option>}</select></label>
                        <label class="v-field v-field-wide"><span>البيان</span><textarea rows="2" @bind="receiptDto.Description" disabled="@isViewRoute"></textarea></label>
                        <label class="v-field v-field-wide"><span>ملاحظات</span><textarea rows="2" @bind="receiptDto.Notes" disabled="@isViewRoute"></textarea></label>
                    </div>
                    @if (receiptDto.EntityType == 1 && receiptDto.EntityID.GetValueOrDefault() > 0)
                    {
                        <section class="v-settlement" aria-label="تسوية فواتير العميل">
                            <div class="v-settlement-head">
                                <div><strong>فواتير العميل المعتمدة ذات المتبقي</strong><span>اختر فاتورة أو أكثر؛ ويمكن تعديل المبلغ المخصص لكل فاتورة.</span></div>
                                @if (receiptDto.IsInvoiceSettlement){<span class="v-settlement-badge">تسوية ذمم</span>}
                            </div>
                            @if (!CanViewSalesInvoices)
                            {
                                <div class="v-settlement-message">لا تتوفر صلاحية عرض فواتير المبيعات لهذا المستخدم.</div>
                            }
                            else if (isLoadingSettlementInvoices)
                            {
                                <div class="v-settlement-message">جارٍ تحميل الفواتير...</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(settlementLookupError))
                            {
                                <div class="v-settlement-message v-settlement-error">@settlementLookupError</div>
                            }
                            else if (salesSettlementInvoices.Count == 0)
                            {
                                <div class="v-settlement-message">لا توجد فواتير معتمدة بمتبقٍ متاح لهذا العميل.</div>
                            }
                            else
                            {
                                <div class="v-settlement-table-wrap">
                                    <table class="v-settlement-table">
                                        <thead><tr><th>اختيار</th><th>رقم الفاتورة</th><th>التاريخ</th><th>الإجمالي</th><th>المدفوع</th><th>المتاح</th><th>العملة</th><th>المخصص</th></tr></thead>
                                        <tbody>
                                            @foreach (var invoice in salesSettlementInvoices)
                                            {
                                                var receiptAllocation = receiptDto.InvoiceAllocations.FirstOrDefault(x => x.InvoiceID == invoice.InvoiceID);
                                                var compatible = IsReceiptInvoiceCompatible(invoice);
                                                <tr>
                                                    <td><input type="checkbox" checked="@(receiptAllocation is not null)" disabled="@(isViewRoute || (!compatible && receiptAllocation is null))" @onchange="@(args => ToggleReceiptInvoiceAsync(invoice, args))" aria-label="اختيار فاتورة @invoice.InvoiceNumber" /></td>
                                                    <td><strong>@invoice.InvoiceNumber</strong></td>
                                                    <td>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                                    <td>@invoice.TotalAmount.ToString("#,##0.00")</td>
                                                    <td>@invoice.PaidAmount.ToString("#,##0.00")</td>
                                                    <td>@invoice.RemainingAmount.ToString("#,##0.00")</td>
                                                    <td><span>@(invoice.CurrencyCode ?? "—")</span><small class="v-muted">سعر @invoice.ExchangeRate.ToString("0.######")</small></td>
                                                    <td>
                                                        @if (receiptAllocation is not null && isViewRoute)
                                                        {
                                                            <span class="v-amount">@receiptAllocation.AppliedAmount.ToString("#,##0.00")</span>
                                                        }
                                                        else if (!compatible)
                                                        {
                                                            <small class="v-incompatible">@(receiptAllocation is null ? "عملة/سعر صرف مختلف" : $"عملة غير متوافقة · {receiptAllocation.AppliedAmount:#,##0.00}")</small>
                                                        }
                                                        else if (receiptAllocation is not null)
                                                        {
                                                            <input class="v-allocation-input" type="number" min="0.01" max="@invoice.RemainingAmount" step="0.01" @bind="receiptAllocation.AppliedAmount" @bind:event="oninput" @bind:after="RecalculateReceiptSettlement" disabled="@isViewRoute" aria-label="المبلغ المخصص للفاتورة @invoice.InvoiceNumber" />
                                                        }
                                                        else { <span class="v-muted">—</span> }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="v-settlement-summary">
                                    <span>إجمالي التخصيص: <strong>@ReceiptAllocationTotal.ToString("#,##0.00")</strong></span>
                                    <span>مبلغ السند: <strong>@receiptDto.Amount.ToString("#,##0.00")</strong></span>
                                    @if (receiptDto.IsInvoiceSettlement && ReceiptAllocationTotal != receiptDto.Amount)
                                    {
                                        <small class="v-settlement-error">يجب أن يساوي مبلغ السند مجموع تخصيصات الفواتير.</small>
                                    }
                                </div>
                            }
                        </section>
                    }
                }
                else
                {
                    <div class="v-form-grid">
                        <label class="v-field"><span>رقم السند</span><input value="@paymentDto.PaymentNumber" placeholder="يُحدّد عند حفظ المسودة" disabled /></label>
                        <label class="v-field"><span>تاريخ السند <b>*</b></span><input type="date" @bind="paymentDto.PaymentDate" disabled="@isViewRoute" /></label>
                        <label class="v-field"><span>الخزينة <b>*</b></span><select @bind="paymentDto.CashBoxID" disabled="@isViewRoute"><option value="0">اختر الخزينة</option>@foreach (var box in cashBoxes){<option value="@box.Id">@box.Name (@box.Code)</option>}</select></label>
                        <label class="v-field"><span>حساب البنك</span><select @bind="paymentDto.BankAccountID" disabled="@isViewRoute"><option value="0">غير محدد</option>@foreach (var bank in bankAccounts){<option value="@bank.Id">@bank.Name</option>}</select></label>
                        <label class="v-field"><span>نوع الجهة</span><select @bind="paymentDto.EntityType" @bind:after="PaymentEntityTypeChanged" disabled="@isViewRoute"><option value="1">مورد</option><option value="2">عميل</option><option value="3">جهة أخرى</option></select></label>
                        <label class="v-field"><span>الجهة</span><select @bind="paymentDto.EntityID" @bind:after="PaymentEntityChanged" disabled="@isViewRoute"><option value="0">@(paymentDto.EntityType == 3 ? "بدون معرف — اكتب الاسم أدناه" : "اختر الجهة")</option>@if(paymentDto.EntityType==1){@foreach(var x in suppliers){<option value="@x.Id">@x.Name (@x.Code)</option>}}else if(paymentDto.EntityType==2){@foreach(var x in customers){<option value="@x.Id">@x.Name (@x.Code)</option>}}</select></label>
                        <label class="v-field v-field-wide"><span>المدفوع له</span><input @bind="paymentDto.PaidTo" disabled="@isViewRoute" placeholder="يُستكمل من الجهة أو يُكتب يدوياً" /></label>
                        <label class="v-field"><span>المبلغ <b>*</b></span><input type="number" min="0" step="0.01" @bind="paymentDto.Amount" @bind:after="CalcPaymentLocal" disabled="@isViewRoute" /></label>
                        <label class="v-field"><span>العملة</span><select @bind="paymentDto.CurrencyID" @bind:after="CalcPaymentLocal" disabled="@isViewRoute"><option value="0">العملة الافتراضية</option>@foreach(var cur in currencies){<option value="@cur.Id">@cur.Name</option>}</select></label>
                        <label class="v-field"><span>سعر الصرف</span><input type="number" min="0.000001" step="0.000001" @bind="paymentDto.ExchangeRate" @bind:after="CalcPaymentLocal" disabled="@isViewRoute" /></label>
                        <label class="v-field"><span>المبلغ بالعملة المحلية</span><input value="@paymentDto.AmountLocal.ToString("#,##0.00")" disabled /></label>
                        <label class="v-field"><span>طريقة الصرف</span><select @bind="paymentDto.PaymentMethod" disabled="@isViewRoute"><option value="1">نقدي</option><option value="2">تحويل بنكي</option><option value="3">شيك</option><option value="4">بطاقة</option></select></label>
                        @if (paymentDto.PaymentMethod == 3)
                        {
                            <label class="v-field"><span>رقم الشيك</span><input @bind="paymentDto.ChequeNumber" disabled="@isViewRoute" /></label>
                            <label class="v-field"><span>تاريخ الشيك</span><input type="date" @bind="paymentDto.ChequeDate" disabled="@isViewRoute" /></label>
                            <label class="v-field"><span>بنك الشيك</span><input @bind="paymentDto.ChequeBankName" disabled="@isViewRoute" /></label>
                        }
                        @if (paymentDto.PaymentMethod == 2)
                        {
                            <label class="v-field"><span>مرجع التحويل</span><input @bind="paymentDto.TransferRef" disabled="@isViewRoute" /></label>
                        }
                        @if (paymentDto.IsInvoiceSettlement)
                        {
                            <div class="v-field v-field-wide v-settlement-account">
                                <strong>حساب ذمم المورد</strong>
                                <span>@(paymentDto.ExpenseAccountNameAr ?? "سيُحدّد من قيد الفاتورة المعتمد عند حفظ المسودة")</span>
                            </div>
                        }
                        else
                        {
                            <label class="v-field"><span>حساب المصروف</span><select @bind="paymentDto.ExpenseAccountID" disabled="@isViewRoute"><option value="0">اختر الحساب المعتمد</option>@foreach(var acc in expenseAccounts){<option value="@acc.Id">@acc.Name (@acc.Code)</option>}</select></label>
                        }
                        <label class="v-field"><span>مركز التكلفة</span><select @bind="paymentDto.CostCenterID" disabled="@isViewRoute"><option value="0">بدون مركز تكلفة</option>@foreach(var cc in costCenters){<option value="@cc.Id">@cc.Name</option>}</select></label>
                        <label class="v-field v-field-wide"><span>البيان</span><textarea rows="2" @bind="paymentDto.Description" disabled="@isViewRoute"></textarea></label>
                        <label class="v-field v-field-wide"><span>ملاحظات</span><textarea rows="2" @bind="paymentDto.Notes" disabled="@isViewRoute"></textarea></label>
                    </div>
                    @if (paymentDto.EntityType == 1 && paymentDto.EntityID.GetValueOrDefault() > 0)
                    {
                        <section class="v-settlement" aria-label="تسوية فواتير المورد">
                            <div class="v-settlement-head">
                                <div><strong>فواتير المورد المستحقة ذات المتبقي</strong><span>اختر فاتورة أو أكثر؛ ويمكن تعديل المبلغ المخصص لكل فاتورة.</span></div>
                                @if (paymentDto.IsInvoiceSettlement){<span class="v-settlement-badge">تسوية ذمم</span>}
                            </div>
                            @if (!CanViewPurchaseInvoices)
                            {
                                <div class="v-settlement-message">لا تتوفر صلاحية عرض فواتير المشتريات لهذا المستخدم.</div>
                            }
                            else if (isLoadingSettlementInvoices)
                            {
                                <div class="v-settlement-message">جارٍ تحميل الفواتير...</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(settlementLookupError))
                            {
                                <div class="v-settlement-message v-settlement-error">@settlementLookupError</div>
                            }
                            else if (purchaseSettlementInvoices.Count == 0)
                            {
                                <div class="v-settlement-message">لا توجد فواتير معتمدة بمتبقٍ متاح لهذا المورد.</div>
                            }
                            else
                            {
                                <div class="v-settlement-table-wrap">
                                    <table class="v-settlement-table">
                                        <thead><tr><th>اختيار</th><th>رقم الفاتورة</th><th>التاريخ</th><th>الإجمالي</th><th>المدفوع</th><th>المتاح</th><th>العملة</th><th>المخصص</th></tr></thead>
                                        <tbody>
                                            @foreach (var invoice in purchaseSettlementInvoices)
                                            {
                                                var paymentAllocation = paymentDto.InvoiceAllocations.FirstOrDefault(x => x.InvoiceID == invoice.InvoiceID);
                                                var compatible = IsPaymentInvoiceCompatible(invoice);
                                                <tr>
                                                    <td><input type="checkbox" checked="@(paymentAllocation is not null)" disabled="@(isViewRoute || (!compatible && paymentAllocation is null))" @onchange="@(args => TogglePaymentInvoiceAsync(invoice, args))" aria-label="اختيار فاتورة @invoice.InvoiceNumber" /></td>
                                                    <td><strong>@invoice.InvoiceNumber</strong></td>
                                                    <td>@invoice.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                                    <td>@invoice.TotalAmount.ToString("#,##0.00")</td>
                                                    <td>@invoice.PaidAmount.ToString("#,##0.00")</td>
                                                    <td>@invoice.RemainingAmount.ToString("#,##0.00")</td>
                                                    <td><span>@(invoice.CurrencyCode ?? "—")</span><small class="v-muted">سعر @invoice.ExchangeRate.ToString("0.######")</small></td>
                                                    <td>
                                                        @if (paymentAllocation is not null && isViewRoute)
                                                        {
                                                            <span class="v-amount">@paymentAllocation.AppliedAmount.ToString("#,##0.00")</span>
                                                        }
                                                        else if (!compatible)
                                                        {
                                                            <small class="v-incompatible">@(paymentAllocation is null ? "عملة/سعر صرف مختلف" : $"عملة غير متوافقة · {paymentAllocation.AppliedAmount:#,##0.00}")</small>
                                                        }
                                                        else if (paymentAllocation is not null)
                                                        {
                                                            <input class="v-allocation-input" type="number" min="0.01" max="@invoice.RemainingAmount" step="0.01" @bind="paymentAllocation.AppliedAmount" @bind:event="oninput" @bind:after="RecalculatePaymentSettlement" disabled="@isViewRoute" aria-label="المبلغ المخصص للفاتورة @invoice.InvoiceNumber" />
                                                        }
                                                        else { <span class="v-muted">—</span> }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="v-settlement-summary">
                                    <span>إجمالي التخصيص: <strong>@PaymentAllocationTotal.ToString("#,##0.00")</strong></span>
                                    <span>مبلغ السند: <strong>@paymentDto.Amount.ToString("#,##0.00")</strong></span>
                                    @if (paymentDto.IsInvoiceSettlement && PaymentAllocationTotal != paymentDto.Amount)
                                    {
                                        <small class="v-settlement-error">يجب أن يساوي مبلغ السند مجموع تخصيصات الفواتير.</small>
                                    }
                                </div>
                            }
                        </section>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(formError))
                {
                    <div class="v-alert v-alert-error" role="alert">@formError</div>
                }
                @if (!string.IsNullOrWhiteSpace(formSuccess))
                {
                    <div class="v-alert v-alert-success" role="status">@formSuccess</div>
                }
                @if (CurrentJournalId.HasValue)
                {
                    <div class="v-journal-summary"><strong>معرّف القيد المرتبط:</strong> @CurrentJournalId — أُبقي إجراء الترحيل الحالي دون تغيير.</div>
                }
            </section>
        }
    </div>

    @if (showNewTypeDialog)
    {
        <div class="v-modal-backdrop" @onclick="CloseNewTypeDialog">
            <section class="v-modal" role="dialog" aria-modal="true" aria-labelledby="new-voucher-title" @onclick:stopPropagation="true">
                <h2 id="new-voucher-title">اختر نوع السند</h2>
                <p>ستُستخدم الصلاحية والتسلسل الخاصان بالنوع المختار.</p>
                <div class="v-modal-actions">
                    @if (CanAddReceipt){<button class="v-btn v-btn-receipt" @onclick='() => NavigateNew("receipt")'>سند قبض</button>}
                    @if (CanAddPayment){<button class="v-btn v-btn-payment" @onclick='() => NavigateNew("payment")'>سند صرف</button>}
                    <button class="v-btn v-btn-ghost" @onclick="CloseNewTypeDialog">إلغاء</button>
                </div>
            </section>
        </div>
    }

    @if (showDeleteDialog && deleteTarget is not null)
    {
        <div class="v-modal-backdrop" @onclick="CloseDeleteDialog">
            <section class="v-modal" role="dialog" aria-modal="true" aria-labelledby="delete-voucher-title" @onclick:stopPropagation="true">
                <h2 id="delete-voucher-title">حذف مسودة السند؟</h2>
                <p>سيُحذف السند <strong>@deleteTarget.Number</strong> فقط إذا ظلّ مسودة.</p>
                @if (!string.IsNullOrWhiteSpace(deleteError)){<div class="v-alert v-alert-error">@deleteError</div>}
                <div class="v-modal-actions">
                    <button class="v-btn v-btn-danger" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">@(isDeleting ? "جارٍ الحذف..." : "حذف المسودة")</button>
                    <button class="v-btn v-btn-ghost" @onclick="CloseDeleteDialog">إلغاء</button>
                </div>
            </section>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(toast))
    {
        <div class="v-toast" role="status"><span>@toast</span><button aria-label="إغلاق" @onclick='() => toast = ""'>×</button></div>
    }
}

<style>
