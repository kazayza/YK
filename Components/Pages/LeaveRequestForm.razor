    private void OnSubstituteChanged(ChangeEventArgs e)
{
    var val = e.Value?.ToString();
    if (int.TryParse(val, out var id) && id > 0)
        model.SubstituteEmployeeID = id;
    else
        model.SubstituteEmployeeID = null;
}
