@page "/leaves"

@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject LeaveRequestService LeaveRequestService
@inject LeaveTypeService LeaveTypeService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>طلبات الإجازات - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card"><div class="no-access-icon">🔒</div><h4>يجب تسجيل الدخول أولاً</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access-card"><div class="no-access-icon">⛔</div><h4>ليس لديك صلاحية</h4></div>
}
else
{
    <div class="items-page" dir="rtl">
        <div class="page-header">
            <div><h2 class="page-title">طلبات الإجازات</h2><p class="page-subtitle">إدارة طلبات إجازات الموظفين</p></div>
            <div class="header-actions">
                <span class="result-badge">@pagedResult.TotalCount طلب</span>
                @if (permissions.CanExport) {
                    <button class="btn-modern btn-export" @onclick="ExportData" disabled="@isExporting">
                        @if (isExporting) { <div class="btn-spinner-sm"></div><span>جاري...</span> } else { <span>تصدير Excel</span> }
                    </button>
                }
                @if (permissions.CanAdd) {
                    <button class="btn-modern btn-primary-modern" @onclick="GoToAdd"><span class="btn-icon">+</span><span>طلب إجازة</span></button>
                }
            </div>
        </div>

        <div class="filter-card">
            <div class="filter-grid">
                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input type="text" class="search-input" placeholder="بحث بالاسم أو الكود..."
                           @bind="filters.SearchText" @bind:event="oninput" />
                </div>
                <div>
                    <label class="filter-label">القسم</label>
                    <select class="filter-select" @bind="filters.DepartmentID">
                        <option value="0">كل الأقسام</option>
                        @if (departments != null) { @foreach (var d in departments) { <option value="@d.Id">@d.Name</option> } }
                    </select>
                </div>
                <div>
                    <label class="filter-label">نوع الإجازة</label>
                    <select class="filter-select" @bind="filters.LeaveTypeID">
                        <option value="0">كل الأنواع</option>
                        @if (leaveTypes != null) { @foreach (var lt in leaveTypes) { <option value="@lt.LeaveTypeID">@lt.LeaveTypeNameAr</option> } }
                    </select>
                </div>
                <div>
                    <label class="filter-label">الحالة</label>
                    <select class="filter-select" @bind="filters.RequestStatus">
                        <option value="0">الكل</option>
                        <option value="1">مقدم</option>
                        <option value="2">معتمد مدير</option>
                        <option value="3">معتمد HR</option>
                        <option value="4">مرفوض</option>
                        <option value="5">ملغي</option>
                    </select>
                </div>
                <div>
                    <label class="filter-label">من تاريخ</label>
                    <input type="date" class="filter-select" @bind="filters.DateFrom" />
                </div>
                <div>
                    <label class="filter-label">إلى تاريخ</label>
                    <input type="date" class="filter-select" @bind="filters.DateTo" />
                </div>
            </div>
            <div class="filter-actions">
                <button class="btn-modern btn-primary-modern" @onclick="SearchData" disabled="@isLoading">بحث</button>
                <button class="btn-modern btn-ghost" @onclick="ClearFilters" disabled="@isLoading">مسح</button>
            </div>
        </div>

        @if (isLoading) { <div class="loading-state"><div class="loader"></div><p>جاري التحميل...</p></div> }
        else if (!pagedResult.Items.Any()) { <div class="empty-state"><div class="empty-icon">🏖️</div><h4>لا توجد طلبات</h4></div> }
        else {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead><tr>
                            <th class="th-num">#</th><th>رقم الطلب</th><th>الموظف</th><th>القسم</th>
                            <th>نوع الإجازة</th><th>من</th><th>إلى</th><th class="th-center">الأيام</th>
                            <th>الحالة</th><th class="th-actions">إجراءات</th>
                        </tr></thead>
                        <tbody>
                            @{ var rowIdx = (filters.PageNumber - 1) * filters.PageSize; }
                            @foreach (var r in pagedResult.Items) {
                                rowIdx++;
                                <tr>
                                    <td class="td-num">@rowIdx</td>
                                    <td><code class="item-code">@r.RequestNumber</code></td>
                                    <td class="item-name">@r.EmployeeName</td>
                                    <td>@(r.DepartmentName ?? "—")</td>
                                    <td>@(r.LeaveTypeName ?? "—")</td>
                                    <td>@r.StartDate.ToString("dd/MM/yyyy")</td>
                                    <td>@r.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td class="td-center"><span class="days-badge">@r.NumberOfDays</span></td>
                                    <td><span class="leave-status leave-status-@r.RequestStatus">@r.StatusName</span></td>
                                    <td class="td-actions">
                                        <div class="actions-wrap">
                                            <button class="action-btn view-btn" @onclick="() => GoToView(r.LeaveRequestID)">عرض</button>
                                            @if (permissions.CanEdit && r.RequestStatus == 1) {
                                                <button class="action-btn approve-btn" @onclick="() => ApproveByManager(r)">اعتماد مدير</button>
                                            }
                                            @if (permissions.CanEdit && r.RequestStatus == 2) {
                                                <button class="action-btn approve-btn" @onclick="() => ApproveByHR(r)">اعتماد HR</button>
                                            }
                                            @if (permissions.CanEdit && (r.RequestStatus == 1 || r.RequestStatus == 2)) {
                                                <button class="action-btn reject-btn" @onclick="() => ShowRejectDialog(r)">رفض</button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pagination-bar">
                    <div class="pagination-info">الصفحة @pagedResult.PageNumber من @Math.Max(pagedResult.TotalPages, 1)</div>
                    <div class="pagination-actions">
                        <button class="btn-modern btn-ghost" @onclick="PreviousPage" disabled="@(!pagedResult.HasPrevious)">السابق</button>
                        <button class="btn-modern btn-ghost" @onclick="NextPage" disabled="@(!pagedResult.HasNext)">التالي</button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (showRejectDialog && selectedRequest != null) {
        <div class="modal-overlay" @onclick="CloseRejectDialog">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-icon reject-modal-icon">❌</div>
                <h4>رفض طلب الإجازة</h4>
                <p>رفض طلب <strong>@selectedRequest.EmployeeName</strong> من @selectedRequest.StartDate.ToString("dd/MM/yyyy") إلى @selectedRequest.EndDate.ToString("dd/MM/yyyy")؟</p>
                <div class="form-field" style="margin-top:14px">
                    <label class="field-label">سبب الرفض</label>
                    <input type="text" class="field-input" @bind="rejectionReason" placeholder="اكتب سبب الرفض..." />
                </div>
                @if (!string.IsNullOrEmpty(dialogMessage)) { <div class="form-message msg-error">@dialogMessage</div> }
                <div class="modal-buttons-row center-buttons">
                    <button class="btn-modern btn-danger-modern" @onclick="ConfirmReject" disabled="@isProcessing">
                        @if (isProcessing) { <div class="btn-spinner-sm"></div><span>جاري...</span> } else { <span>رفض</span> }
                    </button>
                    <button class="btn-modern btn-ghost" @onclick="CloseRejectDialog" disabled="@isProcessing">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultMessage)) {
        <div class="toast-container">
            <div class="toast-card @(resultSuccess ? "toast-success" : "toast-error")">
                <span class="toast-text">@resultMessage</span>
                <button class="toast-close" @onclick='() => resultMessage = ""'>✕</button>
            </div>
        </div>
    }
}

<style>
    .items-page{display:flex;flex-direction:column;gap:20px}
    .page-header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px}
    .page-title{font-weight:800;color:#1f2937;margin:0}
    .page-subtitle{color:#6b7280;font-size:.9rem;margin:4px 0 0}
    .header-actions{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
    .result-badge{background:#f3f4f6;color:#4b5563;padding:8px 16px;border-radius:999px;font-size:.82rem;font-weight:700}
    .filter-card{background:#fff;border-radius:20px;padding:18px;border:1px solid #eef2f7;box-shadow:0 4px 16px rgba(15,23,42,.04)}
    .filter-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}
    .filter-label{display:block;font-size:.8rem;color:#6b7280;font-weight:700;margin-bottom:6px}
    .search-box{position:relative}.search-icon{position:absolute;right:14px;top:38px;transform:translateY(-50%);color:#9ca3af;pointer-events:none}
    .search-input{width:100%;padding:12px 16px 12px 42px;border:1.5px solid #e5e7eb;border-radius:14px;font-size:.92rem;background:#fff;outline:none}
    .search-input:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
    .filter-select{width:100%;padding:12px 14px;border:1.5px solid #e5e7eb;border-radius:14px;font-size:.88rem;background:#fff;outline:none}
    .filter-actions{display:flex;gap:10px;margin-top:16px}
    .table-card{background:#fff;border-radius:20px;overflow:hidden;border:1px solid #eef2f7;box-shadow:0 4px 16px rgba(15,23,42,.04)}
    .table-responsive{overflow-x:auto}.data-table{width:100%;border-collapse:collapse;min-width:900px}
    .data-table thead{background:#f8f9fc}
    .data-table th{padding:14px 14px;font-size:.8rem;font-weight:700;color:#6b7280;text-align:right;border-bottom:2px solid #eef2f7;white-space:nowrap}
    .data-table td{padding:12px 14px;font-size:.86rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}
    .data-table tbody tr:hover{background:#f8f7ff}
    .th-num{width:50px;text-align:center}.th-center{text-align:center}.th-actions{width:240px;text-align:center}
    .td-num{text-align:center;color:#9ca3af}.td-center{text-align:center}.td-actions{text-align:center}
    .actions-wrap{display:flex;gap:6px;justify-content:center;flex-wrap:wrap}
    .item-code{background:#f3f4f6;padding:4px 10px;border-radius:8px;font-size:.82rem;color:#1d4ed8;font-weight:600}
    .item-name{font-weight:700;color:#1f2937}
    .days-badge{background:#eff6ff;color:#2563eb;padding:4px 10px;border-radius:999px;font-size:.78rem;font-weight:700}
    .leave-status{display:inline-block;padding:5px 12px;border-radius:999px;font-size:.76rem;font-weight:800}
    .leave-status-1{background:#fef3c7;color:#d97706}.leave-status-2{background:#dbeafe;color:#2563eb}
    .leave-status-3{background:#ecfdf5;color:#059669}.leave-status-4{background:#fef2f2;color:#dc2626}
    .leave-status-5{background:#f3f4f6;color:#6b7280}
    .action-btn{display:inline-flex;align-items:center;justify-content:center;padding:6px 10px;border-radius:10px;border:1.5px solid;background:transparent;font-size:.76rem;font-weight:700;cursor:pointer;min-width:50px}
    .view-btn{color:#2563eb;border-color:#dbeafe}.view-btn:hover{background:#eff6ff}
    .approve-btn{color:#059669;border-color:#d1fae5}.approve-btn:hover{background:#ecfdf5}
    .reject-btn{color:#dc2626;border-color:#fecaca}.reject-btn:hover{background:#fef2f2}
    .btn-modern{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 18px;border-radius:14px;border:none;font-weight:700;font-size:.88rem;cursor:pointer;transition:.2s}
    .btn-modern:disabled{opacity:.6;cursor:not-allowed}
    .btn-primary-modern{background:linear-gradient(135deg,#1d4ed8,#2563eb);color:#fff}
    .btn-danger-modern{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}
    .btn-ghost{background:transparent;color:#6b7280;border:1.5px solid #e5e7eb}
    .btn-export{background:linear-gradient(135deg,#059669,#10b981);color:#fff}
    .btn-icon{font-size:1.1rem;font-weight:800}
    .btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}
    .pagination-bar{display:flex;justify-content:space-between;align-items:center;padding:16px;flex-wrap:wrap;gap:12px}
    .pagination-info{color:#6b7280;font-size:.86rem;font-weight:600}
    .pagination-actions{display:flex;gap:10px}
    .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:1000;padding:20px}
    .modal-card{background:#fff;border-radius:24px;padding:30px;max-width:460px;width:90%;text-align:center;box-shadow:0 24px 48px rgba(0,0,0,.15)}
    .modal-icon{width:64px;height:64px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:16px;font-size:1.8rem}
    .reject-modal-icon{background:#fef2f2;color:#ef4444}
    .center-buttons{justify-content:center}.modal-buttons-row{display:flex;gap:10px;margin-top:20px}
    .form-field{display:flex;flex-direction:column;gap:6px}
    .field-label{font-size:.82rem;font-weight:700;color:#374151}
    .field-input{width:100%;padding:11px 14px;border:1.5px solid #e5e7eb;border-radius:12px;background:#fff;font-size:.9rem;outline:none}
    .form-message{padding:10px 14px;border-radius:12px;font-size:.85rem;font-weight:600;margin-top:12px}
    .msg-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
    .loading-state{text-align:center;padding:60px 20px;color:#6b7280}
    .loader{width:40px;height:40px;border:3px solid #e5e7eb;border-top-color:#1d4ed8;border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 16px}
    .empty-state{text-align:center;padding:60px 20px;background:#fff;border-radius:20px;border:1px solid #eef2f7}
    .empty-icon{font-size:3rem;margin-bottom:16px}
    .no-access-card{text-align:center;padding:80px 20px;background:#fff;border-radius:24px;border:1px solid #eef2f7}
    .no-access-icon{font-size:3.5rem;margin-bottom:16px}
    .toast-container{position:fixed;bottom:24px;left:24px;z-index:1050;animation:toastIn .4s ease}
    .toast-card{display:flex;align-items:center;gap:12px;padding:14px 20px;border-radius:16px;box-shadow:0 12px 32px rgba(0,0,0,.12);min-width:320px}
    .toast-success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}
    .toast-error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
    .toast-text{flex:1;font-weight:600;font-size:.88rem}
    .toast-close{background:transparent;border:none;font-size:1rem;cursor:pointer;color:inherit;opacity:.6}
    @@keyframes spin{to{transform:rotate(360deg)}}
    @@keyframes toastIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
    @@media(max-width:768px){.page-header{flex-direction:column}.btn-modern{width:100%}.pagination-bar{flex-direction:column}}
</style>

@code {
    private ModulePermissionDto? permissions;
    private LeaveRequestFilterDto filters = new() { PageNumber = 1, PageSize = 20 };
    private LeaveRequestPagedResult pagedResult = new();
    private List<LookupDto>? departments;
    private List<LeaveTypeListDto>? leaveTypes;
    private bool isLoading = true, isExporting = false, isProcessing = false;
    private bool showRejectDialog = false;
    private LeaveRequestListDto? selectedRequest;
    private string rejectionReason = "";
    private string dialogMessage = "";
    private string resultMessage = "";
    private bool resultSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_LEAVE");
        if (permissions == null || !permissions.CanView) { isLoading = false; return; }
        departments = await LookupService.GetDepartmentsLookupAsync();
        leaveTypes = await LeaveTypeService.GetLeaveTypesListAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try { pagedResult = await LeaveRequestService.GetLeaveRequestsPagedAsync(filters); }
        catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
        finally { isLoading = false; }
    }

    private async Task SearchData() { filters.PageNumber = 1; await LoadData(); }
    private async Task ClearFilters() { filters = new() { PageNumber = 1, PageSize = 20 }; await LoadData(); }
    private async Task PreviousPage() { if (pagedResult.HasPrevious) { filters.PageNumber--; await LoadData(); } }
    private async Task NextPage() { if (pagedResult.HasNext) { filters.PageNumber++; await LoadData(); } }

    private void GoToAdd() => Navigation.NavigateTo("/leaves/new");
    private void GoToView(int id) => Navigation.NavigateTo($"/leaves/view/{id}");

    private async Task ApproveByManager(LeaveRequestListDto r)
    {
        try {
            await LeaveRequestService.ApproveByManagerAsync(r.LeaveRequestID, UserSession.UserID);
            resultMessage = "تم اعتماد المدير ✅"; resultSuccess = true;
            await LoadData();
        } catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
    }

    private async Task ApproveByHR(LeaveRequestListDto r)
    {
        try {
            await LeaveRequestService.ApproveByHRAsync(r.LeaveRequestID, UserSession.UserID);
            resultMessage = "تم اعتماد HR ✅"; resultSuccess = true;
            await LoadData();
        } catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
    }

    private void ShowRejectDialog(LeaveRequestListDto r) { selectedRequest = r; rejectionReason = ""; dialogMessage = ""; showRejectDialog = true; }
    private void CloseRejectDialog() { showRejectDialog = false; selectedRequest = null; dialogMessage = ""; }

    private async Task ConfirmReject()
    {
        if (selectedRequest == null) return;
        if (string.IsNullOrWhiteSpace(rejectionReason)) { dialogMessage = "اكتب سبب الرفض"; return; }
        isProcessing = true; dialogMessage = "";
        try {
            await LeaveRequestService.RejectLeaveRequestAsync(selectedRequest.LeaveRequestID, UserSession.UserID, rejectionReason);
            resultMessage = "تم الرفض"; resultSuccess = true;
            showRejectDialog = false; selectedRequest = null;
            await LoadData();
        } catch (Exception ex) { dialogMessage = "خطأ: " + ex.Message; }
        finally { isProcessing = false; }
    }

    private async Task ExportData()
    {
        isExporting = true;
        try {
            var exportFilter = new LeaveRequestFilterDto { SearchText = filters.SearchText, DepartmentID = filters.DepartmentID, LeaveTypeID = filters.LeaveTypeID, RequestStatus = filters.RequestStatus, DateFrom = filters.DateFrom, DateTo = filters.DateTo, PageNumber = 1, PageSize = 10000 };
            var exportResult = await LeaveRequestService.GetLeaveRequestsPagedAsync(exportFilter);
            var bytes = await LeaveRequestService.ExportLeaveRequestsToExcelAsync(exportResult.Items, UserSession.UserID);
            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", $"LeaveRequests_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", b64);
            resultMessage = "تم التصدير ✅"; resultSuccess = true;
        } catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
        finally { isExporting = false; }
    }
}