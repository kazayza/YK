@page "/cash-transfers"
@using YKCoatings.Services
@using YKCoatings.Models
@inject TreasuryService TreasuryService
@inject UserSessionService UserSession
@inject NavigationManager Navigation

<PageTitle>تحويلات خزينة - Gold Edition (فعلي)</PageTitle>

<div class="luxury-page" dir="rtl">
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-content">
            <div class="lh-right"><div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div><div class="lh-text"><h2 class="lh-title">تحويلات بين الخزائن (فعلي: CashTransfers)</h2><p class="lh-subtitle">جدول تم إنشاؤه في الباتش 02_TREASURY_PATCH_ACTUAL — Gold Edition</p></div></div>
            <div class="lh-actions"><button class="btn-luxury btn-primary-luxury" @onclick='() => Navigation.NavigateTo("/cash-transfers/new")'>تحويل جديد</button></div>
        </div>
    </div>

    @if (transfers == null){<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
    else if (!transfers.Any()){<div class="empty-luxury"><h4>لا توجد تحويلات</h4></div>}
    else
    {
        <div class="table-card-luxury"><div class="table-responsive"><table class="table-luxury">
            <thead><tr><th>#</th><th>رقم التحويل</th><th>التاريخ</th><th>من خزينة</th><th>إلى خزينة</th><th>المبلغ</th><th>الحالة</th><th>إجراءات</th></tr></thead>
            <tbody>
                @{int n=0;}
                @foreach(var t in transfers){n++;
                    <tr><td class="td-num">@n</td><td><span class="doc-num-luxury">@t.TransferNo</span></td><td class="td-muted">@t.TransferDate.ToString("dd/MM/yyyy")</td><td class="td-name">@t.FromCashBoxNameAr</td><td class="td-name">@t.ToCashBoxNameAr</td><td><span class="amount-luxury">@t.Amount.ToString("#,##0.00")</span></td><td><span class="status-badge-luxury" style="--sc:@(t.Status==1?"#6b7280":"#10b981")">@(t.StatusName ?? (t.Status==1?"مسودة":"معتمد"))</span></td><td class="td-center"><div class="actions-wrap-luxury">@if(t.Status==1){<button class="act-btn approve" @onclick="() => Approve(t.TransferID)">اعتماد</button>}</div></td></tr>
                }
            </tbody>
        </table></div></div>
    }
</div>

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1200px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,#121A2E 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain}
.lh-title{font-size:1.1rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.72rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;font-family:'Tajawal'}.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2)}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden}.table-luxury{width:100%;border-collapse:collapse;min-width:800px}.table-luxury th{padding:12px 14px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;background:#fcfaf6}.table-luxury td{padding:12px 14px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6}
.td-num{text-align:center;color:#9ca3af}.td-name{font-weight:700;color:#0A0F1E}.td-muted{color:#6b7280}.doc-num-luxury{color:var(--gold-dark);font-weight:800;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:8px}
.amount-luxury{font-family:monospace;font-weight:800;background:#f8f6f0;padding:4px 10px;border-radius:8px;border:1px solid #e8e2d0}
.status-badge-luxury{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,white)}
.actions-wrap-luxury{display:flex;gap:4px;justify-content:center}.act-btn{padding:4px 10px;border-radius:8px;border:1px solid #a7f3d0;background:#ecfdf5;color:#059669;cursor:pointer;font-weight:700}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}@@keyframes spin{to{transform:rotate(360deg)}}.empty-luxury{text-align:center;padding:60px 20px;background:#fff;border-radius:18px;border:1px solid #e8e2d0}
</style>

@code {
    private List<CashTransferListDto>? transfers;
    protected override async Task OnInitializedAsync(){ transfers = await TreasuryService.GetTransfersAsync(); }
    private async Task Approve(int id){ await TreasuryService.ApproveTransferAsync(id, UserSession.UserID); transfers = await TreasuryService.GetTransfersAsync(); }
}
