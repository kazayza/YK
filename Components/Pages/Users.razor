.table-responsive{overflow-x:auto}.table-luxury{width:100%;border-collapse:collapse;min-width:1100px}.table-luxury thead{background:linear-gradient(135deg,#fcfaf6,#f8f6f0)}.table-luxury th{padding:12px 14px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;white-space:nowrap}.table-luxury td{padding:12px 14px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}.table-luxury tbody tr:hover{background:rgba(212,175,55,.03)}.th-num{width:45px;text-align:center}.th-actions{text-align:center;width:160px}.td-num{text-align:center;color:#9ca3af;font-size:.78rem}.td-center{text-align:center}.td-muted{color:#6b7280;font-size:.82rem}
.doc-num-luxury{color:var(--gold-dark);font-weight:800;font-size:.82rem;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:8px}
.acc-cell{display:flex;align-items:center;gap:10px}.acc-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid}.acc-icon.type-1{background:#eff6ff;color:#2563eb;border-color:#dbeafe}.acc-icon svg{width:16px;height:16px}.acc-info{display:flex;flex-direction:column}.acc-name{font-weight:800;color:#0A0F1E;font-size:.86rem}.acc-name-en{font-weight:600;color:#8B95A5;font-size:.72rem}
.coa-type{font-size:.68rem;padding:3px 8px;border-radius:6px;font-weight:800;border:1px solid}.type-1{background:#eff6ff;color:#2563eb;border-color:#dbeafe}.coa-detail{font-size:.68rem;padding:3px 8px;border-radius:6px;font-weight:800;border:1px solid}
.status-badge-luxury{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,white)}.status-dot{width:6px;height:6px;border-radius:50%;background:var(--sc)}
.actions-wrap-luxury{display:flex;gap:4px;justify-content:center}.act-btn{width:30px;height:30px;border-radius:9px;border:1.5px solid;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;background:#fff;transition:.2s}.act-btn.edit{color:var(--gold-dark);border-color:rgba(212,175,55,.2)}.act-btn.add{color:#059669;border-color:#a7f3d0}.act-btn svg{width:13px;height:13px}
.user-avatar-luxury{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,#070B14,#0A0F1E);color:var(--gold);font-weight:900;font-size:.78rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid rgba(212,175,55,.2)}
.row-inactive{opacity:.6}.row-locked{background:#fef2f2 !important}
.modal-overlay-luxury{position:fixed;inset:0;background:rgba(7,11,20,.55);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:1000;padding:16px}
.modal-card-luxury{position:relative;background:#fff;border-radius:20px;width:100%;max-width:520px;overflow:hidden;box-shadow:0 24px 48px rgba(0,0,0,.2);animation:modalIn .3s ease;border:1px solid #e8e2d0}.ml-gold-line{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent)}
.ml-header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8}.ml-header h3{margin:0;font-size:.95rem;font-weight:800;color:#0A0F1E}
.btn-close-x{width:28px;height:28px;border-radius:8px;border:1px solid #e8e2d0;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.btn-close-x svg{width:12px;height:12px}
.ml-body{padding:20px}.form-grid-luxury{display:grid;grid-template-columns:1fr 1fr;gap:14px}.fg.full{grid-column:1/-1}.fg label{font-size:.78rem;font-weight:700;color:#374151;margin-bottom:6px;display:block}.fg input,.fg select{width:100%;height:40px;padding:0 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.84rem;font-family:'Tajawal';outline:none;background:#fcfaf6}
.ml-footer{display:flex;gap:8px;padding:14px 20px;border-top:1px solid #f1efe8;background:#fcfaf6;justify-content:flex-end}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}@@keyframes spin{to{transform:rotate(360deg)}}
.empty-luxury{text-align:center;padding:60px 20px;background:#fff;border-radius:18px;border:1px solid #e8e2d0}.empty-icon-luxury{width:56px;height:56px;margin:0 auto 12px;border-radius:14px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.empty-icon-luxury svg{width:28px;height:28px}.empty-sub{color:#9ca3af;font-size:.82rem;margin-top:6px}.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}
.toast-luxury{position:fixed;bottom:20px;left:20px;z-index:1050;animation:toastIn .35s ease}.toast-card-luxury{display:flex;align-items:center;gap:10px;padding:12px 18px;border-radius:14px;min-width:280px;font-weight:600;font-size:.84rem;box-shadow:0 12px 32px rgba(0,0,0,.12)}.toast-card-luxury.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.toast-card-luxury.error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.toast-card-luxury button{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-right:auto}
.switch-luxury{position:relative;display:inline-block;width:44px;height:24px}.switch-luxury input{opacity:0;width:0;height:0}.switch-luxury span{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#e5e7eb;border-radius:999px;transition:.2s}.switch-luxury span:before{position:absolute;content:"";height:18px;width:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.15)}.switch-luxury input:checked+span{background:var(--gold)}.switch-luxury input:checked+span:before{transform:translateX(20px)}
@@keyframes modalIn{from{opacity:0;transform:scale(.96) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}@@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
</style>

@code {
    private bool _authorized = false;
    private bool _loading = true;
    private string _message = "";
    private bool _isError = false;
    private string _toast = "";
    private bool _toastOk = true;
    private System.Timers.Timer? _searchTimer;
    private List<UserListDto> _users = new();
    private List<UserListDto> filteredUsers => _users.Where(u=>
        activeTab switch{
            "active"=>u.IsActive,
            "inactive"=>!u.IsActive,
            "locked"=>u.IsLocked,
            "mustchange"=>u.MustChangePassword,
            _=>true
        }).ToList();
    private List<LookupDto> _rolesLookup = new();
    private UserFilterDto _filter = new();
    private bool _showResetModal = false;
    private UserListDto? _resetUser;
    private UserPasswordDto _passwordDto = new();
    private string _resetError = "";
    private bool _resetting = false;
    private string activeTab = "all";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!UserSession.IsLoggedIn){var restored=await UserSession.TryRestoreSessionAsync(); if(!restored){Navigation.NavigateTo("/login"); return;} if(!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);}
            if (!PermissionService.CanView("SCR_USERS")){Navigation.NavigateTo("/access-denied"); return;}
            _authorized=true;
            await LoadLookups(); await LoadData(); StateHasChanged();
        }
    }

    private async Task LoadLookups(){try{_rolesLookup=await UserService.GetRolesLookupAsync();}catch{}}
    private async Task LoadData()
    {
        try{_loading=true; StateHasChanged(); _users=await UserService.GetAllAsync(_filter);}
        catch(Exception ex){ShowError("خطأ: "+ex.Message);}
        finally{_loading=false;}
    }

    private void SetTab(string tab){activeTab=tab;}
    private async Task ApplyFilters()=>await LoadData();
    private void OnSearchKeyUp(KeyboardEventArgs e){_searchTimer?.Stop(); _searchTimer?.Dispose(); _searchTimer=new System.Timers.Timer(400); _searchTimer.Elapsed+=async (s,args)=>{_searchTimer?.Stop(); await InvokeAsync(async()=>{await LoadData(); StateHasChanged();});}; _searchTimer.AutoReset=false; _searchTimer.Start();}
    private async Task ClearSearch(){_filter.SearchText=""; await LoadData();}
    private async Task ResetFilters(){_filter=new UserFilterDto(); await LoadData();}
    private void AddNew()=>Navigation.NavigateTo("/users/new");
    private void EditUser(int userId)=>Navigation.NavigateTo($"/users/edit/{userId}");
    private async Task ToggleActive(UserListDto user)
    {
        try{if(await UserService.IsDefaultAdminAsync(user.UserID)){ShowError("لا يمكن تعطيل مدير النظام الافتراضي"); return;} var newState=!user.IsActive; var result=await UserService.ToggleActiveAsync(user.UserID, newState, UserSession.CurrentUserID); if(result){user.IsActive=newState; ShowSuccess(newState ? $"تم تفعيل: {user.FullName}" : $"تم تعطيل: {user.FullName}");}}
        catch(Exception ex){ShowError(ex.Message);}
    }
    private async Task UnlockUser(UserListDto user){try{var result=await UserService.UnlockAsync(user.UserID, UserSession.CurrentUserID); if(result){user.IsLocked=false; user.FailedLoginAttempts=0; ShowSuccess($"تم فك حظر: {user.FullName}");}}catch(Exception ex){ShowError(ex.Message);}}
    private void ShowResetPassword(UserListDto user){_resetUser=user; _passwordDto=new UserPasswordDto{UserID=user.UserID, MustChangeOnLogin=true}; _resetError=""; _showResetModal=true;}
    private void CloseResetModal(){_showResetModal=false; _resetUser=null; _resetError="";}
    private async Task ConfirmResetPassword(){try{_resetting=true; _resetError=""; StateHasChanged(); await UserService.ResetPasswordAsync(_passwordDto, UserSession.CurrentUserID); _showResetModal=false; ShowSuccess($"تم إعادة تعيين كلمة المرور: {_resetUser?.FullName}"); if(_resetUser!=null) _resetUser.MustChangePassword=_passwordDto.MustChangeOnLogin;}catch(Exception ex){_resetError=ex.Message;}finally{_resetting=false;}}
    private void ShowSuccess(string msg){_message=msg; _isError=false; _toast=msg; _toastOk=true;}
    private void ShowError(string msg){_message=msg; _isError=true; _toast=msg; _toastOk=false;}
    private string GetInitials(string fullName){if(string.IsNullOrWhiteSpace(fullName)) return "U"; var parts=fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length>=2 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : parts[0][0].ToString().ToUpper();}
}
