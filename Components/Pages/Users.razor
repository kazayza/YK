@code {
    // ===== الحالة =====
    private bool _authorized = false;
    private bool _loading = true;
    private string _message = "";
    private bool _isError = false;

    // ===== البيانات =====
    private List<UserListDto> _users = new();
    private List<LookupDto> _rolesLookup = new();
    private UserFilterDto _filter = new();

    // ===== مساعدات الفلاتر =====
    private string _filterActiveText = "";
    private string _filterLockedText = "";
    private System.Timers.Timer? _searchTimer;

    // ===== Modal كلمة المرور =====
    private bool _showResetModal = false;
    private UserListDto? _resetUser;
    private UserPasswordDto _passwordDto = new();
    private string _resetError = "";
    private bool _resetting = false;

    // ══════════════════════════════════════
    // التهيئة
    // ══════════════════════════════════════
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // التحقق من تسجيل الدخول
            if (!UserSession.IsLoggedIn)
            {
                var restored = await UserSession.TryRestoreSessionAsync();
                if (!restored)
                {
                    Navigation.NavigateTo("/login");
                    return;
                }
                if (!PermissionService.IsLoaded)
                    await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            }

            // التحقق من صلاحية العرض
            if (!PermissionService.CanView("SCR_USERS"))
            {
                Navigation.NavigateTo("/access-denied");
                return;
            }

            _authorized = true;

            // تحميل البيانات
            await LoadLookups();
            await LoadData();

            StateHasChanged();
        }
    }

    // ══════════════════════════════════════
    // تحميل البيانات
    // ══════════════════════════════════════
    private async Task LoadLookups()
    {
        try
        {
            _rolesLookup = await UserService.GetRolesLookupAsync();
        }
        catch { }
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            // تحويل الفلاتر النصية إلى bool
            _filter.IsActive = string.IsNullOrEmpty(_filterActiveText) ? null : bool.Parse(_filterActiveText);
            _filter.IsLocked = string.IsNullOrEmpty(_filterLockedText) ? null : bool.Parse(_filterLockedText);

            _users = await UserService.GetAllAsync(_filter);
        }
        catch (Exception ex)
        {
            ShowError("خطأ في تحميل البيانات: " + ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    // ══════════════════════════════════════
    // الفلاتر والبحث
    // ══════════════════════════════════════
    private async Task ApplyFilters()
    {
        await LoadData();
    }

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _searchTimer?.Stop();
        _searchTimer?.Dispose();
        _searchTimer = new System.Timers.Timer(400);
        _searchTimer.Elapsed += async (s, args) =>
        {
            _searchTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await LoadData();
                StateHasChanged();
            });
        };
        _searchTimer.AutoReset = false;
        _searchTimer.Start();
    }

    private async Task ClearSearch()
    {
        _filter.SearchText = "";
        await LoadData();
    }

    private async Task ResetFilters()
    {
        _filter = new UserFilterDto();
        _filterActiveText = "";
        _filterLockedText = "";
        await LoadData();
    }

    // ══════════════════════════════════════
    // التنقل
    // ══════════════════════════════════════
    private void AddNew()
    {
        Navigation.NavigateTo("/users/new");
    }

    private void EditUser(int userId)
    {
        Navigation.NavigateTo($"/users/edit/{userId}");
    }

    // ══════════════════════════════════════
    // تفعيل / تعطيل
    // ══════════════════════════════════════
    private async Task ToggleActive(UserListDto user)
    {
        try
        {
            // حماية حساب الأدمن الافتراضي
            if (await UserService.IsDefaultAdminAsync(user.UserID))
            {
                ShowError("لا يمكن تعطيل حساب مدير النظام الافتراضي");
                return;
            }

            var newState = !user.IsActive;
            var result = await UserService.ToggleActiveAsync(user.UserID, newState, UserSession.CurrentUserID);

            if (result)
            {
                user.IsActive = newState;
                ShowSuccess(newState ? $"تم تفعيل المستخدم: {user.FullName}" : $"تم تعطيل المستخدم: {user.FullName}");
            }
        }
        catch (Exception ex)
        {
            ShowError("خطأ: " + ex.Message);
        }
    }

    // ══════════════════════════════════════
    // فك الحظر
    // ══════════════════════════════════════
    private async Task UnlockUser(UserListDto user)
    {
        try
        {
            var result = await UserService.UnlockAsync(user.UserID, UserSession.CurrentUserID);
            if (result)
            {
                user.IsLocked = false;
                user.FailedLoginAttempts = 0;
                ShowSuccess($"تم فك حظر المستخدم: {user.FullName}");
            }
        }
        catch (Exception ex)
        {
            ShowError("خطأ: " + ex.Message);
        }
    }

    // ══════════════════════════════════════
    // إعادة تعيين كلمة المرور
    // ══════════════════════════════════════
    private void ShowResetPassword(UserListDto user)
    {
        _resetUser = user;
        _passwordDto = new UserPasswordDto { UserID = user.UserID, MustChangeOnLogin = true };
        _resetError = "";
        _showResetModal = true;
    }

    private void CloseResetModal()
    {
        _showResetModal = false;
        _resetUser = null;
        _resetError = "";
    }

    private async Task ConfirmResetPassword()
    {
        try
        {
            _resetting = true;
            _resetError = "";
            StateHasChanged();

            await UserService.ResetPasswordAsync(_passwordDto, UserSession.CurrentUserID);

            _showResetModal = false;
            ShowSuccess($"تم إعادة تعيين كلمة المرور للمستخدم: {_resetUser?.FullName}");

            // تحديث حالة MustChangePassword في القائمة
            if (_resetUser != null)
                _resetUser.MustChangePassword = _passwordDto.MustChangeOnLogin;
        }
        catch (Exception ex)
        {
            _resetError = ex.Message;
        }
        finally
        {
            _resetting = false;
        }
    }

    // ══════════════════════════════════════
    // التصدير
    // ══════════════════════════════════════
    private void ExportData()
    {
        // سيتم التنفيذ لاحقاً
        ShowSuccess("جاري تجهيز التصدير...");
    }

    // ══════════════════════════════════════
    // الرسائل
    // ══════════════════════════════════════
    private void ShowSuccess(string msg) { _message = msg; _isError = false; }
    private void ShowError(string msg) { _message = msg; _isError = true; }

    // ══════════════════════════════════════
    // مساعدات
    // ══════════════════════════════════════
    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "U";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : parts[0][0].ToString().ToUpper();
    }
}