@page "/users"
@using YKCoatings.Models
@using YKCoatings.Services
@inject UserService UserService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation

<!-- ===== التحقق من الصلاحية ===== -->
@if (!_authorized)
{
    <div></div>
}
else
{
    <!-- ===== شريط العنوان والأزرار ===== -->
    <div class="page-header">
        <div class="page-header-right">
            <h2 class="page-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="title-icon">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                إدارة المستخدمين
            </h2>
            <span class="record-count">@_users.Count مستخدم</span>
        </div>
        <div class="page-header-left">
            @if (PermissionService.CanExport("SCR_USERS"))
            {
                <button class="btn-action btn-export" @onclick="ExportData" title="تصدير">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    <span>تصدير</span>
                </button>
            }
            @if (PermissionService.CanAdd("SCR_USERS"))
            {
                <button class="btn-action btn-add" @onclick="AddNew" title="إضافة مستخدم">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    <span>مستخدم جديد</span>
                </button>
            }
        </div>
    </div>

    <!-- ===== الفلاتر ===== -->
    <div class="filters-card">
        <div class="filters-grid">

            <!-- بحث عام -->
            <div class="filter-group filter-search">
                <label class="filter-label">بحث</label>
                <div class="input-icon-wrap">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="input-icon">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="M21 21l-4.35-4.35"/>
                    </svg>
                    <input type="text"
                           class="filter-input"
                           placeholder="اسم المستخدم، الاسم، البريد، الهاتف..."
                           @bind="_filter.SearchText"
                           @bind:event="oninput"
                           @onkeyup="OnSearchKeyUp" />
                    @if (!string.IsNullOrWhiteSpace(_filter.SearchText))
                    {
                        <button class="input-clear" @onclick="ClearSearch" title="مسح">✕</button>
                    }
                </div>
            </div>

            <!-- فلتر الدور -->
            <div class="filter-group">
                <label class="filter-label">الدور</label>
                <select class="filter-input" @bind="_filter.RoleID" @bind:after="ApplyFilters">
                    <option value="">— الكل —</option>
                    @foreach (var role in _rolesLookup)
                    {
                        <option value="@role.Id">@role.Name</option>
                    }
                </select>
            </div>

            <!-- فلتر الحالة -->
            <div class="filter-group">
                <label class="filter-label">الحالة</label>
                <select class="filter-input" @bind="_filterActiveText" @bind:after="ApplyFilters">
                    <option value="">— الكل —</option>
                    <option value="true">نشط</option>
                    <option value="false">غير نشط</option>
                </select>
            </div>

            <!-- فلتر الحظر -->
            <div class="filter-group">
                <label class="filter-label">الحظر</label>
                <select class="filter-input" @bind="_filterLockedText" @bind:after="ApplyFilters">
                    <option value="">— الكل —</option>
                    <option value="true">محظور</option>
                    <option value="false">غير محظور</option>
                </select>
            </div>

            <!-- زر إعادة تعيين -->
            <div class="filter-group filter-actions">
                <label class="filter-label">&nbsp;</label>
                <button class="btn-filter-reset" @onclick="ResetFilters" title="إعادة تعيين الفلاتر">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                        <path d="M3 3v5h5"/>
                    </svg>
                    <span>إعادة تعيين</span>
                </button>
            </div>

        </div>
    </div>

        <!-- ===== رسالة النجاح/الخطأ ===== -->
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert-msg @(_isError ? "alert-error" : "alert-success")">
            <span>@_message</span>
            <button class="alert-close" @onclick="@(() => _message = "")">✕</button>
        </div>
    }

    <!-- ===== حالة التحميل ===== -->
    @if (_loading)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <span>جاري تحميل البيانات...</span>
        </div>
    }
    else if (!_users.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <line x1="17" y1="11" x2="23" y2="11"/>
                </svg>
            </div>
            <h3>لا يوجد مستخدمين</h3>
            <p>لا توجد نتائج مطابقة للبحث الحالي</p>
        </div>
    }
    else
    {
        <!-- ===== الجدول ===== -->
        <div class="table-card">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="th-narrow">#</th>
                            <th>اسم المستخدم</th>
                            <th>الاسم الكامل</th>
                            <th>الدور</th>
                            <th>الموظف المرتبط</th>
                            <th class="th-center">الحالة</th>
                            <th class="th-center">الحظر</th>
                            <th>آخر دخول</th>
                            <th class="th-center">العمليات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 0; }
                        @foreach (var user in _users)
                        {
                            rowNum++;
                            <tr class="@(!user.IsActive ? "row-inactive" : "") @(user.IsLocked ? "row-locked" : "")">

                                <!-- الرقم -->
                                <td class="td-narrow">@rowNum</td>

                                <!-- اسم المستخدم -->
                                <td>
                                    <div class="user-cell">
                                        <div class="user-avatar" title="@user.FullName">
                                            @GetInitials(user.FullName)
                                        </div>
                                        <div class="user-info">
                                            <span class="user-username">@user.Username</span>
                                            @if (!string.IsNullOrEmpty(user.Email))
                                            {
                                                <span class="user-email">@user.Email</span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <!-- الاسم الكامل -->
                                <td>
                                    <span class="cell-main">@user.FullName</span>
                                    @if (!string.IsNullOrEmpty(user.Phone))
                                    {
                                        <span class="cell-sub">@user.Phone</span>
                                    }
                                </td>

                                <!-- الدور -->
                                <td>
                                    <span class="badge badge-role">@user.RoleNameAr</span>
                                </td>

                                <!-- الموظف المرتبط -->
                                <td>
                                    @if (!string.IsNullOrEmpty(user.EmployeeName))
                                    {
                                        <span class="cell-main">@user.EmployeeName</span>
                                        <span class="cell-sub">@user.EmployeeCode</span>
                                    }
                                    else
                                    {
                                        <span class="cell-empty">—</span>
                                    }
                                </td>

                                <!-- الحالة -->
                                <td class="td-center">
                                    @if (user.IsActive)
                                    {
                                        <span class="badge badge-active">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-inactive">غير نشط</span>
                                    }
                                </td>

                                <!-- الحظر -->
                                <td class="td-center">
                                    @if (user.IsLocked)
                                    {
                                        <span class="badge badge-locked">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="badge-icon">
                                                <rect x="3" y="11" width="18" height="11" rx="2"/>
                                                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                                            </svg>
                                            محظور
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-unlocked">مفتوح</span>
                                    }
                                    @if (user.MustChangePassword)
                                    {
                                        <span class="badge badge-warn" title="يجب تغيير كلمة المرور">⚠️</span>
                                    }
                                </td>

                                <!-- آخر دخول -->
                                <td>
                                    @if (user.LastLoginDate.HasValue)
                                    {
                                        <span class="cell-main">@user.LastLoginDate.Value.ToString("dd/MM/yyyy")</span>
                                        <span class="cell-sub">@user.LastLoginDate.Value.ToString("hh:mm tt")</span>
                                    }
                                    else
                                    {
                                        <span class="cell-empty">لم يسجل دخول</span>
                                    }
                                </td>

                                <!-- العمليات -->
                                <td class="td-center">
                                    <div class="action-btns">

                                        @if (PermissionService.CanEdit("SCR_USERS"))
                                        {
                                            <button class="btn-icon btn-edit"
                                                    @onclick="@(() => EditUser(user.UserID))"
                                                    title="تعديل">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                                </svg>
                                            </button>
                                        }

                                        @if (PermissionService.CanEdit("SCR_USERS"))
                                        {
                                            <button class="btn-icon @(user.IsActive ? "btn-deactivate" : "btn-activate")"
                                                    @onclick="@(() => ToggleActive(user))"
                                                    title="@(user.IsActive ? "تعطيل" : "تفعيل")">
                                                @if (user.IsActive)
                                                {
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <circle cx="12" cy="12" r="10"/>
                                                        <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
                                                    </svg>
                                                }
                                                else
                                                {
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                                        <polyline points="22 4 12 14.01 9 11.01"/>
                                                    </svg>
                                                }
                                            </button>
                                        }

                                        @if (user.IsLocked && PermissionService.CanEdit("SCR_USERS"))
                                        {
                                            <button class="btn-icon btn-unlock"
                                                    @onclick="@(() => UnlockUser(user))"
                                                    title="فك الحظر">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                                                    <path d="M7 11V7a5 5 0 0 1 9.9-1"/>
                                                </svg>
                                            </button>
                                        }

                                        @if (PermissionService.CanEdit("SCR_USERS"))
                                        {
                                            <button class="btn-icon btn-reset-pwd"
                                                    @onclick="@(() => ShowResetPassword(user))"
                                                    title="إعادة تعيين كلمة المرور">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                                                </svg>
                                            </button>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ===== Modal إعادة تعيين كلمة المرور ===== -->
    @if (_showResetModal)
    {
        <div class="modal-overlay" @onclick="CloseResetModal">
            <div class="modal-box" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h3 class="modal-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="modal-title-icon">
                            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
                        </svg>
                        إعادة تعيين كلمة المرور
                    </h3>
                    <button class="modal-close" @onclick="CloseResetModal">✕</button>
                </div>
                <div class="modal-body">
                    <p class="modal-info">إعادة تعيين كلمة المرور للمستخدم: <strong>@_resetUser?.FullName</strong></p>

                    <div class="form-group">
                        <label class="form-label">كلمة المرور الجديدة <span class="required">*</span></label>
                        <input type="password" class="form-input" @bind="_passwordDto.NewPassword"
                               placeholder="أدخل كلمة المرور الجديدة (6 أحرف على الأقل)" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">تأكيد كلمة المرور <span class="required">*</span></label>
                        <input type="password" class="form-input" @bind="_passwordDto.ConfirmPassword"
                               placeholder="أعد إدخال كلمة المرور" />
                    </div>

                    <div class="form-group-check">
                        <label class="check-label">
                            <input type="checkbox" @bind="_passwordDto.MustChangeOnLogin" />
                            <span>يجب تغيير كلمة المرور عند الدخول التالي</span>
                        </label>
                    </div>

                    @if (!string.IsNullOrEmpty(_resetError))
                    {
                        <div class="alert-msg alert-error" style="margin-top:12px">
                            <span>@_resetError</span>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn-modal btn-cancel" @onclick="CloseResetModal">إلغاء</button>
                    <button class="btn-modal btn-save" @onclick="ConfirmResetPassword" disabled="@_resetting">
                        @if (_resetting)
                        {
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <span>تأكيد</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }

} <!-- نهاية else الخاص بـ _authorized -->
<style>
    /* ===== Page Header ===== */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .page-header-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .page-header-left {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .page-title {
        font-size: 1.3rem;
        font-weight: 800;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
    }
    .title-icon {
        width: 28px;
        height: 28px;
        color: #2563eb;
    }
    .record-count {
        background: #f1f5f9;
        color: #64748b;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: .78rem;
        font-weight: 700;
    }

    /* ===== Action Buttons ===== */
    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 18px;
        border: none;
        border-radius: 10px;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s ease;
    }
    .btn-action svg { width: 16px; height: 16px; }
    .btn-add {
        background: linear-gradient(135deg, #2563eb, #2563eb);
        color: white;
        box-shadow: 0 4px 12px rgba(37,99,235,.3);
    }
    .btn-add:hover { transform: translateY(-1px); box-shadow: 0 6px 16px rgba(37,99,235,.4); }
    .btn-export {
        background: #f1f5f9;
        color: #475569;
        border: 1px solid #e2e8f0;
    }
    .btn-export:hover { background: #e2e8f0; }

    /* ===== Filters ===== */
    .filters-card {
        background: white;
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(15,23,42,.06);
        border: 1px solid #e2e8f0;
    }
    .filters-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr auto;
        gap: 14px;
        align-items: end;
    }
    .filter-group { display: flex; flex-direction: column; gap: 6px; }
    .filter-label { font-size: .86rem; font-weight: 700; color: #475569; }
    .filter-input {
        height: 42px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 0 14px;
        font-size: .88rem;
        background: #f8fafc;
        transition: all .2s;
        width: 100%;
    }
    .filter-input:focus { border-color: #2563eb; background: white; outline: none; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
    .input-icon-wrap { position: relative; }
    .input-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        width: 16px;
        height: 16px;
        color: #94a3b8;
        pointer-events: none;
    }
    .input-icon-wrap .filter-input { padding-right: 38px; }
    .input-clear {
        position: absolute;
        left: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: #e2e8f0;
        border: none;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        font-size: .7rem;
        color: #64748b;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .btn-filter-reset {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 42px;
        padding: 0 16px;
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        border-radius: 10px;
        font-size: .8rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s;
        white-space: nowrap;
    }
    .btn-filter-reset:hover { background: #fee2e2; }
    .btn-filter-reset svg { width: 15px; height: 15px; }

    /* ===== Alert Messages ===== */
    .alert-msg {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 18px;
        border-radius: 10px;
        margin-bottom: 16px;
        font-size: .85rem;
        font-weight: 600;
    }
    .alert-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
    .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    .alert-close {
        background: none;
        border: none;
        font-size: .9rem;
        cursor: pointer;
        color: inherit;
        opacity: .6;
    }

    /* ===== Loading ===== */
    .loading-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 80px 20px;
        color: #64748b;
        gap: 16px;
        font-size: .9rem;
    }
    .loading-spinner {
        width: 40px;
        height: 40px;
        border: 3px solid #e2e8f0;
        border-top-color: #2563eb;
        border-radius: 50%;
        animation: spin .8s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ===== Empty State ===== */
    .empty-state {
        text-align: center;
        padding: 80px 20px;
        color: #94a3b8;
    }
    .empty-icon { margin-bottom: 16px; }
    .empty-icon svg { width: 64px; height: 64px; opacity: .4; }
    .empty-state h3 { font-size: 1.1rem; color: #475569; margin-bottom: 8px; }
    .empty-state p { font-size: .85rem; }

    /* ===== Table ===== */
    .table-card {
        background: white;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(15,23,42,.06);
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }
    .table-responsive { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table thead { background: #f8fafc; border-bottom: 2px solid #e2e8f0; }
    .data-table th {
        padding: 14px 16px;
        font-size: .86rem;
        font-weight: 800;
        color: #475569;
        text-align: right;
        white-space: nowrap;
    }
    .data-table td {
        padding: 12px 16px;
        font-size: .88rem;
        color: #334155;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .data-table tbody tr:hover { background: #f8fafc; }
    .th-narrow, .td-narrow { width: 50px; text-align: center; }
    .th-center, .td-center { text-align: center; }
    .row-inactive { opacity: .6; }
    .row-locked { background: #fef2f2 !important; }

    /* ===== User Cell ===== */
    .user-cell { display: flex; align-items: center; gap: 10px; }
    .user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: linear-gradient(135deg, #2563eb, #6366f1);
        color: white;
        font-weight: 800;
        font-size: .75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .user-info { display: flex; flex-direction: column; }
    .user-username { font-weight: 700; color: #0f172a; font-size: .88rem; }
    .user-email { font-size: .8rem; color: #94a3b8; margin-top: 2px; }

    /* ===== Cell Helpers ===== */
    .cell-main { display: block; font-weight: 600; }
    .cell-sub { display: block; font-size: .78rem; color: #94a3b8; margin-top: 2px; }
    .cell-empty { color: #cbd5e1; font-size: .8rem; }

    /* ===== Badges ===== */
    .badge {
        display: inline-flex;
        align-items: center;
