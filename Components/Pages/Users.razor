@page "/users"
@using YKCoatings.Models
@using YKCoatings.Services
@inject UserService UserService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>المستخدمين - Gold Edition Tabs</PageTitle>

@if (!_authorized)
{<div class="no-access-luxury" dir="rtl"><h4>يجب تسجيل الدخول</h4></div>}
else
{
<div class="luxury-page full-width" dir="rtl">
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
        <div class="lh-content">
            <div class="lh-right">
                <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                <div class="lh-text">
                    <h2 class="lh-title">إدارة المستخدمين — نظام التابات</h2>
                    <p class="lh-subtitle">Gold Edition Tabs — User → Role → Permissions workflow — نفس نظام الموردين والعملاء — استغلال كامل عرض الشاشة</p>
                </div>
            </div>
            <div class="lh-actions">
                <span class="lh-badge"><span class="lh-dot"></span>@_users.Count مستخدم</span>
                <span class="lh-badge" style="background:rgba(16,185,129,.1);color:#059669;border-color:rgba(16,185,129,.15)">نشط: @_users.Count(u=>u.IsActive)</span>
                <span class="lh-badge" style="background:rgba(239,68,68,.08);color:#dc2626;border-color:rgba(239,68,68,.15)">محظور: @_users.Count(u=>u.IsLocked)</span>
                @if (PermissionService.CanAdd("SCR_USERS")){
                    <button class="btn-luxury btn-primary-luxury" @onclick="AddNew"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>مستخدم جديد</button>
                }
            </div>
        </div>
    </div>

    <div class="stats-luxury">
        <div class="stat-luxury"><div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div><div class="st-info"><span class="st-value">@_users.Count</span><span class="st-label">إجمالي المستخدمين</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg></div><div class="st-info"><span class="st-value">@_users.Count(u=>u.IsActive)</span><span class="st-label">نشط</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><div class="st-info"><span class="st-value">@_users.Count(u=>u.IsLocked)</span><span class="st-label">محظور</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><div class="st-info"><span class="st-value">@_users.Count(u=>u.MustChangePassword)</span><span class="st-label">يجب تغيير كلمة المرور</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><div class="st-info"><span class="st-value">@_users.Count(u=>u.LastLoginDate!=null && u.LastLoginDate.Value.Date==DateTime.Today)</span><span class="st-label">دخول اليوم</span></div><div class="st-gold-line"></div></div>
    </div>

    <div class="filter-luxury">
        <div class="search-luxury" style="flex:1;min-width:280px">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="text" placeholder="بحث باسم المستخدم، الاسم الكامل، البريد، الهاتف..." @bind="_filter.SearchText" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
            @if(!string.IsNullOrWhiteSpace(_filter.SearchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}
        </div>
        <div class="select-wrap-luxury"><select @bind="_filter.RoleID" @bind:after="ApplyFilters"><option value="">كل الأدوار</option>@foreach(var role in _rolesLookup){<option value="@role.Id">@role.Name</option>}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
        <button class="btn-luxury btn-ghost-luxury" @onclick="ResetFilters"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>إعادة تعيين</button>
    </div>

    <div class="mudtabs-luxury">
        <div class="mudtabs-header-luxury">
            <button class="mudtab-btn-luxury @(activeTab=="all"?"active":"")" @onclick='()=>SetTab("all")'>
                <span class="mt-icon" style="background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>
                الكل <span class="mt-count">@_users.Count</span>
            </button>
            <button class="mudtab-btn-luxury @(activeTab=="active"?"active":"")" @onclick='()=>SetTab("active")'>
                <span class="mt-icon" style="background:#ecfdf5;color:#059669;border:1px solid #a7f3d0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg></span>
                نشط <span class="mt-count">@_users.Count(u=>u.IsActive)</span>
            </button>
            <button class="mudtab-btn-luxury @(activeTab=="locked"?"active":"")" @onclick='()=>SetTab("locked")'>
                <span class="mt-icon" style="background:#fef2f2;color:#ef4444;border:1px solid #fecaca"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                محظور <span class="mt-count">@_users.Count(u=>u.IsLocked)</span>
            </button>
            <button class="mudtab-btn-luxury @(activeTab=="mustchange"?"active":"")" @onclick='()=>SetTab("mustchange")'>
                <span class="mt-icon" style="background:rgba(212,175,55,.1);color:#9C7C2E;border:1px solid rgba(212,175,55,.2)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
                يجب تغيير <span class="mt-count gold">@_users.Count(u=>u.MustChangePassword)</span>
            </button>
            <button class="mudtab-btn-luxury @(activeTab=="inactive"?"active":"")" @onclick='()=>SetTab("inactive")'>
                <span class="mt-icon" style="background:#f3f4f6;color:#9ca3af;border:1px solid #e5e7eb"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg></span>
                غير نشط <span class="mt-count">@_users.Count(u=>!u.IsActive)</span>
            </button>
        </div>
        <div class="mudtabs-body-luxury">
            @if (!string.IsNullOrEmpty(_message))
            {<div class="msg-luxury @( _isError ? "msg-error" : "msg-success")" style="margin-bottom:12px">@_message <button @onclick='()=>_message=""' style="margin-right:auto;background:none;border:none;cursor:pointer">✕</button></div>}

            @if (_loading)
            {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل المستخدمين...</p></div>}
            else if (!filteredUsers.Any())
            {<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><h4>لا يوجد مستخدمين</h4><p class="empty-sub">لا توجد نتائج مطابقة</p></div>}
            else
            {
                <div class="table-card-luxury full">
                    <div class="card-head-luxury"><h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>المستخدمين — جدول فاخر واسع كامل العرض — @filteredUsers.Count مستخدم</h3></div>
                    <div class="table-responsive">
                        <table class="table-luxury detailed">
                            <thead><tr><th class="th-num">#</th><th>المستخدم</th><th>الاسم الكامل</th><th>الدور</th><th>الموظف</th><th>الحالة</th><th>الحظر</th><th>آخر دخول</th><th>سجل</th><th class="th-actions">إجراءات</th></tr></thead>
                            <tbody>
                                @{int rowNum=0;}
                                @foreach(var user in filteredUsers){rowNum++;
                                    <tr class="@(!user.IsActive ? "row-inactive" : "") @(user.IsLocked ? "row-locked" : "")">
                                        <td class="td-num">@rowNum</td>
                                        <td><div class="acc-cell"><div class="user-avatar-luxury">@GetInitials(user.FullName)</div><div class="acc-info"><span class="acc-name">@user.Username</span><span class="acc-name-en">@user.Email</span></div></div></td>
                                        <td><div class="acc-cell"><div class="acc-icon type-1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div><div class="acc-info"><span class="acc-name">@user.FullName</span><span class="acc-name-en">@user.Phone</span></div></div></td>
                                        <td><span class="coa-type type-1">@user.RoleNameAr</span></td>
                                        <td class="td-muted">@if(!string.IsNullOrEmpty(user.EmployeeName)){<span>@user.EmployeeName</span>}else{<span>—</span>}</td>
                                        <td>@if(user.IsActive){<span class="status-badge-luxury" style="--sc:#10b981"><span class="status-dot" style="--sc:#10b981"></span>نشط</span>}else{<span class="status-badge-luxury" style="--sc:#6b7280"><span class="status-dot" style="--sc:#6b7280"></span>غير نشط</span>}</td>
                                        <td class="td-center">@if(user.IsLocked){<span class="status-badge-luxury" style="--sc:#ef4444"><span class="status-dot" style="--sc:#ef4444"></span>محظور</span>}else{<span class="status-badge-luxury" style="--sc:#10b981"><span class="status-dot" style="--sc:#10b981"></span>مفتوح</span>} @if(user.MustChangePassword){<span class="coa-detail" style="background:#fff7ed;color:#ea580c;border-color:#fed7aa">⚠️</span>}</td>
                                        <td class="td-muted">@if(user.LastLoginDate.HasValue){<span>@user.LastLoginDate.Value.ToString("dd/MM/yyyy")</span>}else{<span>لم يسجل</span>}</td>
                                        <td class="td-center"><button class="btn-luxury btn-ghost-luxury" style="padding:6px 10px;font-size:.72rem" @onclick='()=>Navigation.NavigateTo($"/login-history?user={user.Username}")'>سجل</button></td>
                                        <td class="td-center"><div class="actions-wrap-luxury">
                                            @if(PermissionService.CanEdit("SCR_USERS")){<button class="act-btn edit" title="تعديل" @onclick="()=>EditUser(user.UserID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                            @if(PermissionService.CanEdit("SCR_USERS")){<button class="act-btn @(user.IsActive ? "add" : "edit")" title="@(user.IsActive ? "تعطيل" : "تفعيل")" @onclick="()=>ToggleActive(user)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">@if(user.IsActive){<circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>}else{<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/>}</svg></button>}
                                            @if(user.IsLocked && PermissionService.CanEdit("SCR_USERS")){<button class="act-btn" style="color:#2563eb;border-color:#bfdbfe" title="فك الحظر" @onclick="()=>UnlockUser(user)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 9.9-1"/></svg></button>}
                                            @if(PermissionService.CanEdit("SCR_USERS")){<button class="act-btn" style="color:#ec4899;border-color:#f9a8d4" title="إعادة تعيين كلمة المرور" @onclick="()=>ShowResetPassword(user)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg></button>}
                                        </div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (_showResetModal)
{
    <div class="modal-overlay-luxury" @onclick="CloseResetModal"><div class="modal-card-luxury" @onclick:stopPropagation="true">
        <div class="ml-gold-line"></div>
        <div class="ml-header"><h3>إعادة تعيين كلمة المرور — @_resetUser?.FullName</h3><button class="btn-close-x" @onclick="CloseResetModal"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
        <div class="ml-body">
            <div class="form-grid-luxury"><div class="fg full"><label>كلمة المرور الجديدة *</label><input type="password" @bind="_passwordDto.NewPassword" placeholder="6 أحرف على الأقل" /></div><div class="fg full"><label>تأكيد كلمة المرور *</label><input type="password" @bind="_passwordDto.ConfirmPassword" placeholder="أعد الإدخال" /></div><div class="fg full"><label class="switch-luxury"><input type="checkbox" @bind="_passwordDto.MustChangeOnLogin" /><span></span></label><span style="margin-right:8px;font-size:.82rem;font-weight:600">يجب تغيير كلمة المرور عند الدخول التالي</span></div></div>
            @if(!string.IsNullOrEmpty(_resetError)){<div class="msg-luxury msg-error" style="margin-top:12px">@_resetError</div>}
        </div>
        <div class="ml-footer"><button class="btn-luxury btn-primary-luxury" @onclick="ConfirmResetPassword" disabled="@_resetting">@(_resetting ? "جاري الحفظ..." : "تأكيد")</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseResetModal">إلغاء</button></div>
    </div></div>
}
@if (!string.IsNullOrEmpty(_toast)){<div class="toast-luxury"><div class="toast-card-luxury @(_toastOk?"success":"error")"><span>@_toast</span><button @onclick='()=>_toast=""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;margin:0 auto}.luxury-page.full-width{max-width:100%;width:100%}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.15rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.7rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-luxury svg{width:14px;height:14px}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
.st-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.st-icon.dark{background:linear-gradient(135deg,var(--black2),var(--black3));color:var(--gold);border:1px solid var(--border-gold)}.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.2)}.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.st-icon.red{background:#fef2f2;color:#ef4444;border:1px solid #fecaca}.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.st-icon svg{width:18px;height:18px}.st-info{display:flex;flex-direction:column}.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}.st-gold-line{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}.stat-luxury:hover .st-gold-line{opacity:.8}
.filter-luxury{display:flex;gap:10px;flex-wrap:wrap;align-items:center;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:12px}
.search-luxury{flex:1;min-width:280px;position:relative;display:flex;align-items:center}.search-luxury svg{position:absolute;right:12px;width:16px;height:16px;color:#9ca3af;pointer-events:none}.search-luxury input{width:100%;height:42px;padding:0 40px 0 36px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.86rem;font-family:'Tajawal';outline:none;background:#fcfaf6;transition:.2s}.search-luxury input:focus{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.clear-search-luxury{position:absolute;left:8px;width:26px;height:26px;border-radius:50%;border:none;background:#f3f4f6;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.clear-search-luxury svg{width:10px;height:10px}
.select-wrap-luxury{position:relative;display:flex;align-items:center}.select-wrap-luxury select{height:42px;padding:0 28px 0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.82rem;font-family:'Tajawal';background:#fff;appearance:none;cursor:pointer;outline:none;min-width:120px}.select-wrap-luxury .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.mudtabs-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}
.mudtabs-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5;z-index:2}
.mudtabs-header-luxury{position:relative;display:flex;gap:0;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #e8e2d0;padding:0 8px;overflow-x:auto;scrollbar-width:none}.mudtabs-header-luxury::-webkit-scrollbar{display:none}
