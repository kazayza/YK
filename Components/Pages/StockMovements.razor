@page "/stock-movements"
@page "/stock-movements/{ItemIdParam:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject InventoryService InvService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>حركات المخزون - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div>}
else
{
    <div class="luxury-page" dir="rtl">
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">@(selectedItemId > 0 ? "كارت صنف" : "حركات المخزون")</h2><p class="lh-subtitle">@(selectedItemId > 0 ? "جميع حركات الصنف — كارت تفصيلي" : "متابعة حركات الدخول والخروج لحظياً")</p></div>
                </div>
                <div class="lh-actions">
                    <span class="lh-badge"><span class="lh-dot"></span>@filtered.Count حركة</span>
                    @if (permissions.CanExport){<button class="btn-luxury btn-export-luxury" @onclick="ExportExcel" disabled="@isExporting">@if(isExporting){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>}Excel</button>}
                    @if (selectedItemId > 0){<button class="btn-luxury btn-ghost-luxury" @onclick="ClearItemFilter"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>عرض الكل</button>}
                </div>
            </div>
        </div>

        <div class="filter-luxury">
            <div class="search-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input type="text" placeholder="بحث بالصنف أو المستند..." @bind="searchText" @bind:event="oninput" @onkeyup="FilterLocal" />@if (!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}</div>
            <div class="select-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/></svg><select @bind="filterWarehouse" @bind:after="LoadMovements"><option value="0">كل المخازن</option>@if(warehouses!=null){@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg><select @bind="filterType" @bind:after="LoadMovements"><option value="0">كل الأنواع</option><option value="1">استلام مشتريات</option><option value="2">صرف للإنتاج</option><option value="3">استلام إنتاج</option><option value="4">صرف للبيع</option><option value="5">مرتجع مشتريات</option><option value="6">مرتجع مبيعات</option><option value="7">تحويل صادر</option><option value="8">تحويل وارد</option><option value="9">تسوية زيادة</option><option value="10">تسوية نقص</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <input type="date" class="date-input-luxury" @bind="filterFrom" @bind:after="LoadMovements" />
            <input type="date" class="date-input-luxury" @bind="filterTo" @bind:after="LoadMovements" />
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadMovements"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        @if(movements==null){<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else if(!filtered.Any()){<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><h4>لا توجد حركات</h4></div>}
        else
        {
            <div class="table-card-luxury">
                <div class="table-responsive">
                    <table class="table-luxury">
                        <thead><tr><th class="th-num">#</th><th>التاريخ</th><th>النوع</th><th class="th-center">الاتجاه</th><th>الكود</th><th>الصنف</th><th>المخزن</th><th class="th-center">الكمية</th><th>التكلفة</th><th class="th-center">قبل</th><th class="th-center">بعد</th><th>المستند</th><th>الباتش</th></tr></thead>
                        <tbody>
                            @{int n=0;}
                            @foreach(var m in filtered){n++;
                            <tr class="@(m.Quantity>0?"row-in":"row-out")">
                                <td class="td-num">@n</td>
                                <td class="td-muted">@m.TransactionDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td><span class="type-tag-luxury" style="--tc:@(m.Quantity>0?"#059669":"#dc2626")">@m.TransactionTypeName</span></td>
                                <td class="td-center"><span class="dir-badge-luxury @(m.Quantity>0?"in":"out")">@m.Direction</span></td>
                                <td><code class="code-tag-luxury">@m.ItemCode</code></td>
                                <td class="td-name">@m.ItemNameAr</td>
                                <td class="td-muted">@m.WarehouseNameAr</td>
                                <td class="td-center"><strong class="qty-luxury @(m.Quantity>0?"in":"out")">@m.AbsQuantity.ToString("#,##0.##")</strong></td>
                                <td><span class="amount-luxury">@m.TotalCost.ToString("#,##0.00")</span></td>
                                <td class="td-center td-muted">@m.BalanceBefore.ToString("#,##0.##")</td>
                                <td class="td-center"><strong>@m.BalanceAfter.ToString("#,##0.##")</strong></td>
                                <td class="td-muted">@(m.SourceDocNumber ?? "—")</td>
                                <td class="td-muted">@(m.BatchNumber ?? "—")</td>
                            </tr>}
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
    @if(!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='()=>toast=""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,#121A2E 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25);overflow:hidden}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.2rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.74rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:.2s;font-family:'Tajawal'}.btn-luxury:disabled{opacity:.6}
.btn-export-luxury{background:linear-gradient(135deg,#059669,#10b981);color:#fff}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-ghost-luxury:hover{background:#fcfaf6;border-color:var(--gold)}.btn-luxury svg{width:14px;height:14px}.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.filter-luxury{display:flex;gap:10px;flex-wrap:wrap;align-items:center;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:12px}
.search-luxury{flex:1;min-width:260px;position:relative;display:flex;align-items:center}.search-luxury svg{position:absolute;right:12px;width:16px;height:16px;color:#9ca3af;pointer-events:none}.search-luxury input{width:100%;height:40px;padding:0 40px 0 36px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.86rem;font-family:'Tajawal';outline:none;background:#fcfaf6;transition:.2s}.search-luxury input:focus{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.clear-search-luxury{position:absolute;left:8px;width:24px;height:24px;border-radius:50%;border:none;background:#f3f4f6;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.clear-search-luxury svg{width:10px;height:10px}
.select-wrap-luxury{position:relative;display:flex;align-items:center}.select-wrap-luxury svg:first-child{position:absolute;right:10px;width:14px;height:14px;color:#9ca3af;pointer-events:none;z-index:1}.select-wrap-luxury select{height:40px;padding:0 34px 0 28px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.82rem;font-family:'Tajawal';background:#fff;appearance:none;cursor:pointer;outline:none;min-width:130px}.select-wrap-luxury select:focus{border-color:var(--gold)}.select-wrap-luxury .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.date-input-luxury{height:40px;padding:0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.82rem;font-family:'Tajawal';background:#fff;outline:none}.date-input-luxury:focus{border-color:var(--gold)}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.table-luxury{width:100%;border-collapse:collapse;min-width:1300px}.table-luxury thead{background:linear-gradient(135deg,#fcfaf6,#f8f6f0)}.table-luxury th{padding:12px 14px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;white-space:nowrap}.table-luxury td{padding:11px 14px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}.table-luxury tbody tr:hover{background:rgba(212,175,55,.03)}.table-luxury .row-in{border-right:3px solid #10b981}.table-luxury .row-out{border-right:3px solid #ef4444}.th-num{width:45px;text-align:center}.th-center{text-align:center}.td-num{text-align:center;color:#9ca3af;font-size:.78rem}.td-center{text-align:center}.td-name{font-weight:800;color:#0A0F1E}.td-muted{color:#9ca3af;font-size:.82rem}
.code-tag-luxury{background:#f1f5f9;padding:2px 8px;border-radius:6px;font-size:.76rem;color:#2563eb;font-weight:600}.type-tag-luxury{display:inline-block;padding:3px 10px;border-radius:8px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--tc) 12%,white);color:var(--tc);border:1px solid color-mix(in srgb,var(--tc) 25%,white)}.dir-badge-luxury{padding:3px 10px;border-radius:6px;font-size:.7rem;font-weight:800}.dir-badge-luxury.in{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.dir-badge-luxury.out{background:#fef2f2;color:#dc2626;border:1px solid #fecaca}.qty-luxury{font-family:monospace;font-weight:700}.qty-luxury.in{color:#059669}.qty-luxury.out{color:#dc2626}.amount-luxury{font-family:monospace;font-weight:700;background:#f8f6f0;padding:3px 8px;border-radius:6px;border:1px solid #e8e2d0}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}.empty-luxury{text-align:center;padding:60px 20px;background:#fff;border-radius:18px;border:1px solid #e8e2d0}.empty-icon-luxury{width:56px;height:56px;margin:0 auto 12px;border-radius:14px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.empty-icon-luxury svg{width:28px;height:28px}.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}.no-access-luxury .na-icon{width:64px;height:64px;margin:0 auto 16px;border-radius:16px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.no-access-luxury .na-icon svg{width:32px;height:32px}
.toast-luxury{position:fixed;bottom:20px;left:20px;z-index:1050;animation:toastIn .35s ease}.toast-card-luxury{display:flex;align-items:center;gap:10px;padding:12px 18px;border-radius:14px;min-width:280px;font-weight:600;font-size:.84rem;box-shadow:0 12px 32px rgba(0,0,0,.12)}.toast-card-luxury.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.toast-card-luxury.error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.toast-card-luxury button{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-right:auto}
@@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@@media(max-width:768px){.lh-content{flex-direction:column;align-items:flex-start}}
</style>

@code {
    [Parameter] public int ItemIdParam { get; set; }

    private List<StockMovementDto>? movements;
    private List<StockMovementDto> filtered = new();
    private ModulePermissionDto? permissions;
    private List<LookupDto>? warehouses;
    private string searchText = "";
    private int filterWarehouse = 0, filterType = 0;
    private DateTime? filterFrom, filterTo;
    private int selectedItemId = 0;
    private bool isExporting = false;
    private string toast = ""; private bool toastOk = true;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_TRANS");
        if (permissions == null || !permissions.CanView) return;
        warehouses = await LookupService.GetWarehousesAsync();

        if (ItemIdParam > 0) selectedItemId = ItemIdParam;
        else
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (int.TryParse(query["itemId"], out var qid)) selectedItemId = qid;
        }
        await LoadMovements();
    }

    private async Task LoadMovements()
    {
        movements = await InvService.GetMovementsAsync(
            selectedItemId > 0 ? selectedItemId : null,
            filterWarehouse > 0 ? filterWarehouse : null,
            filterType > 0 ? filterType : null,
            filterFrom, filterTo);
        FilterLocal();
    }

    private void FilterLocal()
    {
        if (movements == null) return;
        filtered = movements.Where(m =>
            string.IsNullOrEmpty(searchText) ||
            ArabicSearchHelper.Contains(m.ItemCode, searchText) ||
            ArabicSearchHelper.Contains(m.ItemNameAr, searchText) ||
            ArabicSearchHelper.Contains(m.SourceDocNumber, searchText)
        ).ToList();
    }

    private void ClearSearch() { searchText = ""; FilterLocal(); }
    private void ClearItemFilter() { selectedItemId = 0; _ = LoadMovements(); Navigation.NavigateTo("/stock-movements", forceLoad: false); }

    private async Task ExportExcel()
    {
        if (!filtered.Any()) return; isExporting = true; StateHasChanged();
        try { var b = await InvService.ExportMovementsToExcelAsync(filtered, UserSession.UserID);
            await JS.InvokeVoidAsync("downloadFile", $"StockMovements_{DateTime.Now:yyyyMMdd}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(b)); }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isExporting = false; }
    }
}
