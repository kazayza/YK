@page "/profile"
@using YKCoatings.Models
@using YKCoatings.Services
@inject UserService UserService
@inject UserPreferencesService UserPreferencesService
@inject UserSessionService UserSession
@inject NavigationManager Navigation

<PageTitle>الملف الشخصي</PageTitle>

@if (!initializationComplete || isLoading)
{
    <div class="profile-state" dir="rtl"><span class="profile-spinner"></span><span>جاري تحميل الملف الشخصي...</span></div>
}
else if (!UserSession.IsLoggedIn)
{
    <div class="profile-state" dir="rtl"><i class="bi bi-lock-fill"></i><strong>انتهت الجلسة</strong><button type="button" @onclick='() => Navigation.NavigateTo("/login")'>تسجيل الدخول</button></div>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <div class="profile-state error" dir="rtl"><i class="bi bi-exclamation-circle-fill"></i><strong>تعذر تحميل الملف الشخصي</strong><span>@loadError</span><button type="button" @onclick="LoadProfileAsync">إعادة المحاولة</button></div>
}
else
{
    <main class="profile-page yk-gold-page" dir="rtl">
        <header class="profile-hero">
            <div class="profile-hero-line"></div>
            <div class="profile-hero-copy">
                <span class="profile-eyebrow">حسابي · بياناتي الشخصية</span>
                <h1><i class="bi bi-person-badge-fill"></i> الملف الشخصي</h1>
                <p>حدّث بيانات التواصل والاسم الظاهر في النظام. بيانات الدخول والصلاحيات لا تتغير من هذه الصفحة.</p>
            </div>
            <button type="button" class="profile-back" @onclick='() => Navigation.NavigateTo("/dashboard")'><i class="bi bi-arrow-right"></i><span>العودة للرئيسية</span></button>
        </header>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="profile-message @(statusIsError ? "error" : "success")" role="@(statusIsError ? "alert" : "status")">
                <i class="bi @(statusIsError ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i><span>@statusMessage</span>
            </div>
        }

        <div class="profile-layout">
            <section class="profile-edit-card">
                <div class="profile-section-head">
                    <span class="profile-section-icon"><i class="bi bi-pencil-square"></i></span>
                    <div><h2>بيانات التواصل</h2><p>هذه الحقول فقط قابلة للتعديل ذاتياً.</p></div>
                </div>

                <EditForm Model="@profile" OnValidSubmit="@SaveProfileAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="profile-validation-summary" />

                    <div class="profile-fields">
                        <div class="profile-field full-width">
                            <label for="profile-full-name">الاسم الكامل <b>*</b></label>
                            <InputText id="profile-full-name" class="profile-input" @bind-Value="profile.FullName" autocomplete="name" disabled="@isSaving" />
                            <ValidationMessage For="() => profile.FullName" />
                        </div>
                        <div class="profile-field">
                            <label for="profile-email">البريد الإلكتروني</label>
                            <InputText id="profile-email" type="email" class="profile-input" @bind-Value="profile.Email" autocomplete="email" dir="ltr" disabled="@isSaving" />
                            <ValidationMessage For="() => profile.Email" />
                        </div>
                        <div class="profile-field">
                            <label for="profile-phone">رقم الهاتف</label>
                            <InputText id="profile-phone" type="tel" class="profile-input" @bind-Value="profile.Phone" autocomplete="tel" dir="ltr" disabled="@isSaving" />
                        </div>
                    </div>

                    <div class="profile-form-note"><i class="bi bi-shield-lock-fill"></i><span>اسم المستخدم والدور والحالة الإدارية محمية، وتغيير كلمة المرور متاح بشكل منفصل من قائمة الحساب.</span></div>

                    <div class="profile-actions">
                        <button type="submit" class="profile-save" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="profile-button-spinner"></span><span>جارٍ الحفظ...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-lg"></i><span>حفظ بياناتي</span>
                            }
                        </button>
                        <button type="button" class="profile-password-link" @onclick='() => Navigation.NavigateTo("/change-password")'><i class="bi bi-key-fill"></i><span>تغيير كلمة المرور</span></button>
                    </div>
                </EditForm>
            </section>

            <aside class="profile-account-card">
                <div class="profile-account-top">
                    <div class="profile-avatar">@GetInitials(profile.FullName)</div>
                    <div><span class="profile-account-label">الحساب الحالي</span><h2>@profile.FullName</h2><p>@(string.IsNullOrWhiteSpace(profile.RoleNameAr) ? "بدون دور مسجل" : profile.RoleNameAr)</p></div>
                </div>
                <div class="profile-account-details">
                    <div class="profile-readonly-row"><span><i class="bi bi-person-fill"></i> اسم المستخدم</span><strong dir="ltr">@profile.Username</strong></div>
                    <div class="profile-readonly-row"><span><i class="bi bi-briefcase-fill"></i> الموظف المرتبط</span><strong>@(string.IsNullOrWhiteSpace(profile.EmployeeName) ? "غير مرتبط" : profile.EmployeeName)</strong></div>
                    @if (!string.IsNullOrWhiteSpace(profile.EmployeeCode))
                    {
                        <div class="profile-readonly-row"><span><i class="bi bi-upc-scan"></i> كود الموظف</span><strong dir="ltr">@profile.EmployeeCode</strong></div>
                    }
                </div>
                <div class="profile-protection"><i class="bi bi-shield-check"></i><span>الملف يعرض بيانات حسابك أنت فقط. الدور وصلاحيات النظام تُدار من قبل المسؤول.</span></div>
            </aside>
        </div>

        <section class="profile-preferences-card">
            <div class="profile-section-head">
                <span class="profile-section-icon"><i class="bi bi-sliders2"></i></span>
                <div><h2>تفضيلاتي</h2><p>تُحفظ هذه القيم لهذا المستخدم فقط، ولا تغيّر إعدادات النظام أو صلاحياته.</p></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(preferencesLoadError))
            {
                <div class="profile-preference-error" role="alert"><i class="bi bi-exclamation-circle-fill"></i><span>تعذر قراءة تفضيلاتك: @preferencesLoadError</span><button type="button" @onclick="LoadPreferencesAsync">إعادة المحاولة</button></div>
            }
            @if (!string.IsNullOrWhiteSpace(preferencesMessage))
            {
                <div class="profile-message @(preferencesStatusIsError ? "error" : "success")" role="@(preferencesStatusIsError ? "alert" : "status")">
                    <i class="bi @(preferencesStatusIsError ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i><span>@preferencesMessage</span>
                </div>
            }

            <div class="profile-preferences-grid">
                <div class="profile-preference-control">
                    <label for="profile-page-size">عدد السجلات في الصفحة</label>
                    <select id="profile-page-size" class="profile-input" @bind="userPreferences.PageSize" disabled="@(!preferencesLoaded || isSavingPreferences)">
                        <option value="10">10 سجلات</option>
                        <option value="20">20 سجلاً</option>
                        <option value="50">50 سجلاً</option>
                        <option value="100">100 سجل</option>
                    </select>
                    <small>القيمة الافتراضية لقوائم النظام المرقّمة.</small>
                </div>

                <label class="profile-preference-toggle">
                    <span><strong>إظهار الإشعارات</strong><small>إخفاء الواجهة وإيقاف الاستطلاع عند التعطيل؛ لا يمنع إنشاء التنبيهات.</small></span>
                    <input type="checkbox" @bind="userPreferences.ShowNotifications" disabled="@(!preferencesLoaded || isSavingPreferences)" />
                    <i aria-hidden="true"></i>
                </label>

                <div class="profile-preference-control">
                    <label for="profile-play-sound">صوت الإشعارات</label>
                    <select id="profile-play-sound" class="profile-input" @bind="userPreferences.PlaySound" disabled="@(!preferencesLoaded || isSavingPreferences)">
                        <option value="">حسب إعداد النظام</option>
                        <option value="true">تشغيل</option>
                        <option value="false">إيقاف</option>
                    </select>
                    <small>اختيار «حسب إعداد النظام» يتبع الإعداد العام إذا لم يوجد تفضيل شخصي.</small>
                </div>
            </div>

            <div class="profile-preference-actions">
                <button type="button" class="profile-save" @onclick="SavePreferencesAsync" disabled="@(!preferencesLoaded || isSavingPreferences)">
                    @if (isSavingPreferences)
                    {
                        <span class="profile-button-spinner"></span><span>جارٍ الحفظ...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg"></i><span>حفظ التفضيلات</span>
                    }
                </button>
            </div>
        </section>

        <footer class="profile-footnote"><i class="bi bi-info-circle-fill"></i><span>حفظ الاسم يحدّث الاسم الظاهر في الجلسة الحالية أيضاً. لن تُغيّر هذه الصفحة اسم الدخول أو الدور أو كلمة المرور.</span></footer>
    </main>
}

