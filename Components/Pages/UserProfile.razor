0px;border:1px solid #F3CECA;border-radius:9px;background:#FFF5F2;color:#8A392C;font-size:.68rem;font-weight:700}.profile-preference-error button{margin-inline-start:auto;padding:5px 8px;border:1px solid #E4B6AE;border-radius:7px;background:#fff;color:#8A392C;font:inherit;white-space:nowrap;cursor:pointer}.profile-preference-actions{display:flex;justify-content:flex-start;margin-top:13px;padding-top:13px;border-top:1px solid #F0EDE5}
    .profile-account-card{overflow:hidden}.profile-account-top{display:flex;align-items:center;gap:12px;padding:19px;background:radial-gradient(ellipse at 0 0,rgba(212,175,55,.14),transparent 55%),linear-gradient(145deg,#FCFAF5,#fff);border-bottom:1px solid #EEE9DD}.profile-avatar{display:grid;place-items:center;flex:0 0 54px;width:54px;height:54px;border:1px solid rgba(212,175,55,.42);border-radius:17px;background:linear-gradient(145deg,#141B2B,#070B14);color:#F2D779;font-size:1.05rem;font-weight:900;box-shadow:0 6px 15px rgba(7,11,20,.14)}.profile-account-label{color:#9A7B28;font-size:.62rem;font-weight:900}.profile-account-top h2{max-width:100%;margin:3px 0 2px;color:#172033;font-size:.95rem;font-weight:900;overflow-wrap:anywhere}.profile-account-top p{margin:0;color:#7B8492;font-size:.68rem;font-weight:700}.profile-account-details{display:flex;flex-direction:column;padding:4px 16px}.profile-readonly-row{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid #F1EEE7}.profile-readonly-row:last-child{border-bottom:0}.profile-readonly-row>span{display:flex;align-items:center;gap:6px;color:#7C8491;font-size:.68rem;font-weight:700;white-space:nowrap}.profile-readonly-row>span i{color:#A48631}.profile-readonly-row>strong{color:#283246;font-size:.7rem;font-weight:900;text-align:left;overflow-wrap:anywhere}.profile-protection{display:flex;align-items:flex-start;gap:8px;margin:0 15px 15px;padding:10px;border:1px solid #E5E7EB;border-radius:9px;background:#F8F9FA;color:#687283;font-size:.66rem;font-weight:700;line-height:1.6}.profile-protection i{color:#96791F}.profile-footnote{display:flex;align-items:flex-start;gap:8px;padding:11px 13px;border:1px dashed #D8C98F;border-radius:11px;background:#FFFDF7;color:#66531A;font-size:.72rem;line-height:1.65}.profile-footnote i{margin-top:2px}
    .profile-state{display:flex;min-height:48vh;flex-direction:column;align-items:center;justify-content:center;gap:9px;padding:20px;color:#657083;font-family:'Tajawal',sans-serif;font-size:.82rem;text-align:center}.profile-state>i{font-size:1.7rem;color:#9C7C2E}.profile-state strong{color:#253044;font-size:.95rem}.profile-state>span:not(.profile-spinner){max-width:650px;color:#8A909A;font-size:.74rem}.profile-state button{margin-top:5px;padding:8px 13px;border:1px solid #D8C98F;border-radius:8px;background:#FFFCF2;color:#705B22;font-family:inherit;font-weight:800;cursor:pointer}.profile-state.error>i{color:#A63E31}.profile-spinner{display:inline-block;width:28px;height:28px;border:2px solid #E8E2D2;border-top-color:#92731F;border-radius:50%;animation:profileSpin .7s linear infinite}@@keyframes profileSpin{to{transform:rotate(360deg)}}
    @@media(max-width:850px){.profile-layout{grid-template-columns:1fr}.profile-account-card{order:-1}.profile-preferences-grid{grid-template-columns:1fr}}
    @@media(max-width:600px){.profile-page{padding:12px}.profile-hero{align-items:flex-start;flex-direction:column;padding:18px}.profile-hero h1{font-size:1.14rem}.profile-back{align-self:stretch}.profile-edit-card{padding:15px}.profile-fields{grid-template-columns:1fr}.profile-field.full-width{grid-column:auto}.profile-account-top{padding:15px}}
</style>

@code {
    private SelfProfileDto profile = new();
    private UserPreferencesDto userPreferences = new();
    private bool initializationComplete;
    private bool isLoading = true;
    private bool isSaving;
    private bool isSavingPreferences;
    private bool preferencesLoaded;
    private bool preferencesStatusIsError;
    private bool statusIsError;
    private string loadError = "";
    private string statusMessage = "";
    private string preferencesLoadError = "";
    private string preferencesMessage = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            if (!await UserSession.EnsureRestoredAsync())
            {
                initializationComplete = true;
                isLoading = false;
                Navigation.NavigateTo("/login");
                return;
            }

            await LoadProfileAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            initializationComplete = true;
            isLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadProfileAsync()
    {
        isLoading = true;
        loadError = "";
        try
        {
            profile = await UserService.GetMyProfileAsync(UserSession.UserID);
            await LoadPreferencesAsync();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
            initializationComplete = true;
        }
    }

    private async Task LoadPreferencesAsync()
    {
        preferencesLoaded = false;
        preferencesLoadError = "";
        try
        {
            userPreferences = await UserPreferencesService.GetCurrentAsync(UserSession.UserID);
            preferencesLoaded = true;
        }
        catch (Exception ex)
        {
            preferencesLoadError = ex.Message;
        }
    }

    private async Task SavePreferencesAsync()
    {
        if (!preferencesLoaded || isSavingPreferences)
            return;

        isSavingPreferences = true;
        preferencesMessage = "";
        preferencesStatusIsError = false;
        try
        {
            await UserPreferencesService.SaveAsync(userPreferences, UserSession.UserID);
            preferencesMessage = "تم حفظ تفضيلاتك لهذا المستخدم.";
        }
        catch (Exception ex)
        {
            preferencesMessage = ex.Message;
            preferencesStatusIsError = true;
        }
        finally
        {
            isSavingPreferences = false;
        }
    }

    private async Task SaveProfileAsync()
    {
        isSaving = true;
        statusMessage = "";
        statusIsError = false;
        try
        {
            var changed = await UserService.UpdateMyProfileAsync(profile, UserSession.UserID);
            if (changed)
                await UserSession.UpdateFullNameAsync(UserSession.UserID, profile.FullName);

            profile = await UserService.GetMyProfileAsync(UserSession.UserID);
            statusMessage = changed ? "تم حفظ بيانات ملفك الشخصي." : "لا توجد تغييرات جديدة لحفظها.";
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "YK";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 1
            ? $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant()
            : parts[0][0].ToString().ToUpperInvariant();
    }
}
