@page "/payment-terms"

@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PaymentTermService PtService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>شروط الدفع - واي كي كوتينج   </PageTitle>

@if (!UserSession.IsLoggedIn)
{ <div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div> }
else if (perms == null || !perms.CanView)
{ <div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div> }
else
{
    <div class="luxury-page" dir="rtl">

        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">شروط الدفع</h2><p class="lh-subtitle">إدارة شروط وأيام الاستحقاق والخصومات</p></div>
                </div>
                <div class="lh-actions">
                    <span class="lh-badge"><span class="lh-dot"></span>@filtered.Count شرط</span>
                    @if (perms.CanExport)
                    {
                        <button class="btn-luxury btn-export-luxury" @onclick="ExportToExcel" disabled="@isExporting">
                            @if (isExporting){<div class="btn-spinner-sm"></div><span>جاري...</span>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg><span>تصدير</span>}
                        </button>
                    }
                    @if (perms.CanAdd){ <button class="btn-luxury btn-primary-luxury" @onclick="ShowAdd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>شرط جديد</button> }
                </div>
            </div>
        </div>

        <div class="stats-luxury">
            <div class="stat-luxury"><div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></div><div class="st-info"><span class="st-value">@terms.Count</span><span class="st-label">إجمالي الشروط</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div class="st-info"><span class="st-value">@terms.Count(t => t.IsActive)</span><span class="st-label">نشطة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div><div class="st-info"><span class="st-value">@terms.Count(t => !t.IsActive)</span><span class="st-label">غير نشطة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><div class="st-info"><span class="st-value">@GetAvgDueDays()</span><span class="st-label">متوسط أيام الاستحقاق</span></div><div class="st-gold-line"></div></div>
        </div>

        <!-- Quick Cards (Active Only) -->
        @if (terms.Any(t => t.IsActive))
        {
            <div class="rates-luxury">
                @foreach (var t in terms.Where(x => x.IsActive).Take(6))
                {
                    <div class="rate-card-luxury">
                        <div class="rc-gold-line"></div>
                        <div class="rc-top">
                            <div class="rc-flag">@t.DueDays</div>
                            <div class="rc-info"><strong>@t.TermNameAr</strong><code>@t.TermCode</code></div>
                        </div>
                        <div class="rc-rate">@t.DueDays<span class="rc-symbol">يوم</span></div>
                        <div class="rc-footer">
                            <span class="rc-status">@(t.DiscountPercent > 0 ? $"خصم {t.DiscountPercent}% خلال {t.DiscountDays} يوم" : "بدون خصم")</span>
                            <span class="rc-en">مستخدم: @t.UsedCount</span>
                        </div>
                    </div>
                }
            </div>
        }

        <!-- Filter Row -->
        <div class="filter-luxury">
            <div class="search-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="بحث بالاسم أو الكود..." @bind="searchText" @bind:event="oninput" @bind:after="ApplyFilter" />
                @if (!string.IsNullOrEmpty(searchText)) { <button class="clear-search-luxury" @onclick='() => { searchText = ""; ApplyFilter(); }'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button> }
            </div>
            <div class="select-wrap-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M7 12h10"/><path d="M10 18h4"/></svg>
                <select @bind="statusFilter" @bind:after="ApplyFilter">
                    <option value="all">الكل</option>
                    <option value="active">نشطة فقط</option>
                    <option value="inactive">غير نشطة فقط</option>
                </select>
                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        <!-- Table -->
        @if (!filtered.Any())
        { <div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></div><h4>لا توجد شروط دفع</h4></div> }
        else
        {
            <div class="table-card-luxury"><div class="table-responsive"><table class="table-luxury">
                <thead><tr>
                    <th class="th-num">#</th><th>الكود</th><th>الاسم (عربي)</th><th>الاسم (إنجليزي)</th>
                    <th class="th-center">أيام الاستحقاق</th><th class="th-center">نسبة الخصم</th><th class="th-center">أيام الخصم</th>
                    <th class="th-center">مستخدم</th><th class="th-center">الحالة</th>
                    @if (perms.CanEdit || perms.CanDelete) { <th class="th-actions">إجراءات</th> }
                </tr></thead>
                <tbody>
                    @{ int n = 0; }
                    @foreach (var t in filtered)
                    {
                        n++;
                        <tr>
                            <td class="td-num">@n</td>
                            <td><span class="code-luxury">@t.TermCode</span></td>
                            <td class="td-name">@t.TermNameAr</td>
                            <td class="td-muted">@(t.TermNameEn ?? "—")</td>
                            <td class="td-center"><span class="days-badge-luxury">@t.DueDays يوم</span></td>
                            <td class="td-center">@(t.DiscountPercent > 0 ? $"{t.DiscountPercent}%" : "—")</td>
                            <td class="td-center">@(t.DiscountDays > 0 ? $"{t.DiscountDays} يوم" : "—")</td>
                            <td class="td-center"><span class="use-count-luxury">@t.UsedCount</span></td>
                            <td class="td-center">
                                <span class="status-dot-luxury @(t.IsActive ? "green" : "red")"></span>
                                <span class="status-text-luxury">@(t.IsActive ? "نشط" : "غير نشط")</span>
                            </td>
                            @if (perms.CanEdit || perms.CanDelete)
                            {
                                <td class="td-actions"><div class="actions-wrap-luxury">
                                    @if (perms.CanEdit) { <button class="act-btn edit" @onclick="() => ShowEdit(t)" title="تعديل"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button> }
                                    @if (!t.IsActive && perms.CanEdit) { <button class="act-btn activate" @onclick="() => ActivateTerm(t)" title="تفعيل"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></button> }
                                    @if (perms.CanDelete && t.IsActive) { <button class="act-btn delete" @onclick="() => ShowDel(t)" title="تعطيل"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></button> }
                                </div></td>
                            }
                        </tr>
                    }
                </tbody>
            </table></div></div>
        }
    </div>

    <!-- Modal: إضافة / تعديل -->
    @if (showForm)
    {
        <div class="modal-overlay-luxury" @onclick="() => showForm = false">
            <div class="modal-card-luxury" @onclick:stopPropagation="true">
                <div class="ml-gold-line"></div>
                <div class="ml-header">
                    <div class="ml-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></div>
                    <div class="ml-text"><h3>@(editItem.PaymentTermID == 0 ? "إضافة شرط دفع" : "تعديل شرط دفع")</h3><p>@(editItem.PaymentTermID == 0 ? "أدخل بيانات الشرط الجديد" : "تحديث بيانات الشرط")</p></div>
                    <button class="ml-close" @onclick="() => showForm = false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>
                </div>
                <div class="ml-body">
                    <div class="form-grid-luxury cols-2">
                        <div class="field-luxury"><label class="fl-label required">الكود</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6"/><path d="M9 15h6"/></svg><input type="text" @bind="editItem.TermCode" placeholder="NET30, CASH..." maxlength="20" dir="ltr" /></div></div>
                        <div class="field-luxury"><label class="fl-label required">أيام الاستحقاق</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><input type="number" @bind="editItem.DueDays" min="0" placeholder="30" /></div></div>
                    </div>
                    <div class="form-grid-luxury cols-2">
                        <div class="field-luxury"><label class="fl-label required">الاسم (عربي)</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" @bind="editItem.TermNameAr" placeholder="استحقاق 30 يوم..." /></div></div>
                        <div class="field-luxury"><label class="fl-label">الاسم (إنجليزي)</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" @bind="editItem.TermNameEn" placeholder="Net 30 Days..." dir="ltr" /></div></div>
                    </div>
                    <div class="form-grid-luxury cols-2">
                        <div class="field-luxury"><label class="fl-label">نسبة الخصم %</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 5 5 19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg><input type="number" @bind="editItem.DiscountPercent" step="0.01" min="0" max="100" placeholder="0" /></div><span class="fl-hint">خصم الدفع المبكر خلال أيام الخصم</span></div>
                        <div class="field-luxury"><label class="fl-label">أيام الخصم</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><input type="number" @bind="editItem.DiscountDays" min="0" placeholder="0" /></div></div>
                    </div>
                    @if (!string.IsNullOrEmpty(formMsg)) { <div class="msg-luxury msg-error">@formMsg</div> }
                </div>
                <div class="ml-footer">
                    <button class="btn-luxury btn-primary-luxury" @onclick="Save" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}حفظ</button>
                    <button class="btn-luxury btn-ghost-luxury" @onclick="() => showForm = false">إلغاء</button>
                </div>
            </div>
        </div>
    }

    <!-- Modal: تعطيل -->
    @if (showDelete)
    {
        <div class="modal-overlay-luxury" @onclick="() => showDelete = false">
            <div class="modal-card-luxury small" @onclick:stopPropagation="true">
                <div class="ml-gold-line danger"></div>
                <div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div>
                <h4>تعطيل شرط الدفع</h4>
                <p>هل تريد تعطيل شرط الدفع: <strong class="delete-name">@deleteItem?.TermNameAr</strong>؟</p>
                <p class="delete-hint">سيتم إيقاف تنشيط الشرط فقط، ويمكن تفعيله لاحقاً</p>
                @if (!string.IsNullOrEmpty(delMsg)) { <div class="msg-luxury msg-error">@delMsg</div> }
                <div class="ml-footer center">
                    <button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDelete" disabled="@isDeleting">@if(isDeleting){<div class="btn-spinner-sm"></div>}تعطيل</button>
                    <button class="btn-luxury btn-ghost-luxury" @onclick="() => showDelete = false">إلغاء</button>
                </div>
            </div>
        </div>
    }

    <!-- Toast -->
    @if (!string.IsNullOrEmpty(toast))
    { <div class="toast-luxury"><div class="toast-card-luxury @(toastOk ? "success" : "error")"><span>@toast</span><button @onclick='() => toast = ""'><i class=bi-x-lg></i></button></div></div> }
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.st-icon.dark{background:linear-gradient(135deg,var(--black2),var(--black3));color:var(--gold);border:1px solid var(--border-gold)}
.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}
.st-icon.red{background:#fef2f2;color:#ef4444;border:1px solid #fecaca}
.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.15)}
.st-info{display:flex;flex-direction:column}
.st-value{font-size:1.2rem;font-weight:900;color:#0A0F1E;line-height:1}
.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}
.rates-luxury{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px}
.rate-card-luxury{position:relative;background:#fff;border:1.5px solid #e8e2d0;border-radius:16px;padding:14px;overflow:hidden;transition:.2s;box-shadow:0 2px 10px rgba(0,0,0,.03)}
.rate-card-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.2)}
.rc-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}
.rate-card-luxury:hover .rc-gold-line{opacity:.8}
.rc-top{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.rc-flag{width:36px;height:36px;border-radius:10px;background:#f8f6f0;border:1px solid #e8e2d0;display:flex;align-items:center;justify-content:center;font-size:1.2rem;font-weight:800;color:var(--gold-dark)}
.rc-info{flex:1;display:flex;flex-direction:column}
.rc-info strong{font-size:.86rem;color:#0A0F1E}
.rc-info code{font-size:.7rem;color:var(--gold-dark);background:#f8f6f0;padding:2px 6px;border-radius:4px;width:fit-content;margin-top:2px;font-family:monospace}
.rc-rate{font-size:1.2rem;font-weight:900;color:#0A0F1E;display:flex;align-items:baseline;gap:6px;margin-bottom:8px}
.rc-symbol{font-size:.8rem;color:var(--gold-dark);font-weight:700;background:rgba(212,175,55,.1);padding:2px 8px;border-radius:999px}
.rc-footer{display:flex;justify-content:space-between;align-items:center;border-top:1px solid #f3f4f6;padding-top:8px;gap:6px}
.rc-status{font-size:.7rem;font-weight:600;color:#6b7280}
.rc-en{font-size:.68rem;color:#9ca3af}
.search-luxury{flex:1;min-width:240px;position:relative;display:flex;align-items:center}
.clear-search-luxury{position:absolute;left:8px;width:24px;height:24px;border-radius:50%;border:none;background:#f3f4f6;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}
.clear-search-luxury svg{width:10px;height:10px;position:static}
.select-wrap-luxury .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}
.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.table-responsive{overflow-x:auto}
.table-luxury{width:100%;border-collapse:collapse}
.table-luxury th{padding:12px 14px;font-size:.78rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;white-space:nowrap}
.th-actions{text-align:center;width:120px}
.td-actions{text-align:center}
.code-luxury{background:#f8f6f0;border:1px solid #e8e2d0;padding:3px 8px;border-radius:8px;font-size:.78rem;color:var(--gold-dark);font-weight:700;font-family:monospace}
.days-badge-luxury{background:rgba(212,175,55,.1);color:var(--gold-dark);padding:3px 10px;border-radius:8px;font-size:.78rem;font-weight:700;border:1px solid rgba(212,175,55,.2)}
.use-count-luxury{background:#f8f6f0;color:#6b7280;padding:3px 10px;border-radius:8px;font-size:.76rem;font-weight:700}
.status-dot-luxury{display:inline-block;width:8px;height:8px;border-radius:50%}
.status-dot-luxury.green{background:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,.15)}
.status-dot-luxury.red{background:#ef4444;box-shadow:0 0 0 3px rgba(239,68,68,.15)}
.status-text-luxury{font-size:.74rem;font-weight:600;margin-right:4px;color:#6b7280}
.actions-wrap-luxury{display:flex;gap:4px;justify-content:center}
.act-btn{width:32px;height:32px;border-radius:10px;border:1.5px solid;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;background:#fff;transition:.2s}
.act-btn.edit{color:var(--gold-dark);border-color:rgba(212,175,55,.2)}
.act-btn.edit:hover{background:rgba(212,175,55,.08);border-color:var(--gold)}
.act-btn.delete{color:#ef4444;border-color:#fee2e2}
.act-btn.delete:hover{background:#fef2f2;border-color:#ef4444}
.act-btn.activate{color:#059669;border-color:#a7f3d0}
.act-btn.activate:hover{background:#ecfdf5;border-color:#059669}
.act-btn svg{width:14px;height:14px}
.modal-overlay-luxury{position:fixed;inset:0;background:rgba(10,15,30,.6);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:1000;padding:20px;animation:modalIn .25s ease}
.modal-card-luxury{position:relative;background:#fff;border-radius:20px;max-width:640px;width:100%;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.25);border:1px solid #e8e2d0;animation:modalIn .3s cubic-bezier(.16,1,.3,1)}
.modal-card-luxury.small{max-width:440px;text-align:center;padding:28px 24px}
.ml-gold-line{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent)}
.ml-gold-line.danger{background:linear-gradient(90deg,transparent,#ef4444,#dc2626,transparent)}
.ml-header{display:flex;align-items:center;gap:12px;padding:18px 20px;border-bottom:1px solid #f1efe8;background:linear-gradient(135deg,#fcfaf6,#fff)}
.ml-icon{width:42px;height:42px;border-radius:12px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);display:flex;align-items:center;justify-content:center;color:var(--gold-dark);flex-shrink:0}
.ml-icon.gold{background:linear-gradient(135deg,rgba(212,175,55,.15),rgba(212,175,55,.05));border-color:rgba(212,175,55,.2)}
.ml-icon svg{width:20px;height:20px}
.ml-text{flex:1;text-align:right}
.ml-text h3{margin:0;font-size:1rem;font-weight:900;color:#0A0F1E}
.ml-text p{margin:2px 0 0;font-size:.74rem;color:#8B95A5;font-weight:600}
.ml-close{width:32px;height:32px;border-radius:10px;border:1px solid #e8e2d0;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280;transition:.2s}
.ml-close:hover{background:#f9fafb;color:#0A0F1E}
.ml-close svg{width:14px;height:14px}
.ml-body{padding:20px;display:flex;flex-direction:column;gap:14px;max-height:70vh;overflow-y:auto}
.ml-footer{display:flex;gap:8px;padding:14px 20px;border-top:1px solid #f1efe8;background:#fcfaf6;justify-content:flex-end}
.ml-footer.center{justify-content:center;background:transparent;border:none;padding-top:16px}
.form-grid-luxury{display:grid;gap:12px}
.form-grid-luxury.cols-2{grid-template-columns:repeat(2,1fr)}
.field-luxury{display:flex;flex-direction:column;gap:6px;text-align:right}
.fl-label.required::after{content:' *';color:#ef4444}
.input-wrap-luxury{position:relative;display:flex;align-items:center}
.input-wrap-luxury svg{position:absolute;right:10px;width:14px;height:14px;color:#9ca3af;pointer-events:none;z-index:1}
.input-wrap-luxury input{width:100%;height:42px;padding:0 34px 0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.86rem;font-family:'Tajawal';outline:none;background:#fff;transition:.2s}
.input-wrap-luxury input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.msg-luxury{padding:10px 14px;border-radius:12px;font-size:.82rem;font-weight:600}
.msg-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
.delete-icon-luxury{width:64px;height:64px;border-radius:50%;background:#fef2f2;border:1px solid #fecaca;display:inline-flex;align-items:center;justify-content:center;color:#ef4444;margin:0 auto 12px}
.delete-icon-luxury svg{width:32px;height:32px}
.delete-name{font-size:1rem;font-weight:800;color:#0A0F1E;margin:8px 0}
.delete-hint{font-size:.76rem;color:#9ca3af;margin:4px 0 0}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}
.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}
.empty-icon-luxury{width:56px;height:56px;margin:0 auto;border-radius:14px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}
.empty-icon-luxury svg{width:28px;height:28px}
.no-access-luxury .na-icon{width:64px;height:64px;margin:0 auto 16px;border-radius:16px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}
.no-access-luxury .na-icon svg{width:32px;height:32px}
.no-val{color:#d1d5db;font-size:.78rem}
</style>

<script>
    window.downloadFile = (fileName, mimeType, base64Data) => {
        const link = document.createElement('a');
        link.download = fileName;
        link.href = `data:${mimeType};base64,${base64Data}`;
        link.click();
    };
</script>

@code {
    private List<PaymentTermListDto> terms = new();
    private List<PaymentTermListDto> filtered = new();
    private ModulePermissionDto? perms;
    private string searchText = "";
    private string statusFilter = "all";
    private string toast = ""; 
    private bool toastOk = true;
    private bool isExporting = false;

    // Form
    private bool showForm = false;
    private PaymentTermEditDto editItem = new();
    private string formMsg = "";
    private bool isSaving = false;

    // Delete
    private bool showDelete = false;
    private PaymentTermListDto? deleteItem;
    private string delMsg = "";
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        perms = PermissionService.GetModule("SCR_PAYTERMS");
        if (perms != null && perms.CanView) await LoadData();
    }

    private async Task LoadData()
    {
        terms = await PtService.GetAllAsync(true);
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var query = terms.AsEnumerable();

        if (!string.IsNullOrEmpty(searchText))
        {
            query = query.Where(t =>
                t.TermCode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true ||
                t.TermNameAr?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true ||
                t.TermNameEn?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true);
        }

        query = statusFilter switch
        {
            "active" => query.Where(t => t.IsActive),
            "inactive" => query.Where(t => !t.IsActive),
            _ => query
        };

        filtered = query.ToList();
    }

    private int GetAvgDueDays()
    {
        if (!terms.Any()) return 0;
        return (int)Math.Round(terms.Average(t => t.DueDays));
    }

    private void ShowAdd()
    {
        editItem = new() { DueDays = 30, DiscountPercent = 0, DiscountDays = 0 };
        formMsg = ""; showForm = true;
    }

    private void ShowEdit(PaymentTermListDto t)
    {
        editItem = new()
        {
            PaymentTermID = t.PaymentTermID,
            TermCode = t.TermCode,
            TermNameAr = t.TermNameAr,
            TermNameEn = t.TermNameEn,
            DueDays = t.DueDays,
            DiscountPercent = t.DiscountPercent,
            DiscountDays = t.DiscountDays,
            IsActive = t.IsActive
        };
        formMsg = ""; showForm = true;
    }

    private async Task ActivateTerm(PaymentTermListDto t)
    {
        try
        {
            var edit = new PaymentTermEditDto
            {
                PaymentTermID = t.PaymentTermID,
                TermCode = t.TermCode,
                TermNameAr = t.TermNameAr,
                TermNameEn = t.TermNameEn,
                DueDays = t.DueDays,
                DiscountPercent = t.DiscountPercent,
                DiscountDays = t.DiscountDays,
                IsActive = true
            };
            await PtService.UpdateAsync(edit, UserSession.UserID);
            toast = $"تم تفعيل شرط الدفع: {t.TermNameAr}";
            toastOk = true;
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            toast = "خطأ: " + ex.Message;
            toastOk = false;
        }
    }

    private async Task Save()
    {
        formMsg = "";
        if (string.IsNullOrWhiteSpace(editItem.TermCode)) { formMsg = "أدخل الكود"; return; }
        if (string.IsNullOrWhiteSpace(editItem.TermNameAr)) { formMsg = "أدخل الاسم"; return; }
        if (editItem.DueDays < 0) { formMsg = "أيام الاستحقاق لازم 0 أو أكتر"; return; }

        isSaving = true; StateHasChanged();
        try
        {
            if (editItem.PaymentTermID == 0)
            {
                await PtService.InsertAsync(editItem, UserSession.UserID);
                toast = "تمت إضافة شرط الدفع"; toastOk = true;
            }
            else
            {
                await PtService.UpdateAsync(editItem, UserSession.UserID);
                toast = "تم تعديل شرط الدفع"; toastOk = true;
            }
            showForm = false; 
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex) { formMsg = "خطأ: " + ex.Message; }
        finally { isSaving = false; StateHasChanged(); }
    }

    private void ShowDel(PaymentTermListDto t) 
    { 
        deleteItem = t; 
        delMsg = ""; 
        showDelete = true; 
    }

    private async Task ConfirmDelete()
    {
        if (deleteItem == null) return;

        isDeleting = true;
        delMsg = "";
        StateHasChanged();

        try
        {
            var result = await PtService.DeleteAsync(deleteItem.PaymentTermID, UserSession.UserID);
            
            if (result.Success)
            {
                toast = result.Message;
                toastOk = true;
                showDelete = false;
                deleteItem = null;
                await LoadData();
                StateHasChanged();
            }
            else
            {
                delMsg = result.Message;
                toast = "فشل: " + result.Message;
                toastOk = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            delMsg = "خطأ: " + ex.Message;
            toast = "خطأ: " + ex.Message;
            toastOk = false;
            StateHasChanged();
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task ExportToExcel()
    {
        if (!filtered.Any())
        {
            toast = "لا توجد بيانات للتصدير";
            toastOk = false;
            return;
        }

        isExporting = true;
        StateHasChanged();

        try
        {
            using var stream = new MemoryStream();
            using var writer = new StreamWriter(stream);
            
            await writer.WriteLineAsync("الكود,الاسم (عربي),الاسم (إنجليزي),أيام الاستحقاق,نسبة الخصم,أيام الخصم,عدد مرات الاستخدام,الحالة");
            
            foreach (var t in filtered)
            {
                await writer.WriteLineAsync($"{t.TermCode},{t.TermNameAr},{t.TermNameEn ?? ""},{t.DueDays},{t.DiscountPercent},{t.DiscountDays},{t.UsedCount},{(t.IsActive ? "نشط" : "غير نشط")}");
            }
            
            writer.Flush();
            var bytes = stream.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            
            await JS.InvokeVoidAsync("downloadFile", $"PaymentTerms_{DateTime.Now:yyyyMMdd_HHmmss}.csv", "text/csv", base64);
            toast = $"تم تصدير {filtered.Count} شرط بنجاح";
            toastOk = true;
        }
        catch (Exception ex)
        {
            toast = "خطأ في التصدير: " + ex.Message;
            toastOk = false;
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }
}

