<script>
    window.downloadFile = (fileName, mimeType, base64Data) => {
        const link = document.createElement('a');
        link.download = fileName;
        link.href = `data:${mimeType};base64,${base64Data}`;
        link.click();
    };
</script>

@code {
    private ModulePermissionDto? permissions;
    private List<JobTitleListDto> jobTitles = new();
    private List<JobTitleListDto> filteredItems = new();

    private string searchText = "";
    private string statusFilter = "all";
    private int levelFilter = 0;

    private bool isLoading = true;
    private bool isExporting = false;
    private bool isChangingStatus = false;

    private bool showStatusDialog = false;
    private JobTitleListDto? selectedItem;
    private string dialogMessage = "";

    private string resultMessage = "";
    private bool resultSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_JOBTITLES");

        if (permissions == null || !permissions.CanView) { isLoading = false; return; }

        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            jobTitles = await JobTitleService.GetJobTitlesListAsync();
            FilterData();
        }
        catch (Exception ex)
        {
            resultMessage = "خطأ: " + ex.Message;
            resultSuccess = false;
        }
        finally { isLoading = false; }
    }

    private void FilterData()
    {
        var query = jobTitles.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var s = searchText.Trim();
            query = query.Where(j =>
                (j.JobTitleNameAr ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (j.JobTitleNameEn ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                (j.JobTitleCode ?? "").Contains(s, StringComparison.OrdinalIgnoreCase));
        }

        if (levelFilter > 0)
            query = query.Where(j => j.JobLevel == levelFilter);

        query = statusFilter switch
        {
            "1" => query.Where(j => j.IsActive),
            "0" => query.Where(j => !j.IsActive),
            _ => query
        };

        filteredItems = query.ToList();
    }

    private void ClearFilters()
    {
        searchText = "";
        statusFilter = "all";
        levelFilter = 0;
        FilterData();
    }

    private void GoToAdd() => Navigation.NavigateTo("/jobtitles/new");
    private void GoToEdit(int id) => Navigation.NavigateTo($"/jobtitles/edit/{id}");
    private void GoToView(int id) => Navigation.NavigateTo($"/jobtitles/view/{id}");

    private void ShowStatusConfirm(JobTitleListDto item) { selectedItem = item; dialogMessage = ""; showStatusDialog = true; }
    private void CloseStatusDialog() { showStatusDialog = false; selectedItem = null; dialogMessage = ""; }

    private async Task ConfirmStatusChange()
    {
        if (selectedItem == null) return;
        isChangingStatus = true; dialogMessage = "";

        try
        {
            var newStatus = !selectedItem.IsActive;
            var result = await JobTitleService.SetJobTitleActiveStatusAsync(selectedItem.JobTitleID, newStatus, UserSession.UserID);

            if (result.Success)
            {
                resultMessage = result.Message; resultSuccess = true;
                showStatusDialog = false; selectedItem = null;
                await LoadData();
            }
            else { dialogMessage = result.Message; }
        }
        catch (Exception ex) { dialogMessage = "خطأ: " + ex.Message; }
        finally { isChangingStatus = false; }
    }

    private async Task ExportData()
    {
        if (!filteredItems.Any()) return;
        isExporting = true;

        try
        {
            var bytes = await JobTitleService.ExportJobTitlesToExcelAsync(filteredItems, UserSession.UserID);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFile", $"JobTitles_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
            resultMessage = "تم التصدير بنجاح ✅"; resultSuccess = true;
        }
        catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
        finally { isExporting = false; }
    }
}