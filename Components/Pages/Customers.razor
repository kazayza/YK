@page "/customers"

@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject CustomerService CustomerService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>العملاء - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول أولاً</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4><button class="btn-luxury btn-secondary-luxury" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة للرئيسية</button></div>}
else
{
    <div class="luxury-page" dir="rtl">
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">العملاء</h2><p class="lh-subtitle">إدارة العملاء والمجموعات والمناديب - نظام ولاء ومتابعة أرصدة</p></div>
                </div>
                <div class="lh-actions">
                    <span class="lh-badge"><span class="lh-dot"></span>@pagedResult.TotalCount عميل</span>
                    @if (permissions.CanExport)
                    {
                        <button class="btn-luxury btn-export-luxury" @onclick="ExportFilteredData" disabled="@isExporting">
                            @if (isExporting){<div class="btn-spinner-sm"></div><span>جاري...</span>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg><span>Excel</span>}
                        </button>
                    }
                    @if (permissions.CanPrint){<button class="btn-luxury btn-ghost-luxury" @onclick="GoToPrint"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>طباعة</button>}
                    @if (permissions.CanAdd){<button class="btn-luxury btn-primary-luxury" @onclick="GoToAdd"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة عميل</button>}
                </div>
            </div>
        </div>

        <div class="stats-luxury">
            <div class="stat-luxury"><div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div><div class="st-info"><span class="st-value">@stats.Total</span><span class="st-label">إجمالي العملاء</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div class="st-info"><span class="st-value">@stats.TotalActive</span><span class="st-label">نشط</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg></div><div class="st-info"><span class="st-value">@stats.TotalWholesale</span><span class="st-label">جملة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/></svg></div><div class="st-info"><span class="st-value">@stats.TotalRetail</span><span class="st-label">تجزئة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@stats.TotalBalance.ToString("#,##0")</span><span class="st-label">إجمالي الأرصدة</span></div><div class="st-gold-line"></div></div>
        </div>

        <div class="filter-card-luxury">
            <div class="filter-grid-luxury">
                <div class="search-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input type="text" placeholder="بحث بالاسم أو الكود أو الهاتف أو المدينة..." @bind="filters.SearchText" /></div>
                <div class="field-luxury-sm"><label>النوع</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg><select @bind="filters.CustomerType"><option value="0">كل الأنواع</option><option value="1">جملة</option><option value="2">نص جملة</option><option value="3">تجزئة</option><option value="4">أونلاين</option><option value="5">مؤسسي</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                <div class="field-luxury-sm"><label>المجموعة</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg><select @bind="filters.CustomerGroupID"><option value="0">كل المجموعات</option>@if (customerGroups != null){@foreach(var item in customerGroups){<option value="@item.Id">@item.Name</option>}}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                <div class="field-luxury-sm"><label>المندوب</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><select @bind="filters.SalesRepID"><option value="0">كل المندوبين</option>@if (salesReps != null){@foreach(var item in salesReps){<option value="@item.Id">@item.Name</option>}}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                <div class="field-luxury-sm"><label>الحالة</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><select @bind="statusFilter"><option value="1">نشط فقط</option><option value="0">غير نشط فقط</option><option value="all">الكل</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                <div class="field-luxury-sm"><label>عدد السجلات</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg><select value="@filters.PageSize" @onchange="OnPageSizeChanged"><option value="10">10</option><option value="20">20</option><option value="50">50</option><option value="100">100</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
            </div>
            <div class="filter-actions-luxury">
                <button class="btn-luxury btn-primary-luxury" @onclick="SearchData" disabled="@isLoading"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>بحث</button>
                <button class="btn-luxury btn-ghost-luxury" @onclick="ClearFilters" disabled="@isLoading">مسح الفلاتر</button>
                <button class="btn-luxury btn-ghost-luxury" @onclick="RefreshData" disabled="@isLoading"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
            </div>
        </div>

        @if (isLoading)
        {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل العملاء...</p></div>}
        else if (!pagedResult.Items.Any())
        {<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><h4>لا توجد بيانات مطابقة</h4></div>}
        else
        {
            <div class="table-card-luxury">
                <div class="table-responsive">
                    <table class="table-luxury">
                        <thead><tr><th class="th-num">#</th><th>الكود</th><th>اسم العميل</th><th>النوع</th><th>المجموعة</th><th>الهاتف</th><th>المدينة</th><th>العملة</th><th>المندوب</th><th>حد الائتمان</th><th>الرصيد</th><th class="th-center">الحالة</th><th class="th-center">التقييم</th><th class="th-actions">إجراءات</th></tr></thead>
                        <tbody>
                            @{var rowIndex = ((filters.PageNumber - 1) * filters.PageSize);}
                            @foreach (var cust in pagedResult.Items){rowIndex++;
                                <tr>
                                    <td class="td-num">@rowIndex</td>
                                    <td><span class="code-luxury">@cust.CustomerCode</span></td>
                                    <td class="td-name"><div class="cust-name-wrap"><span class="cust-avatar">@(cust.CustomerNameAr?.FirstOrDefault().ToString() ?? "C")</span><strong>@cust.CustomerNameAr</strong></div></td>
                                    <td><span class="type-badge-luxury type-cust-@cust.CustomerType">@CustomerService.GetCustomerTypeName(cust.CustomerType)</span></td>
                                    <td class="td-muted">@(cust.CustomerGroupName ?? "—")</td>
                                    <td dir="ltr" class="td-muted">@(cust.Phone1 ?? cust.Mobile ?? "—")</td>
                                    <td class="td-muted">@(cust.City ?? "—")</td>
                                    <td class="td-muted">@(cust.CurrencyName ?? "—")</td>
                                    <td class="td-muted">@(cust.SalesRepName ?? "—")</td>
                                    <td class="num-cell">@cust.CreditLimit.ToString("#,##0.00")</td>
                                    <td class="num-cell @(cust.CurrentBalance>0?"bal-danger":"")"><strong>@cust.CurrentBalance.ToString("#,##0.00")</strong></td>
                                    <td class="td-center"><span class="status-badge-luxury @(cust.IsActive?"active":"inactive")">@(cust.IsActive?"نشط":"غير نشط")</span></td>
                                    <td class="td-center"><span class="rating-gold">@for(int i=1;i<=5;i++){<span class="@(i<=cust.Rating?"filled":"empty")">★</span>}</span></td>
                                    <td class="td-actions"><div class="actions-wrap-luxury">
                                        <button class="act-btn view" title="عرض" @onclick="() => GoToView(cust.CustomerID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
                                        @if (permissions.CanEdit){<button class="act-btn edit" title="تعديل" @onclick="() => GoToEdit(cust.CustomerID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                        @if (permissions.CanDelete){<button class="act-btn @(cust.IsActive?"delete":"activate")" title="@(cust.IsActive?"تعطيل":"تفعيل")" @onclick="() => ShowStatusConfirm(cust)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="@(cust.IsActive ? "M15 9l-6 6M9 9l6 6" : "M9 12l2 2 4-4")"/></svg></button>}
                                    </div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pagination-luxury">
                    <div class="pag-info">الصفحة @pagedResult.PageNumber من @Math.Max(pagedResult.TotalPages, 1) — إجمالي: @pagedResult.TotalCount</div>
                    <div class="pag-actions">
                        <button class="btn-luxury btn-ghost-luxury" @onclick="PreviousPage" disabled="@(!pagedResult.HasPrevious || isLoading)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg>السابق</button>
                        <button class="btn-luxury btn-ghost-luxury" @onclick="NextPage" disabled="@(!pagedResult.HasNext || isLoading)">التالي<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg></button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (showStatusDialog && selectedCustomer != null)
    {
        <div class="modal-overlay-luxury" @onclick="CloseStatusDialog"><div class="modal-card-luxury small" @onclick:stopPropagation="true">
            <div class="ml-gold-line @(selectedCustomer.IsActive?"danger":"")"></div>
            <div class="delete-icon-luxury @(selectedCustomer.IsActive?"danger":"success")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="@(selectedCustomer.IsActive ? "M15 9l-6 6M9 9l6 6" : "M9 12l2 2 4-4")"/></svg></div>
            <h4>@(selectedCustomer.IsActive ? "تأكيد تعطيل العميل" : "تأكيد إعادة التفعيل")</h4>
            <p>هل أنت متأكد من <strong>@(selectedCustomer.IsActive ? "تعطيل" : "إعادة تفعيل")</strong> العميل:</p>
            <strong class="delete-name">@selectedCustomer.CustomerNameAr</strong>
            @if (!string.IsNullOrEmpty(dialogMessage)){<div class="msg-luxury msg-error">@dialogMessage</div>}
            <div class="ml-footer center">
                <button class="btn-luxury @(selectedCustomer.IsActive?"btn-danger-luxury":"btn-success-luxury")" @onclick="ConfirmStatusChange" disabled="@isChangingStatus">@if(isChangingStatus){<div class="btn-spinner-sm"></div><span>جاري...</span>}else{<span>@(selectedCustomer.IsActive?"تعطيل":"إعادة تفعيل")</span>}</button>
                <button class="btn-luxury btn-ghost-luxury" @onclick="CloseStatusDialog" disabled="@isChangingStatus">إلغاء</button>
            </div>
        </div></div>
    }

    @if (!string.IsNullOrEmpty(resultMessage)){<div class="toast-luxury"><div class="toast-card-luxury @(resultSuccess?"success":"error")"><span>@resultMessage</span><button @onclick="ClearResultMessage">✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.2rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.74rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-luxury:disabled{opacity:.6;cursor:not-allowed}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-primary-luxury:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(212,175,55,.35)}.btn-export-luxury{background:linear-gradient(135deg,#059669,#10b981);color:#fff}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-ghost-luxury:hover{background:#fcfaf6;border-color:var(--gold)}.btn-danger-luxury{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}.btn-success-luxury{background:linear-gradient(135deg,#059669,#10b981);color:#fff}.btn-secondary-luxury{background:#f3f4f6;color:#374151}.btn-luxury svg{width:14px;height:14px}.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
.st-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.st-icon.dark{background:linear-gradient(135deg,var(--black2),var(--black3));color:var(--gold);border:1px solid var(--border-gold)}.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.st-icon.cyan{background:#ecfeff;color:#0891b2;border:1px solid #a5f3fc}.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.15)}.st-icon svg{width:18px;height:18px}.st-info{display:flex;flex-direction:column}.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}.st-gold-line{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}.stat-luxury:hover .st-gold-line{opacity:.8}
.filter-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;padding:18px;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}.filter-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.filter-grid-luxury{display:grid;grid-template-columns:2fr repeat(4,1fr) 120px;gap:12px;align-items:end}.field-luxury-sm{display:flex;flex-direction:column;gap:5px}.field-luxury-sm label{font-size:.74rem;font-weight:700;color:#6b7280}
.search-luxury{position:relative;display:flex;align-items:center}.search-luxury svg{position:absolute;right:12px;width:16px;height:16px;color:#9ca3af;pointer-events:none}.search-luxury input{width:100%;height:42px;padding:0 40px 0 36px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.86rem;font-family:'Tajawal';outline:none;background:#fcfaf6;transition:.2s}.search-luxury input:focus{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.08)}
