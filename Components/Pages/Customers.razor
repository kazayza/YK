.cust-name-wrap{display:flex;align-items:center;gap:8px}.cust-avatar{width:28px;height:28px;border-radius:8px;background:linear-gradient(135deg,var(--black2),var(--black3));color:var(--gold);display:flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:900;border:1px solid var(--border-gold)}
.type-badge-luxury{display:inline-block;padding:3px 10px;border-radius:999px;font-size:.7rem;font-weight:700}.type-cust-1{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.type-cust-2{background:#ecfeff;color:#0891b2;border:1px solid #a5f3fc}.type-cust-3{background:#fef3c7;color:#d97706;border:1px solid #fde68a}.type-cust-4{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.type-cust-5{background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb}
.status-badge-luxury{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.72rem;font-weight:800}.status-badge-luxury.active{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.status-badge-luxury.inactive{background:#fef2f2;color:#dc2626;border:1px solid #fecaca}
.rating-gold{font-size:.8rem}.rating-gold .filled{color:var(--gold)}.rating-gold .empty{color:#e8e2d0}
.actions-wrap-luxury{display:flex;gap:4px;justify-content:center}.act-btn{width:32px;height:32px;border-radius:10px;border:1.5px solid;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;background:#fff;transition:.2s}.act-btn.view{color:#2563eb;border-color:#bfdbfe}.act-btn.view:hover{background:#eff6ff}.act-btn.edit{color:var(--gold-dark);border-color:rgba(212,175,55,.2)}.act-btn.edit:hover{background:rgba(212,175,55,.08);border-color:var(--gold)}.act-btn.delete{color:#ef4444;border-color:#fee2e2}.act-btn.delete:hover{background:#fef2f2;border-color:#ef4444}.act-btn.activate{color:#059669;border-color:#a7f3d0}.act-btn.activate:hover{background:#ecfdf5}.act-btn svg{width:14px;height:14px}
.pagination-luxury{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;padding:14px 18px;border-top:1px solid #f3f4f6;background:#fafaf8}.pag-info{color:#6b7280;font-size:.82rem;font-weight:600}.pag-actions{display:flex;gap:8px}
.modal-overlay-luxury{position:fixed;inset:0;background:rgba(7,11,20,.55);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:1000;padding:16px}
.modal-card-luxury{position:relative;background:#fff;border-radius:20px;width:100%;max-width:420px;overflow:hidden;box-shadow:0 24px 48px rgba(0,0,0,.2);animation:modalIn .3s ease;border:1px solid #e8e2d0;text-align:center;padding:28px 24px}.ml-gold-line{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent)}.ml-gold-line.danger{background:linear-gradient(90deg,transparent,#ef4444,#dc2626,transparent)}
.delete-icon-luxury{width:64px;height:64px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px}.delete-icon-luxury.danger{background:#fef2f2;border:1px solid #fecaca;color:#ef4444}.delete-icon-luxury.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#059669}.delete-icon-luxury svg{width:32px;height:32px}.delete-name{display:block;font-size:1rem;font-weight:800;color:#0A0F1E;margin:8px 0}.ml-footer{display:flex;gap:8px;padding:14px 20px;border-top:1px solid #f1efe8;background:#fcfaf6;justify-content:center}.ml-footer.center{justify-content:center;background:transparent;border:none;padding-top:16px}
.msg-luxury{padding:10px 14px;border-radius:12px;font-size:.82rem;font-weight:600}.msg-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}.empty-luxury{text-align:center;padding:60px 20px;background:#fff;border-radius:18px;border:1px solid #e8e2d0}.empty-icon-luxury{width:56px;height:56px;margin:0 auto 12px;border-radius:14px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.empty-icon-luxury svg{width:28px;height:28px}.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}.no-access-luxury .na-icon{width:64px;height:64px;margin:0 auto 16px;border-radius:16px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.no-access-luxury .na-icon svg{width:32px;height:32px}
.toast-luxury{position:fixed;bottom:20px;left:20px;z-index:1050;animation:toastIn .35s ease}.toast-card-luxury{display:flex;align-items:center;gap:10px;padding:12px 18px;border-radius:14px;min-width:280px;font-weight:600;font-size:.84rem;box-shadow:0 12px 32px rgba(0,0,0,.12)}.toast-card-luxury.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.toast-card-luxury.error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.toast-card-luxury button{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-right:auto}
@@keyframes modalIn{from{opacity:0;transform:scale(.96) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}@@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
@@media(max-width:1100px){.filter-grid-luxury{grid-template-columns:1fr 1fr}.filter-grid-luxury .search-luxury{grid-column:span 2}}@@media(max-width:768px){.lh-content{flex-direction:column;align-items:flex-start}.stats-luxury{grid-template-columns:repeat(2,1fr)}.filter-grid-luxury{grid-template-columns:1fr}.filter-grid-luxury .search-luxury{grid-column:span 1}}
</style>

@code {
    private ModulePermissionDto? permissions;
    private CustomerFilterDto filters = new(){ PageNumber = 1, PageSize = 20, IsActive = true };
    private string statusFilter = "1";
    private CustomerPagedResult pagedResult = new();
    private CustomerStatsDto stats = new();
    private List<LookupDto>? customerGroups;
    private List<LookupDto>? salesReps;
    private bool isLoading = true;
    private bool isExporting = false;
    private bool isChangingStatus = false;
    private bool showStatusDialog = false;
    private CustomerListDto? selectedCustomer;
    private string dialogMessage = "";
    private string resultMessage = "";
    private bool resultSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn){Navigation.NavigateTo("/login");return;}
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_CUSTOMERS");
        if (permissions == null || !permissions.CanView) return;
        await LoadLookups();await LoadStats();await LoadData();
    }
    private async Task LoadLookups(){customerGroups = await LookupService.GetCustomerGroupsAsync();salesReps = await LookupService.GetSalesRepsAsync();}
    private async Task LoadStats(){stats = await CustomerService.GetCustomerStatsAsync();}
    private async Task LoadData()
    {
        isLoading = true;ApplyStatusFilter();
        try{pagedResult = await CustomerService.GetCustomersPagedAsync(filters);}
        catch (Exception ex){resultMessage="خطأ أثناء تحميل البيانات: "+ex.Message;resultSuccess=false;}
        finally{isLoading=false;}
    }
    private void ApplyStatusFilter(){filters.IsActive = statusFilter switch{"1"=>true,"0"=>false,_=>null};}
    private async Task SearchData(){filters.PageNumber=1;await LoadData();}
    private async Task RefreshData(){await LoadStats();await LoadData();}
    private async Task ClearFilters(){filters=new CustomerFilterDto{PageNumber=1,PageSize=filters.PageSize,IsActive=true};statusFilter="1";await LoadData();}
    private async Task OnPageSizeChanged(ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(), out var pageSize)){filters.PageSize=pageSize;filters.PageNumber=1;await LoadData();}}
    private async Task PreviousPage(){if(!pagedResult.HasPrevious)return;filters.PageNumber--;await LoadData();}
    private async Task NextPage(){if(!pagedResult.HasNext)return;filters.PageNumber++;await LoadData();}
    private void GoToAdd(){Navigation.NavigateTo("/customers/new");}
    private void GoToEdit(int customerId){Navigation.NavigateTo($"/customers/edit/{customerId}");}
    private void GoToView(int customerId){Navigation.NavigateTo($"/customers/view/{customerId}");}
    private void GoToPrint()
    {
        var queryParts = new List<string>();
        if (!string.IsNullOrWhiteSpace(filters.SearchText)) queryParts.Add($"search={Uri.EscapeDataString(filters.SearchText)}");
        if (filters.CustomerType > 0) queryParts.Add($"type={filters.CustomerType}");
        if (filters.CustomerGroupID > 0) queryParts.Add($"groupId={filters.CustomerGroupID}");
        if (filters.SalesRepID > 0) queryParts.Add($"salesRepId={filters.SalesRepID}");
        queryParts.Add($"status={Uri.EscapeDataString(statusFilter)}");
        var url = "/customers/print";if (queryParts.Any()) url += "?" + string.Join("&", queryParts);
        Navigation.NavigateTo(url);
    }
    private void ShowStatusConfirm(CustomerListDto customer){selectedCustomer=customer;dialogMessage="";showStatusDialog=true;}
    private void CloseStatusDialog(){showStatusDialog=false;selectedCustomer=null;dialogMessage="";}
    private async Task ConfirmStatusChange()
    {
        if (selectedCustomer==null)return;isChangingStatus=true;dialogMessage="";
        try{
            var newStatus=!selectedCustomer.IsActive;
            var result=await CustomerService.SetCustomerActiveStatusAsync(selectedCustomer.CustomerID,newStatus,UserSession.UserID);
            if(result.Success){resultMessage=result.Message;resultSuccess=true;showStatusDialog=false;selectedCustomer=null;await LoadStats();await LoadData();}
            else{dialogMessage=result.Message;}
        }catch(Exception ex){dialogMessage="خطأ: "+ex.Message;}finally{isChangingStatus=false;}
    }
    private async Task ExportFilteredData()
    {
        isExporting=true;
        try{
            ApplyStatusFilter();
            var exportItems=await CustomerService.GetCustomersReportAsync(filters);
            if(exportItems==null||!exportItems.Any()){resultMessage="لا توجد بيانات للتصدير";resultSuccess=false;return;}
            var fileBytes=await CustomerService.ExportCustomersToExcelAsync(exportItems, UserSession.UserID);
            var base64=Convert.ToBase64String(fileBytes);
            await JS.InvokeVoidAsync("downloadFile",$"Customers_Report_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",base64);
            resultMessage="تم تصدير التقرير بنجاح ✅";resultSuccess=true;
        }catch(Exception ex){resultMessage="خطأ أثناء التصدير: "+ex.Message;resultSuccess=false;}
        finally{isExporting=false;}
    }
    private void ClearResultMessage(){resultMessage="";}
}
