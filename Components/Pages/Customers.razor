@page "/customers"

@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject CustomerService CustomerService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>العملاء - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card">
        <div class="no-access-icon">🔒</div>
        <h4>يجب تسجيل الدخول أولاً</h4>
    </div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access-card">
        <div class="no-access-icon">⛔</div>
        <h4>ليس لديك صلاحية لعرض هذه الشاشة</h4>
        <button class="btn-modern btn-secondary-modern" @onclick='() => Navigation.NavigateTo("/dashboard")'>
            العودة للرئيسية
        </button>
    </div>
}
else
{
    <div class="items-page" dir="rtl">

        <div class="page-header">
            <div>
                <h2 class="page-title">العملاء</h2>
                <p class="page-subtitle">عرض وإدارة بيانات العملاء وجهات الاتصال</p>
            </div>

            <div class="header-actions">
                <span class="result-badge">@pagedResult.TotalCount عميل</span>

                                @if (permissions.CanExport)
                {
                    <button class="btn-modern btn-export"
                            @onclick="ExportFilteredData"
                            disabled="@isExporting">
                        @if (isExporting)
                        {
                            <div class="btn-spinner-sm"></div>
                            <span>جاري التصدير...</span>
                        }
                        else
                        {
                            <span>تصدير Excel</span>
                        }
                    </button>
                }

                @if (permissions.CanPrint)
                {
                    <button class="btn-modern btn-secondary-modern" @onclick="GoToPrint">
                        <span>طباعة / PDF</span>
                    </button>
                }

                @if (permissions.CanAdd)
                {
                    <button class="btn-modern btn-primary-modern" @onclick="GoToAdd">
                        <span class="btn-icon">+</span>
                        <span>إضافة عميل</span>
                    </button>
                }
            </div>
        </div>

        <div class="stats-grid">
            <div class="stat-card stat-total">
                <div class="stat-value">@stats.Total</div>
                <div class="stat-label">إجمالي العملاء</div>
            </div>

            <div class="stat-card stat-active">
                <div class="stat-value">@stats.TotalActive</div>
                <div class="stat-label">نشط</div>
            </div>

            <div class="stat-card stat-inactive">
                <div class="stat-value">@stats.TotalInactive</div>
                <div class="stat-label">غير نشط</div>
            </div>

            <div class="stat-card stat-wholesale">
                <div class="stat-value">@stats.TotalWholesale</div>
                <div class="stat-label">جملة</div>
            </div>

            <div class="stat-card stat-retail">
                <div class="stat-value">@stats.TotalRetail</div>
                <div class="stat-label">نص جملة / تجزئة</div>
            </div>

            <div class="stat-card stat-online">
                <div class="stat-value">@stats.TotalOnline</div>
                <div class="stat-label">أونلاين</div>
            </div>

            <div class="stat-card stat-balance">
                <div class="stat-value">@stats.TotalBalance.ToString("#,##0.00")</div>
                <div class="stat-label">إجمالي الأرصدة</div>
            </div>
        </div>

        <div class="filter-card">
            <div class="filter-grid">
                <div class="search-box">
                    <span class="search-icon">🔍</span>
                    <input type="text"
                           class="search-input"
                           placeholder="بحث بالاسم أو الكود أو الهاتف أو المدينة..."
                           @bind="filters.SearchText" />
                </div>

                <div>
                    <label class="filter-label">النوع</label>
                    <select class="filter-select" @bind="filters.CustomerType">
                        <option value="0">كل الأنواع</option>
                        <option value="1">جملة</option>
                        <option value="2">نص جملة</option>
                        <option value="3">تجزئة</option>
                        <option value="4">أونلاين</option>
                        <option value="5">مؤسسي</option>
                    </select>
                </div>

                <div>
                    <label class="filter-label">المجموعة</label>
                    <select class="filter-select" @bind="filters.CustomerGroupID">
                        <option value="0">كل المجموعات</option>
                        @if (customerGroups != null)
                        {
                            @foreach (var item in customerGroups)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label class="filter-label">المندوب</label>
                    <select class="filter-select" @bind="filters.SalesRepID">
                        <option value="0">كل المندوبين</option>
                        @if (salesReps != null)
                        {
                            @foreach (var item in salesReps)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label class="filter-label">الحالة</label>
                    <select class="filter-select" @bind="statusFilter">
                        <option value="1">نشط فقط</option>
                        <option value="0">غير نشط فقط</option>
                        <option value="all">الكل</option>
                    </select>
                </div>

                <div>
                    <label class="filter-label">عدد السجلات</label>
                    <select class="filter-select" value="@filters.PageSize" @onchange="OnPageSizeChanged">
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>

            <div class="filter-actions">
                <button class="btn-modern btn-primary-modern" @onclick="SearchData" disabled="@isLoading">
                    بحث
                </button>

                <button class="btn-modern btn-ghost" @onclick="ClearFilters" disabled="@isLoading">
                    مسح الفلاتر
                </button>

                <button class="btn-modern btn-ghost" @onclick="RefreshData" disabled="@isLoading">
                    تحديث
                </button>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-state">
                <div class="loader"></div>
                <p>جاري تحميل البيانات...</p>
            </div>
        }
        else if (!pagedResult.Items.Any())
        {
            <div class="empty-state">
                <div class="empty-icon">👥</div>
                <h4>لا توجد بيانات مطابقة</h4>
            </div>
        }
        else
        {
            <div class="table-card">
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th class="th-num">#</th>
                                <th>الكود</th>
                                <th>اسم العميل</th>
                                <th>النوع</th>
                                <th>المجموعة</th>
                                <th>الهاتف</th>
                                <th>المدينة</th>
                                <th>العملة</th>
                                <th>المندوب</th>
                                <th class="th-number">حد الائتمان</th>
                                <th class="th-number">الرصيد</th>
                                <th class="th-center">الحالة</th>
                                <th class="th-center">التقييم</th>
                                <th class="th-actions">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var rowIndex = ((filters.PageNumber - 1) * filters.PageSize);
                            }

                            @foreach (var cust in pagedResult.Items)
                            {
                                rowIndex++;

                                <tr>
                                    <td class="td-num">@rowIndex</td>
                                    <td><code class="item-code">@cust.CustomerCode</code></td>
                                    <td class="item-name">@cust.CustomerNameAr</td>
                                    <td>
                                        <span class="type-badge type-cust-@cust.CustomerType">
                                            @CustomerService.GetCustomerTypeName(cust.CustomerType)
                                        </span>
                                    </td>
                                    <td>@(cust.CustomerGroupName ?? "—")</td>
                                    <td dir="ltr">@(cust.Phone1 ?? cust.Mobile ?? "—")</td>
                                    <td>@(cust.City ?? "—")</td>
                                    <td>@(cust.CurrencyName ?? "—")</td>
                                    <td>@(cust.SalesRepName ?? "—")</td>
                                    <td class="td-number">@cust.CreditLimit.ToString("#,##0.00")</td>
                                    <td class="td-number">
                                        <span class="@(cust.CurrentBalance > 0 ? "balance-positive" : "")">
                                            @cust.CurrentBalance.ToString("#,##0.00")
                                        </span>
                                    </td>
                                    <td class="td-center">
                                        <span class="status-badge @(cust.IsActive ? "status-active" : "status-inactive")">
                                            @(cust.IsActive ? "نشط" : "غير نشط")
                                        </span>
                                    </td>
                                    <td class="td-center">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            <span class="@(i <= cust.Rating ? "star-filled" : "star-empty")">★</span>
                                        }
                                    </td>
                                    <td class="td-actions">
                                        <div class="actions-wrap">
                                            <button class="action-btn view-btn" title="عرض" @onclick="() => GoToView(cust.CustomerID)">
                                                عرض
                                            </button>

                                            @if (permissions.CanEdit)
                                            {
                                                <button class="action-btn edit-btn" title="تعديل" @onclick="() => GoToEdit(cust.CustomerID)">
                                                    تعديل
                                                </button>
                                            }

                                            @if (permissions.CanDelete)
                                            {
                                                <button class="action-btn @(cust.IsActive ? "delete-btn" : "restore-btn")"
                                                        title="@(cust.IsActive ? "تعطيل" : "إعادة تفعيل")"
                                                        @onclick="() => ShowStatusConfirm(cust)">
                                                    @(cust.IsActive ? "تعطيل" : "تفعيل")
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pagination-bar">
                    <div class="pagination-info">
                        الصفحة @pagedResult.PageNumber من @Math.Max(pagedResult.TotalPages, 1)
                        — إجمالي السجلات: @pagedResult.TotalCount
                    </div>

                    <div class="pagination-actions">
                        <button class="btn-modern btn-ghost"
                                @onclick="PreviousPage"
                                disabled="@(!pagedResult.HasPrevious || isLoading)">
                            السابق
                        </button>

                        <button class="btn-modern btn-ghost"
                                @onclick="NextPage"
                                disabled="@(!pagedResult.HasNext || isLoading)">
                            التالي
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (showStatusDialog && selectedCustomer != null)
    {
        <div class="modal-overlay" @onclick="CloseStatusDialog">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-icon @(selectedCustomer.IsActive ? "delete-modal-icon" : "restore-modal-icon")">
                    @(selectedCustomer.IsActive ? "⚠️" : "✅")
                </div>

                <h4>@(selectedCustomer.IsActive ? "تأكيد تعطيل العميل" : "تأكيد إعادة التفعيل")</h4>

                <p>
                    هل أنت متأكد من
                    <strong>@(selectedCustomer.IsActive ? "تعطيل" : "إعادة تفعيل")</strong>
                    العميل:
                    <strong>@selectedCustomer.CustomerNameAr</strong>؟
                </p>

                @if (!string.IsNullOrEmpty(dialogMessage))
                {
                    <div class="form-message msg-error">@dialogMessage</div>
                }

                <div class="modal-buttons-row center-buttons">
                    <button class="btn-modern @(selectedCustomer.IsActive ? "btn-danger-modern" : "btn-success-modern")"
                            @onclick="ConfirmStatusChange"
                            disabled="@isChangingStatus">
                        @if (isChangingStatus)
                        {
                            <div class="btn-spinner-sm"></div>
                            <span>جاري التنفيذ...</span>
                        }
                        else
                        {
                            <span>@(selectedCustomer.IsActive ? "تعطيل" : "إعادة تفعيل")</span>
                        }
                    </button>

                    <button class="btn-modern btn-ghost" @onclick="CloseStatusDialog" disabled="@isChangingStatus">
                        إلغاء
                    </button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <div class="toast-container">
            <div class="toast-card @(resultSuccess ? "toast-success" : "toast-error")">
                <span class="toast-text">@resultMessage</span>
                <button class="toast-close" @onclick="ClearResultMessage">✕</button>
            </div>
        </div>
    }
}

<style>
    .items-page { display: flex; flex-direction: column; gap: 20px; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; }
    .page-title { font-weight: 800; color: #1f2937; margin: 0; }
    .page-subtitle { color: #6b7280; font-size: .9rem; margin: 4px 0 0; }
    .header-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .result-badge { background: #f3f4f6; color: #4b5563; padding: 8px 16px; border-radius: 999px; font-size: .82rem; font-weight: 700; }

    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr)); gap: 14px; }
    .stat-card { background: white; border-radius: 18px; padding: 18px; text-align: center; border: 1px solid #eef2f7; box-shadow: 0 4px 12px rgba(15,23,42,.04); }
    .stat-value { font-size: 1.5rem; font-weight: 800; color: #1f2937; }
    .stat-label { font-size: .8rem; color: #6b7280; margin-top: 4px; }
    .stat-total { border-top: 3px solid #1f2937; }
    .stat-active { border-top: 3px solid #10b981; }
    .stat-inactive { border-top: 3px solid #ef4444; }
    .stat-wholesale { border-top: 3px solid #2563eb; }
    .stat-retail { border-top: 3px solid #06b6d4; }
    .stat-online { border-top: 3px solid #f59e0b; }
    .stat-balance { border-top: 3px solid #1d4ed8; }

    .filter-card { background: white; border-radius: 20px; padding: 18px; border: 1px solid #eef2f7; box-shadow: 0 4px 16px rgba(15,23,42,.04); }
    .filter-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; }
    .filter-label { display: block; font-size: .8rem; color: #6b7280; font-weight: 700; margin-bottom: 6px; }

    .search-box { position: relative; }
    .search-icon { position: absolute; right: 14px; top: 38px; transform: translateY(-50%); color: #9ca3af; pointer-events: none; }
    .search-input { width: 100%; padding: 12px 16px 12px 42px; border: 1.5px solid #e5e7eb; border-radius: 14px; font-size: .92rem; background: white; outline: none; transition: .2s; }
    .search-input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
    .filter-select { width: 100%; padding: 12px 14px; border: 1.5px solid #e5e7eb; border-radius: 14px; font-size: .88rem; background: white; outline: none; }

    .filter-actions { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 16px; }

    .table-card { background: white; border-radius: 20px; overflow: hidden; border: 1px solid #eef2f7; box-shadow: 0 4px 16px rgba(15,23,42,.04); }
    .table-responsive { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; min-width: 1250px; }
    .data-table thead { background: #f8f9fc; }
    .data-table th { padding: 14px 16px; font-size: .82rem; font-weight: 700; color: #6b7280; text-align: right; border-bottom: 2px solid #eef2f7; white-space: nowrap; }
    .data-table td { padding: 13px 16px; font-size: .88rem; color: #374151; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
    .data-table tbody tr:hover { background: #f8f7ff; }

    .th-num { width: 50px; text-align: center; }
    .th-center { text-align: center; }
    .th-number { text-align: left; }
    .th-actions { width: 220px; text-align: center; }

    .td-num { text-align: center; color: #9ca3af; }
    .td-center { text-align: center; }
    .td-number { text-align: left; font-family: monospace; font-weight: 700; }
    .td-actions { text-align: center; }
    .actions-wrap { display: flex; gap: 6px; justify-content: center; flex-wrap: wrap; }

    .item-code { background: #f3f4f6; padding: 4px 10px; border-radius: 8px; font-size: .82rem; color: #1d4ed8; font-weight: 600; }
    .item-name { font-weight: 700; color: #1f2937; }
    .balance-positive { color: #dc2626; font-weight: 700; }

    .type-badge { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: .78rem; font-weight: 700; }
    .type-cust-1 { background: #eff6ff; color: #2563eb; }
    .type-cust-2 { background: #ecfeff; color: #0891b2; }
    .type-cust-3 { background: #fef3c7; color: #d97706; }
    .type-cust-4 { background: #ecfdf5; color: #059669; }
    .type-cust-5 { background: #f3f4f6; color: #6b7280; }

    .status-badge { display: inline-block; padding: 5px 12px; border-radius: 999px; font-size: .76rem; font-weight: 800; }
    .status-active { background: #ecfdf5; color: #059669; }
    .status-inactive { background: #fef2f2; color: #dc2626; }

    .star-filled { color: #f59e0b; }
    .star-empty { color: #e5e7eb; }

    .action-btn { display: inline-flex; align-items: center; justify-content: center; padding: 6px 10px; border-radius: 10px; border: 1.5px solid; background: transparent; font-size: .76rem; font-weight: 700; cursor: pointer; transition: .2s; min-width: 56px; }
    .view-btn { color: #2563eb; border-color: #dbeafe; }
    .view-btn:hover { background: #eff6ff; }
    .edit-btn { color: #1d4ed8; border-color: #e9e0ff; }
    .edit-btn:hover { background: #f5f3ff; }
    .delete-btn { color: #ef4444; border-color: #fee2e2; }
    .delete-btn:hover { background: #fef2f2; }
    .restore-btn { color: #059669; border-color: #d1fae5; }
    .restore-btn:hover { background: #ecfdf5; }

    .btn-modern { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; border-radius: 14px; border: none; font-weight: 700; font-size: .88rem; cursor: pointer; transition: .2s; }
    .btn-modern:disabled { opacity: .6; cursor: not-allowed; }
    .btn-primary-modern { background: linear-gradient(135deg, #1d4ed8, #2563eb); color: white; box-shadow: 0 4px 16px rgba(37,99,235,.25); }
    .btn-primary-modern:hover:not(:disabled) { transform: translateY(-1px); }
    .btn-danger-modern { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; }
    .btn-success-modern { background: linear-gradient(135deg, #059669, #10b981); color: white; }
    .btn-secondary-modern { background: #f3f4f6; color: #374151; }
    .btn-ghost { background: transparent; color: #6b7280; border: 1.5px solid #e5e7eb; }
    .btn-ghost:hover:not(:disabled) { background: #f9fafb; }
    .btn-export { background: linear-gradient(135deg, #059669, #10b981); color: white; }
    .btn-icon { font-size: 1.1rem; font-weight: 800; }

    .btn-spinner-sm { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.3); border-top-color: white; border-radius: 50%; animation: spin .6s linear infinite; }

    .pagination-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 16px; }
    .pagination-info { color: #6b7280; font-size: .86rem; font-weight: 600; }
    .pagination-actions { display: flex; gap: 10px; }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 20px; }
    .modal-card { background: white; border-radius: 24px; padding: 30px; max-width: 440px; width: 90%; text-align: center; box-shadow: 0 24px 48px rgba(0,0,0,.15); }
    .modal-icon { width: 64px; height: 64px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px; font-size: 1.8rem; }
    .delete-modal-icon { background: #fef2f2; color: #ef4444; }
    .restore-modal-icon { background: #ecfdf5; color: #059669; }
    .center-buttons { justify-content: center; }
    .modal-buttons-row { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }

    .form-message { padding: 10px 14px; border-radius: 12px; font-size: .85rem; font-weight: 600; margin-top: 12px; }
    .msg-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

    .toast-container { position: fixed; bottom: 24px; left: 24px; z-index: 1050; animation: toastIn .4s ease; }
    .toast-card { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-radius: 16px; box-shadow: 0 12px 32px rgba(0,0,0,.12); min-width: 320px; }
    .toast-success { background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; }
    .toast-error { background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; }
    .toast-text { flex: 1; font-weight: 600; font-size: .88rem; }
    .toast-close { background: transparent; border: none; font-size: 1rem; cursor: pointer; color: inherit; opacity: .6; }

    .loading-state { text-align: center; padding: 60px 20px; color: #6b7280; }
    .loader { width: 40px; height: 40px; border: 3px solid #e5e7eb; border-top-color: #1d4ed8; border-radius: 50%; animation: spin .7s linear infinite; margin: 0 auto 16px; }
    .empty-state { text-align: center; padding: 60px 20px; background: white; border-radius: 20px; border: 1px solid #eef2f7; }
    .empty-icon { font-size: 3rem; margin-bottom: 16px; }
    .no-access-card { text-align: center; padding: 80px 20px; background: white; border-radius: 24px; border: 1px solid #eef2f7; }
    .no-access-icon { font-size: 3.5rem; margin-bottom: 16px; }

    @@keyframes spin { to { transform: rotate(360deg); } }
    @@keyframes toastIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

    @@media (max-width: 768px) {
        .page-header { flex-direction: column; }
        .filter-actions { flex-direction: column; }
        .header-actions { width: 100%; }
        .btn-modern { width: 100%; }
        .pagination-bar { flex-direction: column; align-items: stretch; }
        .pagination-actions { width: 100%; }
        .pagination-actions .btn-modern { flex: 1; }
    }
</style>

@code {
    private ModulePermissionDto? permissions;

    private CustomerFilterDto filters = new()
    {
        PageNumber = 1,
        PageSize = 20,
        IsActive = true
    };

    private string statusFilter = "1";

    private CustomerPagedResult pagedResult = new();
    private CustomerStatsDto stats = new();

    private List<LookupDto>? customerGroups;
    private List<LookupDto>? salesReps;

    private bool isLoading = true;
    private bool isExporting = false;
    private bool isChangingStatus = false;

    private bool showStatusDialog = false;
    private CustomerListDto? selectedCustomer;
    private string dialogMessage = "";

    private string resultMessage = "";
    private bool resultSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_CUSTOMERS");

        if (permissions == null || !permissions.CanView)
            return;

        await LoadLookups();
        await LoadStats();
        await LoadData();
    }

    private async Task LoadLookups()
    {
        customerGroups = await LookupService.GetCustomerGroupsAsync();
        salesReps = await LookupService.GetSalesRepsAsync();
    }

    private async Task LoadStats()
    {
        stats = await CustomerService.GetCustomerStatsAsync();
    }

    private async Task LoadData()
    {
        isLoading = true;
        ApplyStatusFilter();

        try
        {
            pagedResult = await CustomerService.GetCustomersPagedAsync(filters);
        }
        catch (Exception ex)
        {
            resultMessage = "خطأ أثناء تحميل البيانات: " + ex.Message;
            resultSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyStatusFilter()
    {
        filters.IsActive = statusFilter switch
        {
            "1" => true,
            "0" => false,
            _ => null
        };
    }

    private async Task SearchData()
    {
        filters.PageNumber = 1;
        await LoadData();
    }

    private async Task RefreshData()
    {
        await LoadStats();
        await LoadData();
    }

    private async Task ClearFilters()
    {
        filters = new CustomerFilterDto
        {
            PageNumber = 1,
            PageSize = filters.PageSize,
            IsActive = true
        };

        statusFilter = "1";

        await LoadData();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var pageSize))
        {
            filters.PageSize = pageSize;
            filters.PageNumber = 1;
            await LoadData();
        }
    }

    private async Task PreviousPage()
    {
        if (!pagedResult.HasPrevious)
            return;

        filters.PageNumber--;
        await LoadData();
    }

    private async Task NextPage()
    {
        if (!pagedResult.HasNext)
            return;

        filters.PageNumber++;
        await LoadData();
    }

    private void GoToAdd()
    {
        Navigation.NavigateTo("/customers/new");
    }

    private void GoToEdit(int customerId)
    {
        Navigation.NavigateTo($"/customers/edit/{customerId}");
    }

    private void GoToView(int customerId)
    {
        Navigation.NavigateTo($"/customers/view/{customerId}");
    }
        private void GoToPrint()
    {
        var queryParts = new List<string>();

        if (!string.IsNullOrWhiteSpace(filters.SearchText))
            queryParts.Add($"search={Uri.EscapeDataString(filters.SearchText)}");

        if (filters.CustomerType > 0)
            queryParts.Add($"type={filters.CustomerType}");

        if (filters.CustomerGroupID > 0)
            queryParts.Add($"groupId={filters.CustomerGroupID}");

        if (filters.SalesRepID > 0)
            queryParts.Add($"salesRepId={filters.SalesRepID}");

        queryParts.Add($"status={Uri.EscapeDataString(statusFilter)}");

        var url = "/customers/print";

        if (queryParts.Any())
            url += "?" + string.Join("&", queryParts);

        Navigation.NavigateTo(url);
    }
    private void ShowStatusConfirm(CustomerListDto customer)
    {
        selectedCustomer = customer;
        dialogMessage = "";
        showStatusDialog = true;
    }

    private void CloseStatusDialog()
    {
        showStatusDialog = false;
        selectedCustomer = null;
        dialogMessage = "";
    }

    private async Task ConfirmStatusChange()
    {
        if (selectedCustomer == null)
            return;

        isChangingStatus = true;
        dialogMessage = "";

        try
        {
            var newStatus = !selectedCustomer.IsActive;
            var result = await CustomerService.SetCustomerActiveStatusAsync(
                selectedCustomer.CustomerID,
                newStatus,
                UserSession.UserID);

            if (result.Success)
            {
                resultMessage = result.Message;
                resultSuccess = true;
                showStatusDialog = false;
                selectedCustomer = null;

                await LoadStats();
                await LoadData();
            }
            else
            {
                dialogMessage = result.Message;
            }
        }
        catch (Exception ex)
        {
            dialogMessage = "خطأ: " + ex.Message;
        }
        finally
        {
            isChangingStatus = false;
        }
    }

        private async Task ExportFilteredData()
    {
        isExporting = true;

        try
        {
            ApplyStatusFilter();

            var exportItems = await CustomerService.GetCustomersReportAsync(filters);

            if (exportItems == null || !exportItems.Any())
            {
                resultMessage = "لا توجد بيانات للتصدير";
                resultSuccess = false;
                return;
            }

            var fileBytes = await CustomerService.ExportCustomersToExcelAsync(exportItems, UserSession.UserID);
            var base64 = Convert.ToBase64String(fileBytes);

            await JS.InvokeVoidAsync(
                "downloadFile",
                $"Customers_Report_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                base64);

            resultMessage = "تم تصدير التقرير بنجاح ✅";
            resultSuccess = true;
        }
        catch (Exception ex)
        {
            resultMessage = "خطأ أثناء التصدير: " + ex.Message;
            resultSuccess = false;
        }
        finally
        {
            isExporting = false;
        }
    }

    private void ClearResultMessage()
    {
        resultMessage = "";
    }
}