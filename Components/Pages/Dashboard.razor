    private string GetInitials()
    {
        if (string.IsNullOrWhiteSpace(UserSession.FullName)) return "U";
        var parts = UserSession.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : parts[0][0].ToString().ToUpper();
    }

