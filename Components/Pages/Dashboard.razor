@code {
    private DashboardStatsDto? stats;
    private List<RecentActivityDto>? recentActivities;
    private DashboardPendingDto? pending;
    private DashboardInventoryAlertsDto? invAlerts;
    private DashboardOverdueDto? overdue;
    private DashboardPurchaseStatsDto? purchaseStats;
    private List<DashboardItemAlertDto>? itemAlerts;
    private List<MonthlyChartDto>? chartData;
    private bool _loaded = false;
    private bool _animateIn = false;
    private bool _refreshing = false;
    private DateTime _lastRefresh = DateTime.Now;

    // ==========================================
    // Permissions
    // ==========================================
    private bool CanViewPurchases =>
        PermissionService.CanView("SCR_PR") ||
        PermissionService.CanView("SCR_PO") ||
        PermissionService.CanView("SCR_PINV");

    private bool CanViewStock =>
        PermissionService.CanView("SCR_STOCK") ||
        PermissionService.CanView("SCR_WAREHOUSES");

    private bool CanViewFinance =>
        PermissionService.CanView("SCR_COA") ||
        PermissionService.CanView("SCR_JV") ||
        PermissionService.CanView("SCR_PINV");

    // ==========================================
    // Load Data
    // ==========================================
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_loaded)
        {
            _loaded = true;

            if (!UserSession.IsLoggedIn)
            {
                var restored = await UserSession.TryRestoreSessionAsync();
                if (!restored)
                {
                    Navigation.NavigateTo("/login");
                    return;
                }
            }

            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(UserSession.UserID);

            await LoadAllData();

            _animateIn = true;
            StateHasChanged();
        }
    }

    // ==========================================
    // تحميل كل البيانات
    // ==========================================
    private async Task LoadAllData()
    {
        try
        {
            var t1 = DashboardService.GetStatsAsync();
            var t2 = DashboardService.GetRecentActivitiesAsync(8);
            var t3 = CanViewPurchases
                ? DashboardService.GetPendingApprovalsAsync()
                : Task.FromResult<DashboardPendingDto?>(null)!;
            var t4 = CanViewStock
                ? DashboardService.GetInventoryAlertsAsync()
                : Task.FromResult<DashboardInventoryAlertsDto?>(null)!;
            var t5 = CanViewFinance
                ? DashboardService.GetOverdueInfoAsync()
                : Task.FromResult<DashboardOverdueDto?>(null)!;
            var t6 = CanViewPurchases
                ? DashboardService.GetMonthlyPurchaseStatsAsync()
                : Task.FromResult<DashboardPurchaseStatsDto?>(null)!;
            var t7 = CanViewStock
                ? DashboardService.GetTopItemAlertsAsync(5)
                : Task.FromResult<List<DashboardItemAlertDto>?>(null)!;
            var t8 = CanViewPurchases
                ? DashboardService.GetMonthlyPurchaseChartAsync()
                : Task.FromResult<List<MonthlyChartDto>?>(null)!;

            await Task.WhenAll(t1, t2, t3, t4, t5, t6, t7, t8);

            stats = t1.Result;
            recentActivities = t2.Result;
            pending = t3.Result;
            invAlerts = t4.Result;
            overdue = t5.Result;
            purchaseStats = t6.Result;
            itemAlerts = t7.Result;
            chartData = t8.Result;

            _lastRefresh = DateTime.Now;
        }
        catch { /* Log if needed */ }
    }

    // ==========================================
    // تحديث البيانات يدوياً
    // ==========================================
    private async Task RefreshData()
    {
        if (_refreshing) return;

        _refreshing = true;
        StateHasChanged();

        await LoadAllData();

        _refreshing = false;
        StateHasChanged();
    }

    // ==========================================
    // أسماء الشهور بالعربي
    // ==========================================
    private static readonly Dictionary<int, string> ArabicMonths = new()
    {
        { 1, "يناير" },
        { 2, "فبراير" },
        { 3, "مارس" },
        { 4, "أبريل" },
        { 5, "مايو" },
        { 6, "يونيو" },
        { 7, "يوليو" },
        { 8, "أغسطس" },
        { 9, "سبتمبر" },
        { 10, "أكتوبر" },
        { 11, "نوفمبر" },
        { 12, "ديسمبر" }
    };

    private string GetArabicMonthName(string? monthKey)
    {
        if (string.IsNullOrEmpty(monthKey)) return "—";

        try
        {
            // monthKey بيكون بالشكل "2026-04"
            var parts = monthKey.Split('-');
            if (parts.Length == 2 && int.TryParse(parts[1], out int monthNum))
            {
                return ArabicMonths.ContainsKey(monthNum) ? ArabicMonths[monthNum] : monthKey;
            }
        }
        catch { }

        return monthKey;
    }

    // ==========================================
