@code {
    [Parameter] public int ReceiptId { get; set; }

    private GoodsReceiptHeaderDto header = new() { GRNDate = DateTime.Today, InspectionStatus = 1 };
    private List<GoodsReceiptDetailDto> details = new();
    private ModulePermissionDto? permissions;

    private List<LookupDto>? warehouses;
    private List<LookupDto>? employees;
    private List<LookupDto>? units;
    private List<SearchableItem>? suppliersSearchable;
    private List<SearchableItem>? purchaseItems;
    private List<SearchableItem>? availablePOs;

    private List<POLineForGRNDto>? poLines;
    private int selectedPOId;
    private bool isPOLoaded = false;
    private bool isSourceLocked = false;

    private bool isLoading = true;
    private bool isSaving = false;
    private string toast = "";
    private bool toastOk = true;

    private bool showLineForm = false;
    private bool isEditLine = false;
    private GoodsReceiptDetailEditDto editLine = new();
    private bool isSavingLine = false;
    private string lineMsg = "";
    private bool lineMsgOk = true;

    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => ReceiptId == 0;

    private bool canApprove =>
        !isNewMode && !isViewMode &&
        header.GRNStatus == 1 &&
        details.Any() &&
        (permissions?.CanApprove ?? false);

    private bool isReadOnly
    {
        get
        {
            if (isViewMode) return true;
            if (isNewMode) return false;
            return header.GRNStatus != 1;
        }
    }

    private string pageTitle
    {
        get
        {
            if (isNewMode) return "إذن استلام جديد";
            if (isViewMode) return "عرض إذن استلام";
            if (canApprove) return "اعتماد إذن استلام";
            return "تعديل إذن استلام";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
            if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_GRN");
            if (permissions == null || !permissions.CanView) return;

            await LoadLookups();

            if (ReceiptId > 0)
                await LoadReceiptData();
            else
            {
                var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                var source = query["source"];
                if (source == "po")
                {
                    header.GRNSource = 1;
                    availablePOs = await LookupService.GetPOsForGRNSearchableAsync();
                }
                else if (source == "direct")
                {
                    header.GRNSource = 2;
                    isSourceLocked = true;
                }
            }
        }
        catch (Exception ex) { await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task LoadLookups()
    {
        warehouses = await LookupService.GetReceivingWarehousesAsync();
        employees = await LookupService.GetEmployeesAsync();
        units = await LookupService.GetUnitsAsync();
        suppliersSearchable = await LookupService.GetSuppliersSearchableAsync();
        purchaseItems = await LookupService.GetItemsForPurchaseSearchableAsync();
    }

    private async Task LoadReceiptData()
    {
        var loaded = await GrnService.GetReceiptByIdAsync(ReceiptId);
        if (loaded != null)
        {
            header = loaded;
            details = await GrnService.GetReceiptDetailsAsync(ReceiptId);
            isSourceLocked = true;
            isPOLoaded = true;
        }
        else
            await ShowToastAsync("إذن الاستلام غير موجود", false);
    }

    private void SelectPOSource()
    {
        header.GRNSource = 1;
        _ = Task.Run(async () =>
        {
            availablePOs = await LookupService.GetPOsForGRNSearchableAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private void SelectDirectSource()
    {
        header.GRNSource = 2;
        isSourceLocked = true;
        poLines = null;
        selectedPOId = 0;
    }

    private async Task OnPOSelected(SearchableItem? item)
    {
        if (item == null || item.Id == 0) { poLines = null; return; }
        selectedPOId = item.Id;
        header.PurchaseOrderID = item.Id;

        try
        {
            poLines = await LookupService.GetPOLinesForGRNAsync(item.Id);
            foreach (var line in poLines)
            {
                line.IsSelected = true;
                line.QtyToReceive = line.RemainingToReceive;
            }

            var poInfo = (await LookupService.GetPOsForGRNAsync())
                .FirstOrDefault(p => p.PurchaseOrderID == item.Id);

            if (poInfo != null)
            {
                header.SupplierID = poInfo.SupplierID;
                if (poInfo.WarehouseID.HasValue)
                    header.WarehouseID = poInfo.WarehouseID.Value;
            }
        }
        catch (Exception ex) { await ShowToastAsync("خطأ: " + ex.Message, false); }
    }

    private void ToggleAllPOLines(ChangeEventArgs e)
    {
        if (poLines == null) return;
        var val = (bool)(e.Value ?? false);
        foreach (var l in poLines) l.IsSelected = val;
    }

    private async Task OnItemSelected(SearchableItem? item)
    {
        if (item == null) return;
        editLine.ItemID = item.Id;
        var info = await LookupService.GetItemQuickInfoAsync(item.Id);
        if (info != null)
        {
            if (info.UnitID > 0) editLine.UnitID = info.UnitID;
            if (info.EstimatedPrice > 0) editLine.UnitCost = info.EstimatedPrice;
        }
        StateHasChanged();
    }

    private async Task SaveReceipt()
    {
        if (header.SupplierID <= 0) { await ShowToastAsync("اختر المورد", false); return; }
        if (header.WarehouseID <= 0) { await ShowToastAsync("اختر المخزن", false); return; }

        isSaving = true; StateHasChanged();
        try
        {
            if (isNewMode)
            {
                header.GRNNumber = await GrnService.GenerateGRNNumberAsync();
                header.GRNStatus = 1;
                var newId = await GrnService.InsertReceiptAsync(header, UserSession.UserID);
                ReceiptId = newId;
                header.GRNID = newId;

                if (header.GRNSource == 1 && poLines != null)
                {
                    var selectedLines = poLines.Where(l => l.IsSelected && l.QtyToReceive > 0).ToList();
                    if (selectedLines.Any())
                    {
                        var imported = await GrnService.ImportLinesFromPOAsync(newId, header.PurchaseOrderID ?? 0, selectedLines, UserSession.UserID);
                        await ShowToastAsync($"تم الإنشاء وتحميل {imported} صنف ✅");
                    }
                    else
                        await ShowToastAsync($"تم الإنشاء: {header.GRNNumber} ✅");
                }
                else
                    await ShowToastAsync($"تم الإنشاء: {header.GRNNumber} ✅");

                isSourceLocked = true;
                isPOLoaded = true;
                details = await GrnService.GetReceiptDetailsAsync(newId);
                header = await GrnService.GetReceiptByIdAsync(newId) ?? header;
                Navigation.NavigateTo($"/goods-receipts/edit/{newId}", forceLoad: false);
            }
            else
            {
                await GrnService.UpdateReceiptAsync(header, UserSession.UserID);
                header = await GrnService.GetReceiptByIdAsync(ReceiptId) ?? header;
                await ShowToastAsync("تم الحفظ ✅");
            }
        }
        catch (Exception ex) { await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally { isSaving = false; }
    }

    private async Task SendForInspection()
    {
        if (!details.Any()){ await ShowToastAsync("أضف أصناف أولاً", false); return; }
        isSaving = true; StateHasChanged();
        try
        {
            await GrnService.UpdateReceiptAsync(header, UserSession.UserID);
            await GrnService.RequestInspectionAsync(ReceiptId, UserSession.UserID);
            await ShowToastAsync("تم إرسال طلب الفحص ✅");
        }
        catch (Exception ex){ await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally{ isSaving = false; }
    }

    private async Task SendForApproval()
    {
        if (!details.Any()){ await ShowToastAsync("أضف أصناف أولاً", false); return; }
        if (header.InspectionStatus != 2){ await ShowToastAsync("يجب إتمام الفحص وقبول البضاعة قبل طلب الاعتماد", false); return; }
        isSaving = true; StateHasChanged();
        try
        {
            await GrnService.UpdateReceiptAsync(header, UserSession.UserID);
            await GrnService.RequestApprovalAsync(ReceiptId, UserSession.UserID);
            await ShowToastAsync("تم إرسال طلب الاعتماد ✅");
        }
        catch (Exception ex){ await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally{ isSaving = false; }
    }

    private async Task ExecuteApprove()
    {
        if (!details.Any()){ toast = "لا يمكن اعتماد إذن استلام بدون أصناف"; toastOk = false; StateHasChanged(); return; }
        try{ var confirmed = await JS.InvokeAsync<bool>("confirm","هل تريد اعتماد إذن الاستلام؟"); if (!confirmed) return; } catch { return; }
        isSaving = true; toast = ""; StateHasChanged();
        try
        {
            await GrnService.ApproveAsync(ReceiptId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            header.GRNStatus = 2; toast = "تم اعتماد إذن الاستلام بنجاح ✅"; toastOk = true; isSaving = false; StateHasChanged();
            await Task.Delay(2000); Navigation.NavigateTo("/goods-receipts");
        }
        catch (Exception ex){ isSaving = false; toast = "خطأ في الاعتماد: " + ex.Message; toastOk = false; StateHasChanged(); }
    }

    private async Task ExecuteCancel()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "هل تريد إلغاء إذن الاستلام؟");
        if (!confirmed) return;
        try{ await GrnService.CancelAsync(ReceiptId, UserSession.UserID); header.GRNStatus = 4; await ShowToastAsync("تم الإلغاء"); await Task.Delay(1500); Navigation.NavigateTo("/goods-receipts"); }
        catch (Exception ex) { await ShowToastAsync("خطأ: " + ex.Message, false); }
    }

    private void ShowAddLine(){ isEditLine = false; editLine = new() { GRNID = ReceiptId, QualityStatus = 1 }; lineMsg = ""; showLineForm = true; }
    private void ShowEditLine(GoodsReceiptDetailDto line)
    {
        isEditLine = true;
        editLine = new()
        {
            GRNDetailID = line.GRNDetailID, GRNID = line.GRNID,
            ItemID = line.ItemID, UnitID = line.UnitID,
            OrderedQty = line.OrderedQty,
            ReceivedQty = line.ReceivedQty,
            AcceptedQty = line.AcceptedQty,
            RejectedQty = line.RejectedQty,
            BatchNumber = line.BatchNumber,
            ExpiryDate = line.ExpiryDate,
            ManufactureDate = line.ManufactureDate,
            UnitCost = line.UnitCost,
            QualityStatus = line.QualityStatus,
            QualityNotes = line.QualityNotes,
            StorageLocation = line.StorageLocation,
            Notes = line.Notes,
            PODetailID = line.PODetailID
        };
        lineMsg = ""; showLineForm = true;
    }
    private void CloseLineForm() { showLineForm = false; lineMsg = ""; }

    private async Task SaveLine()
    {
        lineMsg = "";
        if (editLine.ItemID == 0) { lineMsg = "اختر الصنف"; lineMsgOk = false; return; }
        if (editLine.UnitID == 0) { lineMsg = "اختر الوحدة"; lineMsgOk = false; return; }
        if (editLine.ReceivedQty <= 0) { lineMsg = "أدخل الكمية المستلمة"; lineMsgOk = false; return; }
        if (isNewMode && ReceiptId == 0){ await SaveReceipt(); if (ReceiptId == 0) return; editLine.GRNID = ReceiptId; }
        isSavingLine = true; StateHasChanged();
        try
        {
            if (isEditLine) await GrnService.UpdateDetailAsync(editLine, UserSession.UserID);
            else await GrnService.InsertDetailAsync(editLine, UserSession.UserID);
            details = await GrnService.GetReceiptDetailsAsync(ReceiptId);
            showLineForm = false;
            await ShowToastAsync(isEditLine ? "تم التحديث ✅" : "تم الإضافة ✅");
        }
        catch (Exception ex) { lineMsg = "خطأ: " + ex.Message; lineMsgOk = false; }
        finally { isSavingLine = false; }
    }

    private async Task DeleteLine(int detailId)
    {
        try{ await GrnService.DeleteDetailAsync(detailId, UserSession.UserID); details = await GrnService.GetReceiptDetailsAsync(ReceiptId); await ShowToastAsync("تم الحذف ✅"); }
        catch (Exception ex) { await ShowToastAsync("خطأ: " + ex.Message, false); }
    }

    private async Task PrintDoc()
    {
        try{ var html = await GrnService.GenerateReportHtmlAsync(ReceiptId, UserSession.UserID); await JS.InvokeVoidAsync("printHtml", html); }
        catch (Exception ex) { await ShowToastAsync("خطأ: " + ex.Message, false); }
    }

    private void GoBack() => Navigation.NavigateTo("/goods-receipts");

    private async Task ShowToastAsync(string message, bool ok = true)
    {
        toast = message; toastOk = ok; StateHasChanged();
        await Task.Delay(4000); toast = ""; StateHasChanged();
    }
}
