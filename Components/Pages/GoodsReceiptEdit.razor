@page "/goods-receipts/new"
@page "/goods-receipts/edit/{ReceiptId:int}"
@page "/goods-receipts/view/{ReceiptId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject GoodsReceiptService GrnService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access"><div class="na-icon">🔒</div><h4>يجب تسجيل الدخول</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access"><div class="na-icon">⛔</div><h4>ليس لديك صلاحية</h4></div>
}
else
{
    <div class="doc-page" dir="rtl">

        <!-- Header -->
        <div class="doc-header">
            <div class="doc-header-right">
                <button class="btn-m btn-ghost" @onclick="GoBack">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5"/><path d="m12 19 7-7-7-7"/>
                    </svg> رجوع
                </button>
                <div>
                    <h2 class="doc-title">@pageTitle</h2>
                    @if (!string.IsNullOrEmpty(header.GRNNumber))
                    {
                        <div class="doc-num-wrap">
                            <code class="doc-number">@header.GRNNumber</code>
                            <span class="status-chip" style="--sc:@GoodsReceiptService.GetStatusColor(header.GRNStatus)">
                                @GoodsReceiptService.GetStatusName(header.GRNStatus)
                            </span>
                        </div>
                    }
                </div>
            </div>
            <div class="doc-header-left">
                @if (permissions.CanPrint && ReceiptId > 0)
                {
                    <button class="btn-m btn-outline" @onclick="PrintDoc">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 6 2 18 2 18 9"/>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                            <rect x="6" y="14" width="12" height="8"/>
                        </svg> طباعة
                    </button>
                }
            </div>
        </div>

        <!-- Approval Bar -->
        @if (canApprove)
        {
            <div class="approval-bar">
                <span class="approval-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
                    </svg>
                    إذن الاستلام جاهز للاعتماد
                </span>
                <button type="button" class="appr-btn appr-quick" @onclick="ExecuteApprove" disabled="@isSaving">
                    @if (isSaving) { <div class="btn-spin"></div> }
                    else { <span>✅</span> }
                    اعتماد الاستلام
                </button>
                <button type="button" class="appr-btn appr-reject" @onclick="ExecuteCancel" disabled="@isSaving">
                    ❌ إلغاء
                </button>
            </div>
        }

        @if (isLoading)
        {
            <div class="loading-st"><div class="loader"></div><p>جاري التحميل...</p></div>
        }
        else
        {
            <!-- مصدر الاستلام (جديد فقط) -->
            @if (isNewMode && !isSourceLocked)
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon purple">📦</div>
                        <h3 class="sec-title">مصدر الاستلام</h3>
                    </div>
                    <div class="source-cards">
                        <div class="source-card @(header.GRNSource == 1 ? "active" : "")" @onclick="SelectPOSource">
                            <div class="source-card-icon" style="background:#ecfeff;color:#0891b2;">📋</div>
                            <div class="source-card-title">من أمر شراء</div>
                            <div class="source-card-desc">استلام بناءً على أمر شراء مرسل للمورد</div>
                        </div>
                        <div class="source-card @(header.GRNSource == 2 ? "active" : "")" @onclick="SelectDirectSource">
                            <div class="source-card-icon" style="background:#f5f3ff;color:#1d4ed8;">✏️</div>
                            <div class="source-card-title">استلام مباشر</div>
                            <div class="source-card-desc">استلام بضاعة بدون أمر شراء مسبق</div>
                        </div>
                    </div>
                </div>
            }

            <!-- اختيار أمر الشراء -->
            @if (header.GRNSource == 1 && isNewMode && !isPOLoaded)
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon cyan">📄</div>
                        <h3 class="sec-title">اختيار أمر الشراء</h3>
                    </div>
                    <div class="form-grid c2">
                        <div class="f-field">
                            <label class="f-label required">أمر الشراء</label>
                            <SearchableSelect Items="@availablePOs" @bind-SelectedId="selectedPOId"
                                              OnSelected="OnPOSelected" Placeholder="ابحث برقم أمر الشراء..." />
                        </div>
                    </div>

                    @if (poLines != null && poLines.Any())
                    {
                        <div class="po-lines-section">
                            <h4 class="po-lines-title">الأصناف المتبقية للاستلام</h4>
                            <div class="tbl-card" style="margin-top:10px;">
                                <table class="tbl">
                                    <thead>
                                        <tr>
                                            <th class="tc" style="width:40px;">
                                                <input type="checkbox" checked="@poLines.All(l => l.IsSelected)"
                                                       @onchange="ToggleAllPOLines" />
                                            </th>
                                            <th>الكود</th>
                                            <th>الصنف</th>
                                            <th>الوحدة</th>
                                            <th class="tc">مطلوب</th>
                                            <th class="tc">تم استلامه</th>
                                            <th class="tc">متبقي</th>
                                            <th class="tc">الكمية المستلمة الآن</th>
                                            <th>رقم الباتش</th>
                                            <th>الصلاحية</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in poLines)
                                        {
                                            <tr class="@(!line.IsSelected ? "tr-deselected" : "")">
                                                <td class="tc"><input type="checkbox" @bind="line.IsSelected" /></td>
                                                <td><code class="code-tag">@line.ItemCode</code></td>
                                                <td class="td-bold">@line.ItemNameAr</td>
                                                <td>@line.UnitName</td>
                                                <td class="tc">@line.OrderedQty.ToString("#,##0.##")</td>
                                                <td class="tc">@line.ReceivedQty.ToString("#,##0.##")</td>
                                                <td class="tc"><strong class="remaining-qty">@line.RemainingToReceive.ToString("#,##0.##")</strong></td>
                                                <td class="tc">
                                                    <input type="number" class="inline-input" @bind="line.QtyToReceive"
                                                           step="0.01" min="0" max="@line.RemainingToReceive"
                                                           disabled="@(!line.IsSelected)" />
                                                </td>
                                                <td>
                                                    <input type="text" class="inline-input" @bind="line.BatchNumber"
                                                           placeholder="باتش..." disabled="@(!line.IsSelected)" />
                                                </td>
                                                <td>
                                                    <input type="date" class="inline-input" @bind="line.ExpiryDate"
                                                           disabled="@(!line.IsSelected)" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- بيانات الإذن -->
            @if (header.GRNSource > 0 || !isNewMode)
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon blue">📝</div>
                        <h3 class="sec-title">بيانات إذن الاستلام</h3>
                    </div>
                    <div class="form-grid c4">
                        <div class="f-field">
                            <label class="f-label">رقم الإذن</label>
                            <input type="text" class="f-input readonly" value="@(header.GRNNumber ?? "تلقائي")" disabled />
                        </div>
                        <div class="f-field">
                            <label class="f-label required">التاريخ</label>
                            <input type="date" class="f-input" @bind="header.GRNDate" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label required">المورد</label>
                            @if (header.GRNSource == 1 && header.SupplierID > 0)
                            {
                                <input type="text" class="f-input readonly" value="@header.SupplierNameAr" disabled />
                            }
                            else
                            {
                                <SearchableSelect Items="@suppliersSearchable" @bind-SelectedId="header.SupplierID"
                                                  Placeholder="اختر المورد..." IsDisabled="@isReadOnly" />
                            }
                        </div>
                        <div class="f-field">
                            <label class="f-label required">المخزن</label>
                            <select class="f-input" @bind="header.WarehouseID" disabled="@isReadOnly">
                                <option value="0">-- اختر --</option>
                                @if (warehouses != null)
                                {
                                    @foreach (var w in warehouses)
                                    { <option value="@w.Id">@w.Name</option> }
                                }
                            </select>
                        </div>
                        <div class="f-field">
                            <label class="f-label">المستلم</label>
                            <select class="f-input" @bind="header.ReceivedBy" disabled="@isReadOnly">
                                <option value="0">-- اختر --</option>
                                @if (employees != null)
                                {
                                    @foreach (var e in employees)
                                    { <option value="@e.Id">@e.Name</option> }
                                }
                            </select>
                        </div>
                        <div class="f-field">
                            <label class="f-label">فاتورة المورد</label>
                            <input type="text" class="f-input" @bind="header.SupplierInvoiceNo" disabled="@isReadOnly" placeholder="رقم فاتورة المورد..." />
                        </div>
                        <div class="f-field">
                            <label class="f-label">تاريخ فاتورة المورد</label>
                            <input type="date" class="f-input" @bind="header.SupplierInvoiceDate" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">إذن التسليم</label>
                            <input type="text" class="f-input" @bind="header.DeliveryNoteNo" disabled="@isReadOnly" placeholder="رقم إذن التسليم..." />
                        </div>
                    </div>

                    <!-- الفحص -->
                    <div class="form-grid c4" style="margin-top:14px;">
                        <div class="f-field">
                            <label class="f-label">الفاحص</label>
                            <select class="f-input" @bind="header.InspectedBy" disabled="@isReadOnly">
                                <option value="0">-- اختر --</option>
                                @if (employees != null)
                                {
                                    @foreach (var e in employees)
                                    { <option value="@e.Id">@e.Name</option> }
                                }
                            </select>
                        </div>
                        <div class="f-field">
                            <label class="f-label">حالة الفحص</label>
                            <select class="f-input" @bind="header.InspectionStatus" disabled="@isReadOnly">
                                <option value="1">لم يتم الفحص</option>
                                <option value="2">مقبول</option>
                                <option value="3">مرفوض</option>
                            </select>
                        </div>
                        <div class="f-field c2">
                            <label class="f-label">ملاحظات الفحص</label>
                            <input type="text" class="f-input" @bind="header.InspectionNotes" disabled="@isReadOnly" placeholder="ملاحظات..." />
                        </div>
                    </div>

                    <div class="form-grid c1" style="margin-top:14px;">
                        <div class="f-field">
                            <label class="f-label">ملاحظات</label>
                            <input type="text" class="f-input" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات عامة..." />
                        </div>
                    </div>
                </div>
            }

            <!-- الأصناف المستلمة -->
            @if ((header.GRNSource > 0 || !isNewMode) && (ReceiptId > 0 || isSourceLocked))
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon green">📦</div>
                        <h3 class="sec-title">الأصناف المستلمة</h3>
                        <span class="sec-badge">@details.Count صنف</span>
                        @if (!isReadOnly && permissions.CanAdd)
                        {
                            <button class="btn-m btn-primary btn-sm" @onclick="ShowAddLine" style="margin-right:auto;">
                                + إضافة صنف
                            </button>
                        }
                    </div>

                    @if (!details.Any() && !showLineForm)
                    {
                        <div class="empty-lines"><p>لا توجد أصناف مستلمة.</p></div>
                    }
                    else
                    {
                        <div class="tbl-card">
                            <table class="tbl">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>الكود</th>
                                        <th>الصنف</th>
                                        <th>الوحدة</th>
                                        <th class="tc">مستلم</th>
                                        <th class="tc">مقبول</th>
                                        <th class="tc">مرفوض</th>
                                        <th>الباتش</th>
                                        <th>الصلاحية</th>
                                        <th class="tl">التكلفة</th>
                                        <th class="tl">الإجمالي</th>
                                        <th class="tc">الجودة</th>
                                        @if (!isReadOnly)
                                        { <th class="tc">إجراءات</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int n = 0; }
                                    @foreach (var line in details)
                                    {
                                        n++;
                                        <tr>
                                            <td class="td-n">@n</td>
                                            <td><code class="code-tag">@line.ItemCode</code></td>
                                            <td class="td-bold">@line.ItemNameAr</td>
                                            <td>@line.UnitName</td>
                                            <td class="tc">@line.ReceivedQty.ToString("#,##0.##")</td>
                                            <td class="tc">@(line.AcceptedQty?.ToString("#,##0.##") ?? "—")</td>
                                            <td class="tc">
                                                @if (line.RejectedQty > 0)
                                                { <span class="rejected-badge">@line.RejectedQty.ToString("#,##0.##")</span> }
                                                else { <span>0</span> }
                                            </td>
                                            <td>@(line.BatchNumber ?? "—")</td>
                                            <td>@(line.ExpiryDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                            <td class="tl num-cell">@line.UnitCost.ToString("#,##0.00")</td>
                                            <td class="tl num-cell"><strong>@line.LineTotalCost.ToString("#,##0.00")</strong></td>
                                            <td class="tc">
                                                <span class="quality-badge" style="--qc:@GoodsReceiptService.GetInspectionColor(line.QualityStatus)">
                                                    @GoodsReceiptService.GetQualityStatusName(line.QualityStatus)
                                                </span>
                                            </td>
                                            @if (!isReadOnly)
                                            {
                                                <td class="tc">
                                                    <div class="line-actions">
                                                        @if (permissions.CanEdit)
                                                        {
                                                            <button class="act-btn edit" @onclick="() => ShowEditLine(line)">✏️</button>
                                                        }
                                                        @if (permissions.CanDelete)
                                                        {
                                                            <button class="act-btn del" @onclick="() => DeleteLine(line.GRNDetailID)">🗑️</button>
                                                        }
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="total-row">
                                        <td colspan="10" class="tl"><strong>الإجمالي</strong></td>
                                        <td class="tl num-cell"><strong>@details.Sum(d => d.LineTotalCost).ToString("#,##0.00") ج.م</strong></td>
                                        <td colspan="@(!isReadOnly ? 2 : 1)"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }

                    <!-- Line Form -->
                    @if (showLineForm)
                    {
                        <div class="line-form">
                            <div class="line-form-head">
                                <h4>@(isEditLine ? "تعديل صنف" : "إضافة صنف")</h4>
                                <button class="btn-close-x" @onclick="CloseLineForm">✕</button>
                            </div>
                            <div class="form-grid c3">
                                <div class="f-field">
                                    <label class="f-label required">الصنف</label>
                                    <SearchableSelect Items="@purchaseItems" @bind-SelectedId="editLine.ItemID"
                                                      OnSelected="OnItemSelected" Placeholder="ابحث..." IsDisabled="@isEditLine" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label required">الوحدة</label>
                                    <select class="f-input" @bind="editLine.UnitID">
                                        <option value="0">-- اختر --</option>
                                        @if (units != null)
                                        { @foreach (var u in units) { <option value="@u.Id">@u.Name</option> } }
                                    </select>
                                </div>
                                <div class="f-field">
                                    <label class="f-label required">الكمية المستلمة</label>
                                    <input type="number" class="f-input" @bind="editLine.ReceivedQty" step="0.01" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">الكمية المقبولة</label>
                                    <input type="number" class="f-input" @bind="editLine.AcceptedQty" step="0.01" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">الكمية المرفوضة</label>
                                    <input type="number" class="f-input" @bind="editLine.RejectedQty" step="0.01" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label required">تكلفة الوحدة</label>
                                    <input type="number" class="f-input" @bind="editLine.UnitCost" step="0.01" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">رقم الباتش</label>
                                    <input type="text" class="f-input" @bind="editLine.BatchNumber" placeholder="Batch..." />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">تاريخ الإنتاج</label>
                                    <input type="date" class="f-input" @bind="editLine.ManufactureDate" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">تاريخ الصلاحية</label>
                                    <input type="date" class="f-input" @bind="editLine.ExpiryDate" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">حالة الجودة</label>
                                    <select class="f-input" @bind="editLine.QualityStatus">
                                        <option value="1">انتظار فحص</option>
                                        <option value="2">مقبول</option>
                                        <option value="3">مرفوض</option>
                                    </select>
                                </div>
                                <div class="f-field">
                                    <label class="f-label">موقع التخزين</label>
                                    <input type="text" class="f-input" @bind="editLine.StorageLocation" placeholder="رف / منطقة..." />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">ملاحظات</label>
                                    <input type="text" class="f-input" @bind="editLine.Notes" placeholder="ملاحظات..." />
                                </div>
                            </div>
                            <div class="line-calc-bar">
                                <span>الإجمالي: <strong>@editLine.LineTotalCost.ToString("#,##0.00") ج.م</strong></span>
                            </div>
                            @if (!string.IsNullOrEmpty(lineMsg))
                            { <div class="form-msg @(lineMsgOk ? "msg-ok" : "msg-err")">@lineMsg</div> }
                            <div class="line-form-btns">
                                <button class="btn-m btn-primary" @onclick="SaveLine" disabled="@isSavingLine">
                                    @if (isSavingLine) { <div class="btn-spin"></div> }
                                    @(isEditLine ? "تحديث" : "إضافة")
                                </button>
                                <button class="btn-m btn-ghost" @onclick="CloseLineForm">إلغاء</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- أزرار الحفظ -->
@if (!isViewMode && !canApprove)
{
    <div class="doc-actions">
        <div class="doc-actions-right">
            @if (!isReadOnly)
            {
                <button class="btn-m btn-primary" @onclick="SaveReceipt" disabled="@isSaving">
                    @if (isSaving) { <div class="btn-spin"></div> }
                    @(isNewMode ? "حفظ إذن الاستلام" : "حفظ التعديلات")
                </button>

                @if (ReceiptId > 0 && header.GRNStatus == 1 && details.Any())
                {
                    @if (header.InspectionStatus == 1)
                    {
                        <button class="btn-m btn-inspect" @onclick="SendForInspection" disabled="@isSaving">
                            🔍 إرسال للفحص
                        </button>
                    }

                    @if (header.InspectionStatus == 2)
                    {
                        <button class="btn-m btn-warning" @onclick="SendForApproval" disabled="@isSaving">
                            📤 إرسال للاعتماد
                        </button>
                    }
                }
            }
        </div>
        <button class="btn-m btn-ghost" @onclick="GoBack">رجوع</button>
    </div>
}
        }
    </div>

    <!-- Toast -->
    @if (!string.IsNullOrEmpty(toast))
    {
        <div class="toast-wrap">
            <div class="toast @(toastOk ? "t-ok" : "t-err")">
                <span>@toast</span>
                <button @onclick='() => toast = ""'>✕</button>
            </div>
        </div>
    }
}
<style>
    .doc-page { display:flex; flex-direction:column; gap:18px; max-width:1200px; }
    .doc-header { display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:14px; }
    .doc-header-right { display:flex; align-items:flex-start; gap:14px; }
    .doc-header-left { display:flex; gap:8px; }
    .doc-title { font-weight:800; color:#0f172a; margin:0; font-size:1.2rem; }
    .doc-num-wrap { display:flex; align-items:center; gap:10px; margin-top:6px; }
    .doc-number { background:#f1f5f9; padding:4px 14px; border-radius:8px; font-size:.88rem; color:#2563eb; font-weight:700; }
    .status-chip { display:inline-block; padding:4px 12px; border-radius:999px; font-size:.75rem; font-weight:700; background:color-mix(in srgb, var(--sc) 12%, white); color:var(--sc); }
    .approval-bar { display:flex; align-items:center; gap:8px; padding:10px 16px; background:linear-gradient(135deg,#ecfdf5,#f0fdf4); border:1.5px solid #a7f3d0; border-radius:14px; flex-wrap:wrap; }
    .approval-label { display:flex; align-items:center; gap:6px; font-size:.82rem; font-weight:700; color:#065f46; padding-left:10px; border-left:2px solid #a7f3d0; margin-left:4px; }
    .appr-btn { display:inline-flex; align-items:center; gap:6px; padding:9px 18px; border-radius:10px; border:none; font-weight:700; font-size:.84rem; cursor:pointer; transition:.2s; }
    .appr-btn:disabled { opacity:.6; cursor:not-allowed; }
    .appr-quick { background:linear-gradient(135deg,#059669,#10b981); color:white; }
    .appr-reject { background:white; color:#dc2626; border:1.5px solid #fecaca; }
    .source-cards { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; }
