    private void ToggleAllPOLines(ChangeEventArgs e)
    {
        if (poLines == null) return;
        var val = (bool)(e.Value ?? false);
        foreach (var l in poLines) l.IsSelected = val;
    }

    private async Task OnItemSelected(SearchableItem? item)
    {
        ResetSelectedItemInfoLoadState();
        if (item == null || item.Id == 0)
        {
            editLine.ItemID = 0;
            return;
        }

        editLine.ItemID = item.Id;
        await LoadSelectedItemInfoAsync(item.Id);
    }

    private async Task LoadSelectedItemInfoAsync(int itemId)
    {
        if (!showLineForm || isEditLine || editLine.ItemID != itemId || isSelectedItemInfoLoading) return;

        var requestVersion = ++selectedItemInfoLoadVersion;
        var userId = UserSession.UserID;
        isSelectedItemInfoLoading = true;
        selectedItemInfoLoadFailed = false;
        selectedItemInfoLoadDenied = false;
        selectedItemInfoNotFound = false;
        selectedItemInfoLoadError = string.Empty;
        StateHasChanged();

        try
        {
            var info = await LookupService.GetItemQuickInfoAsync(itemId);
            if (!IsCurrentSelectedItemInfoRequest(requestVersion, itemId, userId)) return;
            if (info == null)
            {
                selectedItemInfoNotFound = true;
                selectedItemInfoLoadError = "تعذر العثور على معلومات الصنف المحدد.";
                return;
            }

            if (info.UnitID > 0) editLine.UnitID = info.UnitID;
            if (info.EstimatedPrice > 0) editLine.UnitCost = info.EstimatedPrice;
            selectedItemInfoLoaded = true;
            selectedItemInfoLoadedId = itemId;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading selected item information for goods receipt.");
            if (!IsCurrentSelectedItemInfoRequest(requestVersion, itemId, userId)) return;
            selectedItemInfoLoadDenied = true;
            selectedItemInfoLoadError = "ليس لديك صلاحية قراءة معلومات الصنف.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load selected item information for goods receipt.");
            if (!IsCurrentSelectedItemInfoRequest(requestVersion, itemId, userId)) return;
            selectedItemInfoLoadFailed = true;
            selectedItemInfoLoadError = selectedItemInfoLoaded
                ? "تعذر تحديث معلومات الصنف؛ القيم السابقة ما زالت معروضة. أعد المحاولة."
                : "تعذر تحميل معلومات الصنف. أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == selectedItemInfoLoadVersion)
            {
                isSelectedItemInfoLoading = false;
                StateHasChanged();
            }
        }
    }

    private bool IsCurrentSelectedItemInfoRequest(int requestVersion, int itemId, int userId) =>
        requestVersion == selectedItemInfoLoadVersion &&
        (selectedItemInfoLoadedId == 0 || selectedItemInfoLoadedId == itemId) &&
        showLineForm && !isEditLine && editLine.ItemID == itemId &&
        UserSession.IsLoggedIn && UserSession.UserID == userId;

    private async Task RetryLoadSelectedItemInfoAsync()
    {
        if (isSelectedItemInfoLoading || editLine.ItemID <= 0) return;
        await LoadSelectedItemInfoAsync(editLine.ItemID);
    }

    private void ResetSelectedItemInfoLoadState()
    {
        selectedItemInfoLoadVersion++;
        isSelectedItemInfoLoading = false;
        selectedItemInfoLoaded = false;
        selectedItemInfoLoadedId = 0;
        selectedItemInfoLoadFailed = false;
        selectedItemInfoLoadDenied = false;
        selectedItemInfoNotFound = false;
        selectedItemInfoLoadError = string.Empty;
    }

    private async Task SaveReceipt()
    {
        if (header.SupplierID <= 0) { await ShowToastAsync("اختر المورد", false); return; }
        if (header.WarehouseID <= 0) { await ShowToastAsync("اختر المخزن المبدئي؛ ويمكن تغيير مخزن كل صنف على سطره", false); return; }

        isSaving = true; StateHasChanged();
        try
        {
            if (isNewMode)
            {
                header.GRNNumber = await GrnService.GenerateGRNNumberAsync();
                header.GRNStatus = 1;
                var newId = await GrnService.InsertReceiptAsync(header, UserSession.UserID);
                ReceiptId = newId;
                header.GRNID = newId;
                receiptDataLoaded = true;

                if (header.GRNSource == 1 && poLines != null)
                {
                    var selectedLines = poLines.Where(l => l.IsSelected && l.QtyToReceive > 0).ToList();
                    if (selectedLines.Any())
                    {
                        var imported = await GrnService.ImportLinesFromPOAsync(newId, header.PurchaseOrderID ?? 0, selectedLines, UserSession.UserID);
                        await ShowToastAsync($"تم الإنشاء وتحميل {imported} صنف ");
                    }
                    else
                        await ShowToastAsync($"تم الإنشاء: {header.GRNNumber} ");
                }
                else
                    await ShowToastAsync($"تم الإنشاء: {header.GRNNumber} ");

                isSourceLocked = true;
                isPOLoaded = true;
                await RefreshReceiptDetailsAfterWriteAsync(newId);
                await RefreshReceiptHeaderAfterWriteAsync(newId);
                Navigation.NavigateTo($"/goods-receipts/edit/{newId}", forceLoad: false);
            }
            else
            {
                await GrnService.UpdateReceiptAsync(header, UserSession.UserID);
                await RefreshReceiptHeaderAfterWriteAsync(ReceiptId);
                await ShowToastAsync("تم الحفظ ");
            }
        }
        catch (Exception ex) { await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally { isSaving = false; }
    }

    private async Task SendForInspection()
    {
        if (!details.Any()){ await ShowToastAsync("أضف الأصناف واحفظها أولاً", false); return; }
        if (header.AssignedInspectorID.GetValueOrDefault() <= 0){ await ShowToastAsync("حدد مسئول الفحص أولاً", false); return; }
        isSaving = true; StateHasChanged();
        try
        {
            await GrnService.UpdateReceiptAsync(header, UserSession.UserID);
            await GrnService.RequestInspectionAsync(ReceiptId, UserSession.UserID);
            await RefreshReceiptHeaderAfterWriteAsync(ReceiptId);
            var inspectorName = string.IsNullOrWhiteSpace(header.AssignedInspectorName) ? "المسئول المحدد" : header.AssignedInspectorName;
            await ShowToastAsync($"تم إرسال الإذن للفحص إلى {inspectorName}. سيظهر الإشعار داخل التطبيق.");
        }
        catch (Exception ex){ await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally{ isSaving = false; }
    }

    private async Task SubmitInspectionAsync()
    {
        if (!canInspect){ await ShowToastAsync("لا يمكنك تسجيل فحص هذا الإذن", false); return; }
        if (details.Any(d => !d.AcceptedQty.HasValue))
        {
            await ShowToastAsync("حدد الكمية المقبولة لكل صنف؛ وسيتم حساب المرفوض تلقائيًا", false);
            return;
        }

        isSaving = true; StateHasChanged();
        try
        {
            var result = await GrnService.CompleteInspectionAsync(
                ReceiptId,
                details.Select(d => new GoodsReceiptInspectionLineEditDto
                {
                    GRNDetailID = d.GRNDetailID,
                    AcceptedQty = d.AcceptedQty,
                    QualityNotes = d.QualityNotes
                }).ToList(),
                inspectionNotesDraft,
                UserSession.UserID);

            await RefreshReceiptDetailsAfterWriteAsync(ReceiptId);
            await RefreshReceiptHeaderAfterWriteAsync(ReceiptId);
            await ShowToastAsync(result == 2
                ? "تم تسجيل الفحص وإرسال إشعار الاعتماد؛ سيُرحّل المخزون عند الاعتماد النهائي"
                : "تم تسجيل نتيجة الفحص بالرفض وإشعار منشئ الإذن", result == 2);
        }
        catch (Exception ex){ await ShowToastAsync("خطأ في تسجيل الفحص: " + ex.Message, false); }
        finally{ isSaving = false; }
    }

    private async Task ExecuteApprove()
    {
        if (!canApprove){ await ShowToastAsync("لا يمكن اعتماد الإذن قبل قبول الفحص من المسئول المحدد", false); return; }
        try{ var confirmed = await JS.InvokeAsync<bool>("confirm","هل تريد اعتماد الإذن وترحيل الكميات المقبولة إلى المخزون؟"); if (!confirmed) return; } catch { return; }
        isSaving = true; toastGeneration++; toast = string.Empty; StateHasChanged();
        try
        {
            await GrnService.ApproveAsync(ReceiptId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            header.GRNStatus = 2;
            isSaving = false;
            await ShowToastAsync("تم اعتماد الإذن وترحيل الكميات المقبولة بنجاح");
            Navigation.NavigateTo("/goods-receipts");
        }
        catch (Exception ex){ isSaving = false; await ShowToastAsync("خطأ في الاعتماد والترحيل: " + ex.Message, false); }
    }

    private async Task ExecuteCancel()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "هل تريد إلغاء إذن الاستلام؟");
        if (!confirmed) return;
        try{ await GrnService.CancelAsync(ReceiptId, UserSession.UserID); header.GRNStatus = 4; await ShowToastAsync("تم الإلغاء"); await Task.Delay(1500); Navigation.NavigateTo("/goods-receipts"); }
        catch (Exception ex) { await ShowToastAsync("خطأ: " + ex.Message, false); }
    }

    private void ShowAddLine(){ ResetSelectedItemInfoLoadState(); isEditLine = false; editLine = new() { GRNID = ReceiptId, WarehouseID = header.WarehouseID, QualityStatus = 1 }; lineMsg = ""; showLineForm = true; }
    private void ShowEditLine(GoodsReceiptDetailDto line)
    {
        ResetSelectedItemInfoLoadState();
        isEditLine = true;
        editLine = new()
        {
            GRNDetailID = line.GRNDetailID, GRNID = line.GRNID,
            ItemID = line.ItemID, UnitID = line.UnitID, WarehouseID = line.WarehouseID,
            OrderedQty = line.OrderedQty,
            ReceivedQty = line.ReceivedQty,
            AcceptedQty = line.AcceptedQty,
            RejectedQty = line.RejectedQty,
            BatchNumber = line.BatchNumber,
            SupplierBatchNumber = line.SupplierBatchNumber,
            ExpiryDate = line.ExpiryDate,
            ManufactureDate = line.ManufactureDate,
            UnitCost = line.UnitCost,
            QualityStatus = line.QualityStatus,
            QualityNotes = line.QualityNotes,
            StorageLocation = line.StorageLocation,
            Notes = line.Notes,
            PODetailID = line.PODetailID
        };
        lineMsg = ""; showLineForm = true;
    }
    private void CloseLineForm() { ResetSelectedItemInfoLoadState(); showLineForm = false; lineMsg = ""; }

    private async Task SaveLine()
    {
        lineMsg = "";
        if (isSelectedItemInfoLoading) { lineMsg = "جارٍ تحميل معلومات الصنف؛ انتظر قبل إضافة الصنف."; lineMsgOk = false; return; }
        if (editLine.ItemID == 0) { lineMsg = "اختر الصنف"; lineMsgOk = false; return; }
        if (editLine.UnitID == 0) { lineMsg = "اختر الوحدة"; lineMsgOk = false; return; }
        if (editLine.WarehouseID <= 0) { lineMsg = "اختر مخزنًا لهذا الصنف"; lineMsgOk = false; return; }
        if (editLine.ReceivedQty <= 0) { lineMsg = "أدخل الكمية المستلمة"; lineMsgOk = false; return; }
        if (isNewMode && ReceiptId == 0){ await SaveReceipt(); if (ReceiptId == 0) return; editLine.GRNID = ReceiptId; }
        isSavingLine = true; StateHasChanged();
        try
        {
            if (isEditLine) await GrnService.UpdateDetailAsync(editLine, UserSession.UserID);
            else await GrnService.InsertDetailAsync(editLine, UserSession.UserID);
            await RefreshReceiptDetailsAfterWriteAsync(ReceiptId);
            ResetSelectedItemInfoLoadState();
            showLineForm = false;
            await ShowToastAsync(isEditLine ? "تم التحديث " : "تم الإضافة ");
        }
        catch (Exception ex) { lineMsg = "خطأ: " + ex.Message; lineMsgOk = false; }
        finally { isSavingLine = false; }
    }

    private async Task DeleteLine(int detailId)
    {
        try{ await GrnService.DeleteDetailAsync(detailId, UserSession.UserID); await RefreshReceiptDetailsAfterWriteAsync(ReceiptId); await ShowToastAsync("تم الحذف "); }
        catch (Exception ex) { await ShowToastAsync("خطأ: " + ex.Message, false); }
    }

    private async Task PrintDoc()
    {
        if (isPrinting || ReceiptId <= 0) return;

        var requestVersion = ++printRequestVersion;
        var receiptId = ReceiptId;
        var userId = UserSession.UserID;
        isPrinting = true;
        printLoadFailed = false;
        printLoadDenied = false;
        printError = string.Empty;
        StateHasChanged();

        try
        {
            var html = await GrnService.GenerateReportHtmlAsync(receiptId, userId);
            if (!IsCurrentPrintRequest(requestVersion, receiptId, userId)) return;
            await JS.InvokeVoidAsync("printHtml", html);
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied generating goods receipt printout {GoodsReceiptID}.", receiptId);
            if (!IsCurrentPrintRequest(requestVersion, receiptId, userId)) return;
            printLoadDenied = true;
            printError = "ليس لديك صلاحية طباعة إذن الاستلام.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to generate goods receipt printout {GoodsReceiptID}.", receiptId);
            if (!IsCurrentPrintRequest(requestVersion, receiptId, userId)) return;
            printLoadFailed = true;
            printError = "تعذر تجهيز تقرير الطباعة. أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == printRequestVersion)
            {
                isPrinting = false;
                StateHasChanged();
            }
        }
    }

    private bool IsCurrentPrintRequest(int requestVersion, int receiptId, int userId) =>
        requestVersion == printRequestVersion && ReceiptId == receiptId &&
        UserSession.IsLoggedIn && UserSession.UserID == userId;

    private async Task RetryPrintDocAsync()
    {
        if (isPrinting || ReceiptId <= 0) return;
        await PrintDoc();
    }

    private void GoBack() => Navigation.NavigateTo("/goods-receipts");

    private void DismissToast()
    {
        toastGeneration++;
        toast = string.Empty;
        StateHasChanged();
    }

    private async Task ShowToastAsync(string message, bool ok = true)
    {
        var generation = ++toastGeneration;
        toast = message; toastOk = ok; StateHasChanged();
        await Task.Delay(3000);
        if (generation == toastGeneration)
        {
            toast = "";
            StateHasChanged();
        }
    }
}
