    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => ReceiptId == 0;

    private bool canInspect =>
        !isNewMode && !isViewMode &&
        header.GRNStatus == 1 &&
        header.InspectionStatus == 1 &&
        header.InspectionRequestedDate.HasValue &&
        details.Any() &&
        header.AssignedInspectorID.HasValue && header.AssignedInspectorID.Value > 0 &&
        header.AssignedInspectorID == UserSession.CurrentEmployeeID &&
        (qcPermissions?.CanApprove ?? false);

    private bool canApprove =>
        !isNewMode && !isViewMode &&
        header.GRNStatus == 1 &&
        header.InspectionStatus == 2 &&
        header.InspectionRequestedDate.HasValue &&
        header.InspectionCompletedDate.HasValue &&
        header.AssignedInspectorID.HasValue &&
        header.AssignedInspectorID == header.InspectedBy &&
        details.Any(d => d.AcceptedQty.GetValueOrDefault() > 0) &&
        (permissions?.CanApprove ?? false);

    private bool canSendForInspection =>
        !isNewMode && !isViewMode &&
        header.GRNStatus == 1 &&
        details.Any() &&
        !showLineForm &&
        header.AssignedInspectorID.GetValueOrDefault() > 0 &&
        (permissions?.CanEdit ?? false) &&
        (header.InspectionStatus == 3 ||
         (header.InspectionStatus == 1 && !header.InspectionRequestedDate.HasValue));

    private string inspectionStatusLabel =>
        header.InspectionStatus == 1 && header.InspectionRequestedDate.HasValue
            ? "بانتظار الفحص"
            : GoodsReceiptService.GetInspectionStatusName(header.InspectionStatus);

    private bool isReadOnly
    {
        get
        {
            if (isViewMode) return true;
            if (isNewMode) return false;
            if (header.GRNStatus != 1) return true;
            if (!(permissions?.CanEdit ?? false)) return true;
            if (header.InspectionStatus == 2) return true;
            if (header.InspectionStatus == 1 && header.InspectionRequestedDate.HasValue) return true;
            return false;
        }
    }

