@page "/goods-receipts/new"
@page "/goods-receipts/edit/{ReceiptId:int}"
@page "/goods-receipts/view/{ReceiptId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject GoodsReceiptService GrnService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div>}
else
{
    <div class="luxury-doc-page" dir="rtl">
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <button class="btn-luxury btn-back-luxury" @onclick="GoBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19 7-7-7-7"/></svg>رجوع</button>
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">@pageTitle</h2><div class="lh-meta">@if (!string.IsNullOrEmpty(header.GRNNumber)){<code class="doc-num-luxury">@header.GRNNumber</code><span class="status-badge-luxury" style="--sc:@GoodsReceiptService.GetStatusColor(header.GRNStatus)">@GoodsReceiptService.GetStatusName(header.GRNStatus)</span><span class="status-badge-luxury" style="--sc:@GoodsReceiptService.GetInspectionColor(header.InspectionStatus)">@GoodsReceiptService.GetInspectionStatusName(header.InspectionStatus)</span>}</div></div>
                </div>
                <div class="lh-actions">
                    <div class="workflow-mini"><span class="wm-dot done">1 طلب</span><span class="wm-line done"></span><span class="wm-dot done">2 أمر</span><span class="wm-line done"></span><span class="wm-dot active">3 استلام</span><span class="wm-line"></span><span class="wm-dot">4 فاتورة</span><span class="wm-line"></span><span class="wm-dot">5 مرتجع</span></div>
                    @if (permissions.CanPrint && ReceiptId > 0){<button class="btn-luxury btn-ghost-luxury" @onclick="PrintDoc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>طباعة</button>}
                </div>
            </div>
        </div>

        @if (canApprove)
        {
            <div class="approval-bar-luxury">
                <div class="ml-gold-line green"></div>
                <div class="appr-left"><div class="appr-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div><div class="appr-title">إذن الاستلام جاهز للاعتماد</div><div class="appr-sub">فحص الجودة @GoodsReceiptService.GetInspectionStatusName(header.InspectionStatus) - يمكن اعتماد الاستلام الآن</div></div></div>
                <div class="appr-actions"><button class="btn-luxury btn-approve-quick" @onclick="ExecuteApprove" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg>}اعتماد الاستلام</button><button class="btn-luxury btn-reject-luxury" @onclick="ExecuteCancel" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>إلغاء</button></div>
            </div>
        }

        @if (isLoading){<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else
        {
            @if (isNewMode && !isSourceLocked)
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h3 class="sec-title-luxury">مصدر الاستلام</h3></div>
                    <div class="source-cards-luxury">
                        <div class="source-card-luxury @(header.GRNSource == 1 ? "active" : "")" @onclick="SelectPOSource"><div class="source-card-icon-luxury" style="background:#ecfeff;color:#0891b2;border:1px solid #a5f3fc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><div class="source-card-title-luxury">من أمر شراء</div><div class="source-card-desc-luxury">استلام بناءً على أمر شراء مرسل للمورد</div><div class="source-check-luxury">@if(header.GRNSource==1){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5l10-10"/></svg>}</div></div>
                        <div class="source-card-luxury @(header.GRNSource == 2 ? "active" : "")" @onclick="SelectDirectSource"><div class="source-card-icon-luxury" style="background:rgba(212,175,55,.1);color:#9C7C2E;border:1px solid rgba(212,175,55,.18)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><div class="source-card-title-luxury">استلام مباشر</div><div class="source-card-desc-luxury">استلام بضاعة بدون أمر شراء مسبق</div><div class="source-check-luxury">@if(header.GRNSource==2){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5l10-10"/></svg>}</div></div>
                    </div>
                </div>
            }

            @if (header.GRNSource == 1 && isNewMode && !isPOLoaded)
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><h3 class="sec-title-luxury">اختيار أمر الشراء</h3></div>
                    <div class="form-grid-luxury c2"><div class="f-field-luxury"><label class="f-label-luxury required">أمر الشراء</label><SearchableSelect Items="@availablePOs" @bind-SelectedId="selectedPOId" OnSelected="OnPOSelected" Placeholder="ابحث برقم أمر الشراء..." /></div></div>
                    @if (poLines != null && poLines.Any())
                    {
                        <div style="margin-top:16px"><h4 class="po-lines-title-luxury">الأصناف المتبقية للاستلام (@poLines.Count(l=>l.IsSelected) مختار)</h4>
                            <div class="tbl-card-luxury" style="margin-top:10px"><div class="table-responsive"><table class="tbl-luxury"><thead><tr><th class="tc" style="width:40px"><input type="checkbox" checked="@poLines.All(l=>l.IsSelected)" @onchange="ToggleAllPOLines" /></th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="tc">مطلوب</th><th class="tc">تم استلامه</th><th class="tc">متبقي</th><th class="tc">الكمية الآن</th><th>الباتش</th><th>الصلاحية</th></tr></thead><tbody>@foreach (var line in poLines){<tr class="@(!line.IsSelected?"tr-deselected":"")"><td class="tc"><input type="checkbox" @bind="line.IsSelected" /></td><td><code class="code-tag-luxury">@line.ItemCode</code></td><td class="td-bold">@line.ItemNameAr</td><td class="td-muted">@line.UnitName</td><td class="tc">@line.OrderedQty.ToString("#,##0.##")</td><td class="tc">@line.ReceivedQty.ToString("#,##0.##")</td><td class="tc"><strong class="remaining-qty-luxury">@line.RemainingToReceive.ToString("#,##0.##")</strong></td><td class="tc"><input type="number" class="inline-input-luxury" @bind="line.QtyToReceive" step="0.01" min="0" max="@line.RemainingToReceive" disabled="@(!line.IsSelected)" /></td><td><input type="text" class="inline-input-luxury" @bind="line.BatchNumber" placeholder="باتش..." disabled="@(!line.IsSelected)" /></td><td><input type="date" class="inline-input-luxury" @bind="line.ExpiryDate" disabled="@(!line.IsSelected)" /></td></tr>}</tbody></table></div></div>
                        </div>
                    }
                </div>
            }

            @if (header.GRNSource > 0 || !isNewMode)
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h3 class="sec-title-luxury">بيانات إذن الاستلام</h3></div>
                    <div class="form-grid-luxury c4">
                        <div class="f-field-luxury"><label class="f-label-luxury">رقم الإذن</label><input type="text" class="f-input-luxury readonly" value="@(header.GRNNumber ?? "تلقائي")" disabled /></div>
                        <div class="f-field-luxury"><label class="f-label-luxury required">التاريخ</label><input type="date" class="f-input-luxury" @bind="header.GRNDate" disabled="@isReadOnly" /></div>
                        <div class="f-field-luxury"><label class="f-label-luxury required">المورد</label>@if (header.GRNSource == 1 && header.SupplierID > 0){<input type="text" class="f-input-luxury readonly" value="@header.SupplierNameAr" disabled />}else{<SearchableSelect Items="@suppliersSearchable" @bind-SelectedId="header.SupplierID" Placeholder="اختر المورد..." IsDisabled="@isReadOnly" />}</div>
                        <div class="f-field-luxury"><label class="f-label-luxury required">المخزن</label><select class="f-input-luxury" @bind="header.WarehouseID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (warehouses != null){@foreach (var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select></div>
                        <div class="f-field-luxury"><label class="f-label-luxury">المستلم</label><select class="f-input-luxury" @bind="header.ReceivedBy" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (employees != null){@foreach (var e in employees){<option value="@e.Id">@e.Name</option>}}</select></div>
                        <div class="f-field-luxury"><label class="f-label-luxury">فاتورة المورد</label><input type="text" class="f-input-luxury" @bind="header.SupplierInvoiceNo" disabled="@isReadOnly" placeholder="رقم فاتورة المورد..." /></div>
                        <div class="f-field-luxury"><label class="f-label-luxury">تاريخ فاتورة المورد</label><input type="date" class="f-input-luxury" @bind="header.SupplierInvoiceDate" disabled="@isReadOnly" /></div>
                        <div class="f-field-luxury"><label class="f-label-luxury">إذن التسليم</label><input type="text" class="f-input-luxury" @bind="header.DeliveryNoteNo" disabled="@isReadOnly" placeholder="رقم إذن التسليم..." /></div>
                    </div>
                    <div class="form-grid-luxury c4" style="margin-top:14px">
                        <div class="f-field-luxury"><label class="f-label-luxury">الفاحص</label><select class="f-input-luxury" @bind="header.InspectedBy" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (employees != null){@foreach (var e in employees){<option value="@e.Id">@e.Name</option>}}</select></div>
                        <div class="f-field-luxury"><label class="f-label-luxury">حالة الفحص</label><select class="f-input-luxury" @bind="header.InspectionStatus" disabled="@isReadOnly"><option value="1">لم يتم الفحص</option><option value="2">مقبول</option><option value="3">مرفوض</option></select></div>
                        <div class="f-field-luxury c2"><label class="f-label-luxury">ملاحظات الفحص</label><input type="text" class="f-input-luxury" @bind="header.InspectionNotes" disabled="@isReadOnly" placeholder="ملاحظات..." /></div>
                    </div>
                    <div class="form-grid-luxury c1" style="margin-top:14px"><div class="f-field-luxury"><label class="f-label-luxury">ملاحظات</label><input type="text" class="f-input-luxury" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات عامة..." /></div></div>
                </div>
            }

            @if ((header.GRNSource > 0 || !isNewMode) && (ReceiptId > 0 || isSourceLocked))
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96L12 12.01l8.73-5.05"/><path d="M12 22.08V12"/></svg></div><h3 class="sec-title-luxury">الأصناف المستلمة</h3><span class="sec-badge-luxury">@details.Count صنف</span><span class="total-mini-luxury">@details.Sum(d=>d.LineTotalCost).ToString("#,##0.00") ج.م</span>
                    @if (!isReadOnly && permissions.CanAdd){<button class="btn-luxury btn-primary-luxury btn-sm-luxury" style="margin-right:auto;" @onclick="ShowAddLine"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة صنف</button>}
                </div>
                    @if (!details.Any() && !showLineForm){<div class="empty-lines-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><p>لا توجد أصناف مستلمة.</p></div>}
                    else
                    {
                        <div class="tbl-card-luxury"><div class="table-responsive"><table class="tbl-luxury"><thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="tc">مستلم</th><th class="tc">مقبول</th><th class="tc">مرفوض</th><th>الباتش</th><th>الصلاحية</th><th class="tl">التكلفة</th><th class="tl">الإجمالي</th><th class="tc">الجودة</th>@if (!isReadOnly){<th class="tc">إجراءات</th>}</tr></thead><tbody>@{int n=0;}@foreach (var line in details){n++;<tr><td class="td-n">@n</td><td><code class="code-tag-luxury">@line.ItemCode</code></td><td class="td-bold">@line.ItemNameAr</td><td class="td-muted">@line.UnitName</td><td class="tc">@line.ReceivedQty.ToString("#,##0.##")</td><td class="tc">@(line.AcceptedQty?.ToString("#,##0.##") ?? "—")</td><td class="tc">@if(line.RejectedQty>0){<span class="rejected-badge-luxury">@line.RejectedQty.ToString("#,##0.##")</span>}else{<span>0</span>}</td><td class="td-muted">@(line.BatchNumber ?? "—")</td><td class="td-muted">@(line.ExpiryDate?.ToString("dd/MM/yyyy") ?? "—")</td><td class="tl num-cell">@line.UnitCost.ToString("#,##0.00")</td><td class="tl num-cell"><strong>@line.LineTotalCost.ToString("#,##0.00")</strong></td><td class="tc"><span class="quality-badge-luxury" style="--qc:@GoodsReceiptService.GetInspectionColor(line.QualityStatus)">@GoodsReceiptService.GetQualityStatusName(line.QualityStatus)</span></td>@if (!isReadOnly){<td class="tc"><div class="line-actions-luxury">@if (permissions.CanEdit){<button class="act-btn-luxury edit" @onclick="() => ShowEditLine(line)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}@if (permissions.CanDelete){<button class="act-btn-luxury del" @onclick="() => DeleteLine(line.GRNDetailID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}</div></td>}</tr>}</tbody><tfoot><tr class="total-row-luxury"><td colspan="10" class="tl"><strong>الإجمالي</strong></td><td class="tl num-cell"><strong>@details.Sum(d => d.LineTotalCost).ToString("#,##0.00") ج.م</strong></td><td colspan="@(!isReadOnly ? 2 : 1)"></td></tr></tfoot></table></div></div>
                    }

                    @if (showLineForm)
                    {
                        <div class="line-form-luxury"><div class="ml-gold-line"></div><div class="line-form-head-luxury"><h4>@(isEditLine ? "تعديل صنف" : "إضافة صنف")</h4><button class="btn-close-x-luxury" @onclick="CloseLineForm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
                            <div class="form-grid-luxury c3">
                                <div class="f-field-luxury"><label class="f-label-luxury required">الصنف</label><SearchableSelect Items="@purchaseItems" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث..." IsDisabled="@isEditLine" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">الوحدة</label><select class="f-input-luxury" @bind="editLine.UnitID"><option value="0">-- اختر --</option>@if (units != null){@foreach (var u in units){<option value="@u.Id">@u.Name</option>}}</select></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">الكمية المستلمة</label><input type="number" class="f-input-luxury" @bind="editLine.ReceivedQty" step="0.01" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">الكمية المقبولة</label><input type="number" class="f-input-luxury" @bind="editLine.AcceptedQty" step="0.01" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">الكمية المرفوضة</label><input type="number" class="f-input-luxury" @bind="editLine.RejectedQty" step="0.01" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">تكلفة الوحدة</label><input type="number" class="f-input-luxury" @bind="editLine.UnitCost" step="0.01" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">رقم الباتش</label><input type="text" class="f-input-luxury" @bind="editLine.BatchNumber" placeholder="Batch..." /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">تاريخ الإنتاج</label><input type="date" class="f-input-luxury" @bind="editLine.ManufactureDate" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">تاريخ الصلاحية</label><input type="date" class="f-input-luxury" @bind="editLine.ExpiryDate" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">حالة الجودة</label><select class="f-input-luxury" @bind="editLine.QualityStatus"><option value="1">انتظار فحص</option><option value="2">مقبول</option><option value="3">مرفوض</option></select></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">موقع التخزين</label><input type="text" class="f-input-luxury" @bind="editLine.StorageLocation" placeholder="رف / منطقة..." /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">ملاحظات</label><input type="text" class="f-input-luxury" @bind="editLine.Notes" placeholder="ملاحظات..." /></div>
                            </div>
                            <div class="line-calc-bar-luxury"><span>الإجمالي: <strong>@editLine.LineTotalCost.ToString("#,##0.00") ج.م</strong></span></div>
                            @if (!string.IsNullOrEmpty(lineMsg)){<div class="form-msg-luxury @(lineMsgOk?"ok":"err")">@lineMsg</div>}
                            <div class="line-form-btns-luxury"><button class="btn-luxury btn-primary-luxury" @onclick="SaveLine" disabled="@isSavingLine">@if(isSavingLine){<div class="btn-spinner-sm"></div>}@(isEditLine ? "تحديث" : "إضافة")</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseLineForm">إلغاء</button></div>
                        </div>
                    }
                </div>
            }

            @if (!isViewMode && !canApprove)
            {
                <div class="doc-actions-luxury"><div class="ml-gold-line"></div><div class="doc-actions-right">@if (!isReadOnly){<button class="btn-luxury btn-primary-luxury" @onclick="SaveReceipt" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21V13H7v8"/></svg>}@(isNewMode ? "حفظ إذن الاستلام" : "حفظ التعديلات")</button>@if (ReceiptId > 0 && header.GRNStatus == 1 && details.Any()){@if (header.InspectionStatus == 1){<button class="btn-luxury btn-inspect-luxury" @onclick="SendForInspection" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>إرسال للفحص</button>}@if (header.InspectionStatus == 2){<button class="btn-luxury btn-warning-luxury" @onclick="SendForApproval" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m22 2-7 20-4-9-9-4 20-7z"/></svg>إرسال للاعتماد</button>}}}</div><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">رجوع</button></div>
            }
        }
    </div>

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast = ""'>✕</button></div></div>}
}

