            receiptDetailsRefreshFailed = true;
            receiptDetailsRefreshError = receiptDetailsLoaded
                ? "تم الحفظ، لكن تعذر تحديث قائمة الأصناف؛ آخر البيانات الناجحة ما زالت معروضة. أعد المحاولة."
