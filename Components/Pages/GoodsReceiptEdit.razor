    private void ResetSelectedPOLinesLoadState()
    {
        poLinesLoadVersion++;
        isPOLinesLoading = false;
        poLinesLoaded = false;
        poLinesLoadedForId = 0;
        poLinesLoadFailed = false;
        poLinesLoadDenied = false;
        poLinesLoadError = string.Empty;
        poLines = null;
    }

    private async Task LoadSelectedPOInfoAsync(int purchaseOrderId)
    {
        if (isSelectedPOInfoLoading || !IsCurrentSelectedPOSelection(purchaseOrderId, UserSession.UserID)) return;

        var requestVersion = ++selectedPOInfoLoadVersion;
        var userId = UserSession.UserID;
        isSelectedPOInfoLoading = true;
        selectedPOInfoLoadFailed = false;
        selectedPOInfoLoadDenied = false;
        selectedPOInfoNotFound = false;
        selectedPOInfoLoadError = string.Empty;
        StateHasChanged();

        try
        {
            var availableOrders = await LookupService.GetPOsForGRNAsync();
            if (!IsCurrentSelectedPOInfoRequest(requestVersion, purchaseOrderId, userId)) return;

            var poInfo = availableOrders?.FirstOrDefault(p => p.PurchaseOrderID == purchaseOrderId);
            if (poInfo == null)
            {
                selectedPOInfoNotFound = true;
                selectedPOInfoLoadError = "تعذر العثور على بيانات أمر الشراء المحدد؛ اختر أمرًا آخر.";
                return;
            }

            header.SupplierID = poInfo.SupplierID;
            header.SupplierNameAr = poInfo.SupplierNameAr;
            if (poInfo.WarehouseID.HasValue)
                header.WarehouseID = poInfo.WarehouseID.Value;
            selectedPOInfoLoaded = true;
            selectedPOInfoLoadedForId = purchaseOrderId;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading selected purchase-order information for goods receipt.");
            if (!IsCurrentSelectedPOInfoRequest(requestVersion, purchaseOrderId, userId)) return;
            selectedPOInfoLoadDenied = true;
            selectedPOInfoLoadError = "ليس لديك صلاحية قراءة بيانات أمر الشراء المحدد.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load selected purchase-order information for goods receipt.");
            if (!IsCurrentSelectedPOInfoRequest(requestVersion, purchaseOrderId, userId)) return;
            selectedPOInfoLoadFailed = true;
            selectedPOInfoLoadError = selectedPOInfoLoaded
                ? "تعذر تحديث بيانات المورد والمخزن؛ آخر البيانات الناجحة ما زالت معروضة. أعد المحاولة."
                : "تعذر تحميل بيانات المورد والمخزن لأمر الشراء. أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == selectedPOInfoLoadVersion)
            {
                isSelectedPOInfoLoading = false;
                StateHasChanged();
            }
        }
    }

    private bool IsCurrentSelectedPOInfoRequest(int requestVersion, int purchaseOrderId, int userId) =>
        requestVersion == selectedPOInfoLoadVersion &&
        (selectedPOInfoLoadedForId == 0 || selectedPOInfoLoadedForId == purchaseOrderId) &&
        IsCurrentSelectedPOSelection(purchaseOrderId, userId);

