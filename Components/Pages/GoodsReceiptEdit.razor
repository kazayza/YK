            return "تعديل إذن استلام";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            isLoading = false;
            return;
        }

        if (await LoadReceiptPermissionsAsync())
            await InitializeAuthorizedPageAsync();
        else
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<bool> LoadReceiptPermissionsAsync()
    {
        if (isReceiptPermissionLoading) return false;

        var requestVersion = ++receiptPermissionLoadVersion;
        var userId = UserSession.UserID;
        isReceiptPermissionLoading = true;
        receiptPermissionLoadFailed = false;
        receiptPermissionLoadDenied = false;
        receiptPermissionLoadError = string.Empty;
        StateHasChanged();

        try
        {
            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(userId);

            if (!IsCurrentReceiptPermissionRequest(requestVersion, userId)) return false;
            permissions = PermissionService.GetModule("SCR_GRN");
            qcPermissions = PermissionService.GetModule("SCR_QC");
            return true;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading goods receipt permissions for user {UserID}.", userId);
            if (!IsCurrentReceiptPermissionRequest(requestVersion, userId)) return false;
            receiptPermissionLoadDenied = true;
            receiptPermissionLoadError = "تعذر التحقق من صلاحيات الجلسة. سجّل الدخول مجددًا.";
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load goods receipt permissions for user {UserID}.", userId);
            if (!IsCurrentReceiptPermissionRequest(requestVersion, userId)) return false;
            receiptPermissionLoadFailed = true;
            receiptPermissionLoadError = "تعذر تحميل صلاحيات إذن الاستلام. أعد المحاولة.";
            return false;
        }
        finally
        {
            if (requestVersion == receiptPermissionLoadVersion)
            {
                isReceiptPermissionLoading = false;
                StateHasChanged();
            }
        }
    }

    private bool IsCurrentReceiptPermissionRequest(int requestVersion, int userId) =>
        requestVersion == receiptPermissionLoadVersion && UserSession.IsLoggedIn && UserSession.UserID == userId;

    private async Task RetryLoadReceiptPermissionsAsync()
    {
        if (isReceiptPermissionLoading) return;
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (await LoadReceiptPermissionsAsync())
            await InitializeAuthorizedPageAsync();
    }

    private async Task InitializeAuthorizedPageAsync()
    {
        if (permissions == null || !permissions.CanView)
        {
            isLoading = false;
            StateHasChanged();
            return;
        }

        isLoading = true;
        StateHasChanged();
        try
        {
            await LoadLookups();

            if (ReceiptId > 0)
                await LoadReceiptDataAsync();
            else
            {
                var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                var source = query["source"];
                if (source == "po")
                {
                    header.GRNSource = 1;
                    await LoadAvailablePOsAsync();
                }
                else if (source == "direct")
                {
                    header.GRNSource = 2;
                    isSourceLocked = true;
                }
            }
        }
        catch (Exception ex) { await ShowToastAsync("خطأ: " + ex.Message, false); }
        finally { isLoading = false; StateHasChanged(); }
    }

