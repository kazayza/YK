    private async Task LoadReceiptDataAsync()
    {
        if (isReceiptDataLoading || ReceiptId <= 0) return;

        var requestVersion = ++receiptRecordLoadVersion;
        var receiptId = ReceiptId;
        var userId = UserSession.UserID;
        isReceiptDataLoading = true;
        isLoading = true;
        receiptRecordLoadFailed = false;
        receiptRecordLoadDenied = false;
        receiptRecordNotFound = false;
        receiptRecordLoadError = string.Empty;
        StateHasChanged();

        try
        {
            var loadedHeader = await GrnService.GetReceiptByIdAsync(receiptId);
            if (!IsCurrentReceiptDataRequest(requestVersion, receiptId, userId)) return;
            if (loadedHeader == null)
            {
                receiptDataLoaded = false;
                receiptRecordNotFound = true;
                receiptRecordLoadError = "إذن الاستلام غير موجود.";
                return;
            }

            var loadedDetails = await GrnService.GetReceiptDetailsAsync(receiptId);
            if (!IsCurrentReceiptDataRequest(requestVersion, receiptId, userId)) return;

            header = loadedHeader;
            details = loadedDetails ?? new List<GoodsReceiptDetailDto>();
            inspectionNotesDraft = header.InspectionNotes ?? string.Empty;
            if (header.InspectionStatus == 1 && header.InspectionRequestedDate.HasValue &&
                header.AssignedInspectorID == UserSession.CurrentEmployeeID)
            {
                foreach (var line in details)
                    line.AcceptedQty ??= line.ReceivedQty;
            }
            receiptDetailsLoaded = true;
            isSourceLocked = true;
            isPOLoaded = true;
            receiptDataLoaded = true;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading goods receipt {GoodsReceiptID}.", receiptId);
            if (!IsCurrentReceiptDataRequest(requestVersion, receiptId, userId)) return;
            receiptDataLoaded = false;
            receiptRecordLoadDenied = true;
            receiptRecordLoadError = "ليس لديك صلاحية عرض إذن الاستلام أو تفاصيله.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load goods receipt {GoodsReceiptID}.", receiptId);
            if (!IsCurrentReceiptDataRequest(requestVersion, receiptId, userId)) return;
            receiptRecordLoadFailed = true;
            receiptRecordLoadError = "تعذر تحميل بيانات إذن الاستلام. أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == receiptRecordLoadVersion)
            {
                isReceiptDataLoading = false;
                isLoading = false;
                StateHasChanged();
            }
        }
    }

    private bool IsCurrentReceiptDataRequest(int requestVersion, int receiptId, int userId) =>
        requestVersion == receiptRecordLoadVersion && ReceiptId == receiptId &&
        UserSession.IsLoggedIn && UserSession.UserID == userId;

