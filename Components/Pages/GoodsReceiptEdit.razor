    private async Task OnPOSelected(SearchableItem? item)
    {
        ResetSelectedPOLinesLoadState();
        ResetSelectedPOInfoLoadState();
        if (item == null || item.Id == 0)
        {
            selectedPOId = 0;
            header.PurchaseOrderID = 0;
            header.SupplierID = 0;
            header.SupplierNameAr = null;
            header.SupplierCode = null;
            header.WarehouseID = 0;
            header.WarehouseNameAr = null;
            return;
        }

        selectedPOId = item.Id;
        header.PurchaseOrderID = item.Id;
        header.SupplierID = 0;
        header.SupplierNameAr = null;
        header.SupplierCode = null;
        header.WarehouseID = 0;
        header.WarehouseNameAr = null;
        var userId = UserSession.UserID;
        await LoadSelectedPOLinesAsync(item.Id);
        if (!IsCurrentSelectedPOSelection(item.Id, userId)) return;
        await LoadSelectedPOInfoAsync(item.Id);
    }

    private async Task LoadSelectedPOLinesAsync(int purchaseOrderId)
    {
        if (!isNewMode || header.GRNSource != 1 || selectedPOId != purchaseOrderId || header.PurchaseOrderID != purchaseOrderId || isPOLinesLoading) return;

        var requestVersion = ++poLinesLoadVersion;
        var userId = UserSession.UserID;
        isPOLinesLoading = true;
        poLinesLoadFailed = false;
        poLinesLoadDenied = false;
        poLinesLoadError = string.Empty;
        StateHasChanged();

        try
        {
            var loadedLines = await LookupService.GetPOLinesForGRNAsync(purchaseOrderId);
            if (!IsCurrentSelectedPOLinesRequest(requestVersion, purchaseOrderId, userId)) return;

            var resolvedLines = loadedLines ?? new List<POLineForGRNDto>();
            foreach (var line in resolvedLines)
            {
                line.IsSelected = true;
                line.QtyToReceive = line.RemainingToReceive;
            }
            poLines = resolvedLines;
            poLinesLoaded = true;
            poLinesLoadedForId = purchaseOrderId;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading purchase-order lines for goods receipt.");
            if (!IsCurrentSelectedPOLinesRequest(requestVersion, purchaseOrderId, userId)) return;
            poLines = null;
            poLinesLoaded = false;
            poLinesLoadedForId = 0;
            poLinesLoadDenied = true;
            poLinesLoadError = "ليس لديك صلاحية قراءة أصناف أمر الشراء.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load purchase-order lines for goods receipt.");
            if (!IsCurrentSelectedPOLinesRequest(requestVersion, purchaseOrderId, userId)) return;
            poLinesLoadFailed = true;
            poLinesLoadError = poLinesLoaded
                ? "تعذر تحديث أصناف أمر الشراء؛ آخر البيانات الناجحة ما زالت معروضة. أعد المحاولة."
                : "تعذر تحميل الأصناف المتبقية للاستلام. أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == poLinesLoadVersion)
            {
                isPOLinesLoading = false;
                StateHasChanged();
            }
        }
    }

    private bool IsCurrentSelectedPOLinesRequest(int requestVersion, int purchaseOrderId, int userId) =>
        requestVersion == poLinesLoadVersion &&
        (poLinesLoadedForId == 0 || poLinesLoadedForId == purchaseOrderId) &&
        IsCurrentSelectedPOSelection(purchaseOrderId, userId);

