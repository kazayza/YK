@page "/stock-balances"
@page "/stock"
@page "/stock-balances/view/{ItemIdParam:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject InventoryService InvService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>أرصدة المخزون - واي كي كوتينج   </PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول أولاً</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4><button class="btn-luxury btn-ghost-luxury" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة للرئيسية</button></div>}
else
{
    <div class="luxury-page" dir="rtl">
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">أرصدة المخزون</h2><p class="lh-subtitle">مراقبة الأرصدة والتنبيهات وإدارة المخزون — تحديث لحظي</p></div>
                </div>
                <div class="lh-actions">
                    <span class="lh-badge"><span class="lh-dot"></span>@filtered.Count صنف</span>
                    <button class="btn-luxury btn-alert-luxury" @onclick="CheckAlerts" disabled="@isChecking">
                        @if (isChecking){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8a6 6 0 0 1 12 0c0 7 6 5 6 10H0s6-3 6-10"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>}
                        فحص التنبيهات
                    </button>
                    @if (permissions.CanAdd){<button class="btn-luxury btn-primary-luxury" @onclick="ShowOpeningBalance"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>رصيد افتتاحي</button>}
                    @if (permissions.CanPrint){<button class="btn-luxury btn-ghost-luxury" @onclick="PrintReport"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>طباعة</button>}
                    @if (permissions.CanExport){<button class="btn-luxury btn-export-luxury" @onclick="ExportExcel" disabled="@isExporting">@if(isExporting){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>}Excel</button>}
                </div>
            </div>
        </div>

        @if (dashboard != null)
        {
            <div class="stats-luxury">
                <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96L12 12.01l8.73-5.05"/><path d="M12 22.08V12"/></svg></div><div class="st-info"><span class="st-value">@dashboard.ItemsWithStock</span><span class="st-label">أصناف بمخزون</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@dashboard.TotalStockValue.ToString("#,##0")</span><span class="st-label">قيمة المخزون ج.م</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg></div><div class="st-info"><span class="st-value">@dashboard.ItemsBelowMin</span><span class="st-label">تحت الحد الأدنى</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg></div><div class="st-info"><span class="st-value">@dashboard.ItemsOutOfStock</span><span class="st-label">نفد المخزون</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><div class="st-info"><span class="st-value">@dashboard.BatchesNearExpiry</span><span class="st-label">قرب الانتهاء</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon gray"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></div><div class="st-info"><span class="st-value">@dashboard.BatchesExpired</span><span class="st-label">منتهي الصلاحية</span></div><div class="st-gold-line"></div></div>
            </div>
        }

        <div class="filter-luxury">
            <div class="search-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input type="text" placeholder="بحث بالكود أو الصنف أو المخزن..." @bind="searchText" @bind:event="oninput" @onkeyup="Filter" />@if (!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}</div>
            <div class="select-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9z"/><path d="M3 9V7a2 2 0 0 1 2-2h2"/><path d="M19 9V7a2 2 0 0 0-2-2h-2"/></svg><select @bind="filterWarehouse" @bind:after="LoadBalances"><option value="0">كل المخازن</option>@if (warehouses != null){@foreach (var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg><select @bind="filterType" @bind:after="LoadBalances"><option value="0">كل الأنواع</option><option value="1">خام</option><option value="2">تعبئة</option><option value="3">نصف مصنع</option><option value="4">تام</option><option value="5">تشغيل</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg><select @bind="filterAlert" @bind:after="Filter"><option value="-1">كل الحالات</option><option value="0">طبيعي</option><option value="1">أقل من الحد</option><option value="2">تحت نقطة الطلب</option><option value="3">نفد</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            @if (ItemIdParam > 0){<button class="btn-luxury btn-ghost-luxury" @onclick="ClearItemFilter"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>عرض الكل</button>}
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        @if (balances == null)
        {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else if (!filtered.Any())
        {<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><h4>لا توجد أرصدة</h4></div>}
        else
        {
            <div class="table-card-luxury">
                <div class="table-responsive">
                    <table class="table-luxury">
                        <thead><tr><th class="th-num">#</th><th>الكود</th><th>الصنف</th><th>النوع</th><th>المخزن</th><th>الوحدة</th><th class="th-center">الرصيد</th><th class="th-center">المحجوز</th><th class="th-center">المتاح</th><th>التكلفة</th><th>القيمة</th><th class="th-center">الحالة</th><th class="th-actions">إجراءات</th></tr></thead>
                        <tbody>
                            @{int n=0;}
                            @foreach (var b in filtered){n++;
                                <tr class="@(b.StockAlert>=2?"row-alert":"") @(b.CurrentQty<0?"row-negative":"")">
                                    <td class="td-num">@n</td>
                                    <td><code class="code-tag-luxury">@b.ItemCode</code></td>
                                    <td class="td-name">@b.ItemNameAr</td>
                                    <td><span class="type-tag-luxury" style="--tc:@GetItemTypeColor(b.ItemType)">@b.ItemTypeName</span></td>
                                    <td class="td-muted">@b.WarehouseNameAr</td>
                                    <td class="td-muted">@b.PrimaryUnitName</td>
                                    <td class="td-center"><span class="qty-luxury @(b.CurrentQty<=0?"danger":"")">@b.CurrentQty.ToString("#,##0.##")</span></td>
                                    <td class="td-center td-muted">@b.ReservedQty.ToString("#,##0.##")</td>
                                    <td class="td-center"><strong class="qty-luxury @(b.AvailableQty<=0?"danger":"")">@b.AvailableQty.ToString("#,##0.##")</strong></td>
                                    <td class="td-muted num">@b.AverageCost.ToString("#,##0.00")</td>
                                    <td><span class="amount-luxury">@b.TotalValue.ToString("#,##0.00")</span></td>
                                    <td class="td-center"><span class="alert-badge-luxury" style="--ac:@GetAlertColor(b.StockAlert)"><span class="alert-dot" style="background:var(--ac)"></span>@b.StockAlertName</span></td>
                                    <td class="td-center"><button class="act-btn-luxury view" title="كارت الصنف" @onclick="() => ViewCard(b.ItemID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></button></td>
                                </tr>
                            }
                        </tbody>
                        <tfoot><tr class="total-row-luxury"><td colspan="10" class="tl"><strong>إجمالي القيمة</strong></td><td class="tl"><span class="amount-luxury total">@filtered.Sum(b => b.TotalValue).ToString("#,##0.00") ج.م</span></td><td colspan="2"></td></tr></tfoot>
                    </table>
                </div>
            </div>
        }
    </div>

    @if (showOBDialog)
    {
        <div class="modal-overlay-luxury" @onclick="() => showOBDialog = false"><div class="modal-card-luxury" @onclick:stopPropagation="true">
            <div class="ml-gold-line"></div>
            <div class="modal-head-luxury"><div class="mh-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg></div><div><h4>إضافة رصيد افتتاحي</h4><p>إدخال رصيد بداية المدة للصنف في المخزن</p></div><button class="btn-close-x-luxury" @onclick="() => showOBDialog = false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
            <div class="ob-form-luxury">
                <div class="f-field-luxury"><label class="f-label-luxury required">الصنف</label><SearchableSelect Items="@allItems" @bind-SelectedId="obItem" Placeholder="اختر الصنف..." /></div>
                <div class="f-field-luxury"><label class="f-label-luxury required">المخزن</label><select class="f-input-luxury" @bind="obWarehouse"><option value="0">-- اختر --</option>@if (warehouses != null){@foreach (var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select></div>
                <div class="form-grid-luxury c2"><div class="f-field-luxury"><label class="f-label-luxury required">الكمية</label><input type="number" class="f-input-luxury" @bind="obQty" step="0.01" /></div><div class="f-field-luxury"><label class="f-label-luxury required">تكلفة الوحدة</label><input type="number" class="f-input-luxury" @bind="obCost" step="0.01" /></div></div>
            </div>
            @if (!string.IsNullOrEmpty(obMsg)){<div class="form-msg-luxury @(obMsgOk?"ok":"err")">@obMsg</div>}
            <div class="ml-footer"><button class="btn-luxury btn-primary-luxury" @onclick="SaveOpeningBalance" disabled="@isSavingOB">@if(isSavingOB){<div class="btn-spinner-sm"></div>}حفظ الرصيد</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showOBDialog = false">إلغاء</button></div>
        </div></div>
    }

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast = ""'><i class=bi-x-lg></i></button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto;position:relative}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:visible !important;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25);z-index:5}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;overflow:visible !important}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;overflow:visible !important}
.btn-alert-luxury{background:linear-gradient(135deg,#d97706,#f59e0b);color:#fff}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px}
.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}
.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}
.st-icon.amber{background:#fef3c7;color:#d97706;border:1px solid #fde68a}
.st-icon.red{background:#fef2f2;color:#ef4444;border:1px solid #fecaca}
.st-icon.orange{background:#fff7ed;color:#ea580c;border:1px solid #fed7aa}
.st-icon.gray{background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb}
.st-info{display:flex;flex-direction:column}
.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}
.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}
.clear-search-luxury{position:absolute;left:8px;width:24px;height:24px;border-radius:50%;border:none;background:#f3f4f6;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}
.clear-search-luxury svg{width:10px;height:10px}
.select-wrap-luxury .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}
.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.table-luxury{width:100%;border-collapse:collapse;min-width:1200px}
.table-luxury .row-alert{background:#fff7f7}
.table-luxury .row-negative{background:#fff7f7;border-right:3px solid #ef4444}
.th-actions{text-align:center;width:100px}
.td-name{font-weight:800;color:#0A0F1E}
.num{font-family:monospace;font-weight:600}
.code-tag-luxury{background:#f1f5f9;padding:2px 8px;border-radius:6px;font-size:.76rem;color:#2563eb;font-weight:600}
.type-tag-luxury{display:inline-block;padding:4px 12px;border-radius:8px;font-size:.72rem;font-weight:800;background:color-mix(in srgb,var(--tc) 12%,white);color:var(--tc);border:1px solid color-mix(in srgb,var(--tc) 25%,white)}
.qty-luxury{font-family:monospace;font-weight:700}
.qty-luxury.danger{color:#dc2626;font-weight:900}
.amount-luxury{font-family:monospace;font-weight:800;color:#0A0F1E;background:#f8f6f0;padding:4px 10px;border-radius:8px;border:1px solid #e8e2d0}
.amount-luxury.total{background:linear-gradient(135deg,var(--black),var(--black2));color:var(--gold);border-color:var(--border-gold)}
.alert-badge-luxury{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--ac) 12%,white);color:var(--ac);border:1px solid color-mix(in srgb,var(--ac) 25%,white)}
.alert-dot{width:6px;height:6px;border-radius:50%;box-shadow:0 0 0 3px color-mix(in srgb,var(--ac) 15%,transparent)}
.act-btn-luxury{width:32px;height:32px;border-radius:10px;border:1.5px solid;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;background:#fff;transition:.2s}
.act-btn-luxury.view{color:#2563eb;border-color:#bfdbfe}
.act-btn-luxury.view:hover{background:#eff6ff}
.act-btn-luxury svg{width:14px;height:14px}
.total-row-luxury{background:#fcfaf6 !important}
.total-row-luxury td{border-top:2px solid #e8e2d0;padding:12px}
.modal-card-luxury{position:relative;background:#fff;border-radius:20px;width:100%;max-width:500px;overflow:hidden;box-shadow:0 24px 48px rgba(0,0,0,.2);animation:modalIn .3s ease;border:1px solid #e8e2d0}
.modal-head-luxury .mh-icon{width:44px;height:44px;border-radius:12px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}
.modal-head-luxury .mh-icon svg{width:20px;height:20px}
.modal-head-luxury .btn-close-x-luxury{margin-right:auto}
.btn-close-x-luxury{width:28px;height:28px;border-radius:8px;border:1px solid #e8e2d0;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}
.btn-close-x-luxury svg{width:12px;height:12px}
.ob-form-luxury{padding:20px 22px;display:flex;flex-direction:column;gap:14px}
.form-grid-luxury{display:grid;gap:14px}
.c2{grid-template-columns:repeat(2,1fr)}
.f-label-luxury{font-size:.78rem;font-weight:700;color:#374151}
.required::after{content:' *';color:#ef4444}
.f-input-luxury{padding:9px 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.86rem;background:#fff;outline:none;transition:.2s;width:100%;font-family:'Tajawal'}
.f-input-luxury:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.form-msg-luxury{padding:10px 14px;border-radius:10px;font-size:.82rem;font-weight:600;margin:0 22px}
.form-msg-luxury.ok{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}
.form-msg-luxury.err{background:#fef2f2;color:#dc2626;border:1px solid #fecaca}
.ml-footer{display:flex;gap:8px;padding:14px 22px;border-top:1px solid #f1efe8;background:#fcfaf6}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}
