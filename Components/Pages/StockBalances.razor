@page "/stock-balances"
@page "/stock"
@page "/stock-balances/view/{ItemIdParam:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject InventoryService InvService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>أرصدة المخزون - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access"><div class="na-icon">🔒</div><h4>يجب تسجيل الدخول أولاً</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access"><div class="na-icon">⛔</div><h4>ليس لديك صلاحية</h4></div>
}
else
{
    <div class="page-wrap" dir="rtl">

        <div class="page-hdr">
            <div>
                <h2 class="page-title">أرصدة المخزون</h2>
                <p class="page-sub">مراقبة الأرصدة والتنبيهات وإدارة المخزون</p>
            </div>
            <div class="hdr-actions">
                <span class="badge-count">@filtered.Count صنف</span>
                <button class="btn-m btn-alert" @onclick="CheckAlerts" disabled="@isChecking">
                    @if (isChecking) { <div class="btn-spin"></div> } else { <span>🔔</span> }
                    فحص التنبيهات
                </button>
                @if (permissions.CanAdd)
                {
                    <button class="btn-m btn-primary" @onclick="ShowOpeningBalance">📥 رصيد افتتاحي</button>
                }
                @if (permissions.CanPrint)
                {
                    <button class="btn-m btn-print" @onclick="PrintReport">🖨️ طباعة</button>
                }
                @if (permissions.CanExport)
                {
                    <button class="btn-m btn-export" @onclick="ExportExcel" disabled="@isExporting">
                        @if (isExporting) { <div class="btn-spin"></div> } else { <span>📥</span> }
                        Excel
                    </button>
                }
            </div>
        </div>

        @if (dashboard != null)
        {
            <div class="stats-row">
                <div class="stat-box" style="border-top-color:#2563eb">
                    <div class="stat-n">@dashboard.ItemsWithStock</div>
                    <div class="stat-l">أصناف بمخزون</div>
                </div>
                <div class="stat-box" style="border-top-color:#10b981">
                    <div class="stat-n">@dashboard.TotalStockValue.ToString("#,##0")</div>
                    <div class="stat-l">قيمة المخزون</div>
                </div>
                <div class="stat-box" style="border-top-color:#f59e0b">
                    <div class="stat-n">@dashboard.ItemsBelowMin</div>
                    <div class="stat-l">تحت الحد الأدنى</div>
                </div>
                <div class="stat-box" style="border-top-color:#ef4444">
                    <div class="stat-n">@dashboard.ItemsOutOfStock</div>
                    <div class="stat-l">نفد المخزون</div>
                </div>
                <div class="stat-box" style="border-top-color:#f97316">
                    <div class="stat-n">@dashboard.BatchesNearExpiry</div>
                    <div class="stat-l">قرب الانتهاء</div>
                </div>
                <div class="stat-box" style="border-top-color:#dc2626">
                    <div class="stat-n">@dashboard.BatchesExpired</div>
                    <div class="stat-l">منتهي الصلاحية</div>
                </div>
            </div>
        }

        <div class="filter-row">
            <div class="search-wrap">
                <input class="search-inp" type="text" placeholder="بحث بالكود أو الصنف أو المخزن..."
                       @bind="searchText" @bind:event="oninput" @onkeyup="Filter" />
                @if (!string.IsNullOrEmpty(searchText))
                {
                    <button class="search-clr" @onclick="ClearSearch">✕</button>
                }
            </div>
            <select class="filter-sel" @bind="filterWarehouse" @bind:after="LoadBalances">
                <option value="0">كل المخازن</option>
                @if (warehouses != null)
                {
                    @foreach (var w in warehouses)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                }
            </select>
            <select class="filter-sel" @bind="filterType" @bind:after="LoadBalances">
                <option value="0">كل الأنواع</option>
                <option value="1">🟣 خام</option>
                <option value="2">🔵 تعبئة</option>
                <option value="3">🟠 نصف مصنع</option>
                <option value="4">🟢 تام</option>
                <option value="5">⚪ تشغيل</option>
            </select>
            <select class="filter-sel" @bind="filterAlert" @bind:after="Filter">
                <option value="-1">كل الحالات</option>
                <option value="0">طبيعي ✅</option>
                <option value="1">أقل من الحد 🔶</option>
                <option value="2">تحت نقطة الطلب ⚠️</option>
                <option value="3">نفد ❌</option>
            </select>
            @if (ItemIdParam > 0)
            {
                <button class="btn-m btn-ghost" @onclick="ClearItemFilter">✕ عرض الكل</button>
            }
            <button class="btn-m btn-ghost" @onclick="LoadData">🔄</button>
        </div>

        @if (balances == null)
        {
            <div class="loading-st"><div class="loader"></div><p>جاري التحميل...</p></div>
        }
        else if (!filtered.Any())
        {
            <div class="empty-st"><h4>لا توجد أرصدة</h4></div>
        }
        else
        {
            <div class="tbl-card">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>الكود</th>
                            <th>الصنف</th>
                            <th>النوع</th>
                            <th>المخزن</th>
                            <th>الوحدة</th>
                            <th class="tc">الرصيد</th>
                            <th class="tc">المحجوز</th>
                            <th class="tc">المتاح</th>
                            <th class="tl">التكلفة</th>
                            <th class="tl">القيمة</th>
                            <th class="tc">الحالة</th>
                            <th class="tc">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int n = 0;
                        }
                        @foreach (var b in filtered)
                        {
                            n++;
                            <tr class="@(b.StockAlert >= 2 ? "tr-alert" : "") @(b.CurrentQty < 0 ? "tr-negative" : "")">
                                <td class="td-n">@n</td>
                                <td><code class="code-tag">@b.ItemCode</code></td>
                                <td class="td-item-name">@b.ItemNameAr</td>
                                <td>
                                    <span class="type-tag" style="--tc:@GetItemTypeColor(b.ItemType)">@b.ItemTypeName</span>
                                </td>
                                <td class="td-warehouse">@b.WarehouseNameAr</td>
                                <td>@b.PrimaryUnitName</td>
                                <td class="tc num-cell @(b.CurrentQty <= 0 ? "qty-danger" : "")">@b.CurrentQty.ToString("#,##0.##")</td>
                                <td class="tc">@b.ReservedQty.ToString("#,##0.##")</td>
                                <td class="tc num-cell">
                                    <strong class="@(b.AvailableQty <= 0 ? "qty-danger" : "")">@b.AvailableQty.ToString("#,##0.##")</strong>
                                </td>
                                <td class="tl num-cell">@b.AverageCost.ToString("#,##0.00")</td>
                                <td class="tl num-cell"><strong>@b.TotalValue.ToString("#,##0.00")</strong></td>
                                <td class="tc">
                                    <span class="alert-badge" style="--ac:@GetAlertColor(b.StockAlert)">@b.StockAlertName</span>
                                </td>
                                <td class="tc">
                                    <button class="act-btn" title="كارت الصنف" @onclick="() => ViewCard(b.ItemID)">📋</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="total-row">
                            <td colspan="10" class="tl"><strong>إجمالي القيمة</strong></td>
                            <td class="tl num-cell"><strong>@filtered.Sum(b => b.TotalValue).ToString("#,##0.00") ج.م</strong></td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
    </div>

    @if (showOBDialog)
    {
        <div class="modal-ov" @onclick="() => showOBDialog = false">
            <div class="modal-box" @onclick:stopPropagation="true">
                <h4>📥 إضافة رصيد افتتاحي</h4>
                <div class="ob-form">
                    <div class="f-field">
                        <label class="f-label required">الصنف</label>
                        <SearchableSelect Items="@allItems" @bind-SelectedId="obItem" Placeholder="اختر الصنف..." />
                    </div>
                    <div class="f-field">
                        <label class="f-label required">المخزن</label>
                        <select class="f-input" @bind="obWarehouse">
                            <option value="0">-- اختر --</option>
                            @if (warehouses != null)
                            {
                                @foreach (var w in warehouses)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="ob-row">
                        <div class="f-field">
                            <label class="f-label required">الكمية</label>
                            <input type="number" class="f-input" @bind="obQty" step="0.01" />
                        </div>
                        <div class="f-field">
                            <label class="f-label required">تكلفة الوحدة</label>
                            <input type="number" class="f-input" @bind="obCost" step="0.01" />
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(obMsg))
                {
                    <div class="form-msg @(obMsgOk ? "msg-ok" : "msg-err")">@obMsg</div>
                }
                <div class="modal-btns">
                    <button class="btn-m btn-primary" @onclick="SaveOpeningBalance" disabled="@isSavingOB">
                        @if (isSavingOB) { <div class="btn-spin"></div> }
                        حفظ الرصيد
                    </button>
                    <button class="btn-m btn-ghost" @onclick="() => showOBDialog = false">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(toast))
    {
        <div class="toast-wrap">
            <div class="toast @(toastOk ? "t-ok" : "t-err")">
                <span>@toast</span>
                <button @onclick='() => toast = ""'>✕</button>
            </div>
        </div>
    }
}

<style>
    .page-wrap{display:flex;flex-direction:column;gap:18px}
    .page-hdr{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:14px}
    .page-title{font-weight:800;color:#0f172a;margin:0;font-size:1.35rem}
    .page-sub{color:#64748b;font-size:.84rem;margin:3px 0 0}
    .hdr-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    .badge-count{background:#f1f5f9;border:1px solid #e2e8f0;color:#475569;padding:7px 14px;border-radius:999px;font-size:.8rem;font-weight:700}
    .stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px}
    .stat-box{background:white;border:1px solid #e2e8f0;border-radius:16px;padding:16px;text-align:center;border-top:3px solid;transition:.2s}
    .stat-box:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(15,23,42,.06)}
    .stat-n{font-size:1.6rem;font-weight:900;color:#0f172a}
    .stat-l{font-size:.78rem;color:#64748b;margin-top:3px;font-weight:600}
    .filter-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
    .search-wrap{flex:1;min-width:260px;position:relative}
    .search-inp{width:100%;padding:10px 14px 10px 36px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:.88rem;background:white;outline:none;transition:.2s}
    .search-inp:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
    .search-clr{position:absolute;left:10px;top:50%;transform:translateY(-50%);background:#f1f5f9;border:none;width:22px;height:22px;border-radius:50%;cursor:pointer;font-size:.7rem;display:flex;align-items:center;justify-content:center}
    .filter-sel{padding:10px 14px;border:1.5px solid #e2e8f0;border-radius:12px;font-size:.85rem;background:white;outline:none}
    .tbl-card{background:white;border-radius:18px;overflow:hidden;border:1px solid #e2e8f0;box-shadow:0 4px 16px rgba(15,23,42,.04);overflow-x:auto}
    .tbl{width:100%;border-collapse:collapse;min-width:1200px}
    .tbl thead{background:#f8fafc}
    .tbl th{padding:13px 14px;font-size:.82rem;font-weight:700;color:#64748b;text-align:right;border-bottom:2px solid #e2e8f0;white-space:nowrap}
    .tbl td{padding:12px 14px;font-size:.88rem;color:#334155;border-bottom:1px solid #f1f5f9;line-height:1.5}
    .tbl tbody tr{transition:.15s}
    .tbl tbody tr:hover{background:#f8fafc}
    .tr-alert{background:#fef2f2!important}
    .tr-negative{background:#fef2f2!important;border-right:3px solid #ef4444}
    .tc{text-align:center}
    .tl{text-align:left}
    .td-n{color:#94a3b8;font-size:.82rem;text-align:center}
    .td-item-name{font-weight:800;color:#0f172a;font-size:.9rem}
    .td-warehouse{color:#475569;font-weight:600}
    .num-cell{font-family:'Courier New',monospace;font-weight:700;font-size:.88rem}
    .qty-danger{color:#dc2626!important;font-weight:900}
    .code-tag{background:#f1f5f9;padding:3px 10px;border-radius:6px;font-size:.82rem;color:#2563eb;font-weight:700}
    .total-row{background:#f8fafc!important}
    .total-row td{border-top:2px solid #e2e8f0;padding:14px;font-size:.9rem}
    .type-tag{display:inline-block;padding:4px 12px;border-radius:8px;font-size:.78rem;font-weight:800;background:color-mix(in srgb,var(--tc) 12%,white);color:var(--tc);border:1.5px solid color-mix(in srgb,var(--tc) 25%,white);letter-spacing:.3px}
    .alert-badge{display:inline-block;padding:4px 12px;border-radius:8px;font-size:.75rem;font-weight:700;background:color-mix(in srgb,var(--ac) 10%,white);color:var(--ac);border:1px solid color-mix(in srgb,var(--ac) 20%,white)}
    .act-btn{width:32px;height:32px;border-radius:8px;border:1.5px solid #e2e8f0;background:transparent;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:1rem;transition:.2s}
    .act-btn:hover{background:#eff6ff;border-color:#bfdbfe}
    .btn-m{display:inline-flex;align-items:center;gap:7px;padding:9px 18px;border-radius:12px;border:none;font-weight:700;font-size:.86rem;cursor:pointer;transition:.2s}
    .btn-m:disabled{opacity:.6;cursor:not-allowed}
    .btn-primary{background:linear-gradient(135deg,#1e40af,#2563eb);color:white;box-shadow:0 4px 14px rgba(37,99,235,.25)}
    .btn-primary:hover:not(:disabled){transform:translateY(-1px)}
    .btn-export{background:linear-gradient(135deg,#059669,#10b981);color:white}
    .btn-print{background:linear-gradient(135deg,#0891b2,#06b6d4);color:white}
    .btn-alert{background:linear-gradient(135deg,#d97706,#f59e0b);color:white}
    .btn-ghost{background:transparent;color:#64748b;border:1.5px solid #e2e8f0}
    .btn-spin{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:white;border-radius:50%;animation:spin .6s linear infinite}
    .modal-ov{position:fixed;inset:0;background:rgba(15,23,42,.5);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;z-index:1000;padding:20px}
    .modal-box{background:white;border-radius:22px;padding:32px;max-width:500px;width:100%;text-align:right;box-shadow:0 20px 48px rgba(0,0,0,.15)}
    .modal-box h4{font-weight:800;color:#0f172a;margin:0 0 16px;font-size:1.1rem;text-align:center}
    .modal-btns{display:flex;gap:8px;margin-top:20px}
    .ob-form{display:flex;flex-direction:column;gap:14px}
    .ob-row{display:grid;grid-template-columns:1fr 1fr;gap:14px}
    .f-field{display:flex;flex-direction:column;gap:5px}
    .f-label{font-size:.82rem;font-weight:700;color:#334155}
    .required::after{content:' *';color:#ef4444}
    .f-input{padding:10px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.88rem;background:white;outline:none;width:100%;transition:.2s}
    .f-input:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
    .form-msg{padding:10px 14px;border-radius:10px;font-size:.84rem;font-weight:600;margin-top:12px}
    .msg-ok{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}
    .msg-err{background:#fef2f2;color:#dc2626;border:1px solid #fecaca}
    .toast-wrap{position:fixed;bottom:22px;left:22px;z-index:1050;animation:toastIn .35s ease}
    .toast{display:flex;align-items:center;gap:12px;padding:14px 20px;border-radius:14px;box-shadow:0 10px 28px rgba(0,0,0,.12);min-width:320px;font-weight:600;font-size:.88rem}
    .t-ok{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}
    .t-err{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}
    .toast button{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-right:auto;font-size:1.1rem}
    .loading-st{text-align:center;padding:50px 20px;color:#64748b}
    .loader{width:36px;height:36px;border:3px solid #e2e8f0;border-top-color:#2563eb;border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}
    .empty-st{text-align:center;padding:50px 20px;background:white;border-radius:18px;border:1px solid #e2e8f0}
    .empty-st h4{color:#64748b;margin:0}
    .no-access{text-align:center;padding:60px 20px;background:white;border-radius:20px;border:1px solid #e2e8f0}
    .na-icon{font-size:3rem;margin-bottom:12px}
    @@keyframes spin{to{transform:rotate(360deg)}}
    @@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
    @@media(max-width:768px){.page-hdr{flex-direction:column}.filter-row{flex-direction:column}.search-wrap{min-width:100%}.stats-row{grid-template-columns:repeat(2,1fr)}.ob-row{grid-template-columns:1fr}.hdr-actions{width:100%}}
</style>

@code {
    [Parameter] public int ItemIdParam { get; set; }

    private List<StockBalanceDto>? balances;
    private List<StockBalanceDto> filtered = new();
    private InventoryDashboardDto? dashboard;
    private ModulePermissionDto? permissions;
    private List<LookupDto>? warehouses;
    private List<SearchableItem>? allItems;

    private string searchText = "";
    private int filterWarehouse = 0;
    private int filterType = 0;
    private int filterAlert = -1;

    private bool isExporting = false;
    private bool isChecking = false;
    private string toast = "";
    private bool toastOk = true;

    private bool showOBDialog = false;
    private int obItem = 0;
    private int obWarehouse = 0;
    private decimal obQty = 0;
    private decimal obCost = 0;
    private bool isSavingOB = false;
    private string obMsg = "";
    private bool obMsgOk = true;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_STOCK");

        if (permissions != null && permissions.CanView)
        {
            warehouses = await LookupService.GetWarehousesAsync();
            await LoadData();

            if (ItemIdParam > 0 && balances != null)
            {
                filtered = balances.Where(b => b.ItemID == ItemIdParam).ToList();
                if (!filtered.Any())
                {
                    Navigation.NavigateTo($"/stock-movements?itemId={ItemIdParam}");
                    return;
                }
            }

            try { await InvService.CheckAndSendStockAlertsAsync(UserSession.UserID); }
            catch { }
        }
    }

    private async Task LoadData()
    {
        dashboard = await InvService.GetDashboardAsync();
        await LoadBalances();
    }

    private async Task LoadBalances()
    {
        balances = await InvService.GetStockBalancesAsync(
            filterWarehouse > 0 ? filterWarehouse : null,
            filterType > 0 ? filterType : null,
            null);
        Filter();
    }

    private void Filter()
    {
        if (balances == null) return;
        filtered = balances.Where(b =>
            (filterAlert == -1 || b.StockAlert == filterAlert) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(b.ItemCode, searchText) ||
             ArabicSearchHelper.Contains(b.ItemNameAr, searchText) ||
             ArabicSearchHelper.Contains(b.WarehouseNameAr, searchText))
        ).ToList();
    }

    private void ClearSearch() { searchText = ""; Filter(); }

    private void ClearItemFilter()
    {
        ItemIdParam = 0;
        Filter();
        Navigation.NavigateTo("/stock-balances", forceLoad: false);
    }

    private void ViewCard(int itemId) => Navigation.NavigateTo($"/stock-movements?itemId={itemId}");

    private async Task CheckAlerts()
    {
        isChecking = true;
        StateHasChanged();
        try
        {
            var count = await InvService.CheckAndSendStockAlertsAsync(UserSession.UserID);
            dashboard = await InvService.GetDashboardAsync();
            toast = count > 0 ? $"تم إرسال {count} تنبيه ✅" : "لا توجد تنبيهات حالياً ✅";
            toastOk = true;
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isChecking = false; StateHasChanged(); }
    }

    private async Task ShowOpeningBalance()
    {
        if (allItems == null) allItems = await LookupService.GetItemsSearchableAsync();
        obItem = 0; obWarehouse = 0; obQty = 0; obCost = 0; obMsg = "";
        showOBDialog = true;
    }

    private async Task SaveOpeningBalance()
    {
        obMsg = "";
        if (obItem <= 0) { obMsg = "اختر الصنف"; obMsgOk = false; return; }
        if (obWarehouse <= 0) { obMsg = "اختر المخزن"; obMsgOk = false; return; }
        if (obQty <= 0) { obMsg = "أدخل الكمية"; obMsgOk = false; return; }
        isSavingOB = true; StateHasChanged();
        try
        {
            await InvService.SetOpeningBalanceAsync(obItem, obWarehouse, obQty, obCost, UserSession.UserID);
            obMsg = "تم إضافة الرصيد الافتتاحي ✅"; obMsgOk = true;
            await LoadData();
        }
        catch (Exception ex) { obMsg = "خطأ: " + ex.Message; obMsgOk = false; }
        finally { isSavingOB = false; StateHasChanged(); }
    }

    private async Task ExportExcel()
    {
        if (!filtered.Any()) return;
        isExporting = true; StateHasChanged();
        try
        {
            var bytes = await InvService.ExportBalancesToExcelAsync(filtered, UserSession.UserID);
            await JS.InvokeVoidAsync("downloadFile", $"StockBalances_{DateTime.Now:yyyyMMdd}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
            toast = "تم التصدير ✅"; toastOk = true;
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isExporting = false; StateHasChanged(); }
    }

    private async Task PrintReport()
    {
        if (!filtered.Any()) return;
        var rows = "";
        int n = 0;
        foreach (var b in filtered)
        {
            n++;
            var alertStyle = b.StockAlert switch { 3 => "color:#dc2626;font-weight:800;", 2 => "color:#f97316;font-weight:700;", 1 => "color:#f59e0b;", _ => "" };
            var typeColor = GetItemTypeColor(b.ItemType);
            rows += $"<tr><td style='text-align:center'>{n}</td><td style='font-weight:700;color:#2563eb'>{b.ItemCode}</td><td style='font-weight:800'>{b.ItemNameAr}</td><td style='font-weight:800;color:{typeColor}'>{b.ItemTypeName}</td><td style='font-weight:600'>{b.WarehouseNameAr}</td><td>{b.PrimaryUnitName}</td><td style='text-align:center;font-weight:800;{(b.CurrentQty <= 0 ? "color:#dc2626;" : "")}'>{b.CurrentQty:#,##0.##}</td><td style='text-align:center'>{b.AvailableQty:#,##0.##}</td><td style='text-align:left;font-family:monospace'>{b.AverageCost:#,##0.00}</td><td style='text-align:left;font-weight:700;font-family:monospace'>{b.TotalValue:#,##0.00}</td><td style='{alertStyle}'>{b.StockAlertName}</td></tr>";
        }
        var totalValue = filtered.Sum(b => b.TotalValue);
        var alertItems = filtered.Count(b => b.StockAlert >= 2);
        var html = $@"<!DOCTYPE html><html dir='rtl' lang='ar'><head><meta charset='utf-8'><title>أرصدة المخزون</title><style>*{{margin:0;padding:0;box-sizing:border-box}}body{{font-family:'Cairo','Segoe UI',sans-serif;padding:25px;color:#0f172a;font-size:11px}}.header{{text-align:center;border-bottom:3px solid #1e293b;padding-bottom:18px;margin-bottom:18px}}.company{{font-size:20px;font-weight:800}}.report-title{{font-size:14px;color:#475569;margin-top:4px}}.report-date{{font-size:10px;color:#94a3b8;margin-top:4px}}.summary{{display:flex;justify-content:center;gap:24px;margin-bottom:18px;flex-wrap:wrap}}.summary-item{{text-align:center;padding:10px 20px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;min-width:100px}}.summary-value{{font-size:16px;font-weight:900}}.summary-label{{font-size:9px;color:#64748b;margin-top:2px}}table{{width:100%;border-collapse:collapse}}th{{background:#1e293b;color:white;padding:8px;font-size:10px;text-align:right;white-space:nowrap}}td{{padding:6px 8px;border-bottom:1px solid #e2e8f0;font-size:10px}}tr:nth-child(even){{background:#f8fafc}}.total-row{{font-weight:800;background:#f1f5f9!important;border-top:2px solid #1e293b}}.footer{{text-align:center;margin-top:20px;padding-top:10px;border-top:1px solid #e2e8f0;font-size:9px;color:#94a3b8}}</style></head><body><div class='header'><div class='company'>مصنع واي كي كوتينج لمستحضرات التجميل</div><div class='report-title'>تقرير أرصدة المخزون</div><div class='report-date'>تاريخ التقرير: {DateTime.Now:dd/MM/yyyy hh:mm tt}</div></div><div class='summary'><div class='summary-item'><div class='summary-value'>{filtered.Count}</div><div class='summary-label'>عدد الأصناف</div></div><div class='summary-item'><div class='summary-value'>{totalValue:#,##0}</div><div class='summary-label'>قيمة المخزون</div></div><div class='summary-item'><div class='summary-value' style='color:#ef4444'>{alertItems}</div><div class='summary-label'>تحتاج انتباه</div></div></div><table><thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>النوع</th><th>المخزن</th><th>الوحدة</th><th>الرصيد</th><th>المتاح</th><th>التكلفة</th><th>القيمة</th><th>الحالة</th></tr></thead><tbody>{rows}<tr class='total-row'><td colspan='9' style='text-align:left'><strong>الإجمالي</strong></td><td style='text-align:left'><strong>{totalValue:#,##0.00} ج.م</strong></td><td></td></tr></tbody></table><div class='footer'>تم الطباعة: {DateTime.Now:dd/MM/yyyy hh:mm tt} — واي كي كوتينج ERP v2.0</div></body></html>";
        await JS.InvokeVoidAsync("printHtml", html);
    }

    private static string GetItemTypeColor(int t) => t switch { 1 => "#1d4ed8", 2 => "#0891b2", 3 => "#f97316", 4 => "#059669", 5 => "#64748b", _ => "#6b7280" };
    private static string GetAlertColor(int a) => a switch { 0 => "#10b981", 1 => "#f59e0b", 2 => "#f97316", 3 => "#ef4444", _ => "#6b7280" };
}