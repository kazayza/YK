</style>

@code {
    [Parameter] public int ItemIdParam { get; set; }

    private List<StockBalanceDto>? balances;
    private List<StockBalanceDto> filtered = new();
    private InventoryDashboardDto? dashboard;
    private ModulePermissionDto? permissions;
    private List<LookupDto>? warehouses;
    private List<SearchableItem>? allItems;

    private string searchText = "";
    private int filterWarehouse = 0;
    private int filterType = 0;
    private int filterAlert = -1;

    private bool isExporting = false;
    private bool isChecking = false;
    private string toast = "";
    private bool toastOk = true;

    private bool showOBDialog = false;
    private int obItem = 0;
    private int obWarehouse = 0;
    private decimal obQty = 0;
    private decimal obCost = 0;
    private bool isSavingOB = false;
    private string obMsg = "";
    private bool obMsgOk = true;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_STOCK");

        if (permissions != null && permissions.CanView)
        {
            warehouses = await LookupService.GetWarehousesAsync();
            await LoadData();

            if (ItemIdParam > 0 && balances != null)
            {
                filtered = balances.Where(b => b.ItemID == ItemIdParam).ToList();
                if (!filtered.Any())
                {
                    Navigation.NavigateTo($"/stock-movements?itemId={ItemIdParam}");
                    return;
                }
            }

            try { await InvService.CheckAndSendStockAlertsAsync(UserSession.UserID); }
            catch { }
        }
    }

    private async Task LoadData()
    {
        dashboard = await InvService.GetDashboardAsync();
        await LoadBalances();
    }

    private async Task LoadBalances()
    {
        balances = await InvService.GetStockBalancesAsync(
            filterWarehouse > 0 ? filterWarehouse : null,
            filterType > 0 ? filterType : null,
            null);
        Filter();
    }

    private void Filter()
    {
        if (balances == null) return;
        filtered = balances.Where(b =>
            (filterAlert == -1 || b.StockAlert == filterAlert) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(b.ItemCode, searchText) ||
             ArabicSearchHelper.Contains(b.ItemNameAr, searchText) ||
             ArabicSearchHelper.Contains(b.WarehouseNameAr, searchText))
        ).ToList();
    }

    private void ClearSearch() { searchText = ""; Filter(); }

    private void ClearItemFilter()
    {
        ItemIdParam = 0;
        Filter();
        Navigation.NavigateTo("/stock-balances", forceLoad: false);
    }

    private void ViewCard(int itemId) => Navigation.NavigateTo($"/stock-movements?itemId={itemId}");

    private async Task CheckAlerts()
    {
        isChecking = true;
        StateHasChanged();
        try
        {
            var count = await InvService.CheckAndSendStockAlertsAsync(UserSession.UserID);
            dashboard = await InvService.GetDashboardAsync();
            toast = count > 0 ? $"تم إرسال {count} تنبيه " : "لا توجد تنبيهات حالياً ";
            toastOk = true;
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isChecking = false; StateHasChanged(); }
    }

    private async Task ShowOpeningBalance()
    {
        if (allItems == null) allItems = await LookupService.GetItemsSearchableAsync();
        obItem = 0; obWarehouse = 0; obQty = 0; obCost = 0; obMsg = "";
        showOBDialog = true;
    }

    private async Task SaveOpeningBalance()
    {
        obMsg = "";
        if (obItem <= 0) { obMsg = "اختر الصنف"; obMsgOk = false; return; }
        if (obWarehouse <= 0) { obMsg = "اختر المخزن"; obMsgOk = false; return; }
        if (obQty <= 0) { obMsg = "أدخل الكمية"; obMsgOk = false; return; }
        isSavingOB = true; StateHasChanged();
        try
        {
            await InvService.SetOpeningBalanceAsync(obItem, obWarehouse, obQty, obCost, UserSession.UserID);
            obMsg = "تم إضافة الرصيد الافتتاحي "; obMsgOk = true;
            await LoadData();
        }
        catch (Exception ex) { obMsg = "خطأ: " + ex.Message; obMsgOk = false; }
        finally { isSavingOB = false; StateHasChanged(); }
    }

    private async Task ExportExcel()
    {
        if (!filtered.Any()) return;
        isExporting = true; StateHasChanged();
        try
        {
            var bytes = await InvService.ExportBalancesToExcelAsync(filtered, UserSession.UserID);
            await JS.InvokeVoidAsync("downloadFile", $"StockBalances_{DateTime.Now:yyyyMMdd}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
            toast = "تم التصدير "; toastOk = true;
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isExporting = false; StateHasChanged(); }
    }

    private async Task PrintReport()
    {
        if (!filtered.Any()) return;
        var rows = "";
        int n = 0;
        foreach (var b in filtered)
        {
            n++;
            var alertStyle = b.StockAlert switch { 3 => "color:#dc2626;font-weight:800;", 2 => "color:#f97316;font-weight:700;", 1 => "color:#f59e0b;", _ => "" };
            var typeColor = GetItemTypeColor(b.ItemType);
            rows += $"<tr><td style='text-align:center'>{n}</td><td style='font-weight:700;color:#2563eb'>{b.ItemCode}</td><td style='font-weight:800'>{b.ItemNameAr}</td><td style='font-weight:800;color:{typeColor}'>{b.ItemTypeName}</td><td style='font-weight:600'>{b.WarehouseNameAr}</td><td>{b.PrimaryUnitName}</td><td style='text-align:center;font-weight:800;{(b.CurrentQty <= 0 ? "color:#dc2626;" : "")}'>{b.CurrentQty:#,##0.##}</td><td style='text-align:center'>{b.AvailableQty:#,##0.##}</td><td style='text-align:left;font-family:monospace'>{b.AverageCost:#,##0.00}</td><td style='text-align:left;font-weight:700;font-family:monospace'>{b.TotalValue:#,##0.00}</td><td style='{alertStyle}'>{b.StockAlertName}</td></tr>";
        }
        var totalValue = filtered.Sum(b => b.TotalValue);
        var alertItems = filtered.Count(b => b.StockAlert >= 2);
        var html = $@"<!DOCTYPE html><html dir='rtl' lang='ar'><head><meta charset='utf-8'><title>أرصدة المخزون</title><style>*{{margin:0;padding:0;box-sizing:border-box}}body{{font-family:'Tajawal','Cairo','Segoe UI',sans-serif;padding:25px;color:#0f172a;font-size:11px}}.header{{text-align:center;border-bottom:3px solid #0A0F1E;padding-bottom:18px;margin-bottom:18px}}.company{{font-size:20px;font-weight:800}}.report-title{{font-size:14px;color:#475569;margin-top:4px}}.report-date{{font-size:10px;color:#94a3b8;margin-top:4px}}.summary{{display:flex;justify-content:center;gap:24px;margin-bottom:18px;flex-wrap:wrap}}.summary-item{{text-align:center;padding:10px 20px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;min-width:100px}}.summary-value{{font-size:16px;font-weight:900}}.summary-label{{font-size:9px;color:#64748b;margin-top:2px}}table{{width:100%;border-collapse:collapse}}th{{background:#0A0F1E;color:#F5E6C8;padding:8px;font-size:10px;text-align:right;white-space:nowrap}}td{{padding:6px 8px;border-bottom:1px solid #e2e8f0;font-size:10px}}tr:nth-child(even){{background:#f8fafc}}.total-row{{font-weight:800;background:#f1f5f9!important;border-top:2px solid #0A0F1E}}.footer{{text-align:center;margin-top:20px;padding-top:10px;border-top:1px solid #e2e8f0;font-size:9px;color:#94a3b8}}</style></head><body><div class='header'><div class='company'>مصنع واي كي كوتينج  </div><div class='report-title'>تقرير أرصدة المخزون</div><div class='report-date'>تاريخ التقرير: {DateTime.Now:dd/MM/yyyy hh:mm tt}</div></div><div class='summary'><div class='summary-item'><div class='summary-value'>{filtered.Count}</div><div class='summary-label'>عدد الأصناف</div></div><div class='summary-item'><div class='summary-value'>{totalValue:#,##0}</div><div class='summary-label'>قيمة المخزون</div></div><div class='summary-item'><div class='summary-value' style='color:#ef4444'>{alertItems}</div><div class='summary-label'>تحتاج انتباه</div></div></div><table><thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>النوع</th><th>المخزن</th><th>الوحدة</th><th>الرصيد</th><th>المتاح</th><th>التكلفة</th><th>القيمة</th><th>الحالة</th></tr></thead><tbody>{rows}<tr class='total-row'><td colspan='9' style='text-align:left'><strong>الإجمالي</strong></td><td style='text-align:left'><strong>{totalValue:#,##0.00} ج.م</strong></td><td></td></tr></tbody></table><div class='footer'>تم الطباعة: {DateTime.Now:dd/MM/yyyy hh:mm tt} — واي كي كوتينج ERP Gold v2.0</div></body></html>";
        await JS.InvokeVoidAsync("printHtml", html);
    }

    private static string GetItemTypeColor(int t) => t switch { 1 => "#1d4ed8", 2 => "#0891b2", 3 => "#f97316", 4 => "#059669", 5 => "#64748b", _ => "#6b7280" };
    private static string GetAlertColor(int a) => a switch { 0 => "#10b981", 1 => "#f59e0b", 2 => "#f97316", 3 => "#ef4444", _ => "#6b7280" };
}
