    private bool showEdit = false;
    private ChartOfAccountDto editDto = new();
    private bool isSaving = false;
    private string editMsg = "";
    private bool editOk = true;
    private string toast = "";
    private bool toastOk = true;

    private string searchText = "";
    private int filterType = 0;
    private int filterDetail = 0;
    private int viewMode = 0; // 0=Tree+Details, 1=Detailed Table
    private HashSet<int> expandedIds = new();
    private bool isAllExpanded = true;
    private ChartOfAccountDto? selectedAccount = null;

    protected override async Task OnInitializedAsync(){ await LoadData(); }

    private async Task LoadData()
    {
        isLoading=true; StateHasChanged();
        try
        {
            accounts = await AccountingService.GetChartOfAccountsAsync();
            flatAccounts = await AccountingService.GetFlatAccountsAsync();
            totalCount = flatAccounts.Count;
            expandedIds = new HashSet<int>(flatAccounts.Where(a=>a.AccountLevel<=2).Select(a=>a.AccountID));
            if (flatAccounts.Any()) selectedAccount = flatAccounts.First(a=>a.AccountLevel==1);
            ApplyFilter();
        }
        catch(Exception ex){ toast="خطأ: "+ex.Message; toastOk=false; }
        finally{ isLoading=false; }
    }

    private void ApplyFilter()
    {
        if (!flatAccounts.Any()){ filteredRoots=new(); filteredFlat=new(); filteredCount=0; return; }

        bool Matches(ChartOfAccountDto a)
        {
            if (filterType!=0 && a.AccountType!=filterType) return false;
            if (filterDetail==1 && a.IsDetailAccount) return false;
            if (filterDetail==2 && !a.IsDetailAccount) return false;
            if (!string.IsNullOrWhiteSpace(searchText))
            {
                if (!ArabicSearchHelper.Contains(a.AccountCode, searchText) && !ArabicSearchHelper.Contains(a.AccountNameAr, searchText) && !ArabicSearchHelper.Contains(a.AccountNameEn, searchText))
                    return false;
            }
            return true;
        }

        bool HasMatchingDescendant(ChartOfAccountDto node)
        {
            if (Matches(node)) return true;
            foreach(var child in node.Children)
                if (HasMatchingDescendant(child)) return true;
            return false;
        }

        List<ChartOfAccountDto> FilterNodes(List<ChartOfAccountDto> nodes)
        {
            var res = new List<ChartOfAccountDto>();
            foreach(var node in nodes)
            {
                if (!HasMatchingDescendant(node)) continue;
                var clone = new ChartOfAccountDto{
                    AccountID=node.AccountID, AccountCode=node.AccountCode, AccountNameAr=node.AccountNameAr, AccountNameEn=node.AccountNameEn,
                    ParentAccountID=node.ParentAccountID, AccountLevel=node.AccountLevel, AccountType=node.AccountType, AccountTypeName=node.AccountTypeName,
                    AccountNature=node.AccountNature, IsDetailAccount=node.IsDetailAccount, CurrencyID=node.CurrencyID, CostCenterRequired=node.CostCenterRequired,
                    OpeningBalance=node.OpeningBalance, CurrentBalance=node.CurrentBalance, LinkedEntityType=node.LinkedEntityType, LinkedEntityID=node.LinkedEntityID,
                    IsSystemAccount=node.IsSystemAccount, IsCashFlowAccount=node.IsCashFlowAccount, SortOrder=node.SortOrder, Description=node.Description,
                    IsActive=node.IsActive, ChildrenCount=node.ChildrenCount
                };
                clone.Children = FilterNodes(node.Children);
                res.Add(clone);
            }
            return res;
        }

        filteredRoots = FilterNodes(accounts);
        filteredFlat = flatAccounts.Where(Matches).ToList();
        filteredCount = CountAll(filteredRoots);

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var allIds = new HashSet<int>();
            void Collect(List<ChartOfAccountDto> nodes){ foreach(var n in nodes){ allIds.Add(n.AccountID); Collect(n.Children);} }
            Collect(filteredRoots);
            expandedIds = allIds;
            isAllExpanded=true;
        }
    }

    private int CountAll(List<ChartOfAccountDto> nodes){ int c=0; foreach(var n in nodes){ c++; c+=CountAll(n.Children);} return c; }
    private void ClearSearch(){ searchText=""; ApplyFilter(); }
    private void ToggleExpand(int id){ if(expandedIds.Contains(id)) expandedIds.Remove(id); else expandedIds.Add(id); }
    private void ToggleAll(){ if(isAllExpanded){ expandedIds.Clear(); isAllExpanded=false; } else { expandedIds=new HashSet<int>(flatAccounts.Select(a=>a.AccountID)); isAllExpanded=true; } }
    private void SelectAccount(int id){ selectedAccount = flatAccounts.FirstOrDefault(a=>a.AccountID==id) ?? accounts.SelectMany(Flatten).FirstOrDefault(a=>a.AccountID==id); if(selectedAccount!=null){ var full=accounts.SelectMany(Flatten).FirstOrDefault(a=>a.AccountID==id); if(full!=null) selectedAccount=full; } }
    private IEnumerable<ChartOfAccountDto> Flatten(ChartOfAccountDto node){ yield return node; foreach(var child in node.Children) foreach(var sub in Flatten(child)) yield return sub; }
    private List<ChartOfAccountDto> GetBreadcrumb(int id)
    {
        var path = new List<ChartOfAccountDto>();
        var dict = flatAccounts.ToDictionary(a=>a.AccountID);
        int? cur = dict.ContainsKey(id) ? dict[id].ParentAccountID : null;
        while(cur.HasValue && cur.Value!=0 && dict.ContainsKey(cur.Value)){ path.Insert(0, dict[cur.Value]); cur=dict[cur.Value].ParentAccountID; }
        return path;
    }

    private RenderFragment RenderTreeNode(ChartOfAccountDto acc, int level) => __builder =>
    {
        bool isExpanded = expandedIds.Contains(acc.AccountID);
        bool hasChildren = acc.Children.Any();
        bool isSelected = selectedAccount?.AccountID==acc.AccountID;
        <div>
            <div class="tree-node @(isSelected?"selected":"") @(acc.IsDetailAccount?"":"group")" style="margin-right:@(level*16)px" @onclick="()=>SelectAccount(acc.AccountID)" @key="acc.AccountID">
                @if(hasChildren)
                {
                    <button class="tree-expand @(isExpanded?"expanded":"")" @onclick:stopPropagation="true" @onclick="()=>ToggleExpand(acc.AccountID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button>
                }
                else{<div style="width:22px;flex-shrink:0"></div>}
                <div class="tree-icon type-@acc.AccountType">
                    @if(acc.AccountType==1){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 6h14a2 2 0 0 1 2 2v8"/><path d="M9 21V10"/></svg>}
                    else if(acc.AccountType==2){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
                    else if(acc.AccountType==3){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>}
                    else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
                </div>
                <span class="tree-code">@acc.AccountCode</span>
                <span class="tree-name">@acc.AccountNameAr</span>
                @if(!acc.IsDetailAccount){<span class="tree-dot group"></span>}else{<span class="tree-dot detail"></span>}
            </div>
            @if(hasChildren && isExpanded){ @foreach(var child in acc.Children){ @RenderTreeNode(child, level+1) } }
        </div>;
    };

    private void ShowAddRoot(){ editDto=new ChartOfAccountDto{ IsActive=true, AccountType=1, AccountNature=1, AccountLevel=1, IsDetailAccount=true, ParentAccountID=null }; editMsg=""; showEdit=true; }
    private void ShowAddChild(int parentId){ var parent=flatAccounts.FirstOrDefault(a=>a.AccountID==parentId); editDto=new ChartOfAccountDto{ IsActive=true, AccountType=parent?.AccountType??1, AccountNature=parent?.AccountNature??1, IsDetailAccount=true, ParentAccountID=parentId, AccountLevel=(parent?.AccountLevel??0)+1 }; editMsg=""; showEdit=true; }
    private async Task ShowEdit(int id){ var dto=await AccountingService.GetAccountByIdAsync(id); if(dto!=null){ editDto=dto; editMsg=""; showEdit=true; } }
    private void CloseEdit(){ showEdit=false; }

    private async Task SaveAccount()
    {
        if(string.IsNullOrWhiteSpace(editDto.AccountNameAr)){ editMsg="أدخل اسم الحساب"; editOk=false; return; }
        isSaving=true; StateHasChanged();
        try
        {
            if(editDto.AccountID==0){ await AccountingService.InsertAccountAsync(editDto, UserSession.UserID); toast="تم إنشاء الحساب ✅"; toastOk=true; }
            else{ await AccountingService.UpdateAccountAsync(editDto, UserSession.UserID); toast="تم تحديث الحساب ✅"; toastOk=true; }
            showEdit=false; await LoadData();
        }
        catch(Exception ex){ editMsg=ex.Message; editOk=false; }
        finally{ isSaving=false; }
    }
}
