@page "/chart-of-accounts"
@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject AccountingService AccountingService
@inject UserSessionService UserSession
@inject PermissionService PermissionService

<PageTitle>شجرة الحسابات - Gold Edition Pro</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><h4>يجب تسجيل الدخول</h4></div>}
else
{
<div class="luxury-page" dir="rtl">
    <!-- Header -->
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
        <div class="lh-content">
            <div class="lh-right">
                <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                <div class="lh-text">
                    <h2 class="lh-title">شجرة الحسابات</h2>
                    <p class="lh-subtitle">عرض شجري هرمي + عرض تفصيلي جدولي</p>
                </div>
            </div>
            <div class="lh-actions">
                <div class="view-toggle-luxury">
                    <button class="vt-btn @(viewMode==0?"active":"")" @onclick="()=>viewMode=0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3h7v7H3z"/><path d="M14 3h7v7h-7z"/><path d="M3 14h7v7H3z"/><path d="M14 14h7v7h-7z"/></svg>شجري</button>
                    <button class="vt-btn @(viewMode==1?"active":"")" @onclick="()=>viewMode=1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>تفصيلي</button>
                </div>
                <span class="lh-badge"><span class="lh-dot"></span>@totalCount حساب</span>
                <button class="btn-luxury btn-primary-luxury" @onclick="ShowAddRoot"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>حساب رئيسي</button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل شجرة الحسابات...</p></div>}
    else
    {
        <!-- Stats -->
        <div class="stats-luxury">
            <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7"/><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M19 3h2a2 2 0 0 1 2 2v2"/></svg></div><div class="st-info"><span class="st-value">@totalCount</span><span class="st-label">إجمالي الحسابات</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></div><div class="st-info"><span class="st-value">@flatAccounts.Count(a=>a.AccountLevel==1)</span><span class="st-label">رئيسية</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div class="st-info"><span class="st-value">@flatAccounts.Count(a=>!a.IsDetailAccount)</span><span class="st-label">مجموعات</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@flatAccounts.Count(a=>a.IsDetailAccount)</span><span class="st-label">تفصيلية</span></div><div class="st-gold-line"></div></div>
        </div>

        <!-- Filter -->
        <div class="filter-luxury">
            <div class="search-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="بحث سريع بالكود أو الاسم..." @bind="searchText" @bind:event="oninput" @onkeyup="ApplyFilter" />
                @if(!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}
            </div>
            <div class="select-wrap-luxury"><select @bind="filterType" @bind:after="ApplyFilter"><option value="0">كل الأنواع</option><option value="1">أصول</option><option value="2">التزامات</option><option value="3">حقوق ملكية</option><option value="4">إيرادات</option><option value="5">تكلفة</option><option value="6">مصروفات</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><select @bind="filterDetail" @bind:after="ApplyFilter"><option value="0">الكل</option><option value="1">مجموعة</option><option value="2">تفصيلي</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="ToggleAll"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>@(isAllExpanded?"طي":"توسيع")</button>
        </div>

        @if (viewMode==0)
        {
            <!-- Tree View - Split Luxury -->
            <div class="coa-split">
                <!-- Tree Panel -->
                <div class="tree-panel">
                    <div class="panel-head"><h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7"/><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M19 3h2a2 2 0 0 1 2 2v2"/></svg>الهيكل الشجري — @filteredCount حساب</h3></div>
                    <div class="tree-body">
                        @if (!filteredRoots.Any()){<div class="empty-mini">لا توجد نتائج</div>}
                        else
                        {
                            @foreach(var root in filteredRoots){ @RenderTreeNode(root, 0) }
                        }
                    </div>
                </div>

                <!-- Details Panel -->
                <div class="details-panel">
                    @if (selectedAccount==null)
                    {
                        <div class="empty-details">
                            <div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></div>
                            <h4>اختر حساب من الشجرة</h4>
                            <p class="empty-sub">اضغط على أي حساب لعرض تفاصيله وأرصدته وأبنائه</p>
                        </div>
                    }
                    else
                    {
                        <div class="detail-card">
                            <div class="dc-gold-line"></div>
                            <div class="dc-header">
                                <div class="dc-icon type-@selectedAccount.AccountType">
                                    @if(selectedAccount.AccountType==1){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 6h14a2 2 0 0 1 2 2v8"/><path d="M9 21V10"/></svg>}
                                    else if(selectedAccount.AccountType==2){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
                                    else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>}
                                </div>
                                <div class="dc-info">
                                    <span class="dc-code">@selectedAccount.AccountCode</span>
                                    <h3 class="dc-name">@selectedAccount.AccountNameAr</h3>
                                    @if(!string.IsNullOrEmpty(selectedAccount.AccountNameEn)){<span class="dc-name-en">@selectedAccount.AccountNameEn</span>}
                                    <div class="dc-badges">
                                        <span class="coa-type type-@selectedAccount.AccountType">@selectedAccount.AccountTypeName</span>
                                        <span class="coa-level">L@(selectedAccount.AccountLevel)</span>
                                        @if(!selectedAccount.IsDetailAccount){<span class="coa-detail group">مجموعة</span>}else{<span class="coa-detail detail">تفصيلي</span>}
                                        @if(selectedAccount.IsSystemAccount){<span class="coa-detail system">نظامي</span>}
                                    </div>
                                </div>
                                <div class="dc-actions">
                                    <button class="act-btn add" title="إضافة فرعي" @onclick="()=>ShowAddChild(selectedAccount.AccountID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></button>
                                    <button class="act-btn edit" title="تعديل" @onclick="()=>ShowEdit(selectedAccount.AccountID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
                                </div>
                            </div>

                            <div class="dc-breadcrumb">
                                @foreach(var crumb in GetBreadcrumb(selectedAccount.AccountID)){<span class="bc-item">@crumb.AccountCode</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>}
                                <span class="bc-current">@selectedAccount.AccountCode</span>
                            </div>

                            <div class="dc-stats">
                                <div class="dc-stat"><span class="dc-stat-label">الرصيد الافتتاحي</span><span class="dc-stat-value">@selectedAccount.OpeningBalance.ToString("#,##0.00")</span></div>
                                <div class="dc-stat"><span class="dc-stat-label">الرصيد الحالي</span><span class="dc-stat-value gold">@selectedAccount.CurrentBalance.ToString("#,##0.00")</span></div>
                                <div class="dc-stat"><span class="dc-stat-label">عدد الأبناء</span><span class="dc-stat-value">@selectedAccount.Children.Count</span></div>
                                <div class="dc-stat"><span class="dc-stat-label">الطبيعة</span><span class="dc-stat-value">@(selectedAccount.AccountNature==1?"مدين":"دائن")</span></div>
                            </div>

                            @if (selectedAccount.Children.Any())
                            {
                                <div class="dc-children">
                                    <h4>الحسابات الفرعية (@selectedAccount.Children.Count)</h4>
                                    <div class="children-list">
                                        @foreach(var child in selectedAccount.Children)
                                        {
                                            <div class="child-item" @onclick="()=>SelectAccount(child.AccountID)">
                                                <span class="child-code">@child.AccountCode</span>
                                                <span class="child-name">@child.AccountNameAr</span>
                                                <span class="child-type type-@child.AccountType">@child.AccountTypeName</span>
                                                <span class="child-balance">@child.CurrentBalance.ToString("#,##0.00")</span>
                                                @if(!child.IsDetailAccount){<span class="child-dot group"></span>}else{<span class="child-dot detail"></span>}
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(selectedAccount.Description))
                            {
                                <div class="dc-desc"><h4>الوصف</h4><p>@selectedAccount.Description</p></div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Detailed Table View - Dribbble Sales Product List Inspired -->
            <div class="table-card-luxury">
                <div class="card-head-luxury">
                    <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>العرض التفصيلي — جدول فاخر واسع — @filteredFlat.Count حساب</h3>
                    <div style="display:flex;gap:8px;align-items:center">
                        <span class="legend-dot" style="--c:#D4AF37"></span><span style="font-size:.7rem;color:#6b7280;font-weight:700">مجموعة</span>
                        <span class="legend-dot" style="--c:#10b981"></span><span style="font-size:.7rem;color:#6b7280;font-weight:700">تفصيلي</span>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table-luxury detailed">
                        <thead>
                            <tr>
                                <th class="th-num">#</th>
                                <th>الكود</th>
                                <th>الحساب (عربي / انجليزي)</th>
                                <th>الأب</th>
                                <th>المستوى</th>
                                <th>النوع</th>
                                <th>الطبيعة</th>
                                <th>التصنيف</th>
                                <th>افتتاحي</th>
                                <th>حالي</th>
                                <th>مركز تكلفة؟</th>
                                <th>الحالة</th>
                                <th class="th-actions">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{int n=0;}
                            @foreach(var acc in filteredFlat.OrderBy(a=>a.AccountCode)){n++;
                                <tr class="@(acc.IsDetailAccount?"":"group-row")" @key="acc.AccountID">
                                    <td class="td-num">@n</td>
                                    <td><span class="doc-num-luxury">@acc.AccountCode</span></td>
                                    <td>
                                        <div class="acc-cell">
                                            <div class="acc-icon type-@acc.AccountType">
                                                @if(acc.AccountType==1){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 21h18"/><path d="M3 10h18"/><path d="M5 6h14a2 2 0 0 1 2 2v8"/><path d="M9 21V10"/></svg>}
                                                else if(acc.AccountType==2){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>}
                                                else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>}
                                            </div>
                                            <div class="acc-info">
                                                <span class="acc-name">@acc.AccountNameAr</span>
                                                @if(!string.IsNullOrEmpty(acc.AccountNameEn)){<span class="acc-name-en">@acc.AccountNameEn</span>}
                                            </div>
                                            @if(!acc.IsDetailAccount){<span class="acc-dot group"></span>}else{<span class="acc-dot detail"></span>}
                                        </div>
                                    </td>
                                    <td class="td-muted">@(acc.ParentAccountNameAr ?? "—")</td>
                                    <td><span class="level-badge">L@(acc.AccountLevel)</span></td>
                                    <td><span class="coa-type type-@acc.AccountType">@acc.AccountTypeName</span></td>
                                    <td>@if(acc.AccountNature==1){<span class="nature-badge debit">مدين</span>}else{<span class="nature-badge credit">دائن</span>}</td>
                                    <td>
                                        @if(!acc.IsDetailAccount){<span class="coa-detail group">مجموعة (@acc.ChildrenCount)</span>}else{<span class="coa-detail detail">تفصيلي</span>}
                                        @if(acc.IsSystemAccount){<span class="coa-detail system">نظامي</span>}
                                    </td>
                                    <td><span class="amount-luxury" style="background:#f3f4f6;color:#6b7280">@acc.OpeningBalance.ToString("#,##0.00")</span></td>
                                    <td><span class="amount-luxury @(acc.CurrentBalance>=0?"":"negative")">@acc.CurrentBalance.ToString("#,##0.00")</span></td>
                                    <td class="td-center">@if(acc.CostCenterRequired){<span class="coa-detail" style="background:#fff7ed;color:#ea580c;border-color:#fed7aa">مطلوب</span>}else{<span style="color:#9ca3af">—</span>}</td>
                                    <td><span class="status-badge-luxury" style="--sc:@(acc.IsActive?"#10b981":"#6b7280")"><span class="status-dot" style="--sc:@(acc.IsActive?"#10b981":"#6b7280")"></span>@(acc.IsActive?"نشط":"موقوف")</span></td>
                                    <td class="td-center"><div class="actions-wrap-luxury">
                                        <button class="act-btn add" title="إضافة فرعي" @onclick="()=>ShowAddChild(acc.AccountID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg></button>
                                        <button class="act-btn edit" title="تعديل" @onclick="()=>ShowEdit(acc.AccountID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
                                    </div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@if (showEdit)
{
    <div class="modal-overlay-luxury" @onclick="CloseEdit"><div class="modal-card-luxury large" @onclick:stopPropagation="true">
        <div class="ml-gold-line"></div>
        <div class="ml-header"><h3>@(editDto.AccountID==0?"حساب جديد":"تعديل حساب") — ChartOfAccounts الفعلي</h3><button class="btn-close-x" @onclick="CloseEdit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
        <div class="ml-body">
            <div class="form-grid-luxury">
                <div class="fg"><label>كود الحساب</label><input type="text" @bind="editDto.AccountCode" placeholder="تلقائي" /></div>
                <div class="fg"><label>النوع *</label><select @bind="editDto.AccountType"><option value="1">أصول</option><option value="2">التزامات</option><option value="3">حقوق ملكية</option><option value="4">إيرادات</option><option value="5">تكلفة</option><option value="6">مصروفات</option></select></div>
                <div class="fg"><label>الطبيعة</label><select @bind="editDto.AccountNature"><option value="1">مدين</option><option value="2">دائن</option></select></div>
                <div class="fg"><label>الحساب الأب</label><select @bind="editDto.ParentAccountID"><option value="0">— رئيسي —</option>@foreach(var acc in flatAccounts.Where(a=>!a.IsDetailAccount)){<option value="@acc.AccountID">@acc.AccountCode - @acc.AccountNameAr</option>}</select></div>
                <div class="fg full"><label>اسم الحساب عربي *</label><input type="text" @bind="editDto.AccountNameAr" /></div>
                <div class="fg full"><label>اسم الحساب انجليزي</label><input type="text" @bind="editDto.AccountNameEn" /></div>
                <div class="fg"><label>تفصيلي؟ (IsDetailAccount)</label><label class="switch-luxury"><input type="checkbox" @bind="editDto.IsDetailAccount" /><span></span></label></div>
                <div class="fg"><label>نشط؟</label><label class="switch-luxury"><input type="checkbox" @bind="editDto.IsActive" /><span></span></label></div>
                <div class="fg"><label>نظامي؟</label><label class="switch-luxury"><input type="checkbox" @bind="editDto.IsSystemAccount" /><span></span></label></div>
                <div class="fg"><label>مركز تكلفة؟</label><label class="switch-luxury"><input type="checkbox" @bind="editDto.CostCenterRequired" /><span></span></label></div>
                <div class="fg"><label>الرصيد الافتتاحي</label><input type="number" @bind="editDto.OpeningBalance" step="0.01" /></div>
                <div class="fg"><label>الترتيب</label><input type="number" @bind="editDto.SortOrder" /></div>
                <div class="fg full"><label>الوصف</label><textarea @bind="editDto.Description" rows="2"></textarea></div>
            </div>
            @if(!string.IsNullOrEmpty(editMsg)){<div class="msg-luxury @(editOk?"msg-success":"msg-error")">@editMsg</div>}
        </div>
        <div class="ml-footer"><button class="btn-luxury btn-primary-luxury" @onclick="SaveAccount" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}حفظ</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseEdit">إلغاء</button></div>
    </div></div>
}

@if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast=""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,#121A2E 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain}
.lh-title{font-size:1.25rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.72rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
