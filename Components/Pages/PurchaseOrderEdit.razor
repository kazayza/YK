@page "/purchase-orders/new"
@page "/purchase-orders/edit/{OrderId:int}"
@page "/purchase-orders/view/{OrderId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PurchaseOrderService PoService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access"><div class="na-icon">🔒</div><h4>يجب تسجيل الدخول</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access"><div class="na-icon">⛔</div><h4>ليس لديك صلاحية</h4></div>
}
else
{
    <div class="doc-page" dir="rtl">

        <!-- ═══════════ Header ═══════════ -->
        <div class="doc-header">
            <div class="doc-header-right">
                <button class="btn-m btn-ghost" @onclick="GoBack">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5"/><path d="m12 19 7-7-7-7"/>
                    </svg> رجوع
                </button>
                <div>
                    <h2 class="doc-title">@pageTitle</h2>
                    @if (!string.IsNullOrEmpty(header.PONumber))
                    {
                        <div class="doc-num-wrap">
                            <code class="doc-number">@header.PONumber</code>
                            <span class="status-chip" style="--sc:@PurchaseOrderService.GetStatusColor(header.POStatus)">
                                @PurchaseOrderService.GetStatusName(header.POStatus)
                            </span>
                            @if (header.POSource > 0)
                            {
                                <span class="source-chip" style="color:@PurchaseOrderService.GetSourceColor(header.POSource)">
                                    @PurchaseOrderService.GetSourceName(header.POSource)
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="doc-header-left">
                @if (permissions.CanPrint && OrderId > 0)
                {
                    <button class="btn-m btn-outline" @onclick="PrintDoc">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="6 9 6 2 18 2 18 9"/>
                            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                            <rect x="6" y="14" width="12" height="8"/>
                        </svg> طباعة
                    </button>
                }
            </div>
        </div>

        <!-- ═══════════ Approval Bar ═══════════ -->
        @if (isApprovalMode)
        {
            <div class="approval-bar">
                <span class="approval-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 12l2 2 4-4"/><path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/>
                    </svg>
                    بانتظار اعتمادك
                </span>
                <button type="button" class="appr-btn appr-quick" @onclick="ExecuteApprove" disabled="@isSaving">
                    @if (isSaving) { <div class="btn-spin"></div> }
                    else
                    {
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                    }
                    اعتماد
                </button>
                <button type="button" class="appr-btn appr-reject" @onclick="DoShowReject" disabled="@isSaving">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>
                    </svg>
                    رفض
                </button>
            </div>
        }

        <!-- ═══════════ Sent Bar (بعد الاعتماد) ═══════════ -->
        @if (canMarkAsSent)
        {
            <div class="approval-bar" style="background:linear-gradient(135deg,#eff6ff,#dbeafe);border-color:#93c5fd;">
                <span class="approval-label" style="color:#1e40af;border-left-color:#93c5fd;">
                    📤 أمر الشراء معتمد — هل تريد إرساله للمورد؟
                </span>
                <div class="sent-method-wrap">
                    <select class="f-input sent-select" @bind="sentMethod">
                        <option value="">طريقة الإرسال...</option>
                        <option value="email">بريد إلكتروني</option>
                        <option value="fax">فاكس</option>
                        <option value="hand">تسليم يدوي</option>
                        <option value="whatsapp">واتساب</option>
                    </select>
                    <button type="button" class="appr-btn appr-detail" @onclick="ExecuteMarkAsSent" disabled="@isSaving">
                        📤 تأكيد الإرسال
                    </button>
                </div>
            </div>
        }

        @if (isLoading)
        {
            <div class="loading-st"><div class="loader"></div><p>جاري التحميل...</p></div>
        }
        else
        {
            <!-- ═══════════ مصدر الأمر (جديد فقط) ═══════════ -->
            @if (isNewMode && !isSourceLocked)
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon purple">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="M9 9h6v6"/>
                            </svg>
                        </div>
                        <h3 class="sec-title">مصدر أمر الشراء</h3>
                    </div>
                    <div class="source-cards">
                        <div class="source-card @(header.POSource == 1 ? "active" : "")" @onclick="SelectManualSource">
                            <div class="source-card-icon" style="background:#f5f3ff;color:#1d4ed8;">✏️</div>
                            <div class="source-card-title">أمر شراء يدوي</div>
                            <div class="source-card-desc">إنشاء أمر شراء جديد بدون طلب مسبق</div>
                        </div>
                        <div class="source-card @(header.POSource == 2 ? "active" : "")" @onclick="SelectPRSource">
                            <div class="source-card-icon" style="background:#ecfeff;color:#0891b2;">📋</div>
                            <div class="source-card-title">من طلب شراء معتمد</div>
                            <div class="source-card-desc">اختيار طلب شراء وتحميل الأصناف منه</div>
                        </div>
                    </div>
                </div>
            }

            <!-- ═══════════ اختيار طلب الشراء ═══════════ -->
            @if (header.POSource == 2 && isNewMode && !isPRLoaded)
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon cyan">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                        </div>
                        <h3 class="sec-title">اختيار طلب الشراء</h3>
                    </div>
                    <div class="form-grid c2">
                        <div class="f-field">
                            <label class="f-label required">طلب الشراء المعتمد</label>
                            <SearchableSelect Items="@approvedPRs" @bind-SelectedId="selectedPRId"
                                              OnSelected="OnPRSelected" Placeholder="ابحث برقم طلب الشراء..." />
                        </div>
                    </div>

                    @if (prLines != null && prLines.Any())
                    {
                        <div class="pr-lines-section">
                            <h4 class="pr-lines-title">الأصناف المتاحة من الطلب (@prLines.Count(l => l.IsSelected) مختار)</h4>
                            <div class="tbl-card" style="margin-top:10px;">
                                <table class="tbl">
                                    <thead>
                                        <tr>
                                            <th class="tc" style="width:40px;">
                                                <input type="checkbox" checked="@prLines.All(l => l.IsSelected)"
                                                       @onchange="ToggleAllPRLines" />
                                            </th>
                                            <th>الكود</th>
                                            <th>الصنف</th>
                                            <th>الوحدة</th>
                                            <th class="tc">المعتمد</th>
                                            <th class="tc">تم طلبه</th>
                                            <th class="tc">المتبقي</th>
                                            <th class="tl">السعر التقديري</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in prLines)
                                        {
                                            <tr class="@(!line.IsSelected ? "tr-deselected" : "")">
                                                <td class="tc">
                                                    <input type="checkbox" @bind="line.IsSelected" />
                                                </td>
                                                <td><code class="code-tag">@line.ItemCode</code></td>
                                                <td class="td-bold">@line.ItemNameAr</td>
                                                <td>@line.UnitName</td>
                                                <td class="tc">@((line.ApprovedQty ?? line.RequestedQty).ToString("#,##0.##"))</td>
                                                <td class="tc">@line.TotalOrderedQty.ToString("#,##0.##")</td>
                                                <td class="tc"><strong class="remaining-qty">@line.RemainingToOrder.ToString("#,##0.##")</strong></td>
                                                <td class="tl num-cell">@line.EstimatedPrice.ToString("#,##0.00")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- ═══════════ بيانات الأمر ═══════════ -->
            @if (header.POSource > 0 || !isNewMode)
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon blue">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                <polyline points="14 2 14 8 20 8"/>
                            </svg>
                        </div>
                        <h3 class="sec-title">بيانات أمر الشراء</h3>
                    </div>
                    <div class="form-grid c4">
                        <div class="f-field">
                            <label class="f-label">رقم الأمر</label>
                            <input type="text" class="f-input readonly" value="@(header.PONumber ?? "تلقائي")" disabled />
                        </div>
                        <div class="f-field">
                            <label class="f-label required">التاريخ</label>
                            <input type="date" class="f-input" @bind="header.PODate" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">التوريد المتوقع</label>
                            <input type="date" class="f-input" @bind="header.ExpectedDeliveryDate" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label required">المخزن</label>
                            <select class="f-input" @bind="header.WarehouseID" disabled="@isReadOnly">
                                <option value="0">-- اختر --</option>
                                @if (warehouses != null)
                                {
                                    @foreach (var w in warehouses)
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <!-- المورد -->
                    <div class="supplier-section">
                        <h4 class="sub-sec-title">بيانات المورد</h4>
                        <div class="form-grid c4">
                            <div class="f-field c2">
                                <label class="f-label required">المورد</label>
                                <SearchableSelect Items="@suppliersSearchable" @bind-SelectedId="header.SupplierID"
                                                  OnSelected="OnSupplierSelected" Placeholder="ابحث بالاسم أو الكود..."
                                                  IsDisabled="@isReadOnly" />
                            </div>
                            <div class="f-field">
                                <label class="f-label">شروط الدفع</label>
                                <select class="f-input" @bind="header.PaymentTermID" disabled="@isReadOnly">
                                    <option value="0">-- اختر --</option>
                                    @if (paymentTerms != null)
                                    {
                                        @foreach (var pt in paymentTerms)
                                        {
                                            <option value="@pt.Id">@pt.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="f-field">
                                <label class="f-label">العملة</label>
                                <select class="f-input" @bind="header.CurrencyID" @bind:after="OnCurrencyChanged" disabled="@isReadOnly">
                                    <option value="0">-- اختر --</option>
                                    @if (currencies != null)
                                    {
                                        @foreach (var c in currencies)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>

                        @if (supplierInfo != null)
                        {
                            <div class="supplier-info-bar">
                                <div class="si-item">
                                    <span class="si-label">الهاتف</span>
                                    <span class="si-value">@(supplierInfo.Phone1 ?? "—")</span>
                                </div>
                                <div class="si-item">
                                    <span class="si-label">المدينة</span>
                                    <span class="si-value">@(supplierInfo.City ?? "—")</span>
                                </div>
                                <div class="si-item">
                                    <span class="si-label">الرصيد الحالي</span>
                                    <span class="si-value @(supplierInfo.CurrentBalance > 0 ? "si-danger" : "")">
                                        @supplierInfo.CurrentBalance.ToString("#,##0.00")
                                    </span>
                                </div>
                                <div class="si-item">
                                    <span class="si-label">الحد الائتماني</span>
                                    <span class="si-value">@supplierInfo.CreditLimit.ToString("#,##0.00")</span>
                                </div>
                                <div class="si-item">
                                    <span class="si-label">المتاح</span>
                                    <span class="si-value @(supplierInfo.AvailableCredit < 0 ? "si-danger" : "si-ok")">
                                        @supplierInfo.AvailableCredit.ToString("#,##0.00")
                                    </span>
                                </div>
                                <div class="si-item">
                                    <span class="si-label">التقييم</span>
                                    <span class="si-value">@(new string('⭐', supplierInfo.Rating))</span>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- ملاحظات -->
                    <div class="form-grid c2" style="margin-top:14px;">
                        <div class="f-field">
                            <label class="f-label">ملاحظات</label>
                            <input type="text" class="f-input" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات عامة..." />
                        </div>
                        <div class="f-field">
                            <label class="f-label">ملاحظات داخلية</label>
                            <input type="text" class="f-input" @bind="header.InternalNotes" disabled="@isReadOnly" placeholder="ملاحظات داخلية (لا تطبع)..." />
                        </div>
                    </div>

                    @if (header.POStatus == 4 && !string.IsNullOrEmpty(header.RejectionReason))
                    {
                        <div class="rejection-box">❌ <strong>سبب الرفض:</strong> @header.RejectionReason</div>
                    }
                </div>
            }

            <!-- ═══════════ الأصناف ═══════════ -->
            @if ((header.POSource > 0 || !isNewMode) && (OrderId > 0 || isSourceLocked))
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon green">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                            </svg>
                        </div>
                        <h3 class="sec-title">أصناف أمر الشراء</h3>
                        <span class="sec-badge">@details.Count صنف</span>
                        @if (!isReadOnly && !isApprovalMode && permissions.CanAdd)
                        {
                            <button class="btn-m btn-primary btn-sm" @onclick="ShowAddLine" style="margin-right:auto;">
                                + إضافة صنف
                            </button>
                        }
                    </div>

                    @if (!details.Any() && !showLineForm)
                    {
                        <div class="empty-lines"><p>لا توجد أصناف. اضغط "إضافة صنف" للبدء.</p></div>
                    }
                    else
                    {
                        <div class="tbl-card">
                            <table class="tbl">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>الكود</th>
                                        <th>الصنف</th>
                                        <th>الوحدة</th>
                                        <th class="tc">الكمية</th>
                                        <th class="tl">السعر</th>
                                        <th class="tc">خصم %</th>
                                        <th class="tc">ضريبة %</th>
                                        <th class="tl">الإجمالي</th>
                                        @if (!isNewMode)
                                        {
                                            <th class="tc">مستلم</th>
                                            <th class="tc">متبقي</th>
                                        }
                                        @if (!isReadOnly && !isApprovalMode)
                                        {
                                            <th class="tc">إجراءات</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int n = 0; }
                                    @foreach (var line in details)
                                    {
                                        n++;
                                        <tr>
                                            <td class="td-n">@n</td>
                                            <td><code class="code-tag">@line.ItemCode</code></td>
                                            <td class="td-bold">@line.ItemNameAr</td>
                                            <td>@line.UnitName</td>
                                            <td class="tc">@line.OrderedQty.ToString("#,##0.##")</td>
                                            <td class="tl num-cell">@line.UnitPrice.ToString("#,##0.00")</td>
                                            <td class="tc">@line.DiscountPercent.ToString("#,##0.##")</td>
                                            <td class="tc">@line.TaxRate.ToString("#,##0.##")</td>
                                            <td class="tl num-cell"><strong>@line.LineTotalWithTax.ToString("#,##0.00")</strong></td>
                                            @if (!isNewMode)
                                            {
                                                <td class="tc">@line.ReceivedQty.ToString("#,##0.##")</td>
                                                <td class="tc"><strong class="@(line.RemainingQty > 0 ? "remaining-qty" : "")">@line.RemainingQty.ToString("#,##0.##")</strong></td>
                                            }
                                            @if (!isReadOnly && !isApprovalMode)
                                            {
                                                <td class="tc">
                                                    <div class="line-actions">
                                                        @if (permissions.CanEdit)
                                                        {
                                                            <button class="act-btn edit" @onclick="() => ShowEditLine(line)">
                                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                                                </svg>
                                                            </button>
                                                        }
                                                        @if (permissions.CanDelete)
                                                        {
                                                            <button class="act-btn del" @onclick="() => DeleteLine(line.PODetailID)">
                                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                                    <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                                                </svg>
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="total-row">
                                        <td colspan="8" class="tl"><strong>الإجمالي</strong></td>
                                        <td class="tl num-cell">
                                            <strong>@details.Sum(d => d.LineTotalWithTax).ToString("#,##0.00")</strong>
                                        </td>
                                        @if (!isNewMode) { <td colspan="2"></td> }
                                        @if (!isReadOnly && !isApprovalMode) { <td></td> }
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }

                    <!-- Line Form -->
                    @if (showLineForm)
                    {
                        <div class="line-form">
                            <div class="line-form-head">
                                <h4>@(isEditLine ? "تعديل صنف" : "إضافة صنف")</h4>
                                <button class="btn-close-x" @onclick="CloseLineForm">✕</button>
                            </div>
                            <div class="form-grid c3">
                                <div class="f-field">
                                    <label class="f-label required">الصنف</label>
                                    <SearchableSelect Items="@purchaseItems" @bind-SelectedId="editLine.ItemID"
                                                      OnSelected="OnItemSelected" Placeholder="ابحث بالاسم أو الكود..."
                                                      IsDisabled="@isEditLine" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label required">الوحدة</label>
                                    <select class="f-input" @bind="editLine.UnitID">
                                        <option value="0">-- اختر --</option>
                                        @if (units != null)
                                        {
                                            @foreach (var u in units)
                                            {
                                                <option value="@u.Id">@u.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="f-field">
                                    <label class="f-label required">الكمية</label>
                                    <input type="number" class="f-input" @bind="editLine.OrderedQty" step="0.01" />
                                    @if (editLine.PRRemainingToOrder.HasValue)
                                    {
                                        <span class="f-hint">المتبقي من PR: @editLine.PRRemainingToOrder.Value.ToString("#,##0.##")</span>
                                    }
                                </div>
                                <div class="f-field">
                                    <label class="f-label required">سعر الوحدة</label>
                                    <input type="number" class="f-input" @bind="editLine.UnitPrice" step="0.01" />
                                    @if (priceSource != null)
                                    {
                                        <span class="f-hint">@priceSource</span>
                                    }
                                </div>
                                <div class="f-field">
                                    <label class="f-label">خصم %</label>
                                    <input type="number" class="f-input" @bind="editLine.DiscountPercent" step="0.01" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">ضريبة %</label>
                                    <input type="number" class="f-input" @bind="editLine.TaxRate" step="0.01" />
                                </div>
                            </div>
                            <div class="line-calc-bar">
                                <span>الإجمالي قبل الضريبة: <strong>@editLine.LineTotal.ToString("#,##0.00")</strong></span>
                                <span>الضريبة: <strong>@editLine.TaxAmount.ToString("#,##0.00")</strong></span>
                                <span>الإجمالي: <strong>@editLine.LineTotalWithTax.ToString("#,##0.00")</strong></span>
                            </div>
                            @if (!string.IsNullOrEmpty(lineMsg))
                            {
                                <div class="form-msg @(lineMsgOk ? "msg-ok" : "msg-err")">@lineMsg</div>
                            }
                            <div class="line-form-btns">
                                <button class="btn-m btn-primary" @onclick="SaveLine" disabled="@isSavingLine">
                                    @if (isSavingLine) { <div class="btn-spin"></div> }
                                    @(isEditLine ? "تحديث" : "إضافة")
                                </button>
                                <button class="btn-m btn-ghost" @onclick="CloseLineForm">إلغاء</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- ═══════════ التكاليف الإضافية ═══════════ -->
            @if (!isReadOnly && !isApprovalMode && OrderId > 0 && details.Any())
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon orange">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                            </svg>
                        </div>
                        <h3 class="sec-title">التكاليف الإضافية والإجماليات</h3>
                    </div>
                    <div class="form-grid c4">
                        <div class="f-field">
                            <label class="f-label">خصم عام %</label>
                            <input type="number" class="f-input" @bind="header.DiscountPercent" step="0.01" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">تكلفة الشحن</label>
                            <input type="number" class="f-input" @bind="header.ShippingCost" step="0.01" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">تكاليف أخرى</label>
                            <input type="number" class="f-input" @bind="header.OtherCosts" step="0.01" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">سعر الصرف</label>
                            <input type="number" class="f-input" @bind="header.ExchangeRate" step="0.000001" />
                        </div>
                    </div>
                </div>
            }

            <!-- ═══════════ ملخص الإجماليات (عرض) ═══════════ -->
            @if (OrderId > 0 && details.Any())
            {
                <div class="totals-bar">
                    <div class="total-item">
                        <span class="total-label">الإجمالي الفرعي</span>
                        <span class="total-value">@header.SubTotal.ToString("#,##0.00")</span>
                    </div>
                    @if (header.DiscountAmount > 0)
                    {
                        <div class="total-item">
                            <span class="total-label">الخصم</span>
                            <span class="total-value t-discount">- @header.DiscountAmount.ToString("#,##0.00")</span>
                        </div>
                    }
                    <div class="total-item">
                        <span class="total-label">الضريبة</span>
                        <span class="total-value">@header.TaxAmount.ToString("#,##0.00")</span>
                    </div>
                    @if (header.ShippingCost > 0)
                    {
                        <div class="total-item">
                            <span class="total-label">الشحن</span>
                            <span class="total-value">@header.ShippingCost.ToString("#,##0.00")</span>
                        </div>
                    }
                    @if (header.OtherCosts > 0)
                    {
                        <div class="total-item">
                            <span class="total-label">تكاليف أخرى</span>
                            <span class="total-value">@header.OtherCosts.ToString("#,##0.00")</span>
                        </div>
                    }
                    <div class="total-item total-grand">
                        <span class="total-label">الإجمالي الكلي</span>
                        <span class="total-value">@header.TotalAmount.ToString("#,##0.00") @(header.CurrencySymbol ?? "ج.م")</span>
                    </div>
                </div>
            }

            <!-- ═══════════ أزرار الحفظ ═══════════ -->
            @if (!isViewMode && !isApprovalMode)
            {
                <div class="doc-actions">
                    <div class="doc-actions-right">
                        @if (!isReadOnly)
                        {
                            <button class="btn-m btn-primary" @onclick="SaveOrder" disabled="@isSaving">
                                @if (isSaving) { <div class="btn-spin"></div> }
                                @(isNewMode ? "حفظ أمر الشراء" : "حفظ التعديلات")
                            </button>

                            @if (OrderId > 0 && header.POStatus == 1 && details.Any())
                            {
                                <button class="btn-m btn-warning" @onclick="SubmitForApproval" disabled="@isSaving">
                                    📤 إرسال للاعتماد
                                </button>
                            }
                        }
                    </div>
                    <button class="btn-m btn-ghost" @onclick="GoBack">رجوع</button>
                </div>
            }
        }
    </div>

    <!-- ═══════════ Reject Dialog ═══════════ -->
    @if (showRejectDialog)
    {
        <div class="modal-ov" @onclick="() => showRejectDialog = false">
            <div class="modal-box" @onclick:stopPropagation="true">
                <h4>رفض أمر الشراء</h4>
                <p>أدخل سبب الرفض:</p>
                <textarea class="f-input" rows="3" @bind="rejectReason" placeholder="سبب الرفض..."></textarea>
                @if (!string.IsNullOrEmpty(rejectMsg))
                {
                    <div class="form-msg msg-err">@rejectMsg</div>
                }
                <div class="modal-btns-row">
                    <button class="btn-m btn-danger-solid" @onclick="ConfirmReject">تأكيد الرفض</button>
                    <button class="btn-m btn-ghost" @onclick="() => showRejectDialog = false">إلغاء</button>
                </div>
            </div>
        </div>
    }

    <!-- Toast -->
    @if (!string.IsNullOrEmpty(toast))
    {
        <div class="toast-wrap">
            <div class="toast @(toastOk ? "t-ok" : "t-err")">
                <span>@toast</span>
                <button @onclick='() => toast = ""'>✕</button>
            </div>
        </div>
    }
}
