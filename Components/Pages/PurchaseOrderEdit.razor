@page "/purchase-orders/new"
@page "/purchase-orders/edit/{OrderId:int}"
@page "/purchase-orders/view/{OrderId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PurchaseOrderService PoService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<PurchaseOrderEdit> Logger

<PageTitle>@pageTitle - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>}
else if (isPermissionLoading && permissions == null)
{<div class="loading-luxury" dir="rtl"><div class="loader-luxury"></div><p>جارٍ التحقق من صلاحيات أوامر الشراء...</p></div>}
else if (permissionLoadDenied)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>تعذر التحقق من صلاحية الوصول إلى أوامر الشراء</h4></div>}
else if (permissionLoadFailed)
{<div class="loading-luxury" dir="rtl"><div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:12px"><span>تعذر التحقق من صلاحيات أوامر الشراء. يرجى إعادة المحاولة.</span><button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadPermissionsAsync" disabled="@isPermissionLoading">إعادة المحاولة</button></div></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div>}
else
{
    <div class="luxury-edit-page" dir="rtl">

        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <button class="btn-luxury btn-ghost-dark" @onclick="GoBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>رجوع</button>
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text">
                        <h2 class="lh-title">@pageTitle</h2>
                        <p class="lh-subtitle">@(string.IsNullOrEmpty(header.PONumber)?"إنشاء أمر شراء جديد - اختر المصدر ثم المورد":$"{header.PONumber} - {header.SupplierNameAr ?? "—"}")</p>
                    </div>
                </div>
                <div class="lh-actions">
                    @if (!string.IsNullOrEmpty(header.PONumber))
                    {
                        <span class="status-badge-luxury" style="--sc:@PurchaseOrderService.GetStatusColor(header.POStatus)">@PurchaseOrderService.GetStatusName(header.POStatus)</span>
                        @if (header.POSource > 0){<span class="source-badge-luxury" style="--sc:@PurchaseOrderService.GetSourceColor(header.POSource)">@PurchaseOrderService.GetSourceName(header.POSource)</span>}
                    }
                    <span class="lh-badge"><span class="lh-dot"></span>@(isNewMode?"جديد":isViewMode?"عرض":isApprovalMode?"اعتماد":canMarkAsSent?"إرسال":"تعديل")</span>
                    @if (permissions.CanPrint && OrderId > 0){<button class="btn-luxury btn-ghost-dark" @onclick="PrintDoc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>طباعة</button>}
                </div>
            </div>
        </div>

        @if (isApprovalMode)
        {
            <div class="approval-bar-luxury approve"><div class="ab-gold-line"></div><div class="ab-content"><div class="ab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div><strong>بانتظار اعتمادك</strong><span>راجع البيانات والأصناف ثم اعتمد أو ارفض</span></div></div><div class="ab-actions"><button class="btn-luxury btn-success-luxury" @onclick="ExecuteApprove" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg>}اعتماد</button><button class="btn-luxury btn-danger-luxury" @onclick="DoShowReject" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg>رفض</button></div></div>
        }
        @if (canMarkAsSent)
        {
            <div class="approval-bar-luxury sent"><div class="ab-gold-line blue"></div><div class="ab-content"><div class="ab-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="22" y1="2" x2="11" y2="13"/><path d="M22 2L11 13"/><path d="M22 2L15 22L11 13L2 9L22 2Z"/></svg></div><div><strong>أمر الشراء معتمد - جاهز للإرسال</strong><span>اختر طريقة الإرسال وأكد إرساله للمورد</span></div></div><div class="ab-actions"><div class="select-wrap-luxury sm"><select @bind="sentMethod"><option value="">طريقة الإرسال...</option><option value="email">بريد إلكتروني</option><option value="fax">فاكس</option><option value="hand">تسليم يدوي</option><option value="whatsapp">واتساب</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div><button class="btn-luxury btn-primary-luxury" @onclick="ExecuteMarkAsSent" disabled="@isSaving"><i class=bi-book></i> تأكيد الإرسال</button></div></div>
        }

        @if (isLoading)
        {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else if (OrderId > 0 && orderRecordLoadDenied && !orderRecordLoaded)
        {<div class="no-access-luxury"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>@orderRecordLoadError</h4><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">العودة للقائمة</button></div>}
        else if (OrderId > 0 && orderRecordNotFound)
        {<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m9 9 6 6"/><path d="m15 9-6 6"/></svg></div><h4>أمر الشراء غير موجود</h4><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">العودة للقائمة</button></div>}
        else if (OrderId > 0 && orderRecordLoadFailed && !orderRecordLoaded)
        {<div class="loading-luxury"><div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:12px"><span>@orderRecordLoadError</span><button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadOrderRecordAsync" disabled="@isLoading">إعادة المحاولة</button></div></div>}
        else
        {
            @if (OrderId > 0 && orderRecordLoadFailed && orderRecordLoaded)
            {
                <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px"><span>@orderRecordLoadError</span><button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadOrderRecordAsync" disabled="@isLoading">إعادة المحاولة</button></div>
            }
            @if (OrderId > 0 && isOrderDetailsLoading && orderDetailsLoaded)
            {
                <div class="field-hint" role="status" style="margin-bottom:12px">جارٍ تحديث أصناف أمر الشراء؛ آخر قائمة ناجحة معروضة.</div>
            }
            else if (OrderId > 0 && orderDetailsLoadFailed && orderDetailsLoaded)
            {
                <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px"><span>@orderDetailsLoadError</span><button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadOrderDetailsAsync" disabled="@isOrderDetailsLoading">إعادة المحاولة</button></div>
            }
            @if (OrderId > 0 && isOrderDetailsLoading && !orderDetailsLoaded)
            {
                <div class="field-hint" role="status" style="margin-bottom:12px">جارٍ تحميل أصناف أمر الشراء...</div>
            }
            else if (OrderId > 0 && orderDetailsLoadFailed && !orderDetailsLoaded)
            {
                <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:12px"><span>@orderDetailsLoadError</span><button class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadOrderDetailsAsync" disabled="@isOrderDetailsLoading">إعادة المحاولة</button></div>
            }
            else if (OrderId > 0 && orderDetailsLoadDenied && !orderDetailsLoaded)
            {
                <div class="msg-luxury msg-info" role="status" style="margin-bottom:12px">@orderDetailsLoadError</div>
            }
            @if (isNewMode && !isSourceLocked)
            {
                <div class="source-cards-luxury">
                    <div class="source-card-luxury @(header.POSource==1?"active":"")" @onclick="SelectManualSource"><div class="ml-gold-line"></div><div class="sc-icon" style="background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.15)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><div class="sc-title">أمر شراء يدوي</div><div class="sc-desc">إنشاء أمر شراء جديد بدون طلب مسبق</div></div>
                    <div class="source-card-luxury @(header.POSource==2?"active":"")" @onclick="SelectPRSource"><div class="ml-gold-line" style="background:linear-gradient(90deg,transparent,#0891b2,transparent)"></div><div class="sc-icon" style="background:#ecfeff;color:#0891b2;border:1px solid #a5f3fc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></div><div class="sc-title">من طلب شراء معتمد</div><div class="sc-desc">اختيار طلب شراء وتحميل الأصناف منه</div></div>
                </div>
            }

            <div class="mudtabs-luxury">
                <div class="mudtabs-header">
                    <button class="mudtab-btn @(activeTab==0?"active":"")" @onclick="() => activeTab=0"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>البيانات الأساسية @if(header.POSource==0 && isNewMode){<span class="mt-required"></span>}</button>
                    <button class="mudtab-btn @(activeTab==1?"active":"")" @onclick="() => activeTab=1"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>المورد والمالية</button>
                    <button class="mudtab-btn @(activeTab==2?"active":"")" @onclick="() => activeTab=2"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></span>الأصناف <span class="mt-count gold">@OrderDetailsCountText</span></button>
                    <button class="mudtab-btn @(activeTab==3?"active":"")" @onclick="() => activeTab=3"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>التكاليف والإجماليات</button>
                    <button class="mudtab-btn @(activeTab==4?"active":"")" @onclick="() => activeTab=4"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></span>الاعتماد والسجل</button>
                    <button class="mudtab-btn @(activeTab==5?"active":"")" @onclick="() => activeTab=5"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></span>ملاحظات</button>
                    <div class="mudtab-indicator" style="--tab:@activeTab;--total:6"></div>
                </div>

                <div class="mudtabs-body">
                    @if (activeTab == 0)
                    {
                        <div class="tab-panel luxury-fade">
                            @if (header.POSource == 2 && isNewMode && !isPRLoaded)
                            {
                                <div class="tab-header"><div class="tab-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><div><h3>اختيار طلب الشراء المعتمد</h3><p>ابحث واختر طلب الشراء لتحميل الأصناف</p></div></div>
                                <div class="form-grid cols-2">
                                    <div class="form-field">
                                        <label class="field-label required">طلب الشراء المعتمد</label>
                                        <SearchableSelect Items="@approvedPRs" @bind-SelectedId="selectedPRId" OnSelected="OnPRSelected" Placeholder="ابحث برقم طلب الشراء..." IsDisabled="@(!approvedPRsLoaded || approvedPRs == null || !approvedPRs.Any())" />
                                        @if (isApprovedPRsLoading && approvedPRsLoaded)
                                        {
                                            <div class="field-hint" role="status">جارٍ تحديث طلبات الشراء؛ الخيارات السابقة متاحة.</div>
                                        }
                                        else if (isApprovedPRsLoading)
                                        {
                                            <div class="field-hint" role="status">جارٍ تحميل طلبات الشراء المعتمدة...</div>
                                        }
                                        else if (approvedPRsLoadFailed)
                                        {
                                            <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px"><span>@approvedPRsLoadError</span><button type="button" class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadApprovedPRsAsync" disabled="@isApprovedPRsLoading">إعادة المحاولة</button></div>
                                        }
                                        else if (approvedPRsLoadDenied)
                                        {
                                            <div class="msg-luxury msg-info" role="status" style="margin-top:6px">@approvedPRsLoadError</div>
                                        }
                                        else if (approvedPRsLoaded && (approvedPRs == null || !approvedPRs.Any()))
                                        {
                                            <div class="field-hint" role="status">لا توجد طلبات شراء معتمدة متاحة.</div>
                                        }
                                        @if (isPRLinesLoading && prLinesLoaded)
                                        {
                                            <div class="field-hint" role="status">جارٍ تحديث سطور طلب الشراء؛ آخر سطور ناجحة ما زالت معروضة.</div>
                                        }
                                        else if (isPRLinesLoading)
                                        {
                                            <div class="field-hint" role="status">جارٍ تحميل سطور طلب الشراء...</div>
                                        }
                                        else if (prLinesLoadFailed)
                                        {
                                            <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px"><span>@prLinesLoadError</span><button type="button" class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadPRLinesAsync" disabled="@isPRLinesLoading">إعادة المحاولة</button></div>
                                        }
                                        else if (prLinesLoadDenied)
                                        {
                                            <div class="msg-luxury msg-info" role="status" style="margin-top:6px">@prLinesLoadError</div>
                                        }
                                        else if (prLinesLoaded && (prLines == null || !prLines.Any()))
                                        {
                                            <div class="field-hint" role="status">لا توجد سطور متبقية للطلب المحدد.</div>
                                        }
                                    </div>
                                    @if (prLines != null && prLines.Any()){<div class="form-field"><label class="field-label">المختار</label><div class="field-input disabled"><span>@prLines.Count(l=>l.IsSelected) من @prLines.Count صنف</span></div></div>}
                                </div>
                                @if (prLines != null && prLines.Any())
                                {
                                    <div class="table-card-luxury" style="margin-top:12px"><div class="table-responsive"><table class="table-luxury"><thead><tr><th class="th-center" style="width:40px"><input type="checkbox" checked="@prLines.All(l=>l.IsSelected)" @onchange="ToggleAllPRLines" /></th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="th-center">المعتمد</th><th class="th-center">تم طلبه</th><th class="th-center">المتبقي</th><th>السعر التقديري</th></tr></thead><tbody>@foreach(var line in prLines){<tr class="@(!line.IsSelected?"row-dim":"")"><td class="td-center"><input type="checkbox" @bind="line.IsSelected" /></td><td><span class="code-luxury">@line.ItemCode</span></td><td class="td-name">@line.ItemNameAr</td><td class="td-muted">@line.UnitName</td><td class="td-center">@((line.ApprovedQty ?? line.RequestedQty).ToString("#,##0.##"))</td><td class="td-center">@line.TotalOrderedQty.ToString("#,##0.##")</td><td class="td-center"><strong style="color:var(--gold-dark)">@line.RemainingToOrder.ToString("#,##0.##")</strong></td><td class="num-cell">@line.EstimatedPrice.ToString("#,##0.00")</td></tr>}</tbody></table></div></div>
                                }
                            }

                            @if (header.POSource > 0 || !isNewMode)
                            {
                                <div class="tab-header" style="margin-top:@(header.POSource==2 && isNewMode && !isPRLoaded ? "24px":"0")"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><div><h3>بيانات أمر الشراء</h3><p>التواريخ والمخزن والمصدر</p></div></div>
                                <div class="form-grid cols-4">
                                    <div class="form-field"><label class="field-label">رقم الأمر</label><div class="field-input disabled"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><span>@(header.PONumber ?? "تلقائي")</span></div></div>
                                    <div class="form-field"><label class="field-label required">التاريخ</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><input type="date" class="field-input" @bind="header.PODate" disabled="@isReadOnly" /></div></div>
                                    <div class="form-field"><label class="field-label">التوريد المتوقع</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><input type="date" class="field-input" @bind="header.ExpectedDeliveryDate" disabled="@isReadOnly" /></div></div>
                                    <div class="form-field">
                                        <label class="field-label required">المخزن</label>
                                        <div class="select-wrap">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                                            <select class="field-select" @bind="header.WarehouseID" disabled="@(isReadOnly || !receivingWarehousesLoaded || warehouses == null || !warehouses.Any())">
                                                <option value="0">-- اختر --</option>
                                                @if(warehouses!=null){@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}}
                                            </select>
                                            <svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                                        </div>
                                        @if (isReceivingWarehousesLoading && receivingWarehousesLoaded)
                                        {
                                            <div class="field-hint" role="status">جارٍ تحديث مخازن الاستلام؛ الخيارات السابقة متاحة.</div>
                                        }
                                        else if (isReceivingWarehousesLoading)
                                        {
                                            <div class="field-hint" role="status">جارٍ تحميل مخازن الاستلام...</div>
                                        }
                                        else if (receivingWarehousesLoadFailed)
                                        {
                                            <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px"><span>@receivingWarehousesLoadError</span><button type="button" class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadReceivingWarehousesAsync" disabled="@isReceivingWarehousesLoading">إعادة المحاولة</button></div>
                                        }
