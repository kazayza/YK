            showRejectDialog = false;
            await ShowToastAsync("تم رفض أمر الشراء", false);
            await Task.Delay(1500);
            Navigation.NavigateTo("/purchase-orders");
        }
        catch (Exception ex)
        {
            rejectMsg = "خطأ: " + ex.Message;
        }
    }

