    private async Task OnSupplierSelected(SearchableItem? item)
    {
        supplierItemPriceLoadVersion++;
        isSupplierItemPriceLoading = false;
        supplierItemPriceLoadFailed = false;
        supplierItemPriceLoadDenied = false;
        supplierItemPriceLoadError = string.Empty;
        if (item == null || item.Id == 0)
        {
            supplierQuickInfoLoadVersion++;
            isSupplierQuickInfoLoading = false;
            supplierQuickInfoLoadFailed = false;
            supplierQuickInfoLoadDenied = false;
            supplierQuickInfoApplyDefaults = false;
            supplierQuickInfoLoadError = string.Empty;
            supplierInfo = null;
            header.SupplierID = 0;
            StateHasChanged();
            return;
        }

        header.SupplierID = item.Id;
        supplierInfo = null;
        await LoadSupplierQuickInfoAsync(item.Id, applyDefaults: true);
    }
    private async Task OnCurrencyChanged()
    {
        var requestVersion = ++exchangeRateLoadVersion;
        var currencyId = header.CurrencyID ?? 0;
        exchangeRateLoadFailed = false;
        exchangeRateLoadDenied = false;
        exchangeRateLoadError = string.Empty;

        if (currencyId <= 0)
        {
            isExchangeRateLoading = false;
            StateHasChanged();
            return;
        }

        isExchangeRateLoading = true;
        StateHasChanged();
        try
        {
            var loadedExchangeRate = await LookupService.GetExchangeRateAsync(currencyId);
            if (requestVersion != exchangeRateLoadVersion || header.CurrencyID != currencyId) return;

            header.ExchangeRate = loadedExchangeRate;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading exchange rate for purchase order currency {CurrencyID}.", currencyId);
            if (requestVersion != exchangeRateLoadVersion || header.CurrencyID != currencyId) return;

            exchangeRateLoadDenied = true;
            exchangeRateLoadError = "ليس لديك صلاحية قراءة سعر الصرف؛ القيمة الحالية لم تتغير.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load exchange rate for purchase order currency {CurrencyID}.", currencyId);
            if (requestVersion != exchangeRateLoadVersion || header.CurrencyID != currencyId) return;

            exchangeRateLoadFailed = true;
            exchangeRateLoadError = "تعذر تحديث سعر الصرف للعملة المختارة؛ القيمة الحالية لم تتغير. أعد المحاولة وتحقق من السعر قبل الحفظ.";
        }
        finally
        {
            if (requestVersion == exchangeRateLoadVersion)
            {
                isExchangeRateLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task RetryLoadExchangeRateAsync()
    {
        if (isExchangeRateLoading || !header.CurrencyID.HasValue || header.CurrencyID.Value <= 0) return;
        await OnCurrencyChanged();
    }
    private async Task OnItemSelected(SearchableItem? item)
    {
        if (item == null)
        {
            purchaseItemQuickInfoLoadVersion++;
            supplierItemPriceLoadVersion++;
            isSupplierItemPriceLoading = false;
            supplierItemPriceLoadFailed = false;
            supplierItemPriceLoadDenied = false;
            supplierItemPriceLoadError = string.Empty;
            isPurchaseItemQuickInfoLoading = false;
            purchaseItemQuickInfoLoadFailed = false;
            purchaseItemQuickInfoLoadDenied = false;
            purchaseItemQuickInfoLoadError = string.Empty;
            selectedPurchaseItem = null;
            return;
        }

        supplierItemPriceLoadVersion++;
        isSupplierItemPriceLoading = false;
        supplierItemPriceLoadFailed = false;
        supplierItemPriceLoadDenied = false;
        supplierItemPriceLoadError = string.Empty;
        selectedPurchaseItem = item;
        editLine.ItemID = item.Id;
        editLine.ItemCode = item.Code;
        editLine.ItemNameAr = item.Name;
        priceSource = null;

        if (!await LoadPurchaseItemQuickInfoAsync(item.Id)) return;

        if (header.SupplierID > 0)
            await LoadSupplierItemPriceAsync(header.SupplierID, item.Id);

        StateHasChanged();
    }

    private async Task<bool> LoadPurchaseItemQuickInfoAsync(int itemId)
    {
        if (itemId <= 0) return false;

        var requestVersion = ++purchaseItemQuickInfoLoadVersion;
        isPurchaseItemQuickInfoLoading = true;
        purchaseItemQuickInfoLoadFailed = false;
        purchaseItemQuickInfoLoadDenied = false;
        purchaseItemQuickInfoLoadError = string.Empty;
        StateHasChanged();
        try
        {
            var info = await LookupService.GetItemQuickInfoAsync(itemId);
            if (requestVersion != purchaseItemQuickInfoLoadVersion || !showLineForm || editLine.ItemID != itemId) return false;

            if (info != null)
            {
                if (info.UnitID > 0)
                    editLine.UnitID = info.UnitID;
                if (header.SupplierID <= 0 && info.EstimatedPrice > 0)
                {
                    editLine.UnitPrice = info.EstimatedPrice;
                    priceSource = "سعر تقديري";
                }
            }
            return true;
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading quick information for item {ItemID} in purchase orders.", itemId);
            if (requestVersion != purchaseItemQuickInfoLoadVersion || !showLineForm || editLine.ItemID != itemId) return false;

            purchaseItemQuickInfoLoadDenied = true;
            purchaseItemQuickInfoLoadError = "ليس لديك صلاحية قراءة المعلومات الإضافية للصنف.";
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load quick information for item {ItemID} in purchase orders.", itemId);
            if (requestVersion != purchaseItemQuickInfoLoadVersion || !showLineForm || editLine.ItemID != itemId) return false;

            purchaseItemQuickInfoLoadFailed = true;
            purchaseItemQuickInfoLoadError = "تعذر تحميل المعلومات الإضافية للصنف؛ لم يُحدّث السعر أو الوحدة تلقائيًا. أعد المحاولة أو تحقّق منهما يدويًا.";
            return false;
        }
        finally
        {
            if (requestVersion == purchaseItemQuickInfoLoadVersion)
            {
                isPurchaseItemQuickInfoLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task RetryLoadPurchaseItemQuickInfoAsync()
    {
        if (isPurchaseItemQuickInfoLoading || selectedPurchaseItem == null || editLine.ItemID != selectedPurchaseItem.Id) return;
        await OnItemSelected(selectedPurchaseItem);
    }

    private async Task LoadSupplierItemPriceAsync(int supplierId, int itemId)
    {
        if (supplierId <= 0 || itemId <= 0) return;

        var requestVersion = ++supplierItemPriceLoadVersion;
        isSupplierItemPriceLoading = true;
        supplierItemPriceLoadFailed = false;
        supplierItemPriceLoadDenied = false;
        supplierItemPriceLoadError = string.Empty;
        StateHasChanged();
        try
        {
            var loadedPrice = await LookupService.GetSupplierItemPriceAsync(supplierId, itemId);
            if (requestVersion != supplierItemPriceLoadVersion || header.SupplierID != supplierId || editLine.ItemID != itemId || !showLineForm) return;

            if (loadedPrice != null)
            {
                editLine.UnitPrice = loadedPrice.SuggestedPrice;
                priceSource = loadedPrice.PriceSource switch
                {
                    "SupplierPrice" => "سعر المورد",
                    "LastPurchase" => "آخر شراء",
                    "AverageCost" => "متوسط التكلفة",
                    "StandardCost" => "التكلفة المعيارية",
                    _ => null
                };
            }
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied loading supplier item price for supplier {SupplierID} and item {ItemID}.", supplierId, itemId);
            if (requestVersion != supplierItemPriceLoadVersion || header.SupplierID != supplierId || editLine.ItemID != itemId || !showLineForm) return;

            supplierItemPriceLoadDenied = true;
            supplierItemPriceLoadError = "ليس لديك صلاحية قراءة سعر الصنف من المورد؛ السعر الحالي لم يتغير.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load supplier item price for supplier {SupplierID} and item {ItemID}.", supplierId, itemId);
            if (requestVersion != supplierItemPriceLoadVersion || header.SupplierID != supplierId || editLine.ItemID != itemId || !showLineForm) return;

            supplierItemPriceLoadFailed = true;
            supplierItemPriceLoadError = "تعذر تحميل السعر المقترح من المورد؛ السعر الحالي لم يتغير. أدخله يدويًا أو أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == supplierItemPriceLoadVersion)
            {
                isSupplierItemPriceLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task RetryLoadSupplierItemPriceAsync()
    {
        if (isSupplierItemPriceLoading || header.SupplierID <= 0 || editLine.ItemID <= 0) return;
        await LoadSupplierItemPriceAsync(header.SupplierID, editLine.ItemID);
    }
    private async Task SaveOrder()
    {
        if(isNewMode && header.POSource == 2 && selectedPRId > 0 && !prLinesLoaded)
        {
            await ShowToastAsync(prLinesLoadDenied
                ? "لا يمكن حفظ الأمر من طلب الشراء دون صلاحية قراءة سطوره."
                : "يجب تحميل سطور طلب الشراء بنجاح قبل حفظ الأمر.", false);
            activeTab = 0;
            return;
        }
        if(header.PODate==default){await ShowToastAsync("حدد تاريخ أمر الشراء",false);activeTab=0;return;}
        if(header.SupplierID<=0){await ShowToastAsync("اختر المورد",false);activeTab=1;return;}
        isSaving=true;StateHasChanged();
        try{
            if(isNewMode){
                header.PONumber=await PoService.GeneratePONumberAsync();header.POStatus=1;
                var newId=await PoService.InsertOrderAsync(header, UserSession.UserID);
                OrderId=newId;header.PurchaseOrderID=newId;
                if(header.POSource==2&&prLines!=null){
                    var selectedIds=prLines.Where(l=>l.IsSelected).Select(l=>l.RequestDetailID).ToList();
                    if(selectedIds.Any()){var imported=await PoService.ImportLinesFromPRAsync(newId,header.RequestID??0,selectedIds,header.SupplierID,UserSession.UserID);await ShowToastAsync($"تم إنشاء الأمر وتحميل {imported} صنف ");}
                    else{await ShowToastAsync($"تم إنشاء أمر الشراء: {header.PONumber} ");}
                }else{await ShowToastAsync($"تم إنشاء أمر الشراء: {header.PONumber} ");}
                isSourceLocked=true;isPRLoaded=true;
                orderRecordLoaded=false;
                orderDetailsLoaded=false;
                await LoadOrderDetailsAsync();
                await LoadOrderRecordAsync();
                Navigation.NavigateTo($"/purchase-orders/edit/{newId}", forceLoad:false);
            }else{
                await PoService.UpdateOrderAsync(header, UserSession.UserID);
                await LoadOrderRecordAsync();
                await LoadOrderDetailsAsync();
                await ShowToastAsync("تم حفظ التعديلات ");
            }
        }catch(Exception ex){await ShowToastAsync("خطأ: "+ex.Message,false);}
        finally{isSaving=false;}
    }
    private async Task SubmitForApproval(){if(!orderDetailsLoaded){await ShowToastAsync("يجب تحميل أصناف الأمر بنجاح قبل إرساله للاعتماد.",false);activeTab=2;return;}if(!details.Any()){await ShowToastAsync("أضف أصناف أولاً",false);activeTab=2;return;}isSaving=true;StateHasChanged();try{await PoService.SubmitForApprovalAsync(OrderId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);header.POStatus=2;await ShowToastAsync("تم الإرسال للاعتماد ");}catch(Exception ex){await ShowToastAsync("خطأ: "+ex.Message,false);}finally{isSaving=false;}}
    private async Task ExecuteApprove(){var confirmed=await JS.InvokeAsync<bool>("confirm","هل تريد اعتماد أمر الشراء؟");if(!confirmed)return;isSaving=true;StateHasChanged();try{await PoService.ApproveAsync(OrderId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);header.POStatus=3;await ShowToastAsync("تم الاعتماد ");await Task.Delay(1500);Navigation.NavigateTo("/purchase-orders");}catch(Exception ex){await ShowToastAsync("خطأ: "+ex.Message,false);}finally{isSaving=false;}}
    private void DoShowReject(){rejectReason="";rejectMsg="";showRejectDialog=true;}
    private async Task ConfirmReject(){if(string.IsNullOrWhiteSpace(rejectReason)){rejectMsg="أدخل سبب الرفض";return;}try{await PoService.RejectAsync(OrderId, rejectReason, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);header.POStatus=4;header.RejectionReason=rejectReason;showRejectDialog=false;await ShowToastAsync("تم رفض أمر الشراء",false);await Task.Delay(1500);Navigation.NavigateTo("/purchase-orders");}catch(Exception ex){rejectMsg="خطأ: "+ex.Message;}}
    private async Task ExecuteMarkAsSent(){isSaving=true;StateHasChanged();try{await PoService.MarkAsSentAsync(OrderId, sentMethod, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);header.POStatus=5;await ShowToastAsync("تم إرسال أمر الشراء للمورد ");await Task.Delay(1500);Navigation.NavigateTo("/purchase-orders");}catch(Exception ex){await ShowToastAsync("خطأ: "+ex.Message,false);}finally{isSaving=false;}}
    private void ShowAddLine(){if(!isNewMode&&!orderDetailsLoaded)return;isEditLine=false;editLine=new(){PurchaseOrderID=OrderId,TaxRate=14};lineMsg="";priceSource=null;showLineForm=true;}
    private void ShowEditLine(PurchaseOrderDetailDto line){if(!isNewMode&&!orderDetailsLoaded)return;isEditLine=true;editLine=new(){PODetailID=line.PODetailID,PurchaseOrderID=line.PurchaseOrderID,ItemID=line.ItemID,ItemCode=line.ItemCode,ItemNameAr=line.ItemNameAr,UnitID=line.UnitID,UnitName=line.UnitName,OrderedQty=line.OrderedQty,UnitPrice=line.UnitPrice,DiscountPercent=line.DiscountPercent,TaxRate=line.TaxRate,ExpectedDate=line.ExpectedDate,Notes=line.Notes,RequestDetailID=line.RequestDetailID,PRApprovedQty=line.PRApprovedQty,PRRemainingToOrder=line.PRRemainingToOrder};lineMsg="";priceSource=null;showLineForm=true;}
    private void CloseLineForm(){showLineForm=false;lineMsg="";priceSource=null;}
    private async Task SaveLine()
    {
        lineMsg="";
        if(!isNewMode&&!orderDetailsLoaded){lineMsg=orderDetailsLoadDenied?"لا يمكن حفظ الصنف دون صلاحية قراءة أصناف الأمر.":"يجب تحميل أصناف الأمر بنجاح قبل حفظ أي سطر.";lineMsgOk=false;return;}
        if(editLine.ItemID==0){lineMsg="اختر الصنف";lineMsgOk=false;return;}if(editLine.UnitID==0){lineMsg="اختر الوحدة";lineMsgOk=false;return;}if(editLine.OrderedQty<=0){lineMsg="أدخل الكمية";lineMsgOk=false;return;}if(editLine.UnitPrice<0){lineMsg="السعر يجب أن يكون 0 أو أكبر";lineMsgOk=false;return;}
        if(isNewMode&&OrderId==0){await SaveOrder();if(OrderId==0)return;editLine.PurchaseOrderID=OrderId;}
        isSavingLine=true;StateHasChanged();
        try{
            if(isEditLine)await PoService.UpdateDetailAsync(editLine, UserSession.UserID);else await PoService.InsertDetailAsync(editLine, UserSession.UserID);
            await LoadOrderDetailsAsync();
            await LoadOrderRecordAsync();
            showLineForm=false;
            await ShowToastAsync(isEditLine?"تم التحديث ":"تم الإضافة ");
        }catch(Exception ex){lineMsg="خطأ: "+ex.Message;lineMsgOk=false;}
        finally{isSavingLine=false;}
    }
    private async Task DeleteLine(int detailId)
    {
        if(!isNewMode&&!orderDetailsLoaded){await ShowToastAsync(orderDetailsLoadDenied?"لا يمكن حذف الصنف دون صلاحية قراءة أصناف الأمر.":"حمّل أصناف الأمر بنجاح قبل حذف أي سطر.",false);return;}
        try
        {
            await PoService.DeleteDetailAsync(detailId, UserSession.UserID);
            await LoadOrderDetailsAsync();
            await LoadOrderRecordAsync();
            await ShowToastAsync("تم الحذف ");
        }
        catch(Exception ex){await ShowToastAsync("خطأ: "+ex.Message,false);}
    }
    private async Task PrintDoc()
    {
        if (OrderId <= 0 || !orderRecordLoaded) return;

        string html;
        try
        {
            html = await PoService.GenerateReportHtmlAsync(OrderId, UserSession.UserID);
        }
        catch (UnauthorizedAccessException ex)
        {
            Logger.LogWarning(ex, "Access denied generating print report for purchase order {PurchaseOrderID}.", OrderId);
            await ShowToastAsync("ليس لديك صلاحية طباعة أمر الشراء.", false);
            return;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to generate print report for purchase order {PurchaseOrderID}.", OrderId);
            await ShowToastAsync("تعذر تجهيز تقرير أمر الشراء للطباعة.", false);
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("printHtml", html);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to open print window for purchase order {PurchaseOrderID}.", OrderId);
            await ShowToastAsync("تم تجهيز التقرير لكن تعذر فتح نافذة الطباعة. حاول مرة أخرى.", false);
        }
    }
    private void GoBack()=>Navigation.NavigateTo("/purchase-orders");
    private async Task ShowToastAsync(string message, bool ok=true){toast=message;toastOk=ok;StateHasChanged();await Task.Delay(4000);toast="";StateHasChanged();}
