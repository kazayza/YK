            supplierQuickInfoLoadFailed = true;
            supplierQuickInfoLoadError = supplierInfo != null
                ? "تعذر تحديث معلومات المورد؛ البيانات السابقة ما زالت معروضة."
                : "تعذر تحميل معلومات المورد. يرجى إعادة المحاولة.";
