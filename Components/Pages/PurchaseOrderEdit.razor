    // ===========================
    // PR Selection
    // ===========================
    private async Task OnPRSelected(SearchableItem? item)
    {
        if (item == null || item.Id == 0)
        {
            prLines = null;
            selectedPRId = 0;
            return;
        }

        selectedPRId = item.Id;
        header.RequestID = item.Id;

        try
        {
            prLines = await LookupService.GetPRLinesForPOAsync(item.Id);
            foreach (var line in prLines)
            {
                line.IsSelected = true;
            }
        }
        catch (Exception ex)
        {
            await ShowToastAsync("خطأ في تحميل سطور طلب الشراء: " + ex.Message, false);
        }
    }

    private void ToggleAllPRLines(ChangeEventArgs e)
    {
        if (prLines == null) return;
        var val = (bool)(e.Value ?? false);
        foreach (var line in prLines)
            line.IsSelected = val;
    }

    // ===========================
    // Supplier Selection
    // ===========================
    private async Task OnSupplierSelected(SearchableItem? item)
    {
        if (item == null || item.Id == 0)
        {
            supplierInfo = null;
            header.SupplierID = 0;
            return;
        }

        header.SupplierID = item.Id;

        try
        {
            supplierInfo = await LookupService.GetSupplierQuickInfoAsync(item.Id);
            if (supplierInfo != null)
            {
                if (supplierInfo.PaymentTermID.HasValue)
                    header.PaymentTermID = supplierInfo.PaymentTermID;

                if (supplierInfo.CurrencyID.HasValue)
                {
                    header.CurrencyID = supplierInfo.CurrencyID;
                    header.ExchangeRate = supplierInfo.ExchangeRate;
                }
            }

            if (details.Any())
                await RefreshDetailsPrices();
        }
        catch (Exception ex)
        {
            await ShowToastAsync("خطأ في تحميل بيانات المورد: " + ex.Message, false);
        }
    }

    private async Task OnCurrencyChanged()
    {
        if (header.CurrencyID.HasValue && header.CurrencyID.Value > 0)
        {
            header.ExchangeRate = await LookupService.GetExchangeRateAsync(header.CurrencyID.Value);
            StateHasChanged();
        }
    }

    private async Task RefreshDetailsPrices()
    {
        if (header.SupplierID <= 0) return;

        foreach (var detail in details)
        {
            var price = await LookupService.GetSupplierItemPriceAsync(header.SupplierID, detail.ItemID);
            if (price != null && price.SuggestedPrice > 0)
            {
                // ملاحظة: لا نعدل الأسعار تلقائيًا في التفاصيل المحفوظة
                // فقط نعرض السعر المقترح لما المستخدم يعدل السطر
            }
        }
    }

    // ===========================
    // Item Selection (Line Form)
    // ===========================
    private async Task OnItemSelected(SearchableItem? item)
    {
        if (item == null) return;

        editLine.ItemID = item.Id;
        editLine.ItemCode = item.Code;
        editLine.ItemNameAr = item.Name;

        var info = await LookupService.GetItemQuickInfoAsync(item.Id);
        if (info != null)
        {
            if (info.UnitID > 0) editLine.UnitID = info.UnitID;
        }

        if (header.SupplierID > 0)
        {
            var price = await LookupService.GetSupplierItemPriceAsync(header.SupplierID, item.Id);
            if (price != null)
            {
                editLine.UnitPrice = price.SuggestedPrice;
                priceSource = price.PriceSource switch
                {
                    "SupplierPrice" => "💰 سعر المورد",
                    "LastPurchase" => "📋 آخر شراء",
                    "AverageCost" => "📊 متوسط التكلفة",
                    "StandardCost" => "📐 التكلفة المعيارية",
                    _ => null
                };
            }
        }
        else if (info != null && info.EstimatedPrice > 0)
        {
            editLine.UnitPrice = info.EstimatedPrice;
            priceSource = "📊 سعر تقديري";
        }

        StateHasChanged();
    }

    // ===========================
    // Save Order
    // ===========================
    private async Task SaveOrder()
    {
        if (header.PODate == default)
        {
            await ShowToastAsync("حدد تاريخ أمر الشراء", false);
            return;
        }

        if (header.SupplierID <= 0)
        {
            await ShowToastAsync("اختر المورد", false);
            return;
        }

        isSaving = true;
        StateHasChanged();

        try
        {
            if (isNewMode)
            {
                header.PONumber = await PoService.GeneratePONumberAsync();
                header.POStatus = 1;

                var newId = await PoService.InsertOrderAsync(header, UserSession.UserID);
                OrderId = newId;
                header.PurchaseOrderID = newId;

                if (header.POSource == 2 && prLines != null)
                {
                    var selectedIds = prLines
                        .Where(l => l.IsSelected)
                        .Select(l => l.RequestDetailID)
                        .ToList();

                    if (selectedIds.Any())
                    {
                        var imported = await PoService.ImportLinesFromPRAsync(
                            newId,
                            header.RequestID ?? 0,
                            selectedIds,
                            header.SupplierID,
                            UserSession.UserID);

                        await ShowToastAsync($"تم إنشاء الأمر وتحميل {imported} صنف ✅");
                    }
                    else
                    {
                        await ShowToastAsync($"تم إنشاء أمر الشراء: {header.PONumber} ✅");
                    }
                }
                else
                {
                    await ShowToastAsync($"تم إنشاء أمر الشراء: {header.PONumber} ✅");
                }

                isSourceLocked = true;
                isPRLoaded = true;
                details = await PoService.GetOrderDetailsAsync(newId);
                header = await PoService.GetOrderByIdAsync(newId) ?? header;

                Navigation.NavigateTo($"/purchase-orders/edit/{newId}", forceLoad: false);
            }
            else
            {
                await PoService.UpdateOrderAsync(header, UserSession.UserID);
                header = await PoService.GetOrderByIdAsync(OrderId) ?? header;
                details = await PoService.GetOrderDetailsAsync(OrderId);
                await ShowToastAsync("تم حفظ التعديلات ✅");
            }
        }
        catch (Exception ex)
        {
            await ShowToastAsync("خطأ: " + ex.Message, false);
        }
        finally
        {
            isSaving = false;
        }
    }

