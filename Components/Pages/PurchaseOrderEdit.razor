    .modal-btns-row { display:flex; gap:8px; margin-top:16px; justify-content:center; }

    /* Toast */
    .toast-wrap { position:fixed; bottom:22px; left:22px; z-index:1050; animation:toastIn .35s ease; }
    .toast { display:flex; align-items:center; gap:12px; padding:12px 18px; border-radius:14px; box-shadow:0 10px 28px rgba(0,0,0,.12); min-width:300px; font-weight:600; font-size:.86rem; }
    .t-ok { background:#ecfdf5; border:1px solid #a7f3d0; color:#065f46; }
    .t-err { background:#fef2f2; border:1px solid #fecaca; color:#991b1b; }
    .toast button { background:none; border:none; cursor:pointer; color:inherit; opacity:.6; margin-right:auto; }

    /* Loading / No Access */
    .loading-st { text-align:center; padding:50px; color:#64748b; }
    .loader { width:36px; height:36px; border:3px solid #e2e8f0; border-top-color:#2563eb; border-radius:50%; animation:spin .7s linear infinite; margin:0 auto 12px; }
    .no-access { text-align:center; padding:60px; background:white; border-radius:18px; border:1px solid #e2e8f0; }
    .na-icon { font-size:3rem; margin-bottom:12px; }

    @@keyframes spin { to { transform:rotate(360deg); } }
    @@keyframes toastIn { from { opacity:0; transform:translateY(16px); } to { opacity:1; transform:translateY(0); } }

    @@media (max-width:768px) {
        .c4 { grid-template-columns:repeat(2,1fr); }
        .c3 { grid-template-columns:1fr; }
        .c2 { grid-template-columns:1fr; }
        .f-field.c2 { grid-column:span 1; }
        .doc-header { flex-direction:column; }
        .doc-actions { flex-direction:column; gap:10px; }
        .approval-bar { flex-direction:column; }
        .approval-label { border-left:none; border-bottom:2px solid #a7f3d0; padding-left:0; padding-bottom:8px; margin-left:0; margin-bottom:8px; }
        .source-cards { grid-template-columns:1fr; }
        .supplier-info-bar { flex-direction:column; }
        .totals-bar { flex-direction:column; align-items:stretch; }
        .total-item { flex-direction:row; justify-content:space-between; }
        .line-calc-bar { flex-direction:column; gap:8px; }
        .sent-method-wrap { flex-direction:column; width:100%; }
        .sent-select { width:100%; }
    }
</style>
@code {
    [Parameter] public int OrderId { get; set; }

    // === Data ===
    private PurchaseOrderHeaderDto header = new() { PODate = DateTime.Today, ExchangeRate = 1 };
    private List<PurchaseOrderDetailDto> details = new();
    private ModulePermissionDto? permissions;
    private SupplierQuickInfoDto? supplierInfo;

    // === Lookups ===
    private List<LookupDto>? warehouses;
    private List<LookupDto>? paymentTerms;
    private List<LookupDto>? currencies;
    private List<LookupDto>? units;
    private List<SearchableItem>? suppliersSearchable;
    private List<SearchableItem>? purchaseItems;
    private List<SearchableItem>? approvedPRs;

    // === PR Lines ===
    private List<PRLineForPODto>? prLines;
    private int selectedPRId;
    private bool isPRLoaded = false;

    // === UI State ===
    private bool isLoading = true;
    private bool isSaving = false;
    private string toast = "";
    private bool toastOk = true;
    private bool isSourceLocked = false;
    private string sentMethod = "";

    // === Line Form ===
    private bool showLineForm = false;
    private bool isEditLine = false;
    private PurchaseOrderDetailEditDto editLine = new();
    private bool isSavingLine = false;
    private string lineMsg = "";
    private bool lineMsgOk = true;
    private string? priceSource;

    // === Reject Dialog ===
    private bool showRejectDialog = false;
    private string rejectReason = "";
    private string rejectMsg = "";

    // === Computed ===
    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => OrderId == 0;

    private bool isApprovalMode =>
        !isNewMode && !isViewMode &&
        header.POStatus == 2 &&
        (permissions?.CanApprove ?? false);

    private bool canMarkAsSent =>
        !isNewMode && !isViewMode &&
        header.POStatus == 3 &&
        (permissions?.CanEdit ?? false);

    private bool isReadOnly
    {
        get
        {
            if (isViewMode) return true;
            if (isNewMode) return false;
            if (isApprovalMode) return true;
            if (canMarkAsSent) return true;
            return header.POStatus != 1;
        }
    }

    private string pageTitle
    {
        get
        {
            if (isNewMode) return "أمر شراء جديد";
            if (isViewMode) return "عرض أمر شراء";
            if (isApprovalMode) return "اعتماد أمر شراء";
            if (canMarkAsSent) return "إرسال أمر شراء للمورد";
            return "تعديل أمر شراء";
        }
    }

    // ===========================
    // Lifecycle
    // ===========================
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!UserSession.IsLoggedIn)
            {
                Navigation.NavigateTo("/login");
                return;
            }

            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(UserSession.UserID);

            permissions = PermissionService.GetModule("SCR_PO");
            if (permissions == null || !permissions.CanView) return;

            await LoadLookups();

            if (OrderId > 0)
            {
                await LoadOrderData();
            }
            else
            {
                var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                var source = query["source"];
                if (source == "pr")
                {
                    header.POSource = 2;
                    approvedPRs = await LookupService.GetApprovedPRsSearchableAsync();
                }
                else if (source == "manual")
                {
                    header.POSource = 1;
                    isSourceLocked = true;
                }
            }
        }
        catch (Exception ex)
        {
            await ShowToastAsync("خطأ في تحميل الصفحة: " + ex.Message, false);
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

