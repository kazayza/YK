    private async Task SaveLine()
    {
        lineMsg = "";

        if (editLine.ItemID == 0) { lineMsg = "اختر الصنف"; lineMsgOk = false; return; }
        if (editLine.UnitID == 0) { lineMsg = "اختر الوحدة"; lineMsgOk = false; return; }
        if (editLine.OrderedQty <= 0) { lineMsg = "أدخل الكمية"; lineMsgOk = false; return; }
        if (editLine.UnitPrice < 0) { lineMsg = "السعر يجب أن يكون 0 أو أكبر"; lineMsgOk = false; return; }

        if (isNewMode && OrderId == 0)
        {
            await SaveOrder();
            if (OrderId == 0) return;
            editLine.PurchaseOrderID = OrderId;
        }

        isSavingLine = true;
        StateHasChanged();

        try
        {
            if (isEditLine)
                await PoService.UpdateDetailAsync(editLine, UserSession.UserID);
            else
                await PoService.InsertDetailAsync(editLine, UserSession.UserID);

            details = await PoService.GetOrderDetailsAsync(OrderId);
            header = await PoService.GetOrderByIdAsync(OrderId) ?? header;
            showLineForm = false;
            await ShowToastAsync(isEditLine ? "تم التحديث ✅" : "تم الإضافة ✅");
        }
        catch (Exception ex)
        {
            lineMsg = "خطأ: " + ex.Message;
            lineMsgOk = false;
        }
        finally
        {
            isSavingLine = false;
        }
    }

