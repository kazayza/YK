            header.POStatus = 2;
            await ShowToastAsync("تم الإرسال للاعتماد ✅");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("خطأ: " + ex.Message, false);
        }
        finally
        {
            isSaving = false;
        }
    }

    // ===========================
    // Approve
    // ===========================
    private async Task ExecuteApprove()
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "هل تريد اعتماد أمر الشراء؟");
        if (!confirmed) return;

        isSaving = true;
        StateHasChanged();

        try
        {
            await PoService.ApproveAsync(OrderId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            header.POStatus = 3;
            await ShowToastAsync("تم الاعتماد ✅");
            await Task.Delay(1500);
            Navigation.NavigateTo("/purchase-orders");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("خطأ: " + ex.Message, false);
        }
        finally
        {
            isSaving = false;
        }
    }

