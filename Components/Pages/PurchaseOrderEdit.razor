                                    </div>
                                    <div class="line-calc-bar-luxury"><span>قبل الضريبة: <strong>@editLine.LineTotal.ToString("#,##0.00")</strong></span><span>الضريبة: <strong>@editLine.TaxAmount.ToString("#,##0.00")</strong></span><span class="grand">الإجمالي: <strong>@editLine.LineTotalWithTax.ToString("#,##0.00")</strong></span></div>
                                    @if(!string.IsNullOrEmpty(lineMsg)){<div class="msg-luxury @(lineMsgOk?"msg-success":"msg-error")" style="margin-top:10px">@lineMsg</div>}
                                    <div class="line-form-btns"><button class="btn-luxury btn-primary-luxury" @onclick="SaveLine" disabled="@isSavingLine">@if(isSavingLine){<div class="btn-spinner"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H6v8"/></svg>}<span>@(isEditLine?"تحديث":"إضافة")</span></button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseLineForm">إلغاء</button></div>
                                </div>
                            }
                        </div>
                    }

                    @if (activeTab == 3)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div><h3>التكاليف الإضافية والإجماليات</h3><p>الخصم العام والشحن والعملة</p></div></div>
                            @if (!isReadOnly && !isApprovalMode && OrderId > 0 && details.Any())
                            {
                                <div class="form-grid cols-4">
                                    <div class="form-field"><label class="field-label">خصم عام %</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="header.DiscountPercent" step="0.01" /><span class="field-suffix">%</span></div></div>
                                    <div class="form-field"><label class="field-label">تكلفة الشحن</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="header.ShippingCost" step="0.01" /><span class="field-suffix">ج.م</span></div></div>
                                    <div class="form-field"><label class="field-label">تكاليف أخرى</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="header.OtherCosts" step="0.01" /><span class="field-suffix">ج.م</span></div></div>
                                    <div class="form-field">
                                        <label class="field-label">سعر الصرف</label>
                                        <div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><input type="number" class="field-input" @bind="header.ExchangeRate" step="0.000001" disabled="@isExchangeRateLoading" /></div>
                                        @if (isExchangeRateLoading)
                                        {
                                            <div class="field-hint" role="status">جارٍ تحميل سعر الصرف للعملة المختارة...</div>
                                        }
                                        else if (exchangeRateLoadFailed)
                                        {
                                            <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px"><span>@exchangeRateLoadError</span><button type="button" class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadExchangeRateAsync" disabled="@isExchangeRateLoading">إعادة المحاولة</button></div>
                                        }
                                        else if (exchangeRateLoadDenied)
                                        {
                                            <div class="msg-luxury msg-info" role="status" style="margin-top:6px">@exchangeRateLoadError</div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (OrderId > 0 && details.Any())
                            {
                                <div class="totals-bar-luxury"><div class="ml-gold-line"></div><div class="totals-grid"><div class="total-item"><span class="total-label">الإجمالي الفرعي</span><span class="total-value">@header.SubTotal.ToString("#,##0.00")</span></div>@if(header.DiscountAmount>0){<div class="total-item"><span class="total-label">الخصم</span><span class="total-value t-discount">- @header.DiscountAmount.ToString("#,##0.00")</span></div>}<div class="total-item"><span class="total-label">الضريبة</span><span class="total-value">@header.TaxAmount.ToString("#,##0.00")</span></div>@if(header.ShippingCost>0){<div class="total-item"><span class="total-label">الشحن</span><span class="total-value">@header.ShippingCost.ToString("#,##0.00")</span></div>}@if(header.OtherCosts>0){<div class="total-item"><span class="total-label">تكاليف أخرى</span><span class="total-value">@header.OtherCosts.ToString("#,##0.00")</span></div>}<div class="total-item total-grand-luxury"><span class="total-label">الإجمالي الكلي</span><span class="total-value">@header.TotalAmount.ToString("#,##0.00") @(header.CurrencySymbol ?? "ج.م")</span></div></div></div>
                            }
                            else if (OrderId > 0 && !orderDetailsLoaded)
                            {<div class="msg-luxury msg-info" role="status">لا يمكن عرض إجماليات الأصناف قبل اكتمال قراءة تفاصيل الأمر.</div>}
                            else{<div class="empty-luxury small"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><h4>لا توجد أصناف لحساب الإجمالي</h4></div>}
                        </div>
                    }

                    @if (activeTab == 4)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div><h3>الاعتماد والسجل</h3><p>حالة الاعتماد والإرسال والتتبع</p></div></div>
                            <div class="status-timeline-luxury">
                                <div class="st-step @(header.POStatus>=1?"done":"")"><div class="st-dot"></div><div class="st-line"></div><div class="st-content"><strong>مسودة</strong><span>تم الإنشاء @header.PODate.ToString("dd/MM/yyyy")</span></div></div>
                                <div class="st-step @(header.POStatus>=2?"done":"") @(header.POStatus==2?"current":"")"><div class="st-dot"></div><div class="st-line"></div><div class="st-content"><strong>انتظار اعتماد</strong><span>@(header.POStatus>=2?"تم الإرسال للاعتماد":"لم يرسل بعد")</span></div></div>
                                <div class="st-step @(header.POStatus>=3?"done":"") @(header.POStatus==3?"current":"")"><div class="st-dot"></div><div class="st-line"></div><div class="st-content"><strong>معتمد</strong><span>@(header.POStatus>=3?"تم الاعتماد":"بانتظار الاعتماد")</span></div></div>
                                <div class="st-step @(header.POStatus>=5?"done":"")"><div class="st-dot"></div><div class="st-line"></div><div class="st-content"><strong>مرسل للمورد</strong><span>@(header.POStatus>=5?"تم الإرسال":"لم يرسل")</span></div></div>
                                <div class="st-step @(header.POStatus>=6?"done":"")"><div class="st-dot"></div><div class="st-content"><strong>استلام</strong><span>متابعة استلام البضاعة</span></div></div>
                            </div>
                            @if (header.POStatus==4){<div class="msg-luxury msg-error" style="margin-top:16px"><i class=bi-x-circle-fill></i> مرفوض - السبب: @header.RejectionReason</div>}
                        </div>
                    }

                    @if (activeTab == 5)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><div><h3>ملاحظات أمر الشراء</h3><p>ملاحظات عامة وداخلية</p></div></div>
                            <div class="form-grid cols-2">
                                <div class="form-field"><label class="field-label">ملاحظات عامة (تظهر في الطباعة)</label><textarea class="field-textarea" rows="4" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات عامة تظهر للمورد..."></textarea></div>
                                <div class="form-field"><label class="field-label">ملاحظات داخلية (لا تطبع)</label><textarea class="field-textarea" rows="4" @bind="header.InternalNotes" disabled="@isReadOnly" placeholder="ملاحظات داخلية للمتابعة..."></textarea></div>
                            </div>
                            <div class="timeline-luxury">
                                <div class="tl-item"><div class="tl-dot gold"></div><div class="tl-content"><strong>رقم الأمر: @(header.PONumber ?? "تلقائي")</strong><span>تاريخ: @header.PODate.ToString("dd/MM/yyyy")</span></div></div>
                                <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><strong>المورد: @(header.SupplierNameAr ?? "—")</strong><span>المخزن: @ReceivingWarehouseDisplayText</span></div></div>
                                <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><strong>الإجمالي: @header.TotalAmount.ToString("#,##0.00") @(header.CurrencySymbol ?? "")</strong><span>@OrderDetailsTimelineSummaryText</span></div></div>
                                @if (!string.IsNullOrEmpty(createdByName)){<div class="tl-item"><div class="tl-dot gold"></div><div class="tl-content"><strong>أنشئ بواسطة: @createdByName</strong><span>@createdDate</span></div></div>}
                                @if (!string.IsNullOrEmpty(modifiedByName)){<div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><strong>آخر تعديل: @modifiedByName</strong><span>@modifiedDate</span></div></div>}
                                <div class="tl-item"><div class="tl-dot" style="background:var(--gold)"></div><div class="tl-content"><strong>المستخدم الحالي: @UserSession.FullName</strong><span>يعمل الآن على هذا السجل</span></div></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (OrderId > 0 && auditInfoLoaded && auditInfoHasData)
            {
                <div class="audit-bar-luxury">
                    <div class="audit-item-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span>أنشئ بواسطة: <strong>@(string.IsNullOrEmpty(createdByName)?"غير محدد":createdByName)</strong></span><span class="audit-date">@createdDate</span></div>
                    @if (!string.IsNullOrEmpty(modifiedByName)){<div class="audit-item-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 3v5h5"/></svg><span>آخر تعديل: <strong>@modifiedByName</strong></span><span class="audit-date">@modifiedDate</span></div>}
                    <div class="audit-item-luxury gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg><span>المستخدم الحالي: <strong>@UserSession.FullName</strong></span></div>
                </div>
            }
            @if (OrderId > 0 && isAuditInfoLoading && auditInfoLoaded)
            {
                <div class="field-hint" role="status" style="margin-top:8px">جارٍ تحديث سجل مراجعة أمر الشراء؛ تُعرض آخر نتيجة ناجحة.</div>
            }
            else if (OrderId > 0 && auditInfoLoadFailed && auditInfoLoaded)
            {
                <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:8px"><span>@auditInfoWarning</span><button type="button" class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadAuditInfoAsync" disabled="@isAuditInfoLoading">إعادة المحاولة</button></div>
            }
            @if (OrderId > 0 && isAuditInfoLoading && !auditInfoLoaded)
            {
                <div class="field-hint" role="status" style="margin-top:8px">جارٍ تحميل سجل مراجعة أمر الشراء...</div>
            }
            else if (OrderId > 0 && auditInfoLoadFailed && !auditInfoLoaded)
            {
                <div class="msg-luxury msg-error" role="alert" style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:8px"><span>@auditInfoWarning</span><button type="button" class="btn-luxury btn-ghost-luxury" @onclick="RetryLoadAuditInfoAsync" disabled="@isAuditInfoLoading">إعادة المحاولة</button></div>
            }
            else if (OrderId > 0 && auditInfoLoadDenied && !auditInfoLoaded)
            {
                <div class="msg-luxury msg-info" role="status" style="margin-top:8px">@auditInfoWarning</div>
            }
            else if (OrderId > 0 && auditInfoLoaded && !auditInfoHasData)
            {
                <div class="field-hint" role="status" style="margin-top:8px">لا تتوفر بيانات سجل تدقيق إضافية لأمر الشراء.</div>
            }

            @if (!isViewMode && !isApprovalMode)
            {
                <div class="actions-bar-luxury">
                    <div class="actions-right-luxury">
                        @if (!isReadOnly)
                        {
                            <button class="btn-luxury btn-primary-luxury" @onclick="SaveOrder" disabled="@isSaving">@if(isSaving){<div class="btn-spinner"></div><span>جاري الحفظ...</span>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H6v8"/></svg><span>@(isNewMode?"حفظ أمر الشراء":"حفظ التعديلات")</span>}</button>
                            @if (OrderId>0 && header.POStatus==1 && orderDetailsLoaded && details.Any()){<button class="btn-luxury btn-warning-luxury" @onclick="SubmitForApproval" disabled="@isSaving"><i class=bi-book></i> إرسال للاعتماد</button>}
                        }
                    </div>
                    <button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">رجوع للقائمة</button>
                </div>
            }
        }
    </div>

    @if (showRejectDialog)
    {
        <div class="modal-overlay-luxury" @onclick="() => showRejectDialog=false"><div class="modal-card-luxury" @onclick:stopPropagation="true"><div class="ml-gold-line danger"></div><div class="modal-header-luxury"><h3>رفض أمر الشراء</h3><button class="btn-close-x" @onclick="() => showRejectDialog=false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div><div class="modal-body-luxury"><div class="form-field"><label class="field-label required">سبب الرفض</label><textarea class="field-textarea" rows="3" @bind="rejectReason" placeholder="أدخل سبب الرفض..."></textarea></div>@if(!string.IsNullOrEmpty(rejectMsg)){<div class="msg-luxury msg-error" style="margin-top:10px">@rejectMsg</div>}</div><div class="ml-footer"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmReject">تأكيد الرفض</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showRejectDialog=false">إلغاء</button></div></div></div>
    }

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast=""'><i class=bi-x-lg></i></button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-edit-page{display:flex;flex-direction:column;gap:16px;max-width:1300px;margin:0 auto;font-family:'Tajawal',sans-serif}
.lh-bg-logo img{width:100px;height:100px;object-fit:contain}
.lh-logo-wrap{width:40px;height:40px;border-radius:10px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}
.lh-title{font-size:1.1rem;font-weight:900;color:#F5E6C8;margin:0}
.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:700;color:var(--gold)}
.status-badge-luxury{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.72rem;font-weight:800;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,white)}
.source-badge-luxury{display:inline-block;padding:3px 10px;border-radius:999px;font-size:.7rem;font-weight:700;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 20%,white)}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:10px;font-weight:700;font-size:.78rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 2px 10px rgba(212,175,55,.25)}
.btn-ghost-dark{background:rgba(255,255,255,.06);color:#cbd5e1;border:1px solid rgba(212,175,55,.12)}
.btn-ghost-dark:hover{background:rgba(255,255,255,.1)}
.btn-ghost-luxury{background:#fff;border:1px solid #e8e2d0;color:#475569}
.btn-success-luxury{background:linear-gradient(135deg,#059669,#10b981);color:#fff}
.btn-warning-luxury{background:linear-gradient(135deg,#d97706,#f59e0b);color:#fff}
.btn-spinner{width:16px;height:16px;border:2px solid rgba(0,0,0,.1);border-top-color:var(--black2);border-radius:50%;animation:spin .6s linear infinite}
.approval-bar-luxury{position:relative;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 18px;border-radius:16px;flex-wrap:wrap;overflow:hidden}
.approval-bar-luxury.approve{background:linear-gradient(135deg,#ecfdf5,#f0fdf4);border:1px solid #a7f3d0}
.approval-bar-luxury.sent{background:linear-gradient(135deg,#eff6ff,#dbeafe);border:1px solid #93c5fd}
.ab-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#10b981,transparent)}
.ab-gold-line.blue{background:linear-gradient(90deg,transparent,#2563eb,transparent)}
.ab-content{display:flex;align-items:center;gap:12px}
.ab-icon{width:40px;height:40px;border-radius:12px;background:#ecfdf5;border:1px solid #a7f3d0;display:flex;align-items:center;justify-content:center;color:#059669}
.ab-icon.blue{background:#eff6ff;border-color:#bfdbfe;color:#2563eb}
.ab-icon svg{width:20px;height:20px}
.ab-content div{display:flex;flex-direction:column}
.ab-content strong{font-size:.9rem;color:#0A0F1E}
.ab-content span{font-size:.74rem;color:#6b7280}
.ab-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.select-wrap-luxury.sm select{height:36px;padding:0 30px 0 26px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.78rem;font-family:'Tajawal';background:#fff;appearance:none;cursor:pointer;min-width:150px}
.select-wrap-luxury .arrow{position:absolute;left:8px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.source-cards-luxury{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}
.source-card-luxury{position:relative;background:#fff;border:2px solid #e8e2d0;border-radius:16px;padding:22px;text-align:center;cursor:pointer;transition:.2s;overflow:hidden}
.source-card-luxury:hover{border-color:var(--gold);transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06)}
.source-card-luxury.active{border-color:var(--gold);background:rgba(212,175,55,.04);box-shadow:0 0 0 3px rgba(212,175,55,.12)}
.sc-icon{width:52px;height:52px;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:10px}
.sc-icon svg{width:24px;height:24px}
.sc-title{font-weight:800;font-size:.92rem;color:#0A0F1E;margin-bottom:4px}
.sc-desc{font-size:.76rem;color:#8B95A5}
.ml-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent);opacity:.8}
.ml-gold-line.danger{background:linear-gradient(90deg,transparent,#ef4444,#dc2626,transparent)}
.mudtabs-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:20px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.05);position:relative}
.mudtabs-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.6;z-index:2}
.mudtabs-header{position:relative;display:flex;gap:0;background:linear-gradient(135deg,#fcfaf6 0%,#f8f6f0 100%);border-bottom:1px solid #e8e2d0;padding:0 8px;overflow-x:auto;scrollbar-width:none}
.mudtabs-header::-webkit-scrollbar{display:none}
.mudtab-btn{position:relative;display:flex;align-items:center;gap:8px;padding:14px 18px;background:transparent;border:none;border-bottom:2px solid transparent;font-family:'Tajawal';font-size:.82rem;font-weight:700;color:#8B95A5;cursor:pointer;transition:all .25s;white-space:nowrap;flex-shrink:0}
.mudtab-btn:hover{background:rgba(212,175,55,.04);color:#0A0F1E}
.mudtab-btn.active{color:var(--gold-dark);background:rgba(212,175,55,.06);border-bottom-color:var(--gold)}
.mt-icon{width:20px;height:20px;display:flex;align-items:center;justify-content:center}
.mt-icon svg{width:16px;height:16px}
