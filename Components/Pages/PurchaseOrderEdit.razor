        var requestVersion = ++supplierQuickInfoLoadVersion;
        supplierQuickInfoApplyDefaults = applyDefaults;
        isSupplierQuickInfoLoading = true;
        supplierQuickInfoLoadFailed = false;
        supplierQuickInfoLoadDenied = false;
        supplierQuickInfoLoadError = string.Empty;
        StateHasChanged();
        try
        {
            var loadedSupplierInfo = await LookupService.GetSupplierQuickInfoAsync(supplierId);
            if (requestVersion != supplierQuickInfoLoadVersion || header.SupplierID != supplierId) return false;

            supplierInfo = loadedSupplierInfo;
            if (applyDefaults && loadedSupplierInfo != null)
            {
                if (loadedSupplierInfo.PaymentTermID.HasValue)
                    header.PaymentTermID = loadedSupplierInfo.PaymentTermID;
                if (loadedSupplierInfo.CurrencyID.HasValue)
                {
                    header.CurrencyID = loadedSupplierInfo.CurrencyID;
                    header.ExchangeRate = loadedSupplierInfo.ExchangeRate;
