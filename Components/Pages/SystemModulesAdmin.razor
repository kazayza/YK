@page "/settings/modules"
@using YKCoatings.Helpers
@using YKCoatings.Models
@using YKCoatings.Services
@inject SystemModuleAdminService ModuleAdminService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>إدارة الوحدات</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="module-admin-access" dir="rtl"><i class="bi bi-lock-fill"></i><h3>يجب تسجيل الدخول أولاً</h3></div>
}
else if (permissions is null || !permissions.CanView)
{
    <div class="module-admin-access" dir="rtl"><i class="bi bi-shield-lock-fill"></i><h3>ليس لديك صلاحية عرض إعدادات الوحدات</h3></div>
}
else
{
    <main class="module-admin-page yk-gold-page" dir="rtl">
        <header class="module-admin-hero">
            <div class="module-hero-line"></div>
            <div class="module-hero-copy">
                <span class="module-eyebrow">الإعدادات · التحكم في شاشات النظام</span>
                <h1><i class="bi bi-grid-3x3-gap-fill"></i> إدارة الوحدات</h1>
                <p>فعّل أو عطّل إتاحة الشاشات على مستوى النظام، دون تعديل صلاحيات الأدوار.</p>
            </div>
            <button type="button" class="module-back" @onclick='() => Navigation.NavigateTo("/settings")'>
                <i class="bi bi-arrow-right"></i><span>العودة إلى الإعدادات</span>
            </button>
        </header>

        <section class="module-notice">
            <i class="bi bi-info-circle-fill"></i>
            <span>التغيير عام على النظام. بعد الحفظ تُعاد قراءة الوحدات الفعالة وتُحدّث قائمة التنقل في الجلسة الحالية؛ صلاحيات الأدوار نفسها لا تتغير. المجموعات الرئيسية للترتيب فقط، ولا يمكن تعطيل شاشة الإعدادات من هنا.</span>
        </section>

        @if (!string.IsNullOrWhiteSpace(statusMessage))
        {
            <div class="module-message @(statusIsError ? "error" : "success")" role="@(statusIsError ? "alert" : "status")">
                <i class="bi @(statusIsError ? "bi-exclamation-circle-fill" : "bi-check-circle-fill")"></i><span>@statusMessage</span>
            </div>
        }

        <section class="module-stats">
            <div class="module-stat"><span class="module-stat-icon"><i class="bi bi-grid"></i></span><div><strong>@modules.Count</strong><small>إجمالي السجلات</small></div></div>
            <div class="module-stat"><span class="module-stat-icon on"><i class="bi bi-check-circle"></i></span><div><strong>@modules.Count(x => !x.IsMainGroup && x.IsActive)</strong><small>شاشات فعالة</small></div></div>
            <div class="module-stat"><span class="module-stat-icon off"><i class="bi bi-pause-circle"></i></span><div><strong>@modules.Count(x => !x.IsMainGroup && !x.IsActive)</strong><small>شاشات متوقفة</small></div></div>
            <div class="module-stat"><span class="module-stat-icon group"><i class="bi bi-diagram-3"></i></span><div><strong>@modules.Count(x => x.IsMainGroup)</strong><small>مجموعات رئيسية</small></div></div>
        </section>

        <section class="module-list-card">
            <div class="module-list-heading">
                <div class="module-section-title">
                    <span class="module-section-icon"><i class="bi bi-list-ul"></i></span>
                    <div><h2>سجل الوحدات والشاشات</h2><p>الاسم والكود والمجموعة والمسار للقراءة؛ الإجراء الوحيد هنا تغيير حالة التفعيل.</p></div>
                </div>
                @if (permissions.CanEdit)
                {
                    <span class="module-edit-badge"><i class="bi bi-shield-check"></i> تملك صلاحية تغيير الحالة</span>
                }
                else
                {
                    <span class="module-view-badge"><i class="bi bi-eye"></i> عرض فقط</span>
                }
            </div>

            <div class="module-filters">
                <label class="module-search">
                    <i class="bi bi-search"></i>
                    <input type="search" placeholder="ابحث بالاسم أو الكود أو المجموعة أو المسار..." @bind="searchText" @bind:event="oninput" />
                </label>
                <label class="module-status-filter">
                    <span>الحالة</span>
                    <select @bind="statusFilter">
                        <option value="all">الكل</option>
                        <option value="active">الفعالة</option>
                        <option value="inactive">المتوقفة</option>
                    </select>
                </label>
                <span class="module-result-count">@FilteredModules.Count() نتيجة</span>
            </div>

            @if (isLoading)
            {
                <div class="module-empty"><span class="module-spinner"></span><span>جاري تحميل سجل الوحدات...</span></div>
            }
            else if (!FilteredModules.Any())
            {
                <div class="module-empty"><i class="bi bi-search"></i><strong>لا توجد نتائج مطابقة</strong><span>غيّر كلمات البحث أو مرشح الحالة.</span></div>
            }
            else
            {
                <div class="module-table-wrap">
                    <table class="module-table">
                        <thead>
                            <tr>
                                <th>الوحدة</th>
                                <th>الكود</th>
                                <th>التصنيف / المجموعة</th>
                                <th class="center">الترتيب</th>
                                <th>مسار الشاشة</th>
                                <th class="center">الحالة</th>
                                <th class="center">الإجراء</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var module in FilteredModules)
                            {
                                var route = ModuleRouteHelper.GetRoute(module.ModuleCode);
                                var routeIsMapped = !route.StartsWith("/module/", StringComparison.OrdinalIgnoreCase);
                                var canToggle = CanToggle(module);
                                <tr class="@(module.IsMainGroup ? "group-row" : "")">
                                    <td>
                                        <div class="module-name-cell">
                                            <span class="module-row-icon @(module.IsMainGroup ? "group" : "screen")"><i class="bi @(module.IsMainGroup ? "bi-folder2-open" : "bi-window")"></i></span>
                                            <div><strong>@module.ModuleNameAr</strong>
                                                @if (module.IsMainGroup)
                                                {
                                                    <small>مجموعة تنظيمية للعرض</small>
                                                }
                                                else if (module.IsSettingsModule)
                                                {
                                                    <small class="protected-note">محمي من التعطيل لتجنب فقدان الوصول للإعدادات</small>
                                                }
                                            </div>
                                        </div>
                                    </td>
                                    <td><code class="module-code" dir="ltr">@module.ModuleCode</code>
                                        @if (module.DuplicateCodeCount > 1)
                                        {
                                            <span class="issue-badge" title="عدد السجلات بهذا الكود: @module.DuplicateCodeCount"><i class="bi bi-exclamation-triangle-fill"></i> كود مكرر</span>
                                        }
                                    </td>
                                    <td>
                                        @if (module.IsMainGroup)
                                        {
                                            <span class="module-type-badge group-type">مجموعة رئيسية</span>
                                        }
                                        else if (module.ParentModuleID is null)
                                        {
                                            <span class="module-type-badge">شاشة مستقلة</span>
                                        }
                                        else if (!module.ParentExists)
                                        {
                                            <span class="module-type-badge orphan-type">قسم رئيسي مفقود</span>
                                        }
                                        else
                                        {
                                            <span class="module-parent"><i class="bi bi-arrow-return-left"></i> @module.ParentModuleName</span>
                                            @if (!module.ParentIsActive)
                                            {
                                                <small class="parent-inactive-note">المجموعة الرئيسية متوقفة</small>
                                            }
                                        }
                                    </td>
                                    <td class="center"><span class="module-order-badge">@module.SortOrder</span></td>
                                    <td>
                                        <div class="module-route-cell">
                                            <code dir="ltr">@route</code>
                                            @if (!routeIsMapped)
                                            {
                                                <small class="route-fallback"><i class="bi bi-exclamation-triangle"></i> لا يوجد ربط معروف في ModuleRouteHelper</small>
                                            }
                                        </div>
                                    </td>
                                    <td class="center"><span class="module-state @(module.IsActive ? "active" : "inactive")"><i class="bi @(module.IsActive ? "bi-check-circle-fill" : "bi-pause-circle-fill")"></i>@(module.IsActive ? "فعالة" : "متوقفة")</span></td>
                                    <td class="center">
                                        @if (module.IsMainGroup)
                                        {
                                            <span class="read-only-action" title="المجموعات الرئيسية لا تُعدّل من هذه الشاشة"><i class="bi bi-dash-circle"></i> هيكلية</span>
                                        }
                                        else if (module.IsSettingsModule)
                                        {
                                            <span class="read-only-action protected" title="لا يمكن تعطيل شاشة الإعدادات من داخلها"><i class="bi bi-shield-lock"></i> محمية</span>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="module-toggle @(module.IsActive ? "deactivate" : "activate")"
                                                    disabled="@(!canToggle || isSavingModuleId.HasValue)"
                                                    title="@ToggleBlockReason(module)"
                                                    @onclick="() => ToggleModuleAsync(module)">
                                                @if (isSavingModuleId == module.ModuleID)
                                                {
                                                    <span class="module-button-spinner"></span><span>جارٍ الحفظ</span>
                                                }
                                                else
                                                {
                                                    <i class="bi @(module.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                                    <span>@(module.IsActive ? "تعطيل" : "تفعيل")</span>
                                                }
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <footer class="module-footnote"><i class="bi bi-arrow-repeat"></i><span>بعد الحفظ تُعاد قراءة قائمة الوحدات والصلاحيات في الجلسة الحالية دون إعادة تحميل المتصفح. تُسجل الحالة الجديدة في سجل التدقيق.</span></footer>
    </main>
}

