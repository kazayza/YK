@code {
    private ModulePermissionDto? permissions;
    private List<SystemModuleAdminDto> modules = new();
    private string searchText = "";
    private string statusFilter = "all";
    private bool isLoading = true;
    private bool statusIsError;
    private int? isSavingModuleId;
    private string statusMessage = "";

    private IEnumerable<SystemModuleAdminDto> FilteredModules => modules
        .Where(module => statusFilter == "all"
            || (statusFilter == "active" && module.IsActive)
            || (statusFilter == "inactive" && !module.IsActive))
        .Where(module => string.IsNullOrWhiteSpace(searchText)
            || Contains(module.ModuleNameAr, searchText)
            || Contains(module.ModuleCode, searchText)
            || Contains(module.ParentModuleName, searchText)
            || Contains(ModuleRouteHelper.GetRoute(module.ModuleCode), searchText));

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_SETTINGS");
        if (permissions?.CanView == true)
            await LoadModulesAsync();
        else
            isLoading = false;
    }

    private async Task LoadModulesAsync()
    {
        isLoading = true;
        try
        {
            modules = await ModuleAdminService.GetAllAsync();
            statusMessage = "";
            statusIsError = false;
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool CanToggle(SystemModuleAdminDto module)
    {
        if (permissions?.CanEdit != true || module.IsMainGroup || module.IsSettingsModule || module.DuplicateCodeCount != 1)
            return false;
        return module.IsActive ? module.CanDisable : module.CanEnable;
    }

    private string ToggleBlockReason(SystemModuleAdminDto module)
    {
        if (permissions?.CanEdit != true) return "لا تملك صلاحية تعديل إعدادات النظام.";
        if (module.DuplicateCodeCount != 1) return "الكود مكرر؛ عالج التكرار قبل تغيير الحالة.";
        if (!module.IsActive && module.ParentModuleID.HasValue && !module.ParentExists) return "القسم الرئيسي المرتبط غير موجود.";
        if (!module.IsActive && module.ParentModuleID.HasValue && !module.ParentIsActive) return "المجموعة الرئيسية متوقفة؛ يجب تفعيلها أولاً.";
        return module.IsActive ? "تعطيل هذه الشاشة على مستوى النظام" : "تفعيل هذه الشاشة على مستوى النظام";
    }

    private async Task ToggleModuleAsync(SystemModuleAdminDto module)
    {
        if (!CanToggle(module) || isSavingModuleId.HasValue)
            return;

        var activating = !module.IsActive;
        var action = activating ? "تفعيل" : "تعطيل";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد {action} الوحدة «{module.ModuleNameAr}»؟\n\nهذا التغيير عام على النظام ولا يغيّر صلاحيات الأدوار.");
        if (!confirmed)
            return;

        isSavingModuleId = module.ModuleID;
        statusMessage = "";
        statusIsError = false;
        try
        {
            await ModuleAdminService.SetActiveAsync(module.ModuleID, activating, UserSession.UserID);
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            modules = await ModuleAdminService.GetAllAsync();
            statusMessage = $"تم {(activating ? "تفعيل" : "تعطيل")} الوحدة «{module.ModuleNameAr}». حُدّثت قائمة التنقل وصلاحيات الجلسة الحالية.";
        }
        catch (Exception ex)
        {
            statusMessage = ex.Message;
            statusIsError = true;
        }
        finally
        {
            isSavingModuleId = null;
        }
    }

    private static bool Contains(string? value, string search) =>
        !string.IsNullOrEmpty(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);
}
