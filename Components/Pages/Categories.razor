@code {
    private List<CategoryListDto>? categories;
    private List<CategoryListDto> filteredCategories = new();
    private List<LookupDto>? parentCategories;
    private ModulePermissionDto? permissions;
    private string searchText = "";
    private int filterLevel = 0;
    private string viewMode = "table";

    private bool showFormDialog = false;
    private bool isEditMode = false;
    private CategoryEditDto editItem = new();
    private bool isSaving = false;
    private string formMessage = "";
    private bool formSuccess = true;

    private bool showDeleteDialog = false;
    private CategoryListDto? deleteCategory;
    private string deleteMessage = "";

    private string resultMessage = "";
    private bool resultSuccess = true;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn){Navigation.NavigateTo("/login");return;}
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_CATEGORIES");
        if (permissions != null && permissions.CanView) await LoadData();
    }

    private async Task LoadData()
    {
        categories = await CategoryService.GetCategoriesListAsync();
        parentCategories = await LookupService.GetParentCategoriesAsync();
        Search();
    }

    private void Search()
    {
        if (categories == null) return;
        filteredCategories = categories.Where(c =>
            (filterLevel == 0 ||
             (filterLevel == 1 && c.CategoryLevel == 1) ||
             (filterLevel == 2 && c.CategoryLevel > 1)) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(c.CategoryNameAr, searchText) ||
             ArabicSearchHelper.Contains(c.CategoryNameEn, searchText) ||
             ArabicSearchHelper.Contains(c.CategoryCode, searchText))
        ).ToList();
    }

    private void ClearSearch(){searchText="";Search();}

    private void ShowAddDialog()
    {
        isEditMode = false;
        editItem = new CategoryEditDto { SortOrder = 0 };
        formMessage = "";
        showFormDialog = true;
    }

    private void ShowEditDialog(CategoryListDto cat)
    {
        isEditMode = true;
        editItem = new CategoryEditDto
        {
            CategoryID = cat.CategoryID,
            CategoryCode = cat.CategoryCode,
            CategoryNameAr = cat.CategoryNameAr,
            CategoryNameEn = cat.CategoryNameEn,
            ParentCategoryID = cat.ParentCategoryID ?? 0,
            SortOrder = cat.SortOrder
        };
        formMessage = "";
        showFormDialog = true;
    }

    private void CloseDialog(){showFormDialog=false;formMessage="";}
    private async Task SaveCategory()
    {
        formMessage="";
        if (string.IsNullOrWhiteSpace(editItem.CategoryCode)){formMessage="يجب إدخال كود التصنيف";formSuccess=false;return;}
        if (string.IsNullOrWhiteSpace(editItem.CategoryNameAr)){formMessage="يجب إدخال اسم التصنيف بالعربي";formSuccess=false;return;}
        isSaving=true;StateHasChanged();
        try
        {
            if (isEditMode){await CategoryService.UpdateCategoryAsync(editItem, UserSession.UserID);resultMessage="تم تعديل التصنيف بنجاح ✅";}
            else{await CategoryService.InsertCategoryAsync(editItem, UserSession.UserID);resultMessage="تم إضافة التصنيف بنجاح ✅";}
            resultSuccess=true;showFormDialog=false;await LoadData();
        }catch(Exception ex){formMessage="خطأ: "+ex.Message;formSuccess=false;}
        finally{isSaving=false;}
    }

    private void ShowDeleteConfirm(CategoryListDto cat){deleteCategory=cat;deleteMessage="";showDeleteDialog=true;}
    private void CloseDeleteDialog(){showDeleteDialog=false;deleteMessage="";}
    private async Task ConfirmDelete()
    {
        if (deleteCategory==null) return;
        try
        {
            var result = await CategoryService.DeleteCategoryAsync(deleteCategory.CategoryID, UserSession.UserID);
            if (result.Success){resultMessage=result.Message+" ✅";resultSuccess=true;showDeleteDialog=false;await LoadData();}
            else{deleteMessage=result.Message;}
        }catch(Exception ex){deleteMessage="خطأ: "+ex.Message;}
    }

    private async Task ExportToExcel()
    {
        if (filteredCategories==null || !filteredCategories.Any()) return;
        isExporting=true;StateHasChanged();
        try
        {
            var fileBytes = await CategoryService.ExportCategoriesToExcelAsync(filteredCategories, UserSession.UserID);
            var base64 = Convert.ToBase64String(fileBytes);
            await JS.InvokeVoidAsync("downloadFile", $"Categories_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
        }catch(Exception ex){resultMessage="خطأ في التصدير: "+ex.Message;resultSuccess=false;}
        finally{isExporting=false;}
    }
}
