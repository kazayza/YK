@page "/categories"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject CategoryService CategoryService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>التصنيفات - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-luxury" dir="rtl">
        <div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
        <h4>يجب تسجيل الدخول أولاً</h4>
    </div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access-luxury" dir="rtl">
        <div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div>
        <h4>ليس لديك صلاحية لعرض هذه الشاشة</h4>
        <button class="btn-luxury btn-secondary-luxury" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة للرئيسية</button>
    </div>
}
else
{
    <div class="luxury-page" dir="rtl">

        <!-- HEADER HYBRID DARK GOLD -->
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text">
                        <h2 class="lh-title">التصنيفات</h2>
                        <p class="lh-subtitle">إدارة تصنيفات المواد والمنتجات</p>
                    </div>
                </div>
                <div class="lh-actions">
                    <span class="lh-badge"><span class="lh-dot"></span>@filteredCategories.Count تصنيف</span>
                    @if (permissions.CanExport)
                    {
                        <button class="btn-luxury btn-export-luxury" @onclick="ExportToExcel" disabled="@isExporting">
                            @if (isExporting){<div class="btn-spinner-sm"></div>}
                            else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>}
                            تصدير Excel
                        </button>
                    }
                    @if (permissions.CanAdd)
                    {
                        <button class="btn-luxury btn-primary-luxury" @onclick="ShowAddDialog">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                            إضافة تصنيف
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- STATS LUXURY GOLD -->
        @if (categories != null)
        {
            <div class="stats-luxury">
                <div class="stat-luxury">
                    <div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></div>
                    <div class="st-info"><span class="st-value">@categories.Count</span><span class="st-label">إجمالي التصنيفات</span></div>
                    <div class="st-gold-line"></div>
                </div>
                <div class="stat-luxury">
                    <div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></div>
                    <div class="st-info"><span class="st-value">@categories.Count(c => c.CategoryLevel == 1)</span><span class="st-label">رئيسية</span></div>
                    <div class="st-gold-line"></div>
                </div>
                <div class="stat-luxury">
                    <div class="st-icon cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
                    <div class="st-info"><span class="st-value">@categories.Count(c => c.CategoryLevel > 1)</span><span class="st-label">فرعية</span></div>
                    <div class="st-gold-line"></div>
                </div>
                <div class="stat-luxury">
                    <div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01 20.73 6.96"/><path d="M12 22.08V12"/></svg></div>
                    <div class="st-info"><span class="st-value">@categories.Sum(c => c.ItemCount)</span><span class="st-label">إجمالي الأصناف</span></div>
                    <div class="st-gold-line"></div>
                </div>
            </div>
        }

        <!-- FILTER BAR LUXURY -->
        <div class="filter-luxury">
            <div class="search-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="بحث بالاسم أو الكود..." @bind="searchText" @bind:event="oninput" @onkeyup="Search" />
                @if (!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}
            </div>
            <div class="select-wrap-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M7 12h10"/><path d="M10 18h4"/></svg>
                <select @bind="filterLevel" @bind:after="Search">
                    <option value="0">كل المستويات</option>
                    <option value="1">رئيسية فقط</option>
                    <option value="2">فرعية فقط</option>
                </select>
                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <div class="view-toggle-luxury">
                <button class="vt-btn @(viewMode=="table"?"active":"")" @onclick='() => viewMode="table"'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3h7v7H3z"/><path d="M14 3h7v7h-7z"/><path d="M3 14h7v7H3z"/><path d="M14 14h7v7h-7z"/></svg></button>
                <button class="vt-btn @(viewMode=="tree"?"active":"")" @onclick='() => viewMode="tree"'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 6h11"/><path d="M9 12h11"/><path d="M9 18h11"/><path d="M5 6v.01"/><path d="M5 12v.01"/><path d="M5 18v.01"/></svg></button>
            </div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث
            </button>
        </div>

        <!-- CONTENT -->
        @if (categories == null)
        {
            <div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل التصنيفات...</p></div>
        }
        else if (!filteredCategories.Any())
        {
            <div class="empty-luxury">
                <div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></div>
                <h4>لا توجد تصنيفات</h4><p>لا توجد نتائج مطابقة لبحثك</p>
            </div>
        }
        else
        {
            @if (viewMode == "table")
            {
                <div class="table-card-luxury">
                    <div class="table-responsive">
                        <table class="table-luxury">
                            <thead>
                                <tr>
                                    <th class="th-num">#</th>
                                    <th>الكود</th>
                                    <th>اسم التصنيف</th>
                                    <th>الإنجليزي</th>
                                    <th>الأب</th>
                                    <th class="th-center">المستوى</th>
                                    <th class="th-center">الأصناف</th>
                                    <th class="th-center">الترتيب</th>
                                    <th class="th-actions">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rowNum = 0; }
                                @foreach (var cat in filteredCategories)
                                {
                                    rowNum++;
                                    <tr class="@(cat.CategoryLevel==1?"row-parent":"row-child")">
                                        <td class="td-num">@rowNum</td>
                                        <td><span class="code-luxury">@cat.CategoryCode</span></td>
                                        <td class="td-name">
                                            <div class="cat-name-wrap">
                                                @if (cat.CategoryLevel > 1){<span class="tree-branch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 14L4 9l5-5"/><path d="M4 9h10.5A2.5 2.5 0 0 1 17 11.5v7.5"/></svg></span>}
                                                <span class="cat-icon level-@cat.CategoryLevel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></span>
                                                <strong>@cat.CategoryNameAr</strong>
                                            </div>
                                        </td>
                                        <td class="td-muted">@cat.CategoryNameEn</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(cat.ParentCategoryName)){<span class="parent-badge-luxury">@cat.ParentCategoryName</span>}
                                            else{<span class="no-val">— رئيسي</span>}
                                        </td>
                                        <td class="td-center"><span class="level-dot level-@cat.CategoryLevel">@cat.CategoryLevel</span></td>
                                        <td class="td-center">
                                            @if (cat.ItemCount > 0){<span class="count-badge-luxury">@cat.ItemCount</span>}
                                            else{<span class="no-val">0</span>}
                                        </td>
                                        <td class="td-center"><span class="sort-badge">@cat.SortOrder</span></td>
                                        <td class="td-actions">
                                            @if (permissions.CanEdit)
                                            {
                                                <button class="act-btn edit" title="تعديل" @onclick="() => ShowEditDialog(cat)">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                                </button>
                                            }
                                            @if (permissions.CanDelete)
                                            {
                                                <button class="act-btn delete" title="حذف" @onclick="() => ShowDeleteConfirm(cat)">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="tree-grid-luxury">
                    @foreach (var cat in filteredCategories.Where(c=>c.CategoryLevel==1))
                    {
                        <div class="tree-card-luxury">
                            <div class="tc-header">
                                <div class="tc-icon parent"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></div>
                                <div class="tc-info"><strong>@cat.CategoryNameAr</strong><code>@cat.CategoryCode</code></div>
                                <span class="count-badge-luxury">@cat.ItemCount صنف</span>
                            </div>
                            <div class="tc-children">
                                @{
                                    var children = filteredCategories.Where(c => c.ParentCategoryID == cat.CategoryID).ToList();
                                }
                                @if (children.Any())
                                {
                                    @foreach (var ch in children)
                                    {
                                        <div class="child-row-luxury">
                                            <span class="child-dot"></span>
                                            <span class="child-name">@ch.CategoryNameAr</span>
                                            <code>@ch.CategoryCode</code>
                                            <span class="child-count">@ch.ItemCount</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="no-children">لا توجد تصنيفات فرعية</div>
                                }
                            </div>
                            <div class="tc-actions">
                                <button class="btn-luxury btn-ghost-sm" @onclick="() => ShowEditDialog(cat)">تعديل</button>
                                <button class="btn-luxury btn-primary-sm" @onclick="() => { isEditMode=false; editItem=new CategoryEditDto{ParentCategoryID=cat.CategoryID}; showFormDialog=true; }">+ فرعي</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- MODAL ADD/EDIT LUXURY GOLD HYBRID -->
    @if (showFormDialog)
    {
        <div class="modal-overlay-luxury" @onclick="CloseDialog">
            <div class="modal-card-luxury" @onclick:stopPropagation="true">
                <div class="ml-gold-line"></div>
                <div class="ml-header">
                    <div class="ml-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></div>
                    <div class="ml-text"><h3>@(isEditMode ? "تعديل تصنيف" : "إضافة تصنيف جديد")</h3><p>@(isEditMode ? "تحديث بيانات التصنيف" : "أدخل بيانات التصنيف الجديد")</p></div>
                    <button class="ml-close" @onclick="CloseDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>
                </div>

                <div class="ml-body">
                    <div class="form-grid-luxury cols-2">
                        <div class="field-luxury">
                            <label class="fl-label required">كود التصنيف</label>
                            <div class="input-wrap-luxury">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6"/><path d="M9 15h6"/></svg>
                                <input type="text" @bind="editItem.CategoryCode" placeholder="RAW-OIL" dir="ltr" />
                            </div>
                            <span class="fl-hint">كود فريد بالإنجليزي - مثال: RAW-OIL</span>
                        </div>
                        <div class="field-luxury">
                            <label class="fl-label">الترتيب</label>
                            <div class="input-wrap-luxury">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 5h10"/><path d="M11 12h10"/><path d="M11 19h10"/><path d="M4 5v.01"/><path d="M4 12v.01"/><path d="M4 19v.01"/></svg>
                                <input type="number" @bind="editItem.SortOrder" placeholder="0" />
                            </div>
                        </div>
                    </div>

                    <div class="form-grid-luxury cols-2">
                        <div class="field-luxury">
                            <label class="fl-label required">اسم التصنيف (عربي)</label>
                            <div class="input-wrap-luxury">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                <input type="text" @bind="editItem.CategoryNameAr" placeholder="زيوت خام" />
                            </div>
                        </div>
                        <div class="field-luxury">
                            <label class="fl-label">اسم التصنيف (إنجليزي)</label>
                            <div class="input-wrap-luxury">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                <input type="text" @bind="editItem.CategoryNameEn" placeholder="Raw Oils" dir="ltr" />
                            </div>
                        </div>
                    </div>

                    <div class="field-luxury">
                        <label class="fl-label">التصنيف الأب</label>
                        <div class="select-wrap-luxury-input">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                            <select @bind="editItem.ParentCategoryID">
                                <option value="0">-- بدون (تصنيف رئيسي) --</option>
                                @if (parentCategories != null){@foreach(var p in parentCategories){<option value="@p.Id">@p.Name</option>}}
                            </select>
                            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                        </div>
                        <span class="fl-hint">اتركه فارغ ليكون تصنيف رئيسي - أو اختر أب ليكون فرعي</span>
                    </div>

                    <!-- PREVIEW CARD -->
                    <div class="preview-card-luxury">
                        <h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>معاينة التصنيف</h4>
                        <div class="pc-body">
                            <span class="code-luxury">@(string.IsNullOrWhiteSpace(editItem.CategoryCode) ? "CODE" : editItem.CategoryCode)</span>
                            <strong>@(string.IsNullOrWhiteSpace(editItem.CategoryNameAr) ? "اسم التصنيف" : editItem.CategoryNameAr)</strong>
                            <span class="pc-en">@(string.IsNullOrWhiteSpace(editItem.CategoryNameEn) ? "Category Name" : editItem.CategoryNameEn)</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(formMessage))
                    {<div class="msg-luxury @(formSuccess?"msg-success":"msg-error")">@formMessage</div>}
                </div>

                <div class="ml-footer">
                    <button class="btn-luxury btn-primary-luxury" @onclick="SaveCategory" disabled="@isSaving">
                        @if (isSaving){<div class="btn-spinner-sm"></div><span>جاري الحفظ...</span>}
                        else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H6v8"/></svg><span>@(isEditMode?"حفظ التعديلات":"حفظ التصنيف")</span>}
                    </button>
                    <button class="btn-luxury btn-ghost-luxury" @onclick="CloseDialog">إلغاء</button>
                </div>
            </div>
        </div>
    }

    <!-- DELETE MODAL LUXURY -->
    @if (showDeleteDialog)
    {
        <div class="modal-overlay-luxury" @onclick="CloseDeleteDialog">
            <div class="modal-card-luxury small" @onclick:stopPropagation="true">
                <div class="ml-gold-line danger"></div>
                <div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div>
                <h4>تأكيد الحذف</h4>
                <p>هل أنت متأكد من حذف التصنيف:</p>
                <strong class="delete-name">@deleteCategory?.CategoryNameAr</strong>
                <p class="delete-hint">سيتم إيقاف تنشيط التصنيف وليس حذفه نهائياً</p>
                @if (!string.IsNullOrEmpty(deleteMessage)){<div class="msg-luxury msg-error">@deleteMessage</div>}
                <div class="ml-footer center">
                    <button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDelete">تأكيد الحذف</button>
                    <button class="btn-luxury btn-ghost-luxury" @onclick="CloseDeleteDialog">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <div class="toast-luxury"><div class="toast-card-luxury @(resultSuccess?"success":"error")"><span>@resultMessage</span><button @onclick='() => resultMessage=""'>✕</button></div></div>
    }
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}
.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
