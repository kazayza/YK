@page "/pricelists"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PriceListService PriceListService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>قوائم الأسعار - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-luxury" dir="rtl">
        <div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
        <h4>يجب تسجيل الدخول أولاً</h4>
    </div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access-luxury" dir="rtl">
        <div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div>
        <h4>ليس لديك صلاحية لعرض قوائم الأسعار</h4>
        <button class="btn-luxury btn-ghost-luxury" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة للرئيسية</button>
    </div>
}
else
{
    <div class="luxury-page" dir="rtl">

        <!-- ===== الترويسة ===== -->
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text">
                        <h2 class="lh-title">قوائم الأسعار</h2>
                        <p class="lh-subtitle">أسعار الجملة والتجزئة — عرض بطاقات أو جدول في نفس الشاشة</p>
                    </div>
                </div>
                <div class="lh-actions">
                    <div class="view-toggle-luxury">
                        <button class="vt-btn @(viewMode == 0 ? "active" : "")" @onclick="() => viewMode = 0">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                            بطاقات
                        </button>
                        <button class="vt-btn @(viewMode == 1 ? "active" : "")" @onclick="() => viewMode = 1">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/><path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/></svg>
                            جدول
                        </button>
                    </div>
                    <span class="lh-badge"><span class="lh-dot"></span>@priceLists.Count قائمة</span>
                    @if (permissions.CanAdd)
                    {
                        <button class="btn-luxury btn-primary-luxury" @onclick="ShowAddDialog">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                            قائمة جديدة
                        </button>
                    }
                </div>
            </div>
        </div>
        @if (isLoading)
        {
            <div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل قوائم الأسعار...</p></div>
        }
        else
        {
            <!-- ===== الإحصائيات ===== -->
            <div class="stats-luxury luxury-animate">
                <div class="stat-luxury">
                    <div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2 2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg></div>
                    <div class="st-info"><span class="st-value">@priceLists.Count</span><span class="st-label">إجمالي القوائم</span></div>
                    <div class="st-gold-line"></div>
                </div>
                <div class="stat-luxury">
                    <div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m22 4-10 10.01-3-3"/></svg></div>
                    <div class="st-info"><span class="st-value">@priceLists.Count(p => p.IsDefault)</span><span class="st-label">قائمة افتراضية</span></div>
                    <div class="st-gold-line"></div>
                </div>
                <div class="stat-luxury">
                    <div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8Z"/><path d="M3.3 7 12 12l8.7-5"/><path d="M12 22V12"/></svg></div>
                    <div class="st-info"><span class="st-value">@priceLists.Sum(p => p.ItemCount)</span><span class="st-label">إجمالي الأصناف المسعّرة</span></div>
                    <div class="st-gold-line"></div>
                </div>
                <div class="stat-luxury">
                    <div class="st-icon purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41 13.42 20.59a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><path d="M7 7h.01"/></svg></div>
                    <div class="st-info"><span class="st-value">@priceLists.Select(p => p.PriceListType).Distinct().Count()</span><span class="st-label">أنواع الأسعار</span></div>
                    <div class="st-gold-line"></div>
                </div>
            </div>

            <!-- ===== البحث والفلترة ===== -->
            <div class="filter-luxury">
                <div class="search-luxury">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                    <input placeholder="بحث بالكود أو اسم القائمة..." @bind="searchText" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchText))
                    {
                        <button class="clear-search-luxury" @onclick='() => searchText = ""'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
                    }
                </div>
                <div class="select-wrap-luxury">
                    <select @bind="filterType">
                        <option value="0">كل الأنواع</option>
                        <option value="1">جملة</option>
                        <option value="2">نص جملة</option>
                        <option value="3">تجزئة</option>
                        <option value="4">خاص</option>
                    </select>
                    <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                </div>
            </div>

            @if (!filtered.Any())
            {
                <div class="empty-luxury">
                    <div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41 13.42 20.59a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><path d="M7 7h.01"/></svg></div>
                    <h4>لا توجد قوائم أسعار</h4>
                    <p class="empty-sub">ابدأ بإضافة قائمة جديدة لتعريف أسعار البيع للعملاء</p>
                </div>
            }
            else if (viewMode == 0)
            {
                <!-- ===== العرض 1: بطاقات ===== -->
                <div class="plc-grid luxury-animate">
                    @foreach (var pl in filtered)
                    {
                        <div class="plc-card @(pl.IsDefault ? "plc-default" : "") @(selectedPriceListId == pl.PriceListID ? "plc-selected" : "")"
                             @onclick="() => SelectPriceList(pl.PriceListID)">
                            <div class="plc-head">
                                <div class="plc-icon @(pl.IsDefault ? "is-default" : "")">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41 13.42 20.59a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><path d="M7 7h.01"/></svg>
                                </div>
                                <div class="plc-titles">
                                    <div class="plc-name">@pl.PriceListNameAr</div>
                                    <code class="plc-code">@pl.PriceListCode</code>
                                </div>
                                @if (pl.IsDefault)
                                {
                                    <span class="plc-default-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>افتراضي</span>
                                }
                            </div>
                            <div class="plc-meta">
                                <div class="plc-meta-row"><span class="plc-lbl">النوع</span><span class="type-pill t-@pl.PriceListType">@PriceListService.GetPriceListTypeName(pl.PriceListType)</span></div>
                                <div class="plc-meta-row"><span class="plc-lbl">العملة</span><span class="plc-val">@(pl.CurrencyName ?? "—")</span></div>
                                <div class="plc-meta-row"><span class="plc-lbl">خصم عام</span><span class="plc-val">@pl.DiscountPercent%</span></div>
                                <div class="plc-meta-row"><span class="plc-lbl">عدد الأصناف</span><span class="plc-count">@pl.ItemCount</span></div>
                            </div>
                            <div class="plc-actions">
                                <button class="act-btn view" title="عرض أسعار الأصناف" @onclick:stopPropagation="true" @onclick="() => SelectPriceList(pl.PriceListID)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                                @if (permissions.CanEdit)
                                {
                                    <button class="act-btn edit" title="تعديل" @onclick:stopPropagation="true" @onclick="() => ShowEditDialog(pl.PriceListID)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5Z"/></svg>
                                    </button>
                                }
                                @if (permissions.CanDelete)
                                {
                                    <button class="act-btn del" title="حذف" @onclick:stopPropagation="true" @onclick="() => ShowDeleteConfirm(pl)">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- ===== العرض 2: جدول (طريقة جديدة) ===== -->
                <div class="table-card-luxury">
                    <div class="card-head-luxury">
                        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/></svg>كل قوائم الأسعار</h3>
                        <span class="lh-badge"><span class="lh-dot"></span>@filtered.Count() نتيجة</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table-luxury">
                            <thead>
                                <tr>
                                    <th class="th-num">#</th>
                                    <th>الكود</th>
                                    <th>اسم القائمة</th>
                                    <th>النوع</th>
                                    <th>العملة</th>
                                    <th class="th-num">خصم %</th>
                                    <th class="th-num">الأصناف</th>
                                    <th>الحالة</th>
                                    <th class="th-actions">إجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ var rIdx = 0; }
                                @foreach (var pl in filtered)
                                {
                                    rIdx++;
                                    <tr class="@(selectedPriceListId == pl.PriceListID ? "row-selected" : "")" @onclick="() => SelectPriceList(pl.PriceListID)">
                                        <td class="td-num">@rIdx</td>
                                        <td><code class="doc-num-luxury">@pl.PriceListCode</code></td>
                                        <td>
                                            <div class="acc-cell">
                                                <div class="acc-icon t-@pl.PriceListType"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41 13.42 20.59a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><path d="M7 7h.01"/></svg></div>
                                                <div class="acc-info">
                                                    <span class="acc-name">@pl.PriceListNameAr</span>
                                                    <span class="acc-name-en">@(string.IsNullOrWhiteSpace(pl.PriceListNameEn) ? "—" : pl.PriceListNameEn)</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="type-pill t-@pl.PriceListType">@PriceListService.GetPriceListTypeName(pl.PriceListType)</span></td>
                                        <td class="td-muted">@(pl.CurrencyName ?? "—")</td>
                                        <td class="td-center"><b>@pl.DiscountPercent%</b></td>
                                        <td class="td-center"><span class="plc-count">@pl.ItemCount</span></td>
                                        <td>
                                            @if (pl.IsDefault)
                                            {
                                                <span class="type-pill t-def"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>افتراضي</span>
                                            }
                                            else
                                            {
                                                <span class="type-pill t-on">نشطة</span>
                                            }
                                        </td>
                                        <td class="td-center">
                                            <div class="actions-wrap-luxury">
                                                <button class="act-btn view" title="عرض أسعار الأصناف" @onclick:stopPropagation="true" @onclick="() => SelectPriceList(pl.PriceListID)">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z"/><circle cx="12" cy="12" r="3"/></svg>
                                                </button>
                                                @if (permissions.CanEdit)
                                                {
                                                    <button class="act-btn edit" title="تعديل" @onclick:stopPropagation="true" @onclick="() => ShowEditDialog(pl.PriceListID)">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5Z"/></svg>
                                                    </button>
                                                }
                                                @if (permissions.CanDelete)
                                                {
                                                    <button class="act-btn del" title="حذف" @onclick:stopPropagation="true" @onclick="() => ShowDeleteConfirm(pl)">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            <!-- ===== أسعار أصناف القائمة المختارة (تظهر في كلا العرضين) ===== -->
            @if (selectedPriceListId != 0 && details != null)
            {
                var selectedList = priceLists.FirstOrDefault(x => x.PriceListID == selectedPriceListId);
                <div class="table-card-luxury">
                    <div class="card-head-luxury">
                        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.59 13.41 13.42 20.59a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82Z"/><path d="M7 7h.01"/></svg>أسعار أصناف — @(selectedList?.PriceListNameAr ?? "")</h3>
                        <div class="head-actions">
                            @if (permissions.CanAdd)
                            {
                                <button class="btn-luxury btn-primary-luxury" @onclick="ShowAddDetailDialog">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                                    سعر صنف جديد
                                </button>
                            }
                            <button class="btn-luxury btn-ghost-luxury" @onclick="CloseDetails">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                إغلاق
                            </button>
                        </div>
                    </div>
                    @if (!details.Any())
                    {
                        <div class="empty-luxury inline">
                            <div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8Z"/><path d="M3.3 7 12 12l8.7-5"/><path d="M12 22V12"/></svg></div>
                            <p class="empty-sub">لا توجد أسعار أصناف في هذه القائمة بعد</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table-luxury">
                                <thead>
                                    <tr>
                                        <th class="th-num">#</th>
                                        <th>الصنف</th>
                                        <th>الوحدة</th>
                                        <th class="th-num">السعر</th>
                                        <th class="th-num">أقل كمية</th>
                                        <th class="th-num">خصم %</th>
                                        <th class="th-num">أقل سعر بيع</th>
                                        <th class="th-actions">إجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ var dIdx = 0; }
                                    @foreach (var d in details)
                                    {
                                        dIdx++;
                                        <tr>
                                            <td class="td-num">@dIdx</td>
                                            <td>
                                                <b>@d.ItemNameAr</b>
                                                <code class="doc-num-luxury" style="margin-right:6px;font-size:.7rem">@d.ItemCode</code>
                                            </td>
                                            <td class="td-muted">@d.UnitName</td>
                                            <td class="td-center"><span class="amount-luxury">@d.UnitPrice.ToString("N2")</span></td>
                                            <td class="td-center">@d.MinQty</td>
                                            <td class="td-center">@d.DiscountPercent%</td>
                                            <td class="td-center">@(d.MinSellingPrice > 0 ? d.MinSellingPrice.ToString("N2") : "—")</td>
                                            <td class="td-center">
                                                <div class="actions-wrap-luxury">
                                                    @if (permissions.CanEdit)
                                                    {
                                                        <button class="act-btn edit" title="تعديل" @onclick="() => ShowEditDetailDialog(d)">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5Z"/></svg>
                                                        </button>
                                                    }
                                                    @if (permissions.CanDelete)
                                                    {
                                                        <button class="act-btn del" title="حذف" @onclick="() => DeleteDetail(d.PriceDetailID)">
                                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg>
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        }

        <!-- ===== توست النتائج ===== -->
        @if (!string.IsNullOrEmpty(resultMessage))
        {
            <div class="toast-luxury">
                <div class="toast-card-luxury @(resultSuccess ? "success" : "error")">
                    @if (resultSuccess)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m22 4-10 10.01-3-3"/></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                    }
                    <span>@resultMessage</span>
                    <button @onclick='() => resultMessage = ""'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
                </div>
            </div>
        }
        <!-- ===== مودال إضافة/تعديل قائمة ===== -->
        @if (showFormDialog)
        {
            <div class="modal-overlay-luxury" @onclick="CloseDialog">
                <div class="modal-card-luxury large" @onclick:stopPropagation="true">
                    <div class="ml-gold-line"></div>
                    <div class="ml-header">
                        <h3>@(isEditMode ? "تعديل قائمة أسعار" : "إضافة قائمة أسعار")</h3>
                        <button class="btn-close-x" @onclick="CloseDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
                    </div>
                    <div class="ml-body">
                        <div class="form-grid-luxury">
                            <div class="fg">
                                <label>كود القائمة <span class="req">*</span></label>
                                <input @bind="editItem.PriceListCode" placeholder="مثال: PL-001" />
                            </div>
                            <div class="fg">
                                <label>الاسم بالعربية <span class="req">*</span></label>
                                <input @bind="editItem.PriceListNameAr" placeholder="مثال: قائمة الجملة" />
                            </div>
                            <div class="fg">
                                <label>الاسم بالإنجليزية</label>
                                <input @bind="editItem.PriceListNameEn" placeholder="Wholesale List" />
                            </div>
                            <div class="fg">
                                <label>نوع القائمة <span class="req">*</span></label>
                                <select @bind="editItem.PriceListType">
                                    <option value="0">-- اختر النوع --</option>
                                    <option value="1">جملة</option>
                                    <option value="2">نص جملة</option>
                                    <option value="3">تجزئة</option>
                                    <option value="4">خاص</option>
                                </select>
                            </div>
                            <div class="fg">
                                <label>العملة</label>
                                <select @bind="editItem.CurrencyID">
                                    <option value="0">-- اختر العملة --</option>
                                    @if (currencies != null)
                                    {
                                        @foreach (var c in currencies)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="fg">
                                <label>خصم عام %</label>
                                <input type="number" @bind="editItem.DiscountPercent" step="0.01" min="0" max="100" />
                            </div>
                            <div class="fg full">
                                <label>ملاحظات</label>
                                <textarea rows="2" @bind="editItem.Notes" placeholder="ملاحظات اختيارية..."></textarea>
                            </div>
                            <div class="fg full switches-row">
                                <label class="chk-lab"><span class="switch-luxury"><input type="checkbox" @bind="editItem.IsActive" /><span></span></span>نشط</label>
                                <label class="chk-lab"><span class="switch-luxury"><input type="checkbox" @bind="editItem.IsDefault" /><span></span></span>قائمة افتراضية</label>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(formMessage))
                        {
                            <div class="msg-luxury @(formSuccess ? "msg-success" : "msg-error")">@formMessage</div>
                        }
                    </div>
                    <div class="ml-footer">
                        <button class="btn-luxury btn-primary-luxury" @onclick="SavePriceList" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <div class="btn-spinner-sm"></div><span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
                                <span>@(isEditMode ? "حفظ التعديلات" : "حفظ")</span>
                            }
                        </button>
                        <button class="btn-luxury btn-ghost-luxury" @onclick="CloseDialog">إلغاء</button>
                    </div>
                </div>
            </div>
        }
        <!-- ===== مودال إضافة/تعديل سعر صنف ===== -->
        @if (showDetailDialog)
        {
            <div class="modal-overlay-luxury" @onclick="CloseDetailDialog">
                <div class="modal-card-luxury large" @onclick:stopPropagation="true">
                    <div class="ml-gold-line"></div>
                    <div class="ml-header">
                        <h3>@(isEditDetail ? "تعديل سعر صنف" : "إضافة سعر صنف")</h3>
                        <button class="btn-close-x" @onclick="CloseDetailDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
                    </div>
                    <div class="ml-body">
                        <div class="form-grid-luxury">
                            <div class="fg">
                                <label>الصنف <span class="req">*</span></label>
                                <select @bind="editDetail.ItemID" disabled="@isEditDetail">
                                    <option value="0">-- اختر الصنف --</option>
                                    @if (finishedItems != null)
                                    {
                                        @foreach (var item in finishedItems)
                                        {
                                            <option value="@item.Id">@item.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="fg">
                                <label>الوحدة <span class="req">*</span></label>
                                <select @bind="editDetail.UnitID">
                                    <option value="0">-- اختر الوحدة --</option>
                                    @if (unitsList != null)
                                    {
                                        @foreach (var u in unitsList)
                                        {
                                            <option value="@u.Id">@u.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="fg">
                                <label>السعر <span class="req">*</span></label>
                                <input type="number" @bind="editDetail.UnitPrice" step="0.01" min="0" />
                            </div>
                            <div class="fg">
                                <label>أقل كمية</label>
                                <input type="number" @bind="editDetail.MinQty" step="0.01" min="0" />
                            </div>
                            <div class="fg">
                                <label>خصم %</label>
                                <input type="number" @bind="editDetail.DiscountPercent" step="0.01" min="0" max="100" />
                            </div>
                            <div class="fg">
                                <label>أقل سعر بيع</label>
                                <input type="number" @bind="editDetail.MinSellingPrice" step="0.01" min="0" />
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(detailMessage))
                        {
                            <div class="msg-luxury @(detailSuccess ? "msg-success" : "msg-error")">@detailMessage</div>
                        }
                    </div>
                    <div class="ml-footer">
                        <button class="btn-luxury btn-primary-luxury" @onclick="SaveDetail" disabled="@isSavingDetail">
                            @if (isSavingDetail)
                            {
                                <div class="btn-spinner-sm"></div><span>جاري الحفظ...</span>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8"/><path d="M7 3v5h8"/></svg>
                                <span>حفظ</span>
                            }
                        </button>
                        <button class="btn-luxury btn-ghost-luxury" @onclick="CloseDetailDialog">إلغاء</button>
                    </div>
                </div>
            </div>
        }
        <!-- ===== مودال تأكيد الحذف ===== -->
        @if (showDeleteDialog)
        {
            <div class="modal-overlay-luxury" @onclick="CloseDeleteDialog">
                <div class="modal-card-luxury" @onclick:stopPropagation="true">
                    <div class="ml-gold-line"></div>
                    <div class="ml-header">
                        <h3>تأكيد الحذف</h3>
                        <button class="btn-close-x" @onclick="CloseDeleteDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg></button>
                    </div>
                    <div class="ml-body">
                        <div class="del-confirm">
                            <div class="del-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg></div>
                            <p>هل أنت متأكد من حذف القائمة <b>@deletePriceList?.PriceListNameAr</b>؟</p>
                            @if (!string.IsNullOrEmpty(deleteMessage))
                            {
                                <div class="msg-luxury msg-error">@deleteMessage</div>
                            }
                        </div>
                    </div>
                    <div class="ml-footer">
                        <button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDelete">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
                            تأكيد الحذف
                        </button>
                        <button class="btn-luxury btn-ghost-luxury" @onclick="CloseDeleteDialog">إلغاء</button>
                    </div>
                </div>
            </div>
        }

    </div>
}

