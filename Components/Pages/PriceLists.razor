.th-num{width:45px;text-align:center}.th-actions{text-align:center;width:110px}.td-num{text-align:center;color:#9ca3af;font-size:.78rem}.td-center{text-align:center}.td-muted{color:#6b7280;font-size:.82rem}
.doc-num-luxury{color:var(--gold-dark);font-weight:800;font-size:.8rem;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:8px;white-space:nowrap}
.acc-cell{display:flex;align-items:center;gap:10px}.acc-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid}.acc-icon svg{width:16px;height:16px}.acc-info{display:flex;flex-direction:column}.acc-name{font-weight:800;color:#0A0F1E;font-size:.86rem}.acc-name-en{font-weight:600;color:#8B95A5;font-size:.72rem}
.amount-luxury{font-family:monospace;font-weight:800;color:#0A0F1E;background:#f8f6f0;padding:4px 10px;border-radius:8px;border:1px solid #e8e2d0;white-space:nowrap}
.actions-wrap-luxury{display:flex;gap:4px;justify-content:center}.act-btn{width:30px;height:30px;border-radius:9px;border:1.5px solid;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;background:#fff;transition:.2s}.act-btn:hover{transform:translateY(-1px)}.act-btn.view{color:#0891b2;border-color:#a5f3fc}.act-btn.view:hover{background:#ecfeff}.act-btn.add{color:#059669;border-color:#a7f3d0}.act-btn.edit{color:var(--gold-dark);border-color:rgba(212,175,55,.2)}.act-btn.edit:hover{background:#fffbef}.act-btn.del{color:#dc2626;border-color:#fecaca}.act-btn.del:hover{background:#fef2f2}.act-btn svg{width:13px;height:13px}
