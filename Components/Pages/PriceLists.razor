.modal-card-luxury{position:relative;background:#fff;border-radius:20px;width:100%;max-width:520px;overflow:hidden;box-shadow:0 24px 48px rgba(0,0,0,.2);animation:modalInX .3s ease;border:1px solid #e8e2d0;max-height:90vh;display:flex;flex-direction:column}.modal-card-luxury.large{max-width:640px}
.ml-gold-line{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent);z-index:2}
.ml-header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8}.ml-header h3{margin:0;font-size:.95rem;font-weight:800;color:#0A0F1E}
.btn-close-x{width:28px;height:28px;border-radius:8px;border:1px solid #e8e2d0;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.btn-close-x svg{width:12px;height:12px}
.ml-body{padding:20px;overflow-y:auto;flex:1}.form-grid-luxury{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form-grid-luxury .fg.full{grid-column:1/-1}.fg label{font-size:.78rem;font-weight:700;color:#374151;margin-bottom:6px;display:block}.fg .req{color:#dc2626}.fg input,.fg select,.fg textarea{width:100%;height:40px;padding:0 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.84rem;font-family:'Tajawal';outline:none;background:#fcfaf6;transition:.2s}.fg textarea{height:auto;padding:10px 12px;resize:vertical}.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.08)}.fg input:disabled,.fg select:disabled{opacity:.55;cursor:not-allowed}
.switches-row{display:flex;gap:22px;flex-wrap:wrap}.chk-lab{display:flex;align-items:center;gap:8px;font-size:.82rem;font-weight:700;color:#374151;cursor:pointer;margin:0!important}
.switch-luxury{position:relative;display:inline-block;width:42px;height:22px;flex-shrink:0}.switch-luxury input{position:absolute;opacity:0;width:0;height:0}.switch-luxury span{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#e5e7eb;border-radius:999px;transition:.2s}.switch-luxury span:before{position:absolute;content:"";height:18px;width:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.15)}.switch-luxury input:checked+span{background:var(--gold)}.switch-luxury input:checked+span:before{transform:translateX(20px)}
.ml-footer{display:flex;gap:8px;padding:14px 20px;border-top:1px solid #f1efe8;background:#fcfaf6;justify-content:flex-end}
.msg-luxury{padding:10px 14px;border-radius:12px;font-size:.82rem;font-weight:600;margin-top:12px}.msg-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}.msg-success{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}
.del-confirm{text-align:center;padding:8px 4px}.del-icon{width:60px;height:60px;margin:0 auto 14px;border-radius:16px;background:#fef2f2;border:1px solid #fecaca;color:#dc2626;display:flex;align-items:center;justify-content:center}.del-icon svg{width:28px;height:28px}.del-confirm p{color:#374151;font-size:.9rem;line-height:1.7;margin:0}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spinX .7s linear infinite;margin:0 auto 12px}
.empty-luxury{text-align:center;padding:60px 20px;background:#fff;border-radius:18px;border:1px solid #e8e2d0}.empty-luxury.inline{padding:36px 20px;border:none;background:transparent}.empty-icon-luxury{width:56px;height:56px;margin:0 auto 12px;border-radius:14px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.empty-icon-luxury svg{width:28px;height:28px}.empty-sub{color:#9ca3af;font-size:.82rem;margin-top:6px}.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}
.toast-luxury{position:fixed;bottom:20px;left:20px;z-index:1050;animation:toastInX .35s ease}.toast-card-luxury{display:flex;align-items:center;gap:10px;padding:12px 18px;border-radius:14px;min-width:280px;font-weight:600;font-size:.84rem;box-shadow:0 12px 32px rgba(0,0,0,.12)}.toast-card-luxury.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.toast-card-luxury.error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.toast-card-luxury button{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-right:auto;display:flex}.toast-card-luxury button svg{width:12px;height:12px}
@@keyframes modalInX{from{opacity:0;transform:scale(.96) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}@@keyframes toastInX{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
</style>

@code {
    private ModulePermissionDto? permissions;
    private List<PriceListHeaderDto> priceLists = new();
    private bool isLoading = true;
    private string searchText = "";
    private int filterType = 0;
    private int viewMode = 0; // 0 = بطاقات (الطريقة الحالية) · 1 = جدول (طريقة جديدة)

    private int selectedPriceListId = 0;
    private List<PriceListDetailDto>? details;

    private bool showFormDialog = false;
    private bool isEditMode = false;
    private PriceListEditDto editItem = new();
    private bool isSaving = false;
    private string formMessage = "";
    private bool formSuccess = true;

    private List<LookupDto>? currencies;
    private List<LookupDto>? finishedItems;
    private List<LookupDto>? unitsList;

    private bool showDetailDialog = false;
    private bool isEditDetail = false;
    private PriceListDetailEditDto editDetail = new();
    private bool isSavingDetail = false;
    private string detailMessage = "";
    private bool detailSuccess = true;

    private bool showDeleteDialog = false;
    private PriceListHeaderDto? deletePriceList;
    private string deleteMessage = "";

    private string resultMessage = "";
    private bool resultSuccess = true;
    private IEnumerable<PriceListHeaderDto> filtered
    {
        get
        {
            var q = priceLists.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(searchText))
                q = q.Where(p => ArabicSearchHelper.Contains(p.PriceListCode, searchText)
                              || ArabicSearchHelper.Contains(p.PriceListNameAr, searchText)
                              || ArabicSearchHelper.Contains(p.PriceListNameEn, searchText));
            if (filterType > 0)
                q = q.Where(p => p.PriceListType == filterType);
            return q.OrderBy(p => p.PriceListType).ThenBy(p => p.PriceListNameAr);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_PRICELISTS");
        if (permissions != null && permissions.CanView) await LoadData();
    }

    private async Task LoadData()
    {
        priceLists = await PriceListService.GetPriceListsAsync();
        currencies = await LookupService.GetCurrenciesAsync();
        finishedItems = await PriceListService.GetFinishedItemsAsync();
        unitsList = await LookupService.GetUnitsAsync();
        isLoading = false;
    }

    private async Task SelectPriceList(int priceListId)
    {
        if (selectedPriceListId == priceListId)
        {
            selectedPriceListId = 0;
            details = null;
            return;
        }
        selectedPriceListId = priceListId;
        details = await PriceListService.GetPriceListDetailsAsync(priceListId);
    }

    private void CloseDetails()
    {
        selectedPriceListId = 0;
        details = null;
    }

    // ===== القائمة =====
    private void ShowAddDialog()
    { isEditMode = false; editItem = new PriceListEditDto(); formMessage = ""; showFormDialog = true; }

    private async Task ShowEditDialog(int id)
    {
        var loaded = await PriceListService.GetPriceListByIdAsync(id);
        if (loaded != null) { isEditMode = true; editItem = loaded; formMessage = ""; showFormDialog = true; }
    }

    private void CloseDialog() { showFormDialog = false; }

    private async Task SavePriceList()
    {
        formMessage = "";
        if (string.IsNullOrWhiteSpace(editItem.PriceListCode)) { formMessage = "يجب إدخال الكود"; formSuccess = false; return; }
        if (string.IsNullOrWhiteSpace(editItem.PriceListNameAr)) { formMessage = "يجب إدخال الاسم"; formSuccess = false; return; }
        if (editItem.PriceListType == 0) { formMessage = "يجب اختيار النوع"; formSuccess = false; return; }

        isSaving = true; StateHasChanged();
        try
        {
            if (isEditMode) { await PriceListService.UpdatePriceListAsync(editItem, UserSession.UserID); resultMessage = "تم تعديل القائمة بنجاح"; }
            else { await PriceListService.InsertPriceListAsync(editItem, UserSession.UserID); resultMessage = "تم إضافة القائمة بنجاح"; }
            resultSuccess = true; showFormDialog = false; await LoadData();
        }
        catch (Exception ex) { formMessage = "خطأ: " + ex.Message; formSuccess = false; }
        finally { isSaving = false; }
    }
    // ===== التفاصيل =====
    private void ShowAddDetailDialog()
    { isEditDetail = false; editDetail = new PriceListDetailEditDto { PriceListID = selectedPriceListId, MinQty = 1 }; detailMessage = ""; showDetailDialog = true; }

    private void ShowEditDetailDialog(PriceListDetailDto d)
    {
        isEditDetail = true;
        editDetail = new PriceListDetailEditDto
        {
            PriceDetailID = d.PriceDetailID,
            PriceListID = d.PriceListID,
            ItemID = d.ItemID,
            UnitID = d.UnitID,
            UnitPrice = d.UnitPrice,
            MinQty = d.MinQty,
            DiscountPercent = d.DiscountPercent,
            MinSellingPrice = d.MinSellingPrice
        };
        detailMessage = "";
        showDetailDialog = true;
    }

    private void CloseDetailDialog() { showDetailDialog = false; }

    private async Task SaveDetail()
    {
        detailMessage = "";
        if (editDetail.ItemID == 0) { detailMessage = "اختر الصنف"; detailSuccess = false; return; }
        if (editDetail.UnitID == 0) { detailMessage = "اختر الوحدة"; detailSuccess = false; return; }
        if (editDetail.UnitPrice <= 0) { detailMessage = "أدخل السعر"; detailSuccess = false; return; }

        isSavingDetail = true; StateHasChanged();
        try
        {
            if (isEditDetail) await PriceListService.UpdatePriceDetailAsync(editDetail, UserSession.UserID);
            else await PriceListService.InsertPriceDetailAsync(editDetail, UserSession.UserID);
            resultMessage = "تم حفظ سعر الصنف بنجاح"; resultSuccess = true;
            showDetailDialog = false;
            details = await PriceListService.GetPriceListDetailsAsync(selectedPriceListId);
            await LoadData();
        }
        catch (Exception ex) { detailMessage = "خطأ: " + ex.Message; detailSuccess = false; }
        finally { isSavingDetail = false; }
    }

    private async Task DeleteDetail(int detailId)
    {
        await PriceListService.DeletePriceDetailAsync(detailId, UserSession.UserID);
        resultMessage = "تم حذف السعر بنجاح"; resultSuccess = true;
        details = await PriceListService.GetPriceListDetailsAsync(selectedPriceListId);
        await LoadData();
    }

    // ===== حذف القائمة =====
    private void ShowDeleteConfirm(PriceListHeaderDto pl) { deletePriceList = pl; deleteMessage = ""; showDeleteDialog = true; }
    private void CloseDeleteDialog() { showDeleteDialog = false; }

    private async Task ConfirmDelete()
    {
        if (deletePriceList == null) return;
        try
        {
            var result = await PriceListService.DeletePriceListAsync(deletePriceList.PriceListID, UserSession.UserID);
            if (result.Success)
            {
                resultMessage = result.Message; resultSuccess = true; showDeleteDialog = false;
                selectedPriceListId = 0; details = null; await LoadData();
            }
            else { deleteMessage = result.Message; }
        }
        catch (Exception ex) { deleteMessage = "خطأ: " + ex.Message; }
    }
}















