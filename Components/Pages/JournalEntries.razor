@page "/journal-entries"
@using YKCoatings.Services
@using YKCoatings.Models
@inject AccountingService AccountingService
@inject UserSessionService UserSession
@inject NavigationManager Navigation

<PageTitle>القيود المحاسبية - Gold Edition Pro</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><h4>يجب تسجيل الدخول</h4></div>}
else
{
<div class="luxury-page" dir="rtl">
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-content">
            <div class="lh-right">
                <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                <div class="lh-text">
                    <h2 class="lh-title">القيود المحاسبية</h2>
                    <p class="lh-subtitle"></p>
                </div>
            </div>
            <div class="lh-actions">
                <span class="lh-badge"><span class="lh-dot"></span>@(filtered.Count) قيد</span>
                <span class="lh-badge" style="background:rgba(16,185,129,.1);color:#059669;border-color:rgba(16,185,129,.15)">مرحل: @(filtered.Count(j=>j.JournalStatus==2))</span>
                <span class="lh-badge" style="background:rgba(212,175,55,.1);color:var(--gold-dark);border-color:rgba(212,175,55,.15)">مدين: @(filtered.Sum(j=>j.TotalDebit).ToString("#,##0"))</span>
                <button class="btn-luxury btn-primary-luxury" @onclick='() => Navigation.NavigateTo("/journal-entries/new")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>قيد جديد</button>
            </div>
        </div>
    </div>

    @if (isLoading)
    {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل القيود...</p></div>}
    else
    {
        <div class="stats-luxury">
            <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></div><div class="st-info"><span class="st-value">@allJournals.Count</span><span class="st-label">إجمالي القيود</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><div class="st-info"><span class="st-value">@allJournals.Count(j=>j.JournalStatus==1)</span><span class="st-label">مسودة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg></div><div class="st-info"><span class="st-value">@allJournals.Count(j=>j.JournalStatus==2)</span><span class="st-label">مرحلة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@allJournals.Where(j=>j.IsAutoGenerated).Count()</span><span class="st-label">أوتوماتيك</span></div><div class="st-gold-line"></div></div>
        </div>

        <div class="filter-luxury">
            <div class="search-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="بحث برقم القيد، البيان، المصدر..." @bind="searchText" @bind:event="oninput" @onkeyup="ApplyFilter" />
                @if(!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}
            </div>
            <div class="select-wrap-luxury"><select @bind="filterStatus" @bind:after="ApplyFilter"><option value="0">كل الحالات</option><option value="1">مسودة</option><option value="2">مرحل</option><option value="3">ملغي</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><select @bind="filterAuto" @bind:after="ApplyFilter"><option value="0">الكل</option><option value="1">يدوي</option><option value="2">أوتوماتيك</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><input type="date" @bind="filterFrom" @bind:after="ApplyFilter" style="height:42px;border:1.5px solid #e8e2d0;border-radius:12px;padding:0 12px;font-family:'Tajawal';font-size:.82rem" /></div>
            <div class="select-wrap-luxury"><input type="date" @bind="filterTo" @bind:after="ApplyFilter" style="height:42px;border:1.5px solid #e8e2d0;border-radius:12px;padding:0 12px;font-family:'Tajawal';font-size:.82rem" /></div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        <div class="table-card-luxury">
            <div class="card-head-luxury">
                <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>القيود المحاسبية — @filtered.Count قيد</h3>
                <div style="display:flex;gap:8px;align-items:center"><span class="legend-dot" style="--c:#10b981"></span><span style="font-size:.7rem;color:#6b7280;font-weight:700">مرحل</span><span class="legend-dot" style="--c:#6b7280"></span><span style="font-size:.7rem;color:#6b7280;font-weight:700">مسودة</span></div>
            </div>
            <div class="table-responsive">
                <table class="table-luxury detailed">
                    <thead>
                        <tr>
                            <th class="th-num">#</th>
                            <th>رقم القيد</th>
                            <th>التاريخ</th>
                            <th>البيان / المرجع</th>
                            <th>المصدر</th>
                            <th>إجمالي مدين</th>
                            <th>إجمالي دائن</th>
                            <th>عدد الأسطر</th>
                            <th>الحالة</th>
                            <th>النوع</th>
                            <th>المنشئ</th>
                            <th class="th-actions">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{int n=0;}
                        @foreach(var j in filtered.OrderByDescending(j=>j.JournalDate)){n++;
                            <tr @key="j.JournalID" class="@(j.JournalStatus==1?"":"")">
                                <td class="td-num">@n</td>
                                <td><span class="doc-num-luxury">@j.JournalNumber</span></td>
                                <td><span class="level-badge">@j.JournalDate.ToString("dd/MM/yyyy")</span></td>
                                <td>
                                    <div class="acc-cell">
                                        <div class="acc-icon type-@(j.IsAutoGenerated?2:1)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div>
                                        <div class="acc-info"><span class="acc-name" style="max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block">@(j.Description ?? "—")</span><span class="acc-name-en">@(j.Reference ?? "")</span></div>
                                    </div>
                                </td>
                                <td>
                                    @if(!string.IsNullOrEmpty(j.SourceDocType)){
                                        <div style="display:flex;flex-direction:column;gap:2px">
                                            <span class="coa-type type-1">@GetSourceNameAr(j.SourceDocType)</span>
                                            <span style="font-family:monospace;font-size:.7rem;color:#6b7280">@j.SourceDocNumber</span>
                                            <span style="font-size:.65rem;color:#9ca3af">@j.SourceDocType</span>
                                        </div>
                                    }else{<span class="td-muted">— يدوي —</span>}
                                </td>
                                <td><span class="amount-luxury">@j.TotalDebit.ToString("#,##0.00")</span></td>
                                <td><span class="amount-luxury">@j.TotalCredit.ToString("#,##0.00")</span></td>
                                <td><span class="level-badge">@j.DetailsCount سطر</span></td>
                                <td>
                                    @if(j.JournalStatus==1){<span class="status-badge-luxury" style="--sc:#6b7280"><span class="status-dot" style="--sc:#6b7280"></span>مسودة</span>}
                                    else if(j.JournalStatus==2){<span class="status-badge-luxury" style="--sc:#10b981"><span class="status-dot" style="--sc:#10b981"></span>مرحل</span>}
                                    else{<span class="status-badge-luxury" style="--sc:#dc2626"><span class="status-dot" style="--sc:#dc2626"></span>ملغي</span>}
                                </td>
                                <td>@if(j.IsAutoGenerated){<span class="coa-detail group">أوتوماتيك</span>}else{<span class="coa-detail detail">يدوي</span>}</td>
                                <td class="td-muted">@(j.CreatedByName ?? "—")<br/><span style="font-size:.68rem">@j.CreatedDate.ToString("dd/MM HH:mm")</span></td>
                                <td class="td-center"><div class="actions-wrap-luxury">
                                    <button class="act-btn add" title="عرض" @onclick="()=>ViewJournal(j.JournalID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
                                    @if(j.JournalStatus==1){
                                        <button class="act-btn edit" title="تعديل" @onclick='()=>Navigation.NavigateTo($"/journal-entries/edit/{j.JournalID}")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
                                        <button class="act-btn" style="color:#10b981;border-color:#a7f3d0" title="ترحيل" @onclick="()=>PostJournal(j.JournalID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg></button>
                                    }
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (showDetail && selectedJournal!=null)
{
    <div class="modal-overlay-luxury" @onclick="()=>showDetail=false"><div class="modal-card-luxury large" style="max-width:800px" @onclick:stopPropagation="true">
        <div class="ml-gold-line"></div>
        <div class="ml-header"><h3>قيد @selectedJournal.JournalNumber — @selectedJournal.JournalDate.ToString("dd/MM/yyyy")</h3><button class="btn-close-x" @onclick="()=>showDetail=false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
        <div class="ml-body">
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px">
                <span class="doc-num-luxury">@selectedJournal.JournalNumber</span>
                <span class="level-badge">@selectedJournal.JournalDate.ToString("dd/MM/yyyy")</span>
                @if(selectedJournal.JournalStatus==1){<span class="status-badge-luxury" style="--sc:#6b7280"><span class="status-dot" style="--sc:#6b7280"></span>مسودة</span>}else{<span class="status-badge-luxury" style="--sc:#10b981"><span class="status-dot" style="--sc:#10b981"></span>مرحل</span>}
                @if(selectedJournal.IsAutoGenerated){<span class="coa-detail group">أوتوماتيك — @selectedJournal.SourceDocType @selectedJournal.SourceDocNumber</span>}
            </div>
            <p style="color:#374151;font-size:.86rem;margin-bottom:16px">@selectedJournal.Description</p>
            <div class="table-responsive">
                <table class="table-luxury">
                    <thead><tr><th>#</th><th>الحساب</th><th>البيان</th><th>مدين</th><th>دائن</th><th>مركز تكلفة</th></tr></thead>
                    <tbody>
                        @foreach(var d in selectedJournal.Details.OrderBy(x=>x.LineNumber))
                        {
                            <tr><td class="td-num">@d.LineNumber</td><td><span class="doc-num-luxury" style="font-size:.74rem">@d.AccountCode</span><br/><span style="font-weight:700;font-size:.82rem">@d.AccountNameAr</span></td><td class="td-muted">@d.Description</td><td><span class="amount-luxury">@(d.DebitAmount>0?d.DebitAmount.ToString("#,##0.00"):"—")</span></td><td><span class="amount-luxury">@(d.CreditAmount>0?d.CreditAmount.ToString("#,##0.00"):"—")</span></td><td class="td-muted">@(d.CostCenterNameAr ?? "—")</td></tr>
                        }
                        <tr style="background:#fcfaf6;font-weight:800"><td></td><td colspan="2" style="text-align:left">الإجمالي</td><td><span class="amount-luxury">@selectedJournal.TotalDebit.ToString("#,##0.00")</span></td><td><span class="amount-luxury">@selectedJournal.TotalCredit.ToString("#,##0.00")</span></td><td></td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="ml-footer"><button class="btn-luxury btn-ghost-luxury" @onclick="()=>showDetail=false">إغلاق</button></div>
    </div></div>
}

@if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='()=>toast=""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,#121A2E 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain}
.lh-title{font-size:1.25rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.72rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:.2s;font-family:'Tajawal'}.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-luxury svg{width:14px;height:14px}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
.st-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.2)}.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.st-icon.purple{background:#f5f3ff;color:#7c3aed;border:1px solid #ddd6fe}.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.st-icon svg{width:18px;height:18px}.st-info{display:flex;flex-direction:column}.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}.st-gold-line{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}.stat-luxury:hover .st-gold-line{opacity:.8}
.filter-luxury{display:flex;gap:10px;flex-wrap:wrap;align-items:center;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:12px}
.search-luxury{flex:1;min-width:280px;position:relative;display:flex;align-items:center}.search-luxury svg{position:absolute;right:12px;width:16px;height:16px;color:#9ca3af;pointer-events:none}.search-luxury input{width:100%;height:42px;padding:0 40px 0 36px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.86rem;font-family:'Tajawal';outline:none;background:#fcfaf6;transition:.2s}.search-luxury input:focus{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.clear-search-luxury{position:absolute;left:8px;width:26px;height:26px;border-radius:50%;border:none;background:#f3f4f6;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.clear-search-luxury svg{width:10px;height:10px}
.select-wrap-luxury{position:relative;display:flex;align-items:center}.select-wrap-luxury select{height:42px;padding:0 28px 0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.82rem;font-family:'Tajawal';background:#fff;appearance:none;cursor:pointer;outline:none;min-width:110px}.select-wrap-luxury .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.card-head-luxury{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8;flex-wrap:wrap;gap:8px}.card-head-luxury h3{font-size:.9rem;font-weight:800;color:#0A0F1E;display:flex;align-items:center;gap:8px;margin:0}.card-head-luxury h3 svg{width:16px;height:16px;color:var(--gold-dark)}.legend-dot{width:8px;height:8px;border-radius:50%;background:var(--c);box-shadow:0 0 0 3px color-mix(in srgb,var(--c) 15%,transparent);display:inline-block}
.table-responsive{overflow-x:auto}.table-luxury{width:100%;border-collapse:collapse;min-width:1300px}.table-luxury thead{background:linear-gradient(135deg,#fcfaf6,#f8f6f0)}.table-luxury th{padding:12px 14px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;white-space:nowrap}.table-luxury td{padding:12px 14px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}.table-luxury tbody tr:hover{background:rgba(212,175,55,.03)}
.th-num{width:45px;text-align:center}.th-actions{text-align:center;width:100px}.td-num{text-align:center;color:#9ca3af;font-size:.78rem}.td-center{text-align:center}.td-muted{color:#6b7280;font-size:.82rem}
.doc-num-luxury{color:var(--gold-dark);font-weight:800;font-size:.82rem;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:8px}
.acc-cell{display:flex;align-items:center;gap:10px}.acc-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid}.acc-icon.type-1{background:#eff6ff;color:#2563eb;border-color:#dbeafe}.acc-icon.type-2{background:#fef3c7;color:#d97706;border-color:#fde68a}.acc-icon svg{width:16px;height:16px}
.acc-info{display:flex;flex-direction:column}.acc-name{font-weight:800;color:#0A0F1E;font-size:.86rem}.acc-name-en{font-weight:600;color:#8B95A5;font-size:.72rem}
.level-badge{font-family:monospace;font-weight:700;background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb;padding:3px 8px;border-radius:999px;font-size:.72rem}
.coa-type{font-size:.68rem;padding:3px 8px;border-radius:6px;font-weight:800;border:1px solid}.type-1{background:#eff6ff;color:#2563eb;border-color:#dbeafe}
.coa-detail{font-size:.68rem;padding:3px 8px;border-radius:6px;font-weight:800;border:1px solid}.coa-detail.group{background:rgba(212,175,55,.1);color:#9C7C2E;border-color:rgba(212,175,55,.2)}
.amount-luxury{font-family:monospace;font-weight:800;color:#0A0F1E;background:#f8f6f0;padding:4px 10px;border-radius:8px;border:1px solid #e8e2d0}
.status-badge-luxury{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,white)}.status-dot{width:6px;height:6px;border-radius:50%;background:var(--sc);box-shadow:0 0 0 2px color-mix(in srgb,var(--sc) 15%,transparent)}
.actions-wrap-luxury{display:flex;gap:4px;justify-content:center}.act-btn{width:30px;height:30px;border-radius:9px;border:1.5px solid;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;background:#fff;transition:.2s}.act-btn.add{color:#059669;border-color:#a7f3d0}.act-btn.edit{color:var(--gold-dark);border-color:rgba(212,175,55,.2)}.act-btn svg{width:13px;height:13px}
.modal-overlay-luxury{position:fixed;inset:0;background:rgba(7,11,20,.55);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:1000;padding:16px;overflow-y:auto}
.modal-card-luxury{position:relative;background:#fff;border-radius:20px;width:100%;max-width:520px;overflow:hidden;box-shadow:0 24px 48px rgba(0,0,0,.2);animation:modalIn .3s ease;border:1px solid #e8e2d0;max-height:90vh;display:flex;flex-direction:column}.modal-card-luxury.large{max-width:800px}
.ml-gold-line{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent);z-index:2}
.ml-header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8}.ml-header h3{margin:0;font-size:.95rem;font-weight:800;color:#0A0F1E}
.btn-close-x{width:28px;height:28px;border-radius:8px;border:1px solid #e8e2d0;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.btn-close-x svg{width:12px;height:12px}
.ml-body{padding:20px;overflow-y:auto;flex:1}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}@@keyframes spin{to{transform:rotate(360deg)}}
.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}
.toast-luxury{position:fixed;bottom:20px;left:20px;z-index:1050;animation:toastIn .35s ease}.toast-card-luxury{display:flex;align-items:center;gap:10px;padding:12px 18px;border-radius:14px;min-width:280px;font-weight:600;font-size:.84rem;box-shadow:0 12px 32px rgba(0,0,0,.12)}.toast-card-luxury.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.toast-card-luxury.error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.toast-card-luxury button{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-right:auto}
@@keyframes modalIn{from{opacity:0;transform:scale(.96) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}@@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
</style>

@code {
    private List<JournalEntryListDto> allJournals = new();
    private List<JournalEntryListDto> filtered = new();
    private bool isLoading = true;
    private string searchText = "";
    private int filterStatus = 0;
    private int filterAuto = 0;
    private DateTime? filterFrom = null;
    private DateTime? filterTo = null;
    private bool showDetail = false;
    private JournalEntryDto? selectedJournal = null;
    private string toast = "";
    private bool toastOk = true;

    protected override async Task OnInitializedAsync(){ await LoadData(); }

    private async Task LoadData()
    {
        isLoading=true; StateHasChanged();
        try
        {
            allJournals = await AccountingService.GetJournalsAsync(filterFrom, filterTo);
            ApplyFilter();
        }
        catch(Exception ex){ toast="خطأ: "+ex.Message; toastOk=false; }
        finally{ isLoading=false; }
    }

    private void ApplyFilter()
    {
        filtered = allJournals.Where(j =>
            (filterStatus==0 || j.JournalStatus==filterStatus) &&
            (filterAuto==0 || (filterAuto==1 && !j.IsAutoGenerated) || (filterAuto==2 && j.IsAutoGenerated)) &&
            (string.IsNullOrWhiteSpace(searchText) ||
             (j.JournalNumber?.Contains(searchText,StringComparison.OrdinalIgnoreCase)??false) ||
             (j.Description?.Contains(searchText,StringComparison.OrdinalIgnoreCase)??false) ||
             (j.SourceDocNumber?.Contains(searchText,StringComparison.OrdinalIgnoreCase)??false))
        ).ToList();
    }

    private void ClearSearch(){ searchText=""; ApplyFilter(); }

    private string GetSourceNameAr(string? code) => code switch
    {
        "OverheadExpense" => "مصروف",
        "ReceiptVoucher" => "سند قبض",
        "PaymentVoucher" => "سند صرف",
        "CashTransfer" => "تحويل خزينة",
        "BankTransfer" => "تحويل بنكي",
        "OpeningBalance" => "رصيد افتتاحي",
        "SalesInvoice" => "فاتورة مبيعات",
        "PurchaseInvoice" => "فاتورة مشتريات",
        _ => code ?? "—"
    };

    private async Task ViewJournal(int id)
    {
        try{ 
            // فتح صفحة العرض الكاملة بدل المودال
            Navigation.NavigateTo($"/journal-entries/{id}");
        }
        catch(Exception ex){ toast=ex.Message; toastOk=false; }
    }

    private async Task ViewJournalModal(int id)
    {
        try{ selectedJournal = await AccountingService.GetJournalByIdAsync(id); if(selectedJournal!=null) showDetail=true; }
        catch(Exception ex){ toast=ex.Message; toastOk=false; }
    }

    private async Task PostJournal(int id)
    {
        try{ await AccountingService.PostJournalAsync(id, 1); toast="تم ترحيل القيد ✅"; toastOk=true; await LoadData(); }
        catch(Exception ex){ toast=ex.Message; toastOk=false; }
    }
}
