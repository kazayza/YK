@page "/audit-log"
@using YKCoatings.Models
@using YKCoatings.Services
@inject AuditLogService AuditLogService
@inject UserService UserService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>سجل العمليات</PageTitle>

@if (!_authorized)
{<div class="no-access-luxury" dir="rtl"><h4>جاري التحقق...</h4></div>}
else
{
<div class="luxury-page full-width" dir="rtl">
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
        <div class="lh-content">
            <div class="lh-right">
                <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                <div class="lh-text">
                    <h2 class="lh-title">سجل العمليات</h2>
                </div>
            </div>
            <div class="lh-actions">
                <span class="lh-badge"><span class="lh-dot"></span>@_records.Count سجل</span>
                @if (PermissionService.CanExport("SCR_AUDIT")){
                    <button class="btn-luxury btn-ghost-luxury" @onclick="ExportData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>تصدير</button>
                }
            </div>
        </div>
    </div>

    <div class="stats-luxury">
        <div class="stat-luxury"><div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><div class="st-info"><span class="st-value">@_stats.TotalActions</span><span class="st-label">إجمالي</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg></div><div class="st-info"><span class="st-value">@_stats.AddCount</span><span class="st-label">إضافة</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></div><div class="st-info"><span class="st-value">@_stats.EditCount</span><span class="st-label">تعديل</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></div><div class="st-info"><span class="st-value">@_stats.DeleteCount</span><span class="st-label">حذف</span></div><div class="st-gold-line"></div></div>
    </div>

    <div class="filter-luxury">
        <div class="select-wrap-luxury"><input type="date" @bind="_filter.DateFrom" @bind:after="ApplyFilters" style="height:42px;border:1.5px solid #e8e2d0;border-radius:12px;padding:0 12px;font-family:'Tajawal';font-size:.82rem" /><small style="font-size:.65rem;color:#8B95A5;margin-right:4px">من</small></div>
        <div class="select-wrap-luxury"><input type="date" @bind="_filter.DateTo" @bind:after="ApplyFilters" style="height:42px;border:1.5px solid #e8e2d0;border-radius:12px;padding:0 12px;font-family:'Tajawal';font-size:.82rem" /><small style="font-size:.65rem;color:#8B95A5;margin-right:4px">إلى</small></div>
        <div class="select-wrap-luxury">
            <select @bind="_filter.Username" @bind:after="ApplyFilters" style="min-width:160px">
                <option value="">كل المستخدمين</option>
                @foreach(var u in _usersLookup){<option value="@u.Username">@u.FullName (@u.Username)</option>}
            </select>
            <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
        </div>
        <div class="select-wrap-luxury"><select @bind="_filter.TableName" @bind:after="ApplyFilters"><option value="">كل الجداول</option>@foreach(var t in _tables){<option value="@t">@GetTableNameAr(t)</option>}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
        <div class="search-luxury" style="min-width:140px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg><input type="text" placeholder="Record ID..." @bind="_filter.RecordID" @bind:event="oninput" @onkeyup="OnSearchKeyUp" /></div>
        <button class="btn-luxury btn-ghost-luxury" @onclick="ResetFilters"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>إعادة تعيين</button>
    </div>

    <div class="mudtabs-luxury">
        <div class="mudtabs-header-luxury">
            <button class="mudtab-btn-luxury @(activeTab=="all"?"active":"")" @onclick='()=>activeTab="all"'>
                <span class="mt-icon" style="background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>
                الكل <span class="mt-count">@_records.Count</span>
            </button>
            <button class="mudtab-btn-luxury @(activeTab=="add"?"active":"")" @onclick='()=>activeTab="add"'>
                <span class="mt-icon" style="background:#ecfdf5;color:#059669;border:1px solid #a7f3d0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg></span>
                إضافة <span class="mt-count">@_records.Count(r=>r.ActionType==1)</span>
            </button>
            <button class="mudtab-btn-luxury @(activeTab=="edit"?"active":"")" @onclick='()=>activeTab="edit"'>
                <span class="mt-icon" style="background:#eff6ff;color:#2563eb;border:1px solid #dbeafe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></span>
                تعديل <span class="mt-count">@_records.Count(r=>r.ActionType==2)</span>
            </button>
            <button class="mudtab-btn-luxury @(activeTab=="delete"?"active":"")" @onclick='()=>activeTab="delete"'>
                <span class="mt-icon" style="background:#fef2f2;color:#ef4444;border:1px solid #fecaca"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></span>
                حذف <span class="mt-count">@_records.Count(r=>r.ActionType==3)</span>
            </button>
        </div>
        <div class="mudtabs-body-luxury">
            @if (_loading)
            {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
            else if (!filteredRecords.Any())
            {<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h4>لا يوجد سجلات</h4></div>}
            else
            {
                <div class="table-card-luxury full">
                    <div class="table-responsive">
                        <table class="table-luxury detailed">
                            <thead><tr><th class="th-num">#</th><th>التاريخ</th><th>المستخدم</th><th>العملية</th><th>الجدول</th><th>السجل</th><th>الوصف</th><th>IP</th><th class="th-actions">تفاصيل</th></tr></thead>
                            <tbody>
                                @{int rowNum=0;}
                                @foreach(var rec in filteredRecords){rowNum++;
                                    <tr>
                                        <td class="td-num">@rowNum</td>
                                        <td><span class="level-badge">@rec.AuditDate.ToString("dd/MM/yyyy")</span><br/><small style="color:#8B95A5">@rec.AuditDate.ToString("hh:mm tt")</small></td>
                                        <td><div class="acc-cell"><div class="user-avatar-luxury">@GetInitials(rec.Username ?? "U")</div><div class="acc-info"><span class="acc-name">@(rec.Username ?? "—")</span></div></div></td>
                                        <td><span class="status-badge-luxury" style="--sc:@GetActionColor(rec.ActionType)"><span class="status-dot" style="--sc:@GetActionColor(rec.ActionType)"></span>@GetActionIconSvg(rec.ActionType) @rec.ActionTypeName</span></td>
                                        <td><span class="doc-num-luxury">@GetTableNameAr(rec.TableName)</span><br/><small style="color:#9ca3af;font-size:.65rem">@rec.TableName</small></td>
                                        <td><span class="level-badge">@(rec.RecordID ?? "—")</span></td>
                                        <td class="td-muted" style="max-width:320px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@rec.Description">@TruncateText(rec.Description, 70)</td>
                                        <td><span class="level-badge">@(rec.IPAddress ?? "—")</span></td>
                                        <td class="td-center">@if(!string.IsNullOrEmpty(rec.OldValues) || !string.IsNullOrEmpty(rec.NewValues)){<button class="act-btn" style="color:#2563eb;border-color:#bfdbfe" title="تفاصيل" @onclick="()=>ShowDetails(rec)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>}</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@if (_showDetail && _selectedRecord != null)
{
    <div class="modal-overlay-luxury" @onclick="()=>_showDetail=false"><div class="modal-card-luxury large" style="max-width:760px" @onclick:stopPropagation="true">
        <div class="ml-gold-line"></div>
        <div class="ml-header"><h3>تفاصيل العملية #@_selectedRecord.AuditID — @_selectedRecord.ActionTypeName</h3><button class="btn-close-x" @onclick="()=>_showDetail=false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
        <div class="ml-body">
            <div class="form-grid-luxury">
                <div class="fg"><label>المستخدم</label><input type="text" value="@_selectedRecord.Username" readonly class="readonly" /></div>
                <div class="fg"><label>العملية</label><input type="text" value="@_selectedRecord.ActionTypeName" readonly class="readonly" /></div>
                <div class="fg"><label>الجدول</label><input type="text" value="@GetTableNameAr(_selectedRecord.TableName)" readonly class="readonly" /></div>
                <div class="fg"><label>معرف السجل</label><input type="text" value="@(_selectedRecord.RecordID ?? "—")" readonly class="readonly" /></div>
            </div>
            @if(!string.IsNullOrEmpty(_selectedRecord.ChangedColumns)){<div style="margin-top:16px"><label style="font-size:.78rem;font-weight:700;color:#374151">الأعمدة المعدلة</label><div style="background:#fcfaf6;border:1px solid #e8e2d0;border-radius:10px;padding:12px;margin-top:6px"><pre style="margin:0;font-family:monospace;font-size:.78rem;white-space:pre-wrap">@_selectedRecord.ChangedColumns</pre></div></div>}
            @if(!string.IsNullOrEmpty(_selectedRecord.OldValues)){<div style="margin-top:16px"><label style="font-size:.78rem;font-weight:700;color:#374151">القيم القديمة</label><div style="background:#1e293b;color:#e2e8f0;border-radius:10px;padding:14px;margin-top:6px;max-height:200px;overflow-y:auto"><pre style="margin:0;font-family:monospace;font-size:.74rem;white-space:pre-wrap;direction:ltr;text-align:left">@FormatJson(_selectedRecord.OldValues)</pre></div></div>}
            @if(!string.IsNullOrEmpty(_selectedRecord.NewValues)){<div style="margin-top:16px"><label style="font-size:.78rem;font-weight:700;color:#374151">القيم الجديدة</label><div style="background:#1e293b;color:#e2e8f0;border-radius:10px;padding:14px;margin-top:6px;max-height:200px;overflow-y:auto"><pre style="margin:0;font-family:monospace;font-size:.74rem;white-space:pre-wrap;direction:ltr;text-align:left">@FormatJson(_selectedRecord.NewValues)</pre></div></div>}
        </div>
        <div class="ml-footer"><button class="btn-luxury btn-ghost-luxury" @onclick="()=>_showDetail=false">إغلاق</button></div>
    </div></div>
}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;margin:0 auto}.luxury-page.full-width{max-width:100%;width:100%}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.25rem;font-weight:900;color:#F5E6C8;margin:0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-luxury svg{width:14px;height:14px}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
.st-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.st-icon.dark{background:linear-gradient(135deg,var(--black2),var(--black3));color:var(--gold);border:1px solid var(--border-gold)}.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.st-icon.red{background:#fef2f2;color:#ef4444;border:1px solid #fecaca}.st-icon svg{width:18px;height:18px}.st-info{display:flex;flex-direction:column}.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}.st-gold-line{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}.stat-luxury:hover .st-gold-line{opacity:.8}
.filter-luxury{display:flex;gap:10px;flex-wrap:wrap;align-items:center;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:12px}
.search-luxury{flex:1;min-width:160px;position:relative;display:flex;align-items:center}.search-luxury svg{position:absolute;right:12px;width:16px;height:16px;color:#9ca3af;pointer-events:none}.search-luxury input{width:100%;height:42px;padding:0 40px 0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.84rem;font-family:'Tajawal';outline:none;background:#fcfaf6;transition:.2s}.search-luxury input:focus{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.select-wrap-luxury{position:relative;display:flex;align-items:center}.select-wrap-luxury select{height:42px;padding:0 28px 0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.82rem;font-family:'Tajawal';background:#fff;appearance:none;cursor:pointer;outline:none;min-width:120px}.select-wrap-luxury .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.mudtabs-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}
.mudtabs-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5;z-index:2}
.mudtabs-header-luxury{position:relative;display:flex;gap:0;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #e8e2d0;padding:0 8px;overflow-x:auto;scrollbar-width:none}.mudtabs-header-luxury::-webkit-scrollbar{display:none}
.mudtab-btn-luxury{position:relative;display:flex;align-items:center;gap:8px;padding:14px 20px;background:transparent;border:none;border-bottom:2px solid transparent;font-family:'Tajawal';font-size:.82rem;font-weight:800;color:#8B95A5;cursor:pointer;transition:all .25s;white-space:nowrap;flex-shrink:0}
.mudtab-btn-luxury:hover{background:rgba(212,175,55,.05);color:#0A0F1E}.mudtab-btn-luxury.active{color:var(--gold-dark);background:rgba(212,175,55,.08);border-bottom-color:var(--gold)}
.mudtab-btn-luxury .mt-icon{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.mt-icon svg{width:14px;height:14px}
.mt-count{background:#f3f4f6;color:#6b7280;padding:2px 8px;border-radius:999px;font-size:.68rem;font-weight:800}.mt-count.gold{background:rgba(212,175,55,.15);color:var(--gold-dark)}
.mudtabs-body-luxury{padding:18px;background:#fff;min-height:400px}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}.table-card-luxury.full{width:100%}.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.card-head-luxury{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8;flex-wrap:wrap;gap:8px}.card-head-luxury h3{font-size:.9rem;font-weight:800;color:#0A0F1E;display:flex;align-items:center;gap:8px;margin:0}.card-head-luxury h3 svg{width:16px;height:16px;color:var(--gold-dark)}
.table-responsive{overflow-x:auto}.table-luxury{width:100%;border-collapse:collapse;min-width:1100px}.table-luxury thead{background:linear-gradient(135deg,#fcfaf6,#f8f6f0)}.table-luxury th{padding:12px 14px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;white-space:nowrap}.table-luxury td{padding:12px 14px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}.table-luxury tbody tr:hover{background:rgba(212,175,55,.03)}
.th-num{width:45px;text-align:center}.th-actions{text-align:center;width:80px}.td-num{text-align:center;color:#9ca3af;font-size:.78rem}.td-center{text-align:center}.td-muted{color:#6b7280;font-size:.82rem}
.doc-num-luxury{color:var(--gold-dark);font-weight:800;font-size:.82rem;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:8px}
.level-badge{font-family:monospace;font-weight:700;background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb;padding:3px 8px;border-radius:999px;font-size:.72rem}
.status-badge-luxury{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,white)}.status-dot{width:6px;height:6px;border-radius:50%;background:var(--sc)}
.act-btn{width:30px;height:30px;border-radius:9px;border:1.5px solid;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;background:#fff;transition:.2s}.act-btn svg{width:13px;height:13px}
.acc-cell{display:flex;align-items:center;gap:10px}.acc-info{display:flex;flex-direction:column}.acc-name{font-weight:800;color:#0A0F1E;font-size:.86rem}.user-avatar-luxury{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,#070B14,#0A0F1E);color:var(--gold);font-weight:900;font-size:.74rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid rgba(212,175,55,.2)}
.modal-overlay-luxury{position:fixed;inset:0;background:rgba(7,11,20,.55);backdrop-filter:blur(6px);display:flex;align-items:center;justify-content:center;z-index:1000;padding:16px}
.modal-card-luxury{position:relative;background:#fff;border-radius:20px;width:100%;max-width:520px;overflow:hidden;box-shadow:0 24px 48px rgba(0,0,0,.2);animation:modalIn .3s ease;border:1px solid #e8e2d0;max-height:90vh;display:flex;flex-direction:column}.modal-card-luxury.large{max-width:760px}
.ml-gold-line{position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent)}
.ml-header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8}.ml-header h3{margin:0;font-size:.95rem;font-weight:800;color:#0A0F1E}
.btn-close-x{width:28px;height:28px;border-radius:8px;border:1px solid #e8e2d0;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.btn-close-x svg{width:12px;height:12px}
.ml-body{padding:20px;overflow-y:auto;flex:1}.form-grid-luxury{display:grid;grid-template-columns:1fr 1fr;gap:14px}.fg label{font-size:.78rem;font-weight:700;color:#374151;margin-bottom:6px;display:block}.fg input{width:100%;height:40px;padding:0 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.84rem;font-family:'Tajawal';outline:none;background:#fcfaf6}.fg input.readonly{background:#f3f4f6;color:#6b7280}
.ml-footer{display:flex;gap:8px;padding:14px 20px;border-top:1px solid #f1efe8;background:#fcfaf6;justify-content:flex-end}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}@@keyframes spin{to{transform:rotate(360deg)}}
.empty-luxury{text-align:center;padding:60px 20px;background:#fff;border-radius:18px;border:1px solid #e8e2d0}.empty-icon-luxury{width:56px;height:56px;margin:0 auto 12px;border-radius:14px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.empty-icon-luxury svg{width:28px;height:28px}.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}
@@keyframes modalIn{from{opacity:0;transform:scale(.96) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}
</style>

@code {
    private bool _authorized = false;
    private bool _loading = true;
    private List<AuditLogDto> _records = new();
    private List<AuditLogDto> filteredRecords => _records.Where(r=>
        activeTab switch{
            "add"=>r.ActionType==1,
            "edit"=>r.ActionType==2,
            "delete"=>r.ActionType==3,
            _=>true
        }).ToList();
    private AuditLogFilterDto _filter = new();
    private AuditStatsDto _stats = new();
    private List<string> _tables = new();
    private List<UserListDto> _usersLookup = new();
    private System.Timers.Timer? _searchTimer;
    private bool _showDetail = false;
    private AuditLogDto? _selectedRecord;
    private string activeTab = "all";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!UserSession.IsLoggedIn){var restored=await UserSession.TryRestoreSessionAsync(); if(!restored){Navigation.NavigateTo("/login"); return;} if(!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);}
            if (!PermissionService.CanView("SCR_AUDIT")){Navigation.NavigateTo("/access-denied"); return;}
            _authorized=true; _filter.DateFrom=DateTime.Today.AddDays(-7); _filter.DateTo=DateTime.Today; await LoadLookups(); await LoadData(); StateHasChanged();
        }
    }

    private async Task LoadLookups()
    {
        try{_tables=await AuditLogService.GetDistinctTablesAsync();}catch{}
        try{_usersLookup=await UserService.GetAllAsync(new UserFilterDto());}catch{ _usersLookup=new(); }
    }
    private async Task LoadData(){try{_loading=true; StateHasChanged(); _records=await AuditLogService.GetAllAsync(_filter); _stats=await AuditLogService.GetStatsAsync(_filter.DateFrom, _filter.DateTo);}catch{}finally{_loading=false;}}
    private async Task ApplyFilters()=>await LoadData();
    private void OnSearchKeyUp(KeyboardEventArgs e){_searchTimer?.Stop(); _searchTimer?.Dispose(); _searchTimer=new System.Timers.Timer(400); _searchTimer.Elapsed+=async (s,args)=>{_searchTimer?.Stop(); await InvokeAsync(async()=>{await LoadData(); StateHasChanged();});}; _searchTimer.AutoReset=false; _searchTimer.Start();}
    private async Task ResetFilters(){_filter=new AuditLogFilterDto{DateFrom=DateTime.Today.AddDays(-7), DateTo=DateTime.Today}; activeTab="all"; await LoadData();}
    private void ShowDetails(AuditLogDto rec){_selectedRecord=rec; _showDetail=true;}
    private string GetActionColor(int actionType)=>actionType switch{1=>"#10b981",2=>"#2563eb",3=>"#ef4444",4=>"#6b7280",5=>"#7c3aed",_=>"#6b7280"};
    private RenderFragment GetActionIconSvg(int actionType) => builder =>
    {
        string svg = actionType switch{
            1 => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='M12 5v14M5 12h14'/></svg>",
            2 => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z'/></svg>",
            3 => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='M3 6h18'/><path d='M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6'/></svg>",
            4 => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z'/><circle cx='12' cy='12' r='3'/></svg>",
            5 => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='M6 9V2h12v7'/><path d='M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2'/><path d='M6 14h12v8H6z'/></svg>",
            _ => "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5'><path d='M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z'/></svg>"
        };
        builder.AddMarkupContent(0, $"<span style='width:14px;height:14px;display:inline-flex;vertical-align:middle;margin-left:4px'>{svg}</span>");
    };
    private string TruncateText(string? text, int max){if(string.IsNullOrEmpty(text)) return "—"; return text.Length>max ? text.Substring(0,max)+"..." : text;}
    private string FormatJson(string? json){if(string.IsNullOrEmpty(json)) return ""; try{var obj=System.Text.Json.JsonSerializer.Deserialize<object>(json); return System.Text.Json.JsonSerializer.Serialize(obj, new System.Text.Json.JsonSerializerOptions{WriteIndented=true});}catch{return json;}}
    private void ExportData(){}
    private string GetInitials(string name){if(string.IsNullOrWhiteSpace(name)) return "U"; var parts=name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length>=2 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : parts[0][0].ToString().ToUpper();}
    private string GetTableNameAr(string? table)
    {
        if(string.IsNullOrWhiteSpace(table)) return "—";
        return table switch{
            "Users" => "المستخدمين",
            "Roles" => "الأدوار",
            "RolePermissions" => "صلاحيات الأدوار",
            "UserPermissions" => "صلاحيات المستخدمين",
            "Customers" => "العملاء",
            "Suppliers" => "الموردين",
            "Items" => "الأصناف",
            "Warehouses" => "المخازن",
            "Units" => "الوحدات",
            "Currencies" => "العملات",
            "CashBoxes" => "الخزن",
            "BankAccounts" => "الحسابات البنكية",
            "ReceiptVouchers" => "سندات القبض",
            "PaymentVouchers" => "سندات الصرف",
            "CashTransfers" => "تحويلات الخزينة",
            "JournalEntries" => "القيود المحاسبية",
            "JournalEntryDetails" => "تفاصيل القيود",
            "SalesInvoices" => "فواتير المبيعات",
            "SalesOrders" => "أوامر المبيعات",
            "PurchaseInvoices" => "فواتير المشتريات",
            "PurchaseOrders" => "أوامر الشراء",
            "ChartOfAccounts" => "شجرة الحسابات",
            "CostCenters" => "مراكز التكلفة",
            "FiscalYears" => "السنوات المالية",
            "SystemSettings" => "إعدادات النظام",
            "OverheadExpenses" => "المصروفات",
            "Employees" => "الموظفين",
            _ => table
        };
    }
}
