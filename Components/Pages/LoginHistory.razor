@page "/login-history"
@using YKCoatings.Models
@using YKCoatings.Services
@inject LoginHistoryService LoginHistoryService
@inject UserService UserService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation


@if (!_authorized)
{
    <div></div>
}
else
{
    <!-- ===== شريط العنوان ===== -->
    <div class="page-header">
        <div class="page-header-right">
            <h2 class="page-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="title-icon">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
                سجل الدخول
            </h2>
            <span class="record-count">@_records.Count سجل</span>
        </div>
        <div class="page-header-left">
            @if (PermissionService.CanExport("SCR_LOGINLOG"))
            {
                <button class="btn-action btn-export" @onclick="ExportData">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    <span>تصدير</span>
                </button>
            }
        </div>
    </div>

    <!-- ===== بطاقات الإحصائيات ===== -->
    <div class="stats-grid">
        <div class="stat-card stat-total">
            <div class="stat-icon">📊</div>
            <div class="stat-body">
                <span class="stat-num">@_stats.TotalAttempts</span>
                <span class="stat-label">إجمالي المحاولات</span>
            </div>
        </div>
        <div class="stat-card stat-success">
            <div class="stat-icon">✅</div>
            <div class="stat-body">
                <span class="stat-num">@_stats.SuccessCount</span>
                <span class="stat-label">دخول ناجح</span>
            </div>
        </div>
        <div class="stat-card stat-failed">
            <div class="stat-icon">❌</div>
            <div class="stat-body">
                <span class="stat-num">@_stats.FailedPasswordCount</span>
                <span class="stat-label">كلمة مرور خطأ</span>
            </div>
        </div>
        <div class="stat-card stat-locked">
            <div class="stat-icon">🔒</div>
            <div class="stat-body">
                <span class="stat-num">@_stats.FailedLockedCount</span>
                <span class="stat-label">محاولات محظورة</span>
            </div>
        </div>
        <div class="stat-card stat-users">
            <div class="stat-icon">👥</div>
            <div class="stat-body">
                <span class="stat-num">@_stats.UniqueUsers</span>
                <span class="stat-label">مستخدم فريد</span>
            </div>
        </div>
    </div>

    <!-- ===== الفلاتر ===== -->
    <div class="filters-card">
        <div class="filters-grid">

            <div class="filter-group">
                <label class="filter-label">من تاريخ</label>
                <input type="date" class="filter-input" @bind="_filter.DateFrom" @bind:after="ApplyFilters" />
            </div>

            <div class="filter-group">
                <label class="filter-label">إلى تاريخ</label>
                <input type="date" class="filter-input" @bind="_filter.DateTo" @bind:after="ApplyFilters" />
            </div>

            <div class="filter-group">
    <label class="filter-label">المستخدم</label>
    <select class="filter-input" @bind="_filterUserIdText" @bind:after="ApplyFilters">
        <option value="">— الكل —</option>
        @foreach (var user in _usersLookup)
        {
            <option value="@user.Code">@user.Name</option>
        }
    </select>
</div>

            <div class="filter-group">
                <label class="filter-label">حالة الدخول</label>
                <select class="filter-input" @bind="_filterStatusText" @bind:after="ApplyFilters">
                    <option value="">— الكل —</option>
                    <option value="1">ناجح</option>
                    <option value="2">فاشل - كلمة مرور</option>
                    <option value="3">فاشل - محظور</option>
                </select>
            </div>

            <div class="filter-group">
                <label class="filter-label">عنوان IP</label>
                <input type="text" class="filter-input" placeholder="IP..."
                       @bind="_filter.IPAddress" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
            </div>

            <div class="filter-group filter-actions">
                <label class="filter-label">&nbsp;</label>
                <button class="btn-filter-reset" @onclick="ResetFilters">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                        <path d="M3 3v5h5"/>
                    </svg>
                    <span>إعادة تعيين</span>
                </button>
            </div>

        </div>
    </div>

    <!-- ===== التحميل ===== -->
    @if (_loading)
    {
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <span>جاري تحميل البيانات...</span>
        </div>
    }
    else if (!_records.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <h3>لا يوجد سجلات</h3>
            <p>لا توجد نتائج مطابقة للبحث</p>
        </div>
    }
    else
    {
        <!-- ===== الجدول ===== -->
        <div class="table-card">
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th class="th-narrow">#</th>
                            <th>المستخدم</th>
                            <th>الدور</th>
                            <th>وقت الدخول</th>
                            <th>وقت الخروج</th>
                            <th class="th-center">المدة (دقيقة)</th>
                            <th class="th-center">الحالة</th>
                            <th>IP</th>
                            <th>الجهاز</th>
                            <th>سبب الفشل</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 0; }
                        @foreach (var rec in _records)
                        {
                            rowNum++;
                            <tr class="@(rec.LoginStatus != 1 ? "row-failed" : "")">
                                <td class="td-narrow">@rowNum</td>
                                <td>
                                    <span class="cell-main">@rec.Username</span>
                                    @if (!string.IsNullOrEmpty(rec.FullName))
                                    {
                                        <span class="cell-sub">@rec.FullName</span>
                                    }
                                </td>
                                <td><span class="badge badge-role">@(rec.RoleNameAr ?? "—")</span></td>
                                <td>
                                    <span class="cell-main">@rec.LoginTime.ToString("dd/MM/yyyy")</span>
                                    <span class="cell-sub">@rec.LoginTime.ToString("hh:mm:ss tt")</span>
                                </td>
                                <td>
                                    @if (rec.LogoutTime.HasValue)
                                    {
                                        <span class="cell-main">@rec.LogoutTime.Value.ToString("dd/MM/yyyy")</span>
                                        <span class="cell-sub">@rec.LogoutTime.Value.ToString("hh:mm:ss tt")</span>
                                    }
                                    else
                                    {
                                        <span class="cell-empty">—</span>
                                    }
                                </td>
                                <td class="td-center">
                                    @if (rec.SessionDuration.HasValue)
                                    {
                                        <span class="badge badge-duration">@rec.SessionDuration د</span>
                                    }
                                    else
                                    {
                                        <span class="cell-empty">—</span>
                                    }
                                </td>
                                <td class="td-center">
                                    <span class="badge @GetStatusBadgeClass(rec.LoginStatus)">
                                        @rec.LoginStatusName
                                    </span>
                                </td>
                                <td><span class="cell-mono">@(rec.IPAddress ?? "—")</span></td>
                                <td><span class="cell-sub">@(rec.MachineName ?? "—")</span></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(rec.FailureReason))
                                    {
                                        <span class="cell-error">@rec.FailureReason</span>
                                    }
                                    else
                                    {
                                        <span class="cell-empty">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<style>
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
    .page-header-right { display: flex; align-items: center; gap: 12px; }
    .page-header-left { display: flex; align-items: center; gap: 8px; }
    .page-title { font-size: 1.3rem; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 10px; margin: 0; }
    .title-icon { width: 28px; height: 28px; color: #2563eb; }
    .record-count { background: #f1f5f9; color: #64748b; padding: 4px 12px; border-radius: 20px; font-size: .78rem; font-weight: 700; }
    .btn-action { display: inline-flex; align-items: center; gap: 6px; padding: 10px 18px; border: none; border-radius: 10px; font-size: .82rem; font-weight: 700; cursor: pointer; transition: all .2s; }
    .btn-action svg { width: 16px; height: 16px; }
    .btn-export { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .btn-export:hover { background: #e2e8f0; }

    /* Stats */
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin-bottom: 20px; }
    .stat-card { background: white; border-radius: 12px; padding: 16px; display: flex; align-items: center; gap: 12px; border: 1px solid #e2e8f0; box-shadow: 0 2px 8px rgba(15,23,42,.04); }
    .stat-icon { font-size: 1.5rem; }
    .stat-body { display: flex; flex-direction: column; }
    .stat-num { font-size: 1.3rem; font-weight: 800; color: #0f172a; }
    .stat-label { font-size: .72rem; color: #94a3b8; font-weight: 600; }

    /* Filters */
    .filters-card { background: white; border-radius: 14px; padding: 20px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(15,23,42,.06); border: 1px solid #e2e8f0; }
    .filters-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; align-items: end; }
    .filter-group { display: flex; flex-direction: column; gap: 6px; }
    .filter-label { font-size: .86rem; font-weight: 700; color: #475569; }
    .filter-input { height: 44px; border: 1px solid #e2e8f0; border-radius: 10px; padding: 0 14px; font-size: .9rem; background: #f8fafc; transition: all .2s; width: 100%; }
    .filter-input:focus { border-color: #2563eb; background: white; outline: none; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
    .btn-filter-reset { display: inline-flex; align-items: center; gap: 6px; height: 42px; padding: 0 16px; background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; border-radius: 10px; font-size: .8rem; font-weight: 700; cursor: pointer; transition: all .2s; white-space: nowrap; }
    .btn-filter-reset:hover { background: #fee2e2; }
    .btn-filter-reset svg { width: 15px; height: 15px; }

    /* Loading */
    .loading-container { display: flex; flex-direction: column; align-items: center; padding: 80px 20px; color: #64748b; gap: 16px; }
    .loading-spinner { width: 40px; height: 40px; border: 3px solid #e2e8f0; border-top-color: #2563eb; border-radius: 50%; animation: spin .8s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .empty-state { text-align: center; padding: 80px 20px; color: #94a3b8; }
    .empty-icon svg { width: 64px; height: 64px; opacity: .4; }
    .empty-state h3 { font-size: 1.1rem; color: #475569; margin-bottom: 8px; }

    /* Table */
    .table-card { background: white; border-radius: 14px; box-shadow: 0 2px 8px rgba(15,23,42,.06); border: 1px solid #e2e8f0; overflow: hidden; }
    .table-responsive { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; }
    .data-table thead { background: #f8fafc; border-bottom: 2px solid #e2e8f0; }
    .data-table th { padding: 14px 12px; font-size: .86rem; font-weight: 800; color: #475569; text-align: right; white-space: nowrap; }
    .data-table td { padding: 12px 14px; font-size: .9rem; color: #334155; border-bottom: 1px solid #f1f5f9; vertical-align: middle; }
    .data-table tbody tr:hover { background: #f8fafc; }
    .th-narrow, .td-narrow { width: 50px; text-align: center; }
    .th-center, .td-center { text-align: center; }
    .row-failed { background: #fef2f2 !important; }

    .cell-main { display: block; font-weight: 600; font-size: .9rem; }
    .cell-sub { display: block; font-size: .78rem; color: #94a3b8; margin-top: 2px; }
    .cell-empty { color: #cbd5e1; }
    .cell-mono { font-family: monospace; font-size: .84rem; color: #64748b; }
    .cell-error { color: #dc2626; font-size: .84rem; font-weight: 600; }

    .badge { display: inline-flex; align-items: center; padding: 5px 12px; border-radius: 8px; font-size: .8rem; font-weight: 700; white-space: nowrap; }
    .badge-role { background: #eff6ff; color: #1d4ed8; border: 1px solid #bfdbfe; }
    .badge-duration { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .badge-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
    .badge-failed { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .badge-locked { background: #fdf4ff; color: #86198f; border: 1px solid #e879f9; }

    @@media (max-width: 768px) {
        .stats-grid { grid-template-columns: repeat(2, 1fr); }
        .filters-grid { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 640px) {
        .stats-grid { grid-template-columns: 1fr; }
        .filters-grid { grid-template-columns: 1fr; }
    }
</style>

@code {
    private bool _authorized = false;
    private bool _loading = true;
    private List<LoginHistoryDto> _records = new();
    private LoginHistoryFilterDto _filter = new();
    private LoginStatsDto _stats = new();
    private string _filterStatusText = "";
    private List<LookupDto> _usersLookup = new();
private string _filterUserIdText = "";
    private System.Timers.Timer? _searchTimer;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!UserSession.IsLoggedIn)
            {
                var restored = await UserSession.TryRestoreSessionAsync();
                if (!restored) { Navigation.NavigateTo("/login"); return; }
                if (!PermissionService.IsLoaded)
                    await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            }

            if (!PermissionService.CanView("SCR_LOGINLOG"))
            { Navigation.NavigateTo("/access-denied"); return; }

            _authorized = true;

            // فلتر افتراضي: آخر 7 أيام
            _filter.DateFrom = DateTime.Today.AddDays(-7);
            _filter.DateTo = DateTime.Today;
            _usersLookup = await LoginHistoryService.GetUsersLookupAsync();

            await LoadData();
            StateHasChanged();
        }
    }

    private async Task LoadData()
    {
        try
        {
            _loading = true;
            StateHasChanged();

            _filter.LoginStatus = string.IsNullOrEmpty(_filterStatusText) ? null : int.Parse(_filterStatusText);
            _filter.Username = string.IsNullOrEmpty(_filterUserIdText) ? null : _filterUserIdText;

            _records = await LoginHistoryService.GetAllAsync(_filter);
            _stats = await LoginHistoryService.GetStatsAsync(_filter.DateFrom, _filter.DateTo);
        }
        catch { }
        finally { _loading = false; }
    }

    private async Task ApplyFilters() => await LoadData();

    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _searchTimer?.Stop();
        _searchTimer?.Dispose();
        _searchTimer = new System.Timers.Timer(400);
        _searchTimer.Elapsed += async (s, args) =>
        {
            _searchTimer?.Stop();
            await InvokeAsync(async () => { await LoadData(); StateHasChanged(); });
        };
        _searchTimer.AutoReset = false;
        _searchTimer.Start();
    }

    private async Task ResetFilters()
    {
        _filter = new LoginHistoryFilterDto
        {
            DateFrom = DateTime.Today.AddDays(-7),
            DateTo = DateTime.Today
        };
        _filterStatusText = "";
        _filterUserIdText = "";
        await LoadData();
    }

    private string GetStatusBadgeClass(int status) => status switch
    {
        1 => "badge-success",
        2 => "badge-failed",
        3 => "badge-locked",
        _ => ""
    };

    private void ExportData() { }
}