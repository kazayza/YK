@page "/login-history"
@using YKCoatings.Models
@using YKCoatings.Services
@inject LoginHistoryService LoginHistoryService
@inject UserService UserService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>سجل الدخول - Gold Edition Tabs</PageTitle>

@if (!_authorized)
{<div class="no-access-luxury" dir="rtl"><h4>جاري التحقق...</h4></div>}
else
{
<div class="luxury-page full-width" dir="rtl">
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
        <div class="lh-content">
            <div class="lh-right">
                <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                <div class="lh-text">
                    <h2 class="lh-title">سجل الدخول والجلسات</h2>
                    <p class="lh-subtitle"></p>
                </div>
            </div>
            <div class="lh-actions">
                <span class="lh-badge"><span class="lh-dot"></span>@_records.Count سجل</span>
                <span class="lh-badge" style="background:rgba(16,185,129,.1);color:#059669;border-color:rgba(16,185,129,.15)">ناجح: @_stats.SuccessCount</span>
                <span class="lh-badge" style="background:rgba(239,68,68,.08);color:#dc2626;border-color:rgba(239,68,68,.15)">فاشل: @_stats.FailedPasswordCount</span>
                @if (PermissionService.CanExport("SCR_LOGINLOG")){
                    <button class="btn-luxury btn-ghost-luxury" @onclick="ExportData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l12 5-12 5v-5z"/></svg>تصدير</button>
                }
            </div>
        </div>
    </div>

    <div class="stats-luxury">
        <div class="stat-luxury"><div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><div class="st-info"><span class="st-value">@_stats.TotalAttempts</span><span class="st-label">إجمالي المحاولات</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg></div><div class="st-info"><span class="st-value">@_stats.SuccessCount</span><span class="st-label">دخول ناجح</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div><div class="st-info"><span class="st-value">@_stats.FailedPasswordCount</span><span class="st-label">كلمة مرور خطأ</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><div class="st-info"><span class="st-value">@_stats.FailedLockedCount</span><span class="st-label">محاولات محظورة</span></div><div class="st-gold-line"></div></div>
        <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div class="st-info"><span class="st-value">@_stats.UniqueUsers</span><span class="st-label">مستخدم فريد</span></div><div class="st-gold-line"></div></div>
    </div>

    <div class="filter-luxury">
        <div class="select-wrap-luxury"><input type="date" @bind="_filter.DateFrom" @bind:after="ApplyFilters" style="height:42px;border:1.5px solid #e8e2d0;border-radius:12px;padding:0 12px;font-family:'Tajawal';font-size:.82rem" /><small style="font-size:.65rem;color:#8B95A5;margin-right:4px">من</small></div>
        <div class="select-wrap-luxury"><input type="date" @bind="_filter.DateTo" @bind:after="ApplyFilters" style="height:42px;border:1.5px solid #e8e2d0;border-radius:12px;padding:0 12px;font-family:'Tajawal';font-size:.82rem" /><small style="font-size:.65rem;color:#8B95A5;margin-right:4px">إلى</small></div>
        <div class="select-wrap-luxury"><select @bind="_filterUserIdText" @bind:after="ApplyFilters"><option value="">كل المستخدمين</option>@foreach(var user in _usersLookup){<option value="@user.Code">@user.Name</option>}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
        <div class="search-luxury" style="min-width:160px"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><input type="text" placeholder="IP..." @bind="_filter.IPAddress" @bind:event="oninput" @onkeyup="OnSearchKeyUp" /></div>
        <button class="btn-luxury btn-ghost-luxury" @onclick="ResetFilters"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>إعادة تعيين</button>
    </div>

    <div class="mudtabs-luxury">
        <div class="mudtabs-header-luxury">
            <button class="mudtab-btn-luxury @(activeTab=="all"?"active":"")" @onclick='()=>activeTab="all"'>
                <span class="mt-icon" style="background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
                الكل <span class="mt-count">@_records.Count</span>
            </button>
            <button class="mudtab-btn-luxury @(activeTab=="success"?"active":"")" @onclick='()=>activeTab="success"'>
                <span class="mt-icon" style="background:#ecfdf5;color:#059669;border:1px solid #a7f3d0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/></svg></span>
                ناجح <span class="mt-count">@_records.Count(r=>r.LoginStatus==1)</span>
            </button>
            <button class="mudtab-btn-luxury @(activeTab=="failed"?"active":"")" @onclick='()=>activeTab="failed"'>
                <span class="mt-icon" style="background:#fef2f2;color:#ef4444;border:1px solid #fecaca"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></span>
                فشل كلمة مرور <span class="mt-count">@_records.Count(r=>r.LoginStatus==2)</span>
            </button>
            <button class="mudtab-btn-luxury @(activeTab=="locked"?"active":"")" @onclick='()=>activeTab="locked"'>
                <span class="mt-icon" style="background:#f5f3ff;color:#7c3aed;border:1px solid #ddd6fe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></span>
                محظور <span class="mt-count gold">@_records.Count(r=>r.LoginStatus==3)</span>
            </button>
        </div>
        <div class="mudtabs-body-luxury">
            @if (_loading)
            {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل سجل الدخول...</p></div>}
            else if (!filteredRecords.Any())
            {<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></div><h4>لا يوجد سجلات</h4></div>}
            else
            {
                <div class="table-card-luxury full">
                    <div class="card-head-luxury"><h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>سجل الدخول — كامل العرض — @filteredRecords.Count سجل</h3></div>
                    <div class="table-responsive">
                        <table class="table-luxury detailed">
                            <thead><tr><th class="th-num">#</th><th>المستخدم</th><th>الدور</th><th>وقت الدخول</th><th>وقت الخروج</th><th>المدة</th><th>الحالة</th><th>IP</th><th>الجهاز</th><th>سبب الفشل</th></tr></thead>
                            <tbody>
                                @{int rowNum=0;}
                                @foreach(var rec in filteredRecords){rowNum++;
                                    <tr class="@(rec.LoginStatus!=1 ? "row-failed" : "")">
                                        <td class="td-num">@rowNum</td>
                                        <td><div class="acc-cell"><div class="user-avatar-luxury">@GetInitials(rec.Username)</div><div class="acc-info"><span class="acc-name">@rec.Username</span>@if(!string.IsNullOrEmpty(rec.FullName)){<span class="acc-name-en">@rec.FullName</span>}</div></div></td>
                                        <td><span class="coa-type type-1">@(rec.RoleNameAr ?? "—")</span></td>
                                        <td><span class="level-badge">@rec.LoginTime.ToString("dd/MM/yyyy")</span><br/><small style="color:#8B95A5">@rec.LoginTime.ToString("hh:mm:ss tt")</small></td>
                                        <td class="td-muted">@if(rec.LogoutTime.HasValue){<span>@rec.LogoutTime.Value.ToString("dd/MM/yyyy")<br/><small>@rec.LogoutTime.Value.ToString("hh:mm:ss tt")</small></span>}else{<span>—</span>}</td>
                                        <td class="td-center">@if(rec.SessionDuration.HasValue){<span class="level-badge">@rec.SessionDuration د</span>}else{<span style="color:#cbd5e1">—</span>}</td>
                                        <td><span class="status-badge-luxury" style="--sc:@GetStatusColor(rec.LoginStatus)"><span class="status-dot" style="--sc:@GetStatusColor(rec.LoginStatus)"></span>@rec.LoginStatusName</span></td>
                                        <td><span class="level-badge">@(rec.IPAddress ?? "—")</span></td>
                                        <td class="td-muted">@(rec.MachineName ?? "—")</td>
                                        <td class="td-muted">@if(!string.IsNullOrEmpty(rec.FailureReason)){<span style="color:#dc2626;font-weight:700">@rec.FailureReason</span>}else{<span>—</span>}</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;margin:0 auto}.luxury-page.full-width{max-width:100%;width:100%}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.15rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.7rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-luxury svg{width:14px;height:14px}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
.st-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.st-icon.dark{background:linear-gradient(135deg,var(--black2),var(--black3));color:var(--gold);border:1px solid var(--border-gold)}.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.2)}.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.st-icon.red{background:#fef2f2;color:#ef4444;border:1px solid #fecaca}.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.st-icon svg{width:18px;height:18px}.st-info{display:flex;flex-direction:column}.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}.st-gold-line{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}.stat-luxury:hover .st-gold-line{opacity:.8}
.filter-luxury{display:flex;gap:10px;flex-wrap:wrap;align-items:center;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:12px}
.search-luxury{flex:1;min-width:140px;position:relative;display:flex;align-items:center}.search-luxury svg{position:absolute;right:12px;width:16px;height:16px;color:#9ca3af;pointer-events:none}.search-luxury input{width:100%;height:42px;padding:0 40px 0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.84rem;font-family:'Tajawal';outline:none;background:#fcfaf6;transition:.2s}.search-luxury input:focus{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.select-wrap-luxury{position:relative;display:flex;align-items:center}.select-wrap-luxury select{height:42px;padding:0 28px 0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.82rem;font-family:'Tajawal';background:#fff;appearance:none;cursor:pointer;outline:none;min-width:120px}.select-wrap-luxury .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.mudtabs-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}
.mudtabs-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5;z-index:2}
.mudtabs-header-luxury{position:relative;display:flex;gap:0;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #e8e2d0;padding:0 8px;overflow-x:auto;scrollbar-width:none}.mudtabs-header-luxury::-webkit-scrollbar{display:none}
.mudtab-btn-luxury{position:relative;display:flex;align-items:center;gap:8px;padding:14px 20px;background:transparent;border:none;border-bottom:2px solid transparent;font-family:'Tajawal';font-size:.82rem;font-weight:800;color:#8B95A5;cursor:pointer;transition:all .25s;white-space:nowrap;flex-shrink:0}
.mudtab-btn-luxury:hover{background:rgba(212,175,55,.05);color:#0A0F1E}.mudtab-btn-luxury.active{color:var(--gold-dark);background:rgba(212,175,55,.08);border-bottom-color:var(--gold)}
.mudtab-btn-luxury .mt-icon{width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.mt-icon svg{width:14px;height:14px}
.mt-count{background:#f3f4f6;color:#6b7280;padding:2px 8px;border-radius:999px;font-size:.68rem;font-weight:800}.mt-count.gold{background:rgba(212,175,55,.15);color:var(--gold-dark)}
.mudtabs-body-luxury{padding:18px;background:#fff;min-height:400px}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}.table-card-luxury.full{width:100%}.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.card-head-luxury{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8;flex-wrap:wrap;gap:8px}.card-head-luxury h3{font-size:.9rem;font-weight:800;color:#0A0F1E;display:flex;align-items:center;gap:8px;margin:0}.card-head-luxury h3 svg{width:16px;height:16px;color:var(--gold-dark)}
.table-responsive{overflow-x:auto}.table-luxury{width:100%;border-collapse:collapse;min-width:1100px}.table-luxury thead{background:linear-gradient(135deg,#fcfaf6,#f8f6f0)}.table-luxury th{padding:12px 14px;font-size:.76rem;font-weight:800;color:#6b7280;text-align:right;border-bottom:2px solid #e8e2d0;white-space:nowrap}.table-luxury td{padding:12px 14px;font-size:.84rem;color:#374151;border-bottom:1px solid #f3f4f6;vertical-align:middle}.table-luxury tbody tr:hover{background:rgba(212,175,55,.03)}
.th-num{width:45px;text-align:center}.td-num{text-align:center;color:#9ca3af;font-size:.78rem}.td-center{text-align:center}.td-muted{color:#6b7280;font-size:.82rem}
.level-badge{font-family:monospace;font-weight:700;background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb;padding:3px 8px;border-radius:999px;font-size:.72rem}
.coa-type{font-size:.68rem;padding:3px 8px;border-radius:6px;font-weight:800;border:1px solid}.type-1{background:#eff6ff;color:#2563eb;border-color:#dbeafe}
.status-badge-luxury{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,white)}.status-dot{width:6px;height:6px;border-radius:50%;background:var(--sc)}
.acc-cell{display:flex;align-items:center;gap:10px}.acc-info{display:flex;flex-direction:column}.acc-name{font-weight:800;color:#0A0F1E;font-size:.86rem}.acc-name-en{font-weight:600;color:#8B95A5;font-size:.72rem}
.user-avatar-luxury{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,#070B14,#0A0F1E);color:var(--gold);font-weight:900;font-size:.74rem;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid rgba(212,175,55,.2)}
.row-failed{background:#fef2f2 !important}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}@@keyframes spin{to{transform:rotate(360deg)}}
.empty-luxury{text-align:center;padding:60px 20px;background:#fff;border-radius:18px;border:1px solid #e8e2d0}.empty-icon-luxury{width:56px;height:56px;margin:0 auto 12px;border-radius:14px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.empty-icon-luxury svg{width:28px;height:28px}.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}
</style>

@code {
    private bool _authorized = false;
    private bool _loading = true;
    private List<LoginHistoryDto> _records = new();
    private List<LoginHistoryDto> filteredRecords => _records.Where(r=>
        activeTab switch{
            "success"=>r.LoginStatus==1,
            "failed"=>r.LoginStatus==2,
            "locked"=>r.LoginStatus==3,
            _=>true
        }).ToList();
    private LoginHistoryFilterDto _filter = new();
    private LoginStatsDto _stats = new();
    private List<LookupDto> _usersLookup = new();
    private string _filterUserIdText = "";
    private System.Timers.Timer? _searchTimer;
    private string activeTab = "all";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!UserSession.IsLoggedIn){var restored=await UserSession.TryRestoreSessionAsync(); if(!restored){Navigation.NavigateTo("/login"); return;} if(!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);}
            if (!PermissionService.CanView("SCR_LOGINLOG")){Navigation.NavigateTo("/access-denied"); return;}
            _authorized=true; _filter.DateFrom=DateTime.Today.AddDays(-7); _filter.DateTo=DateTime.Today; _usersLookup=await LoginHistoryService.GetUsersLookupAsync(); await LoadData(); StateHasChanged();
        }
    }

    private async Task LoadData(){try{_loading=true; StateHasChanged(); _records=await LoginHistoryService.GetAllAsync(_filter); _stats=await LoginHistoryService.GetStatsAsync(_filter.DateFrom, _filter.DateTo);}catch{}finally{_loading=false;}}
    private async Task ApplyFilters()=>await LoadData();
    private void OnSearchKeyUp(KeyboardEventArgs e){_searchTimer?.Stop(); _searchTimer?.Dispose(); _searchTimer=new System.Timers.Timer(400); _searchTimer.Elapsed+=async (s,args)=>{_searchTimer?.Stop(); await InvokeAsync(async()=>{await LoadData(); StateHasChanged();});}; _searchTimer.AutoReset=false; _searchTimer.Start();}
    private async Task ResetFilters(){_filter=new LoginHistoryFilterDto{DateFrom=DateTime.Today.AddDays(-7), DateTo=DateTime.Today}; await LoadData();}
    private string GetStatusColor(int status)=>status switch{1=>"#10b981",2=>"#ef4444",3=>"#7c3aed",_=>"#6b7280"};
    private string GetInitials(string name){if(string.IsNullOrWhiteSpace(name)) return "U"; var parts=name.Split(' ', StringSplitOptions.RemoveEmptyEntries); return parts.Length>=2 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : parts[0][0].ToString().ToUpper();}
    private void ExportData(){}
