@page "/customer-groups"

@using YKCoatings.Models
@using YKCoatings.Services
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject CustomerGroupService CustomerGroupService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Microsoft.Extensions.Logging.ILogger<CustomerGroups> Logger

<PageTitle>مجموعات العملاء - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-luxury" dir="rtl"><h4>يجب تسجيل الدخول أولًا</h4></div>
}
else if (permissionLoadFailed)
{
    <div class="cg-page" dir="rtl">
        <div class="cg-alert error" role="alert">
            <span>تعذر التحقق من صلاحيات مجموعات العملاء.</span>
            <button class="btn-luxury btn-ghost-luxury" @onclick="RetryPermissionsAsync" disabled="@isLoading">إعادة المحاولة</button>
        </div>
    </div>
}
else if (permissions?.CanView != true)
{
    <div class="no-access-luxury" dir="rtl"><h4>ليس لديك صلاحية عرض مجموعات العملاء</h4></div>
}
else
{
    <div class="cg-page" dir="rtl">
        <header class="cg-header">
            <div class="cg-title">
                <div class="cg-title-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
                </div>
                <div><h1>مجموعات العملاء</h1><p>تصنيف العملاء وتحديد خصم وقائمة أسعار افتراضيين</p></div>
            </div>
            <div class="cg-header-actions">
                <span class="cg-count">@(hasLoadedGroups ? $"{filteredGroups.Count} مجموعة" : isLoading ? "جارٍ التحميل" : "العدد غير متاح")</span>
                <button type="button" class="btn-luxury btn-ghost-luxury" @onclick='() => Navigation.NavigateTo("/customers")'>العودة للعملاء</button>
                @if (permissions.CanAdd)
                {
                    <button type="button" class="btn-luxury btn-primary-luxury" @onclick="ShowAdd">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
                        مجموعة جديدة
                    </button>
                }
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(resultMessage))
        {
            <div class="cg-alert @(resultSuccess ? "success" : "error")" role="status">
                <span>@resultMessage</span>
                <button type="button" class="cg-alert-close" aria-label="إغلاق" @onclick="() => resultMessage = string.Empty">×</button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="cg-alert error" role="alert">
                <span>@loadError</span>
                <button type="button" class="btn-luxury btn-ghost-luxury" @onclick="LoadData" disabled="@isLoading">إعادة تحميل المجموعات</button>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(priceListLoadError))
        {
            <div class="cg-alert warning" role="alert">
                <span>تعذر تحديث قوائم الأسعار؛ لن تتأثر بيانات المجموعات، لكن راجع القائمة المرتبطة قبل التعديل.</span>
                <button type="button" class="btn-luxury btn-ghost-luxury" @onclick="LoadPriceListsAsync" disabled="@isLoadingPriceLists">إعادة تحميل القوائم</button>
            </div>
        }

        <section class="cg-toolbar" aria-label="البحث والتصفية">
            <div class="cg-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="search" placeholder="بحث بالكود أو الاسم..." @bind="searchText" @bind:event="oninput" @bind:after="ApplyFilter" />
            </div>
            <select class="cg-filter" @bind="statusFilter" @bind:after="ApplyFilter" aria-label="تصفية حسب الحالة">
                <option value="all">كل الحالات</option>
                <option value="active">النشطة</option>
                <option value="inactive">غير النشطة</option>
            </select>
            <button type="button" class="btn-luxury btn-ghost-luxury" @onclick="LoadData" disabled="@isLoading">@(isLoading ? "جارٍ التحديث..." : "تحديث")</button>
        </section>

        @if (!hasLoadedGroups && isLoading)
        {
            <div class="cg-state" role="status"><span class="cg-spinner"></span> جاري تحميل مجموعات العملاء...</div>
        }
        else if (!hasLoadedGroups && !string.IsNullOrWhiteSpace(loadError))
        {
            <div class="cg-state error" role="alert">تعذر عرض البيانات حتى ينجح التحميل.</div>
        }
        else if (hasLoadedGroups && filteredGroups.Count == 0)
        {
            <div class="cg-state">لا توجد مجموعات مطابقة للبحث أو التصفية.</div>
        }
        else if (hasLoadedGroups)
        {
            <div class="cg-table-wrap">
                <div class="cg-table-scroll">
                    <table class="cg-table">
                        <thead>
                            <tr><th>#</th><th>الكود</th><th>المجموعة (عربي)</th><th>الاسم الإنجليزي</th><th>خصم المجموعة</th><th>قائمة الأسعار</th><th>العملاء</th><th>الحالة</th><th>الوصف</th><th>الإجراءات</th></tr>
                        </thead>
                        <tbody>
                            @{ var rowNumber = 0; }
                            @foreach (var group in filteredGroups)
                            {
                                rowNumber++;
                                <tr>
                                    <td class="cg-muted">@rowNumber</td>
                                    <td><code class="cg-code">@group.GroupCode</code></td>
                                    <td class="cg-name">@group.GroupNameAr</td>
                                    <td class="cg-muted" dir="ltr">@(group.GroupNameEn ?? "—")</td>
                                    <td><span class="cg-discount">@group.DiscountPercent.ToString("0.##")%</span></td>
                                    <td class="cg-muted">@GetPriceListLabel(group)</td>
                                    <td><span class="cg-customer-count">@group.CustomerCount</span></td>
                                    <td><span class="cg-status @(group.IsActive ? "active" : "inactive")">@(group.IsActive ? "نشطة" : "غير نشطة")</span></td>
                                    <td class="cg-description">@(string.IsNullOrWhiteSpace(group.Description) ? "—" : group.Description)</td>
                                    <td>
                                        <div class="cg-row-actions">
                                            @if (permissions.CanEdit)
                                            {
                                                <button type="button" class="cg-icon-btn edit" title="تعديل" @onclick="() => ShowEdit(group)">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
                                                </button>
                                            }
                                            @if (group.IsActive && permissions.CanDelete)
                                            {
                                                <button type="button" class="cg-icon-btn disable" title="تعطيل" @onclick="() => ChangeStatusAsync(group, false)" disabled="@isChangingStatus">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6M9 9l6 6"/></svg>
                                                </button>
                                            }
                                            else if (!group.IsActive && permissions.CanEdit)
                                            {
                                                <button type="button" class="cg-icon-btn enable" title="تفعيل" @onclick="() => ChangeStatusAsync(group, true)" disabled="@isChangingStatus">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4 12 14.01l-3-3"/></svg>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="cg-table-footer">المعروض @filteredGroups.Count مجموعة — إجمالي السجلات المحمّلة @groups.Count</div>
            </div>
        }
    </div>

    @if (showForm)
    {
        <div class="cg-modal-backdrop" @onclick="CloseForm">
            <section class="cg-modal" role="dialog" aria-modal="true" aria-labelledby="cg-modal-title" @onclick:stopPropagation="true">
                <div class="cg-modal-topline"></div>
                <header class="cg-modal-header">
                    <div><h2 id="cg-modal-title">@(editItem.GroupID == 0 ? "إضافة مجموعة عملاء" : "تعديل مجموعة العملاء")</h2><p>الخصم والقائمة هنا قيم افتراضية للعميل ويمكن تعديلها في بطاقة العميل.</p></div>
                    <button type="button" class="cg-alert-close" aria-label="إغلاق" @onclick="CloseForm" disabled="@isSaving">×</button>
                </header>
                <form class="cg-form" @onsubmit="SaveGroupAsync" @onsubmit:preventDefault="true">
                    @if (!string.IsNullOrWhiteSpace(formMessage))
                    {
                        <div class="cg-alert error" role="alert">@formMessage</div>
                    }
                    <div class="cg-form-grid">
                        <label class="cg-field"><span>كود المجموعة <b>*</b></span><input @bind="editItem.GroupCode" maxlength="20" required dir="ltr" autocomplete="off" disabled="@isSaving" placeholder="WHL" /></label>
                        <label class="cg-field"><span>الاسم بالعربية <b>*</b></span><input @bind="editItem.GroupNameAr" maxlength="100" required disabled="@isSaving" placeholder="عملاء جملة" /></label>
                        <label class="cg-field"><span>الاسم بالإنجليزية</span><input @bind="editItem.GroupNameEn" maxlength="100" dir="ltr" disabled="@isSaving" placeholder="Wholesale" /></label>
                        <label class="cg-field"><span>خصم افتراضي (%) <b>*</b></span><input type="number" @bind="editItem.DiscountPercent" min="0" max="100" step="0.01" required disabled="@isSaving" /></label>
                        <label class="cg-field cg-field-wide"><span>قائمة الأسعار الافتراضية</span>
                            <select @bind="editItem.PriceListID" disabled="@isSaving">
                                <option value="">بدون قائمة خاصة — استخدم الافتراضية</option>
                                @foreach (var list in priceLists)
                                {
                                    <option value="@list.Id">@list.Name</option>
                                }
                                @if (editItem.PriceListID.HasValue && !priceLists.Any(x => x.Id == editItem.PriceListID.Value))
                                {
                                    <option value="@editItem.PriceListID.Value">@(editItem.PriceListID.Value < 0 ? $"القيمة الحالية {editItem.PriceListID.Value} (قيمة قديمة غير معرّفة)" : $"القائمة الحالية #{editItem.PriceListID.Value} (غير موجودة ضمن القوائم النشطة)")</option>
                                }
                            </select>
                            @if (!hasLoadedPriceLists)
                            {
                                <small>قائمة الاختيار لم تُحمّل؛ القيمة الحالية محفوظة حتى يختار المستخدم غيرها.</small>
                            }
                        </label>
                        <label class="cg-field cg-field-wide"><span>الوصف</span><textarea @bind="editItem.Description" maxlength="500" rows="3" disabled="@isSaving" placeholder="ملاحظات المجموعة أو سياسة التعامل..."></textarea></label>
                    </div>
                    <footer class="cg-modal-footer">
                        <button type="submit" class="btn-luxury btn-primary-luxury" disabled="@isSaving">
                            @(isSaving ? "جارٍ الحفظ..." : editItem.GroupID == 0 ? "إضافة المجموعة" : "حفظ التعديلات")
                        </button>
                        <button type="button" class="btn-luxury btn-ghost-luxury" @onclick="CloseForm" disabled="@isSaving">إلغاء</button>
                    </footer>
                </form>
            </section>
        </div>
    }
}

