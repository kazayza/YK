@code {
    private ModulePermissionDto? permissions;
    private bool permissionLoadFailed;
    private bool isLoading;
    private bool hasLoadedGroups;
    private bool isLoadingPriceLists;
    private bool hasLoadedPriceLists;
    private bool isSaving;
    private bool isChangingStatus;
    private bool showForm;
    private List<CustomerGroupDto> groups = new();
    private List<CustomerGroupDto> filteredGroups = new();
    private List<LookupDto> priceLists = new();
    private CustomerGroupDto editItem = new();
    private string searchText = string.Empty;
    private string statusFilter = "all";
    private string loadError = string.Empty;
    private string priceListLoadError = string.Empty;
    private string formMessage = string.Empty;
    private string resultMessage = string.Empty;
    private bool resultSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadPermissionsAsync();
        if (permissions?.CanView == true)
            await LoadData();
    }

    private async Task RetryPermissionsAsync()
    {
        if (isLoading) return;
        await LoadPermissionsAsync();
        if (permissions?.CanView == true)
            await LoadData();
    }

    private async Task LoadPermissionsAsync()
    {
        permissionLoadFailed = false;
        permissions = null;
        try
        {
            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_CUSTOMERS");
        }
        catch (UnauthorizedAccessException)
        {
            permissions = null;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load customer-group page permissions.");
            permissionLoadFailed = true;
        }
    }

    private async Task LoadData()
    {
        if (permissions?.CanView != true || isLoading) return;

        isLoading = true;
        loadError = string.Empty;
        StateHasChanged();
        try
        {
            var loadedGroups = await CustomerGroupService.GetAllAsync(includeInactive: true);
            groups = loadedGroups;
            ApplyFilter();
            hasLoadedGroups = true;
        }
        catch (UnauthorizedAccessException)
        {
            groups = new();
            filteredGroups = new();
            hasLoadedGroups = false;
            loadError = "ليس لديك صلاحية عرض مجموعات العملاء.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load customer groups.");
            loadError = hasLoadedGroups
                ? "تعذر تحديث مجموعات العملاء؛ المعروض آخر تحميل ناجح."
                : "تعذر تحميل مجموعات العملاء. أعد المحاولة.";
        }
        finally
        {
            isLoading = false;
        }

        if (hasLoadedGroups && !hasLoadedPriceLists)
            await LoadPriceListsAsync();
    }

    private async Task LoadPriceListsAsync()
    {
        if (isLoadingPriceLists) return;
        isLoadingPriceLists = true;
        priceListLoadError = string.Empty;
        try
        {
            var loadedLists = await LookupService.GetPriceListsAsync();
            priceLists = loadedLists;
            hasLoadedPriceLists = true;
        }
        catch (UnauthorizedAccessException)
        {
            priceLists = new();
            hasLoadedPriceLists = false;
            priceListLoadError = "ليس لديك صلاحية قراءة قوائم الأسعار.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load price-list options for customer groups.");
            priceListLoadError = "تعذر تحميل قوائم الأسعار.";
        }
        finally
        {
            isLoadingPriceLists = false;
        }
    }

    private void ApplyFilter()
    {
        IEnumerable<CustomerGroupDto> query = groups;
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var value = searchText.Trim();
            query = query.Where(group =>
                group.GroupCode.Contains(value, StringComparison.OrdinalIgnoreCase)
                || group.GroupNameAr.Contains(value, StringComparison.OrdinalIgnoreCase)
                || (group.GroupNameEn?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        query = statusFilter switch
        {
            "active" => query.Where(group => group.IsActive),
            "inactive" => query.Where(group => !group.IsActive),
            _ => query
        };
        filteredGroups = query.ToList();
    }

    private string GetPriceListLabel(CustomerGroupDto group)
    {
        if (!group.PriceListID.HasValue || group.PriceListID.Value == 0)
            return "غير محددة — القائمة الافتراضية";
        if (group.PriceListID.Value < 0)
            return $"قيمة قديمة ({group.PriceListID.Value}) — غير مستخدمة كتسعير";
        return group.PriceListName ?? $"قائمة #{group.PriceListID.Value}";
    }

    private void ShowAdd()
    {
        if (permissions?.CanAdd != true) return;
        editItem = new CustomerGroupDto { DiscountPercent = 0, IsActive = true };
        formMessage = string.Empty;
        showForm = true;
    }

    private void ShowEdit(CustomerGroupDto group)
    {
        if (permissions?.CanEdit != true) return;
        editItem = new CustomerGroupDto
        {
            GroupID = group.GroupID,
            GroupCode = group.GroupCode,
            GroupNameAr = group.GroupNameAr,
            GroupNameEn = group.GroupNameEn,
            DiscountPercent = group.DiscountPercent,
            PriceListID = group.PriceListID,
            PriceListName = group.PriceListName,
            Description = group.Description,
            IsActive = group.IsActive,
            CreatedDate = group.CreatedDate,
            CustomerCount = group.CustomerCount
        };
        formMessage = string.Empty;
        showForm = true;
    }

    private void CloseForm()
    {
        if (isSaving) return;
        showForm = false;
        formMessage = string.Empty;
    }

    private async Task SaveGroupAsync()
    {
        if (isSaving) return;
        if (editItem.GroupID == 0 && permissions?.CanAdd != true) return;
        if (editItem.GroupID > 0 && permissions?.CanEdit != true) return;

        isSaving = true;
        formMessage = string.Empty;
        try
        {
            if (editItem.GroupID == 0)
                await CustomerGroupService.InsertAsync(editItem, UserSession.UserID);
            else
                await CustomerGroupService.UpdateAsync(editItem, UserSession.UserID);

            showForm = false;
            resultMessage = editItem.GroupID == 0 ? "تمت إضافة مجموعة العملاء." : "تم حفظ تعديلات مجموعة العملاء.";
            resultSuccess = true;
            await LoadData();
        }
        catch (ArgumentException ex)
        {
            formMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            formMessage = ex.Message;
        }
        catch (UnauthorizedAccessException)
        {
            formMessage = "ليس لديك صلاحية تنفيذ هذه العملية.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to save customer group {GroupID}.", editItem.GroupID);
            formMessage = "تعذر حفظ مجموعة العملاء. لم تُعرض تفاصيل تقنية.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ChangeStatusAsync(CustomerGroupDto group, bool isActive)
    {
        if (isChangingStatus) return;
        if (isActive && permissions?.CanEdit != true) return;
        if (!isActive && permissions?.CanDelete != true) return;

        var action = isActive ? "تفعيل" : "تعطيل";
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد {action} مجموعة {group.GroupNameAr}؟");
        if (!confirmed) return;

        isChangingStatus = true;
        try
        {
            var result = await CustomerGroupService.SetActiveAsync(group.GroupID, isActive, UserSession.UserID);
            resultMessage = result.Message;
            resultSuccess = result.Success;
            if (result.Success)
                await LoadData();
        }
        catch (UnauthorizedAccessException)
        {
            resultMessage = "ليس لديك صلاحية تنفيذ هذه العملية.";
            resultSuccess = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to change status for customer group {GroupID}.", group.GroupID);
            resultMessage = "تعذر تغيير حالة مجموعة العملاء.";
            resultSuccess = false;
        }
        finally
        {
            isChangingStatus = false;
        }
    }
}
