@code {
    private List<SalesOrderListDto>? orders;
    private List<SalesOrderListDto> filtered = new();
    private ModulePermissionDto? permissions;
    private string searchText = "";
    private int filterStatus = 0;
    private int filterSource = 0;
    private bool isExporting = false;
    private string toast = "";
    private bool toastOk = true;
    private bool showAddMenu = false;
    private bool showDeleteDialog = false;
    private SalesOrderListDto? deleteOrder;
    private string deleteMsg = "";

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_SO");
        if (permissions != null && permissions.CanView) await LoadData();
    }
    private async Task LoadData(){orders = await SoService.GetOrdersListAsync();Filter();}
    private void Filter()
    {
        if (orders == null) return;
        filtered = orders.Where(o =>
            (filterStatus == 0 || o.OrderStatus == filterStatus) &&
            (filterSource == 0 || o.OrderSource == filterSource) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(o.OrderNumber, searchText) ||
             ArabicSearchHelper.Contains(o.CustomerNameAr, searchText) ||
             ArabicSearchHelper.Contains(o.LinkedQuotationNumber, searchText) ||
             ArabicSearchHelper.Contains(o.SalesRepName, searchText))
        ).ToList();
    }
    private void ClearSearch() { searchText = ""; Filter(); }
    private void ToggleAddMenu() { showAddMenu = !showAddMenu; }
    private void CloseAddMenu() { showAddMenu = false; }
    private void AddManual(){showAddMenu=false;Navigation.NavigateTo("/sales-orders/new?source=manual");}
    private void AddFromQuotation(){showAddMenu=false;Navigation.NavigateTo("/sales-orders/new?source=quotation");}
    private void ViewOrder(int id)
    {
        var so = orders?.FirstOrDefault(o => o.SalesOrderID == id);
        if (so != null && so.OrderStatus == 2 && permissions != null && permissions.CanApprove) Navigation.NavigateTo($"/sales-orders/edit/{id}");
        else Navigation.NavigateTo($"/sales-orders/view/{id}");
    }
    private void EditOrder(int id) => Navigation.NavigateTo($"/sales-orders/edit/{id}");
    private async Task PrintOrder(int id)
    {
        try{var html = await SoService.GenerateReportHtmlAsync(id, UserSession.UserID);await JS.InvokeVoidAsync("printHtml", html);}
        catch (Exception ex){toast="خطأ في الطباعة: "+ex.Message;toastOk=false;}
    }
    private async Task ExportExcel()
    {
        if (!filtered.Any()) return;isExporting=true;StateHasChanged();
        try{var bytes = await SoService.ExportToExcelAsync(filtered, UserSession.UserID);await JS.InvokeVoidAsync("downloadFile",$"SalesOrders_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",Convert.ToBase64String(bytes));}
        catch (Exception ex){toast="خطأ: "+ex.Message;toastOk=false;}
        finally{isExporting=false;}
    }
    private void ShowDeleteDialog(SalesOrderListDto so){deleteOrder=so;deleteMsg="";showDeleteDialog=true;}
    private void CloseDeleteDialog(){showDeleteDialog=false;}
    private async Task ConfirmDelete()
    {
        if (deleteOrder==null) return;
        try{
            var result=await SoService.DeleteOrderAsync(deleteOrder.SalesOrderID, UserSession.UserID);
            if(result.Success){toast=result.Message+" ";toastOk=true;showDeleteDialog=false;await LoadData();}
            else{deleteMsg=result.Message;}
        }catch(Exception ex){deleteMsg="خطأ: "+ex.Message;}
    }
}
