@page "/sales-orders"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject SalesOrderService SoService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>أوامر البيع - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول أولاً</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4><button class="btn-luxury btn-ghost-luxury" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة للرئيسية</button></div>}
else
{
    <div class="luxury-page" dir="rtl">
        <div class="luxury-header-hybrid" style="overflow:visible !important">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content" style="overflow:visible !important">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">أوامر البيع</h2><p class="lh-subtitle">أوامر البيع اختيارية - الفاتورة هي الأساس - نفس نظام المشتريات</p></div>
                </div>
                <div class="lh-actions" style="overflow:visible !important">
                    <span class="lh-badge"><span class="lh-dot"></span>@filtered.Count أمر</span>
                    @if (permissions.CanExport)
                    {
                        <button class="btn-luxury btn-export-luxury" @onclick="ExportExcel" disabled="@isExporting">
                            @if (isExporting){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>}
                            Excel
                        </button>
                    }
                    @if (permissions.CanAdd)
                    {
                        <div class="add-dropdown-wrap-luxury" style="overflow:visible !important">
                            <button class="btn-luxury btn-primary-luxury" @onclick="ToggleAddMenu">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>أمر بيع جديد
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:10px"><path d="m6 9 6 6 6-6"/></svg>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (showAddMenu)
        {
            <div class="add-dropdown-portal-luxury" dir="rtl">
                <div class="ml-gold-line"></div>
                <div class="portal-head"><span>اختر نوع أمر البيع</span><button class="btn-close-x" @onclick="CloseAddMenu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
                <div class="add-opt-luxury" @onclick="AddManual"><span class="add-opt-icon" style="background:rgba(212,175,55,.1);color:#9C7C2E;border:1px solid rgba(212,175,55,.15)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></span><div><div class="add-opt-title">أمر بيع يدوي</div><div class="add-opt-desc">إنشاء أمر بيع مباشر بدون عرض سعر</div></div><svg class="opt-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></div>
                <div class="add-opt-luxury" @onclick="AddFromQuotation"><span class="add-opt-icon" style="background:#eff6ff;color:#2563eb;border:1px solid #dbeafe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></span><div><div class="add-opt-title">من عرض سعر</div><div class="add-opt-desc">تحويل عرض سعر معتمد لأمر بيع</div></div><svg class="opt-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></div>
            </div>
            <div class="add-overlay-portal-luxury" @onclick="CloseAddMenu"></div>
        }

        <div class="workflow-luxury">
            <div class="wf-step done"><span class="wf-num">1</span><span>عرض سعر</span><div class="wf-line"></div></div>
            <div class="wf-step active"><span class="wf-num">2</span><span>أمر بيع</span><div class="wf-line"></div></div>
            <div class="wf-step"><span class="wf-num">3</span><span>فاتورة</span><div class="wf-line"></div></div>
            <div class="wf-step"><span class="wf-num">4</span><span>مرتجع</span><div class="wf-line"></div></div>
            <div class="wf-step"><span class="wf-num">5</span><span>قبض</span></div>
        </div>

        @if (orders != null)
        {
            <div class="stats-luxury">
                <div class="stat-luxury"><div class="st-icon gray"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></div><div class="st-info"><span class="st-value">@orders.Count(o => o.OrderStatus == 1)</span><span class="st-label">مسودة</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><div class="st-info"><span class="st-value">@orders.Count(o => o.OrderStatus == 2)</span><span class="st-label">انتظار اعتماد</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div class="st-info"><span class="st-value">@orders.Count(o => o.OrderStatus == 3)</span><span class="st-label">معتمد</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><circle cx="19" cy="7" r="3"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg></div><div class="st-info"><span class="st-value">@orders.Count(o => o.OrderStatus == 5)</span><span class="st-label">قيد التجهيز</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><div class="st-info"><span class="st-value">@orders.Sum(o => o.ItemCount)</span><span class="st-label">إجمالي الأصناف</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon red"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div><div class="st-info"><span class="st-value">@orders.Count(o => o.IsOverdue)</span><span class="st-label">متأخر</span></div><div class="st-gold-line"></div></div>
            </div>
        }

        <div class="filter-luxury">
            <div class="search-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input type="text" placeholder="بحث برقم الأمر أو العميل أو عرض السعر..." @bind="searchText" @bind:event="oninput" @onkeyup="Filter" />@if (!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}</div>
            <div class="select-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M7 12h10"/><path d="M10 18h4"/></svg><select @bind="filterStatus" @bind:after="Filter"><option value="0">كل الحالات</option><option value="1">مسودة</option><option value="2">انتظار اعتماد</option><option value="3">معتمد</option><option value="4">مرفوض</option><option value="5">قيد التجهيز</option><option value="7">ملغي</option><option value="8">مغلق</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg><select @bind="filterSource" @bind:after="Filter"><option value="0">كل المصادر</option><option value="1">يدوي</option><option value="2">من عرض سعر</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        @if (orders == null)
        {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else if (!filtered.Any())
        {<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/></svg></div><h4>لا توجد أوامر بيع</h4><p class="empty-sub">أمر البيع اختياري - يمكنك إنشاء فاتورة مباشرة</p></div>}
        else
        {
            <div class="table-card-luxury">
                <div class="table-responsive">
                    <table class="table-luxury">
                        <thead><tr><th class="th-num">#</th><th>رقم الأمر</th><th>التاريخ</th><th>المصدر</th><th>العميل</th><th>عرض السعر</th><th>المندوب</th><th class="th-center">أصناف</th><th>الإجمالي</th><th>التسليم المتوقع</th><th class="th-center">الحالة</th><th class="th-actions">إجراءات</th></tr></thead>
                        <tbody>
                            @{int n=0;}
                            @foreach (var so in filtered){n++;
                                <tr class="@(so.OrderStatus==1?"row-draft":"") @(so.IsOverdue?"row-overdue":"")">
                                    <td class="td-num">@n</td>
                                    <td><span class="doc-num-luxury" @onclick="() => ViewOrder(so.SalesOrderID)">@so.OrderNumber</span></td>
                                    <td class="td-muted">@so.OrderDate.ToString("dd/MM/yyyy")</td>
                                    <td><span class="source-badge-luxury" style="--sc:@SalesOrderService.GetSourceColor(so.OrderSource)">@SalesOrderService.GetSourceName(so.OrderSource)</span></td>
                                    <td class="td-name">@(so.CustomerNameAr ?? "—")</td>
                                    <td>@if (!string.IsNullOrEmpty(so.LinkedQuotationNumber)){<code class="quot-link-luxury">@so.LinkedQuotationNumber</code>}else{<span class="no-val">—</span>}</td>
                                    <td class="td-muted">@(so.SalesRepName ?? "—")</td>
                                    <td class="td-center"><span class="cnt-badge-luxury">@so.ItemCount</span></td>
                                    <td><span class="amount-luxury">@so.TotalAmount.ToString("#,##0.00")</span></td>
                                    <td>@if (so.ExpectedDeliveryDate.HasValue){<span class="@(so.IsOverdue?"overdue-date":"td-muted")">@so.ExpectedDeliveryDate.Value.ToString("dd/MM/yyyy") @if (so.IsOverdue){<span class="overdue-badge-luxury">متأخر @so.DaysOverdue يوم</span>}</span>}else{<span class="no-val">—</span>}</td>
                                    <td class="td-center"><span class="status-badge-luxury" style="--sc:@SalesOrderService.GetStatusColor(so.OrderStatus)">@SalesOrderService.GetStatusName(so.OrderStatus)</span></td>
                                    <td class="td-center"><div class="actions-wrap-luxury">
                                        @if (permissions.CanEdit && so.OrderStatus == 1){<button class="act-btn edit" title="تعديل" @onclick="() => EditOrder(so.SalesOrderID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                        else{<button class="act-btn view" title="عرض" @onclick="() => ViewOrder(so.SalesOrderID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>}
                                        @if (permissions.CanPrint){<button class="act-btn print" title="طباعة" @onclick="() => PrintOrder(so.SalesOrderID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg></button>}
                                        @if (permissions.CanApprove && so.OrderStatus == 2){<button class="act-btn approve" title="اعتماد" @onclick="() => ViewOrder(so.SalesOrderID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></button>}
                                        @if (permissions.CanDelete && so.OrderStatus == 1){<button class="act-btn delete" title="حذف" @onclick="() => ShowDeleteDialog(so)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}
                                    </div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>

    @if (showDeleteDialog)
    {
        <div class="modal-overlay-luxury" @onclick="CloseDeleteDialog"><div class="modal-card-luxury small" @onclick:stopPropagation="true">
            <div class="ml-gold-line danger"></div>
            <div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div>
            <h4>تأكيد الحذف</h4><p>هل أنت متأكد من حذف أمر البيع: <strong class="delete-name">@deleteOrder?.OrderNumber</strong>؟</p>
            @if (!string.IsNullOrEmpty(deleteMsg)){<div class="msg-luxury msg-error">@deleteMsg</div>}
            <div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDelete">تأكيد الحذف</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseDeleteDialog">إلغاء</button></div>
        </div></div>
    }

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast = ""'></button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto;position:relative}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:visible !important;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25);z-index:5}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:90px;height:90px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;overflow:visible !important}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:42px;height:42px;border-radius:12px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}.lh-title{font-size:1.2rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.74rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap;overflow:visible !important}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:5px 12px;border-radius:999px;font-size:.72rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-luxury:disabled{opacity:.6;cursor:not-allowed}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 3px 12px rgba(212,175,55,.25)}.btn-primary-luxury:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(212,175,55,.35)}.btn-export-luxury{background:linear-gradient(135deg,#059669,#10b981);color:#fff}.btn-ghost-luxury{background:#fff;border:1.5px solid #e8e2d0;color:#6b7280}.btn-ghost-luxury:hover{background:#fcfaf6;border-color:var(--gold)}.btn-danger-luxury{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}.btn-luxury svg{width:14px;height:14px}.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.workflow-luxury{display:flex;align-items:center;gap:0;background:#fff;border:1px solid #e8e2d0;border-radius:14px;padding:10px 16px;overflow-x:auto}
.wf-step{display:flex;align-items:center;gap:8px;font-size:.78rem;font-weight:700;color:#9ca3af;white-space:nowrap}
.wf-step.active{color:var(--gold-dark)}.wf-step.done{color:#059669}
.wf-num{width:24px;height:24px;border-radius:50%;background:#f3f4f6;border:1px solid #e5e7eb;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:900}
.wf-step.active .wf-num{background:rgba(212,175,55,.15);border-color:rgba(212,175,55,.25);color:var(--gold-dark)}
.wf-step.done .wf-num{background:#ecfdf5;border-color:#a7f3d0;color:#059669}
.wf-line{width:24px;height:2px;background:#e5e7eb;margin:0 8px}.wf-step.done .wf-line{background:#a7f3d0}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
