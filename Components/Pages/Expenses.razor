</style>

@code {
    private List<ExpenseListDto> allList = new();
    private List<ExpenseListDto> filtered = new();
    private List<AccountingPeriodListDto> periods = new();
    private bool isLoading = true;
    private ModulePermissionDto? permissions;
    private bool permissionsLoaded;
    private string searchText = "";
    private int filterStatus = 0;
    private int filterPeriod = 0;
    private string toast = "";
    private bool toastOk = true;
    private bool showDelete = false;
    private ExpenseListDto? deleteExp;
    private string deleteMsg = "";
    private bool showDetails;
    private ExpenseListDto? detailsExpense;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            permissionsLoaded = true;
            return;
        }

        try
        {
            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(UserSession.UserID);

            var expensePermissions = PermissionService.Permissions
                .Where(p => p.ModuleCode.Equals("SCR_EXPENSES", StringComparison.OrdinalIgnoreCase)
                         || p.ModuleCode.Equals("SCR_EXPENSE", StringComparison.OrdinalIgnoreCase)
                         || p.ModuleCode.Equals("SCR_OVERHEAD", StringComparison.OrdinalIgnoreCase)
                         || p.ModuleCode.Equals("SCR_OVERHEAD_EXPENSES", StringComparison.OrdinalIgnoreCase))
                .ToList();
            permissions = expensePermissions.Count == 0 ? null : new ModulePermissionDto
            {
                CanView = expensePermissions.Any(p => p.CanView),
                CanAdd = expensePermissions.Any(p => p.CanAdd),
                CanEdit = expensePermissions.Any(p => p.CanEdit),
                CanDelete = expensePermissions.Any(p => p.CanDelete),
                CanPrint = expensePermissions.Any(p => p.CanPrint),
                CanExport = expensePermissions.Any(p => p.CanExport),
                CanApprove = expensePermissions.Any(p => p.CanApprove),
                CanPost = expensePermissions.Any(p => p.CanPost),
                CanCancel = expensePermissions.Any(p => p.CanCancel)
            };
            permissionsLoaded = true;

            if (permissions?.CanView == true)
                await LoadData();
        }
        catch (Exception ex)
        {
            permissions = null;
            permissionsLoaded = true;
            toast = "تعذر التحقق من الصلاحيات: " + ex.Message;
            toastOk = false;
        }
    }

    private async Task LoadData()
    {
        if (permissions?.CanView != true) return;

        isLoading = true; StateHasChanged();
        try
        {
            allList = await AccountingService.GetExpensesAsync();
            periods = await AccountingService.GetAccountingPeriodsAsync();
            ApplyFilter();
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isLoading = false; }
    }

    private void ApplyFilter()
    {
        filtered = allList.Where(e =>
            (filterStatus == 0 || e.ExpenseStatus == filterStatus) &&
            (filterPeriod == 0 || e.PeriodID == filterPeriod) &&
            (string.IsNullOrWhiteSpace(searchText) ||
             (e.ExpenseNumber?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (e.Description?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (e.CostCenterNameAr?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
             (e.ExpenseAccountNameAr?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false))
        ).ToList();
    }

    private void ClearSearch() { searchText = ""; ApplyFilter(); }
    private void AddNew()
    {
        if (permissions?.CanAdd == true)
            Navigation.NavigateTo("/expenses/new");
    }
    private void EditExpense(int id)
    {
        if (permissions?.CanEdit == true)
            Navigation.NavigateTo($"/expenses/edit/{id}");
    }
    private void ViewJournal(int? jId)
    {
        if (permissions?.CanView == true && jId.HasValue)
            Navigation.NavigateTo($"/journal-entries/{jId.Value}");
    }

    private void ShowDetails(ExpenseListDto expense)
    {
        if (permissions?.CanView != true) return;
        detailsExpense = expense;
        showDetails = true;
    }

    private void CloseDetails()
    {
        showDetails = false;
        detailsExpense = null;
    }

    private void OpenTreasuryMovements()
    {
        if (PermissionService.CanViewCashBoxStatement)
            Navigation.NavigateTo("/cash-box-statement");
    }

    private void OpenCashBoxMovements(int? cashBoxId)
    {
        if (!PermissionService.CanViewCashBoxStatement) return;
        Navigation.NavigateTo(cashBoxId.HasValue
            ? $"/cash-box-statement?cashBoxId={cashBoxId.Value}"
            : "/cash-box-statement");
    }

    private static string GetPaymentMethodName(int? method) => method switch
    {
        1 => "نقدي - خزينة",
        2 => "بنك",
        3 => "آجل - مستحق",
        _ => "—"
    };

    private async Task Approve(int id)
    {
        if (permissions?.CanApprove != true) return;
        try { await AccountingService.ApproveExpenseAsync(id, UserSession.UserID); toast = "تم اعتماد المصروف"; toastOk = true; await LoadData(); }
        catch (Exception ex) { toast = ex.Message; toastOk = false; }
    }

    private void ShowDelete(ExpenseListDto exp)
    {
        if (permissions?.CanDelete != true) return;
        deleteExp = exp;
        deleteMsg = "";
        showDelete = true;
    }
    private void CloseDelete() { showDelete = false; }

    private async Task ConfirmDelete()
    {
        if (permissions?.CanDelete != true || deleteExp == null) return;
        try { await AccountingService.DeleteExpenseAsync(deleteExp.ExpenseID, UserSession.UserID); toast = "تم حذف المصروف والقيد "; toastOk = true; showDelete = false; await LoadData(); }
        catch (Exception ex) { deleteMsg = ex.Message; }
    }
}
