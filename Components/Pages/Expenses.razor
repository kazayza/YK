@page "/expenses"
@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject AccountingService AccountingService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>المصروفات -    Pro</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><h4>يجب تسجيل الدخول</h4></div>}
else if (!permissionsLoaded)
{<div class="loading-luxury" dir="rtl"><p>جاري التحقق من صلاحيات المصروفات...</p></div>}
else if (permissions?.CanView != true)
{<div class="no-access-luxury" dir="rtl"><h4>ليس لديك صلاحية عرض المصروفات</h4></div>}
else
{
<div class="luxury-page" dir="rtl">
    <div class="luxury-header-hybrid">
        <div class="lh-gold-line"></div>
        <div class="lh-content">
            <div class="lh-right">
                <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                <div class="lh-text">
                    <h2 class="lh-title">المصروفات</h2>
                    <p class="lh-subtitle">مصروفات مربوطة بمركز تكلفة + فترة محاسبية + قيد أوتوماتيك</p>
                </div>
            </div>
            <div class="lh-actions">
                <span class="lh-badge"><span class="lh-dot"></span>@filtered.Count مصروف</span>
                <span class="lh-badge" style="background:rgba(16,185,129,.1);border-color:rgba(16,185,129,.15);color:#059669">@filtered.Sum(e=>e.Amount).ToString("#,##0.00") ج.م</span>
                @if (PermissionService.CanViewCashBoxStatement)
                {
                    <button class="btn-luxury btn-ghost-luxury" @onclick="OpenTreasuryMovements"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3v18h18"/><path d="m7 14 4-4 4 4 6-7"/></svg>حركات الخزينة</button>
                }
                @if (permissions?.CanAdd == true)
                {
                    <button class="btn-luxury btn-primary-luxury" @onclick="AddNew"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>مصروف جديد</button>
                }
            </div>
        </div>
    </div>

    @if (isLoading)
    {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل المصروفات...</p></div>}
    else
    {
        <div class="stats-luxury">
            <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></div><div class="st-info"><span class="st-value">@allList.Count</span><span class="st-label">إجمالي المصروفات</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div class="st-info"><span class="st-value">@allList.Count(e=>e.ExpenseStatus==2)</span><span class="st-label">معتمدة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></div><div class="st-info"><span class="st-value">@allList.Count(e=>e.CostCenterID!=null)</span><span class="st-label">بمركز تكلفة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div class="st-info"><span class="st-value">@allList.Count(e=>e.JournalID!=null)</span><span class="st-label">بقيد تلقائي</span></div><div class="st-gold-line"></div></div>
        </div>

        <div class="filter-luxury">
            <div class="search-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><input type="text" placeholder="بحث برقم المصروف أو البيان أو مركز التكلفة..." @bind="searchText" @bind:event="oninput" @onkeyup="ApplyFilter" />@if(!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}</div>
            <div class="select-wrap-luxury"><select @bind="filterStatus" @bind:after="ApplyFilter"><option value="0">كل الحالات</option><option value="1">مسودة</option><option value="2">معتمد</option><option value="3">ملغي</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <div class="select-wrap-luxury"><select @bind="filterPeriod" @bind:after="ApplyFilter"><option value="0">كل الفترات</option>@foreach(var p in periods){<option value="@p.PeriodID">@p.PeriodName</option>}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        <div class="table-card-luxury">
            <div class="card-head-luxury"><h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>المصروفات — قيد أوتوماتيك + مركز تكلفة + فترة</h3></div>
            <div class="table-responsive">
                <table class="table-luxury detailed">
                    <thead><tr><th class="th-num">#</th><th>رقم المصروف</th><th>التاريخ</th><th>الفترة</th><th>حساب المصروف</th><th>مركز التكلفة</th><th>المبلغ</th><th>الحساب الدائن</th><th>الحالة</th><th>قيد؟</th><th class="th-actions">إجراءات</th></tr></thead>
                    <tbody>
                        @{int n=0;}
                        @foreach(var exp in filtered){n++;
                            <tr @key="exp.ExpenseID">
                                <td class="td-num">@n</td>
                                <td><span class="doc-num-luxury">@exp.ExpenseNumber</span></td>
                                <td class="td-muted">@exp.ExpenseDate.ToString("dd/MM/yyyy")</td>
                                <td><span class="level-badge">@exp.PeriodName</span></td>
                                <td><div class="acc-cell"><div class="acc-icon type-6"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="acc-info"><span class="acc-name">@exp.ExpenseAccountNameAr</span><span class="acc-name-en">@exp.ExpenseAccountCode</span></div></div></td>
                                <td>@if(exp.CostCenterID!=null){<span class="coa-type type-3">@exp.CostCenterNameAr</span>}else{<span class="coa-detail group">— بدون —</span>}</td>
                                <td><span class="amount-luxury remaining">@exp.Amount.ToString("#,##0.00")</span></td>
                                <td class="td-muted">@(exp.CreditAccountNameAr ?? exp.CashBoxNameAr ?? exp.BankName ?? "—")</td>
                                <td>@if(exp.ExpenseStatus==1){<span class="status-badge-luxury" style="--sc:#6b7280"><span class="status-dot" style="--sc:#6b7280"></span>مسودة</span>}else if(exp.ExpenseStatus==2){<span class="status-badge-luxury" style="--sc:#10b981"><span class="status-dot" style="--sc:#10b981"></span>معتمد</span>}else{<span class="status-badge-luxury" style="--sc:#ef4444"><span class="status-dot" style="--sc:#ef4444"></span>ملغي</span>}</td>
                                <td>@if(exp.JournalID!=null){<span class="coa-detail detail" title="@exp.JournalNumber"><i class=bi-check-lg></i> @exp.JournalNumber</span>}else{<span class="coa-detail group">—</span>}</td>
                                <td class="td-center"><div class="actions-wrap-luxury">
                                    <button class="act-btn view" title="عرض تفاصيل المصروف" aria-label="عرض تفاصيل المصروف" @onclick="()=>ShowDetails(exp)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M8 13h8M8 17h8"/></svg></button>
                                    <button class="act-btn view" title="عرض القيد" aria-label="عرض القيد" @onclick="()=>ViewJournal(exp.JournalID)" disabled="@(exp.JournalID==null)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg></button>
                                    @if(exp.ExpenseStatus==1 && permissions?.CanEdit == true && ((exp.JournalID == null && !exp.IsPosted) || (exp.JournalID != null && permissions?.CanApprove == true))){<button class="act-btn edit" title="تعديل" @onclick="()=>EditExpense(exp.ExpenseID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                    @if(exp.ExpenseStatus==1 && permissions?.CanApprove == true){<button class="act-btn approve" title="اعتماد" @onclick="()=>Approve(exp.ExpenseID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></button>}
                                    @if(exp.ExpenseStatus==1 && permissions?.CanDelete == true){<button class="act-btn delete" title="حذف" @onclick="()=>ShowDelete(exp)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}
                                </div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (showDelete)
{
    <div class="modal-overlay-luxury" @onclick="CloseDelete"><div class="modal-card-luxury small" @onclick:stopPropagation="true">
        <div class="ml-gold-line danger"></div>
        <div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M15 9l-6 6"/><path d="M9 9l6 6"/></svg></div>
        <h4>تأكيد الحذف</h4><p>حذف المصروف: <strong class="delete-name">@deleteExp?.ExpenseNumber</strong>؟ سيتم حذف القيد التلقائي أيضاً.</p>
        @if(!string.IsNullOrEmpty(deleteMsg)){<div class="msg-luxury msg-error">@deleteMsg</div>}
        <div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmDelete">حذف</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseDelete">إلغاء</button></div>
    </div></div>
}

@if (showDetails && detailsExpense is not null)
{
    <div class="modal-overlay-luxury" @onclick="CloseDetails">
        <div class="modal-card-luxury expense-details-modal" @onclick:stopPropagation="true">
            <div class="ml-gold-line"></div>
            <div class="expense-details-head">
                <div><h3>تفاصيل المصروف</h3><span>@detailsExpense.ExpenseNumber</span></div>
                <button class="btn-close-x" title="إغلاق" @onclick="CloseDetails"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
            </div>
            <div class="expense-details-grid">
                <div class="expense-detail-item"><span>التاريخ</span><strong>@detailsExpense.ExpenseDate.ToString("dd/MM/yyyy")</strong></div>
                <div class="expense-detail-item"><span>الفترة / السنة</span><strong>@detailsExpense.PeriodName / @detailsExpense.FiscalYearName</strong></div>
                <div class="expense-detail-item"><span>المبلغ</span><strong>@detailsExpense.Amount.ToString("#,##0.00") ج.م</strong></div>
                <div class="expense-detail-item"><span>حساب المصروف</span><strong>@detailsExpense.ExpenseAccountNameAr</strong></div>
                <div class="expense-detail-item"><span>الحساب الدائن</span><strong>@(detailsExpense.CreditAccountNameAr ?? detailsExpense.CashBoxNameAr ?? detailsExpense.BankName ?? "—")</strong></div>
                <div class="expense-detail-item"><span>مركز التكلفة</span><strong>@(detailsExpense.CostCenterNameAr ?? "—")</strong></div>
                <div class="expense-detail-item"><span>طريقة الدفع</span><strong>@GetPaymentMethodName(detailsExpense.PaymentMethod)</strong></div>
                <div class="expense-detail-item"><span>الخزينة</span><strong>@(detailsExpense.CashBoxNameAr ?? "—")</strong></div>
                <div class="expense-detail-item"><span>الحالة</span><strong>@(detailsExpense.StatusName ?? "—")</strong></div>
                <div class="expense-detail-item"><span>المرجع</span><strong>@(detailsExpense.Reference ?? "—")</strong></div>
                <div class="expense-detail-item"><span>رقم القيد</span><strong>@(detailsExpense.JournalNumber ?? "—")</strong></div>
                <div class="expense-detail-item"><span>تاريخ الإنشاء</span><strong>@detailsExpense.CreatedDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                <div class="expense-detail-item detail-wide"><span>البيان</span><strong>@(detailsExpense.Description ?? "—")</strong></div>
                @if (!string.IsNullOrWhiteSpace(detailsExpense.Notes))
                {
                    <div class="expense-detail-item detail-wide"><span>ملاحظات</span><strong>@detailsExpense.Notes</strong></div>
                }
            </div>
            <div class="expense-details-actions">
                @if (detailsExpense.JournalID.HasValue)
                {
                    <button class="btn-luxury btn-primary-luxury" @onclick="()=>ViewJournal(detailsExpense.JournalID)">فتح القيد</button>
                }
                @if (detailsExpense.CashBoxID.HasValue && PermissionService.CanViewCashBoxStatement)
                {
                    <button class="btn-luxury btn-ghost-luxury" @onclick="()=>OpenCashBoxMovements(detailsExpense.CashBoxID)">حركات هذه الخزينة</button>
                }
                <button class="btn-luxury btn-ghost-luxury" @onclick="CloseDetails">إغلاق</button>
            </div>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='()=>toast=""'><i class=bi-x-lg></i></button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--border-gold:rgba(212,175,55,.18)}
.luxury-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1400px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,#121A2E 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-logo{width:26px;height:26px;object-fit:contain}
.lh-title{font-size:1.25rem;font-weight:900;color:#F5E6C8;margin:0}
.lh-subtitle{font-size:.72rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:12px;font-weight:700;font-size:.82rem;border:none;cursor:pointer;transition:.2s;font-family:'Tajawal'}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.2)}
.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}
.st-icon.purple{background:#f5f3ff;color:#7c3aed;border:1px solid #ddd6fe}
.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}
.st-info{display:flex;flex-direction:column}
.st-value{font-size:1.15rem;font-weight:900;color:#0A0F1E;line-height:1}
.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}
.clear-search-luxury{position:absolute;left:8px;width:24px;height:24px;border-radius:50%;border:none;background:#f3f4f6;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}
.clear-search-luxury svg{width:10px;height:10px}
.select-wrap-luxury select{height:40px;padding:0 28px 0 12px;border:1.5px solid #e8e2d0;border-radius:12px;font-size:.82rem;font-family:'Tajawal';background:#fff;appearance:none;cursor:pointer;outline:none;min-width:130px}
.select-wrap-luxury .arrow{position:absolute;left:10px;width:12px;height:12px;color:#9ca3af;pointer-events:none}
.table-card-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:18px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.04);position:relative}
.table-card-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.card-head-luxury{display:flex;justify-content:space-between;align-items:center;padding:14px 18px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8;flex-wrap:wrap;gap:8px}
.card-head-luxury h3{font-size:.9rem;font-weight:800;color:#0A0F1E;display:flex;align-items:center;gap:8px;margin:0}
.card-head-luxury h3 svg{width:16px;height:16px;color:var(--gold-dark)}
.table-responsive{overflow-x:auto}
.table-luxury{width:100%;border-collapse:collapse;min-width:1200px}
.td-muted{color:#6b7280;font-size:.82rem}
.acc-cell{display:flex;align-items:center;gap:10px}
.acc-icon{width:32px;height:32px;border-radius:9px;display:flex;align-items:center;justify-content:center;flex-shrink:0;border:1px solid}
.acc-icon.type-6{background:#fef2f2;color:#dc2626;border-color:#fecaca}
.acc-icon svg{width:16px;height:16px}
.acc-info{display:flex;flex-direction:column}
.acc-name{font-weight:800;color:#0A0F1E;font-size:.86rem}
.acc-name-en{font-weight:600;color:#8B95A5;font-size:.72rem}
.level-badge{font-family:monospace;font-weight:700;background:#f3f4f6;color:#6b7280;border:1px solid #e5e7eb;padding:3px 8px;border-radius:999px;font-size:.72rem}
.coa-type{font-size:.68rem;padding:3px 8px;border-radius:6px;font-weight:800;border:1px solid}
.type-3{background:#f5f3ff;color:#7c3aed;border-color:#ddd6fe}
.status-badge-luxury{display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:800;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,white)}
.status-dot{width:6px;height:6px;border-radius:50%;background:var(--sc);box-shadow:0 0 0 2px color-mix(in srgb,var(--sc) 15%,transparent)}
.coa-detail{font-size:.68rem;padding:3px 8px;border-radius:6px;font-weight:800;border:1px solid}
.coa-detail.detail{background:#ecfdf5;color:#065f46;border-color:#a7f3d0}
.coa-detail.group{background:rgba(212,175,55,.1);color:#9C7C2E;border-color:rgba(212,175,55,.2)}
.amount-luxury{font-family:monospace;font-weight:800;color:#0A0F1E;background:#f8f6f0;padding:4px 10px;border-radius:8px;border:1px solid #e8e2d0}
.amount-luxury.remaining{background:#fef2f2;color:#dc2626;border-color:#fecaca}
.actions-wrap-luxury{display:flex;gap:4px;justify-content:center}
.act-btn{width:30px;height:30px;border-radius:9px;border:1.5px solid;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;background:#fff;transition:.2s}
.act-btn.view{color:#2563eb;border-color:#bfdbfe}
.act-btn.edit{color:var(--gold-dark);border-color:rgba(212,175,55,.2)}
.act-btn.approve{color:#059669;border-color:#a7f3d0}
.act-btn.delete{color:#ef4444;border-color:#fee2e2}
.act-btn svg{width:13px;height:13px}
.ml-gold-line.danger{background:linear-gradient(90deg,transparent,#ef4444,#dc2626,transparent)}
.ml-footer{display:flex;gap:8px;padding:14px 20px;border-top:1px solid #f1efe8;background:#fcfaf6;justify-content:center}
.ml-footer.center{justify-content:center;background:transparent;border:none;padding-top:16px}
.expense-details-modal{text-align:right;padding:0;width:100%;max-width:820px;max-height:90vh;overflow:auto}
.expense-details-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:20px 24px 14px;border-bottom:1px solid #f1efe8;background:linear-gradient(135deg,#fcfaf6,#fff)}
.expense-details-head h3{margin:0;color:#0A0F1E;font-size:1.05rem;font-weight:900}
.expense-details-head span{display:inline-block;margin-top:4px;color:var(--gold-dark);font-size:.78rem;font-weight:800}
.btn-close-x{width:34px;height:34px;border:1px solid #e8e2d0;border-radius:10px;background:#fff;color:#6b7280;display:inline-flex;align-items:center;justify-content:center;cursor:pointer}
.btn-close-x svg{width:16px;height:16px}
