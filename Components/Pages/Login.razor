@page "/login"
@layout YKCoatings.Components.Layout.EmptyLayout
@using YKCoatings.Services
@inject AuthService AuthService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>تسجيل الدخول - واي كي كوتينج</PageTitle>

<!-- ===== الأنماط المخصصة ===== -->
<style>
    /* === خطوط عربية احترافية === */
    @@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap');

    .login-page * {
        font-family: 'Cairo', sans-serif;
    }

    /* === الخلفية الرئيسية === */
    .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #060b16 0%, #0b1526 30%, #123a6b 60%, #0b1526 100%);
        position: relative;
        overflow: hidden;
        direction: rtl;
    }

    /* === الجزيئات المتحركة في الخلفية === */
    .login-page::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background:
            radial-gradient(circle at 20% 80%, rgba(96, 165, 250, 0.08) 0%, transparent 50%),
            radial-gradient(circle at 80% 20%, rgba(147, 197, 253, 0.06) 0%, transparent 50%),
            radial-gradient(circle at 50% 50%, rgba(37,99,235, 0.04) 0%, transparent 50%);
        animation: bgPulse 15s ease-in-out infinite;
    }

    @@keyframes bgPulse {
        0%, 100% { transform: scale(1) rotate(0deg); opacity: 1; }
        50% { transform: scale(1.1) rotate(3deg); opacity: 0.8; }
    }

    /* === الأشكال العائمة === */
    .floating-shape {
        position: absolute;
        border-radius: 50%;
        opacity: 0.03;
        pointer-events: none;
    }

    .floating-shape-1 {
        width: 600px;
        height: 600px;
        background: linear-gradient(135deg, #2563eb, #93c5fd);
        top: -200px;
        right: -200px;
        animation: float1 20s ease-in-out infinite;
    }

    .floating-shape-2 {
        width: 400px;
        height: 400px;
        background: linear-gradient(135deg, #1d4ed8, #c084fc);
        bottom: -100px;
        left: -100px;
        animation: float2 25s ease-in-out infinite;
    }

    .floating-shape-3 {
        width: 300px;
        height: 300px;
        background: linear-gradient(135deg, #1e40af, #2563eb);
        top: 50%;
        left: 10%;
        animation: float3 18s ease-in-out infinite;
    }

    @@keyframes float1 {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33% { transform: translate(-30px, 30px) scale(1.05); }
        66% { transform: translate(20px, -20px) scale(0.95); }
    }

    @@keyframes float2 {
        0%, 100% { transform: translate(0, 0) rotate(0deg); }
        50% { transform: translate(40px, -40px) rotate(10deg); }
    }

    @@keyframes float3 {
        0%, 100% { transform: translate(0, 0); }
        50% { transform: translate(-30px, 30px); }
    }

    /* === خطوط شبكية === */
    .grid-overlay {
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(37,99,235, 0.03) 1px, transparent 1px),
            linear-gradient(90deg, rgba(37,99,235, 0.03) 1px, transparent 1px);
        background-size: 60px 60px;
        pointer-events: none;
    }

    /* === حاوية تسجيل الدخول === */
    .login-container {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 480px;
        padding: 0 20px;
        animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(40px) scale(0.96);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* === البطاقة الرئيسية === */
    .login-card {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(40px);
        -webkit-backdrop-filter: blur(40px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        padding: 48px 40px;
        box-shadow:
            0 32px 64px rgba(0, 0, 0, 0.4),
            0 0 0 1px rgba(255, 255, 255, 0.05) inset,
            0 -1px 0 rgba(255, 255, 255, 0.1) inset;
        position: relative;
        overflow: hidden;
    }

    .login-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(37,99,235, 0.5), transparent);
    }

    /* === شعار الشركة === */
    .brand-section {
        text-align: center;
        margin-bottom: 40px;
    }

    .brand-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
    position: relative;
    background: transparent;
    box-shadow: none;
    animation: none;
    width: auto;
    height: auto;
    border-radius: 0;
}
   .brand-logo-image {
    width: 188px;
    max-width: 100%;
    height: auto;
    display: block;
}

    @@keyframes logoGlow {
        0%, 100% { box-shadow: 0 12px 40px rgba(37, 99, 235, 0.4), 0 0 60px rgba(37, 99, 235, 0.1); }
        50% { box-shadow: 0 12px 50px rgba(37, 99, 235, 0.5), 0 0 80px rgba(37, 99, 235, 0.15); }
    }

    .brand-logo svg {
        width: 44px;
        height: 44px;
        color: white;
        filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.2));
    }

    .brand-logo::after {
    display: none;
}

    .brand-name {
        font-size: 1.75rem;
        font-weight: 800;
        background: linear-gradient(135deg, #fff 0%, #bfdbfe 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 6px;
        letter-spacing: -0.5px;
    }

    .brand-subtitle {
        font-size: 0.85rem;
        color: rgba(255, 255, 255, 0.4);
        font-weight: 400;
        letter-spacing: 0.5px;
    }

    /* === الفاصل === */
    .brand-divider {
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(37,99,235, 0.3), transparent);
        margin: 0 0 32px 0;
        border: none;
    }

    /* === رسائل التنبيه === */
    .alert-modern {
        border: none;
        border-radius: 14px;
        padding: 14px 18px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 0.85rem;
        font-weight: 500;
        animation: alertSlide 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        backdrop-filter: blur(10px);
    }

    @@keyframes alertSlide {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .alert-danger-modern {
        background: rgba(239, 68, 68, 0.12);
        color: #fca5a5;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .alert-success-modern {
        background: rgba(34, 197, 94, 0.12);
        color: #86efac;
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .alert-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .alert-danger-modern .alert-icon {
        background: rgba(239, 68, 68, 0.2);
    }

    .alert-success-modern .alert-icon {
        background: rgba(34, 197, 94, 0.2);
    }

    .alert-icon svg {
        width: 18px;
        height: 18px;
    }

    /* === مجموعة الحقول === */
    .field-group {
        margin-bottom: 24px;
    }

    .field-label {
        display: block;
        font-size: 0.82rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.6);
        margin-bottom: 10px;
        letter-spacing: 0.3px;
    }

    .field-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.04);
        border: 1.5px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        overflow: hidden;
    }

    .field-wrapper:hover {
        border-color: rgba(37,99,235, 0.3);
        background: rgba(255, 255, 255, 0.06);
    }

    .field-wrapper:focus-within {
        border-color: rgba(37,99,235, 0.6);
        background: rgba(37,99,235, 0.05);
        box-shadow:
            0 0 0 4px rgba(37,99,235, 0.1),
            0 0 20px rgba(37,99,235, 0.05);
    }

    .field-icon {
        width: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255, 255, 255, 0.3);
        flex-shrink: 0;
        transition: color 0.3s ease;
    }

    .field-wrapper:focus-within .field-icon {
        color: rgba(37,99,235, 0.8);
    }

    .field-icon svg {
        width: 20px;
        height: 20px;
    }

    .field-input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        padding: 16px 16px 16px 0;
        font-size: 0.95rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.9);
        font-family: 'Cairo', sans-serif;
        direction: rtl;
    }

    .field-input::placeholder {
        color: rgba(255, 255, 255, 0.2);
        font-weight: 400;
    }

    .field-input:-webkit-autofill,
    .field-input:-webkit-autofill:hover,
    .field-input:-webkit-autofill:focus {
        -webkit-text-fill-color: rgba(255, 255, 255, 0.9);
        -webkit-box-shadow: 0 0 0 30px rgba(11, 21, 38, 1) inset;
        transition: background-color 5000s ease-in-out 0s;
    }

    .toggle-password {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.3);
        cursor: pointer;
        transition: all 0.2s ease;
        border-radius: 10px;
        margin: 4px;
        flex-shrink: 0;
    }

    .toggle-password:hover {
        background: rgba(255, 255, 255, 0.06);
        color: rgba(37,99,235, 0.8);
    }

    .toggle-password svg {
        width: 20px;
        height: 20px;
    }

    /* === زر تسجيل الدخول === */
    .login-btn {
        width: 100%;
        padding: 16px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 50%, #93c5fd 100%);
        color: white;
        font-size: 1rem;
        font-weight: 700;
        font-family: 'Cairo', sans-serif;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 32px;
        box-shadow: 0 8px 32px rgba(37, 99, 235, 0.35);
        letter-spacing: 0.5px;
    }

    .login-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, transparent 0%, rgba(255, 255, 255, 0.1) 50%, transparent 100%);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .login-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 12px 40px rgba(37, 99, 235, 0.5);
    }

    .login-btn:hover:not(:disabled)::before {
        opacity: 1;
    }

    .login-btn:active:not(:disabled) {
        transform: translateY(0);
        box-shadow: 0 4px 20px rgba(37, 99, 235, 0.3);
    }

    .login-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    .login-btn svg {
        width: 20px;
        height: 20px;
    }

    /* === سبينر التحميل === */
    .btn-spinner {
        width: 22px;
        height: 22px;
        border: 2.5px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.7s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* === التذييل === */
    .login-footer {
        text-align: center;
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .footer-text {
        font-size: 0.75rem;
        color: rgba(255, 255, 255, 0.2);
        font-weight: 400;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .footer-dot {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: rgba(37,99,235, 0.4);
    }

    .footer-version {
        color: rgba(37,99,235, 0.5);
        font-weight: 600;
    }
    .footer-dev {
    margin-top: 12px;
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
}

.footer-dev-en {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.35);
    font-weight: 400;
    direction: ltr;
}

.footer-dev-contact {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.25);
    font-weight: 400;
    direction: ltr;
}

    /* === معلومات إضافية أسفل الكارد === */
    .extra-info {
        text-align: center;
        margin-top: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 24px;
    }

    .info-badge {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 0.72rem;
        color: rgba(255, 255, 255, 0.25);
        font-weight: 400;
    }

    .info-badge svg {
        width: 14px;
        height: 14px;
        color: rgba(37,99,235, 0.4);
    }

    /* === التجاوب === */
    @@media (max-width: 520px) {
        .login-card {
            padding: 36px 24px;
            border-radius: 22px;
        }

        .brand-logo {
            width: 72px;
            height: 72px;
            border-radius: 20px;
        }

        .brand-name {
            font-size: 1.5rem;
        }

        .login-container {
            padding: 0 16px;
        }

        .extra-info {
            flex-direction: column;
            gap: 8px;
        }
    }

    /* === حالة تعطيل الحقول === */
    .field-wrapper.disabled {
        opacity: 0.5;
        pointer-events: none;
    }
</style>

<!-- ===== هيكل الصفحة ===== -->
<div class="login-page">

    <!-- الأشكال العائمة -->
    <div class="floating-shape floating-shape-1"></div>
    <div class="floating-shape floating-shape-2"></div>
    <div class="floating-shape floating-shape-3"></div>

    <!-- الشبكة -->
    <div class="grid-overlay"></div>

    <!-- حاوية تسجيل الدخول -->
    <div class="login-container">

        <!-- البطاقة الرئيسية -->
        <div class="login-card">

            <!-- قسم العلامة التجارية -->
            <div class="brand-section">
                <div class="brand-logo">
    <img src="/images/yk-logo.svg"
         alt="YK Coatings"
         class="brand-logo-image" />
</div>

<p class="brand-subtitle">نظام إدارة المصنع المتكامل</p>
            </div>

            <!-- الفاصل -->
            <hr class="brand-divider" />

            <!-- رسالة الخطأ -->
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-modern alert-danger-modern">
                    <div class="alert-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <line x1="15" y1="9" x2="9" y2="15" />
                            <line x1="9" y1="9" x2="15" y2="15" />
                        </svg>
                    </div>
                    <span>@errorMessage</span>
                </div>
            }

            <!-- رسالة النجاح -->
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert-modern alert-success-modern">
                    <div class="alert-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                            <polyline points="22 4 12 14.01 9 11.01" />
                        </svg>
                    </div>
                    <span>@successMessage</span>
                </div>
            }

            <!-- حقل اسم المستخدم -->
            <div class="field-group">
                <label class="field-label">اسم المستخدم</label>
                <div class="field-wrapper @(isLoading ? "disabled" : "")">
                    <div class="field-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                    </div>
                    <input type="text"
                           class="field-input"
                           @bind="username"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown"
                           placeholder="أدخل اسم المستخدم"
                           disabled="@isLoading"
                           autocomplete="username" />
                </div>
            </div>

            <!-- حقل كلمة المرور -->
            <div class="field-group">
                <label class="field-label">كلمة المرور</label>
                <div class="field-wrapper @(isLoading ? "disabled" : "")">
                    <div class="field-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                            <circle cx="12" cy="16" r="1" />
                        </svg>
                    </div>
                    <input type="@(showPassword ? "text" : "password")"
                           class="field-input"
                           @bind="password"
                           @bind:event="oninput"
                           @onkeydown="HandleKeyDown"
                           placeholder="أدخل كلمة المرور"
                           disabled="@isLoading"
                           autocomplete="current-password" />
                    <button class="toggle-password"
                            type="button"
                            tabindex="-1"
                            @onclick="TogglePassword"
                            title="@(showPassword ? "إخفاء كلمة المرور" : "إظهار كلمة المرور")">
                        @if (showPassword)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                                <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                    </button>
                </div>
            </div>

            <!-- زر تسجيل الدخول -->
            <button class="login-btn"
                    @onclick="DoLogin"
                    disabled="@isLoading">
                @if (isLoading)
                {
                    <div class="btn-spinner"></div>
                    <span>جاري التحقق...</span>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                        <polyline points="10 17 15 12 10 7" />
                        <line x1="15" y1="12" x2="3" y2="12" />
                    </svg>
                    <span>تسجيل الدخول</span>
                }
            </button>

            <!-- التذييل -->
            <div class="login-footer">
    <div class="footer-text">
        <span>© 2026 واي كي كوتينج</span>
        <div class="footer-dot"></div>
        <span>جميع الحقوق محفوظة</span>
        <div class="footer-dot"></div>
        <span class="footer-version">v1.0.0</span>
    </div>
    <div class="footer-dev">
        تصميم وتطوير : أحمد محمد الرفاعى
        <span class="footer-dev-en">Developed by: Ahmed M. El-Refaey</span>
        <span class="footer-dev-contact">للتواصل : 01122050119</span>
    </div>
</div>
        </div>

        <!-- معلومات أسفل الكارد -->
        <div class="extra-info">
            <div class="info-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                </svg>
                <span>اتصال مشفر وآمن</span>
            </div>
            <div class="info-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
                    <line x1="8" y1="21" x2="16" y2="21" />
                    <line x1="12" y1="17" x2="12" y2="21" />
                </svg>
                <span>نظام ERP متكامل</span>
            </div>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private string successMessage = "";
    private bool isLoading = false;
    private bool showPassword = false;

    private bool _sessionChecked;

    // ️ نستعيد الجلسة بعد الرندر قبل أي تحويل، وإلا فإن Refresh على /login
    // وأنت مسجّل دخول يعرض نموذج الدخول بدلاً من توجيهك للوحة التحكم.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionChecked) return;
        _sessionChecked = true;

        if (await UserSession.EnsureRestoredAsync())
        {
            if (UserSession.RequiresPasswordChange)
                Navigation.NavigateTo("/change-password");
            else
                Navigation.NavigateTo("/dashboard");
        }
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(username))
        {
            errorMessage = "يجب إدخال اسم المستخدم";
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "يجب إدخال كلمة المرور";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            string machineName = "";
string ipAddress = "unknown";

try
{
    var clientInfo = await JS.InvokeAsync<ClientInfo>("getClientInfo");
    machineName = clientInfo?.MachineName ?? "";
}
catch { }

try
{
    ipAddress = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "unknown";
}
catch { ipAddress = "unknown"; }
            var result = await AuthService.LoginAsync(username.Trim(), password, ipAddress, machineName);

            if (result.Success)
            
            {
                await UserSession.LoginAsync(
    result.UserID,
    result.Username,
    result.FullName,
    result.RoleID,
    result.RoleName,
    result.RoleCode,
    result.EmployeeID,
    result.MustChangePassword,
    result.PasswordExpired
);
            await PermissionService.LoadPermissionsAsync(result.UserID);
            UserSession.MachineName = machineName;
            UserSession.IPAddress = ipAddress;
                

                successMessage = result.Message;
                StateHasChanged();

                await Task.Delay(800);

if (result.RequiresPasswordChange)
    Navigation.NavigateTo("/change-password");
else
    Navigation.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = result.Message;
                password = "";
            }
        }
        catch (Exception)
{
    errorMessage = "خطأ في الاتصال بالخادم. يرجى المحاولة لاحقاً.";
}
        finally
        {
            isLoading = false;
        }
    }
        private class ClientInfo
    {
        public string MachineName { get; set; } = "";
        public string ScreenSize { get; set; } = "";
        public string Language { get; set; } = "";
        public string Platform { get; set; } = "";
    }
}