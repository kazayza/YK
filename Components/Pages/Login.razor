@page "/login"
@layout YKCoatings.Components.Layout.EmptyLayout
@using YKCoatings.Services
@inject AuthService AuthService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>تسجيل الدخول - واي كي كوتينج</PageTitle>

<!-- ===== الأنماط: هوية Gold & Black Premium ===== -->
<style>
.login-page *{font-family:'Tajawal','Cairo',sans-serif;box-sizing:border-box}
/* === الخلفية السوداء الفاخرة (نفس app-boot) — بدون سكرول خارجي === */
    .login-page{
        height:100vh;height:100dvh;
        display:flex;align-items:center;justify-content:center;
        background:
            radial-gradient(ellipse at 15% 20%, rgba(212,175,55,.07) 0%, transparent 45%),
            radial-gradient(ellipse at 85% 85%, rgba(212,175,55,.05) 0%, transparent 45%),
            linear-gradient(135deg,#070B14 0%,#0A0F1E 50%,#121A2E 100%);
        position:relative;overflow:hidden;direction:rtl;padding:24px;margin:0;
    }
.login-page::before{
        content:'';position:absolute;inset:0;pointer-events:none;
        background-image:
            linear-gradient(rgba(212,175,55,.035) 1px,transparent 1px),
            linear-gradient(90deg,rgba(212,175,55,.035) 1px,transparent 1px);
        background-size:44px 44px;
        mask-image:radial-gradient(ellipse at 50% 45%,#000 25%,transparent 78%);
        -webkit-mask-image:radial-gradient(ellipse at 50% 45%,#000 25%,transparent 78%);
    }
.orb{position:absolute;border-radius:50%;pointer-events:none;filter:blur(70px);opacity:.5}
.orb-1{width:460px;height:460px;background:radial-gradient(circle,rgba(212,175,55,.16),transparent 68%);top:-140px;right:-120px;animation:orbFloat 20s ease-in-out infinite}
.orb-2{width:360px;height:360px;background:radial-gradient(circle,rgba(156,124,46,.14),transparent 68%);bottom:-120px;left:-100px;animation:orbFloat 26s ease-in-out infinite reverse}
.page-gold-line{position:absolute;top:0;left:0;right:0;height:3px;z-index:3;
        background:linear-gradient(90deg,transparent,var(--yk-gold,#D4AF37),var(--yk-gold-light,#E8C86A),var(--yk-gold,#D4AF37),transparent);
        box-shadow:0 0 22px rgba(212,175,55,.5)}
/* === الحاوية المقسّمة (Split) — مقاس مضغوط بلا سكرول === */
    .split{
        position:relative;z-index:2;display:grid;
        grid-template-columns:1.02fr .98fr;
        width:100%;max-width:1020px;max-height:calc(100vh - 48px);max-height:calc(100dvh - 48px);
        border-radius:22px;overflow:hidden;
        background:rgba(10,15,30,.55);
        backdrop-filter:blur(26px);-webkit-backdrop-filter:blur(26px);
        border:1px solid rgba(212,175,55,.16);
        box-shadow:0 34px 90px rgba(0,0,0,.6),0 0 0 1px rgba(255,255,255,.02) inset;
        animation:splitIn .7s cubic-bezier(.16,1,.3,1) both;
    }
/* ===== لوحة الهوية ===== */
    .brand-panel{
        position:relative;padding:36px 34px;
        display:flex;flex-direction:column;justify-content:center;gap:16px;
        background:
            radial-gradient(ellipse at 20% 0%,rgba(212,175,55,.12) 0%,transparent 55%),
            linear-gradient(150deg,#0C1224 0%,#0A0F1E 100%);
        border-left:1px solid rgba(212,175,55,.14);
        overflow:hidden;
    }
.brand-panel::after{
        content:'';position:absolute;left:-70px;bottom:-70px;width:230px;height:230px;
        border:1px solid rgba(212,175,55,.1);border-radius:50%;pointer-events:none;
    }
.brand-logo-box{width:100%;max-width:400px;height:auto;min-height:140px;border-radius:20px;display:flex;align-items:center;justify-content:center;padding:20px;
        background:linear-gradient(140deg,rgba(212,175,55,.16),rgba(212,175,55,.03));
        border:1px solid rgba(212,175,55,.34);
        box-shadow:0 12px 34px rgba(212,175,55,.14);position:relative}
.brand-logo-box img{width:100%;max-width:300px;height:auto;max-height:120px;object-fit:contain}
.brand-logo-box::after{content:'';position:absolute;inset:-6px;border-radius:28px;
        border:1px solid rgba(212,175,55,.12);animation:pulseRing 3s ease-in-out infinite}
.brand-name{font-size:1.75rem;font-weight:900;margin:0;line-height:1.25;
        background:linear-gradient(120deg,#F5E6C8 0%,var(--yk-gold,#D4AF37) 55%,#9C7C2E 100%);
        -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.brand-name-en{font-size:.78rem;font-weight:700;letter-spacing:4px;color:rgba(212,175,55,.55);margin-top:6px}
.brand-desc{font-size:.95rem;line-height:1.9;color:#94A3B8;margin:0;max-width:400px}
.brand-tag{display:inline-flex;align-items:center;gap:8px;align-self:flex-start;
        padding:7px 15px;border-radius:999px;font-size:.72rem;font-weight:800;
        background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.3);color:var(--yk-gold,#D4AF37)}
.brand-tag svg{width:13px;height:13px}
.feature-list{display:flex;flex-direction:column;gap:10px;margin-top:2px}
.feature-item{display:flex;align-items:flex-start;gap:11px}
.feature-ico{width:36px;height:36px;flex-shrink:0;border-radius:11px;display:flex;align-items:center;justify-content:center;
        background:rgba(212,175,55,.09);border:1px solid rgba(212,175,55,.2);color:var(--yk-gold,#D4AF37)}
.feature-ico svg{width:19px;height:19px}
.feature-txt h4{margin:0 0 3px;font-size:.9rem;font-weight:800;color:#E7ECF4}
.feature-txt p{margin:0;font-size:.76rem;color:#7B879B;line-height:1.6}
/* ===== لوحة الدخول ===== */
    .login-panel{padding:36px 34px;display:flex;flex-direction:column;justify-content:center;
        background:linear-gradient(160deg,rgba(18,26,46,.6) 0%,rgba(10,15,30,.4) 100%)}
.login-head{margin-bottom:20px}
.login-head h1{margin:0 0 6px;font-size:1.4rem;font-weight:900;color:#F1F5F9}
.login-head p{margin:0;font-size:.82rem;color:#8494AC}
.login-head .gold-bar{width:52px;height:4px;border-radius:99px;margin-top:12px;
        background:linear-gradient(90deg,var(--yk-gold,#D4AF37),var(--yk-gold-dark,#9C7C2E));
        box-shadow:0 0 14px rgba(212,175,55,.45)}
/* === التنبيهات === */
    .alert-modern{display:flex;align-items:flex-start;gap:11px;padding:13px 16px;border-radius:14px;
        font-size:.85rem;font-weight:700;margin-bottom:20px;line-height:1.6;
        animation:alertIn .3s ease both;border:1px solid}
.alert-danger-modern{background:rgba(220,38,38,.1);border-color:rgba(220,38,38,.35);color:#FCA5A5}
.alert-success-modern{background:rgba(16,185,129,.1);border-color:rgba(16,185,129,.35);color:#6EE7B7}
.alert-modern .alert-icon{flex-shrink:0;width:20px;height:20px;margin-top:1px}
.alert-modern .alert-icon svg{width:20px;height:20px}
/* === الحقول === */
    .field-group{margin-bottom:14px}
.field-label{display:block;font-size:.82rem;font-weight:800;color:#AEB9CC;margin-bottom:7px}
.field-wrapper{position:relative;display:flex;align-items:center;
        background:rgba(7,11,20,.55);border:1.5px solid rgba(212,175,55,.18);
        border-radius:14px;transition:border-color .22s,box-shadow .22s,background .22s}
.field-wrapper:hover{border-color:rgba(212,175,55,.34)}
.field-wrapper:focus-within{
        border-color:rgba(212,175,55,.75);
        background:rgba(7,11,20,.75);
        box-shadow:0 0 0 4px rgba(212,175,55,.14);transform:translateY(-1px)}
.field-wrapper.disabled{opacity:.55;pointer-events:none}
.field-icon{position:absolute;right:15px;display:flex;color:rgba(212,175,55,.6);pointer-events:none;transition:color .22s}
.field-icon svg{width:19px;height:19px}
.field-wrapper:focus-within .field-icon{color:var(--yk-gold,#D4AF37)}
.field-input{width:100%;border:none;outline:none;background:transparent;
        padding:13px 46px 13px 48px;font-size:.92rem;font-weight:600;color:#EEF2F8;
        font-family:inherit;transition:color .22s}
.field-input::placeholder{color:#5C6880;font-weight:500}
.field-input:disabled{cursor:not-allowed}
.toggle-password{position:absolute;left:14px;background:none;border:none;cursor:pointer;
        color:#64748B;padding:6px;display:flex;border-radius:9px;transition:color .2s,background .2s}
.toggle-password:hover{color:var(--yk-gold,#D4AF37);background:rgba(212,175,55,.1)}
.toggle-password svg{width:18px;height:18px}
/* === زر الدخول (تدرج ذهبي) === */
    .login-btn{width:100%;display:flex;align-items:center;justify-content:center;gap:10px;
        padding:14px 24px;border:none;border-radius:13px;cursor:pointer;
        font-size:.98rem;font-weight:900;font-family:inherit;letter-spacing:.3px;
        color:#0A0F1E;
        background:linear-gradient(135deg,var(--yk-gold,#D4AF37) 0%,var(--yk-gold-dark,#9C7C2E) 100%);
        box-shadow:0 12px 30px rgba(212,175,55,.28);
        transition:transform .2s,box-shadow .2s,filter .2s;position:relative;overflow:hidden}
.login-btn::after{content:'';position:absolute;top:0;left:-100%;width:60%;height:100%;
        background:linear-gradient(90deg,transparent,rgba(255,255,255,.4),transparent);
        transition:left .5s}
.login-btn:hover:not(:disabled){transform:translateY(-2px);
        box-shadow:0 16px 38px rgba(212,175,55,.42);filter:brightness(1.05)}
.login-btn:hover:not(:disabled)::after{left:130%}
.login-btn:active:not(:disabled){transform:translateY(0)}
.login-btn:disabled{cursor:not-allowed;opacity:.75}
.login-btn svg{width:19px;height:19px}
.btn-spinner{width:18px;height:18px;border-radius:50%;
        border:2.5px solid rgba(10,15,30,.3);border-top-color:#0A0F1E;
        animation:spin .7s linear infinite}
/* === التذييل === */
    .login-footer{margin-top:18px;padding-top:14px;border-top:1px solid rgba(212,175,55,.12);
        text-align:center;display:flex;flex-direction:column;gap:7px}
.footer-text{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;
        font-size:.74rem;color:#6B7791;font-weight:600}
.footer-dot{width:4px;height:4px;border-radius:50%;background:rgba(212,175,55,.5)}
.footer-dev{font-size:.74rem;color:#5A6580;line-height:2}
.footer-dev-en{display:block;font-size:.68rem;color:#4C5670;letter-spacing:.4px}
.footer-dev-contact{display:inline-block;margin-top:3px;color:#6B7791;font-weight:700}
/* === التجاوب الشامل === */
    @@media (max-width:1100px){
        .split{max-width:940px}
        .brand-panel{padding:44px 34px}
        .login-panel{padding:44px 34px}
        .brand-logo-box{max-width:340px;min-height:150px}
        .brand-logo-box img{max-width:260px;max-height:130px}
    }
</style>

<!-- ===== الهيكل: Split Screen ===== -->
<div class="login-page">
    <div class="page-gold-line"></div>
    <div class="orb orb-1"></div>
    <div class="orb orb-2"></div>

    <div class="split">
        <!-- لوحة الهوية -->
        <div class="brand-panel">
            <div class="brand-logo-box">
                <img src="/images/yk-logo-white.png" alt="YK Coatings" />
            </div>
            <div>
                <h2 class="brand-name">واي كي كوتينج</h2>
                <div class="brand-name-en">YK COATINGS ERP</div>
            </div>
            <span class="brand-tag">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                نظام ERP متكامل
            </span>
            <p class="brand-desc">نظام إدارة المصنع المتكامل — مشتريات · مخازن · تصنيع · موارد بشرية · خزينة وحسابات في منصة واحدة.</p>

            <div class="feature-list">
                <div class="feature-item">
                    <div class="feature-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V7"/><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M19 3h2a2 2 0 0 1 2 2v2"/><path d="M8 12h8"/><path d="M8 16h5"/></svg></div>
                    <div class="feature-txt"><h4>إدارة المشتريات والمخازن</h4><p>طلبات · أوامر · أذون استلام · فواتير · أرصدة لحظية</p></div>
                </div>
                <div class="feature-item">
                    <div class="feature-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7-5-9 5v12Z"/><path d="M6 8h4v4H6z"/><path d="M14 8h4h-4z"/><path d="M6 14h4v4H6z"/></svg></div>
                    <div class="feature-txt"><h4>التصنيع والوصفات</h4><p>وصفات BOM · أوامر تصنيع · دفعات · متابعة لحظية</p></div>
                </div>
                <div class="feature-item">
                    <div class="feature-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                    <div class="feature-txt"><h4>الخزينة والحسابات</h4><p>سندات · قيود يومية · ميزان مراجعة · دفتر أستاذ</p></div>
                </div>
            </div>
        </div>
        <!-- لوحة الدخول -->
        <div class="login-panel">
            <div class="login-head">
                <h1>تسجيل الدخول</h1>
                <p>مرحباً بعودتك — أدخل بياناتك للوصول للنظام</p>
                <div class="gold-bar"></div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert-modern alert-danger-modern">
                    <div class="alert-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                        </svg>
                    </div>
                    <span>@errorMessage</span>
                </div>
            }

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert-modern alert-success-modern">
                    <div class="alert-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                        </svg>
                    </div>
                    <span>@successMessage</span>
                </div>
            }

            <!-- حقل اسم المستخدم -->
            <div class="field-group">
                <label class="field-label">اسم المستخدم</label>
                <div class="field-wrapper @(isLoading ? "disabled" : "")">
                    <div class="field-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <input type="text" class="field-input" @bind="username" @bind:event="oninput"
                           @onkeydown="HandleKeyDown" placeholder="أدخل اسم المستخدم"
                           disabled="@isLoading" autocomplete="username" />
                </div>
            </div>

            <!-- حقل كلمة المرور -->
            <div class="field-group">
                <label class="field-label">كلمة المرور</label>
                <div class="field-wrapper @(isLoading ? "disabled" : "")">
                    <div class="field-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/>
                        </svg>
                    </div>
                    <input type="@(showPassword ? "text" : "password")" class="field-input" @bind="password"
                           @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="أدخل كلمة المرور"
                           disabled="@isLoading" autocomplete="current-password" />
                    <button class="toggle-password" type="button" tabindex="-1" @onclick="TogglePassword"
                            title="@(showPassword ? "إخفاء كلمة المرور" : "إظهار كلمة المرور")">
                        @if (showPassword)
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                                <line x1="1" y1="1" x2="23" y2="23"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>
                            </svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                        }
                    </button>
                </div>
            </div>
            <!-- زر الدخول -->
            <button class="login-btn" @onclick="DoLogin" disabled="@isLoading">
                @if (isLoading)
                {
                    <div class="btn-spinner"></div><span>جاري التحقق...</span>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    <span>تسجيل الدخول</span>
                }
            </button>

            <!-- التذييل -->
            <div class="login-footer">
                <div class="footer-text">
                    <span>© 2026 واي كي كوتينج</span>
                    <div class="footer-dot"></div>
                    <span>جميع الحقوق محفوظة</span>
                </div>
                <div class="footer-dev">
                    تصميم وتطوير : أحمد محمد الرفاعى
                    <span class="footer-dev-en">Developed by: Ahmed M. El-Refaey</span>
                    <span class="footer-dev-contact">للتواصل : 01122050119</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private string successMessage = "";
    private bool isLoading = false;
    private bool showPassword = false;

    private bool _sessionChecked;

    // نستعيد الجلسة بعد الرندر قبل أي تحويل، وإلا فإن Refresh على /login
    // وأنت مسجّل دخول يعرض نموذج الدخول بدلاً من توجيهك للوحة التحكم.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionChecked) return;
        _sessionChecked = true;

        if (await UserSession.EnsureRestoredAsync())
        {
            if (UserSession.RequiresPasswordChange)
                Navigation.NavigateTo("/change-password");
            else
                Navigation.NavigateTo("/dashboard");
        }
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(username))
        {
            errorMessage = "يجب إدخال اسم المستخدم";
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "يجب إدخال كلمة المرور";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            string machineName = "";
            string ipAddress = "unknown";

            try
            {
                var clientInfo = await JS.InvokeAsync<ClientInfo>("getClientInfo");
                machineName = clientInfo?.MachineName ?? "";
            }
            catch { }

            try
            {
                ipAddress = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "unknown";
            }
            catch { ipAddress = "unknown"; }

            var result = await AuthService.LoginAsync(username.Trim(), password, ipAddress, machineName);

            if (result.Success)
            {
                await UserSession.LoginAsync(
                    result.UserID,
                    result.Username,
                    result.FullName,
                    result.RoleID,
                    result.RoleName,
                    result.RoleCode,
                    result.EmployeeID,
                    result.MustChangePassword,
                    result.PasswordExpired
                );
                await PermissionService.LoadPermissionsAsync(result.UserID);
                UserSession.MachineName = machineName;
                UserSession.IPAddress = ipAddress;

                successMessage = result.Message;
                StateHasChanged();

                await Task.Delay(800);

                if (result.RequiresPasswordChange)
                    Navigation.NavigateTo("/change-password");
                else
                    Navigation.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = result.Message;
                password = "";
            }
        }
        catch (Exception)
        {
            errorMessage = "خطأ في الاتصال بالخادم. يرجى المحاولة لاحقاً.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ClientInfo
    {
        public string MachineName { get; set; } = "";
        public string ScreenSize { get; set; } = "";
        public string Language { get; set; } = "";
        public string Platform { get; set; } = "";
    }
}