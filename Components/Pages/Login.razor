@page "/login"
@layout YKCoatings.Components.Layout.EmptyLayout
@using YKCoatings.Services
@inject AuthService AuthService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.Extensions.Logging.ILogger<Login> Logger

<PageTitle>تسجيل الدخول - واي كي كوتينج</PageTitle>

<!-- ===== Aurora Minimal — Gold & Black & White ===== -->
<style>
    html, body { margin: 0; padding: 0; }

    /* ===== متغيرات الهوية — غيّر الألوان من هنا فقط ===== */
    .lg-page {
        --accent: #D4AF37;
        --accent-2: #E8C86A;
        --accent-dark: #9C7C2E;
        --btn-text: #0A0F1E;
        --text: #EEF1F6;
        --muted: #8A93A3;
        --border: rgba(255,255,255,.09);
        --surface: rgba(255,255,255,.03);
    }

    .lg-page * {
        font-family: 'Tajawal', 'Cairo', sans-serif;
        box-sizing: border-box;
    }

    /* ===== الصفحة ===== */
    .lg-page {
        height: 100vh;
        height: 100dvh;
        position: relative;
        overflow: hidden;
        direction: rtl;
        background: #06080C;
    }

    /* نقاط Grid خافتة بلمعة ذهبية */
    .lg-page::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        background-image: radial-gradient(rgba(212,175,55,.05) 1px, transparent 1px);
        background-size: 26px 26px;
        mask-image: radial-gradient(ellipse 70% 65% at 50% 42%, #000 15%, transparent 75%);
        -webkit-mask-image: radial-gradient(ellipse 70% 65% at 50% 42%, #000 15%, transparent 75%);
    }

    /* ===== توهجات Aurora الذهبية ===== */
    .aurora { position: absolute; inset: 0; pointer-events: none; }

    .aurora span {
        position: absolute;
        border-radius: 50%;
        filter: blur(75px);
    }

    .aur-1 {
        width: 540px; height: 540px;
        top: -170px; right: -110px;
        background: radial-gradient(circle, rgba(212,175,55,.16), transparent 65%);
        animation: aur1 18s ease-in-out infinite;
    }

    .aur-2 {
        width: 480px; height: 480px;
        bottom: -170px; left: -110px;
        background: radial-gradient(circle, rgba(156,124,46,.12), transparent 65%);
        animation: aur2 24s ease-in-out infinite;
    }

    .aur-3 {
        width: 380px; height: 380px;
        top: 38%; left: 58%;
        background: radial-gradient(circle, rgba(232,200,106,.08), transparent 65%);
        animation: aur3 22s ease-in-out infinite;
    }

    /* منطقة التمرير الداخلية (للشاشات القصيرة فقط) */
    .lg-scroll {
        position: relative;
        z-index: 2;
        width: 100%;
        height: 100%;
        overflow-y: auto;
        overflow-x: hidden;
        display: grid;
        place-items: center;
        padding: 32px 16px;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .lg-scroll::-webkit-scrollbar { display: none; }

    /* ===== الحاوية ===== */
    .lg-wrap {
        width: 100%;
        max-width: 400px;
        display: flex;
        flex-direction: column;
        align-items: center;
        animation: cardIn .7s cubic-bezier(.16,1,.3,1) both;
    }

    /* ===== الكارد ===== */
    .lg-card {
        position: relative;
        width: 100%;
        background: linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.018));
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 30px 28px 26px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow:
            0 24px 60px rgba(0,0,0,.45),
            0 0 80px rgba(212,175,55,.04);
    }

    /* خط إضاءة علوي ذهبي رفيع */
    .lg-card::before {
        content: '';
        position: absolute;
        top: -1px;
        left: 30px;
        right: 30px;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(232,200,106,.5), transparent);
    }

    /* ===== اللوجو ===== */
    .lg-logo {
        position: relative;
        display: flex;
        justify-content: center;
        margin-bottom: 14px;
    }

    .lg-logo img {
        max-width: 130px;
        max-height: 58px;
        object-fit: contain;
        position: relative;
        z-index: 1;
        filter: drop-shadow(0 4px 16px rgba(212,175,55,.2));
    }

    /* توهج ذهبي ثابت هادي خلف اللوجو */
    .lg-logo::before {
        content: '';
        position: absolute;
        inset: -26px -44px;
        background: radial-gradient(ellipse, rgba(212,175,55,.15), transparent 70%);
    }

    .lg-appname {
        text-align: center;
        font-size: .66rem;
        font-weight: 700;
        letter-spacing: 4px;
        color: rgba(212,175,55,.4);
        margin-bottom: 20px;
    }

    /* ===== العنوان ===== */
    .lg-head {
        text-align: center;
        margin-bottom: 20px;
    }

    .lg-head h1 {
        margin: 0 0 6px;
        font-size: 1.3rem;
        font-weight: 900;
        color: var(--text);
    }

    .lg-head p {
        margin: 0;
        font-size: .8rem;
        color: var(--muted);
    }

    /* ===== التنبيهات ===== */
    .alert-modern {
        display: flex;
        align-items: flex-start;
        gap: 11px;
        padding: 12px 15px;
        border-radius: 12px;
        font-size: .83rem;
        font-weight: 700;
        margin-bottom: 16px;
        line-height: 1.6;
        animation: alertIn .3s ease both;
        border: 1px solid;
    }

    .alert-danger-modern {
        background: rgba(239,68,68,.07);
        border-color: rgba(239,68,68,.25);
        color: #FCA5A5;
    }

    .alert-success-modern {
        background: rgba(16,185,129,.08);
        border-color: rgba(16,185,129,.28);
        color: #6EE7B7;
    }

    .alert-modern .alert-icon {
        flex-shrink: 0;
        width: 19px;
        height: 19px;
        margin-top: 2px;
    }

    .alert-modern .alert-icon svg { width: 19px; height: 19px; }

    /* ===== الحقول ===== */
    .field-group { margin-bottom: 14px; }

    .field-label {
        display: block;
        font-size: .8rem;
        font-weight: 700;
        color: #9AA3B2;
        margin-bottom: 7px;
        transition: color .25s ease;
    }

    .field-group:focus-within .field-label { color: var(--accent-2); }

    .field-wrapper {
        position: relative;
        display: flex;
        align-items: center;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        transition: border-color .25s, box-shadow .25s, background .25s;
    }

    .field-wrapper:hover {
        border-color: rgba(212,175,55,.22);
        background: rgba(255,255,255,.045);
    }

    .field-wrapper:focus-within {
        border-color: rgba(212,175,55,.55);
        background: rgba(255,255,255,.05);
        box-shadow:
            0 0 0 3px rgba(212,175,55,.12),
            0 0 20px rgba(212,175,55,.06);
    }

    .field-wrapper.disabled {
        opacity: .5;
        pointer-events: none;
    }

    .field-icon {
        position: absolute;
        right: 14px;
        display: flex;
        color: #5B6472;
        pointer-events: none;
        transition: color .25s;
    }

    .field-icon svg { width: 18px; height: 18px; }

    .field-wrapper:focus-within .field-icon { color: var(--accent-2); }

    .field-input {
        width: 100%;
        border: none;
        outline: none;
        background: transparent;
        padding: 13px 44px 13px 46px;
        font-size: .92rem;
        font-weight: 600;
        color: var(--text);
        font-family: inherit;
    }

    .field-input::placeholder {
        color: #4B5563;
        font-weight: 500;
    }

    .field-input:disabled { cursor: not-allowed; }

    .toggle-password {
        position: absolute;
        left: 12px;
        background: none;
        border: none;
        cursor: pointer;
        color: #5B6472;
        padding: 6px;
        display: flex;
        border-radius: 8px;
        transition: color .2s, background .2s;
    }

    .toggle-password:hover:not(:disabled) {
        color: var(--accent-2);
        background: rgba(212,175,55,.09);
    }

    .toggle-password:disabled { cursor: not-allowed; opacity: .5; }
    .toggle-password svg { width: 17px; height: 17px; }

    .toggle-password:focus-visible,
    .login-btn:focus-visible {
        outline: 2px solid rgba(232,200,106,.8);
        outline-offset: 2px;
    }

    /* ===== زر الدخول الذهبي ===== */
    .login-btn {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 13px 22px;
        margin-top: 8px;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-size: .97rem;
        font-weight: 800;
        font-family: inherit;
        color: var(--btn-text);
        background: linear-gradient(135deg, var(--accent-2), var(--accent) 55%, var(--accent-dark));
        box-shadow:
            0 6px 20px rgba(212,175,55,.22),
            0 0 0 1px rgba(255,255,255,.07) inset;
        transition: transform .2s, box-shadow .2s, filter .2s;
    }

    .login-btn:hover:not(:disabled) {
        transform: translateY(-1px);
        filter: brightness(1.06);
        box-shadow:
            0 10px 28px rgba(212,175,55,.32),
            0 0 0 1px rgba(255,255,255,.1) inset;
    }

    .login-btn:active:not(:disabled) { transform: translateY(0); }

    .login-btn:disabled { cursor: not-allowed; opacity: .65; }

    .login-btn svg { width: 18px; height: 18px; }

    .btn-spinner {
        width: 17px;
        height: 17px;
        border-radius: 50%;
        border: 2.5px solid rgba(10,15,30,.25);
        border-top-color: var(--btn-text);
        animation: spin .6s linear infinite;
    }

    /* ===== التذييل ===== */
    .lg-footer {
        margin-top: 20px;
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 4px;
        font-size: .72rem;
        color: #565F6E;
        font-weight: 600;
    }

    .lg-dev {
        font-size: .68rem;
        color: #454D5B;
    }

    .lg-dev bdi {
        color: rgba(212,175,55,.55);
        font-weight: 700;
        direction: ltr;
        unicode-bidi: isolate;
    }

    .lg-dev-en {
        display: block;
        font-size: .62rem;
        color: #3D4450;
        letter-spacing: .3px;
    }

    /* ===== الحركات ===== */
    @@keyframes cardIn {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes aur1 {
        0%, 100% { transform: translate3d(0,0,0) scale(1); }
        50% { transform: translate3d(-30px,26px,0) scale(1.08); }
    }

    @@keyframes aur2 {
        0%, 100% { transform: translate3d(0,0,0) scale(1); }
        50% { transform: translate3d(28px,-22px,0) scale(1.06); }
    }

    @@keyframes aur3 {
        0%, 100% { transform: translate3d(0,0,0) scale(1); }
        50% { transform: translate3d(-24px,-18px,0) scale(1.1); }
    }

    @@keyframes alertIn {
        from { opacity: 0; transform: translateY(-6px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes spin { to { transform: rotate(360deg); } }

    /* ===== التجاوب ===== */
    @@media (max-width: 480px) {
        .lg-scroll { padding: 22px 14px; }
        .lg-card { padding: 24px 20px 20px; border-radius: 16px; }
        .lg-logo img { max-width: 110px; max-height: 50px; }
        .lg-appname { font-size: .6rem; letter-spacing: 3px; margin-bottom: 16px; }
        .lg-head h1 { font-size: 1.2rem; }
        .lg-head p { font-size: .76rem; }
        .field-input { font-size: 16px; padding: 12px 42px 13px 44px; }
        .login-btn { padding: 12px 20px; font-size: .93rem; }
        .lg-dev-en { display: none; }
        .aurora span { filter: blur(60px); opacity: .75; }
    }

    /* شاشات قصيرة الارتفاع */
    @@media (max-height: 640px) {
        .lg-scroll { place-items: start center; padding-top: 18px; padding-bottom: 18px; }
        .lg-logo img { max-height: 44px; }
        .lg-appname { margin-bottom: 12px; }
        .lg-head { margin-bottom: 14px; }
        .lg-card { padding-top: 20px; padding-bottom: 18px; }
        .lg-footer { margin-top: 14px; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .aurora span, .lg-wrap, .alert-modern, .btn-spinner {
            animation: none !important;
        }
        .login-btn, .toggle-password, .field-wrapper, .field-icon, .field-label {
            transition: none !important;
        }
    }
</style>

<!-- ===== الهيكل: Aurora Minimal ===== -->
<div class="lg-page">
    <div class="aurora" aria-hidden="true">
        <span class="aur-1"></span>
        <span class="aur-2"></span>
        <span class="aur-3"></span>
    </div>

    <div class="lg-scroll">
        <div class="lg-wrap">

            <div class="lg-card">
                <!-- اللوجو -->
                <div class="lg-logo">
                    <img src="/images/yk-logo-white.png" alt="YK Coatings" />
                </div>
                <div class="lg-appname">YK COATINGS ERP</div>

                <div class="lg-head">
                    <h1>تسجيل الدخول</h1>
                    <p>مرحباً بعودتك — أدخل بياناتك للمتابعة</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert-modern alert-danger-modern" role="alert" aria-live="assertive" aria-atomic="true">
                        <div class="alert-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                            </svg>
                        </div>
                        <span>@errorMessage</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert-modern alert-success-modern" role="status" aria-live="polite" aria-atomic="true">
                        <div class="alert-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                            </svg>
                        </div>
                        <span>@successMessage</span>
                    </div>
                }

                <!-- حقل اسم المستخدم -->
                <div class="field-group">
                    <label class="field-label" for="login-username">اسم المستخدم</label>
                    <div class="field-wrapper @(isLoading ? "disabled" : "")">
                        <div class="field-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>
                            </svg>
                        </div>
                        <input @ref="usernameInputRef" id="login-username" name="username" type="text" class="field-input" @bind="username" @bind:event="oninput"
                               @onkeydown="HandleKeyDown" placeholder="أدخل اسم المستخدم"
                               disabled="@isLoading" autocomplete="username" required dir="auto" autocapitalize="none" spellcheck="false" />
                    </div>
                </div>

                <!-- حقل كلمة المرور -->
                <div class="field-group">
                    <label class="field-label" for="login-password">كلمة المرور</label>
                    <div class="field-wrapper @(isLoading ? "disabled" : "")">
                        <div class="field-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/><circle cx="12" cy="16" r="1"/>
                            </svg>
                        </div>
                        <input id="login-password" name="password" type="@(showPassword ? "text" : "password")" class="field-input" @bind="password"
                               @bind:event="oninput" @onkeydown="HandleKeyDown" placeholder="أدخل كلمة المرور"
                               disabled="@isLoading" autocomplete="current-password" required />
                        <button class="toggle-password" type="button" @onclick="TogglePassword" disabled="@isLoading"
                                aria-label="@(showPassword ? "إخفاء كلمة المرور" : "إظهار كلمة المرور")"
                                aria-controls="login-password" aria-pressed="@(showPassword ? "true" : "false")"
                                title="@(showPassword ? "إخفاء كلمة المرور" : "إظهار كلمة المرور")">
                            @if (showPassword)
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                                    <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                                    <line x1="1" y1="1" x2="23" y2="23"/><path d="M14.12 14.12a3 3 0 1 1-4.24-4.24"/>
                                </svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                </svg>
                            }
                        </button>
                    </div>
                </div>

                <!-- زر الدخول -->
                <button class="login-btn" @onclick="DoLogin" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <div class="btn-spinner"></div><span>جاري التحقق...</span>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/>
                        </svg>
                        <span>تسجيل الدخول</span>
                    }
                </button>
            </div>

            <!-- التذييل -->
            <div class="lg-footer">
                <span>© @DateTime.Now.Year واي كي كوتينج — جميع الحقوق محفوظة</span>
                <span class="lg-dev">
                    تصميم وتطوير: أحمد محمد الرفاعى · <bdi>01122050119</bdi>
                    <span class="lg-dev-en">Developed by: Ahmed M. El-Refaey</span>
                </span>
            </div>

        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private string successMessage = "";
    private bool isLoading = false;
    private bool showPassword = false;

    private bool _sessionChecked;

    // مرجع حقل اسم المستخدم للتركيز التلقائي
    private ElementReference usernameInputRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionChecked) return;
        _sessionChecked = true;

        if (await UserSession.EnsureRestoredAsync())
        {
            if (UserSession.RequiresPasswordChange)
                Navigation.NavigateTo("/change-password");
            else
                Navigation.NavigateTo("/dashboard");
            return;
        }

        // تركيز تلقائي على حقل اسم المستخدم — للشاشات الكبيرة فقط
        try
        {
            bool wideScreen = await JS.InvokeAsync<bool>("eval", "window.matchMedia('(min-width: 992px)').matches");
            if (wideScreen)
                await usernameInputRef.FocusAsync();
        }
        catch { /* تجاهل أي خطأ في التركيز — لا يؤثر على الدخول */ }
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await DoLogin();
    }

    private async Task DoLogin()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(username))
        {
            errorMessage = "يجب إدخال اسم المستخدم";
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "يجب إدخال كلمة المرور";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            string machineName = "";
            string ipAddress = "unknown";

            try
            {
                var clientInfo = await JS.InvokeAsync<ClientInfo>("getClientInfo");
                machineName = clientInfo?.MachineName ?? "";
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex,
                    "Failed to read browser client details for login audit; continuing with an empty machine name.");
            }

            try
            {
                ipAddress = HttpContextAccessor.HttpContext?.Connection?.RemoteIpAddress?.ToString() ?? "unknown";
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex,
                    "Failed to read remote address for login audit; continuing with an unknown address.");
                ipAddress = "unknown";
            }

            var result = await AuthService.LoginAsync(username.Trim(), password, ipAddress, machineName);

            if (result.Success)
            {
                await UserSession.LoginAsync(
                    result.UserID,
                    result.Username,
                    result.FullName,
                    result.RoleID,
                    result.RoleName,
                    result.RoleCode,
                    result.EmployeeID,
                    result.MustChangePassword,
                    result.PasswordExpired
                );
                await PermissionService.LoadPermissionsAsync(result.UserID);
                UserSession.MachineName = machineName;
                UserSession.IPAddress = ipAddress;

                successMessage = result.Message;
                StateHasChanged();

                await Task.Delay(800);

                if (result.RequiresPasswordChange)
                    Navigation.NavigateTo("/change-password");
                else
                    Navigation.NavigateTo("/dashboard");
            }
            else
            {
                errorMessage = result.Message;
                password = "";
            }
        }
        catch (Exception)
        {
            errorMessage = "خطأ في الاتصال بالخادم. يرجى المحاولة لاحقاً.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ClientInfo
    {
        public string MachineName { get; set; } = "";
        public string ScreenSize { get; set; } = "";
        public string Language { get; set; } = "";
        public string Platform { get; set; } = "";
    }
}