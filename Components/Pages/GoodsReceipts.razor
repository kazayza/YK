</style>

@code {
    private List<GoodsReceiptListDto>? receipts;
    private List<GoodsReceiptListDto> filtered = new();
    private ModulePermissionDto? permissions;
    private string searchText = "";
    private int filterStatus = 0;
    private bool isExporting = false;
    private string toast = "";
    private bool toastOk = true;
    private bool showAddMenu = false;
    private bool showDeleteDialog = false;
    private GoodsReceiptListDto? deleteReceipt;
    private string deleteMsg = "";

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_GRN");
        if (permissions != null && permissions.CanView) await LoadData();
    }

    private async Task LoadData()
    {
        receipts = await GrnService.GetReceiptsListAsync();
        Filter();
    }

    private void Filter()
    {
        if (receipts == null) return;
        filtered = receipts.Where(r =>
            (filterStatus == 0 || r.GRNStatus == filterStatus) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(r.GRNNumber, searchText) ||
             ArabicSearchHelper.Contains(r.SupplierNameAr, searchText) ||
             ArabicSearchHelper.Contains(r.LinkedPONumber, searchText))
        ).ToList();
    }

    private void ClearSearch() { searchText = ""; Filter(); }
    private void ToggleAddMenu() { showAddMenu = !showAddMenu; }
    private void CloseAddMenu() { showAddMenu = false; }

    private void AddFromPO()
    {
        showAddMenu = false;
        Navigation.NavigateTo("/goods-receipts/new?source=po");
    }

    private void AddDirect()
    {
        showAddMenu = false;
        Navigation.NavigateTo("/goods-receipts/new?source=direct");
    }

    private void ViewReceipt(int id)
    {
        var grn = receipts?.FirstOrDefault(r => r.GRNID == id);
        if (grn != null && grn.GRNStatus == 1 && permissions != null && (permissions.CanEdit || permissions.CanApprove))
            Navigation.NavigateTo($"/goods-receipts/edit/{id}");
        else
            Navigation.NavigateTo($"/goods-receipts/view/{id}");
    }

    private void EditReceipt(int id) => Navigation.NavigateTo($"/goods-receipts/edit/{id}");

    private async Task PrintReceipt(int id)
    {
        try
        {
            var html = await GrnService.GenerateReportHtmlAsync(id, UserSession.UserID);
            await JS.InvokeVoidAsync("printHtml", html);
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
    }

    private async Task ExportExcel()
    {
        if (!filtered.Any()) return;
        isExporting = true; StateHasChanged();
        try
        {
            var bytes = await GrnService.ExportToExcelAsync(filtered, UserSession.UserID);
            await JS.InvokeVoidAsync("downloadFile",
                $"GoodsReceipts_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isExporting = false; }
    }

    private void ShowDeleteDialog(GoodsReceiptListDto grn)
    { deleteReceipt = grn; deleteMsg = ""; showDeleteDialog = true; }
    private void CloseDeleteDialog() { showDeleteDialog = false; }

    private async Task ConfirmDelete()
    {
        if (deleteReceipt == null) return;
        try
        {
            var result = await GrnService.DeleteReceiptAsync(deleteReceipt.GRNID, UserSession.UserID);
            if (result.Success) { toast = result.Message + " ✅"; toastOk = true; showDeleteDialog = false; await LoadData(); }
            else { deleteMsg = result.Message; }
        }
        catch (Exception ex) { deleteMsg = "خطأ: " + ex.Message; }
    }
}