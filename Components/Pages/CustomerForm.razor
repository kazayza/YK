    private async Task SaveCustomer()
    {
        if(isViewMode)return;formMessage="";
        if(string.IsNullOrWhiteSpace(model.CustomerNameAr)){formMessage="يجب إدخال اسم العميل";formSuccess=false;activeTab="basic";return;}
        if(model.CustomerType==0){formMessage="يجب اختيار نوع العميل";formSuccess=false;activeTab="basic";return;}
        if((model.CurrencyID ?? 0)==0){formMessage="يجب اختيار العملة";formSuccess=false;activeTab="finance";return;}
        if(model.CreditLimit<0){formMessage="حد الائتمان لا يمكن أن يكون سالباً";formSuccess=false;activeTab="finance";return;}
        if(model.OpeningBalance<0){formMessage="الرصيد الافتتاحي لا يمكن أن يكون سالباً";formSuccess=false;activeTab="finance";return;}
        if(model.DiscountPercent<0||model.DiscountPercent>100){formMessage="نسبة الخصم يجب أن تكون بين 0 و 100";formSuccess=false;activeTab="finance";return;}
        if(model.Rating<1||model.Rating>5){formMessage="التقييم يجب أن يكون بين 1 و 5";formSuccess=false;activeTab="basic";return;}
        isSaving=true;
        try{
            if(isNewMode){model.CustomerCode=await CustomerService.GenerateCustomerCodeAsync();var newId=await CustomerService.InsertCustomerAsync(model, UserSession.UserID);resultMessage="تم إضافة العميل بنجاح ";resultSuccess=true;Navigation.NavigateTo($"/customers/edit/{newId}");return;}
            else{await CustomerService.UpdateCustomerAsync(model, UserSession.UserID);resultMessage="تم حفظ التعديلات بنجاح ";resultSuccess=true;formMessage="تم حفظ البيانات بنجاح";formSuccess=true;}
        }catch(Exception ex){formMessage="خطأ: "+ex.Message;formSuccess=false;}
        finally{isSaving=false;}
    }
    private void OnCustomerCodeChanged(ChangeEventArgs e){model.CustomerCode=e.Value?.ToString();}
    private void GoToEditMode(){if(model.CustomerID>0)Navigation.NavigateTo($"/customers/edit/{model.CustomerID}");}
    private string GetLookupName(List<LookupDto>? source, int? id){if(source==null||(id??0)==0)return "—";return source.FirstOrDefault(x=>x.Id==id)?.Name ?? "—";}
    private int GetTabIndex(string tab)=>tab switch{"basic"=>0,"contact"=>1,"finance"=>2,"contacts"=>3,"notes"=>4,_=>0};
    private int GetCreditPercent(){if(model.CreditLimit<=0)return 0;var used=model.CurrentBalance/model.CreditLimit*100;return Math.Clamp((int)used,0,100);}
    private void ShowAddContactDialog(){contactModel=new CustomerContactDto{CustomerID=model.CustomerID,IsPrimary=!contacts.Any()};contactDialogMessage="";showContactDialog=true;}
    private void ShowEditContactDialog(CustomerContactDto item){contactModel=new CustomerContactDto{ContactID=item.ContactID,CustomerID=item.CustomerID,ContactName=item.ContactName,JobTitle=item.JobTitle,Phone=item.Phone,Mobile=item.Mobile,Email=item.Email,IsPrimary=item.IsPrimary,Notes=item.Notes,IsActive=item.IsActive};contactDialogMessage="";showContactDialog=true;}
