    private async Task SaveContact()
    {
        contactDialogMessage="";if(model.CustomerID<=0){contactDialogMessage="يجب حفظ العميل أولاً";return;}if(string.IsNullOrWhiteSpace(contactModel.ContactName)){contactDialogMessage="اسم جهة الاتصال مطلوب";return;}
        isContactSaving=true;
        try{contactModel.CustomerID=model.CustomerID;await CustomerService.SaveCustomerContactAsync(contactModel, UserSession.UserID);contactMessage=contactModel.ContactID==0?"تمت إضافة جهة الاتصال بنجاح ":"تم تعديل جهة الاتصال بنجاح ";contactSuccess=true;showContactDialog=false;contactModel=new CustomerContactDto();await LoadContactsAsync();}
        catch(Exception ex){contactDialogMessage="خطأ: "+ex.Message;}
        finally{isContactSaving=false;}
    }
    private async Task DeleteContact(CustomerContactDto item){var confirmed=await JS.InvokeAsync<bool>("confirm",$"هل تريد حذف جهة الاتصال: {item.ContactName} ؟");if(!confirmed)return;try{var result=await CustomerService.DeleteCustomerContactAsync(item.ContactID, UserSession.UserID);contactMessage=result.Message+(result.Success?" ":"");contactSuccess=result.Success;await LoadContactsAsync();}catch(Exception ex){contactMessage="خطأ: "+ex.Message;contactSuccess=false;}}
