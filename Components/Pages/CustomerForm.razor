    private async Task LoadCustomerRecordAsync()
    {
        var customerId = CustomerId;
        var requestVersion = ++customerRecordLoadVersion;
        isCustomerRecordLoading = true;
        customerRecordLoadFailed = false;
        customerRecordLoadDenied = false;
        customerRecordNotFound = false;
        try
        {
            var loaded = await CustomerService.GetCustomerByIdAsync(customerId);
            if (requestVersion != customerRecordLoadVersion || CustomerId != customerId) return;

            if (loaded is null)
            {
                customerRecordLoaded = false;
                customerRecordNotFound = true;
                model = new CustomerEditDto();
                contactsLoadVersion++;
                isContactsLoading = false;
                contacts = new List<CustomerContactDto>();
                contactsLoaded = true;
                contactsLoadFailed = false;
                contactsLoadError = string.Empty;
                return;
            }

            model = loaded;
            previousCustomerGroupId = loaded.CustomerGroupID.GetValueOrDefault();
            customerRecordLoaded = true;
        }
        catch (UnauthorizedAccessException)
        {
            if (requestVersion != customerRecordLoadVersion || CustomerId != customerId) return;

            customerRecordLoaded = false;
            customerRecordLoadDenied = true;
            model = new CustomerEditDto();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load customer record for customer form.");
            if (requestVersion != customerRecordLoadVersion || CustomerId != customerId) return;

            customerRecordLoadFailed = true;
        }
        finally
        {
            if (requestVersion == customerRecordLoadVersion && CustomerId == customerId)
                isCustomerRecordLoading = false;
        }
    }

