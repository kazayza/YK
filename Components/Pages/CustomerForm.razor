    private Task ApplyCustomerGroupDefaultsAsync()
    {
        var selectedGroupId = model.CustomerGroupID.GetValueOrDefault();
        var previousGroup = customerGroups?.FirstOrDefault(group => group.Id == previousCustomerGroupId);
        var discountMatchesPreviousDefault = previousGroup is not null
            ? model.DiscountPercent == previousGroup.DiscountPercent
            : model.DiscountPercent == 0;
        var priceListMatchesPreviousDefault = previousGroup is not null
            ? model.PriceListID.GetValueOrDefault() == previousGroup.PriceListID.GetValueOrDefault()
            : model.PriceListID.GetValueOrDefault() <= 0;

        if (selectedGroupId <= 0)
        {
            if (discountMatchesPreviousDefault)
                model.DiscountPercent = 0;
            if (priceListMatchesPreviousDefault)
                model.PriceListID = null;

            previousCustomerGroupId = 0;
            customerGroupDefaultsMessage = "أزيلت افتراضيات المجموعة السابقة؛ أُبقيت أي قيم خصم أو قائمة أسعار عُدلت يدويًا.";
            return Task.CompletedTask;
        }

        var selectedGroup = customerGroups?.FirstOrDefault(group => group.Id == selectedGroupId);
        if (selectedGroup is null)
        {
            customerGroupDefaultsMessage = "تعذر تحديد افتراضيات المجموعة؛ راجع الخصم وقائمة الأسعار يدويًا.";
            return Task.CompletedTask;
        }

        if (discountMatchesPreviousDefault)
            model.DiscountPercent = selectedGroup.DiscountPercent;

        var selectedGroupPriceListId = selectedGroup.PriceListID.GetValueOrDefault();
        var groupHasPriceList = selectedGroupPriceListId > 0;
        var groupPriceListAvailable = !groupHasPriceList
            || priceLists?.Any(list => list.Id == selectedGroupPriceListId) == true;
        var priceListWasApplied = priceListMatchesPreviousDefault && groupPriceListAvailable;
        if (priceListWasApplied)
            model.PriceListID = groupHasPriceList ? selectedGroupPriceListId : null;

        previousCustomerGroupId = selectedGroupId;
        var discountMessage = discountMatchesPreviousDefault
            ? $"الخصم الافتراضي للمجموعة {selectedGroup.DiscountPercent:0.##}%"
            : "احتُفظ بخصم العميل المعدل يدويًا";
        string priceListMessage;
        if (!priceListMatchesPreviousDefault)
        {
            priceListMessage = "احتُفظت بقائمة الأسعار المعدلة يدويًا";
        }
        else if (!groupPriceListAvailable)
        {
            priceListMessage = "لم تُطبق قائمة المجموعة لأن خيارات قوائم الأسعار غير متاحة؛ أعد تحميلها قبل الحفظ";
        }
        else if (groupHasPriceList)
        {
            var priceListName = priceLists?.FirstOrDefault(list => list.Id == selectedGroupPriceListId)?.Name;
            priceListName = string.IsNullOrWhiteSpace(priceListName) ? $"#{selectedGroupPriceListId}" : priceListName;
            priceListMessage = $"قائمة الأسعار {priceListName}";
        }
        else
        {
            priceListMessage = "لا توجد قائمة خاصة للمجموعة؛ ستُستخدم القائمة الافتراضية عند التسعير";
        }
        customerGroupDefaultsMessage = $"{discountMessage}؛ {priceListMessage}. راجع القيم في تبويب المالية قبل الحفظ.";
        return Task.CompletedTask;
    }

