    private async Task LoadContactsAsync()
    {
        var customerId = model.CustomerID;
        if (customerId <= 0)
        {
            contactsLoadVersion++;
            contactsContextCustomerId = customerId;
            contacts = new List<CustomerContactDto>();
            contactsLoaded = true;
            contactsLoadFailed = false;
            contactsLoadError = string.Empty;
            isContactsLoading = false;
            return;
        }

        if (contactsContextCustomerId != customerId)
        {
            contactsLoadVersion++;
            contactsContextCustomerId = customerId;
            contacts = new List<CustomerContactDto>();
            contactsLoaded = false;
            contactsLoadFailed = false;
            contactsLoadError = string.Empty;
        }

        var requestVersion = ++contactsLoadVersion;
        isContactsLoading = true;
        try
        {
            var loadedContacts = await CustomerService.GetCustomerContactsAsync(customerId);
            if (requestVersion != contactsLoadVersion || model.CustomerID != customerId) return;

            contacts = loadedContacts ?? new List<CustomerContactDto>();
            contactsLoaded = true;
            contactsLoadFailed = false;
            contactsLoadError = string.Empty;
        }
        catch (Exception ex)
        {
            if (requestVersion != contactsLoadVersion || model.CustomerID != customerId) return;

            Logger.LogWarning(ex,
                "Failed to load contacts for customer {CustomerID}.",
                customerId);
            contactsLoadFailed = true;
            contactsLoadError = contactsLoaded
                ? "تعذر تحديث جهات الاتصال؛ ما زالت آخر قائمة ناجحة معروضة. أعد المحاولة."
                : "تعذر تحميل جهات الاتصال. أعد المحاولة.";
        }
        finally
        {
            if (requestVersion == contactsLoadVersion)
                isContactsLoading = false;
        }
    }
    private async Task LoadAuditInfo()
    {
        var customerId = model.CustomerID;
        if (customerId <= 0) return;

        if (auditInfoContextCustomerId != customerId)
        {
            auditInfoLoadVersion++;
            auditInfoContextCustomerId = customerId;
            auditInfoLoaded = false;
            auditInfoLoadFailed = false;
            auditInfoLoadDenied = false;
            auditInfoWarning = string.Empty;
            isAuditInfoLoading = false;
            ClearAuditInfoValues();
        }

        var requestVersion = ++auditInfoLoadVersion;
        isAuditInfoLoading = true;
        auditInfoLoadFailed = false;
        auditInfoLoadDenied = false;
        auditInfoWarning = string.Empty;
        try
        {
            var audit = await CustomerService.GetCustomerAuditAsync(customerId);
            if (requestVersion != auditInfoLoadVersion || model.CustomerID != customerId) return;

            if (audit is null)
            {
                ClearAuditInfoValues();
                auditInfoLoaded = true;
                return;
            }

            createdByName = audit.CreatedByName ?? "غير محدد";
            createdDate = audit.CreatedDate?.ToString("dd/MM/yyyy hh:mm tt") ?? "";
            modifiedByName = audit.ModifiedByName ?? "";
            modifiedDate = audit.ModifiedDate?.ToString("dd/MM/yyyy hh:mm tt") ?? "";
            auditInfoLoaded = true;
        }
        catch (UnauthorizedAccessException)
        {
            if (requestVersion != auditInfoLoadVersion || model.CustomerID != customerId) return;

            ClearAuditInfoValues();
            auditInfoLoaded = false;
            auditInfoLoadDenied = true;
            auditInfoWarning = "ليس لديك صلاحية قراءة سجل مراجعة العميل.";
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex,
                "Failed to load audit details for customer {CustomerID}.",
                customerId);
            if (requestVersion != auditInfoLoadVersion || model.CustomerID != customerId) return;

            auditInfoLoadFailed = true;
            auditInfoWarning = auditInfoLoaded
                ? "تعذر تحديث سجل مراجعة العميل؛ ما زال آخر سجل ناجح معروضًا."
                : "تعذر تحميل سجل مراجعة العميل الإضافي؛ بيانات العميل الأساسية لم تتأثر.";
        }
        finally
        {
            if (requestVersion == auditInfoLoadVersion && model.CustomerID == customerId)
                isAuditInfoLoading = false;
        }
    }

