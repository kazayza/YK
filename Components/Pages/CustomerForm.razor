@page "/customers/new"
@page "/customers/edit/{CustomerId:int}"
@page "/customers/view/{CustomerId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject CustomerService CustomerService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@PageTitleText - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card">
        <div class="no-access-icon">🔒</div>
        <h4>يجب تسجيل الدخول أولاً</h4>
    </div>
}
else if (permissions == null || !HasAccessToCurrentMode())
{
    <div class="no-access-card">
        <div class="no-access-icon">⛔</div>
        <h4>ليس لديك صلاحية للوصول إلى هذه الصفحة</h4>
        <button class="btn-modern btn-secondary-modern" @onclick='() => Navigation.NavigateTo("/customers")'>
            العودة لقائمة العملاء
        </button>
    </div>
}
else if (isLoading)
{
    <div class="loading-state">
        <div class="loader"></div>
        <p>جاري تحميل البيانات...</p>
    </div>
}
else
{
    <div class="customer-form-page" dir="rtl">

        <div class="page-header">
            <div>
                <div class="breadcrumb-line">
                    <span class="crumb-link" @onclick='() => Navigation.NavigateTo("/customers")'>العملاء</span>
                    <span class="crumb-sep">/</span>
                    <span class="crumb-current">@PageTitleText</span>
                </div>

                <h2 class="page-title">@PageTitleText</h2>
                <p class="page-subtitle">
                    @if (isNewMode)
                    {
                        <span>إدخال بيانات عميل جديد</span>
                    }
                    else if (isEditMode)
                    {
                        <span>تعديل بيانات العميل وجهات الاتصال</span>
                    }
                    else
                    {
                        <span>عرض بيانات العميل وجهات الاتصال</span>
                    }
                </p>
            </div>

            <div class="header-actions">
                @if (!isNewMode)
                {
                    <span class="status-badge @(model.IsActive ? "status-active" : "status-inactive")">
                        @(model.IsActive ? "نشط" : "غير نشط")
                    </span>
                }

                @if (isViewMode && permissions.CanEdit && CustomerId > 0)
                {
                    <button class="btn-modern btn-primary-modern" @onclick="GoToEditMode">
                        تعديل
                    </button>
                }

                @if (!isViewMode)
                {
                    <button class="btn-modern btn-primary-modern" @onclick="SaveCustomer" disabled="@isSaving">
                        @if (isSaving)
                        {
                            <div class="btn-spinner-sm"></div>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <span>@(isNewMode ? "حفظ العميل" : "حفظ التعديلات")</span>
                        }
                    </button>
                }

                <button class="btn-modern btn-ghost" @onclick='() => Navigation.NavigateTo("/customers")'>
                    رجوع
                </button>
            </div>
        </div>

        <div class="summary-strip">
            <div class="summary-item">
                <div class="summary-label">كود العميل</div>
                <div class="summary-value">@(string.IsNullOrWhiteSpace(model.CustomerCode) ? "سيولد عند الحفظ" : model.CustomerCode)</div>
            </div>

            <div class="summary-item">
                <div class="summary-label">الرصيد الحالي</div>
                <div class="summary-value">@model.CurrentBalance.ToString("#,##0.00")</div>
            </div>

            <div class="summary-item">
                <div class="summary-label">العملة</div>
                <div class="summary-value">@GetLookupName(currencies, model.CurrencyID)</div>
            </div>

            <div class="summary-item">
                <div class="summary-label">المندوب</div>
                <div class="summary-value">@GetLookupName(salesReps, model.SalesRepID)</div>
            </div>
        </div>

        <div class="tabs-bar">
            <button class="tab-btn @(activeTab == "basic" ? "active" : "")" @onclick='() => activeTab = "basic"'>
                البيانات الأساسية
            </button>
            <button class="tab-btn @(activeTab == "contact" ? "active" : "")" @onclick='() => activeTab = "contact"'>
                التواصل
            </button>
            <button class="tab-btn @(activeTab == "finance" ? "active" : "")" @onclick='() => activeTab = "finance"'>
                المالية
            </button>
            <button class="tab-btn @(activeTab == "contacts" ? "active" : "")" @onclick='() => activeTab = "contacts"'>
                جهات الاتصال
            </button>
            <button class="tab-btn @(activeTab == "notes" ? "active" : "")" @onclick='() => activeTab = "notes"'>
                ملاحظات
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(formMessage))
        {
            <div class="form-message @(formSuccess ? "msg-success" : "msg-error")">@formMessage</div>
        }

        <div class="form-card">
            @if (activeTab == "basic")
            {
                <div>
                    <div class="section-title">البيانات الأساسية</div>

                    <div class="form-grid cols-3">
                        <div class="form-field">
                            <label class="field-label required-field">كود العميل</label>
                            <input type="text"
                                   class="field-input"
                                   value="@(string.IsNullOrWhiteSpace(model.CustomerCode) ? "" : model.CustomerCode)"
                                   @oninput="OnCustomerCodeChanged"
                                   dir="ltr"
                                   disabled="@isNewMode || isViewMode"
                                   placeholder="سيولد تلقائياً عند الحفظ" />
                        </div>

                        <div class="form-field">
                            <label class="field-label required-field">اسم العميل (عربي)</label>
                            <input type="text" class="field-input" @bind="model.CustomerNameAr" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">اسم العميل (إنجليزي)</label>
                            <input type="text" class="field-input" @bind="model.CustomerNameEn" dir="ltr" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label required-field">نوع العميل</label>
                            <select class="field-select" @bind="model.CustomerType" disabled="@isViewMode">
                                <option value="0">-- اختر --</option>
                                <option value="1">جملة</option>
                                <option value="2">نص جملة</option>
                                <option value="3">تجزئة</option>
                                <option value="4">أونلاين</option>
                                <option value="5">مؤسسي</option>
                            </select>
                        </div>

                        <div class="form-field">
                            <label class="field-label">مجموعة العميل</label>
                            <select class="field-select" @bind="model.CustomerGroupID" disabled="@isViewMode">
                                <option value="0">-- بدون --</option>
                                @if (customerGroups != null)
                                {
                                    @foreach (var item in customerGroups)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-field">
                            <label class="field-label">الحالة</label>
                            <input type="text"
                                   class="field-input readonly-input"
                                   value="@(isNewMode ? "سيصبح نشطًا بعد الحفظ" : (model.IsActive ? "نشط" : "غير نشط"))"
                                   disabled />
                            @if (!isNewMode)
                            {
                                <small class="field-hint">تغيير الحالة يتم من شاشة قائمة العملاء</small>
                            }
                        </div>

                        <div class="form-field">
                            <label class="field-label">الرقم الضريبي</label>
                            <input type="text" class="field-input" @bind="model.TaxNumber" dir="ltr" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">السجل التجاري</label>
                            <input type="text" class="field-input" @bind="model.CommercialRegister" dir="ltr" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">التقييم</label>
                            <select class="field-select" @bind="model.Rating" disabled="@isViewMode">
                                <option value="1">⭐</option>
                                <option value="2">⭐⭐</option>
                                <option value="3">⭐⭐⭐</option>
                                <option value="4">⭐⭐⭐⭐</option>
                                <option value="5">⭐⭐⭐⭐⭐</option>
                            </select>
                        </div>
                    </div>
                </div>
            }

            @if (activeTab == "contact")
            {
                <div>
                    <div class="section-title">بيانات التواصل</div>

                    <div class="form-grid cols-3">
                        <div class="form-field">
                            <label class="field-label">هاتف 1</label>
                            <input type="text" class="field-input" @bind="model.Phone1" dir="ltr" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">هاتف 2</label>
                            <input type="text" class="field-input" @bind="model.Phone2" dir="ltr" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">موبايل</label>
                            <input type="text" class="field-input" @bind="model.Mobile" dir="ltr" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">فاكس</label>
                            <input type="text" class="field-input" @bind="model.Fax" dir="ltr" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">البريد الإلكتروني</label>
                            <input type="email" class="field-input" @bind="model.Email" dir="ltr" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">الموقع الإلكتروني</label>
                            <input type="text" class="field-input" @bind="model.Website" dir="ltr" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">الدولة</label>
                            <input type="text" class="field-input" @bind="model.Country" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">المدينة</label>
                            <input type="text" class="field-input" @bind="model.City" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">المنطقة</label>
                            <input type="text" class="field-input" @bind="model.Region" disabled="@isViewMode" />
                        </div>
                    </div>

                    <div class="form-field full-width">
                        <label class="field-label">العنوان</label>
                        <textarea class="field-input" rows="3" @bind="model.Address" disabled="@isViewMode"></textarea>
                    </div>
                </div>
            }

            @if (activeTab == "finance")
            {
                <div>
                    <div class="section-title">البيانات المالية والمبيعات</div>

                    <div class="form-grid cols-3">
                        <div class="form-field">
                            <label class="field-label">شروط الدفع</label>
                            <select class="field-select" @bind="model.PaymentTermID" disabled="@isViewMode">
                                <option value="0">-- اختر --</option>
                                @if (paymentTerms != null)
                                {
                                    @foreach (var item in paymentTerms)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-field">
                            <label class="field-label required-field">العملة</label>
                            <select class="field-select" @bind="model.CurrencyID" disabled="@isViewMode">
                                <option value="0">-- اختر --</option>
                                @if (currencies != null)
                                {
                                    @foreach (var item in currencies)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-field">
                            <label class="field-label">قائمة الأسعار</label>
                            <select class="field-select" @bind="model.PriceListID" disabled="@isViewMode">
                                <option value="0">-- اختر --</option>
                                @if (priceLists != null)
                                {
                                    @foreach (var item in priceLists)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-field">
                            <label class="field-label">مندوب المبيعات</label>
                            <select class="field-select" @bind="model.SalesRepID" disabled="@isViewMode">
                                <option value="0">-- بدون --</option>
                                @if (salesReps != null)
                                {
                                    @foreach (var item in salesReps)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="form-field">
                            <label class="field-label">حد الائتمان</label>
                            <input type="number" class="field-input" @bind="model.CreditLimit" step="0.01" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">نسبة الخصم %</label>
                            <input type="number" class="field-input" @bind="model.DiscountPercent" step="0.01" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">الرصيد الافتتاحي</label>
                            <input type="number" class="field-input" @bind="model.OpeningBalance" step="0.01" disabled="@(!isNewMode || isViewMode)" />
                            @if (!isNewMode)
                            {
                                <small class="field-hint">لا يمكن تعديل الرصيد الافتتاحي بعد الحفظ</small>
                            }
                        </div>

                        <div class="form-field">
                            <label class="field-label">الرصيد الحالي</label>
                            <input type="number" class="field-input readonly-input" value="@model.CurrentBalance.ToString("0.00")" disabled />
                        </div>

                        <div class="form-field">
                            <label class="field-label">اسم البنك</label>
                            <input type="text" class="field-input" @bind="model.BankName" disabled="@isViewMode" />
                        </div>

                        <div class="form-field">
                            <label class="field-label">رقم الحساب البنكي</label>
                            <input type="text" class="field-input" @bind="model.BankAccountNumber" dir="ltr" disabled="@isViewMode" />
                        </div>
                    </div>
                </div>
            }

            @if (activeTab == "contacts")
            {
                <div>
                    <div class="section-title contacts-header">
                        <span>جهات الاتصال</span>

                        @if (!isViewMode && model.CustomerID > 0)
                        {
                            <button class="btn-modern btn-primary-modern btn-sm" @onclick="ShowAddContactDialog">
                                + إضافة جهة اتصال
                            </button>
                        }
                    </div>

                    @if (model.CustomerID <= 0)
                    {
                        <div class="notice-box">
                            يجب حفظ العميل أولاً قبل إضافة جهات الاتصال.
                        </div>
                    }
                    else if (isContactsLoading)
                    {
                        <div class="loading-inline">جاري تحميل جهات الاتصال...</div>
                    }
                    else if (!contacts.Any())
                    {
                        <div class="empty-inline">لا توجد جهات اتصال مسجلة لهذا العميل.</div>
                    }
                    else
                    {
                        <div class="table-card mini-table-card">
                            <div class="table-responsive">
                                <table class="data-table mini-table">
                                    <thead>
                                        <tr>
                                            <th>الاسم</th>
                                            <th>الوظيفة</th>
                                            <th>الهاتف</th>
                                            <th>الموبايل</th>
                                            <th>البريد</th>
                                            <th class="th-center">أساسي</th>
                                            @if (!isViewMode)
                                            {
                                                <th class="th-actions">إجراءات</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in contacts)
                                        {
                                            <tr>
                                                <td class="item-name">@item.ContactName</td>
                                                <td>@(item.JobTitle ?? "—")</td>
                                                <td dir="ltr">@(item.Phone ?? "—")</td>
                                                <td dir="ltr">@(item.Mobile ?? "—")</td>
                                                <td dir="ltr">@(item.Email ?? "—")</td>
                                                <td class="td-center">
                                                    @if (item.IsPrimary)
                                                    {
                                                        <span class="primary-badge">أساسي</span>
                                                    }
                                                    else
                                                    {
                                                        <span>—</span>
                                                    }
                                                </td>
                                                @if (!isViewMode)
                                                {
                                                    <td class="td-actions">
                                                        <div class="actions-wrap">
                                                            <button class="action-btn edit-btn" @onclick="() => ShowEditContactDialog(item)">تعديل</button>
                                                            <button class="action-btn delete-btn" @onclick="() => DeleteContact(item)">حذف</button>
                                                        </div>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(contactMessage))
                    {
                        <div class="form-message @(contactSuccess ? "msg-success" : "msg-error")">@contactMessage</div>
                    }
                </div>
            }

            @if (activeTab == "notes")
            {
                <div>
                    <div class="section-title">ملاحظات</div>
                    <div class="form-field full-width">
                        <label class="field-label">ملاحظات العميل</label>
                        <textarea class="field-input" rows="6" @bind="model.Notes" disabled="@isViewMode"></textarea>
                    </div>
                </div>
            }
        </div>

        @if (!isViewMode)
        {
            <div class="footer-actions">
                <button class="btn-modern btn-primary-modern" @onclick="SaveCustomer" disabled="@isSaving">
                    @if (isSaving)
                    {
                        <div class="btn-spinner-sm"></div>
                        <span>جاري الحفظ...</span>
                    }
                    else
                    {
                        <span>@(isNewMode ? "حفظ العميل" : "حفظ التعديلات")</span>
                    }
                </button>

                <button class="btn-modern btn-ghost" @onclick='() => Navigation.NavigateTo("/customers")'>
                    إلغاء
                </button>
            </div>
        }
    </div>

    @if (showContactDialog)
    {
        <div class="modal-overlay" @onclick="CloseContactDialog">
            <div class="modal-card form-modal-md" @onclick:stopPropagation="true">
                <h3 class="modal-title">@(contactModel.ContactID == 0 ? "إضافة جهة اتصال" : "تعديل جهة اتصال")</h3>

                <div class="form-grid cols-2">
                    <div class="form-field">
                        <label class="field-label required-field">الاسم</label>
                        <input type="text" class="field-input" @bind="contactModel.ContactName" />
                    </div>

                    <div class="form-field">
                        <label class="field-label">الوظيفة</label>
                        <input type="text" class="field-input" @bind="contactModel.JobTitle" />
                    </div>

                    <div class="form-field">
                        <label class="field-label">الهاتف</label>
                        <input type="text" class="field-input" @bind="contactModel.Phone" dir="ltr" />
                    </div>

                    <div class="form-field">
                        <label class="field-label">الموبايل</label>
                        <input type="text" class="field-input" @bind="contactModel.Mobile" dir="ltr" />
                    </div>

                    <div class="form-field">
                        <label class="field-label">البريد الإلكتروني</label>
                        <input type="email" class="field-input" @bind="contactModel.Email" dir="ltr" />
                    </div>

                    <div class="form-field checkbox-field">
                        <label class="checkbox-wrap">
                            <input type="checkbox" @bind="contactModel.IsPrimary" />
                            <span>جهة الاتصال الأساسية</span>
                        </label>
                    </div>
                </div>

                <div class="form-field full-width">
                    <label class="field-label">ملاحظات</label>
                    <textarea class="field-input" rows="3" @bind="contactModel.Notes"></textarea>
                </div>

                @if (!string.IsNullOrWhiteSpace(contactDialogMessage))
                {
                    <div class="form-message msg-error">@contactDialogMessage</div>
                }

                <div class="modal-buttons-row">
                    <button class="btn-modern btn-primary-modern" @onclick="SaveContact" disabled="@isContactSaving">
                        @if (isContactSaving)
                        {
                            <div class="btn-spinner-sm"></div>
                            <span>جاري الحفظ...</span>
                        }
                        else
                        {
                            <span>حفظ</span>
                        }
                    </button>

                    <button class="btn-modern btn-ghost" @onclick="CloseContactDialog" disabled="@isContactSaving">
                        إلغاء
                    </button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <div class="toast-container">
            <div class="toast-card @(resultSuccess ? "toast-success" : "toast-error")">
                <span class="toast-text">@resultMessage</span>
                <button class="toast-close" @onclick='() => resultMessage = ""'>✕</button>
            </div>
        </div>
    }
}

<style>
    .customer-form-page { display: flex; flex-direction: column; gap: 18px; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; }
    .page-title { margin: 0; color: #1f2937; font-weight: 800; }
    .page-subtitle { margin: 4px 0 0; color: #6b7280; font-size: .9rem; }
    .header-actions { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }

    .breadcrumb-line { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; font-size: .85rem; }
    .crumb-link { color: #1d4ed8; font-weight: 700; cursor: pointer; }
    .crumb-sep { color: #9ca3af; }
    .crumb-current { color: #6b7280; }

    .summary-strip { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
    .summary-item { background: white; border: 1px solid #eef2f7; border-radius: 18px; padding: 16px; box-shadow: 0 4px 14px rgba(15,23,42,.04); }
    .summary-label { font-size: .78rem; color: #6b7280; font-weight: 700; margin-bottom: 6px; }
    .summary-value { font-size: 1rem; color: #1f2937; font-weight: 800; }

    .tabs-bar { display: flex; gap: 8px; flex-wrap: wrap; }
    .tab-btn { border: 1.5px solid #e5e7eb; background: white; color: #6b7280; padding: 10px 16px; border-radius: 14px; font-weight: 700; cursor: pointer; transition: .2s; }
    .tab-btn.active { background: linear-gradient(135deg, #1d4ed8, #2563eb); color: white; border-color: transparent; box-shadow: 0 4px 14px rgba(37,99,235,.22); }

    .form-card { background: white; border-radius: 24px; padding: 24px; border: 1px solid #eef2f7; box-shadow: 0 8px 22px rgba(15,23,42,.05); }
    .section-title { font-size: .95rem; font-weight: 800; color: #1d4ed8; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .contacts-header { margin-bottom: 14px; }

    .form-grid { display: grid; gap: 14px; }
    .cols-3 { grid-template-columns: repeat(3, 1fr); }
