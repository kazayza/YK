    protected override async Task OnParametersSetAsync()
    {
        if (!UserSession.IsLoggedIn){Navigation.NavigateTo("/login");return;}
        DetectMode();
        await LoadCustomerPermissionsAsync();
        if (permissions == null || !HasAccessToCurrentMode()){isLoading=false;return;}
        await LoadPageAsync();
    }

    private async Task RetryLoadPermissionsAsync()
    {
        if (isPermissionLoading) return;
        await LoadCustomerPermissionsAsync();
        if (permissions == null || !HasAccessToCurrentMode())
        {
            isLoading = false;
            return;
        }
        await LoadPageAsync();
    }

    private async Task LoadCustomerPermissionsAsync()
    {
        var userId = UserSession.UserID;
        var requestVersion = ++permissionLoadVersion;
        isPermissionLoading = true;
        permissionLoadFailed = false;
        permissionLoadDenied = false;
        permissions = null;
        try
        {
            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(userId);
            if (requestVersion != permissionLoadVersion || UserSession.UserID != userId) return;

            permissions = PermissionService.GetModule("SCR_CUSTOMERS");
        }
        catch (UnauthorizedAccessException)
        {
            if (requestVersion != permissionLoadVersion || UserSession.UserID != userId) return;

            permissionLoadDenied = true;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load customer form permissions.");
            if (requestVersion != permissionLoadVersion || UserSession.UserID != userId) return;

            permissionLoadFailed = true;
        }
        finally
        {
            if (requestVersion == permissionLoadVersion)
                isPermissionLoading = false;
        }
    }

    private void DetectMode(){var path=Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();if(path.StartsWith("customers/edit/"))currentMode="edit";else if(path.StartsWith("customers/view/"))currentMode="view";else currentMode="new";}
    private bool HasAccessToCurrentMode(){if(permissions==null)return false;if(isNewMode)return permissions.CanAdd;if(isEditMode)return permissions.CanEdit;return permissions.CanView;}
    private async Task LoadPageAsync()
    {
        isLoading=true;formMessage="";contactMessage="";customerGroupDefaultsMessage=string.Empty;previousCustomerGroupId=0;
        if (customerRecordContextId != CustomerId)
        {
            customerRecordLoadVersion++;
            customerRecordContextId = CustomerId;
            customerRecordLoaded = false;
            customerRecordLoadFailed = false;
            customerRecordLoadDenied = false;
            customerRecordNotFound = false;
            isCustomerRecordLoading = false;
        }
        if (contactsContextCustomerId != CustomerId)
        {
            contactsLoadVersion++;
            contactsContextCustomerId = CustomerId;
            contacts = new List<CustomerContactDto>();
            contactsLoaded = false;
            contactsLoadFailed = false;
            contactsLoadError = string.Empty;
            isContactsLoading = false;
        }
        try{
            await LoadLookupsAsync();
            if(isNewMode){model=new CustomerEditDto{Country="مصر",Rating=3,IsActive=true,CurrencyID=currencies?.FirstOrDefault()?.Id ?? 0};contacts=new List<CustomerContactDto>();contactsLoaded=true;contactsLoadFailed=false;contactsLoadError=string.Empty;}
            else
            {
                await LoadCustomerRecordAsync();
                if (customerRecordLoaded)
                {
                    await LoadContactsAsync();
                    await LoadAuditInfo();
                }
            }
        }catch(Exception ex){formMessage="خطأ أثناء تحميل البيانات: "+ex.Message;formSuccess=false;}
        finally{isLoading=false;}
    }

