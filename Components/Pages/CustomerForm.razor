@page "/customers/new"
@page "/customers/edit/{CustomerId:int}"
@page "/customers/view/{CustomerId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject CustomerService CustomerService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@PageTitleText - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول أولاً</h4></div>}
else if (permissions == null || !HasAccessToCurrentMode())
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4><button class="btn-luxury btn-ghost-luxury" @onclick='() => Navigation.NavigateTo("/customers")'>العودة للقائمة</button></div>}
else if (isLoading)
{<div class="loading-luxury" dir="rtl"><div class="loader-luxury"></div><p>جاري تحميل البيانات...</p></div>}
else
{
    <div class="luxury-edit-page" dir="rtl">

        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <button class="btn-luxury btn-ghost-dark" @onclick='() => Navigation.NavigateTo("/customers")'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>رجوع</button>
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text">
                        <h2 class="lh-title">@PageTitleText</h2>
                        <p class="lh-subtitle">@(string.IsNullOrWhiteSpace(model.CustomerCode)?"إدخال عميل جديد - سيولد الكود تلقائياً":$"كود: {model.CustomerCode} - {model.CustomerNameAr}")</p>
                    </div>
                </div>
                <div class="lh-actions">
                    @if (!isNewMode){<span class="status-badge-luxury @(model.IsActive?"active":"inactive")">@(model.IsActive?"نشط":"غير نشط")</span>}
                    <span class="lh-badge"><span class="lh-dot"></span>@(isNewMode?"جديد":isViewMode?"عرض":"تعديل")</span>
                    @if (isViewMode && permissions.CanEdit && CustomerId > 0){<button class="btn-luxury btn-primary-luxury" @onclick="GoToEditMode"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>تعديل</button>}
                    @if (!isViewMode){<button class="btn-luxury btn-primary-luxury" @onclick="SaveCustomer" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div><span>جاري...</span>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H6v8"/></svg><span>@(isNewMode?"حفظ العميل":"حفظ التعديلات")</span>}</button>}
                </div>
            </div>
        </div>

        <div class="stats-luxury">
            <div class="stat-luxury"><div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div class="st-info"><span class="st-value">@(string.IsNullOrWhiteSpace(model.CustomerCode)?"تلقائي":model.CustomerCode)</span><span class="st-label">كود العميل</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@model.CurrentBalance.ToString("#,##0.00")</span><span class="st-label">الرصيد الحالي</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div class="st-info"><span class="st-value">@GetLookupName(currencies, model.CurrencyID)</span><span class="st-label">العملة</span></div><div class="st-gold-line"></div></div>
            <div class="stat-luxury"><div class="st-icon green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg></div><div class="st-info"><span class="st-value">@GetLookupName(salesReps, model.SalesRepID)</span><span class="st-label">المندوب</span></div><div class="st-gold-line"></div></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(formMessage)){<div class="msg-luxury @(formSuccess?"msg-success":"msg-error")">@formMessage</div>}

        <div class="mudtabs-luxury">
            <div class="mudtabs-header">
                <button class="mudtab-btn @(activeTab=="basic"?"active":"")" @onclick='() => activeTab="basic"'><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>البيانات الأساسية</button>
                <button class="mudtab-btn @(activeTab=="contact"?"active":"")" @onclick='() => activeTab="contact"'><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/></svg></span>التواصل والموقع</button>
                <button class="mudtab-btn @(activeTab=="finance"?"active":"")" @onclick='() => activeTab="finance"'><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>المالية والمبيعات</button>
                <button class="mudtab-btn @(activeTab=="contacts"?"active":"")" @onclick='() => activeTab="contacts"'><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>جهات الاتصال <span class="mt-count">@contacts.Count</span></button>
                <button class="mudtab-btn @(activeTab=="notes"?"active":"")" @onclick='() => activeTab="notes"'><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></span>ملاحظات وسجل</button>
                <div class="mudtab-indicator" style="--tab:@GetTabIndex(activeTab);--total:5"></div>
            </div>

            <div class="mudtabs-body">
                @if (activeTab == "basic")
                {
                    <div class="tab-panel luxury-fade">
                        <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div><h3>البيانات الأساسية</h3><p>المعلومات الرئيسية للعميل</p></div></div>
                        <div class="form-grid cols-3">
                            <div class="form-field"><label class="field-label required">كود العميل</label><div class="field-input disabled"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><span>@(string.IsNullOrWhiteSpace(model.CustomerCode)?"سيولد تلقائياً":model.CustomerCode)</span></div><span class="field-hint">تلقائي عند الحفظ</span></div>
                            <div class="form-field"><label class="field-label required">اسم العميل (عربي)</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" class="field-input" @bind="model.CustomerNameAr" disabled="@isViewMode" placeholder="اسم العميل..." /></div></div>
                            <div class="form-field"><label class="field-label">اسم العميل (إنجليزي)</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" class="field-input" @bind="model.CustomerNameEn" dir="ltr" disabled="@isViewMode" placeholder="Customer name..." /></div></div>
                            <div class="form-field"><label class="field-label required">نوع العميل</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg><select class="field-select" @bind="model.CustomerType" disabled="@isViewMode"><option value="0">-- اختر --</option><option value="1">جملة</option><option value="2">نص جملة</option><option value="3">تجزئة</option><option value="4">أونلاين</option><option value="5">مؤسسي</option></select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                            <div class="form-field"><label class="field-label">مجموعة العميل</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg><select class="field-select" @bind="model.CustomerGroupID" disabled="@isViewMode"><option value="0">-- بدون --</option>@if(customerGroups!=null){@foreach(var item in customerGroups){<option value="@item.Id">@item.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                            <div class="form-field"><label class="field-label">التقييم</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><select class="field-select" @bind="model.Rating" disabled="@isViewMode"><option value="1">⭐ ضعيف</option><option value="2">⭐⭐ مقبول</option><option value="3">⭐⭐⭐ جيد</option><option value="4">⭐⭐⭐⭐ ممتاز</option><option value="5">⭐⭐⭐⭐⭐ مميز</option></select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                        </div>
                        <div class="form-grid cols-3">
                            <div class="form-field"><label class="field-label">الرقم الضريبي</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg><input type="text" class="field-input" @bind="model.TaxNumber" dir="ltr" disabled="@isViewMode" /></div></div>
                            <div class="form-field"><label class="field-label">السجل التجاري</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg><input type="text" class="field-input" @bind="model.CommercialRegister" dir="ltr" disabled="@isViewMode" /></div></div>
                            <div class="form-field"><label class="field-label">الحالة</label><div class="field-input disabled"><span>@(isNewMode?"سيصبح نشطًا بعد الحفظ":(model.IsActive?"نشط ✅":"غير نشط"))</span></div><span class="field-hint">التفعيل من قائمة العملاء</span></div>
                        </div>
                        <div class="preview-card-luxury"><h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>معاينة العميل</h4><div class="pc-body"><span class="code-luxury">@(model.CustomerCode ?? "CODE")</span><strong>@(string.IsNullOrWhiteSpace(model.CustomerNameAr)?"اسم العميل":model.CustomerNameAr)</strong><span class="type-badge-luxury type-cust-@model.CustomerType">@(model.CustomerType==0?"غير محدد":CustomerService.GetCustomerTypeName(model.CustomerType))</span><span class="rating-gold">@for(int i=1;i<=5;i++){<span class="@(i<=model.Rating?"filled":"empty")">★</span>}</span></div></div>
                    </div>
                }
                @if (activeTab == "contact")
                {
                    <div class="tab-panel luxury-fade">
                        <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72"/></svg></div><div><h3>بيانات التواصل والموقع</h3><p>طرق التواصل والعنوان الجغرافي</p></div></div>
                        <div class="form-grid cols-4">
                            <div class="form-field"><label class="field-label">هاتف 1</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2"/></svg><input type="text" class="field-input" @bind="model.Phone1" dir="ltr" disabled="@isViewMode" /></div></div>
                            <div class="form-field"><label class="field-label">هاتف 2</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2"/></svg><input type="text" class="field-input" @bind="model.Phone2" dir="ltr" disabled="@isViewMode" /></div></div>
                            <div class="form-field"><label class="field-label">موبايل</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/></svg><input type="text" class="field-input" @bind="model.Mobile" dir="ltr" disabled="@isViewMode" /></div></div>
                            <div class="form-field"><label class="field-label">فاكس</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/></svg><input type="text" class="field-input" @bind="model.Fax" dir="ltr" disabled="@isViewMode" /></div></div>
                            <div class="form-field"><label class="field-label">البريد الإلكتروني</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/></svg><input type="email" class="field-input" @bind="model.Email" dir="ltr" disabled="@isViewMode" /></div></div>
                            <div class="form-field"><label class="field-label">الموقع الإلكتروني</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/></svg><input type="text" class="field-input" @bind="model.Website" dir="ltr" disabled="@isViewMode" placeholder="https://..." /></div></div>
                            <div class="form-field"><label class="field-label">الدولة</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/></svg><input type="text" class="field-input" @bind="model.Country" disabled="@isViewMode" /></div></div>
                            <div class="form-field"><label class="field-label">المدينة</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><input type="text" class="field-input" @bind="model.City" disabled="@isViewMode" /></div></div>
                        </div>
                        <div class="form-grid cols-3">
                            <div class="form-field"><label class="field-label">المنطقة</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><input type="text" class="field-input" @bind="model.Region" disabled="@isViewMode" /></div></div>
                            <div class="form-field" style="grid-column:span 2"><label class="field-label">العنوان التفصيلي</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/></svg><input type="text" class="field-input" @bind="model.Address" disabled="@isViewMode" placeholder="العنوان التفصيلي..." /></div></div>
                        </div>
                        <div class="map-placeholder-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><span>قريباً: عرض موقع العميل على الخريطة وربط واتساب مباشر + اتجاهات GPS</span></div>
                    </div>
                }
                @if (activeTab == "finance")
                {
                    <div class="tab-panel luxury-fade">
                        <div class="tab-header"><div class="tab-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div><h3>البيانات المالية والمبيعات</h3><p>الائتمان والعملة والمندوب وقائمة الأسعار</p></div></div>
                        <div class="form-grid cols-4">
                            <div class="form-field"><label class="field-label">شروط الدفع</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><select class="field-select" @bind="model.PaymentTermID" disabled="@isViewMode"><option value="0">-- اختر --</option>@if(paymentTerms!=null){@foreach(var item in paymentTerms){<option value="@item.Id">@item.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                            <div class="form-field"><label class="field-label required">العملة</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><select class="field-select" @bind="model.CurrencyID" disabled="@isViewMode"><option value="0">-- اختر --</option>@if(currencies!=null){@foreach(var item in currencies){<option value="@item.Id">@item.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                            <div class="form-field"><label class="field-label">قائمة الأسعار</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/></svg><select class="field-select" @bind="model.PriceListID" disabled="@isViewMode"><option value="0">-- اختر --</option>@if(priceLists!=null){@foreach(var item in priceLists){<option value="@item.Id">@item.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                            <div class="form-field"><label class="field-label">مندوب المبيعات</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><select class="field-select" @bind="model.SalesRepID" disabled="@isViewMode"><option value="0">-- بدون --</option>@if(salesReps!=null){@foreach(var item in salesReps){<option value="@item.Id">@item.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                        </div>
                        <div class="form-grid cols-3">
                            <div class="form-field"><label class="field-label">حد الائتمان</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="model.CreditLimit" step="0.01" disabled="@isViewMode" /><span class="field-suffix">ج.م</span></div><span class="field-hint">الحد الأقصى للمديونية</span></div>
                            <div class="form-field"><label class="field-label">نسبة الخصم %</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="model.DiscountPercent" step="0.01" disabled="@isViewMode" /><span class="field-suffix">%</span></div></div>
                            <div class="form-field"><label class="field-label">الرصيد الافتتاحي</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="model.OpeningBalance" step="0.01" disabled="@(!isNewMode || isViewMode)" /><span class="field-suffix">ج.م</span></div><span class="field-hint">@(!isNewMode?"لا يمكن التعديل بعد الحفظ":"رصيد بداية التعامل")</span></div>
                            <div class="form-field"><label class="field-label">الرصيد الحالي</label><div class="field-input disabled"><span>@model.CurrentBalance.ToString("#,##0.00") ج.م</span></div><div class="credit-bar-luxury"><div class="credit-fill-luxury" style="width:@(GetCreditPercent())%"></div></div></div>
                            <div class="form-field"><label class="field-label">اسم البنك</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/></svg><input type="text" class="field-input" @bind="model.BankName" disabled="@isViewMode" /></div></div>
                            <div class="form-field"><label class="field-label">رقم الحساب البنكي</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg><input type="text" class="field-input" @bind="model.BankAccountNumber" dir="ltr" disabled="@isViewMode" /></div></div>
                        </div>
                    </div>
                }
                @if (activeTab == "contacts")
                {
                    <div class="tab-panel luxury-fade">
                        <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div><h3>جهات الاتصال</h3><p>@contacts.Count جهة - @contacts.Count(c=>c.IsPrimary) أساسي</p></div>@if(!isViewMode && model.CustomerID>0){<button class="btn-luxury btn-primary-luxury" @onclick="ShowAddContactDialog" style="margin-right:auto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة جهة اتصال</button>}</div>
                        @if (model.CustomerID<=0){<div class="notice-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>يجب حفظ العميل أولاً قبل إضافة جهات الاتصال</div>}
                        else if (isContactsLoading){<div class="loading-luxury small"><div class="loader-luxury"></div>جاري تحميل جهات الاتصال...</div>}
                        else if (!contacts.Any()){<div class="empty-luxury small"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><h4>لا توجد جهات اتصال مسجلة</h4></div>}
                        else{<div class="table-card-luxury"><div class="table-responsive"><table class="table-luxury"><thead><tr><th>الاسم</th><th>الوظيفة</th><th>الهاتف</th><th>الموبايل</th><th>البريد</th><th class="th-center">أساسي</th>@if(!isViewMode){<th class="th-actions">إجراءات</th>}</tr></thead><tbody>@foreach(var item in contacts){<tr><td class="td-name">@item.ContactName</td><td class="td-muted">@(item.JobTitle ?? "—")</td><td dir="ltr">@(item.Phone ?? "—")</td><td dir="ltr">@(item.Mobile ?? "—")</td><td dir="ltr">@(item.Email ?? "—")</td><td class="td-center">@if(item.IsPrimary){<span class="primary-badge-luxury">أساسي</span>}else{<span class="td-muted">—</span>}</td>@if(!isViewMode){<td class="td-actions"><div class="actions-wrap-luxury"><button class="act-btn edit" @onclick="() => ShowEditContactDialog(item)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button><button class="act-btn delete" @onclick="() => DeleteContact(item)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button></div></td>}</tr>}</tbody></table></div></div>}
                        @if (!string.IsNullOrWhiteSpace(contactMessage)){<div class="msg-luxury @(contactSuccess?"msg-success":"msg-error")">@contactMessage</div>}
                    </div>
                }
                @if (activeTab == "notes")
                {
                    <div class="tab-panel luxury-fade">
                        <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><div><h3>ملاحظات وسجل العميل</h3><p>ملاحظات عامة وسجل النشاط</p></div></div>
                        <div class="form-field"><label class="field-label">ملاحظات العميل</label><textarea class="field-textarea" rows="6" @bind="model.Notes" disabled="@isViewMode" placeholder="ملاحظات عامة عن العميل، تعليمات خاصة، شروط تعامل..."></textarea></div>
                        <div class="timeline-luxury">
                            <div class="tl-item"><div class="tl-dot gold"></div><div class="tl-content"><strong>تم إنشاء العميل</strong><span>@(model.CustomerID>0?"ID: "+model.CustomerID:"جديد - لم يحفظ بعد")</span></div></div>
                            @if (!string.IsNullOrEmpty(createdByName)){<div class="tl-item"><div class="tl-dot gold"></div><div class="tl-content"><strong>أنشئ بواسطة: @createdByName</strong><span>@createdDate</span></div></div>}
                            @if (!string.IsNullOrEmpty(modifiedByName)){<div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><strong>آخر تعديل: @modifiedByName</strong><span>@modifiedDate</span></div></div>}
                            <div class="tl-item"><div class="tl-dot" style="background:var(--gold)"></div><div class="tl-content"><strong>المستخدم الحالي: @UserSession.FullName</strong><span>يعمل الآن</span></div></div>
                            <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><strong>الرصيد الحالي: @model.CurrentBalance.ToString("#,##0.00")</strong><span>يتم تحديثه تلقائياً من الفواتير والمدفوعات</span></div></div>
                            <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><strong>جهات اتصال: @contacts.Count</strong><span>@contacts.Count(c=>c.IsPrimary) جهة أساسية</span></div></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @if (model.CustomerID > 0)
        {
            <div class="audit-bar-luxury">
                <div class="audit-item-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span>أنشئ بواسطة: <strong>@(string.IsNullOrEmpty(createdByName)?"غير محدد":createdByName)</strong></span><span class="audit-date">@createdDate</span></div>
                @if (!string.IsNullOrEmpty(modifiedByName)){<div class="audit-item-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 3v5h5"/></svg><span>آخر تعديل: <strong>@modifiedByName</strong></span><span class="audit-date">@modifiedDate</span></div>}
                <div class="audit-item-luxury gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg><span>المستخدم الحالي: <strong>@UserSession.FullName</strong></span></div>
            </div>
        }

        @if (!isViewMode)
        {
            <div class="actions-bar-luxury"><div class="actions-right-luxury"><button class="btn-luxury btn-primary-luxury" @onclick="SaveCustomer" disabled="@isSaving">@if(isSaving){<div class="btn-spinner"></div><span>جاري الحفظ...</span>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H6v8"/></svg><span>@(isNewMode?"حفظ العميل":"حفظ التعديلات")</span>}</button></div><button class="btn-luxury btn-ghost-luxury" @onclick='() => Navigation.NavigateTo("/customers")'>إلغاء</button></div>
        }
    </div>

    @if (showContactDialog)
    {
        <div class="modal-overlay-luxury" @onclick="CloseContactDialog"><div class="modal-card-luxury form-md" @onclick:stopPropagation="true"><div class="ml-gold-line"></div><div class="modal-header-luxury"><h3>@(contactModel.ContactID==0?"إضافة جهة اتصال":"تعديل جهة اتصال")</h3><button class="btn-close-x" @onclick="CloseContactDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div><div class="modal-body-luxury"><div class="form-grid cols-2"><div class="form-field"><label class="field-label required">الاسم</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><input type="text" class="field-input" @bind="contactModel.ContactName" /></div></div><div class="form-field"><label class="field-label">الوظيفة</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="7" width="20" height="14" rx="2"/></svg><input type="text" class="field-input" @bind="contactModel.JobTitle" /></div></div><div class="form-field"><label class="field-label">الهاتف</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2"/></svg><input type="text" class="field-input" @bind="contactModel.Phone" dir="ltr" /></div></div><div class="form-field"><label class="field-label">الموبايل</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/></svg><input type="text" class="field-input" @bind="contactModel.Mobile" dir="ltr" /></div></div><div class="form-field"><label class="field-label">البريد الإلكتروني</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/></svg><input type="email" class="field-input" @bind="contactModel.Email" dir="ltr" /></div></div><div class="form-field"><label class="field-label">جهة الاتصال الأساسية</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg><select class="field-select" @bind="contactModel.IsPrimary"><option value="false">لا</option><option value="true">نعم - أساسي</option></select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div></div><div class="form-field" style="margin-top:12px"><label class="field-label">ملاحظات</label><textarea class="field-textarea" rows="3" @bind="contactModel.Notes"></textarea></div>@if(!string.IsNullOrWhiteSpace(contactDialogMessage)){<div class="msg-luxury msg-error" style="margin-top:12px">@contactDialogMessage</div>}</div><div class="ml-footer"><button class="btn-luxury btn-primary-luxury" @onclick="SaveContact" disabled="@isContactSaving">@if(isContactSaving){<div class="btn-spinner"></div>}else{<span>حفظ</span>}</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseContactDialog" disabled="@isContactSaving">إلغاء</button></div></div></div>
    }

    @if (!string.IsNullOrEmpty(resultMessage)){<div class="toast-luxury"><div class="toast-card-luxury @(resultSuccess?"success":"error")"><span>@resultMessage</span><button @onclick='() => resultMessage=""'>✕</button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-edit-page{display:flex;flex-direction:column;gap:16px;max-width:1300px;margin:0 auto;font-family:'Tajawal',sans-serif}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:100px;height:100px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:40px;height:40px;border-radius:10px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}
.lh-title{font-size:1.1rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.74rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:10px;font-weight:700;font-size:.78rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-luxury:disabled{opacity:.6;cursor:not-allowed}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 2px 10px rgba(212,175,55,.25)}.btn-ghost-dark{background:rgba(255,255,255,.06);color:#cbd5e1;border:1px solid rgba(212,175,55,.12)}.btn-ghost-dark:hover{background:rgba(255,255,255,.1)}.btn-ghost-luxury{background:#fff;border:1px solid #e8e2d0;color:#475569}.btn-ghost-luxury:hover{background:#fcfaf6;border-color:var(--gold)}.btn-luxury svg{width:14px;height:14px}.btn-spinner{width:16px;height:16px;border:2px solid rgba(0,0,0,.1);border-top-color:var(--black2);border-radius:50%;animation:spin .6s linear infinite}.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.stats-luxury{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px}
.stat-luxury{position:relative;background:#fff;border:1px solid #e8e2d0;border-radius:16px;padding:14px;display:flex;align-items:center;gap:10px;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.03);transition:.2s}.stat-luxury:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06);border-color:rgba(212,175,55,.25)}
.st-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0}.st-icon.dark{background:linear-gradient(135deg,var(--black2),var(--black3));color:var(--gold);border:1px solid var(--border-gold)}.st-icon.gold{background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.15)}.st-icon.blue{background:#eff6ff;color:#2563eb;border:1px solid #dbeafe}.st-icon.green{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.st-icon svg{width:18px;height:18px}.st-info{display:flex;flex-direction:column}.st-value{font-size:1rem;font-weight:900;color:#0A0F1E;line-height:1}.st-label{font-size:.7rem;color:#8B95A5;font-weight:600;margin-top:3px}.st-gold-line{position:absolute;bottom:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:.2s}.stat-luxury:hover .st-gold-line{opacity:.8}
.status-badge-luxury{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.72rem;font-weight:800}.status-badge-luxury.active{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0}.status-badge-luxury.inactive{background:#fef2f2;color:#dc2626;border:1px solid #fecaca}
.msg-luxury{padding:10px 14px;border-radius:12px;font-size:.82rem;font-weight:600}.msg-success{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}.msg-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}
.mudtabs-luxury{background:#fff;border:1px solid #e8e2d0;border-radius:20px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.05);position:relative}.mudtabs-luxury::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.6;z-index:2}
.mudtabs-header{position:relative;display:flex;gap:0;background:linear-gradient(135deg,#fcfaf6 0%,#f8f6f0 100%);border-bottom:1px solid #e8e2d0;padding:0 8px;overflow-x:auto;scrollbar-width:none}.mudtabs-header::-webkit-scrollbar{display:none}
.mudtab-btn{position:relative;display:flex;align-items:center;gap:8px;padding:14px 18px;background:transparent;border:none;border-bottom:2px solid transparent;font-family:'Tajawal';font-size:.82rem;font-weight:700;color:#8B95A5;cursor:pointer;transition:all .25s;white-space:nowrap;flex-shrink:0}.mudtab-btn:hover{background:rgba(212,175,55,.04);color:#0A0F1E}.mudtab-btn.active{color:var(--gold-dark);background:rgba(212,175,55,.06);border-bottom-color:var(--gold)}
.mt-icon{width:20px;height:20px;display:flex;align-items:center;justify-content:center}.mt-icon svg{width:16px;height:16px}.mt-count{background:#f3f4f6;color:#6b7280;padding:2px 8px;border-radius:999px;font-size:.7rem;font-weight:700}
.mudtab-indicator{position:absolute;bottom:0;height:2px;background:var(--gold);transition:all .3s;width:calc(100% / var(--total));right:calc(var(--tab) * (100% / var(--total)));opacity:0}
.mudtabs-body{padding:22px;background:#fff;min-height:400px}
.tab-panel{display:flex;flex-direction:column;gap:18px}.tab-panel.luxury-fade{animation:fadeUp .4s both}@@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.tab-header{display:flex;align-items:center;gap:12px;padding-bottom:14px;border-bottom:1px solid #f1efe8}.tab-icon{width:40px;height:40px;border-radius:12px;background:#fcfaf6;border:1px solid #e8e2d0;display:flex;align-items:center;justify-content:center;color:#475569}.tab-icon.gold{background:rgba(212,175,55,.1);border-color:rgba(212,175,55,.15);color:var(--gold-dark)}.tab-icon svg{width:18px;height:18px}.tab-header h3{font-size:.95rem;font-weight:800;color:#0A0F1E;margin:0}.tab-header p{font-size:.72rem;color:#8B95A5;font-weight:600;margin:2px 0 0}
.form-grid{display:grid;gap:14px;margin-bottom:4px}.cols-2{grid-template-columns:repeat(2,1fr)} .cols-3{grid-template-columns:repeat(3,1fr)} .cols-4{grid-template-columns:repeat(4,1fr)}
.form-field{display:flex;flex-direction:column;gap:6px}.field-label{font-size:.78rem;font-weight:700;color:#374151}.field-label.required::after{content:' *';color:#ef4444}
.input-wrap{position:relative;display:flex;align-items:center}.input-wrap svg{position:absolute;right:10px;width:14px;height:14px;color:#9ca3af;pointer-events:none;z-index:1}
.field-input{width:100%;height:42px;padding:0 36px 0 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.86rem;background:#fff;font-family:'Tajawal';transition:all .2s;outline:none}.field-input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.08)}.field-input.disabled{background:#f9fafb;color:#9ca3af;border-style:dashed;display:flex;align-items:center;gap:8px;padding:0 12px}.field-input.disabled svg{position:static;width:14px;height:14px}
.select-wrap{position:relative;display:flex;align-items:center}.select-wrap svg:first-child{position:absolute;right:10px;width:14px;height:14px;color:#9ca3af;pointer-events:none;z-index:1}
