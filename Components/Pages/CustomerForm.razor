@code {
    [Parameter] public int CustomerId { get; set; }

    private ModulePermissionDto? permissions;

    private CustomerEditDto model = new();
    private List<CustomerContactDto> contacts = new();

    private List<LookupDto>? paymentTerms;
    private List<LookupDto>? currencies;
    private List<LookupDto>? customerGroups;
    private List<LookupDto>? priceLists;
    private List<LookupDto>? salesReps;

    private bool isLoading = true;
    private bool isSaving = false;
    private bool isContactsLoading = false;
    private string activeTab = "basic";

    private string currentMode = "new";
    private bool isNewMode => currentMode == "new";
    private bool isEditMode => currentMode == "edit";
    private bool isViewMode => currentMode == "view";

    private string PageTitleText =>
        isNewMode ? "إضافة عميل" :
        isEditMode ? "تعديل عميل" :
        "عرض عميل";

    private string formMessage = "";
    private bool formSuccess = true;

    private string resultMessage = "";
    private bool resultSuccess = true;

    private bool showContactDialog = false;
    private bool isContactSaving = false;
    private CustomerContactDto contactModel = new();
    private string contactDialogMessage = "";
    private string contactMessage = "";
    private bool contactSuccess = true;

    protected override async Task OnParametersSetAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        permissions = PermissionService.GetModule("SCR_CUSTOMERS");

        DetectMode();

        if (permissions == null || !HasAccessToCurrentMode())
        {
            isLoading = false;
            return;
        }

        await LoadPageAsync();
    }

    private void DetectMode()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).ToLowerInvariant();

        if (path.StartsWith("customers/edit/"))
            currentMode = "edit";
        else if (path.StartsWith("customers/view/"))
            currentMode = "view";
        else
            currentMode = "new";
    }

    private bool HasAccessToCurrentMode()
    {
        if (permissions == null)
            return false;

        if (isNewMode)
            return permissions.CanAdd;

        if (isEditMode)
            return permissions.CanEdit;

        return permissions.CanView;
    }

    private async Task LoadPageAsync()
    {
        isLoading = true;
        formMessage = "";
        contactMessage = "";

        try
        {
            await LoadLookupsAsync();

            if (isNewMode)
            {
                model = new CustomerEditDto
                {
                    Country = "مصر",
                    Rating = 3,
                    IsActive = true,
                    CurrencyID = currencies?.FirstOrDefault()?.Id ?? 0
                };

                contacts = new List<CustomerContactDto>();
            }
            else
            {
                var loaded = await CustomerService.GetCustomerByIdAsync(CustomerId);

                if (loaded == null)
                {
                    formMessage = "العميل غير موجود";
                    formSuccess = false;
                    model = new CustomerEditDto();
                }
                else
                {
                    model = loaded;
                    await LoadContactsAsync();
                }
            }
        }
        catch (Exception ex)
        {
            formMessage = "خطأ أثناء تحميل البيانات: " + ex.Message;
            formSuccess = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLookupsAsync()
    {
        paymentTerms = await LookupService.GetPaymentTermsAsync();
        currencies = await LookupService.GetCurrenciesAsync();
        customerGroups = await LookupService.GetCustomerGroupsAsync();
        priceLists = await LookupService.GetPriceListsAsync();
        salesReps = await LookupService.GetSalesRepsAsync();
    }

    private async Task LoadContactsAsync()
    {
        if (model.CustomerID <= 0)
        {
            contacts = new List<CustomerContactDto>();
            return;
        }

        isContactsLoading = true;

        try
        {
            contacts = await CustomerService.GetCustomerContactsAsync(model.CustomerID);
        }
        catch (Exception ex)
        {
            contactMessage = "خطأ أثناء تحميل جهات الاتصال: " + ex.Message;
            contactSuccess = false;
        }
        finally
        {
            isContactsLoading = false;
        }
    }

    private async Task SaveCustomer()
    {
        if (isViewMode)
            return;

        formMessage = "";

        if (string.IsNullOrWhiteSpace(model.CustomerNameAr))
        {
            formMessage = "يجب إدخال اسم العميل";
            formSuccess = false;
            activeTab = "basic";
            return;
        }

        if (model.CustomerType == 0)
        {
            formMessage = "يجب اختيار نوع العميل";
            formSuccess = false;
            activeTab = "basic";
            return;
        }

        if ((model.CurrencyID ?? 0) == 0)
        {
            formMessage = "يجب اختيار العملة";
            formSuccess = false;
            activeTab = "finance";
            return;
        }

        if (model.CreditLimit < 0)
        {
            formMessage = "حد الائتمان لا يمكن أن يكون سالباً";
            formSuccess = false;
            activeTab = "finance";
            return;
        }

        if (model.OpeningBalance < 0)
        {
            formMessage = "الرصيد الافتتاحي لا يمكن أن يكون سالباً";
            formSuccess = false;
            activeTab = "finance";
            return;
        }

        if (model.DiscountPercent < 0 || model.DiscountPercent > 100)
        {
            formMessage = "نسبة الخصم يجب أن تكون بين 0 و 100";
            formSuccess = false;
            activeTab = "finance";
            return;
        }

        if (model.Rating < 1 || model.Rating > 5)
        {
            formMessage = "التقييم يجب أن يكون بين 1 و 5";
            formSuccess = false;
            activeTab = "basic";
            return;
        }

        isSaving = true;

        try
        {
            if (isNewMode)
            {
                model.CustomerCode = await CustomerService.GenerateCustomerCodeAsync();
                var newId = await CustomerService.InsertCustomerAsync(model, UserSession.UserID);

                resultMessage = "تم إضافة العميل بنجاح ✅";
                resultSuccess = true;

                Navigation.NavigateTo($"/customers/edit/{newId}");
                return;
            }
            else
            {
                await CustomerService.UpdateCustomerAsync(model, UserSession.UserID);
                resultMessage = "تم حفظ التعديلات بنجاح ✅";
                resultSuccess = true;
                formMessage = "تم حفظ البيانات بنجاح";
                formSuccess = true;
            }
        }
        catch (Exception ex)
        {
            formMessage = "خطأ: " + ex.Message;
            formSuccess = false;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OnCustomerCodeChanged(ChangeEventArgs e)
    {
        model.CustomerCode = e.Value?.ToString();
    }

    private void GoToEditMode()
    {
        if (model.CustomerID > 0)
            Navigation.NavigateTo($"/customers/edit/{model.CustomerID}");
    }

    private string GetLookupName(List<LookupDto>? source, int? id)
    {
        if (source == null || (id ?? 0) == 0)
            return "—";

        return source.FirstOrDefault(x => x.Id == id)?.Name ?? "—";
    }

    private void ShowAddContactDialog()
    {
        contactModel = new CustomerContactDto
        {
            CustomerID = model.CustomerID,
            IsPrimary = !contacts.Any()
        };

        contactDialogMessage = "";
        showContactDialog = true;
    }

    private void ShowEditContactDialog(CustomerContactDto item)
    {
        contactModel = new CustomerContactDto
        {
            ContactID = item.ContactID,
            CustomerID = item.CustomerID,
            ContactName = item.ContactName,
            JobTitle = item.JobTitle,
            Phone = item.Phone,
            Mobile = item.Mobile,
            Email = item.Email,
            IsPrimary = item.IsPrimary,
            Notes = item.Notes,
            IsActive = item.IsActive
        };

        contactDialogMessage = "";
        showContactDialog = true;
    }

    private void CloseContactDialog()
    {
        showContactDialog = false;
        contactDialogMessage = "";
        contactModel = new CustomerContactDto();
    }

    private async Task SaveContact()
    {
        contactDialogMessage = "";

        if (model.CustomerID <= 0)
        {
            contactDialogMessage = "يجب حفظ العميل أولاً";
            return;
        }

        if (string.IsNullOrWhiteSpace(contactModel.ContactName))
        {
            contactDialogMessage = "اسم جهة الاتصال مطلوب";
            return;
        }

        isContactSaving = true;

        try
        {
            contactModel.CustomerID = model.CustomerID;

            await CustomerService.SaveCustomerContactAsync(contactModel, UserSession.UserID);

            contactMessage = contactModel.ContactID == 0
                ? "تمت إضافة جهة الاتصال بنجاح ✅"
                : "تم تعديل جهة الاتصال بنجاح ✅";

            contactSuccess = true;

            showContactDialog = false;
            contactModel = new CustomerContactDto();

            await LoadContactsAsync();
        }
        catch (Exception ex)
        {
            contactDialogMessage = "خطأ: " + ex.Message;
        }
        finally
        {
            isContactSaving = false;
        }
    }

    private async Task DeleteContact(CustomerContactDto item)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف جهة الاتصال: {item.ContactName} ؟");
        if (!confirmed)
            return;

        try
        {
            var result = await CustomerService.DeleteCustomerContactAsync(item.ContactID, UserSession.UserID);
            contactMessage = result.Message + (result.Success ? " ✅" : "");
            contactSuccess = result.Success;

            await LoadContactsAsync();
        }
        catch (Exception ex)
        {
            contactMessage = "خطأ: " + ex.Message;
            contactSuccess = false;
        }
    }
}