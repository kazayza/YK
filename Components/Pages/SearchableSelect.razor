@using YKCoatings.Services
@using YKCoatings.Helpers

<div class="ss-wrap @(IsLuxury ? "ss-luxury" : "")" @onclick:stopPropagation="true">
    <div class="ss-input-wrap @(isOpen ? "focused" : "") @(IsDisabled ? "disabled" : "")">
        @if (hasSelection)
        {
            <div class="ss-selected">
                <span class="ss-selected-text">@GetSelectedName()</span>
                @if (!IsDisabled)
                {
                    <button class="ss-clear" @onclick="ClearSelection" type="button" aria-label="مسح الاختيار"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 6-12 12M6 6l12 12"/></svg></button>
                }
            </div>
        }
        else
        {
            <input type="text" class="ss-input" placeholder="@Placeholder"
                   @bind="searchText" @bind:event="oninput"
                   @onfocus="Open" @onkeyup="OnKeyUp"
                   disabled="@IsDisabled" />
            <svg class="ss-search-icon" width="16" height="16" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
        }
    </div>

    @if (isOpen && filteredItems.Any())
    {
        <div class="ss-dropdown">
            @foreach (var item in filteredItems)
            {
                <div class="ss-option" @onclick="() => Select(item)">
                    <span class="ss-opt-name">@item.Name</span>
                    @if (!string.IsNullOrEmpty(item.Code))
                    {
                        <code class="ss-opt-code">@item.Code</code>
                    }
                </div>
            }
            @if (filteredItems.Count >= MaxResults)
            {
                <div class="ss-more">اكتب للمزيد من النتائج...</div>
            }
        </div>
    }
    else if (isOpen && !string.IsNullOrEmpty(searchText) && searchText.Length >= MinChars)
    {
        <div class="ss-dropdown">
            <div class="ss-empty">لا توجد نتائج مطابقة</div>
        </div>
    }
</div>

@if (isOpen)
{
    <div class="ss-overlay" @onclick="Close"></div>
}

<style>
.ss-wrap{ position: relative; width: 100%; }
.ss-input-wrap{
        display: flex;
        align-items: center;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        background: white;
        transition: .2s;
        position: relative;
        min-height: 42px;
    }
.ss-input-wrap.focused{
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.1);
    }
.ss-input-wrap.disabled{
        background: #f8fafc;
        opacity: .7;
        pointer-events: none;
    }
.ss-input{
        flex: 1;
        border: none;
        outline: none;
        padding: 10px 36px 10px 12px;
        font-size: .88rem;
        background: transparent;
        width: 100%;
    }
.ss-search-icon{
        position: absolute;
        right: 12px;
        color: #94a3b8;
        pointer-events: none;
    }
.ss-selected{
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        margin: 4px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        flex: 1;
    }
.ss-selected-text{
        flex: 1;
        font-size: .86rem;
        font-weight: 600;
        color: #1e40af;
    }
.ss-clear{
        width: 22px;
        height: 22px;
        border-radius: 6px;
        border: none;
        background: #dbeafe;
        color: #2563eb;
        font-size: .7rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .2s;
    }
.ss-clear:hover{ background: #bfdbfe; }
.ss-clear svg{ width: 12px; height: 12px; }
.ss-dropdown{
        position: absolute;
        top: calc(100% + 4px);
        right: 0;
        left: 0;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        box-shadow: 0 12px 32px rgba(0,0,0,.12);
        z-index: 500;
        max-height: 280px;
        overflow-y: auto;
        animation: ssIn .15s ease;
    }
.ss-option{
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 14px;
        cursor: pointer;
        transition: .15s;
        border-bottom: 1px solid #f8fafc;
    }
.ss-option:last-child{ border-bottom: none; }
.ss-option:hover{ background: #eff6ff; }
.ss-opt-name{
        font-size: .86rem;
        font-weight: 600;
        color: #0f172a;
    }
.ss-opt-code{
        background: #f1f5f9;
        padding: 2px 8px;
        border-radius: 6px;
        font-size: .75rem;
        color: #2563eb;
        font-weight: 600;
        direction: ltr;
    }
.ss-empty, .ss-more{
        padding: 14px;
        text-align: center;
        color: #94a3b8;
        font-size: .84rem;
    }
.ss-overlay{
        position: fixed;
        inset: 0;
        z-index: 400;
    }
.ss-wrap.ss-luxury .ss-input-wrap{
        border-color: rgba(212,175,55,.32);
        background: #171819;
        color: #f5f1e8;
    }
.ss-wrap.ss-luxury .ss-input-wrap.focused{
        border-color: #d4af37;
        box-shadow: 0 0 0 3px rgba(212,175,55,.13);
    }
.ss-wrap.ss-luxury .ss-input{ color: #f5f1e8; }
.ss-wrap.ss-luxury .ss-input::placeholder{ color: #9b9689; }
.ss-wrap.ss-luxury .ss-search-icon{ color: #d4af37; }
.ss-wrap.ss-luxury .ss-selected{
        background: rgba(212,175,55,.1);
        border-color: rgba(212,175,55,.28);
    }
.ss-wrap.ss-luxury .ss-selected-text{ color: #e5cf8a; }
.ss-wrap.ss-luxury .ss-clear{
        background: rgba(212,175,55,.15);
        color: #e5cf8a;
    }
.ss-wrap.ss-luxury .ss-clear:hover{ background: rgba(212,175,55,.25); }
.ss-wrap.ss-luxury .ss-dropdown{
        background: #171819;
        border-color: rgba(212,175,55,.3);
        box-shadow: 0 14px 36px rgba(0,0,0,.38);
    }
.ss-wrap.ss-luxury .ss-option{ border-bottom-color: rgba(255,255,255,.06); }
.ss-wrap.ss-luxury .ss-option:hover{ background: rgba(212,175,55,.1); }
.ss-wrap.ss-luxury .ss-opt-name{ color: #f4f0e6; }
.ss-wrap.ss-luxury .ss-opt-code{
        background: rgba(212,175,55,.12);
        color: #e5cf8a;
    }
.ss-wrap.ss-luxury .ss-empty,
    .ss-wrap.ss-luxury .ss-more{ color: #aaa391; }
</style>

@code {
    [Parameter] public List<SearchableItem>? Items { get; set; }
    [Parameter] public int SelectedId { get; set; }
    [Parameter] public EventCallback<int> SelectedIdChanged { get; set; }
    [Parameter] public EventCallback<SearchableItem?> OnSelected { get; set; }
    [Parameter] public string Placeholder { get; set; } = "ابحث واختر...";
    [Parameter] public bool IsDisabled { get; set; } = false;
    [Parameter] public bool IsLuxury { get; set; } = false;
    [Parameter] public int MaxResults { get; set; } = 15;
    [Parameter] public int MinChars { get; set; } = 1;

    private string searchText = "";
    private bool isOpen = false;
    private SearchableItem? selectedItem;
    private List<SearchableItem> filteredItems = new();
    private List<SearchableItem>? previousItems;

    private bool hasSelection => selectedItem is not null && selectedItem.Id > 0;

    private string GetSelectedName()
    {
        if (selectedItem is not null)
            return selectedItem.Name;
        return "";
    }

    protected override void OnParametersSet()
    {
        var itemsChanged = !ReferenceEquals(previousItems, Items);
        previousItems = Items;

        if (SelectedId > 0 && Items is not null)
        {
            var found = Items.FirstOrDefault(i => i.Id == SelectedId);
            if (found is not null)
                selectedItem = found;
        }
        else if (SelectedId == 0)
        {
            selectedItem = null;
        }

        if (itemsChanged)
            DoSearch();
    }

    private void Open()
    {
        if (IsDisabled) return;
        isOpen = true;
        DoSearch();
    }

    private void Close()
    {
        isOpen = false;
        searchText = "";
    }

    private void OnKeyUp()
    {
        if (!isOpen) isOpen = true;
        DoSearch();
    }

    private void DoSearch()
    {
        if (Items is null)
        {
            filteredItems = new();
            return;
        }

        if (string.IsNullOrEmpty(searchText) || searchText.Length < MinChars)
        {
            filteredItems = Items.Take(MaxResults).ToList();
            return;
        }

        filteredItems = Items
            .Where(i =>
                ArabicSearchHelper.Contains(i.Name, searchText) ||
                ArabicSearchHelper.Contains(i.Code, searchText))
            .Take(MaxResults)
            .ToList();
    }

    private async Task Select(SearchableItem item)
    {
        selectedItem = item;
        searchText = "";
        isOpen = false;
        await SelectedIdChanged.InvokeAsync(item.Id);
        await OnSelected.InvokeAsync(item);
    }

    private async Task ClearSelection()
    {
        selectedItem = null;
        searchText = "";
        await SelectedIdChanged.InvokeAsync(0);
        await OnSelected.InvokeAsync(null);
    }
}