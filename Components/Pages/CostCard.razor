@code {
    private ModulePermissionDto? permissions;
    private bool permissionChecked;
    private bool showHelp;
    private bool focusHelpDialogAfterRender;
    private bool restoreHelpTriggerAfterRender;
    private ElementReference helpTriggerRef;
    private ElementReference helpDialogRef;
    private bool isLoading;
    private bool isBusy;
    private bool isPreviewing;
    private bool isSaving;
    private bool acknowledgeWarnings;
    private int costType = 1;
    private int selectedItemId;
    private int selectedSourceId;
    private int? selectedPeriodId;
    private decimal targetProfitPercent;
    private string pageError = "";
    private string pageMessage = "";

    private List<CostCardProductOptionDto> products = new();
    private List<SearchableItem> searchableProducts = new();
    private List<CostCardPeriodOptionDto> periods = new();
    private List<CostCardSourceOptionDto> sourceOptions = new();
    private List<CostCardHistoryDto> history = new();
    private CostCardPreviewDto? preview;

    private Task OpenHelpAsync()
    {
        showHelp = true;
        focusHelpDialogAfterRender = true;
        return Task.CompletedTask;
    }

    private Task CloseHelpAsync()
    {
        showHelp = false;
        restoreHelpTriggerAfterRender = true;
        return Task.CompletedTask;
    }

    private Task HandleHelpDialogKeyDown(KeyboardEventArgs args) =>
        args.Key == "Escape" ? CloseHelpAsync() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusHelpDialogAfterRender)
        {
            focusHelpDialogAfterRender = false;
            await helpDialogRef.FocusAsync();
        }

        if (restoreHelpTriggerAfterRender)
        {
            restoreHelpTriggerAfterRender = false;
            await helpTriggerRef.FocusAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        try
        {
            if (!PermissionService.IsLoaded)
                await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_COSTCARD");
            permissionChecked = true;
            if (permissions?.CanView != true) return;

            isLoading = true;
            products = await CostCards.GetProductsAsync();
            searchableProducts = products.Select(item => new SearchableItem
            {
                Id = item.ItemID,
                Name = item.ItemNameAr,
                Code = item.ItemCode,
                Extra = item.UnitName
            }).ToList();
            periods = await CostCards.GetOpenPeriodsAsync();
            var today = DateTime.Today;
            var currentPeriod = periods.FirstOrDefault(p => p.StartDate.Date <= today && p.EndDate.Date >= today)
                                ?? periods.FirstOrDefault();
            selectedPeriodId = currentPeriod?.PeriodID;
            history = await CostCards.GetHistoryAsync();
            isLoading = false;
        }
        catch (Exception ex)
        {
            pageError = ex.Message;
            isLoading = false;
            permissionChecked = true;
        }
    }

    private async Task ChangeCostTypeAsync(int value)
    {
        if (value is not (1 or 2) || isBusy) return;
        if (costType == value) return;
        costType = value;
        preview = null;
        acknowledgeWarnings = false;
        await LoadSourcesAsync();
    }

    private async Task OnProductSearchSelectionChanged(SearchableItem? item)
    {
        selectedItemId = item?.Id ?? 0;
        await OnProductChanged();
    }

    private async Task OnProductChanged()
    {
        preview = null;
        acknowledgeWarnings = false;
        await LoadSourcesAsync();
        await LoadHistoryAsync();
    }

    private async Task LoadSourcesAsync()
    {
        pageError = "";
        selectedSourceId = 0;
        sourceOptions.Clear();
        if (selectedItemId <= 0) return;

        try
        {
            isBusy = true;
            sourceOptions = costType == 1
                ? await CostCards.GetEstimatedSourcesAsync(selectedItemId)
                : await CostCards.GetActualSourcesAsync(selectedItemId);
            // Require an explicit source choice; never calculate against the first row silently.
            selectedSourceId = 0;
        }
        catch (Exception ex)
        {
            pageError = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task BuildPreviewAsync()
    {
        pageError = "";
        pageMessage = "";
        preview = null;
        acknowledgeWarnings = false;
        if (selectedItemId <= 0 || selectedSourceId <= 0)
        {
            pageError = "اختر الصنف ومصدر التكلفة أولًا.";
            return;
        }

        try
        {
            isPreviewing = true;
            isBusy = true;
            preview = costType == 1
                ? await CostCards.PreviewEstimatedAsync(selectedItemId, selectedSourceId, selectedPeriodId, targetProfitPercent)
                : await CostCards.PreviewActualAsync(selectedItemId, selectedSourceId, selectedPeriodId, targetProfitPercent);
        }
        catch (Exception ex)
        {
            pageError = ex.Message;
        }
        finally
        {
            isPreviewing = false;
            isBusy = false;
        }
    }

    private async Task SaveSnapshotAsync()
    {
        if (!CostCards.SnapshotPersistenceEnabled)
        {
            pageError = "حفظ لقطات بطاقة التكلفة متوقف مؤقتًا؛ هذه الشاشة للمعاينة فقط.";
            return;
        }
        if (preview is null || permissions?.CanAdd != true || isBusy) return;
        pageError = "";
        pageMessage = "";
        try
        {
            isSaving = true;
            isBusy = true;
            var cardId = await CostCards.SaveSnapshotAsync(new CostCardSaveRequest
            {
                ItemID = selectedItemId,
                PeriodID = selectedPeriodId,
                CostType = costType,
                BOMID = costType == 1 ? selectedSourceId : null,
                ProductionOrderID = costType == 2 ? selectedSourceId : null,
                TargetProfitPercent = targetProfitPercent,
                PreviewFingerprint = preview.PreviewFingerprint,
                AcknowledgeWarnings = acknowledgeWarnings
            }, UserSession.UserID);

            pageMessage = $"تم حفظ لقطة بطاقة التكلفة رقم {cardId}. لم يحدث ترحيل محاسبي أو تغيير في المخزون.";
            preview = null;
            acknowledgeWarnings = false;
            await LoadHistoryAsync();
        }
        catch (Exception ex)
        {
            pageError = ex.Message;
        }
        finally
        {
            isSaving = false;
            isBusy = false;
        }
    }

    private void InvalidatePreview()
    {
        preview = null;
        acknowledgeWarnings = false;
    }

    private static bool HasSavedWarnings(CostCardHistoryDto card) =>
        card.Notes?.Contains("تحذيرات تمت مراجعتها", StringComparison.Ordinal) == true;

    private async Task LoadHistoryAsync()
    {
        if (permissions?.CanView != true) return;
        try
        {
            history = await CostCards.GetHistoryAsync(selectedItemId > 0 ? selectedItemId : null);
        }
        catch (Exception ex)
        {
            pageError = ex.Message;
        }
    }

    private static string Money(decimal amount) => amount.ToString("N2");
}
