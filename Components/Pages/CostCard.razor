@page "/cost-card"

@using YKCoatings.Models
@using YKCoatings.Services
@inject CostCardService CostCards
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation

<PageTitle>بطاقة التكلفة — واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="cc-access" dir="rtl"><span class="cc-access-icon">🔒</span><h3>يجب تسجيل الدخول أولًا</h3></div>
}
else if (!permissionChecked)
{
    <div class="cc-loading" dir="rtl"><span class="cc-spinner"></span><span>جاري التحقق من الصلاحية...</span></div>
}
else if (permissions is null || !permissions.CanView)
{
    <div class="cc-access" dir="rtl"><span class="cc-access-icon">⛔</span><h3>ليس لديك صلاحية عرض بطاقة التكلفة</h3><button class="cc-btn cc-btn-light" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة للرئيسية</button></div>
}
else
{
    <main class="cost-card-page" dir="rtl">
        <header class="cc-header">
            <div class="cc-header-mark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2Z"/><path d="M8 7h8M8 11h8M8 15h5"/></svg></div>
            <div class="cc-header-text"><span class="cc-eyebrow">التكاليف الصناعية</span><h1>بطاقة التكلفة</h1><p>@(CostCards.SnapshotPersistenceEnabled ? "معاينة وحفظ لقطة تكلفة تقديرية أو فعلية للصنف" : "معاينة تكلفة تقديرية أو فعلية — دون حفظ لقطات حاليًا")</p></div>
            <div class="cc-header-actions">
                <button class="cc-help-trigger" type="button" @ref="helpTriggerRef" @onclick="OpenHelpAsync" aria-haspopup="dialog" aria-controls="cc-help-dialog" aria-label="فتح شرح بطاقة التكلفة">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.6 9a2.5 2.5 0 1 1 4.3 1.8c-1.1 1.1-1.9 1.4-1.9 3M12 17h.01"/></svg>
                    <span>شرح طريقة الاستخدام</span>
                </button>
                <div class="cc-header-side"><span class="cc-status-dot"></span> لا يوجد ترحيل محاسبي أو حركة مخزون</div>
            </div>
        </header>

        @if (isLoading)
        {
            <div class="cc-loading"><span class="cc-spinner"></span><span>جاري تحميل بيانات بطاقة التكلفة...</span></div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(pageError))
            {
                <div class="cc-alert cc-alert-error"><b>تعذر إكمال العملية</b><span>@pageError</span><button aria-label="إغلاق" @onclick='() => pageError = ""'>×</button></div>
            }
            @if (!string.IsNullOrWhiteSpace(pageMessage))
            {
                <div class="cc-alert cc-alert-ok"><b>تم</b><span>@pageMessage</span><button aria-label="إغلاق" @onclick='() => pageMessage = ""'>×</button></div>
            }

            <section class="cc-panel cc-builder">
                <div class="cc-panel-heading">
                    <div><span class="cc-step">01</span><div><h2>إعداد البطاقة</h2><p>اختر المنتج ومصدر التكلفة ثم اعرض المعاينة</p></div></div>
                    <span class="cc-assumption">1 تقديري من BOM · 2 فعلي من أمر</span>
                </div>

                <div class="cc-type-switch" role="tablist" aria-label="نوع بطاقة التكلفة">
                    <button class="@(costType == 1 ? "active" : "")" @onclick="() => ChangeCostTypeAsync(1)" disabled="@isBusy">
                        <span class="cc-type-icon"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg></span>
                        <span><b>تقديري من الوصفة</b><small>تقدير قبل/أثناء التخطيط من BOM سارية</small></span>
                        <span class="cc-type-value">CostType 1</span>
                    </button>
                    <button class="@(costType == 2 ? "active" : "")" @onclick="() => ChangeCostTypeAsync(2)" disabled="@isBusy">
                        <span class="cc-type-icon"><svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-5 5"/><path d="M15 9h4v4"/></svg></span>
                        <span><b>فعلي</b><small>من صرف أمر تصنيع مكتمل</small></span>
                        <span class="cc-type-value">CostType 2</span>
                    </button>
                </div>

                <div class="cc-form-grid">
                    <div class="cc-field cc-field-wide">
                        <label class="cc-field-label"><span>الصنف المنتج <i>*</i></span></label>
                        <SearchableSelect Items="@searchableProducts"
                                          @bind-SelectedId="selectedItemId"
                                          OnSelected="OnProductSearchSelectionChanged"
                                          Placeholder="اكتب اسم المنتج أو كوده للبحث والاختيار..."
                                          MaxResults="20"
                                          MinChars="1"
                                          IsDisabled="@isBusy" />
                        <small class="cc-help">اكتب جزءًا من كود الصنف أو اسمه؛ ستُفلتر النتائج فورًا. اختر منتجًا من القائمة للمتابعة.</small>
                    </div>

                    <label class="cc-field cc-field-wide"><span>@(costType == 1 ? "الوصفة المعتمدة السارية" : "أمر التصنيع المكتمل") <i>*</i></span>
                        <select @bind="selectedSourceId" @bind:after="InvalidatePreview" disabled="@(isBusy || selectedItemId <= 0 || sourceOptions.Count == 0)">
                            <option value="0">@(sourceOptions.Count == 0 ? "لا يوجد مصدر متاح لهذا الصنف" : "اختر مصدر الحساب...")</option>
                            @foreach (var source in sourceOptions)
                            {
                                <option value="@source.SourceID">@source.DisplayName</option>
                            }
                        </select>
                        @if (costType == 2)
                        {
                            <small class="cc-help">يعرض الأوامر المكتملة ذات الناتج المقبول وإذن صرف معتمد فقط؛ الحساب على مستوى الأمر لا الباتش.</small>
                        }
                        else
                        {
                            <small class="cc-help">تُستخدم تكاليف مكونات الوصفة المحفوظة، ولا يُعاد تسعير BOM من متوسط المخزون.</small>
                        }
                    </label>

                    <label class="cc-field"><span>الفترة المحاسبية</span>
                        <select @bind="selectedPeriodId" @bind:after="InvalidatePreview" disabled="@isBusy">
                            <option value="">بدون فترة</option>
                            @foreach (var period in periods)
                            {
                                <option value="@period.PeriodID">@period.DisplayName</option>
                            }
                        </select>
                        <small class="cc-help">@(CostCards.SnapshotPersistenceEnabled ? "تظهر الفترات المفتوحة فقط. الحفظ ينشئ لقطة تكلفة، ولا يقفل الفترة." : "تظهر الفترات المفتوحة للمعلومة فقط؛ حفظ لقطات التكلفة غير مفعل حاليًا.")</small>
                    </label>

                    <label class="cc-field"><span>الزيادة المستهدفة على التكلفة %</span>
                        <input type="number" min="0" max="999.99" step="0.01" @bind="targetProfitPercent" @bind:after="InvalidatePreview" disabled="@isBusy" />
                        <small class="cc-help">السعر المقترح = تكلفة الوحدة × (1 + النسبة ÷ 100)، أي زيادة على التكلفة وليست هامشًا من سعر البيع.</small>
                    </label>
                </div>

                <div class="cc-builder-footer">
                    <div class="cc-source-note"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg><span>الخانات التي لا يوفر مصدر الحساب بياناتها تبقى صفرًا وتظهر في التنبيهات.</span></div>
                    <button class="cc-btn cc-btn-primary" @onclick="BuildPreviewAsync" disabled="@(isBusy || selectedItemId <= 0 || selectedSourceId <= 0)">
                        @if (isPreviewing) { <span class="cc-mini-spinner"></span><span>جاري الحساب...</span> }
                        else { <svg viewBox="0 0 24 24"><path d="M3 3v18h18"/><path d="M7 14h3l2-5 3 8 2-4h2"/></svg><span>احسب المعاينة</span> }
                    </button>
                </div>
            </section>

            @if (preview is not null)
            {
                <section class="cc-panel cc-preview">
                    <div class="cc-panel-heading">
                        <div><span class="cc-step">02</span><div><h2>معاينة بطاقة التكلفة</h2><p>@preview.ItemCode — @preview.ItemNameAr</p></div></div>
                        <div class="cc-preview-badges"><span class="cc-pill @(preview.CostType == 1 ? "pill-blue" : "pill-purple")">@preview.CostTypeName</span><span class="cc-pill pill-muted">المصدر: @preview.SourceReference</span></div>
                    </div>

                    <div class="cc-scope-note @(preview.CostType == 1 ? "estimate" : "actual")">
                        <span class="cc-scope-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg></span>
                        <div>
                            @if (preview.CostType == 1)
                            {
                                <b>نطاق التقدير:</b><span> يُحسب من كل بنود الوصفة المختارة، بما فيها البنود الاختيارية. لذلك قد يختلف عن أمر تصنيع لم يختر كل البنود أو استخدم بديلًا.</span>
                            }
                            else
                            {
                                <b>نطاق الفعلي:</b><span> يُحسب من أسطر الصرف المعتمدة للأمر، وليس من تكلفة الوحدة التقديرية المحفوظة على مواد الأمر.</span>
                                @if (preview.HasApprovedIssueLines && preview.DirectLaborCost == 0 && preview.TotalIndirectCost == 0)
                                {
                                    <strong> لا توجد عمالة أو أعباء مسجلة هنا؛ الإجمالي المعروض هو تكلفة المواد المصروفة فقط.</strong>
                                }
                            }
                        </div>
                    </div>

                    @if (preview.HasWarnings)
                    {
                        <div class="cc-warning-box">
                            <div class="cc-warning-title"><svg viewBox="0 0 24 24"><path d="M10.3 3.9 1.8 18.2A2 2 0 0 0 3.5 21h17a2 2 0 0 0 1.7-2.8L13.7 3.9a2 2 0 0 0-3.4 0Z"/><path d="M12 9v4M12 17h.01"/></svg><b>@(CostCards.SnapshotPersistenceEnabled ? "تنبيهات يجب مراجعتها قبل الحفظ" : "تنبيهات المعاينة")</b></div>
                            <ul>@foreach (var warning in preview.Warnings) { <li>@warning</li> }</ul>
                            @if (preview.CanPersist && CostCards.SnapshotPersistenceEnabled)
                            {
                                <label class="cc-ack"><input type="checkbox" @bind="acknowledgeWarnings" /> راجعت التنبيهات وأوافق على حفظ هذه اللقطة بالقيم المعروضة</label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="cc-success-note"><span>✓</span> لا توجد موانع في المصدر المحدد.</div>
                    }

                    @if (!preview.CanPersist)
                    {
                        <div class="cc-block-note">الحفظ متوقف حتى معالجة موانع المصدر أعلاه. لن نُسجل تكلفة ناقصة أو غير قابلة للتسوية على أنها بطاقة سليمة.</div>
                    }

                    <div class="cc-preview-meta">
                        <div><small>كمية الناتج المعتمدة للحساب</small><b>@preview.OutputQty.ToString("N4") @preview.UnitName</b></div>
                        <div><small>الفترة</small><b>@(periods.FirstOrDefault(x => x.PeriodID == preview.PeriodID)?.PeriodName ?? "بدون فترة")</b></div>
                        <div><small>الفاقد (للمعلومية)</small><b>@preview.WastePercent.ToString("N2")%</b></div>
                    </div>

                    <div class="cc-result-hero">
                        <div class="cc-result-main">
                            <small>تكلفة الوحدة</small>
                            <strong>@Money(preview.CostPerUnit) <em>/ @preview.UnitName</em></strong>
                            <span>@(preview.CostType == 1 ? "تقدير محسوب من الوصفة المختارة" : "تكلفة فعلية للأمر ÷ الناتج المقبول")</span>
                        </div>
                        <div class="cc-result-stat"><small>إجمالي تكلفة المصدر</small><b>@Money(preview.TotalCost)</b><span>للكمية المحددة أعلاه</span></div>
                        <div class="cc-result-stat"><small>السعر المقترح</small><b>@Money(preview.SuggestedPrice)</b><span>زيادة @preview.TargetProfitPercent.ToString("N2")% على التكلفة</span></div>
                    </div>

                    <div class="cc-breakdown-grid">
                        <section class="cc-breakdown-card">
                            <header><div><span class="cc-breakdown-icon material"><svg viewBox="0 0 24 24"><path d="M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z"/></svg></span><div><h3>المواد المباشرة</h3><small>المواد التي تدخل في المنتج</small></div></div><span class="cc-breakdown-total-chip">@Money(preview.RawMaterialCost + preview.FinishedComponentCost + preview.PackagingCost)</span></header>
                            <div class="cc-breakdown-row"><span>مواد خام</span><b>@Money(preview.RawMaterialCost)</b></div>
                            <div class="cc-breakdown-row"><span>مكوّنات منتج نهائي <small>تُجمع مع المواد المباشرة عند الحفظ</small></span><b>@Money(preview.FinishedComponentCost)</b></div>
                            <div class="cc-breakdown-row"><span>تعبئة وتغليف</span><b>@Money(preview.PackagingCost)</b></div>
                            @if (preview.UnclassifiedMaterialCost > 0)
                            {
                                <div class="cc-breakdown-row cc-row-warning"><span>مواد غير مصنفة <small>مستبعدة من الإجمالي وتمنع الحفظ</small></span><b>@Money(preview.UnclassifiedMaterialCost)</b></div>
                            }
                            <div class="cc-breakdown-total-row"><span>إجمالي المواد المباشرة</span><b>@Money(preview.RawMaterialCost + preview.FinishedComponentCost + preview.PackagingCost)</b></div>
                        </section>

                        <section class="cc-breakdown-card">
                            <header><div><span class="cc-breakdown-icon conversion"><svg viewBox="0 0 24 24"><path d="M3 21h18M5 21V10l6 3V9l6 4V7h2v14M9 17h1m4 0h1"/></svg></span><div><h3>العمالة والأعباء الصناعية</h3><small>القيم المتاحة من BOM أو أمر التصنيع</small></div></div><span class="cc-breakdown-total-chip">@Money(preview.DirectLaborCost + preview.TotalIndirectCost)</span></header>
                            <div class="cc-breakdown-row"><span>عمالة مباشرة</span><b>@Money(preview.DirectLaborCost)</b></div>
                            <div class="cc-breakdown-row"><span>مصاريف صناعية أخرى</span><b>@Money(preview.OtherOverheadCost)</b></div>
                            <div class="cc-breakdown-row"><span>مواد غير مباشرة</span><b>@Money(preview.IndirectMaterialCost)</b></div>
                            <div class="cc-breakdown-row"><span>عمالة غير مباشرة</span><b>@Money(preview.IndirectLaborCost)</b></div>
                            <div class="cc-breakdown-row"><span>طاقة ومرافق</span><b>@Money(preview.UtilityCost)</b></div>
                            <div class="cc-breakdown-row"><span>إهلاك</span><b>@Money(preview.DepreciationCost)</b></div>
                            <div class="cc-breakdown-row"><span>صيانة</span><b>@Money(preview.MaintenanceCost)</b></div>
                            <div class="cc-breakdown-total-row"><span>إجمالي العمالة والأعباء</span><b>@Money(preview.DirectLaborCost + preview.TotalIndirectCost)</b></div>
                            <div class="cc-breakdown-total-row muted"><span>منها: الأعباء غير المباشرة</span><b>@Money(preview.TotalIndirectCost)</b></div>
                        </section>
                    </div>

                    <div class="cc-preview-footer">
                        @if (CostCards.SnapshotPersistenceEnabled)
                        {
                            <p>الحفظ ينشئ سجلًا جديدًا في <code>ProductCostCards</code> فقط؛ لا يرحّل قيدًا ولا يغيّر رصيد المخزون.</p>
                            @if (permissions.CanAdd)
                            {
                                <button class="cc-btn cc-btn-save" @onclick="SaveSnapshotAsync" disabled="@(isBusy || !preview.CanPersist || (preview.HasWarnings && !acknowledgeWarnings))">
                                    @if (isSaving) { <span class="cc-mini-spinner"></span><span>جاري الحفظ...</span> }
                                    else { <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg><span>حفظ لقطة التكلفة</span> }
                                </button>
                            }
                        }
                        else
                        {
                            <p class="cc-block-note">هذه النسخة للمعاينة فقط. حفظ اللقطات متوقف حتى اعتماد سياسة التكلفة وربط المصدر؛ لم تُحفظ هذه المعاينة.</p>
                        }
                    </div>
                </section>
            }

            <section class="cc-panel cc-history">
                <div class="cc-panel-heading">
                    <div><span class="cc-step">03</span><div><h2>آخر بطاقات التكلفة</h2><p>لقطات محفوظة من الجدول الحالي</p></div></div>
                    <span class="cc-count">@history.Count سجل</span>
                </div>
                @if (history.Count == 0)
                {
                    <div class="cc-empty"><span><svg viewBox="0 0 24 24"><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h5"/></svg></span><b>لا توجد بطاقات محفوظة حتى الآن</b><small>@(CostCards.SnapshotPersistenceEnabled ? "احسب المعاينة ثم احفظ لقطة صريحة لإظهار سجل التكلفة هنا." : "حفظ اللقطات متوقف مؤقتًا؛ يمكن مراجعة المعاينة دون إنشاء سجل.")</small></div>
                }
                else
                {
                    <div class="cc-table-wrap"><table class="cc-table">
                        <thead><tr><th>التاريخ</th><th>الصنف</th><th>النوع</th><th>الفترة</th><th>مواد مباشرة (تشمل المكونات)</th><th>عمالة</th><th>مصاريف أخرى</th><th>الإجمالي</th><th>تكلفة الوحدة</th><th>السعر المقترح</th><th>المصدر/التحذير</th></tr></thead>
                        <tbody>
                            @foreach (var card in history)
                            {
                                <tr>
                                    <td>@card.CalculationDate.ToString("dd/MM/yyyy")</td>
                                    <td><b>@card.ItemCode</b><small>@card.ItemNameAr</small></td>
                                    <td><span class="cc-pill @(card.CostType == 1 ? "pill-blue" : "pill-purple")">@card.CostTypeName</span></td>
                                    <td>@(card.PeriodName ?? "—")</td>
                                    <td>@Money(card.RawMaterialCost + card.PackagingCost)</td>
                                    <td>@Money(card.DirectLaborCost)</td>
                                    <td>@Money(card.TotalIndirectCost)</td>
                                    <td><b>@Money(card.TotalCost)</b></td>
                                    <td><b>@Money(card.CostPerUnit)</b></td>
                                    <td>@Money(card.SuggestedPrice)</td>
                                    <td title="@card.Notes"><span class="@(HasSavedWarnings(card) ? "cc-pill pill-purple" : "cc-pill pill-muted")">@(HasSavedWarnings(card) ? "تحذير مُراجع" : "مصدر موثق")</span></td>
                                </tr>
                            }
                        </tbody>
                    </table></div>
                    <div class="cc-history-foot">المصدر المرجعي محفوظ في الملاحظات؛ لا يوجد عمود ربط مستقل بالوصفة أو الأمر. تكلفة مكوّنات المنتج النهائي تُجمع في خانة المواد المباشرة لعدم وجود خانة مستقلة في الجدول.</div>
                }
            </section>

            <footer class="cc-assumption-foot"><b>توضيح مهم:</b> معنى <code>CostType</code> غير موثق في القاعدة؛ 1 هنا تقديري من BOM وليس معيارًا رسميًا مجمّدًا، و2 فعلي من أمر تصنيع. لا يُعتمد معيار رسمي إلا بمسار اعتماد وتثبيت منفصل. السعر المقترح زيادة على التكلفة (Markup)، وليس هامشًا من سعر البيع.</footer>
        }

        @if (showHelp)
        {
            <div class="cc-help-backdrop" @onclick="CloseHelpAsync">
                <section id="cc-help-dialog" class="cc-help-dialog" role="dialog" aria-modal="true" aria-labelledby="cc-help-title" tabindex="-1" @ref="helpDialogRef" @onclick:stopPropagation="true" @onkeydown="HandleHelpDialogKeyDown">
                    <header class="cc-help-head">
                        <div class="cc-help-heading">
                            <span class="cc-help-heading-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span>
                            <div><span class="cc-help-eyebrow">دليل المستخدم والمسؤول</span><h2 id="cc-help-title">شرح بطاقة التكلفة خطوة بخطوة</h2><p>هذا الشرح متاح لكل من لديه صلاحية عرض الشاشة.</p></div>
                        </div>
                        <button class="cc-help-close" type="button" aria-label="إغلاق الشرح" @onclick="CloseHelpAsync">×</button>
                    </header>

                    <div class="cc-help-content">
                        <section class="cc-help-block">
                            <div class="cc-help-block-title"><span>01</span><div><h3>ما هدف البطاقة؟</h3><p>أن تعرف تكلفة إنتاج الصنف للوحدة أو للكمية، وتراجع أساس التسعير. حفظ اللقطات @(CostCards.SnapshotPersistenceEnabled ? "متاح حسب الصلاحية" : "متوقف مؤقتًا حتى اعتماد السياسة").</p></div></div>
                            <div class="cc-help-note"><b>مهم:</b> البطاقة سجل تكلفة وتحليل؛ ليست فاتورة أو إذن صرف أو قيدًا محاسبيًا، ولا تغيّر رصيد المخزون. المعاينة وحدها لا تحفظ شيئًا.</div>
                        </section>

                        <section class="cc-help-block">
                            <div class="cc-help-block-title"><span>02</span><div><h3>افهم الأنواع قبل الاختيار</h3><p>ببساطة: التقديري = ما نتوقعه، المعياري = الهدف المعتمد، الفعلي = ما حدث بالفعل.</p></div></div>
                            <div class="cc-help-type-grid">
                                <article class="cc-help-type estimate"><span class="cc-help-state">متاح الآن</span><h4>تقديري من الوصفة</h4><p>توقع تكلفة قبل الإنتاج، محسوب من الوصفة السارية وتكاليف مكوناتها والمدخلات المتاحة. يتغير إذا تغيّرت الوصفة أو تكاليفها؛ لذلك لا يُعد معيارًا رسميًا مجمّدًا.</p></article>
                                <article class="cc-help-type standard"><span class="cc-help-state">غير متاح حاليًا</span><h4>معياري</h4><p>تكلفة مستهدفة تعتمدها الإدارة وتثبتها لفترة أو نسخة محددة، ثم تقارن الفعلي بها. هذه الشاشة لا تنشئ معيارًا ولا تعتمده أو تجمّده.</p></article>
                                <article class="cc-help-type actual"><span class="cc-help-state">متاح الآن</span><h4>فعلي من أمر تصنيع</h4><p>تكلفة أمر مكتمل وفق الصرف المعتمد والعمالة والأعباء المسجلة، مقسومة على الناتج المقبول. الحساب على مستوى الأمر، وليس على مستوى الباتش.</p></article>
                            </div>
                        </section>

                        <section class="cc-help-block">
                            <div class="cc-help-block-title"><span>03</span><div><h3>طريقة الاستخدام</h3><p>اتبع الخطوات بالترتيب؛ لا تحفظ قبل مراجعة مصدر الحساب والنتيجة.</p></div></div>
                            <ol class="cc-help-steps">
                                <li><span>1</span><div><b>اختر نوع البطاقة</b><p>ابدأ بالتقديري إذا كنت تخطط قبل الإنتاج، أو بالفعلي إذا كان لديك أمر تصنيع مكتمل تريد مراجعة تكلفته.</p></div></li>
                                <li><span>2</span><div><b>ابحث عن المنتج</b><p>اكتب جزءًا من اسم الصنف أو كوده، ثم اختره من النتائج. تُحمّل مصادر التكلفة الخاصة به بعد الاختيار.</p></div></li>
                                <li><span>3</span><div><b>تأكد من المصدر</b><p>للتقديري اختر الوصفة السارية المقصودة. للفعلي اختر الأمر المكتمل الصحيح؛ لا يُعرض إلا الأمر ذو ناتج مقبول وإذن صرف معتمد.</p></div></li>
                                <li><span>4</span><div><b>حدد الفترة ونسبة الزيادة</b><p>الفترة اختيارية وتكون مفتوحة فقط؛ اختيارها لا يقفلها. أدخل نسبة الزيادة على التكلفة إذا أردت سعرًا مقترحًا؛ اتركها صفرًا إذا لم ترد زيادة.</p></div></li>
                                <li><span>5</span><div><b>احسب المعاينة وراجعها</b><p>ستظهر تكلفة الوحدة والإجمالي والسعر المقترح وتفصيل المواد والعمالة والأعباء. اقرأ التنبيهات، وتأكد أن الأصفار مقصودة وأن المصدر صحيح.</p></div></li>
                                <li><span>6</span><div><b>@(CostCards.SnapshotPersistenceEnabled ? "احفظ عند التأكد فقط" : "المعاينة دون حفظ")</b><p>@(CostCards.SnapshotPersistenceEnabled ? "زر الحفظ ينشئ لقطة جديدة في سجل البطاقات. راجع التنبيهات وأكد الاطلاع؛ وإذا وُجد مانع فلن يسمح النظام بالحفظ." : "حفظ اللقطات متوقف افتراضيًا حتى اعتماد سياسة التكلفة وربط المصدر. لا تُنشأ سجلات عند حساب المعاينة.")</p></div></li>
                            </ol>
                        </section>

                        <section class="cc-help-block">
                            <div class="cc-help-block-title"><span>04</span><div><h3>كيف أقرأ الأرقام؟</h3><p>الإجمالي يجمع مكونات التكلفة التي وفرها المصدر، وتكلفة الوحدة تقسمه على كمية الناتج المستخدمة في الحساب.</p></div></div>
                            <div class="cc-help-example">
                                <div class="cc-help-example-title"><b>مثال مبسط</b><span>كمية الناتج 10 وحدات</span></div>
                                <div class="cc-help-math"><span>مواد خام 60 + تعبئة 10 + عمالة 20 + أعباء 10</span><b>= إجمالي 100</b></div>
                                <div class="cc-help-math"><span>100 ÷ 10 وحدات</span><b>= تكلفة الوحدة 10</b></div>
                                <div class="cc-help-math highlight"><span>زيادة 20% على تكلفة الوحدة</span><b>10 × 1.20 = سعر مقترح 12</b></div>
                            </div>
                            <div class="cc-help-note cc-help-compare-note"><b>مهم عند مقارنة التقديري بالفعلي:</b> التقديري من BOM يجمع كل بنود الوصفة، بما فيها البنود الاختيارية. الفعلي يجمع أسطر الصرف المعتمدة التي استُخدمت فعلًا؛ وقد يختلف إذا اختير بديل أو لم يُستخدم مكوّن اختياري. وتكلفة الوحدة المسجلة على مادة أمر التصنيع تقديرية للتخطيط؛ الفعلي في البطاقة يعتمد تكلفة أسطر الصرف المعتمدة المحفوظة.</div>
                            <p class="cc-help-extra"><b>تنبيه على السعر:</b> نسبة الحقل زيادة على التكلفة (Markup)، وليست هامشًا من سعر البيع. تكلفة 100 مع زيادة 20% تعطي سعرًا 120؛ أما هامش ربح 20% من سعر البيع فيعني سعرًا 125.</p>
                            <p class="cc-help-extra"><b>مثال معياري للمقارنة فقط:</b> إذا كان المعيار المعتمد 9 للوحدة والفعلي 10، فالانحراف +1 للوحدة. الشاشة الحالية لا تحسب هذا الانحراف تلقائيًا؛ ولا يوجد فيها مسار لإنشاء المعيار واعتماده.</p>
                        </section>

                        <section class="cc-help-block">
                            <div class="cc-help-block-title"><span>05</span><div><h3>التنبيهات ومتى أتوقف عن الحفظ؟</h3><p>الأرقام الصفرية أو غير المصنفة لا تعني دائمًا أن تكلفتها الحقيقية صفر.</p></div></div>
                            <div class="cc-help-warning-grid">
                                <div><b>راجع قبل الإقرار</b><ul><li>قد تبقى بعض الأعباء غير المباشرة صفرًا إذا لم يوفرها المصدر.</li><li>في التكلفة الفعلية راجع صفر العمالة أو المصاريف الصناعية، وتأكد أنه مقصود.</li><li>مكونات المنتج النهائي تظهر منفصلة، لكنها تُجمع في خانة المواد المباشرة عند الحفظ لحدود أعمدة الجدول.</li></ul></div>
                                <div class="blocked"><b>لن يسمح بالحفظ عند</b><ul><li>وجود مرتجعات مواد مسجلة؛ فالشاشة لا تستطيع تسوية صافي تكلفتها تلقائيًا.</li><li>وجود مواد غير مصنفة أو عدم وجود أسطر صرف معتمدة.</li><li>اختلاف مجموع مواد الأمر عن أسطر الصرف المعتمدة بأكثر من 0.01.</li></ul></div>
                            </div>
                        </section>

                        <section class="cc-help-block cc-help-limits">
                            <div class="cc-help-block-title"><span>06</span><div><h3>حدود مهمة للمستخدم والمسؤول</h3><p>حتى لا تُفسّر اللقطة على أنها شيء لا توفره الشاشة.</p></div></div>
                            <ul><li>الحفظ ينشئ سجل تكلفة وسجل تدقيق؛ لا يرحّل قيدًا محاسبيًا ولا ينفذ حركة مخزون.</li><li>المصدر محفوظ كمرجع في الملاحظات؛ لا يوجد ربط مستقل بالوصفة أو الأمر، ولا توزيع تلقائي لتكلفة الأمر على دفعات الإنتاج.</li><li>القيم 1 و2 في <code>CostType</code> افتراض تنفيذي غير موثق في قاعدة البيانات: 1 تقديري، و2 فعلي. المعياري يحتاج مسار اعتماد وتثبيت منفصلًا.</li></ul>
                        </section>
                    </div>
                    <footer class="cc-help-footer"><span>@(CostCards.SnapshotPersistenceEnabled ? "المعاينة لا تكتب بيانات؛ لا تحفظ لقطة إلا بعد مراجعة الأرقام والمصدر." : "هذه النسخة للمعاينة فقط؛ لا تحفظ أي بيانات بطاقة.")</span><button type="button" class="cc-btn cc-btn-primary" @onclick="CloseHelpAsync">فهمت، إغلاق الشرح</button></footer>
                </section>
            </div>
        }
    </main>
}

