@code {
    [Parameter] public int BOMID { get; set; }

    private ModulePermissionDto? perms;
    private BOMEditDto bom = new();
    private List<BOMDetailDto> details = new();
    private List<BOMStageDto> stages = new();
    private BOMCostSummaryDto costs = new();
    private BOMAuditDto? auditInfo;

    private List<BOMLookupDto> productLookup  = new();
    private List<BOMLookupDto> unitLookup     = new();
    private List<BOMLookupDto> stageLookup    = new();
    private List<BOMLookupDto> materialLookup = new();

    private BOMDetailDto detailModel = new();
    private BOMStageDto  stageModel  = new();

    private bool isLoading     = true;
    private bool lookupsLoaded = false;
    private int  currentTab    = 1;

    private bool IsNew         => BOMID == 0;
    private bool IsReadOnly    => !IsNew && (bom.BOMStatus == 2 || bom.BOMStatus == 4);
    private bool CanEditHeader => IsNew || bom.BOMStatus == 1 || bom.BOMStatus == 3;
    private bool CanEditLines  => !IsNew && (bom.BOMStatus == 1 || bom.BOMStatus == 3);
    private bool CanActivate   => !IsNew && (bom.BOMStatus == 1 || bom.BOMStatus == 3);
    private bool CanStop       => !IsNew && bom.BOMStatus == 2;
    private bool CanCancel     => !IsNew && (bom.BOMStatus == 1 || bom.BOMStatus == 3);
    private bool IsProductLocked => !IsNew && details.Any();

    private int  CurrentUserId     => UserSession.CurrentUserID;
    private int? CurrentEmployeeId => UserSession.CurrentEmployeeID;

    private string PageTitle => IsNew ? "إضافة وصفة تصنيع"
                              : IsReadOnly ? "عرض وصفة تصنيع"
                              : "تعديل وصفة تصنيع";

    private string EffectiveFromText
{
    get => bom.EffectiveFrom?.ToString("yyyy-MM-dd") ?? "";
    set
    {
        var v = value ?? "";
        if (string.IsNullOrWhiteSpace(v)) bom.EffectiveFrom = null;
        else if (DateTime.TryParse(v, out var d)) bom.EffectiveFrom = d;
    }
}

    private string EffectiveToText
{
    get => bom.EffectiveTo?.ToString("yyyy-MM-dd") ?? "";
    set
    {
        var v = value ?? "";
        if (string.IsNullOrWhiteSpace(v)) bom.EffectiveTo = null;
        else if (DateTime.TryParse(v, out var d)) bom.EffectiveTo = d;
    }
}

    private int SubstituteItemIdValue
    {
        get => detailModel.SubstituteItemID ?? 0;
        set => detailModel.SubstituteItemID = value == 0 ? null : value;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded)
            await PermissionService.LoadPermissionsAsync(UserSession.UserID);

        perms = PermissionService.GetModule("SCR_BOM");

        if (perms == null || !perms.CanView) { isLoading = false; return; }

        if (!lookupsLoaded) { await LoadLookupsAsync(); lookupsLoaded = true; }

        await LoadPageAsync();
        isLoading = false;
    }

    private void SetTab(int t) => currentTab = t;

    private async Task LoadLookupsAsync()
    {
        productLookup  = await BomService.GetProductItemsLookupAsync();
        unitLookup     = await BomService.GetUnitsLookupAsync();
        stageLookup    = await BomService.GetStagesLookupAsync();
        materialLookup = await BomService.GetMaterialItemsLookupAsync();
    }

    private async Task LoadPageAsync()
    {
        if (IsNew)
        {
            bom = new BOMEditDto
            {
                BOMVersion    = 1,
                BOMStatus     = 1,
                WastePercent  = 3,
                IsActive      = true,
                EffectiveFrom = DateTime.Today
            };
            details   = new();
            stages    = new();
            costs     = new();
            auditInfo = null;
            ResetDetailForm();
            ResetStageForm();
            return;
        }

        var data = await BomService.GetBOMByIdAsync(BOMID);
        if (data == null) { await Alert("الوصفة غير موجودة"); BackToList(); return; }

        bom = data;
        await ReloadDetailsAsync();
        await ReloadStagesAsync();
        await ReloadCostsAsync();
        await ReloadAuditAsync();
        ResetDetailForm();
        ResetStageForm();
    }

    private async Task ReloadDetailsAsync() =>
        details = IsNew ? new() : await BomService.GetBOMDetailsAsync(BOMID);

    private async Task ReloadStagesAsync() =>
        stages = IsNew ? new() : await BomService.GetBOMStagesAsync(BOMID);

    private async Task ReloadCostsAsync() =>
        costs = IsNew ? new() : await BomService.GetBOMCostSummaryAsync(BOMID);

    private async Task ReloadAuditAsync() =>
        auditInfo = IsNew ? null : await BomService.GetBOMAuditAsync(BOMID);

    private async Task SaveHeaderAsync()
    {
        if (!await ValidateHeaderAsync()) return;
        if (IsNew)
        {
            var newId = await BomService.InsertBOMAsync(bom, CurrentUserId);
            await Alert("تم حفظ الوصفة بنجاح ✅");
            NavigationManager.NavigateTo($"/boms/edit/{newId}", true);
            return;
        }
        await BomService.UpdateBOMAsync(bom, CurrentUserId);
        await ReloadCostsAsync();
        await ReloadAuditAsync();
        await Alert("تم حفظ التعديلات بنجاح ✅");
    }

    private async Task SaveHeaderAndReloadCostsAsync()
    {
        if (IsNew) { await Alert("يجب حفظ الوصفة أولاً"); return; }
        if (!await ValidateHeaderAsync()) return;
        await BomService.UpdateBOMAsync(bom, CurrentUserId);
        await ReloadCostsAsync();
        await ReloadAuditAsync();
        await Alert("تم حفظ بيانات التكاليف بنجاح ✅");
    }

    private async Task<bool> ValidateHeaderAsync()
    {
        if (string.IsNullOrWhiteSpace(bom.BOMName))  { currentTab = 1; await Alert("يجب إدخال اسم الوصفة");             return false; }
        if (bom.ProductItemID <= 0)                   { currentTab = 1; await Alert("يجب اختيار المنتج");               return false; }
        if (bom.BatchSize     <= 0)                   { currentTab = 1; await Alert("يجب إدخال حجم دفعة أكبر من صفر"); return false; }
        if (bom.BatchUnitID   <= 0)                   { currentTab = 1; await Alert("يجب اختيار وحدة الدفعة");          return false; }
        if (bom.OutputQty     <= 0)                   { currentTab = 1; await Alert("يجب إدخال كمية ناتجة أكبر من صفر"); return false; }
        if (bom.OutputUnitID  <= 0)                   { currentTab = 1; await Alert("يجب اختيار وحدة الناتج");          return false; }
        return true;
    }

    private async Task SaveDetailAsync()
    {
        if (IsNew)                    { await Alert("يجب حفظ الوصفة أولاً"); return; }
        if (detailModel.ItemID <= 0)  { await Alert("يجب اختيار الصنف");     return; }
        if (detailModel.UnitID <= 0)  { await Alert("يجب اختيار الوحدة");    return; }
        if (detailModel.Quantity <= 0){ await Alert("يجب إدخال كمية أكبر من صفر"); return; }
        if (detailModel.StageNumber <= 0) detailModel.StageNumber = 1;

        var dup = await BomService.IsDuplicateItemAsync(BOMID, detailModel.ItemID, detailModel.BOMDetailID);
        if (dup) { await Alert("هذا الصنف موجود بالفعل داخل الوصفة"); return; }

        detailModel.BOMID = BOMID;

        if (detailModel.BOMDetailID == 0)
            await BomService.InsertBOMDetailAsync(detailModel, CurrentUserId);
        else
            await BomService.UpdateBOMDetailAsync(detailModel, CurrentUserId);

        await ReloadDetailsAsync();
        await ReloadCostsAsync();
        ResetDetailForm();
    }

    private void EditDetail(BOMDetailDto row)
    {
        detailModel = new BOMDetailDto
        {
            BOMDetailID       = row.BOMDetailID,
            BOMID             = row.BOMID,
            LineNumber        = row.LineNumber,
            ItemID            = row.ItemID,
            ItemCode          = row.ItemCode,
            ItemName          = row.ItemName,
            MaterialType      = row.MaterialType,
            MaterialTypeName  = row.MaterialTypeName,
            UnitID            = row.UnitID,
            UnitName          = row.UnitName,
            Quantity          = row.Quantity,
            WastePercent      = row.WastePercent,
            NetQuantity       = row.NetQuantity,
            UnitCost          = row.UnitCost,
            LineCost          = row.LineCost,
            IsOptional        = row.IsOptional,
            SubstituteItemID  = row.SubstituteItemID,
            SubstituteItemName = row.SubstituteItemName,
            Sequence          = row.Sequence,
            StageNumber       = row.StageNumber,
            Notes             = row.Notes
        };
    }

    private async Task DeleteDetailAsync(int id)
    {
        if (!await Confirm("هل تريد حذف هذا المكون؟")) return;
        await BomService.DeleteBOMDetailAsync(id, CurrentUserId);
        await ReloadDetailsAsync();
        await ReloadCostsAsync();
        ResetDetailForm();
    }

    private void ResetDetailForm() =>
        detailModel = new BOMDetailDto
        {
            BOMID       = BOMID,
            MaterialType = 1,
            WastePercent = 0,
            StageNumber  = 1,
            Sequence     = 0,
            IsOptional   = false
        };

    private async Task SaveStageAsync()
    {
        if (IsNew)                     { await Alert("يجب حفظ الوصفة أولاً");          return; }
        if (stageModel.StageID <= 0)   { await Alert("يجب اختيار المرحلة");            return; }
        if (stageModel.StageOrder <= 0){ await Alert("يجب إدخال ترتيب أكبر من صفر");  return; }

        var dupStage = await BomService.IsDuplicateStageAsync(BOMID, stageModel.StageID, stageModel.BOMStageID);
        if (dupStage) { await Alert("هذه المرحلة موجودة بالفعل داخل الوصفة"); return; }

        var dupOrder = await BomService.IsDuplicateStageOrderAsync(BOMID, stageModel.StageOrder, stageModel.BOMStageID);
        if (dupOrder) { await Alert("رقم الترتيب مستخدم مسبقاً"); return; }

        stageModel.BOMID = BOMID;

        if (stageModel.BOMStageID == 0)
            await BomService.InsertBOMStageAsync(stageModel, CurrentUserId);
        else
            await BomService.UpdateBOMStageAsync(stageModel, CurrentUserId);

        await ReloadStagesAsync();
        ResetStageForm();
    }

    private void EditStage(BOMStageDto row) =>
        stageModel = new BOMStageDto
        {
            BOMStageID           = row.BOMStageID,
            BOMID                = row.BOMID,
            StageID              = row.StageID,
            StageName            = row.StageName,
            StageOrder           = row.StageOrder,
            Duration             = row.Duration,
            Temperature          = row.Temperature,
            Speed                = row.Speed,
            QualityCheckRequired = row.QualityCheckRequired,
            QualityCheckNotes    = row.QualityCheckNotes,
            Instructions         = row.Instructions,
            Notes                = row.Notes
        };

    private async Task DeleteStageAsync(int id)
    {
        if (!await Confirm("هل تريد حذف هذه المرحلة؟")) return;
        await BomService.DeleteBOMStageAsync(id, CurrentUserId);
        await ReloadStagesAsync();
        ResetStageForm();
    }

    private void ResetStageForm() =>
        stageModel = new BOMStageDto
        {
            BOMID      = BOMID,
            StageOrder = stages.Any() ? stages.Max(x => x.StageOrder) + 1 : 1
        };

    private async Task MoveStageUpAsync(BOMStageDto row)
    {
        var other = stages.FirstOrDefault(x => x.StageOrder == row.StageOrder - 1);
        if (other == null) return;
        await BomService.SwapStageOrderAsync(BOMID, row.BOMStageID, row.StageOrder, other.BOMStageID, other.StageOrder);
        await ReloadStagesAsync();
    }

    private async Task MoveStageDownAsync(BOMStageDto row)
    {
        var other = stages.FirstOrDefault(x => x.StageOrder == row.StageOrder + 1);
        if (other == null) return;
        await BomService.SwapStageOrderAsync(BOMID, row.BOMStageID, row.StageOrder, other.BOMStageID, other.StageOrder);
        await ReloadStagesAsync();
    }

    private async Task ActivateAsync()
    {
        if (IsNew) { await Alert("يجب حفظ الوصفة أولاً"); return; }
        await BomService.UpdateBOMAsync(bom, CurrentUserId);
        var existing = await BomService.CheckActiveVersionExistsAsync(bom.ProductItemID, bom.BOMID);
        if (existing.Exists)
        {
            if (!await Confirm($"يوجد إصدار نشط ({existing.ExistingBOMCode}). هل تريد إيقافه وتنشيط هذا الإصدار؟"))
                return;
            var r = await BomService.ActivateAndDeactivateOldAsync(bom.BOMID, existing.ExistingBOMID, CurrentUserId, CurrentEmployeeId);
            await Alert(r.Message);
            if (r.Success) await LoadPageAsync();
            return;
        }
        var result = await BomService.ChangeStatusAsync(bom.BOMID, 2, CurrentUserId, CurrentEmployeeId);
        await Alert(result.Message);
        if (result.Success) await LoadPageAsync();
    }

    private async Task StopAsync()
    {
        if (!await Confirm("هل تريد إيقاف هذه الوصفة؟")) return;
        var r = await BomService.ChangeStatusAsync(bom.BOMID, 3, CurrentUserId, CurrentEmployeeId);
        await Alert(r.Message);
        if (r.Success) await LoadPageAsync();
    }

    private async Task CancelBomAsync()
    {
        if (!await Confirm("هل تريد إلغاء هذه الوصفة؟")) return;
        var r = await BomService.SoftDeleteBOMAsync(bom.BOMID, CurrentUserId);
        await Alert(r.Message);
        if (r.Success) await LoadPageAsync();
    }

    private async Task CopyBomAsync()
    {
        if (!await Confirm("سيتم إنشاء نسخة جديدة. هل تريد المتابعة؟")) return;
        var r = await BomService.CopyBOMAsync(bom.BOMID, CurrentUserId);
        await Alert(r.Message);
        if (r.Success) NavigationManager.NavigateTo($"/boms/edit/{r.NewBOMID}", true);
    }

    private async Task UpdateCostsAsync()
    {
        if (IsNew) { await Alert("يجب حفظ الوصفة أولاً"); return; }
        if (!await Confirm("سيتم تحديث تكاليف المكونات من أسعار المواد الحالية. هل تريد المتابعة؟")) return;
        await BomService.UpdateBOMCostsAsync(BOMID, CurrentUserId);
        await ReloadDetailsAsync();
        await ReloadCostsAsync();
        await Alert("تم تحديث التكاليف بنجاح ✅");
        currentTab = 4;
    }

    private void BackToList() => NavigationManager.NavigateTo("/boms");
    private async Task Alert(string msg) => await JS.InvokeVoidAsync("alert", msg);
    private async Task<bool> Confirm(string msg) => await JS.InvokeAsync<bool>("confirm", msg);

    private string GetStatusName(int s) => s switch
    {
        1 => "مسودة", 2 => "نشط", 3 => "متوقف", 4 => "ملغي", _ => "—"
    };

    private string GetStatusClass(int s) => s switch
    {
        1 => "s-draft", 2 => "s-active", 3 => "s-paused", 4 => "s-cancelled", _ => "s-draft"
    };
}