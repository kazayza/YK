@page "/purchase-invoices"
@page "/purchase-invoice"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PurchaseInvoiceService InvService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>فواتير المشتريات - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access"><div class="na-icon">🔒</div><h4>يجب تسجيل الدخول أولاً</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access"><div class="na-icon">⛔</div><h4>ليس لديك صلاحية</h4>
        <button class="btn-m btn-ghost" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة للرئيسية</button>
    </div>
}
else
{
    <div class="page-wrap" dir="rtl">
        <div class="page-hdr">
            <div>
                <h2 class="page-title">فواتير المشتريات</h2>
                <p class="page-sub">إدارة فواتير الموردين والمدفوعات</p>
            </div>
            <div class="hdr-actions">
                <span class="badge-count">@filtered.Count فاتورة</span>
                @if (permissions.CanExport)
                {
                    <button class="btn-m btn-export" @onclick="ExportExcel" disabled="@isExporting">
                        @if (isExporting) { <div class="btn-spin"></div> } else { <span>📥</span> }
                        Excel
                    </button>
                }
                @if (permissions.CanAdd)
                {
                    <div class="add-dropdown-wrap">
                        <button class="btn-m btn-primary" @onclick="ToggleAddMenu">
                            ➕ فاتورة جديدة ▾
                        </button>
                        @if (showAddMenu)
                        {
                            <div class="add-dropdown">
                                <div class="add-opt" @onclick="AddFromGRN">
                                    <span class="add-opt-icon" style="background:#ecfeff;color:#0891b2;">📦</span>
                                    <div>
                                        <div class="add-opt-title">من إذن استلام</div>
                                        <div class="add-opt-desc">إنشاء فاتورة من إذن استلام معتمد</div>
                                    </div>
                                </div>
                                <div class="add-opt" @onclick="AddDirect">
                                    <span class="add-opt-icon" style="background:#fff7ed;color:#f97316;">✏️</span>
                                    <div>
                                        <div class="add-opt-title">فاتورة مباشرة</div>
                                        <div class="add-opt-desc">إنشاء فاتورة بدون إذن استلام</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (invoices != null)
        {
            <div class="stats-row">
                <div class="stat-box" style="border-top-color:#64748b">
                    <div class="stat-n">@invoices.Count(i => i.InvoiceStatus == 1)</div><div class="stat-l">مسودة</div>
                </div>
                <div class="stat-box" style="border-top-color:#f59e0b">
                    <div class="stat-n">@invoices.Count(i => i.InvoiceStatus == 2)</div><div class="stat-l">انتظار اعتماد</div>
                </div>
                <div class="stat-box" style="border-top-color:#10b981">
                    <div class="stat-n">@invoices.Count(i => i.InvoiceStatus == 3)</div><div class="stat-l">معتمدة</div>
                </div>
                <div class="stat-box" style="border-top-color:#6366f1">
                    <div class="stat-n">@invoices.Where(i => i.PaymentStatus == 2).Count()</div><div class="stat-l">مدفوعة جزئياً</div>
                </div>
                <div class="stat-box" style="border-top-color:#14b8a6">
                    <div class="stat-n">@invoices.Where(i => i.PaymentStatus == 3).Count()</div><div class="stat-l">مدفوعة</div>
                </div>
                <div class="stat-box" style="border-top-color:#ef4444">
                    <div class="stat-n">@invoices.Count(i => i.IsOverdue)</div><div class="stat-l">متأخرة ⚠️</div>
                </div>
            </div>
        }

        <div class="filter-row">
            <div class="search-wrap">
                <svg class="search-ic" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                </svg>
                <input class="search-inp" type="text" placeholder="بحث برقم الفاتورة أو المورد..."
                       @bind="searchText" @bind:event="oninput" @onkeyup="Filter" />
                @if (!string.IsNullOrEmpty(searchText))
                { <button class="search-clr" @onclick="ClearSearch">✕</button> }
            </div>
            <select class="filter-sel" @bind="filterStatus" @bind:after="Filter">
                <option value="0">كل الحالات</option>
                <option value="1">مسودة</option>
                <option value="2">انتظار اعتماد</option>
                <option value="3">معتمدة</option>
                <option value="4">مدفوعة جزئياً</option>
                <option value="5">مدفوعة بالكامل</option>
                <option value="6">متأخرة</option>
                <option value="7">ملغية</option>
            </select>
            <button class="btn-m btn-ghost" @onclick="LoadData">🔄 تحديث</button>
        </div>

        @if (invoices == null)
        {
            <div class="loading-st"><div class="loader"></div><p>جاري التحميل...</p></div>
        }
        else if (!filtered.Any())
        {
            <div class="empty-st"><h4>لا توجد فواتير</h4></div>
        }
        else
        {
            <div class="tbl-card">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>#</th><th>رقم الفاتورة</th><th>التاريخ</th><th>المورد</th>
                            <th>فاتورة المورد</th><th>إذن الاستلام</th>
                            <th class="tc">أصناف</th><th class="tl">الإجمالي</th>
                            <th class="tl">المدفوع</th><th class="tl">المتبقي</th>
                            <th>الاستحقاق</th><th class="tc">الدفع</th>
                            <th class="tc">الحالة</th><th class="tc">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int n = 0; }
                        @foreach (var inv in filtered)
                        {
                            n++;
                            <tr class="@(inv.InvoiceStatus == 1 ? "tr-draft" : "") @(inv.IsOverdue ? "tr-overdue" : "")">
                                <td class="td-n">@n</td>
                                <td><span class="doc-num" @onclick="() => ViewInvoice(inv.InvoiceID)" style="cursor:pointer">@inv.InvoiceNumber</span></td>
                                <td>@inv.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                <td class="td-bold">@(inv.SupplierNameAr ?? "—")</td>
                                <td class="td-muted">@(inv.SupplierInvoiceNo ?? "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(inv.LinkedGRNNumber))
                                    { <code class="grn-link">@inv.LinkedGRNNumber</code> }
                                    else { <span class="td-muted">مباشرة</span> }
                                </td>
                                <td class="tc"><span class="cnt-badge">@inv.ItemCount</span></td>
                                <td class="tl"><span class="amount-cell">@inv.TotalAmount.ToString("#,##0.00")</span></td>
                                <td class="tl num-cell">@inv.PaidAmount.ToString("#,##0.00")</td>
                                <td class="tl">
                                    <span class="@(inv.RemainingAmount > 0 ? "remaining-amount" : "")">
                                        @inv.RemainingAmount.ToString("#,##0.00")
                                    </span>
                                </td>
                                <td>
                                    @if (inv.DueDate.HasValue)
                                    {
                                        <span class="@(inv.IsOverdue ? "overdue-date" : "")">
                                            @inv.DueDate.Value.ToString("dd/MM/yyyy")
                                            @if (inv.IsOverdue)
                                            { <span class="overdue-badge">@inv.DaysOverdue يوم</span> }
                                        </span>
                                    }
                                    else { <span class="td-muted">—</span> }
                                </td>
                                <td class="tc">
                                    <span class="payment-badge" style="--pc:@PurchaseInvoiceService.GetPaymentStatusColor(inv.PaymentStatus)">
                                        @PurchaseInvoiceService.GetPaymentStatusName(inv.PaymentStatus)
                                    </span>
                                </td>
                                <td class="tc">
                                    <span class="status-badge" style="--sc:@PurchaseInvoiceService.GetStatusColor(inv.InvoiceStatus)">
                                        @PurchaseInvoiceService.GetStatusName(inv.InvoiceStatus)
                                    </span>
                                </td>
                                <td class="tc">
                                    <div class="actions-wrap">
                                        @if (permissions.CanEdit && inv.InvoiceStatus == 1)
                                        { <button class="act-btn edit" title="تعديل" @onclick="() => EditInvoice(inv.InvoiceID)">✏️</button> }
                                        else
                                        { <button class="act-btn view" title="عرض" @onclick="() => ViewInvoice(inv.InvoiceID)">👁️</button> }
                                        @if (permissions.CanPrint)
                                        { <button class="act-btn print" title="طباعة" @onclick="() => PrintInvoice(inv.InvoiceID)">🖨️</button> }
                                        @if (permissions.CanApprove && inv.InvoiceStatus == 2)
                                        { <button class="act-btn approve" title="اعتماد" @onclick="() => EditInvoice(inv.InvoiceID)">✅</button> }
                                        @if (permissions.CanDelete && inv.InvoiceStatus == 1)
                                        { <button class="act-btn del" title="حذف" @onclick="() => ShowDeleteDialog(inv)">🗑️</button> }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (showDeleteDialog)
    {
        <div class="modal-ov" @onclick="CloseDeleteDialog">
            <div class="modal-box" @onclick:stopPropagation="true">
                <h4>تأكيد الحذف</h4>
                <p>هل أنت متأكد من حذف الفاتورة: <strong>@deleteInvoice?.InvoiceNumber</strong>؟</p>
                @if (!string.IsNullOrEmpty(deleteMsg))
                { <div class="form-msg err">@deleteMsg</div> }
                <div class="modal-btns">
                    <button class="btn-m btn-danger" @onclick="ConfirmDelete">تأكيد الحذف</button>
                    <button class="btn-m btn-ghost" @onclick="CloseDeleteDialog">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(toast))
    {
        <div class="toast-wrap">
            <div class="toast @(toastOk ? "t-ok" : "t-err")">
                <span>@toast</span><button @onclick='() => toast = ""'>✕</button>
            </div>
        </div>
    }
}

@if (showAddMenu) { <div class="add-overlay" @onclick="CloseAddMenu"></div> }

<style>
