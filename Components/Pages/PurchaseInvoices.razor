</style>

@code {
    private List<PurchaseInvoiceListDto>? invoices;
    private List<PurchaseInvoiceListDto> filtered = new();
    private ModulePermissionDto? permissions;
    private string searchText = "";
    private int filterStatus = 0;
    private bool isExporting = false;
    private string toast = ""; private bool toastOk = true;
    private bool showAddMenu = false;
    private bool showDeleteDialog = false;
    private PurchaseInvoiceListDto? deleteInvoice;
    private string deleteMsg = "";

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_PINV");
        if (permissions != null && permissions.CanView) await LoadData();
    }

    private async Task LoadData() { invoices = await InvService.GetInvoicesListAsync(); Filter(); }

    private void Filter()
    {
        if (invoices == null) return;
        filtered = invoices.Where(i =>
            (filterStatus == 0 || i.InvoiceStatus == filterStatus) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(i.InvoiceNumber, searchText) ||
             ArabicSearchHelper.Contains(i.SupplierNameAr, searchText) ||
             ArabicSearchHelper.Contains(i.SupplierInvoiceNo, searchText))
        ).ToList();
    }

    private void ClearSearch() { searchText = ""; Filter(); }
    private void ToggleAddMenu() { showAddMenu = !showAddMenu; }
    private void CloseAddMenu() { showAddMenu = false; }
    private void AddFromGRN() { showAddMenu = false; Navigation.NavigateTo("/purchase-invoices/new?source=grn"); }
    private void AddDirect() { showAddMenu = false; Navigation.NavigateTo("/purchase-invoices/new?source=direct"); }

    private void ViewInvoice(int id)
    {
        var inv = invoices?.FirstOrDefault(i => i.InvoiceID == id);
        if (inv != null && inv.InvoiceStatus == 2 && permissions != null && permissions.CanApprove)
            Navigation.NavigateTo($"/purchase-invoices/edit/{id}");
        else
            Navigation.NavigateTo($"/purchase-invoices/view/{id}");
    }

    private void EditInvoice(int id) => Navigation.NavigateTo($"/purchase-invoices/edit/{id}");

    private async Task PrintInvoice(int id)
    {
        try { var html = await InvService.GenerateReportHtmlAsync(id, UserSession.UserID); await JS.InvokeVoidAsync("printHtml", html); }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
    }

    private async Task ExportExcel()
    {
        if (!filtered.Any()) return;
        isExporting = true; StateHasChanged();
        try
        {
            var bytes = await InvService.ExportToExcelAsync(filtered, UserSession.UserID);
            await JS.InvokeVoidAsync("downloadFile", $"PurchaseInvoices_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isExporting = false; }
    }

    private void ShowDeleteDialog(PurchaseInvoiceListDto inv) { deleteInvoice = inv; deleteMsg = ""; showDeleteDialog = true; }
    private void CloseDeleteDialog() { showDeleteDialog = false; }

    private async Task ConfirmDelete()
    {
        if (deleteInvoice == null) return;
        try
        {
            var result = await InvService.DeleteInvoiceAsync(deleteInvoice.InvoiceID, UserSession.UserID);
            if (result.Success) { toast = result.Message + " ✅"; toastOk = true; showDeleteDialog = false; await LoadData(); }
            else { deleteMsg = result.Message; }
        }
        catch (Exception ex) { deleteMsg = "خطأ: " + ex.Message; }
    }
}