.ml-header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;background:linear-gradient(135deg,#fcfaf6,#f8f6f0);border-bottom:1px solid #f1efe8}.ml-header h3{margin:0;font-size:.95rem;font-weight:800;color:#0A0F1E}
.btn-close-x{width:28px;height:28px;border-radius:8px;border:1px solid #e8e2d0;background:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#6b7280}.btn-close-x svg{width:12px;height:12px}
.ml-body{padding:20px;overflow-y:auto;flex:1}.form-grid-luxury{display:grid;grid-template-columns:1fr 1fr;gap:14px}.form-grid-luxury .fg.full{grid-column:1/-1}.fg label{font-size:.78rem;font-weight:700;color:#374151;margin-bottom:6px;display:block}.fg input,.fg select{width:100%;height:40px;padding:0 12px;border:1.5px solid #e8e2d0;border-radius:10px;font-size:.84rem;font-family:'Tajawal';outline:none;background:#fcfaf6;transition:.2s}.fg input:focus,.fg select:focus{border-color:var(--gold);background:#fff;box-shadow:0 0 0 3px rgba(212,175,55,.08)}
.switch-luxury{position:relative;display:inline-block;width:44px;height:24px}.switch-luxury input{opacity:0;width:0;height:0}.switch-luxury span{position:absolute;cursor:pointer;top:0;left:0;right:0;bottom:0;background:#e5e7eb;border-radius:999px;transition:.2s}.switch-luxury span:before{position:absolute;content:"";height:18px;width:18px;left:3px;bottom:3px;background:#fff;border-radius:50%;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.15)}.switch-luxury input:checked+span{background:var(--gold)}.switch-luxury input:checked+span:before{transform:translateX(20px)}
.ml-footer{display:flex;gap:8px;padding:14px 20px;border-top:1px solid #f1efe8;background:#fcfaf6;justify-content:flex-end}
.msg-luxury{padding:10px 14px;border-radius:12px;font-size:.82rem;font-weight:600;margin-top:12px}.msg-error{background:#fef2f2;color:#991b1b;border:1px solid #fecaca}.msg-success{background:#ecfdf5;color:#065f46;border:1px solid #a7f3d0}
.loading-luxury{text-align:center;padding:60px 20px;color:#6b7280}.loader-luxury{width:40px;height:40px;border:3px solid #f1efe8;border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin:0 auto 12px}@@keyframes spin{to{transform:rotate(360deg)}}
.empty-luxury{text-align:center;padding:60px 20px;background:#fff;border-radius:18px;border:1px solid #e8e2d0}.empty-icon-luxury{width:56px;height:56px;margin:0 auto 12px;border-radius:14px;background:rgba(212,175,55,.06);border:1px solid rgba(212,175,55,.1);display:flex;align-items:center;justify-content:center;color:var(--gold-dark)}.empty-icon-luxury svg{width:28px;height:28px}.empty-sub{color:#9ca3af;font-size:.82rem;margin-top:6px}.no-access-luxury{text-align:center;padding:80px 20px;background:#fff;border-radius:20px;border:1px solid #e8e2d0}
.toast-luxury{position:fixed;bottom:20px;left:20px;z-index:1050;animation:toastIn .35s ease}.toast-card-luxury{display:flex;align-items:center;gap:10px;padding:12px 18px;border-radius:14px;min-width:280px;font-weight:600;font-size:.84rem;box-shadow:0 12px 32px rgba(0,0,0,.12)}.toast-card-luxury.success{background:#ecfdf5;border:1px solid #a7f3d0;color:#065f46}.toast-card-luxury.error{background:#fef2f2;border:1px solid #fecaca;color:#991b1b}.toast-card-luxury button{background:none;border:none;cursor:pointer;color:inherit;opacity:.6;margin-right:auto}
@@keyframes modalIn{from{opacity:0;transform:scale(.96) translateY(10px)}to{opacity:1;transform:scale(1) translateY(0)}}@@keyframes toastIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
</style>

@code {
    private List<CostCenterListDto> roots = new();
    private List<CostCenterListDto> flatList = new();
    private List<CostCenterListDto> filteredRoots = new();
    private List<CostCenterListDto> filteredFlat = new();
    private int totalCount = 0;
    private int filteredCount = 0;
    private bool isLoading = true;
    private bool showEdit = false;
    private CostCenterDto editDto = new();
    private bool isSaving = false;
    private string editMsg = "";
    private bool editOk = true;
    private string toast = "";
    private bool toastOk = true;
    private string searchText = "";
    private int viewMode = 0;
    private HashSet<int> expandedIds = new();
    private bool isAllExpanded = true;
    private CostCenterListDto? selected = null;
    private List<LookupDto> departments = new();

    protected override async Task OnInitializedAsync(){ await LoadData(); }

    private async Task LoadData()
    {
        isLoading=true; StateHasChanged();
        try
        {
            roots = await TreasuryService.GetCostCentersTreeAsync();
            flatList = await TreasuryService.GetCostCentersFlatAsync();
            totalCount = CountAll(roots);
            expandedIds = new HashSet<int>(flatList.Where(c=>c.CenterLevel<=2).Select(c=>c.CostCenterID));
            if (flatList.Any()) selected = FindNode(roots, flatList.First().CostCenterID);
            departments = await LookupService.GetDepartmentsAsync();
            ApplyFilter();
        }
        catch(Exception ex){ toast="خطأ: "+ex.Message; toastOk=false; }
        finally{ isLoading=false; }
    }

    private void ApplyFilter()
    {
        bool Matches(CostCenterListDto c){ if(string.IsNullOrWhiteSpace(searchText)) return true; return (c.CostCenterCode?.Contains(searchText,StringComparison.OrdinalIgnoreCase)??false) || (c.CostCenterNameAr?.Contains(searchText,StringComparison.OrdinalIgnoreCase)??false); }
        bool HasMatch(CostCenterListDto n){ if(Matches(n)) return true; foreach(var ch in n.Children) if(HasMatch(ch)) return true; return false; }
        List<CostCenterListDto> FilterNodes(List<CostCenterListDto> nodes){
            var res=new List<CostCenterListDto>();
            foreach(var node in nodes){
                if(!HasMatch(node)) continue;
                var clone=new CostCenterListDto{ CostCenterID=node.CostCenterID, CostCenterCode=node.CostCenterCode, CostCenterNameAr=node.CostCenterNameAr, CostCenterNameEn=node.CostCenterNameEn, ParentCostCenterID=node.ParentCostCenterID, CenterLevel=node.CenterLevel, DepartmentID=node.DepartmentID, DepartmentNameAr=node.DepartmentNameAr, IsActive=node.IsActive, ChildrenCount=node.ChildrenCount };
                clone.Children=FilterNodes(node.Children);
                res.Add(clone);
            }
            return res;
        }
        filteredRoots=FilterNodes(roots);
        filteredFlat=flatList.Where(Matches).ToList();
        filteredCount=CountAll(filteredRoots);
        if(!string.IsNullOrWhiteSpace(searchText)){ var all=new HashSet<int>(); void Collect(List<CostCenterListDto> ns){ foreach(var n in ns){ all.Add(n.CostCenterID); Collect(n.Children);} } Collect(filteredRoots); expandedIds=all; isAllExpanded=true; }
    }

    private int CountAll(List<CostCenterListDto> nodes){ int c=0; foreach(var n in nodes){ c++; c+=CountAll(n.Children);} return c; }
    private void ClearSearch(){ searchText=""; ApplyFilter(); }
    private void ToggleExpand(int id){ if(expandedIds.Contains(id)) expandedIds.Remove(id); else expandedIds.Add(id); }
    private void ToggleAll(){ if(isAllExpanded){ expandedIds.Clear(); isAllExpanded=false; } else { expandedIds=new HashSet<int>(flatList.Select(c=>c.CostCenterID)); isAllExpanded=true; } }
    private void Select(int id){ selected=FindNode(roots, id); }
    private CostCenterListDto? FindNode(List<CostCenterListDto> nodes, int id){ foreach(var n in nodes){ if(n.CostCenterID==id) return n; var f=FindNode(n.Children,id); if(f!=null) return f; } return null; }

    private RenderFragment RenderTreeNode(CostCenterListDto cc, int level) => __builder =>
    {
        bool isExpanded = expandedIds.Contains(cc.CostCenterID);
        bool hasChildren = cc.Children.Any();
        bool isSelected = selected?.CostCenterID==cc.CostCenterID;
        <div>
            <div class="tree-node @(isSelected?"selected":"")" style="margin-right:@(level*16)px" @onclick="()=>Select(cc.CostCenterID)" @key="cc.CostCenterID">
                @if(hasChildren){<button class="tree-expand @(isExpanded?"expanded":"")" @onclick:stopPropagation="true" @onclick="()=>ToggleExpand(cc.CostCenterID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg></button>}else{<div style="width:22px;flex-shrink:0"></div>}
                <div class="tree-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div>
                <span class="tree-code">@cc.CostCenterCode</span>
                <span class="tree-name">@cc.CostCenterNameAr</span>
                @if(!hasChildren){<span class="tree-dot detail"></span>}else{<span class="tree-dot group"></span>}
            </div>
            @if(hasChildren && isExpanded){ @foreach(var child in cc.Children){ @RenderTreeNode(child, level+1) } }
        </div>;
    };

    private void ShowAddRoot(){ editDto=new CostCenterDto{ IsActive=true, CenterLevel=1 }; editMsg=""; showEdit=true; }
    private void ShowAddChild(int parentId){ var p=flatList.FirstOrDefault(c=>c.CostCenterID==parentId); editDto=new CostCenterDto{ IsActive=true, ParentCostCenterID=parentId, CenterLevel=(p?.CenterLevel??0)+1 }; editMsg=""; showEdit=true; }
    private async Task ShowEdit(int id){ var dto=await TreasuryService.GetCostCenterByIdAsync(id); if(dto!=null){ editDto=dto; editMsg=""; showEdit=true; } }
    private void CloseEdit(){ showEdit=false; }

    private async Task Save()
    {
        if(string.IsNullOrWhiteSpace(editDto.CostCenterNameAr)){ editMsg="أدخل الاسم"; editOk=false; return; }
        isSaving=true; StateHasChanged();
        try
        {
            if(editDto.CostCenterID==0){ await TreasuryService.InsertCostCenterAsync(editDto, UserSession.UserID); toast="تم إنشاء المركز ✅"; toastOk=true; }
            else{ await TreasuryService.UpdateCostCenterAsync(editDto, UserSession.UserID); toast="تم تحديث المركز ✅"; toastOk=true; }
            showEdit=false; await LoadData();
        }
        catch(Exception ex){ editMsg=ex.Message; editOk=false; }
        finally{ isSaving=false; }
    }
}
