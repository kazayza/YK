@code {
    [Parameter] public int Id { get; set; }

    private bool _authorized = false;
    private bool _isNew => Id == 0;
    private bool _saving = false;
    private string _message = "";
    private bool _isError = false;
    private int _activeTab = 1;

    private RoleEditDto _dto = new();
    private List<RolePermissionEditDto> _permissions = new();
    private List<LookupDto> _rolesForCopy = new();
    private int _copyFromRoleId = 0;
    private HashSet<int> _expandedModules = new();

    // ══════════════════════════════════════
    // التهيئة
    // ══════════════════════════════════════
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!UserSession.IsLoggedIn)
            {
                var restored = await UserSession.TryRestoreSessionAsync();
                if (!restored) { Navigation.NavigateTo("/login"); return; }
                if (!PermissionService.IsLoaded)
                    await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            }

            if (_isNew && !PermissionService.CanAdd("SCR_ROLES"))
            { Navigation.NavigateTo("/access-denied"); return; }

            if (!_isNew && !PermissionService.CanEdit("SCR_ROLES"))
            { Navigation.NavigateTo("/access-denied"); return; }

            _authorized = true;

            if (!_isNew)
            {
                await LoadRole();
                await LoadPermissions();
                _rolesForCopy = await RoleService.GetRolesForCopyAsync(Id);
            }

            StateHasChanged();
        }
    }

    // ══════════════════════════════════════
    // تحميل البيانات
    // ══════════════════════════════════════
    private async Task LoadRole()
    {
        try
        {
            var role = await RoleService.GetByIdAsync(Id);
            if (role == null) { ShowError("الدور غير موجود"); return; }
            _dto = role;
        }
        catch (Exception ex) { ShowError("خطأ: " + ex.Message); }
    }

    private async Task LoadPermissions()
    {
        try
        {
            _permissions = await RoleService.GetPermissionsAsync(Id);
            // توسيع كل الموديولات افتراضياً
            _expandedModules = new HashSet<int>(
                _permissions.Where(p => p.ModuleType == 1).Select(p => p.ModuleID));
        }
        catch (Exception ex) { ShowError("خطأ في تحميل الصلاحيات: " + ex.Message); }
    }

    // ══════════════════════════════════════
    // الحفظ الشامل
    // ══════════════════════════════════════
    private async Task SaveAll()
    {
        try
        {
            _saving = true;
            _message = "";
            StateHasChanged();

            // التحقق
            if (string.IsNullOrWhiteSpace(_dto.RoleCode))
            { ShowError("كود الدور مطلوب"); _activeTab = 1; return; }

            if (string.IsNullOrWhiteSpace(_dto.RoleNameAr))
            { ShowError("اسم الدور بالعربية مطلوب"); _activeTab = 1; return; }

            if (_isNew)
            {
                var newId = await RoleService.CreateAsync(_dto);
                ShowSuccess("تم إنشاء الدور بنجاح");
                await Task.Delay(500);
                Navigation.NavigateTo($"/roles/edit/{newId}");
            }
            else
            {
                // حفظ بيانات الدور
                await RoleService.UpdateAsync(_dto);

                // حفظ الصلاحيات
                if (_permissions.Any())
                    await RoleService.SavePermissionsAsync(Id, _permissions);

                ShowSuccess("تم حفظ الدور والصلاحيات بنجاح");
            }
        }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _saving = false; }
    }

    // ══════════════════════════════════════
    // عمليات الصلاحيات
    // ══════════════════════════════════════
    private IEnumerable<RolePermissionEditDto> GetParentModules() =>
        _permissions.Where(p => p.ModuleType == 1).OrderBy(p => p.SortOrder);

    private IEnumerable<RolePermissionEditDto> GetChildModules(int parentId) =>
        _permissions.Where(p => p.ParentModuleID == parentId && p.ModuleType != 1).OrderBy(p => p.SortOrder);

    private void ToggleExpand(int moduleId)
    {
        if (_expandedModules.Contains(moduleId))
            _expandedModules.Remove(moduleId);
        else
            _expandedModules.Add(moduleId);
    }

    private void SelectRow(RolePermissionEditDto perm, bool value)
    {
        perm.CanView = value;
        perm.CanAdd = value;
        perm.CanEdit = value;
        perm.CanDelete = value;
        perm.CanPrint = value;
        perm.CanExport = value;
        perm.CanApprove = value;
        perm.CanPost = value;
        perm.CanCancel = value;
    }

    private void SelectModule(int parentId, bool value)
    {
        foreach (var child in GetChildModules(parentId))
            SelectRow(child, value);
    }

    private void SelectAll()
    {
        foreach (var perm in _permissions.Where(p => p.ModuleType != 1))
            SelectRow(perm, true);
    }

    private void DeselectAll()
    {
        foreach (var perm in _permissions.Where(p => p.ModuleType != 1))
            SelectRow(perm, false);
    }

    private async Task CopyPermissions()
    {
        if (_copyFromRoleId == 0) return;

        try
        {
            await RoleService.CopyPermissionsAsync(_copyFromRoleId, Id);
            await LoadPermissions();
            _copyFromRoleId = 0;
            ShowSuccess("تم نسخ الصلاحيات بنجاح - اضغط حفظ لتثبيتها");
        }
        catch (Exception ex) { ShowError("خطأ في النسخ: " + ex.Message); }
    }

    // ══════════════════════════════════════
    // التنقل والرسائل
    // ══════════════════════════════════════
    private void GoBack() => Navigation.NavigateTo("/roles");
    private void ShowSuccess(string msg) { _message = msg; _isError = false; }
    private void ShowError(string msg) { _message = msg; _isError = true; }
}