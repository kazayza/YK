@page "/roles/new"
@page "/roles/edit/{Id:int}"
@using YKCoatings.Models
@using YKCoatings.Services
@inject RoleService RoleService
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation

@if (!_authorized)
{
    <div></div>
}
else
{
    <!-- ===== شريط العنوان ===== -->
    <div class="page-header">
        <div class="page-header-right">
            <button class="btn-back" @onclick="GoBack" title="رجوع">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5"/>
                    <path d="M12 19l7-7-7-7"/>
                </svg>
            </button>
            <h2 class="page-title">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="title-icon">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                @(_isNew ? "إضافة دور جديد" : "تعديل الدور")
            </h2>
            @if (!_isNew)
            {
                <span class="edit-badge">@_dto.RoleCode</span>
                @if (_dto.IsSystemRole)
                {
                    <span class="edit-badge system-badge">🔒 نظامي</span>
                }
            }
        </div>
        <div class="page-header-left">
            <button class="btn-action btn-cancel-page" @onclick="GoBack">
                <span>إلغاء</span>
            </button>
            <button class="btn-action btn-save-page" @onclick="SaveAll" disabled="@_saving">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                    <polyline points="17 21 17 13 7 13 7 21"/>
                    <polyline points="7 3 7 8 15 8"/>
                </svg>
                <span>@(_saving ? "جاري الحفظ..." : "حفظ الكل")</span>
            </button>
        </div>
    </div>

    <!-- ===== رسالة ===== -->
    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert-msg @(_isError ? "alert-error" : "alert-success")">
            <span>@_message</span>
            <button class="alert-close" @onclick="@(() => _message = "")">✕</button>
        </div>
    }

    <!-- ===== التبويبات ===== -->
    <div class="tabs-header">
        <button class="tab-btn @(_activeTab == 1 ? "active" : "")" @onclick="@(() => _activeTab = 1)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>بيانات الدور</span>
        </button>
        @if (!_isNew)
        {
            <button class="tab-btn @(_activeTab == 2 ? "active" : "")" @onclick="@(() => _activeTab = 2)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <path d="M9 12l2 2 4-4"/>
                </svg>
                <span>مصفوفة الصلاحيات</span>
                @if (_permissions.Any())
                {
                    <span class="tab-count">@_permissions.Count(p => p.CanView)</span>
                }
            </button>
        }
    </div>

    <!-- ===== محتوى التبويبات ===== -->
    <div class="tab-content">

        <!-- ────────── تبويب 1: بيانات الدور ────────── -->
        @if (_activeTab == 1)
        {
            <div class="form-card">
                <div class="form-card-title">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    </svg>
                    بيانات الدور
                </div>

                <div class="form-grid">

                    <!-- كود الدور -->
                    <div class="form-group">
                        <label class="form-label">كود الدور <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_dto.RoleCode"
                               placeholder="مثال: SALE_MGR" 
                               disabled="@(_dto.IsSystemRole && !_isNew)" />
                    </div>

                    <!-- اسم الدور بالعربية -->
                    <div class="form-group">
                        <label class="form-label">اسم الدور بالعربية <span class="required">*</span></label>
                        <input type="text" class="form-input" @bind="_dto.RoleNameAr"
                               placeholder="مثال: مدير المبيعات" />
                    </div>

                    <!-- اسم الدور بالإنجليزية -->
                    <div class="form-group">
                        <label class="form-label">اسم الدور بالإنجليزية</label>
                        <input type="text" class="form-input" @bind="_dto.RoleNameEn"
                               placeholder="مثال: Sales Manager" />
                    </div>

                    <!-- نشط -->
                    <div class="form-group">
                        <label class="form-label">الحالة</label>
                        <div class="toggle-wrap">
                            <label class="toggle-label">
                                <input type="checkbox" @bind="_dto.IsActive"
                                       disabled="@_dto.IsSystemRole" />
                                <span class="toggle-switch"></span>
                                <span class="toggle-text">@(_dto.IsActive ? "نشط" : "غير نشط")</span>
                            </label>
                        </div>
                    </div>

                    <!-- الوصف -->
                    <div class="form-group form-full">
                        <label class="form-label">الوصف</label>
                        <textarea class="form-input form-textarea" @bind="_dto.Description"
                                  placeholder="وصف صلاحيات هذا الدور..." rows="3"></textarea>
                    </div>

                </div>
            </div>

            @if (_isNew)
            {
                <div class="info-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 16v-4"/>
                        <path d="M12 8h.01"/>
                    </svg>
                    <span>بعد حفظ الدور ستتمكن من تعديل صلاحياته في تبويب "مصفوفة الصلاحيات"</span>
                </div>
            }
        }
                <!-- ────────── تبويب 2: مصفوفة الصلاحيات ────────── -->
        @if (_activeTab == 2 && !_isNew)
        {
            <div class="form-card perm-card">

                <!-- شريط أدوات الصلاحيات -->
                <div class="perm-toolbar">
                    <div class="perm-toolbar-right">
                        <div class="form-card-title" style="margin:0;padding:0;border:none">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2"/>
                                <path d="M9 12l2 2 4-4"/>
                            </svg>
                            مصفوفة الصلاحيات
                        </div>
                    </div>
                    <div class="perm-toolbar-left">
                        <!-- نسخ من دور آخر -->
                        <div class="copy-from-wrap">
                            <select class="filter-input copy-select" @bind="_copyFromRoleId">
                                <option value="0">— نسخ من دور —</option>
                                @foreach (var r in _rolesForCopy)
                                {
                                    <option value="@r.Id">@r.Name</option>
                                }
                            </select>
                            <button class="btn-copy" @onclick="CopyPermissions"
                                    disabled="@(_copyFromRoleId == 0)" title="نسخ الصلاحيات">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <rect x="9" y="9" width="13" height="13" rx="2"/>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
                                </svg>
                                <span>نسخ</span>
                            </button>
                        </div>

                        <!-- تحديد/إلغاء الكل -->
                        <button class="btn-toolbar" @onclick="SelectAll" title="تحديد الكل">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2"/>
                                <path d="M9 12l2 2 4-4"/>
                            </svg>
                            <span>تحديد الكل</span>
                        </button>
                        <button class="btn-toolbar btn-toolbar-danger" @onclick="DeselectAll" title="إلغاء الكل">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="3" width="18" height="18" rx="2"/>
                                <line x1="9" y1="9" x2="15" y2="15"/>
                                <line x1="15" y1="9" x2="9" y2="15"/>
                            </svg>
                            <span>إلغاء الكل</span>
                        </button>
                    </div>
                </div>

                <!-- جدول الصلاحيات -->
                <div class="perm-table-wrap">
                    <table class="perm-table">
                        <thead>
                            <tr>
                                <th class="perm-th-module">الشاشة</th>
                                <th class="perm-th-check">عرض</th>
                                <th class="perm-th-check">إضافة</th>
                                <th class="perm-th-check">تعديل</th>
                                <th class="perm-th-check">حذف</th>
                                <th class="perm-th-check">طباعة</th>
                                <th class="perm-th-check">تصدير</th>
                                <th class="perm-th-check">اعتماد</th>
                                <th class="perm-th-check">ترحيل</th>
                                <th class="perm-th-check">إلغاء</th>
                                <th class="perm-th-check">الكل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var module in GetParentModules())
                            {
                                var children = GetChildModules(module.ModuleID);
                                var isExpanded = _expandedModules.Contains(module.ModuleID);

                                <!-- سطر الموديول الرئيسي -->
                                <tr class="perm-row-parent">
                                    <td class="perm-td-module">
                                        <button class="perm-expand-btn" @onclick="@(() => ToggleExpand(module.ModuleID))">
                                            @if (isExpanded)
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M6 9l6 6 6-6"/>
                                                </svg>
                                            }
                                            else
                                            {
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M15 18l-6-6 6-6"/>
                                                </svg>
                                            }
                                        </button>
                                        <span class="perm-module-icon">📁</span>
                                        <span class="perm-module-name parent-name">@module.ModuleNameAr</span>
                                    </td>
                                    <!-- Select All لكل الموديول -->
                                    <td colspan="9" class="perm-td-parent-actions">
                                        <button class="btn-select-module" @onclick="@(() => SelectModule(module.ModuleID, true))">
                                            تحديد الكل
                                        </button>
                                        <button class="btn-deselect-module" @onclick="@(() => SelectModule(module.ModuleID, false))">
                                            إلغاء الكل
                                        </button>
                                    </td>
                                    <td></td>
                                </tr>

                                <!-- الشاشات الفرعية -->
                                @if (isExpanded)
                                {
                                    @foreach (var child in children)
                                    {
                                        <tr class="perm-row-child">
                                            <td class="perm-td-module perm-td-child">
                                                <span class="perm-child-indent"></span>
                                                <span class="perm-module-icon">📄</span>
                                                <span class="perm-module-name">@child.ModuleNameAr</span>
                                            </td>
                                            <td class="perm-td-check">
                                                <label class="perm-check">
                                                    <input type="checkbox" @bind="child.CanView" />
                                                    <span class="perm-checkmark"></span>
                                                </label>
                                            </td>
                                            <td class="perm-td-check">
                                                <label class="perm-check">
                                                    <input type="checkbox" @bind="child.CanAdd" />
                                                    <span class="perm-checkmark"></span>
                                                </label>
                                            </td>
                                            <td class="perm-td-check">
                                                <label class="perm-check">
                                                    <input type="checkbox" @bind="child.CanEdit" />
                                                    <span class="perm-checkmark"></span>
                                                </label>
                                            </td>
                                            <td class="perm-td-check">
                                                <label class="perm-check">
                                                    <input type="checkbox" @bind="child.CanDelete" />
                                                    <span class="perm-checkmark"></span>
                                                </label>
                                            </td>
                                            <td class="perm-td-check">
                                                <label class="perm-check">
                                                    <input type="checkbox" @bind="child.CanPrint" />
                                                    <span class="perm-checkmark"></span>
                                                </label>
                                            </td>
                                            <td class="perm-td-check">
                                                <label class="perm-check">
                                                    <input type="checkbox" @bind="child.CanExport" />
                                                    <span class="perm-checkmark"></span>
                                                </label>
                                            </td>
                                            <td class="perm-td-check">
                                                <label class="perm-check">
                                                    <input type="checkbox" @bind="child.CanApprove" />
                                                    <span class="perm-checkmark"></span>
                                                </label>
                                            </td>
                                            <td class="perm-td-check">
                                                <label class="perm-check">
                                                    <input type="checkbox" @bind="child.CanPost" />
                                                    <span class="perm-checkmark"></span>
                                                </label>
                                            </td>
                                            <td class="perm-td-check">
                                                <label class="perm-check">
                                                    <input type="checkbox" @bind="child.CanCancel" />
                                                    <span class="perm-checkmark"></span>
                                                </label>
                                            </td>
                                            <td class="perm-td-check">
                                                <button class="btn-row-all" @onclick="@(() => SelectRow(child, true))" title="تحديد السطر">✓</button>
                                                <button class="btn-row-none" @onclick="@(() => SelectRow(child, false))" title="إلغاء السطر">✕</button>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        }

    </div> <!-- نهاية tab-content -->

} <!-- نهاية else الخاص بـ _authorized -->
<style>
    /* ===== Page Header ===== */
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px; }
    .page-header-right { display: flex; align-items: center; gap: 12px; }
    .page-header-left { display: flex; align-items: center; gap: 8px; }
    .page-title { font-size: 1.2rem; font-weight: 800; color: #0f172a; display: flex; align-items: center; gap: 10px; margin: 0; }
    .title-icon { width: 26px; height: 26px; color: #2563eb; }
    .edit-badge { background: #eff6ff; color: #1d4ed8; padding: 4px 12px; border-radius: 8px; font-size: .78rem; font-weight: 700; border: 1px solid #bfdbfe; }
    .system-badge { background: #fffbeb; color: #b45309; border-color: #fde68a; }
    .btn-back { width: 40px; height: 40px; border: 1px solid #e2e8f0; background: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all .2s; }
    .btn-back:hover { background: #f1f5f9; }
    .btn-back svg { width: 18px; height: 18px; color: #475569; }
    .btn-action { display: inline-flex; align-items: center; gap: 6px; padding: 10px 20px; border: none; border-radius: 10px; font-size: .84rem; font-weight: 700; cursor: pointer; transition: all .2s; }
    .btn-action svg { width: 16px; height: 16px; }
    .btn-save-page { background: linear-gradient(135deg, #2563eb, #2563eb); color: white; box-shadow: 0 4px 12px rgba(37,99,235,.3); }
    .btn-save-page:hover { transform: translateY(-1px); }
    .btn-save-page:disabled { opacity: .6; cursor: not-allowed; transform: none; }
    .btn-cancel-page { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }

    /* ===== Alerts ===== */
    .alert-msg { display: flex; justify-content: space-between; align-items: center; padding: 12px 18px; border-radius: 10px; margin-bottom: 16px; font-size: .85rem; font-weight: 600; }
    .alert-success { background: #f0fdf4; color: #166534; border: 1px solid #bbf7d0; }
    .alert-error { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }
    .alert-close { background: none; border: none; cursor: pointer; color: inherit; opacity: .6; }

    /* ===== Tabs ===== */
    .tabs-header { display: flex; gap: 4px; background: white; border-radius: 14px 14px 0 0; padding: 6px 6px 0; border: 1px solid #e2e8f0; border-bottom: none; overflow-x: auto; }
    .tab-btn { display: flex; align-items: center; gap: 8px; padding: 12px 20px; border: none; background: transparent; color: #64748b; font-size: .84rem; font-weight: 700; border-radius: 10px 10px 0 0; cursor: pointer; transition: all .2s; white-space: nowrap; border-bottom: 3px solid transparent; }
    .tab-btn:hover { background: #f8fafc; color: #334155; }
    .tab-btn.active { background: #f8fafc; color: #2563eb; border-bottom-color: #2563eb; }
    .tab-btn svg { width: 16px; height: 16px; }
    .tab-count { background: #2563eb; color: white; padding: 1px 7px; border-radius: 10px; font-size: .68rem; font-weight: 800; }

    /* ===== Form Card ===== */
    .form-card { background: white; border-radius: 0 0 14px 14px; padding: 24px; border: 1px solid #e2e8f0; border-top: none; box-shadow: 0 2px 8px rgba(15,23,42,.06); }
    .perm-card { padding: 0; overflow: hidden; }
    .form-card-title { display: flex; align-items: center; gap: 10px; font-size: .95rem; font-weight: 800; color: #0f172a; margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid #f1f5f9; }
    .form-card-title svg { width: 20px; height: 20px; color: #2563eb; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-full { grid-column: 1 / -1; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-label { font-size: .8rem; font-weight: 700; color: #475569; }
    .required { color: #dc2626; }
    .form-input { height: 42px; border: 1px solid #e2e8f0; border-radius: 10px; padding: 0 14px; font-size: .85rem; background: #f8fafc; transition: all .2s; width: 100%; }
    .form-input:focus { border-color: #2563eb; background: white; outline: none; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
    .form-input:disabled { background: #f1f5f9; color: #94a3b8; cursor: not-allowed; }
    .form-textarea { height: auto; padding: 12px 14px; resize: vertical; min-height: 80px; }

    /* ===== Toggle ===== */
    .toggle-wrap { display: flex; align-items: center; height: 42px; }
    .toggle-label { display: flex; align-items: center; gap: 10px; cursor: pointer; font-size: .84rem; color: #334155; }
    .toggle-label input { display: none; }
    .toggle-switch { width: 44px; height: 24px; background: #cbd5e1; border-radius: 12px; position: relative; transition: background .2s; flex-shrink: 0; }
    .toggle-switch::after { content: ''; position: absolute; width: 18px; height: 18px; background: white; border-radius: 50%; top: 3px; right: 3px; transition: transform .2s; box-shadow: 0 1px 3px rgba(0,0,0,.15); }
    .toggle-label input:checked + .toggle-switch { background: #2563eb; }
    .toggle-label input:checked + .toggle-switch::after { transform: translateX(-20px); }
    .toggle-text { font-weight: 600; }

    /* ===== Info Note ===== */
    .info-note { display: flex; align-items: center; gap: 10px; margin-top: 16px; padding: 14px 18px; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 10px; font-size: .84rem; color: #1d4ed8; font-weight: 600; }
    .info-note svg { width: 18px; height: 18px; flex-shrink: 0; }

    /* ===== Permissions Toolbar ===== */
    .perm-toolbar { display: flex; justify-content: space-between; align-items: center; padding: 16px 20px; border-bottom: 1px solid #e2e8f0; background: #f8fafc; flex-wrap: wrap; gap: 12px; }
    .perm-toolbar-right { display: flex; align-items: center; gap: 10px; }
    .perm-toolbar-left { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .copy-from-wrap { display: flex; gap: 6px; align-items: center; }
    .copy-select { height: 36px; font-size: .8rem; min-width: 180px; padding: 0 10px; }
    .btn-copy { display: inline-flex; align-items: center; gap: 4px; height: 36px; padding: 0 14px; background: #eff6ff; color: #2563eb; border: 1px solid #bfdbfe; border-radius: 8px; font-size: .78rem; font-weight: 700; cursor: pointer; transition: all .2s; }
    .btn-copy:hover { background: #dbeafe; }
    .btn-copy:disabled { opacity: .5; cursor: not-allowed; }
    .btn-copy svg { width: 14px; height: 14px; }
    .btn-toolbar { display: inline-flex; align-items: center; gap: 4px; height: 36px; padding: 0 12px; background: white; color: #475569; border: 1px solid #e2e8f0; border-radius: 8px; font-size: .76rem; font-weight: 700; cursor: pointer; transition: all .2s; }
    .btn-toolbar:hover { background: #f1f5f9; }
    .btn-toolbar svg { width: 14px; height: 14px; }
    .btn-toolbar-danger { color: #dc2626; border-color: #fecaca; }
    .btn-toolbar-danger:hover { background: #fef2f2; }

    /* ===== Permissions Table ===== */
    .perm-table-wrap {
    overflow-x: auto;
    max-height: 70vh;
    overflow-y: auto;
}
    .perm-table { width: 100%; border-collapse: collapse; min-width: 900px; }
    .perm-table thead {
    background: #f1f5f9;
    border-bottom: 2px solid #e2e8f0;
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(15,23,42,.08);
}
    .perm-table th {
    padding: 14px 10px;
    font-size: .82rem;
    font-weight: 800;
    color: #334155;
    text-align: center;
    white-space: nowrap;
    background: #f1f5f9;
}
    .perm-th-module { text-align: right; padding-right: 16px; min-width: 220px; }
    .perm-th-check { width: 60px; }

    /* Parent Row */
    .perm-row-parent { background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
    .perm-row-parent td { padding: 10px 8px; }
    .perm-td-module { display: flex; align-items: center; gap: 8px; text-align: right; padding-right: 16px !important; }
    .perm-expand-btn { width: 28px; height: 28px; border: none; background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; color: #64748b; border-radius: 6px; transition: all .15s; }
    .perm-expand-btn:hover { background: #e2e8f0; }
    .perm-expand-btn svg { width: 16px; height: 16px; }
    .perm-module-icon { font-size: .9rem; }
    .perm-module-name { font-size: .88rem; font-weight: 600; color: #334155; }
    .parent-name { font-weight: 800; color: #0f172a; }
    .perm-td-parent-actions { text-align: center; }
    .btn-select-module, .btn-deselect-module { padding: 4px 10px; border: 1px solid #e2e8f0; background: white; border-radius: 6px; font-size: .7rem; font-weight: 700; cursor: pointer; margin: 0 2px; transition: all .15s; }
