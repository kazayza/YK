</style>
@code {
    [Parameter] public int InvoiceId { get; set; }

    private PurchaseInvoiceHeaderDto header = new() { InvoiceDate = DateTime.Today, ExchangeRate = 1 };
    private List<PurchaseInvoiceDetailDto> details = new();
    private ModulePermissionDto? permissions;

    private List<LookupDto>? paymentTerms, currencies, units;
    private List<SearchableItem>? suppliersSearchable, purchaseItems, availableGRNs;

    private List<GRNLineForInvoiceDto>? grnLines;
    private int selectedGRNId;
    private bool isGRNLoaded = false, isSourceLocked = false;

    private bool isLoading = true, isSaving = false;
    private string toast = ""; private bool toastOk = true;

    private bool showLineForm = false, isEditLine = false;
    private PurchaseInvoiceDetailEditDto editLine = new();
    private bool isSavingLine = false;
    private string lineMsg = ""; private bool lineMsgOk = true;

    private bool showRejectDialog = false;
    private string rejectReason = "", rejectMsg = "";

    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => InvoiceId == 0;
    private bool isApprovalMode => !isNewMode && !isViewMode && header.InvoiceStatus == 2 && (permissions?.CanApprove ?? false);
    private bool isReadOnly
    {
        get
        {
            if (isViewMode) return true;
            if (isNewMode) return false;
            return header.InvoiceStatus != 1;
        }
    }
    private string pageTitle => isNewMode ? "فاتورة مشتريات جديدة" : isViewMode ? "عرض فاتورة مشتريات" : isApprovalMode ? "اعتماد فاتورة مشتريات" : "تعديل فاتورة مشتريات";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
            if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_PINV");
            if (permissions == null || !permissions.CanView) return;
            await LoadLookups();
            if (InvoiceId > 0) await LoadInvoiceData();
            else
            {
                var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                var source = query["source"];
                if (source == "grn") { header.InvoiceSource = 1; availableGRNs = await LookupService.GetGRNsForInvoiceSearchableAsync(); }
                else if (source == "direct") { header.InvoiceSource = 3; isSourceLocked = true; }
            }
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isLoading = false; StateHasChanged(); }
    }

    private async Task LoadLookups()
    {
        paymentTerms = await LookupService.GetPaymentTermsAsync();
        currencies = await LookupService.GetCurrenciesAsync();
        units = await LookupService.GetUnitsAsync();
        suppliersSearchable = await LookupService.GetSuppliersSearchableAsync();
        purchaseItems = await LookupService.GetItemsForPurchaseSearchableAsync();
    }

    private async Task LoadInvoiceData()
    {
        var loaded = await InvService.GetInvoiceByIdAsync(InvoiceId);
        if (loaded != null) { header = loaded; details = await InvService.GetInvoiceDetailsAsync(InvoiceId); isSourceLocked = true; isGRNLoaded = true; }
        else { toast = "الفاتورة غير موجودة"; toastOk = false; }
    }

    private void SelectGRNSource()
    {
        header.InvoiceSource = 1;
        _ = Task.Run(async () => { availableGRNs = await LookupService.GetGRNsForInvoiceSearchableAsync(); await InvokeAsync(StateHasChanged); });
    }

    private void SelectDirectSource() { header.InvoiceSource = 3; isSourceLocked = true; grnLines = null; selectedGRNId = 0; }

    private async Task OnGRNSelected(SearchableItem? item)
{
    if (item == null || item.Id == 0)
    {
        grnLines = null;
        selectedGRNId = 0;
        return;
    }

    selectedGRNId = item.Id;
    header.GRNID = item.Id;

    try
    {
        // 1) تحميل سطور GRN
        grnLines = await LookupService.GetGRNLinesForInvoiceAsync(item.Id);
        foreach (var l in grnLines)
        {
            l.IsSelected = true;
            l.InvoiceUnitPrice = l.UnitCost;
            l.InvoiceTaxRate = 14;
        }

        // 2) جلب بيانات GRN (المورد + المخزن + أمر الشراء)
        var grnInfo = await LookupService.GetGRNQuickInfoAsync(item.Id);
            

        if (grnInfo != null)
        {
            header.SupplierID = grnInfo.SupplierID;
            header.SupplierNameAr = grnInfo.SupplierNameAr;

            if (grnInfo.PurchaseOrderID.HasValue)
                header.PurchaseOrderID = grnInfo.PurchaseOrderID;
        }

        // 3) جلب بيانات المورد كاملة (شروط الدفع + العملة + ...)
        if (header.SupplierID > 0)
        {
            var supplierInfo = await LookupService.GetSupplierQuickInfoAsync(header.SupplierID);
            if (supplierInfo != null)
            {
                header.SupplierNameAr = supplierInfo.SupplierNameAr;
                header.SupplierCode = supplierInfo.SupplierCode;

                // شروط الدفع
                if (supplierInfo.PaymentTermID.HasValue)
                    header.PaymentTermID = supplierInfo.PaymentTermID;

                // العملة
                if (supplierInfo.CurrencyID.HasValue)
                {
                    header.CurrencyID = supplierInfo.CurrencyID;
                    header.ExchangeRate = supplierInfo.ExchangeRate;
                }
            }
        }

        StateHasChanged();
    }
    catch (Exception ex)
    {
        toast = "خطأ في تحميل بيانات إذن الاستلام: " + ex.Message;
        toastOk = false;
        StateHasChanged();
    }
}

    private void ToggleAllGRNLines(ChangeEventArgs e) { if (grnLines == null) return; var val = (bool)(e.Value ?? false); foreach (var l in grnLines) l.IsSelected = val; }

    private async Task OnItemSelected(SearchableItem? item)
    {
        if (item == null) return;
        editLine.ItemID = item.Id;
        var info = await LookupService.GetItemQuickInfoAsync(item.Id);
        if (info != null) { if (info.UnitID > 0) editLine.UnitID = info.UnitID; if (info.EstimatedPrice > 0) editLine.UnitPrice = info.EstimatedPrice; }
        StateHasChanged();
    }

    private async Task SaveInvoice()
    {
        if (header.SupplierID <= 0) { toast = "اختر المورد"; toastOk = false; StateHasChanged(); return; }
        isSaving = true; StateHasChanged();
        try
        {
            if (isNewMode)
            {
                header.InvoiceNumber = await InvService.GenerateInvoiceNumberAsync();
                header.InvoiceStatus = 1;
                var newId = await InvService.InsertInvoiceAsync(header, UserSession.UserID);
                InvoiceId = newId; header.InvoiceID = newId;
                if (header.InvoiceSource == 1 && grnLines != null)
                {
                    var selected = grnLines.Where(l => l.IsSelected).ToList();
                    if (selected.Any()) { var imp = await InvService.ImportLinesFromGRNAsync(newId, header.GRNID ?? 0, selected, UserSession.UserID); toast = $"تم الإنشاء وتحميل {imp} صنف ✅"; }
                    else toast = $"تم الإنشاء: {header.InvoiceNumber} ✅";
                }
                else toast = $"تم الإنشاء: {header.InvoiceNumber} ✅";
                toastOk = true; isSourceLocked = true; isGRNLoaded = true;
                details = await InvService.GetInvoiceDetailsAsync(newId);
                header = await InvService.GetInvoiceByIdAsync(newId) ?? header;
                Navigation.NavigateTo($"/purchase-invoices/edit/{newId}", forceLoad: false);
            }
            else
            {
                await InvService.UpdateInvoiceAsync(header, UserSession.UserID);
                header = await InvService.GetInvoiceByIdAsync(InvoiceId) ?? header;
                details = await InvService.GetInvoiceDetailsAsync(InvoiceId);
                toast = "تم الحفظ ✅"; toastOk = true;
            }
        }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task SubmitForApproval()
    {
        if (!details.Any()) { toast = "أضف أصناف أولاً"; toastOk = false; StateHasChanged(); return; }
        isSaving = true; StateHasChanged();
        try { await InvService.SubmitForApprovalAsync(InvoiceId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID); header.InvoiceStatus = 2; toast = "تم الإرسال للاعتماد ✅"; toastOk = true; }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        finally { isSaving = false; StateHasChanged(); }
    }

    private async Task ExecuteApprove()
    {
        try { var c = await JS.InvokeAsync<bool>("confirm", "هل تريد اعتماد الفاتورة؟\n\nسيتم:\n• تحديث رصيد المورد\n• إنشاء القيد المحاسبي"); if (!c) return; } catch { return; }
        isSaving = true; toast = ""; StateHasChanged();
        try
        {
            await InvService.ApproveAsync(InvoiceId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            header = await InvService.GetInvoiceByIdAsync(InvoiceId) ?? header;
            details = await InvService.GetInvoiceDetailsAsync(InvoiceId);
            toast = "تم اعتماد الفاتورة ✅"; toastOk = true; isSaving = false; StateHasChanged();
            await Task.Delay(2000); Navigation.NavigateTo("/purchase-invoices");
        }
        catch (Exception ex) { isSaving = false; toast = "خطأ: " + ex.Message; toastOk = false; StateHasChanged(); }
    }

    private void DoShowReject() { rejectReason = ""; rejectMsg = ""; showRejectDialog = true; }
    private async Task ConfirmReject()
    {
        if (string.IsNullOrWhiteSpace(rejectReason)) { rejectMsg = "أدخل سبب الرفض"; return; }
        try
        {
            await InvService.RejectAsync(InvoiceId, rejectReason, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);
            header.InvoiceStatus = 1; header.RejectionReason = rejectReason; showRejectDialog = false;
            toast = "تم رفض الفاتورة"; toastOk = false; StateHasChanged();
            await Task.Delay(1500); Navigation.NavigateTo("/purchase-invoices");
        }
        catch (Exception ex) { rejectMsg = "خطأ: " + ex.Message; }
    }

    private void ShowAddLine() { isEditLine = false; editLine = new() { InvoiceID = InvoiceId, TaxRate = 14 }; lineMsg = ""; showLineForm = true; }
    private void ShowEditLine(PurchaseInvoiceDetailDto line)
    {
        isEditLine = true;
        editLine = new()
        {
            InvoiceDetailID = line.InvoiceDetailID, InvoiceID = line.InvoiceID,
            ItemID = line.ItemID, UnitID = line.UnitID, WarehouseID = line.WarehouseID,
            Quantity = line.Quantity, UnitPrice = line.UnitPrice,
            DiscountPercent = line.DiscountPercent, TaxRate = line.TaxRate,
            BatchNumber = line.BatchNumber, ExpiryDate = line.ExpiryDate,
            GRNDetailID = line.GRNDetailID, PODetailID = line.PODetailID, Notes = line.Notes
        };
        lineMsg = ""; showLineForm = true;
    }
    private void CloseLineForm() { showLineForm = false; lineMsg = ""; }

    private async Task SaveLine()
    {
        lineMsg = "";
        if (editLine.ItemID == 0) { lineMsg = "اختر الصنف"; lineMsgOk = false; return; }
        if (editLine.UnitID == 0) { lineMsg = "اختر الوحدة"; lineMsgOk = false; return; }
        if (editLine.Quantity <= 0) { lineMsg = "أدخل الكمية"; lineMsgOk = false; return; }
        if (isNewMode && InvoiceId == 0) { await SaveInvoice(); if (InvoiceId == 0) return; editLine.InvoiceID = InvoiceId; }
        isSavingLine = true; StateHasChanged();
        try
        {
            if (isEditLine) await InvService.UpdateDetailAsync(editLine, UserSession.UserID);
            else await InvService.InsertDetailAsync(editLine, UserSession.UserID);
            details = await InvService.GetInvoiceDetailsAsync(InvoiceId);
            header = await InvService.GetInvoiceByIdAsync(InvoiceId) ?? header;
            showLineForm = false; toast = isEditLine ? "تم التحديث ✅" : "تم الإضافة ✅"; toastOk = true;
        }
        catch (Exception ex) { lineMsg = "خطأ: " + ex.Message; lineMsgOk = false; }
        finally { isSavingLine = false; StateHasChanged(); }
    }

    private async Task DeleteLine(int detailId)
    {
        try { await InvService.DeleteDetailAsync(detailId, UserSession.UserID); details = await InvService.GetInvoiceDetailsAsync(InvoiceId); header = await InvService.GetInvoiceByIdAsync(InvoiceId) ?? header; toast = "تم الحذف ✅"; toastOk = true; }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; }
        StateHasChanged();
    }

    private async Task PrintDoc()
    {
        try { var html = await InvService.GenerateReportHtmlAsync(InvoiceId, UserSession.UserID); await JS.InvokeVoidAsync("printHtml", html); }
        catch (Exception ex) { toast = "خطأ: " + ex.Message; toastOk = false; StateHasChanged(); }
    }

    private void GoBack() => Navigation.NavigateTo("/purchase-invoices");
}