@page "/purchase-invoices/new"
@page "/purchase-invoices/edit/{InvoiceId:int}"
@page "/purchase-invoices/view/{InvoiceId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject PurchaseInvoiceService InvService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{ <div class="no-access"><div class="na-icon">🔒</div><h4>يجب تسجيل الدخول</h4></div> }
else if (permissions == null || !permissions.CanView)
{ <div class="no-access"><div class="na-icon">⛔</div><h4>ليس لديك صلاحية</h4></div> }
else
{
    <div class="doc-page" dir="rtl">
        <div class="doc-header">
            <div class="doc-header-right">
                <button class="btn-m btn-ghost" @onclick="GoBack">→ رجوع</button>
                <div>
                    <h2 class="doc-title">@pageTitle</h2>
                    @if (!string.IsNullOrEmpty(header.InvoiceNumber))
                    {
                        <div class="doc-num-wrap">
                            <code class="doc-number">@header.InvoiceNumber</code>
                            <span class="status-chip" style="--sc:@PurchaseInvoiceService.GetStatusColor(header.InvoiceStatus)">
                                @PurchaseInvoiceService.GetStatusName(header.InvoiceStatus)
                            </span>
                            <span class="payment-chip" style="--pc:@PurchaseInvoiceService.GetPaymentStatusColor(header.PaymentStatus)">
                                @PurchaseInvoiceService.GetPaymentStatusName(header.PaymentStatus)
                            </span>
                        </div>
                    }
                </div>
            </div>
            <div class="doc-header-left">
                @if (permissions.CanPrint && InvoiceId > 0)
                { <button class="btn-m btn-outline" @onclick="PrintDoc">🖨️ طباعة</button> }
            </div>
        </div>

        @if (isApprovalMode)
        {
            <div class="approval-bar">
                <span class="approval-label">📄 فاتورة بانتظار اعتمادك</span>
                <button type="button" class="appr-btn appr-quick" @onclick="ExecuteApprove" disabled="@isSaving">
                    @if (isSaving) { <div class="btn-spin"></div> } else { <span>✅</span> } اعتماد
                </button>
                <button type="button" class="appr-btn appr-reject" @onclick="DoShowReject" disabled="@isSaving">❌ رفض</button>
            </div>
        }

        @if (isLoading)
        { <div class="loading-st"><div class="loader"></div><p>جاري التحميل...</p></div> }
        else
        {
            @if (isNewMode && !isSourceLocked)
            {
                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon purple">📄</div><h3 class="sec-title">مصدر الفاتورة</h3></div>
                    <div class="source-cards">
                        <div class="source-card @(header.InvoiceSource == 1 ? "active" : "")" @onclick="SelectGRNSource">
                            <div class="source-card-icon" style="background:#ecfeff;color:#0891b2;">📦</div>
                            <div class="source-card-title">من إذن استلام</div>
                            <div class="source-card-desc">فاتورة بناءً على إذن استلام معتمد</div>
                        </div>
                        <div class="source-card @(header.InvoiceSource == 3 ? "active" : "")" @onclick="SelectDirectSource">
                            <div class="source-card-icon" style="background:#fff7ed;color:#f97316;">✏️</div>
                            <div class="source-card-title">فاتورة مباشرة</div>
                            <div class="source-card-desc">فاتورة بدون إذن استلام</div>
                        </div>
                    </div>
                </div>
            }

            @if (header.InvoiceSource == 1 && isNewMode && !isGRNLoaded)
            {
                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon cyan">📦</div><h3 class="sec-title">اختيار إذن الاستلام</h3></div>
                    <div class="form-grid c2">
                        <div class="f-field">
                            <label class="f-label required">إذن الاستلام المعتمد</label>
                            <SearchableSelect Items="@availableGRNs" @bind-SelectedId="selectedGRNId"
                                              OnSelected="OnGRNSelected" Placeholder="ابحث برقم إذن الاستلام..." />
                        </div>
                    </div>
                    @if (grnLines != null && grnLines.Any())
                    {
                        <div style="margin-top:16px;">
                            <h4 style="font-weight:700;font-size:.88rem;margin-bottom:10px;">الأصناف المستلمة (@grnLines.Count(l => l.IsSelected) مختار)</h4>
                            <div class="tbl-card">
                                <table class="tbl">
                                    <thead>
                                        <tr>
                                            <th class="tc" style="width:40px;"><input type="checkbox" checked="@grnLines.All(l => l.IsSelected)" @onchange="ToggleAllGRNLines" /></th>
                                            <th>الكود</th><th>الصنف</th><th>الوحدة</th>
                                            <th class="tc">الكمية</th><th class="tl">التكلفة</th>
                                            <th class="tl">سعر الفاتورة</th><th class="tc">ضريبة %</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in grnLines)
                                        {
                                            <tr class="@(!line.IsSelected ? "tr-deselected" : "")">
                                                <td class="tc"><input type="checkbox" @bind="line.IsSelected" /></td>
                                                <td><code class="code-tag">@line.ItemCode</code></td>
                                                <td class="td-bold">@line.ItemNameAr</td>
                                                <td>@line.UnitName</td>
                                                <td class="tc">@((line.AcceptedQty ?? line.ReceivedQty).ToString("#,##0.##"))</td>
                                                <td class="tl num-cell">@line.UnitCost.ToString("#,##0.00")</td>
                                                <td class="tc"><input type="number" class="inline-input" @bind="line.InvoiceUnitPrice" step="0.01" disabled="@(!line.IsSelected)" /></td>
                                                <td class="tc"><input type="number" class="inline-input" style="width:70px" @bind="line.InvoiceTaxRate" step="0.01" disabled="@(!line.IsSelected)" /></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (header.InvoiceSource > 0 || !isNewMode)
            {
                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon blue">📝</div><h3 class="sec-title">بيانات الفاتورة</h3></div>
                    <div class="form-grid c4">
                        <div class="f-field"><label class="f-label">رقم الفاتورة</label><input type="text" class="f-input readonly" value="@(header.InvoiceNumber ?? "تلقائي")" disabled /></div>
                        <div class="f-field"><label class="f-label required">التاريخ</label><input type="date" class="f-input" @bind="header.InvoiceDate" disabled="@isReadOnly" /></div>
                        <div class="f-field">
                            <label class="f-label required">المورد</label>
                            @if (header.InvoiceSource == 1 && header.SupplierID > 0)
                            { <input type="text" class="f-input readonly" value="@header.SupplierNameAr" disabled /> }
                            else
                            { <SearchableSelect Items="@suppliersSearchable" @bind-SelectedId="header.SupplierID" Placeholder="اختر المورد..." IsDisabled="@isReadOnly" /> }
                        </div>
                        <div class="f-field"><label class="f-label">شروط الدفع</label>
                            <select class="f-input" @bind="header.PaymentTermID" disabled="@isReadOnly">
                                <option value="0">-- اختر --</option>
                                @if (paymentTerms != null) { @foreach (var pt in paymentTerms) { <option value="@pt.Id">@pt.Name</option> } }
                            </select>
                        </div>
                        <div class="f-field"><label class="f-label">رقم فاتورة المورد</label><input type="text" class="f-input" @bind="header.SupplierInvoiceNo" disabled="@isReadOnly" placeholder="رقم فاتورة المورد..." /></div>
                        <div class="f-field"><label class="f-label">تاريخ فاتورة المورد</label><input type="date" class="f-input" @bind="header.SupplierInvoiceDate" disabled="@isReadOnly" /></div>
                        <div class="f-field"><label class="f-label">العملة</label>
                            <select class="f-input" @bind="header.CurrencyID" disabled="@isReadOnly">
                                <option value="0">-- اختر --</option>
                                @if (currencies != null) { @foreach (var c in currencies) { <option value="@c.Id">@c.Name</option> } }
                            </select>
                        </div>
                        <div class="f-field"><label class="f-label">ملاحظات</label><input type="text" class="f-input" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات..." /></div>
                    </div>
                    @if (header.InvoiceStatus == 1 && !string.IsNullOrEmpty(header.RejectionReason))
                    { <div class="rejection-box">❌ <strong>سبب الرفض السابق:</strong> @header.RejectionReason</div> }
                </div>
            }

            @if ((header.InvoiceSource > 0 || !isNewMode) && (InvoiceId > 0 || isSourceLocked))
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon green">📦</div><h3 class="sec-title">أصناف الفاتورة</h3>
                        <span class="sec-badge">@details.Count صنف</span>
                        @if (!isReadOnly && !isApprovalMode && permissions.CanAdd)
                        { <button class="btn-m btn-primary btn-sm" @onclick="ShowAddLine" style="margin-right:auto;">+ إضافة صنف</button> }
                    </div>
                    @if (!details.Any() && !showLineForm)
                    { <div class="empty-lines"><p>لا توجد أصناف.</p></div> }
                    else
                    {
                        <div class="tbl-card">
                            <table class="tbl">
                                <thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="tc">الكمية</th><th class="tl">السعر</th><th class="tc">خصم%</th><th class="tc">ضريبة%</th><th class="tl">الإجمالي</th>
                                @if (!isReadOnly && !isApprovalMode) { <th class="tc">إجراءات</th> }</tr></thead>
                                <tbody>
                                    @{ int n = 0; }
                                    @foreach (var line in details)
                                    {
                                        n++;
                                        <tr><td class="td-n">@n</td><td><code class="code-tag">@line.ItemCode</code></td><td class="td-bold">@line.ItemNameAr</td><td>@line.UnitName</td>
                                        <td class="tc">@line.Quantity.ToString("#,##0.##")</td><td class="tl num-cell">@line.UnitPrice.ToString("#,##0.00")</td>
                                        <td class="tc">@line.DiscountPercent.ToString("#,##0.##")</td><td class="tc">@line.TaxRate.ToString("#,##0.##")</td>
                                        <td class="tl num-cell"><strong>@line.LineTotalWithTax.ToString("#,##0.00")</strong></td>
                                        @if (!isReadOnly && !isApprovalMode)
                                        {
                                            <td class="tc"><div class="line-actions">
                                                @if (permissions.CanEdit) { <button class="act-btn edit" @onclick="() => ShowEditLine(line)">✏️</button> }
                                                @if (permissions.CanDelete) { <button class="act-btn del" @onclick="() => DeleteLine(line.InvoiceDetailID)">🗑️</button> }
                                            </div></td>
                                        }
                                        </tr>
                                    }
                                </tbody>
                                <tfoot><tr class="total-row"><td colspan="8" class="tl"><strong>الإجمالي</strong></td><td class="tl num-cell"><strong>@details.Sum(d => d.LineTotalWithTax).ToString("#,##0.00")</strong></td>
                                @if (!isReadOnly && !isApprovalMode) { <td></td> }</tr></tfoot>
                            </table>
                        </div>
                    }

                    @if (showLineForm)
                    {
                        <div class="line-form">
                            <div class="line-form-head"><h4>@(isEditLine ? "تعديل صنف" : "إضافة صنف")</h4><button class="btn-close-x" @onclick="CloseLineForm">✕</button></div>
                            <div class="form-grid c3">
                                <div class="f-field"><label class="f-label required">الصنف</label><SearchableSelect Items="@purchaseItems" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث..." IsDisabled="@isEditLine" /></div>
                                <div class="f-field"><label class="f-label required">الوحدة</label><select class="f-input" @bind="editLine.UnitID"><option value="0">-- اختر --</option>@if (units != null) { @foreach (var u in units) { <option value="@u.Id">@u.Name</option> } }</select></div>
                                <div class="f-field"><label class="f-label required">الكمية</label><input type="number" class="f-input" @bind="editLine.Quantity" step="0.01" /></div>
                                <div class="f-field"><label class="f-label required">سعر الوحدة</label><input type="number" class="f-input" @bind="editLine.UnitPrice" step="0.01" /></div>
                                <div class="f-field"><label class="f-label">خصم %</label><input type="number" class="f-input" @bind="editLine.DiscountPercent" step="0.01" /></div>
                                <div class="f-field"><label class="f-label">ضريبة %</label><input type="number" class="f-input" @bind="editLine.TaxRate" step="0.01" /></div>
                            </div>
                            <div class="line-calc-bar">
                                <span>قبل الضريبة: <strong>@editLine.LineTotal.ToString("#,##0.00")</strong></span>
                                <span>الضريبة: <strong>@editLine.TaxAmount.ToString("#,##0.00")</strong></span>
                                <span>الإجمالي: <strong>@editLine.LineTotalWithTax.ToString("#,##0.00")</strong></span>
                            </div>
                            @if (!string.IsNullOrEmpty(lineMsg)) { <div class="form-msg @(lineMsgOk ? "msg-ok" : "msg-err")">@lineMsg</div> }
                            <div class="line-form-btns">
                                <button class="btn-m btn-primary" @onclick="SaveLine" disabled="@isSavingLine">@if (isSavingLine) { <div class="btn-spin"></div> } @(isEditLine ? "تحديث" : "إضافة")</button>
                                <button class="btn-m btn-ghost" @onclick="CloseLineForm">إلغاء</button>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (!isReadOnly && !isApprovalMode && InvoiceId > 0 && details.Any())
            {
                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon orange">💰</div><h3 class="sec-title">التكاليف الإضافية</h3></div>
                    <div class="form-grid c3">
                        <div class="f-field"><label class="f-label">خصم عام %</label><input type="number" class="f-input" @bind="header.DiscountPercent" step="0.01" /></div>
                        <div class="f-field"><label class="f-label">تكلفة الشحن</label><input type="number" class="f-input" @bind="header.ShippingCost" step="0.01" /></div>
                        <div class="f-field"><label class="f-label">تكاليف أخرى</label><input type="number" class="f-input" @bind="header.OtherCosts" step="0.01" /></div>
                    </div>
                </div>
            }

            @if (InvoiceId > 0 && details.Any())
            {
                <div class="totals-bar">
                    <div class="total-item"><span class="total-label">الإجمالي الفرعي</span><span class="total-value">@header.SubTotal.ToString("#,##0.00")</span></div>
                    @if (header.DiscountAmount > 0) { <div class="total-item"><span class="total-label">الخصم</span><span class="total-value t-discount">- @header.DiscountAmount.ToString("#,##0.00")</span></div> }
                    <div class="total-item"><span class="total-label">الضريبة</span><span class="total-value">@header.TaxAmount.ToString("#,##0.00")</span></div>
                    <div class="total-item total-grand"><span class="total-label">الإجمالي</span><span class="total-value">@header.TotalAmount.ToString("#,##0.00") @(header.CurrencySymbol ?? "ج.م")</span></div>
                    @if (header.PaidAmount > 0) { <div class="total-item"><span class="total-label">المدفوع</span><span class="total-value">@header.PaidAmount.ToString("#,##0.00")</span></div> }
                    @if (header.RemainingAmount > 0) { <div class="total-item"><span class="total-label">المتبقي</span><span class="total-value" style="color:#dc2626">@header.RemainingAmount.ToString("#,##0.00")</span></div> }
                </div>
            }

            @if (!isViewMode && !isApprovalMode)
            {
                <div class="doc-actions">
                    <div class="doc-actions-right">
                        @if (!isReadOnly)
                        {
                            <button class="btn-m btn-primary" @onclick="SaveInvoice" disabled="@isSaving">@if (isSaving) { <div class="btn-spin"></div> } @(isNewMode ? "حفظ الفاتورة" : "حفظ التعديلات")</button>
                            @if (InvoiceId > 0 && header.InvoiceStatus == 1 && details.Any())
                            { <button class="btn-m btn-warning" @onclick="SubmitForApproval" disabled="@isSaving">📤 إرسال للاعتماد</button> }
                        }
                    </div>
                    <button class="btn-m btn-ghost" @onclick="GoBack">رجوع</button>
                </div>
            }
        }
    </div>

    @if (showRejectDialog)
    {
        <div class="modal-ov" @onclick="() => showRejectDialog = false">
            <div class="modal-box" @onclick:stopPropagation="true">
                <h4>رفض الفاتورة</h4><p>أدخل سبب الرفض:</p>
                <textarea class="f-input" rows="3" @bind="rejectReason" placeholder="سبب الرفض..."></textarea>
                @if (!string.IsNullOrEmpty(rejectMsg)) { <div class="form-msg msg-err">@rejectMsg</div> }
                <div class="modal-btns-row">
                    <button class="btn-m btn-danger-solid" @onclick="ConfirmReject">تأكيد الرفض</button>
                    <button class="btn-m btn-ghost" @onclick="() => showRejectDialog = false">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(toast))
    { <div class="toast-wrap"><div class="toast @(toastOk ? "t-ok" : "t-err")"><span>@toast</span><button @onclick='() => toast = ""'>✕</button></div></div> }
}
<style>
    .doc-page{display:flex;flex-direction:column;gap:18px;max-width:1200px}.doc-header{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:14px}.doc-header-right{display:flex;align-items:flex-start;gap:14px}.doc-header-left{display:flex;gap:8px}.doc-title{font-weight:800;color:#0f172a;margin:0;font-size:1.2rem}.doc-num-wrap{display:flex;align-items:center;gap:10px;margin-top:6px;flex-wrap:wrap}.doc-number{background:#f1f5f9;padding:4px 14px;border-radius:8px;font-size:.88rem;color:#2563eb;font-weight:700}.status-chip{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.75rem;font-weight:700;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc)}.payment-chip{display:inline-block;padding:4px 10px;border-radius:8px;font-size:.72rem;font-weight:700;background:color-mix(in srgb,var(--pc) 10%,white);color:var(--pc)}
    .approval-bar{display:flex;align-items:center;gap:8px;padding:10px 16px;background:linear-gradient(135deg,#ecfdf5,#f0fdf4);border:1.5px solid #a7f3d0;border-radius:14px;flex-wrap:wrap}.approval-label{display:flex;align-items:center;gap:6px;font-size:.82rem;font-weight:700;color:#065f46;padding-left:10px;border-left:2px solid #a7f3d0;margin-left:4px}.appr-btn{display:inline-flex;align-items:center;gap:6px;padding:9px 18px;border-radius:10px;border:none;font-weight:700;font-size:.84rem;cursor:pointer;transition:.2s}.appr-btn:disabled{opacity:.6;cursor:not-allowed}.appr-quick{background:linear-gradient(135deg,#059669,#10b981);color:white}.appr-reject{background:white;color:#dc2626;border:1.5px solid #fecaca}
    .source-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.source-card{padding:20px;border:2px solid #e2e8f0;border-radius:16px;cursor:pointer;transition:.2s;text-align:center}.source-card:hover{border-color:#2563eb;background:#f8fafc}.source-card.active{border-color:#2563eb;background:#eff6ff;box-shadow:0 0 0 3px rgba(37,99,235,.15)}.source-card-icon{width:48px;height:48px;border-radius:12px;display:inline-flex;align-items:center;justify-content:center;font-size:1.4rem;margin-bottom:10px}.source-card-title{font-weight:800;font-size:.92rem;color:#0f172a;margin-bottom:4px}.source-card-desc{font-size:.78rem;color:#64748b}
    .tr-deselected{opacity:.4}.inline-input{width:100px;padding:6px 8px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.82rem;text-align:center}.inline-input:focus{border-color:#2563eb}
    .doc-section{background:white;border:1px solid #e2e8f0;border-radius:18px;padding:22px;box-shadow:0 4px 16px rgba(15,23,42,.04)}.sec-head{display:flex;align-items:center;gap:12px;margin-bottom:20px;padding-bottom:14px;border-bottom:1px solid #f1f5f9;flex-wrap:wrap}.sec-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:1.2rem}.sec-icon.blue{background:#eff6ff}.sec-icon.green{background:#ecfdf5}.sec-icon.purple{background:#f5f3ff}.sec-icon.cyan{background:#ecfeff}.sec-icon.orange{background:#fff7ed}.sec-title{font-weight:800;color:#0f172a;margin:0;font-size:.98rem}.sec-badge{background:#f1f5f9;color:#475569;padding:4px 12px;border-radius:999px;font-size:.78rem;font-weight:700}
    .form-grid{display:grid;gap:14px}.c4{grid-template-columns:repeat(4,1fr)}.c3{grid-template-columns:repeat(3,1fr)}.c2{grid-template-columns:repeat(2,1fr)}.f-field{display:flex;flex-direction:column;gap:5px}.f-label{font-size:.8rem;font-weight:700;color:#334155}.required::after{content:' *';color:#ef4444}.f-input{padding:9px 12px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:.88rem;background:white;outline:none;transition:.2s;width:100%}.f-input:focus{border-color:#2563eb;box-shadow:0 0 0 3px rgba(37,99,235,.1)}.f-input.readonly,.f-input:disabled{background:#f8fafc;color:#64748b}
