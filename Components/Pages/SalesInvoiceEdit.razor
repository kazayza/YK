@page "/sales-invoices/new"
@page "/sales-invoices/edit/{InvoiceId:int}"
@page "/sales-invoices/view/{InvoiceId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject SalesInvoiceService InvService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div>}
else
{
    <div class="luxury-doc-page" dir="rtl">
        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <button class="btn-luxury btn-back-luxury" @onclick="GoBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19 7-7-7-7"/></svg>رجوع</button>
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">@pageTitle</h2><div class="lh-meta">@if (!string.IsNullOrEmpty(header.InvoiceNumber)){<code class="doc-num-luxury">@header.InvoiceNumber</code><span class="status-badge-luxury" style="--sc:@SalesInvoiceService.GetStatusColor(header.InvoiceStatus)">@SalesInvoiceService.GetStatusName(header.InvoiceStatus)</span><span class="status-badge-luxury" style="--sc:@SalesInvoiceService.GetPaymentStatusColor(header.PaymentStatus)">@SalesInvoiceService.GetPaymentStatusName(header.PaymentStatus)</span><span class="tax-badge-luxury @(header.IsTaxable?"yes":"no")">@(header.IsTaxable ? $"مع ضريبة {header.TaxRate:#,##0}%" : "بدون ضريبة")</span>}</div></div>
                </div>
                <div class="lh-actions">
                    <div class="workflow-mini"><span class="wm-dot done">عرض</span><span class="wm-line done"></span><span class="wm-dot done">أمر</span><span class="wm-line done"></span><span class="wm-dot active">فاتورة</span><span class="wm-line"></span><span class="wm-dot">مرتجع</span><span class="wm-line"></span><span class="wm-dot">قبض</span></div>
                    @if (permissions.CanPrint && InvoiceId > 0){<button class="btn-luxury btn-ghost-luxury" @onclick="PrintDoc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>طباعة</button>}
                </div>
            </div>
        </div>

        @if (isApprovalMode)
        {
            <div class="approval-bar-luxury"><div class="ml-gold-line green"></div><div class="appr-left"><div class="appr-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><div><div class="appr-title">فاتورة مبيعات بانتظار اعتمادك @(header.IsTaxable ? "مع ضريبة" : "بدون ضريبة")</div><div class="appr-sub">سيتم خصم المخزون + تحديث رصيد العميل + إنشاء القيد المحاسبي @(header.IsTaxable ? "مع ضريبة" : "معفاة")</div></div></div><div class="appr-actions"><button class="btn-luxury btn-approve-quick" @onclick="ExecuteApprove" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg>}اعتماد</button><button class="btn-luxury btn-reject-luxury" @onclick="DoShowReject" disabled="@isSaving">رفض</button></div></div>
        }

        @if (isLoading){<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else
        {
            @if (isNewMode && !isSourceLocked)
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury purple"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h3 class="sec-title-luxury">مصدر الفاتورة - الجداول الموجودة فقط</h3><span class="sec-badge-luxury">الفاتورة هي الأساس</span></div>
                    <div class="source-cards-luxury" style="grid-template-columns:repeat(2,1fr)">
                        <div class="source-card-luxury @(header.InvoiceSource == 2 ? "active" : "")" @onclick="SelectOrderSource"><div class="source-card-icon-luxury" style="background:#eff6ff;color:#2563eb;border:1px solid #dbeafe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><div class="source-card-title-luxury">من أمر بيع</div><div class="source-card-desc-luxury">اختياري - تحميل سطور من أمر بيع معتمد موجود 28 عمود</div><div class="source-check-luxury">@if(header.InvoiceSource==2){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5l10-10"/></svg>}</div></div>
                        <div class="source-card-luxury @(header.InvoiceSource == 3 ? "active" : "")" @onclick="SelectDirectSource"><div class="source-card-icon-luxury" style="background:rgba(212,175,55,.1);color:#9C7C2E;border:1px solid rgba(212,175,55,.18)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/></svg></div><div class="source-card-title-luxury">فاتورة مباشرة - الأساس</div><div class="source-card-desc-luxury">بدون أمر - مع/بدون ضريبة - نفس نظام المشتريات</div><div class="source-check-luxury">@if(header.InvoiceSource==3){<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12l5 5l10-10"/></svg>}</div></div>
                    </div>
                </div>
            }

            @if (header.InvoiceSource > 0 || !isNewMode)
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h3 class="sec-title-luxury">بيانات الفاتورة</h3>
                    <label class="tax-toggle-luxury"><input type="checkbox" @bind="header.IsTaxable" disabled="@isReadOnly" /><span class="tax-slider"></span><span class="tax-label">@(header.IsTaxable ? $"مع ضريبة {header.TaxRate:#,##0}%" : "بدون ضريبة - معفاة")</span></label>
                </div>
                    <div class="form-grid-luxury c4">
                        <div class="f-field-luxury"><label class="f-label-luxury">رقم الفاتورة</label><input type="text" class="f-input-luxury readonly" value="@(header.InvoiceNumber ?? "تلقائي")" disabled /></div>
                        <div class="f-field-luxury"><label class="f-label-luxury required">التاريخ</label><input type="date" class="f-input-luxury" @bind="header.InvoiceDate" disabled="@isReadOnly" /></div>
                        <div class="f-field-luxury"><label class="f-label-luxury required">العميل</label><SearchableSelect Items="@customersSearchable" @bind-SelectedId="header.CustomerID" Placeholder="اختر العميل..." IsDisabled="@isReadOnly" OnSelected="OnCustomerSelected" /></div>
                        <div class="f-field-luxury"><label class="f-label-luxury">المخزن</label><select class="f-input-luxury" @bind="header.WarehouseID" disabled="@isReadOnly"><option value="">-- اختر --</option>@if (warehouses != null){@foreach (var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select></div>
                        <div class="f-field-luxury"><label class="f-label-luxury">شروط الدفع</label><select class="f-input-luxury" @bind="header.PaymentTermID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (paymentTerms != null){@foreach (var pt in paymentTerms){<option value="@pt.Id">@pt.Name</option>}}</select></div>
                        <div class="f-field-luxury"><label class="f-label-luxury">العملة</label><select class="f-input-luxury" @bind="header.CurrencyID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if (currencies != null){@foreach (var c in currencies){<option value="@c.Id">@c.Name</option>}}</select></div>
                        @if (header.IsTaxable)
                        {
                            <div class="f-field-luxury"><label class="f-label-luxury">نسبة الضريبة %</label><input type="number" class="f-input-luxury" @bind="header.TaxRate" step="0.01" disabled="@isReadOnly" /></div>
                        }
                        <div class="f-field-luxury"><label class="f-label-luxury">ملاحظات</label><input type="text" class="f-input-luxury" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات..." /></div>
                    </div>
                    @if (header.InvoiceStatus == 1 && !string.IsNullOrEmpty(header.RejectionReason)){<div class="rejection-box-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg><strong>سبب الرفض السابق:</strong> @header.RejectionReason</div>}
                </div>
            }

            @if ((header.InvoiceSource > 0 || !isNewMode) && (InvoiceId > 0 || isSourceLocked))
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury green"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><h3 class="sec-title-luxury">أصناف الفاتورة</h3><span class="sec-badge-luxury">@details.Count صنف</span><span class="total-mini-luxury">@details.Sum(d=>d.LineTotalWithTax).ToString("#,##0.00") ج.م</span>
                    @if (!isReadOnly && !isApprovalMode && permissions.CanAdd){<button class="btn-luxury btn-primary-luxury btn-sm-luxury" style="margin-right:auto;" @onclick="ShowAddLine"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة صنف</button>}
                </div>
                    @if (!details.Any() && !showLineForm){<div class="empty-lines-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><p>لا توجد أصناف — أضف صنف للفاتورة @(header.IsTaxable ? "مع ضريبة" : "بدون ضريبة")</p></div>}
                    else
                    {
                        <div class="tbl-card-luxury"><div class="table-responsive"><table class="tbl-luxury"><thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="tc">الكمية</th><th class="tl">السعر</th><th class="tc">خصم%</th><th class="tc">ضريبة%</th><th class="tl">الإجمالي</th>@if (!isReadOnly && !isApprovalMode){<th class="tc">إجراءات</th>}</tr></thead><tbody>@{int n=0;}@foreach (var line in details){n++;<tr><td class="td-n">@n</td><td><code class="code-tag-luxury">@line.ItemCode</code></td><td class="td-bold">@line.ItemNameAr</td><td class="td-muted">@line.UnitName</td><td class="tc">@line.Quantity.ToString("#,##0.##")</td><td class="tl num-cell">@line.UnitPrice.ToString("#,##0.00")</td><td class="tc">@line.DiscountPercent.ToString("#,##0.##")</td><td class="tc">@(header.IsTaxable ? line.TaxRate.ToString("#,##0.##") : "—")</td><td class="tl num-cell"><strong>@line.LineTotalWithTax.ToString("#,##0.00")</strong></td>@if (!isReadOnly && !isApprovalMode){<td class="tc"><div class="line-actions-luxury">@if (permissions.CanDelete){<button class="act-btn-luxury del" @onclick="() => DeleteLine(line.InvoiceDetailID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}</div></td>}</tr>}</tbody><tfoot><tr class="total-row-luxury"><td colspan="8" class="tl"><strong>الإجمالي @(header.IsTaxable ? "شامل الضريبة" : "بدون ضريبة")</strong></td><td class="tl num-cell"><strong>@details.Sum(d => d.LineTotalWithTax).ToString("#,##0.00")</strong></td>@if (!isReadOnly && !isApprovalMode){<td></td>}</tr></tfoot></table></div></div>
                    }

                    @if (showLineForm)
                    {
                        <div class="line-form-luxury"><div class="ml-gold-line"></div><div class="line-form-head-luxury"><h4>إضافة صنف @(header.IsTaxable ? "مع ضريبة" : "بدون ضريبة")</h4><button class="btn-close-x-luxury" @onclick="CloseLineForm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
                            <div class="form-grid-luxury c3">
                                <div class="f-field-luxury"><label class="f-label-luxury required">الصنف</label><SearchableSelect Items="@saleItems" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث..." /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">الوحدة</label><select class="f-input-luxury" @bind="editLine.UnitID"><option value="0">-- اختر --</option>@if (units != null){@foreach (var u in units){<option value="@u.Id">@u.Name</option>}}</select></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">المخزن</label><select class="f-input-luxury" @bind="editLine.WarehouseID"><option value="">--</option>@if (warehouses != null){@foreach (var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">الكمية</label><input type="number" class="f-input-luxury" @bind="editLine.Quantity" step="0.01" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury required">سعر الوحدة</label><input type="number" class="f-input-luxury" @bind="editLine.UnitPrice" step="0.01" /></div>
                                <div class="f-field-luxury"><label class="f-label-luxury">خصم %</label><input type="number" class="f-input-luxury" @bind="editLine.DiscountPercent" step="0.01" /></div>
                                @if (header.IsTaxable)
                                {
                                    <div class="f-field-luxury"><label class="f-label-luxury">ضريبة %</label><input type="number" class="f-input-luxury" @bind="editLine.TaxRate" step="0.01" /></div>
                                }
                            </div>
                            <div class="line-calc-bar-luxury"><span>قبل الضريبة: <strong>@editLine.LineTotal.ToString("#,##0.00")</strong></span>@if(header.IsTaxable){<span>الضريبة: <strong>@editLine.TaxAmount.ToString("#,##0.00")</strong></span>}<span>الإجمالي: <strong>@editLine.LineTotalWithTax.ToString("#,##0.00")</strong></span><span class="tax-badge-luxury @(header.IsTaxable?"yes":"no")">@(header.IsTaxable ? "مع ضريبة" : "معفاة")</span></div>
                            @if (!string.IsNullOrEmpty(lineMsg)){<div class="form-msg-luxury @(lineMsgOk?"ok":"err")">@lineMsg</div>}
                            <div class="line-form-btns-luxury"><button class="btn-luxury btn-primary-luxury" @onclick="SaveLine" disabled="@isSavingLine">@if(isSavingLine){<div class="btn-spinner-sm"></div>}إضافة</button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseLineForm">إلغاء</button></div>
                        </div>
                    }
                </div>
            }

            @if (!isReadOnly && !isApprovalMode && InvoiceId > 0 && details.Any())
            {
                <div class="doc-section-luxury"><div class="ml-gold-line"></div><div class="sec-head-luxury"><div class="sec-icon-luxury orange"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></div><h3 class="sec-title-luxury">التكاليف الإضافية</h3></div>
                    <div class="form-grid-luxury c3"><div class="f-field-luxury"><label class="f-label-luxury">خصم عام %</label><input type="number" class="f-input-luxury" @bind="header.DiscountPercent" step="0.01" /></div><div class="f-field-luxury"><label class="f-label-luxury">تكلفة الشحن</label><input type="number" class="f-input-luxury" @bind="header.ShippingCost" step="0.01" /></div><div class="f-field-luxury"><label class="f-label-luxury">تكاليف أخرى</label><input type="number" class="f-input-luxury" @bind="header.OtherCosts" step="0.01" /></div></div>
                </div>
            }

            @if (InvoiceId > 0 && details.Any())
            {
                <div class="totals-bar-luxury"><div class="ml-gold-line"></div><div class="total-item-luxury"><span class="total-label-luxury">الإجمالي الفرعي</span><span class="total-value-luxury">@header.SubTotal.ToString("#,##0.00")</span></div>@if (header.DiscountAmount > 0){<div class="total-item-luxury"><span class="total-label-luxury">الخصم</span><span class="total-value-luxury t-discount-luxury">- @header.DiscountAmount.ToString("#,##0.00")</span></div>}<div class="total-item-luxury"><span class="total-label-luxury">@(header.IsTaxable ? $"الضريبة {header.TaxRate:#,##0}%" : "الضريبة")</span><span class="total-value-luxury">@(header.IsTaxable ? header.TaxAmount.ToString("#,##0.00") : "معفاة")</span></div><div class="total-item-luxury total-grand-luxury"><span class="total-label-luxury">الإجمالي @(header.IsTaxable ? "شامل" : "بدون ضريبة")</span><span class="total-value-luxury">@header.TotalAmount.ToString("#,##0.00") @(header.CurrencySymbol ?? "ج.م")</span></div>@if (header.PaidAmount > 0){<div class="total-item-luxury"><span class="total-label-luxury">المدفوع</span><span class="total-value-luxury">@header.PaidAmount.ToString("#,##0.00")</span></div>}@if (header.RemainingAmount > 0){<div class="total-item-luxury"><span class="total-label-luxury">المتبقي</span><span class="total-value-luxury" style="color:#dc2626">@header.RemainingAmount.ToString("#,##0.00")</span></div>}</div>
            }

            @if (!isViewMode && !isApprovalMode)
            {
                <div class="doc-actions-luxury"><div class="ml-gold-line"></div><div class="doc-actions-right">@if (!isReadOnly){<button class="btn-luxury btn-primary-luxury" @onclick="SaveInvoice" disabled="@isSaving">@if(isSaving){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21V13H7v8"/></svg>}@(isNewMode ? "حفظ الفاتورة" : "حفظ التعديلات")</button>@if (InvoiceId > 0 && header.InvoiceStatus == 1 && details.Any()){<button class="btn-luxury btn-warning-luxury" @onclick="SubmitForApproval" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="m22 2-7 20-4-9-9-4 20-7z"/></svg>إرسال للاعتماد — قيد أوتوماتيك @(header.IsTaxable ? "مع ضريبة" : "بدون")</button>}}</div><button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">رجوع</button></div>
            }
        }
    </div>

    @if (showRejectDialog)
    {
        <div class="modal-overlay-luxury" @onclick="() => showRejectDialog = false"><div class="modal-card-luxury" @onclick:stopPropagation="true"><div class="ml-gold-line danger"></div><div class="delete-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>رفض الفاتورة</h4><p>أدخل سبب الرفض:</p><textarea class="f-input-luxury" rows="3" @bind="rejectReason" placeholder="سبب الرفض..."></textarea>@if (!string.IsNullOrEmpty(rejectMsg)){<div class="form-msg-luxury err">@rejectMsg</div>}<div class="ml-footer center"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmReject">تأكيد الرفض</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showRejectDialog = false">إلغاء</button></div></div></div>
    }

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast = ""'></button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-doc-page{display:flex;flex-direction:column;gap:16px;font-family:'Tajawal',sans-serif;max-width:1300px;margin:0 auto}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25);overflow:hidden}
