@page "/sales-orders/new"
@page "/sales-orders/edit/{OrderId:int}"
@page "/sales-orders/view/{OrderId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject SalesOrderService SoService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4></div>}
else
{
    <div class="luxury-edit-page" dir="rtl">

        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <button class="btn-luxury btn-ghost-dark" @onclick="GoBack"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>رجوع</button>
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text">
                        <h2 class="lh-title">@pageTitle</h2>
                        <p class="lh-subtitle">@(string.IsNullOrEmpty(header.OrderNumber)?"إنشاء أمر بيع - اختياري والفاتورة هي الأساس":$"{header.OrderNumber} - {header.CustomerNameAr ?? "—"}")</p>
                    </div>
                </div>
                <div class="lh-actions">
                    @if (!string.IsNullOrEmpty(header.OrderNumber))
                    {
                        <span class="status-badge-luxury" style="--sc:@SalesOrderService.GetStatusColor(header.OrderStatus)">@SalesOrderService.GetStatusName(header.OrderStatus)</span>
                        @if (header.OrderSource > 0){<span class="source-badge-luxury" style="--sc:@SalesOrderService.GetSourceColor(header.OrderSource)">@SalesOrderService.GetSourceName(header.OrderSource)</span>}
                    }
                    <span class="lh-badge"><span class="lh-dot"></span>@(isNewMode?"جديد":isViewMode?"عرض":isApprovalMode?"اعتماد":"تعديل")</span>
                    @if (permissions.CanPrint && OrderId > 0){<button class="btn-luxury btn-ghost-dark" @onclick="PrintDoc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>طباعة</button>}
                </div>
            </div>
        </div>

        @if (isApprovalMode)
        {
            <div class="approval-bar-luxury approve"><div class="ab-gold-line"></div><div class="ab-content"><div class="ab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div><strong>بانتظار اعتمادك</strong><span>راجع البيانات والأصناف ثم اعتمد أو ارفض</span></div></div><div class="ab-actions"><button class="btn-luxury btn-success-luxury" @onclick="ExecuteApprove" disabled="@isSaving">اعتماد</button><button class="btn-luxury btn-danger-luxury" @onclick="DoShowReject" disabled="@isSaving">رفض</button></div></div>
        }

        @if (isLoading)
        {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري التحميل...</p></div>}
        else
        {
            @if (isNewMode && !isSourceLocked)
            {
                <div class="source-cards-luxury">
                    <div class="source-card-luxury @(header.OrderSource==1?"active":"")" @onclick="SelectManualSource"><div class="ml-gold-line"></div><div class="sc-icon" style="background:rgba(212,175,55,.1);color:var(--gold-dark);border:1px solid rgba(212,175,55,.15)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><div class="sc-title">أمر بيع يدوي</div><div class="sc-desc">إنشاء أمر بيع مباشر بدون عرض سعر</div></div>
                    <div class="source-card-luxury @(header.OrderSource==2?"active":"")" @onclick="SelectQuotationSource"><div class="ml-gold-line" style="background:linear-gradient(90deg,transparent,#2563eb,transparent)"></div><div class="sc-icon" style="background:#eff6ff;color:#2563eb;border:1px solid #dbeafe"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></div><div class="sc-title">من عرض سعر</div><div class="sc-desc">تحويل عرض سعر معتمد لأمر بيع</div></div>
                </div>
            }

            <div class="mudtabs-luxury">
                <div class="mudtabs-header">
                    <button class="mudtab-btn @(activeTab==0?"active":"")" @onclick="() => activeTab=0"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></span>البيانات الأساسية</button>
                    <button class="mudtab-btn @(activeTab==1?"active":"")" @onclick="() => activeTab=1"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>العميل والمالية</button>
                    <button class="mudtab-btn @(activeTab==2?"active":"")" @onclick="() => activeTab=2"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></span>الأصناف <span class="mt-count gold">@details.Count</span></button>
                    <button class="mudtab-btn @(activeTab==3?"active":"")" @onclick="() => activeTab=3"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span>التكاليف والإجماليات</button>
                    <button class="mudtab-btn @(activeTab==4?"active":"")" @onclick="() => activeTab=4"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></span>الاعتماد والسجل</button>
                    <button class="mudtab-btn @(activeTab==5?"active":"")" @onclick="() => activeTab=5"><span class="mt-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></span>ملاحظات</button>
                </div>

                <div class="mudtabs-body">
                    @if (activeTab == 0)
                    {
                        <div class="tab-panel luxury-fade">
                            @if (header.OrderSource == 2 && isNewMode && !isQuotationLoaded)
                            {
                                <div class="tab-header"><div class="tab-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><div><h3>اختيار عرض السعر المعتمد</h3><p>ابحث واختر عرض السعر لتحميل الأصناف</p></div></div>
                                <div class="form-grid cols-2">
                                    <div class="form-field"><label class="field-label required">عرض السعر</label><SearchableSelect Items="@approvedQuotations" @bind-SelectedId="selectedQuotationId" OnSelected="OnQuotationSelected" Placeholder="ابحث برقم عرض السعر..." /></div>
                                    @if (quotationLines != null && quotationLines.Any()){<div class="form-field"><label class="field-label">المختار</label><div class="field-input disabled"><span>@quotationLines.Count(l=>l.IsSelected) من @quotationLines.Count صنف</span></div></div>}
                                </div>
                                @if (quotationLines != null && quotationLines.Any())
                                {
                                    <div class="table-card-luxury" style="margin-top:12px"><div class="table-responsive"><table class="table-luxury"><thead><tr><th class="th-center" style="width:40px"><input type="checkbox" checked="@quotationLines.All(l=>l.IsSelected)" @onchange="ToggleAllQuotationLines" /></th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="th-center">الكمية</th><th class="th-center">تم طلبه</th><th class="th-center">المتبقي</th><th>السعر</th></tr></thead><tbody>@foreach(var line in quotationLines){<tr class="@(!line.IsSelected?"row-dim":"")"><td class="td-center"><input type="checkbox" @bind="line.IsSelected" /></td><td><span class="code-luxury">@line.ItemCode</span></td><td class="td-name">@line.ItemNameAr</td><td class="td-muted">@line.UnitName</td><td class="td-center">@line.QuotedQty.ToString("#,##0.##")</td><td class="td-center">@line.TotalOrderedQty.ToString("#,##0.##")</td><td class="td-center"><strong style="color:var(--gold-dark)">@line.RemainingToOrder.ToString("#,##0.##")</strong></td><td class="num-cell">@line.UnitPrice.ToString("#,##0.00")</td></tr>}</tbody></table></div></div>
                                }
                            }

                            @if (header.OrderSource > 0 || !isNewMode)
                            {
                                <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><div><h3>بيانات أمر البيع</h3><p>التواريخ والمخزن والمصدر</p></div></div>
                                <div class="form-grid cols-4">
                                    <div class="form-field"><label class="field-label">رقم الأمر</label><div class="field-input disabled"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/></svg><span>@(header.OrderNumber ?? "تلقائي")</span></div></div>
                                    <div class="form-field"><label class="field-label required">التاريخ</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><input type="date" class="field-input" @bind="header.OrderDate" disabled="@isReadOnly" /></div></div>
                                    <div class="form-field"><label class="field-label">التسليم المتوقع</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><input type="date" class="field-input" @bind="header.ExpectedDeliveryDate" disabled="@isReadOnly" /></div></div>
                                    <div class="form-field"><label class="field-label required">المخزن</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><select class="field-select" @bind="header.WarehouseID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if(warehouses!=null){@foreach(var w in warehouses){<option value="@w.Id">@w.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                                </div>
                                @if (header.OrderStatus==4 && !string.IsNullOrEmpty(header.RejectionReason)){<div class="msg-luxury msg-error"> <strong>سبب الرفض:</strong> @header.RejectionReason</div>}
                            }
                            else if (isNewMode && header.OrderSource==0)
                            {<div class="empty-luxury small"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg></div><h4>اختر مصدر أمر البيع أولاً</h4><p style="font-size:.8rem;color:#8B95A5;margin:6px 0 0">يدوي أو من عرض سعر معتمد</p></div>}
                        </div>
                    }

                    @if (activeTab == 1)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></div><div><h3>بيانات العميل والمالية</h3><p>اختيار العميل والمندوب وشروط الدفع والعملة</p></div></div>
                            <div class="form-grid cols-4">
                                <div class="form-field" style="grid-column:span 2"><label class="field-label required">العميل</label><SearchableSelect Items="@customersSearchable" @bind-SelectedId="header.CustomerID" OnSelected="OnCustomerSelected" Placeholder="ابحث بالاسم أو الكود..." IsDisabled="@isReadOnly" /></div>
                                <div class="form-field"><label class="field-label">المندوب</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><circle cx="19" cy="7" r="3"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/></svg><select class="field-select" @bind="header.SalesRepID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if(salesReps!=null){@foreach(var r in salesReps){<option value="@r.Id">@r.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                                <div class="form-field"><label class="field-label">قائمة الأسعار</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg><select class="field-select" @bind="header.PriceListID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if(priceLists!=null){@foreach(var p in priceLists){<option value="@p.Id">@p.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                                <div class="form-field"><label class="field-label">شروط الدفع</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><select class="field-select" @bind="header.PaymentTermID" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if(paymentTerms!=null){@foreach(var pt in paymentTerms){<option value="@pt.Id">@pt.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                                <div class="form-field"><label class="field-label">العملة</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><select class="field-select" @bind="header.CurrencyID" @bind:after="OnCurrencyChanged" disabled="@isReadOnly"><option value="0">-- اختر --</option>@if(currencies!=null){@foreach(var c in currencies){<option value="@c.Id">@c.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                            </div>
                            @if (customerInfo != null)
                            {
                                <div class="customer-info-luxury"><div class="ml-gold-line"></div><div class="si-grid"><div class="si-item"><span class="si-label">الهاتف</span><span class="si-value">@(customerInfo.Phone1 ?? "—")</span></div><div class="si-item"><span class="si-label">المدينة</span><span class="si-value">@(customerInfo.City ?? "—")</span></div><div class="si-item"><span class="si-label">الرصيد الحالي</span><span class="si-value @(customerInfo.CurrentBalance>0?"si-danger":"")">@customerInfo.CurrentBalance.ToString("#,##0.00")</span></div><div class="si-item"><span class="si-label">الحد الائتماني</span><span class="si-value">@customerInfo.CreditLimit.ToString("#,##0.00")</span></div><div class="si-item"><span class="si-label">المتاح</span><span class="si-value @(customerInfo.AvailableCredit<0?"si-danger":"si-ok")">@customerInfo.AvailableCredit.ToString("#,##0.00")</span></div><div class="si-item"><span class="si-label">قائمة الأسعار</span><span class="si-value">@(customerInfo.PriceListName ?? "—")</span></div></div></div>
                            }
                        </div>
                    }

                    @if (activeTab == 2)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><div><h3>أصناف أمر البيع</h3><p>@details.Count صنف - الإجمالي: @details.Sum(d=>d.LineTotalWithTax).ToString("#,##0.00")</p></div>@if(!isReadOnly && !isApprovalMode && permissions.CanAdd){<button class="btn-luxury btn-primary-luxury" @onclick="ShowAddLine" style="margin-right:auto"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة صنف</button>}</div>
                            @if (!details.Any() && !showLineForm){<div class="empty-luxury small"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><h4>لا توجد أصناف</h4><p style="font-size:.8rem;color:#8B95A5;margin:6px 0 0">اضغط إضافة صنف للبدء</p></div>}
                            else
                            {
                                <div class="table-card-luxury"><div class="table-responsive"><table class="table-luxury"><thead><tr><th>#</th><th>الكود</th><th>الصنف</th><th>الوحدة</th><th class="th-center">الكمية</th><th>السعر</th><th class="th-center">خصم %</th><th class="th-center">ضريبة %</th><th>الإجمالي</th>@if(!isNewMode){<th class="th-center">مسلم</th><th class="th-center">متبقي</th>}@if(!isReadOnly && !isApprovalMode){<th class="th-actions">إجراءات</th>}</tr></thead><tbody>@{int n=0;}@foreach(var line in details){n++;<tr><td class="td-num">@n</td><td><span class="code-luxury">@line.ItemCode</span></td><td class="td-name">@line.ItemNameAr</td><td class="td-muted">@line.UnitName</td><td class="td-center">@line.OrderedQty.ToString("#,##0.##")</td><td class="num-cell">@line.UnitPrice.ToString("#,##0.00")</td><td class="td-center">@line.DiscountPercent.ToString("#,##0.##")</td><td class="td-center">@line.TaxRate.ToString("#,##0.##")</td><td class="num-cell"><strong>@line.LineTotalWithTax.ToString("#,##0.00")</strong></td>@if(!isNewMode){<td class="td-center">@line.DeliveredQty.ToString("#,##0.##")</td><td class="td-center"><strong class="@(line.RemainingQty>0?"bal-danger":"")">@line.RemainingQty.ToString("#,##0.##")</strong></td>}@if(!isReadOnly && !isApprovalMode){<td class="td-center"><div class="actions-wrap-luxury">@if(permissions.CanEdit){<button class="act-btn edit" @onclick="() => ShowEditLine(line)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}@if(permissions.CanDelete){<button class="act-btn delete" @onclick="() => DeleteLine(line.SODetailID)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}</div></td>}</tr>}</tbody><tfoot><tr class="total-row-luxury"><td colspan="8" class="td-name">الإجمالي</td><td class="num-cell"><strong>@details.Sum(d=>d.LineTotalWithTax).ToString("#,##0.00")</strong></td>@if(!isNewMode){<td colspan="2"></td>}@if(!isReadOnly && !isApprovalMode){<td></td>}</tr></tfoot></table></div></div>
                            }

                            @if (showLineForm)
                            {
                                <div class="line-form-luxury"><div class="lf-gold-line"></div><div class="line-form-head"><h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg>@(isEditLine?"تعديل صنف":"إضافة صنف")</h4><button class="btn-close-x" @onclick="CloseLineForm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div>
                                    <div class="form-grid cols-3">
                                        <div class="form-field"><label class="field-label required">الصنف</label><SearchableSelect Items="@saleItems" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث بالاسم أو الكود..." IsDisabled="@isEditLine" /></div>
                                        <div class="form-field"><label class="field-label required">الوحدة</label><div class="select-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg><select class="field-select" @bind="editLine.UnitID"><option value="0">-- اختر --</option>@if(units!=null){@foreach(var u in units){<option value="@u.Id">@u.Name</option>}}</select><svg class="select-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                                        <div class="form-field"><label class="field-label required">الكمية</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14"/></svg><input type="number" class="field-input" @bind="editLine.OrderedQty" step="0.01" /></div>@if(editLine.QuotationRemaining.HasValue){<span class="field-hint">المتبقي من عرض السعر: @editLine.QuotationRemaining.Value.ToString("#,##0.##")</span>}</div>
                                        <div class="form-field"><label class="field-label required">سعر الوحدة</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="editLine.UnitPrice" step="0.01" /><span class="field-suffix">ج.م</span></div></div>
                                        <div class="form-field"><label class="field-label">خصم %</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="editLine.DiscountPercent" step="0.01" /><span class="field-suffix">%</span></div></div>
                                        <div class="form-field"><label class="field-label">ضريبة %</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="editLine.TaxRate" step="0.01" /><span class="field-suffix">%</span></div></div>
                                    </div>
                                    <div class="line-calc-bar-luxury"><span>قبل الضريبة: <strong>@editLine.LineTotal.ToString("#,##0.00")</strong></span><span>الضريبة: <strong>@editLine.TaxAmount.ToString("#,##0.00")</strong></span><span class="grand">الإجمالي: <strong>@editLine.LineTotalWithTax.ToString("#,##0.00")</strong></span></div>
                                    @if(!string.IsNullOrEmpty(lineMsg)){<div class="msg-luxury @(lineMsgOk?"msg-success":"msg-error")" style="margin-top:10px">@lineMsg</div>}
                                    <div class="line-form-btns"><button class="btn-luxury btn-primary-luxury" @onclick="SaveLine" disabled="@isSavingLine"><span>@(isEditLine?"تحديث":"إضافة")</span></button><button class="btn-luxury btn-ghost-luxury" @onclick="CloseLineForm">إلغاء</button></div>
                                </div>
                            }
                        </div>
                    }

                    @if (activeTab == 3)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><div><h3>التكاليف الإضافية والإجماليات</h3><p>الخصم العام والشحن والعملة</p></div></div>
                            @if (!isReadOnly && !isApprovalMode && OrderId > 0 && details.Any())
                            {
                                <div class="form-grid cols-4">
                                    <div class="form-field"><label class="field-label">خصم عام %</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="header.DiscountPercent" step="0.01" /><span class="field-suffix">%</span></div></div>
                                    <div class="form-field"><label class="field-label">تكلفة الشحن</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="header.ShippingCost" step="0.01" /><span class="field-suffix">ج.م</span></div></div>
                                    <div class="form-field"><label class="field-label">تكاليف أخرى</label><div class="input-with-suffix"><input type="number" class="field-input" @bind="header.OtherCosts" step="0.01" /><span class="field-suffix">ج.م</span></div></div>
                                    <div class="form-field"><label class="field-label">سعر الصرف</label><div class="input-wrap"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg><input type="number" class="field-input" @bind="header.ExchangeRate" step="0.000001" /></div></div>
                                </div>
                            }
                            @if (OrderId > 0 && details.Any())
                            {
                                <div class="totals-bar-luxury"><div class="ml-gold-line"></div><div class="totals-grid"><div class="total-item"><span class="total-label">الإجمالي الفرعي</span><span class="total-value">@header.SubTotal.ToString("#,##0.00")</span></div>@if(header.DiscountAmount>0){<div class="total-item"><span class="total-label">الخصم</span><span class="total-value t-discount">- @header.DiscountAmount.ToString("#,##0.00")</span></div>}<div class="total-item"><span class="total-label">الضريبة</span><span class="total-value">@header.TaxAmount.ToString("#,##0.00")</span></div>@if(header.ShippingCost>0){<div class="total-item"><span class="total-label">الشحن</span><span class="total-value">@header.ShippingCost.ToString("#,##0.00")</span></div>}<div class="total-item total-grand-luxury"><span class="total-label">الإجمالي الكلي</span><span class="total-value">@header.TotalAmount.ToString("#,##0.00") @(header.CurrencySymbol ?? "ج.م")</span></div></div></div>
                            }
                            else{<div class="empty-luxury small"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div><h4>لا توجد أصناف لحساب الإجمالي</h4></div>}
                        </div>
                    }

                    @if (activeTab == 4)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01 9 11.01"/></svg></div><div><h3>الاعتماد والسجل</h3><p>حالة الاعتماد والتتبع</p></div></div>
                            <div class="status-timeline-luxury">
                                <div class="st-step @(header.OrderStatus>=1?"done":"")"><div class="st-dot"></div><div class="st-line"></div><div class="st-content"><strong>مسودة</strong><span>تم الإنشاء @header.OrderDate.ToString("dd/MM/yyyy")</span></div></div>
                                <div class="st-step @(header.OrderStatus>=2?"done":"") @(header.OrderStatus==2?"current":"")"><div class="st-dot"></div><div class="st-line"></div><div class="st-content"><strong>انتظار اعتماد</strong><span>@(header.OrderStatus>=2?"تم الإرسال للاعتماد":"لم يرسل بعد")</span></div></div>
                                <div class="st-step @(header.OrderStatus>=3?"done":"") @(header.OrderStatus==3?"current":"")"><div class="st-dot"></div><div class="st-line"></div><div class="st-content"><strong>معتمد</strong><span>@(header.OrderStatus>=3?"تم الاعتماد - جاهز للفوترة":"بانتظار الاعتماد")</span></div></div>
                                <div class="st-step @(header.OrderStatus>=5?"done":"")"><div class="st-dot"></div><div class="st-line"></div><div class="st-content"><strong>قيد التجهيز</strong><span>@(header.OrderStatus>=5?"جاري تجهيز الطلب":"لم يبدأ")</span></div></div>
                                <div class="st-step @(header.OrderStatus>=6?"done":"")"><div class="st-dot"></div><div class="st-content"><strong>فاتورة</strong><span>إنشاء فاتورة مباشرة - الأساس (بدون جدول تسليم)</span></div></div>
                            </div>
                            @if (header.OrderStatus==4){<div class="msg-luxury msg-error" style="margin-top:16px"> مرفوض - السبب: @header.RejectionReason</div>}
                        </div>
                    }

                    @if (activeTab == 5)
                    {
                        <div class="tab-panel luxury-fade">
                            <div class="tab-header"><div class="tab-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></div><div><h3>ملاحظات أمر البيع</h3><p>ملاحظات عامة وداخلية</p></div></div>
                            <div class="form-grid cols-2">
                                <div class="form-field"><label class="field-label">ملاحظات عامة (تظهر في الطباعة)</label><textarea class="field-textarea" rows="4" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات عامة تظهر للعميل..."></textarea></div>
                                <div class="form-field"><label class="field-label">ملاحظات داخلية (لا تطبع)</label><textarea class="field-textarea" rows="4" @bind="header.InternalNotes" disabled="@isReadOnly" placeholder="ملاحظات داخلية للمتابعة..."></textarea></div>
                            </div>
                            <div class="timeline-luxury">
                                <div class="tl-item"><div class="tl-dot gold"></div><div class="tl-content"><strong>رقم الأمر: @(header.OrderNumber ?? "تلقائي")</strong><span>تاريخ: @header.OrderDate.ToString("dd/MM/yyyy")</span></div></div>
                                <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><strong>العميل: @(header.CustomerNameAr ?? "—")</strong><span>المخزن: @(warehouses?.FirstOrDefault(w=>w.Id==header.WarehouseID)?.Name ?? "—")</span></div></div>
                                <div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><strong>الإجمالي: @header.TotalAmount.ToString("#,##0.00") @(header.CurrencySymbol ?? "")</strong><span>@details.Count صنف - @details.Sum(d=>d.OrderedQty).ToString("#,##0.##") كمية إجمالية</span></div></div>
                                @if (!string.IsNullOrEmpty(createdByName)){<div class="tl-item"><div class="tl-dot gold"></div><div class="tl-content"><strong>أنشئ بواسطة: @createdByName</strong><span>@createdDate</span></div></div>}
                                @if (!string.IsNullOrEmpty(modifiedByName)){<div class="tl-item"><div class="tl-dot"></div><div class="tl-content"><strong>آخر تعديل: @modifiedByName</strong><span>@modifiedDate</span></div></div>}
                                <div class="tl-item"><div class="tl-dot" style="background:var(--gold)"></div><div class="tl-content"><strong>المستخدم الحالي: @UserSession.FullName</strong><span>يعمل الآن على هذا السجل</span></div></div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (OrderId > 0)
            {
                <div class="audit-bar-luxury">
                    <div class="audit-item-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg><span>أنشئ بواسطة: <strong>@(string.IsNullOrEmpty(createdByName)?"غير محدد":createdByName)</strong></span><span class="audit-date">@createdDate</span></div>
                    @if (!string.IsNullOrEmpty(modifiedByName)){<div class="audit-item-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 3v5h5"/></svg><span>آخر تعديل: <strong>@modifiedByName</strong></span><span class="audit-date">@modifiedDate</span></div>}
                    <div class="audit-item-luxury gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg><span>المستخدم الحالي: <strong>@UserSession.FullName</strong></span></div>
                </div>
            }

            @if (!isViewMode && !isApprovalMode)
            {
                <div class="actions-bar-luxury">
                    <div class="actions-right-luxury">
                        @if (!isReadOnly)
                        {
                            <button class="btn-luxury btn-primary-luxury" @onclick="SaveOrder" disabled="@isSaving">@if(isSaving){<div class="btn-spinner"></div><span>جاري الحفظ...</span>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H6v8"/></svg><span>@(isNewMode?"حفظ أمر البيع":"حفظ التعديلات")</span>}</button>
                            @if (OrderId>0 && header.OrderStatus==1 && details.Any()){<button class="btn-luxury btn-warning-luxury" @onclick="SubmitForApproval" disabled="@isSaving"> إرسال للاعتماد</button>}
                            @if (OrderId>0 && header.OrderStatus==3){<button class="btn-luxury btn-success-luxury" @onclick="CreateInvoice" disabled="@isSaving"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M16 13H8"/></svg>إنشاء فاتورة</button>}
                        }
                    </div>
                    <button class="btn-luxury btn-ghost-luxury" @onclick="GoBack">رجوع للقائمة</button>
                </div>
            }
        }
    </div>

    @if (showRejectDialog)
    {
        <div class="modal-overlay-luxury" @onclick="() => showRejectDialog=false"><div class="modal-card-luxury" @onclick:stopPropagation="true"><div class="ml-gold-line danger"></div><div class="modal-header-luxury"><h3>رفض أمر البيع</h3><button class="btn-close-x" @onclick="() => showRejectDialog=false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button></div><div class="modal-body-luxury"><div class="form-field"><label class="field-label required">سبب الرفض</label><textarea class="field-textarea" rows="3" @bind="rejectReason" placeholder="أدخل سبب الرفض..."></textarea></div>@if(!string.IsNullOrEmpty(rejectMsg)){<div class="msg-luxury msg-error" style="margin-top:10px">@rejectMsg</div>}</div><div class="ml-footer"><button class="btn-luxury btn-danger-luxury" @onclick="ConfirmReject">تأكيد الرفض</button><button class="btn-luxury btn-ghost-luxury" @onclick="() => showRejectDialog=false">إلغاء</button></div></div></div>
    }

    @if (!string.IsNullOrEmpty(toast)){<div class="toast-luxury"><div class="toast-card-luxury @(toastOk?"success":"error")"><span>@toast</span><button @onclick='() => toast = ""'></button></div></div>}
}

<style>
:root{--gold:#D4AF37;--gold-dark:#9C7C2E;--black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--border-gold:rgba(212,175,55,.18)}
.luxury-edit-page{display:flex;flex-direction:column;gap:16px;max-width:1300px;margin:0 auto;font-family:'Tajawal',sans-serif}
.luxury-header-hybrid{position:relative;background:linear-gradient(135deg,var(--black) 0%,var(--black2) 50%,var(--black3) 100%);border-radius:20px;padding:18px 22px;overflow:hidden;border:1px solid var(--border-gold);box-shadow:0 8px 32px rgba(0,0,0,.25)}
.lh-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8}
.lh-bg-logo{position:absolute;left:12px;top:50%;transform:translateY(-50%);opacity:.04;pointer-events:none}.lh-bg-logo img{width:100px;height:100px;object-fit:contain}
.lh-content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.lh-right{display:flex;align-items:center;gap:10px}.lh-logo-wrap{width:40px;height:40px;border-radius:10px;background:radial-gradient(ellipse at center,rgba(212,175,55,.15) 0%,transparent 70%);border:1px solid rgba(212,175,55,.18);display:flex;align-items:center;justify-content:center}.lh-logo{width:26px;height:26px;object-fit:contain;filter:drop-shadow(0 0 6px rgba(212,175,55,.4))}
.lh-title{font-size:1.1rem;font-weight:900;color:#F5E6C8;margin:0}.lh-subtitle{font-size:.74rem;color:#8B95A5;font-weight:600;margin:3px 0 0}
.lh-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.lh-badge{display:flex;align-items:center;gap:5px;background:rgba(212,175,55,.1);border:1px solid rgba(212,175,55,.15);padding:4px 10px;border-radius:999px;font-size:.7rem;font-weight:700;color:var(--gold)}.lh-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 0 3px rgba(212,175,55,.15);animation:pulse 2s infinite}@@keyframes pulse{0%,100%{opacity:1}50%{opacity:.6}}
.status-badge-luxury{display:inline-block;padding:4px 12px;border-radius:999px;font-size:.72rem;font-weight:800;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 25%,white)}.source-badge-luxury{display:inline-block;padding:3px 10px;border-radius:999px;font-size:.7rem;font-weight:700;background:color-mix(in srgb,var(--sc) 12%,white);color:var(--sc);border:1px solid color-mix(in srgb,var(--sc) 20%,white)}
.btn-luxury{display:inline-flex;align-items:center;gap:6px;padding:8px 14px;border-radius:10px;font-weight:700;font-size:.78rem;border:none;cursor:pointer;transition:all .2s;font-family:'Tajawal'}.btn-luxury:disabled{opacity:.6;cursor:not-allowed}
.btn-primary-luxury{background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:var(--black2);box-shadow:0 2px 10px rgba(212,175,55,.25)}.btn-ghost-dark{background:rgba(255,255,255,.06);color:#cbd5e1;border:1px solid rgba(212,175,55,.12)}.btn-ghost-dark:hover{background:rgba(255,255,255,.1)}.btn-ghost-luxury{background:#fff;border:1px solid #e8e2d0;color:#475569}.btn-ghost-luxury:hover{background:#fcfaf6;border-color:var(--gold)}.btn-success-luxury{background:linear-gradient(135deg,#059669,#10b981);color:#fff}.btn-danger-luxury{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}.btn-warning-luxury{background:linear-gradient(135deg,#d97706,#f59e0b);color:#fff}.btn-luxury svg{width:14px;height:14px}.btn-spinner{width:16px;height:16px;border:2px solid rgba(0,0,0,.1);border-top-color:var(--black2);border-radius:50%;animation:spin .6s linear infinite}.btn-spinner-sm{width:14px;height:14px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}@@keyframes spin{to{transform:rotate(360deg)}}
.approval-bar-luxury{position:relative;display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 18px;border-radius:16px;flex-wrap:wrap;overflow:hidden}.approval-bar-luxury.approve{background:linear-gradient(135deg,#ecfdf5,#f0fdf4);border:1px solid #a7f3d0}.ab-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,#10b981,transparent)}.ab-content{display:flex;align-items:center;gap:12px}.ab-icon{width:40px;height:40px;border-radius:12px;background:#ecfdf5;border:1px solid #a7f3d0;display:flex;align-items:center;justify-content:center;color:#059669}.ab-icon svg{width:20px;height:20px}.ab-content div{display:flex;flex-direction:column}.ab-content strong{font-size:.9rem;color:#0A0F1E}.ab-content span{font-size:.74rem;color:#6b7280}.ab-actions{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.source-cards-luxury{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.source-card-luxury{position:relative;background:#fff;border:2px solid #e8e2d0;border-radius:16px;padding:22px;text-align:center;cursor:pointer;transition:.2s;overflow:hidden}.source-card-luxury:hover{border-color:var(--gold);transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.06)}.source-card-luxury.active{border-color:var(--gold);background:rgba(212,175,55,.04);box-shadow:0 0 0 3px rgba(212,175,55,.12)}.sc-icon{width:52px;height:52px;border-radius:14px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:10px}.sc-icon svg{width:24px;height:24px}.sc-title{font-weight:800;font-size:.92rem;color:#0A0F1E;margin-bottom:4px}.sc-desc{font-size:.76rem;color:#8B95A5}.ml-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),var(--gold-dark),var(--gold),transparent);opacity:.8}.ml-gold-line.danger{background:linear-gradient(90deg,transparent,#ef4444,#dc2626,transparent)}
