@code {
    [Parameter] public int OrderId { get; set; }
    private SalesOrderHeaderDto header = new() { OrderDate = DateTime.Today, ExchangeRate = 1 };
    private List<SalesOrderDetailDto> details = new();
    private ModulePermissionDto? permissions;
    private SalesCustomerExtendedDto? customerInfo;
    private YKCoatings.Services.CustomerQuickInfoDto? customerBaseInfo;
    private List<LookupDto>? warehouses;
    private List<LookupDto>? paymentTerms;
    private List<LookupDto>? currencies;
    private List<LookupDto>? priceLists;
    private List<LookupDto>? salesReps;
    private List<LookupDto>? units;
    private List<SearchableItem>? customersSearchable;
    private List<SearchableItem>? saleItems;
    private List<SearchableItem>? approvedQuotations;
    private List<QuotationLineForOrderDto>? quotationLines;
    private int selectedQuotationId;
    private bool isQuotationLoaded = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private string toast = ""; private bool toastOk = true;
    private bool isSourceLocked = false;
    private bool showLineForm = false;
    private bool isEditLine = false;
    private SalesOrderDetailEditDto editLine = new();
    private bool isSavingLine = false;
    private string lineMsg = ""; private bool lineMsgOk = true;
    private bool showRejectDialog = false;
    private string rejectReason = ""; private string rejectMsg = "";
    private string createdByName = ""; private string createdDate = ""; private string modifiedByName = ""; private string modifiedDate = "";
    private int activeTab = 0;
    private bool isViewMode => Navigation.Uri.ToLower().Contains("/view/");
    private bool isNewMode => OrderId == 0;
    private bool isApprovalMode => !isNewMode && !isViewMode && header.OrderStatus == 2 && (permissions?.CanApprove ?? false);
    private bool isReadOnly{get{if(isViewMode)return true;if(isNewMode)return false;if(isApprovalMode)return true;return header.OrderStatus!=1;}}
    private string pageTitle{get{if(isNewMode)return "أمر بيع جديد";if(isViewMode)return "عرض أمر بيع";if(isApprovalMode)return "اعتماد أمر بيع";return "تعديل أمر بيع";}}

    protected override async Task OnInitializedAsync()
    {
        try{
            if (!UserSession.IsLoggedIn){Navigation.NavigateTo("/login");return;}
            if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
            permissions = PermissionService.GetModule("SCR_SO");
            if (permissions == null || !permissions.CanView) return;
            await LoadLookups();
            if (OrderId > 0){await LoadOrderData();}
            else{
                var uri=Navigation.ToAbsoluteUri(Navigation.Uri);
                var query=System.Web.HttpUtility.ParseQueryString(uri.Query);
                var source=query["source"];
                if(source=="quotation"){header.OrderSource=2;approvedQuotations=await SoService.GetApprovedQuotationsSearchableAsync();}
                else if(source=="manual"){header.OrderSource=1;isSourceLocked=true;}
            }
        }catch(Exception ex){await ShowToastAsync("خطأ في تحميل الصفحة: "+ex.Message,false);}
        finally{isLoading=false;StateHasChanged();}
    }
    private async Task LoadLookups(){warehouses=await LookupService.GetWarehousesAsync();paymentTerms=await LookupService.GetPaymentTermsAsync();currencies=await LookupService.GetCurrenciesAsync();priceLists=await LookupService.GetPriceListsAsync();salesReps=await LookupService.GetSalesRepsAsync();units=await LookupService.GetUnitsAsync();customersSearchable=await LookupService.GetCustomersSearchableAsync();saleItems=await LookupService.GetItemsForSaleSearchableAsync();}
    private async Task LoadOrderData(){var loaded=await SoService.GetOrderByIdAsync(OrderId);if(loaded!=null){header=loaded;details=await SoService.GetOrderDetailsAsync(OrderId);isSourceLocked=true;isQuotationLoaded=true;if(header.CustomerID>0){try{var full=await LookupService.GetCustomerQuickInfoAsync(header.CustomerID);if(full!=null)customerInfo=new SalesCustomerExtendedDto{CustomerID=full.CustomerID,CustomerNameAr=full.CustomerNameAr,CustomerCode=full.CustomerCode,CreditLimit=full.CreditLimit,CurrentBalance=full.CurrentBalance};}catch{}}await LoadAuditInfo();}else{await ShowToastAsync("أمر البيع غير موجود",false);}}
    private async Task LoadAuditInfo(){try{if(OrderId<=0)return;var audit=await SoService.GetOrderAuditAsync(OrderId);if(audit!=null){createdByName=audit.CreatedByName??"غير محدد";createdDate=audit.CreatedDate?.ToString("dd/MM/yyyy hh:mm tt")??"";modifiedByName=audit.ModifiedByName??"";modifiedDate=audit.ModifiedDate?.ToString("dd/MM/yyyy hh:mm tt")??"";}}catch{}}
    private void SelectManualSource(){header.OrderSource=1;isSourceLocked=true;quotationLines=null;selectedQuotationId=0;isQuotationLoaded=false;header.QuotationID=null;}
    private async Task SelectQuotationSource(){header.OrderSource=2;if(approvedQuotations==null)approvedQuotations=await SoService.GetApprovedQuotationsSearchableAsync();}
    private async Task OnQuotationSelected(SearchableItem? item){if(item==null||item.Id==0){quotationLines=null;selectedQuotationId=0;return;}selectedQuotationId=item.Id;header.QuotationID=item.Id;try{quotationLines=await SoService.GetQuotationLinesForOrderAsync(item.Id);foreach(var line in quotationLines){line.IsSelected=true;}}catch(Exception ex){await ShowToastAsync("خطأ في تحميل سطور عرض السعر: "+ex.Message,false);}}
    private void ToggleAllQuotationLines(ChangeEventArgs e){if(quotationLines==null)return;var val=(bool)(e.Value??false);foreach(var line in quotationLines)line.IsSelected=val;}
    private async Task OnCustomerSelected(SearchableItem? item){if(item==null||item.Id==0){customerInfo=null;header.CustomerID=0;return;}header.CustomerID=item.Id;try{var full=await LookupService.GetCustomerQuickInfoAsync(item.Id);if(full!=null){customerBaseInfo=full; customerInfo=new SalesCustomerExtendedDto{CustomerID=full.CustomerID, CustomerNameAr=full.CustomerNameAr, CustomerCode=full.CustomerCode, CreditLimit=full.CreditLimit, CurrentBalance=full.CurrentBalance};if(full.PaymentTermID.HasValue)header.PaymentTermID=full.PaymentTermID;if(full.CurrencyID.HasValue){header.CurrencyID=full.CurrencyID;header.ExchangeRate=full.ExchangeRate;}} }catch(Exception ex){await ShowToastAsync("خطأ في تحميل بيانات العميل: "+ex.Message,false);}}
    private async Task OnCurrencyChanged(){if(header.CurrencyID.HasValue&&header.CurrencyID.Value>0){header.ExchangeRate=await LookupService.GetExchangeRateAsync(header.CurrencyID.Value);StateHasChanged();}}
    private async Task OnItemSelected(SearchableItem? item){if(item==null)return;editLine.ItemID=item.Id;editLine.ItemCode=item.Code;editLine.ItemNameAr=item.Name;var info=await LookupService.GetItemQuickInfoAsync(item.Id);if(info!=null){if(info.UnitID>0)editLine.UnitID=info.UnitID;editLine.UnitPrice=info.SalesPrice>0?info.SalesPrice:info.EstimatedPrice;}StateHasChanged();}
    private async Task SaveOrder()
    {
        if(header.OrderDate==default){await ShowToastAsync("حدد تاريخ أمر البيع",false);activeTab=0;return;}
        if(header.CustomerID<=0){await ShowToastAsync("اختر العميل",false);activeTab=1;return;}
        isSaving=true;StateHasChanged();
        try{
            if(isNewMode){
                header.OrderNumber=await SoService.GenerateOrderNumberAsync();header.OrderStatus=1;
                var newId=await SoService.InsertOrderAsync(header, UserSession.UserID);
                OrderId=newId;header.SalesOrderID=newId;
                if(header.OrderSource==2&&quotationLines!=null){
                    var selectedIds=quotationLines.Where(l=>l.IsSelected).Select(l=>l.QuotationDetailID).ToList();
                    if(selectedIds.Any()){var imported=await SoService.ImportLinesFromQuotationAsync(newId,header.QuotationID??0,selectedIds,UserSession.UserID);await ShowToastAsync($"تم إنشاء الأمر وتحميل {imported} صنف ");}
                    else{await ShowToastAsync($"تم إنشاء أمر البيع: {header.OrderNumber} ");}
                }else{await ShowToastAsync($"تم إنشاء أمر البيع: {header.OrderNumber} ");}
                isSourceLocked=true;isQuotationLoaded=true;details=await SoService.GetOrderDetailsAsync(newId);header=await SoService.GetOrderByIdAsync(newId)??header;Navigation.NavigateTo($"/sales-orders/edit/{newId}", forceLoad:false);
            }else{await SoService.UpdateOrderAsync(header, UserSession.UserID);header=await SoService.GetOrderByIdAsync(OrderId)??header;details=await SoService.GetOrderDetailsAsync(OrderId);await ShowToastAsync("تم حفظ التعديلات ");}
        }catch(Exception ex){await ShowToastAsync("خطأ: "+ex.Message,false);}
        finally{isSaving=false;}
    }
    private async Task SubmitForApproval(){if(!details.Any()){await ShowToastAsync("أضف أصناف أولاً",false);activeTab=2;return;}isSaving=true;StateHasChanged();try{await SoService.SubmitForApprovalAsync(OrderId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);header.OrderStatus=2;await ShowToastAsync("تم الإرسال للاعتماد ");}catch(Exception ex){await ShowToastAsync("خطأ: "+ex.Message,false);}finally{isSaving=false;}}
    private async Task ExecuteApprove(){var confirmed=await JS.InvokeAsync<bool>("confirm","هل تريد اعتماد أمر البيع؟");if(!confirmed)return;isSaving=true;StateHasChanged();try{await SoService.ApproveAsync(OrderId, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);header.OrderStatus=3;await ShowToastAsync("تم الاعتماد ");await Task.Delay(1200);Navigation.NavigateTo("/sales-orders");}catch(Exception ex){await ShowToastAsync("خطأ: "+ex.Message,false);}finally{isSaving=false;}}
    private void DoShowReject(){rejectReason="";rejectMsg="";showRejectDialog=true;}
    private async Task ConfirmReject(){if(string.IsNullOrWhiteSpace(rejectReason)){rejectMsg="أدخل سبب الرفض";return;}try{await SoService.RejectAsync(OrderId, rejectReason, UserSession.CurrentUserID, UserSession.CurrentEmployeeID);header.OrderStatus=4;header.RejectionReason=rejectReason;showRejectDialog=false;await ShowToastAsync("تم رفض أمر البيع",false);await Task.Delay(1200);Navigation.NavigateTo("/sales-orders");}catch(Exception ex){rejectMsg="خطأ: "+ex.Message;}}
    private void ShowAddLine(){isEditLine=false;editLine=new(){SalesOrderID=OrderId,TaxRate=14};lineMsg="";showLineForm=true;}
    private void ShowEditLine(SalesOrderDetailDto line){isEditLine=true;editLine=new(){SODetailID=line.SODetailID,SalesOrderID=line.SalesOrderID,ItemID=line.ItemID,ItemCode=line.ItemCode,ItemNameAr=line.ItemNameAr,UnitID=line.UnitID,UnitName=line.UnitName,OrderedQty=line.OrderedQty,UnitPrice=line.UnitPrice,DiscountPercent=line.DiscountPercent,TaxRate=line.TaxRate,ExpectedDate=line.ExpectedDate,Notes=line.Notes,QuotationDetailID=line.QuotationDetailID,QuotationQty=line.QuotationQty,QuotationRemaining=line.QuotationRemaining};lineMsg="";showLineForm=true;}
    private void CloseLineForm(){showLineForm=false;lineMsg="";}
    private async Task SaveLine()
    {
        lineMsg="";if(editLine.ItemID==0){lineMsg="اختر الصنف";lineMsgOk=false;return;}if(editLine.UnitID==0){lineMsg="اختر الوحدة";lineMsgOk=false;return;}if(editLine.OrderedQty<=0){lineMsg="أدخل الكمية";lineMsgOk=false;return;}if(editLine.UnitPrice<0){lineMsg="السعر يجب أن يكون 0 أو أكبر";lineMsgOk=false;return;}
        if(isNewMode&&OrderId==0){await SaveOrder();if(OrderId==0)return;editLine.SalesOrderID=OrderId;}
        isSavingLine=true;StateHasChanged();
        try{
            if(isEditLine)await SoService.UpdateDetailAsync(editLine, UserSession.UserID);else await SoService.InsertDetailAsync(editLine, UserSession.UserID);
            details=await SoService.GetOrderDetailsAsync(OrderId);header=await SoService.GetOrderByIdAsync(OrderId)??header;showLineForm=false;await ShowToastAsync(isEditLine?"تم التحديث ":"تم الإضافة ");
        }catch(Exception ex){lineMsg="خطأ: "+ex.Message;lineMsgOk=false;}
        finally{isSavingLine=false;}
    }
    private async Task DeleteLine(int detailId){try{await SoService.DeleteDetailAsync(detailId, UserSession.UserID);details=await SoService.GetOrderDetailsAsync(OrderId);header=await SoService.GetOrderByIdAsync(OrderId)??header;await ShowToastAsync("تم الحذف ");}catch(Exception ex){await ShowToastAsync("خطأ: "+ex.Message,false);}}
    private async Task PrintDoc(){try{var html=await SoService.GenerateReportHtmlAsync(OrderId, UserSession.UserID);await JS.InvokeVoidAsync("printHtml", html);}catch(Exception ex){await ShowToastAsync("خطأ: "+ex.Message,false);}}
    private void CreateInvoice(){Navigation.NavigateTo($"/sales-invoices/new?source=order&orderId={OrderId}");}
    private void GoBack()=>Navigation.NavigateTo("/sales-orders");
    private async Task ShowToastAsync(string message, bool ok=true){toast=message;toastOk=ok;StateHasChanged();await Task.Delay(4000);toast="";StateHasChanged();}
}
