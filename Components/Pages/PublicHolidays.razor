@code {
    private ModulePermissionDto? permissions;
    private List<PublicHolidayListDto> holidays = new();
    private List<PublicHolidayListDto> filteredHolidays = new();
    
    // Filters
    private string searchText = "";
    private int selectedYear = 0;
    private string recurringFilter = "all";
    private string sortColumn = "HolidayDate";
    private bool sortAsc = true;
    
    // UI State
    private bool isLoading = true;
    private bool isDeleting = false;
    private bool isExporting = false;
    private bool showCalendar = false;
    
    // Calendar
    private DateTime currentMonth = DateTime.Today;
    
    // Dropdown
    private int? activeDropdownId = null;
    
    // Delete Dialog
    private bool showDeleteDialog = false;
    private PublicHolidayListDto? selectedItem;
    private string dialogMessage = "";
    
    // Toast
    private string resultMessage = "";
    private bool resultSuccess = true;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_ATTEND");
        if (permissions == null || !permissions.CanView) { isLoading = false; return; }
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try 
        { 
            holidays = await HolidayService.GetHolidaysListAsync();
            ApplyFilters();
        }
        catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
        finally { isLoading = false; }
    }

    private void ApplyFilters()
    {
        var query = holidays.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var search = searchText.Trim();
            query = query.Where(h => 
                (h.HolidayNameAr ?? "").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                (h.Notes ?? "").Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (selectedYear > 0)
        {
            query = query.Where(h => h.HolidayDate.Year == selectedYear);
        }

        query = recurringFilter switch
        {
            "recurring" => query.Where(h => h.IsRecurring),
            "once" => query.Where(h => !h.IsRecurring),
            _ => query
        };

        filteredHolidays = ApplySort(query).ToList();
    }

    private IEnumerable<PublicHolidayListDto> ApplySort(IEnumerable<PublicHolidayListDto> data)
    {
        return sortColumn switch
        {
            "HolidayNameAr" => sortAsc ? data.OrderBy(h => h.HolidayNameAr) : data.OrderByDescending(h => h.HolidayNameAr),
            "HolidayDate" => sortAsc ? data.OrderBy(h => h.HolidayDate) : data.OrderByDescending(h => h.HolidayDate),
            _ => data.OrderBy(h => h.HolidayDate)
        };
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }
        ApplyFilters();
    }

    private string SortIcon(string column)
    {
        if (sortColumn != column) return "";
        return sortAsc ? "▲" : "▼";
    }

    private void ClearSearch()
    {
        searchText = "";
        ApplyFilters();
    }

    private void ResetFilters()
    {
        searchText = "";
        selectedYear = 0;
        recurringFilter = "all";
        ApplyFilters();
    }

    private bool HasActiveFilters()
    {
        return !string.IsNullOrEmpty(searchText) || selectedYear > 0 || recurringFilter != "all";
    }

    private int GetUpcomingHolidaysCount()
    {
        var today = DateTime.Today;
        return holidays.Count(h => h.HolidayDate >= today);
    }

    private int GetCurrentYearHolidaysCount()
    {
        var currentYear = DateTime.Now.Year;
        return holidays.Count(h => h.HolidayDate.Year == currentYear);
    }

    private void ToggleCalendar(bool show)
    {
        showCalendar = show;
        currentMonth = DateTime.Today;
    }

    private void ChangeMonth(int delta)
    {
        currentMonth = currentMonth.AddMonths(delta);
    }

    private List<CalendarDay> GetCalendarDays()
    {
        var days = new List<CalendarDay>();
        var firstDayOfMonth = new DateTime(currentMonth.Year, currentMonth.Month, 1);
        var startDate = firstDayOfMonth.AddDays(-(int)firstDayOfMonth.DayOfWeek);
        
        for (int i = 0; i < 42; i++)
        {
            var date = startDate.AddDays(i);
            days.Add(new CalendarDay
            {
                Date = date,
                IsCurrentMonth = date.Month == currentMonth.Month
            });
        }
        return days;
    }

    private bool IsHolidayDate(DateTime date)
    {
        return holidays.Any(h => h.HolidayDate == date || (h.IsRecurring && h.HolidayDate.Day == date.Day && h.HolidayDate.Month == date.Month));
    }

    private string GetHolidayName(DateTime date)
    {
        var holiday = holidays.FirstOrDefault(h => h.HolidayDate == date || (h.IsRecurring && h.HolidayDate.Day == date.Day && h.HolidayDate.Month == date.Month));
        return holiday?.HolidayNameAr ?? "";
    }

    private void ToggleDropdown(int id)
    {
        activeDropdownId = activeDropdownId == id ? null : id;
    }

    private void GoToAdd() => Navigation.NavigateTo("/holidays/new");
    private void GoToEdit(int id) => Navigation.NavigateTo($"/holidays/edit/{id}");
    private void GoToView(int id) => Navigation.NavigateTo($"/holidays/view/{id}");

    private void ShowDeleteConfirm(PublicHolidayListDto item) 
    { 
        selectedItem = item; 
        dialogMessage = ""; 
        showDeleteDialog = true; 
    }
    
    private void CloseDeleteDialog() 
    { 
        showDeleteDialog = false; 
        selectedItem = null; 
        dialogMessage = ""; 
    }

    // ========== FIXED METHOD ==========
    private async Task ConfirmDelete()
    {
        if (selectedItem == null) return;
        isDeleting = true; 
        dialogMessage = "";
        
        try 
        {
            // Execute delete without blocking (fire and forget)
            _ = Task.Run(() => HolidayService.DeleteHolidayAsync(selectedItem.HolidayID, UserSession.UserID));
            
            resultMessage = $"تم حذف العطلة: {selectedItem.HolidayNameAr} ✅"; 
            resultSuccess = true;
            showDeleteDialog = false; 
            selectedItem = null;
            
            // Small delay to allow delete to complete
            await Task.Delay(300);
            await LoadData();
        } 
        catch (Exception ex) 
        { 
            dialogMessage = "خطأ: " + ex.Message; 
        }
        finally 
        { 
            isDeleting = false; 
        }
    }

    private async Task ExportToExcel()
    {
        if (!filteredHolidays.Any()) 
        {
            resultMessage = "لا توجد بيانات للتصدير";
            resultSuccess = false;
            return;
        }

        isExporting = true;
        try
        {
            using var stream = new MemoryStream();
            using var writer = new StreamWriter(stream);
            
            await writer.WriteLineAsync("المناسبة,التاريخ,اليوم,النوع,ملاحظات");
            
            foreach (var holiday in filteredHolidays)
            {
                var dayName = GetDayName(holiday.HolidayDate.DayOfWeek);
                var type = holiday.IsRecurring ? "متكررة سنوياً" : "مرة واحدة";
                var notes = holiday.Notes ?? "";
            await writer.WriteLineAsync($"\"{holiday.HolidayNameAr}\",{holiday.HolidayDate:yyyy-MM-dd},{dayName},{type},\"{notes}\"");
            }
            
            await writer.FlushAsync();
            var bytes = stream.ToArray();
            var base64 = Convert.ToBase64String(bytes);
            
            await JS.InvokeVoidAsync("downloadFile", $"Holidays_{DateTime.Now:yyyyMMdd_HHmmss}.csv", "text/csv", base64);
            resultMessage = $"تم تصدير {filteredHolidays.Count} عطلة بنجاح ✅";
            resultSuccess = true;
        }
        catch (Exception ex)
        {
            resultMessage = "خطأ في التصدير: " + ex.Message;
            resultSuccess = false;
        }
        finally
        {
            isExporting = false;
        }
    }

    private string GetDayName(DayOfWeek day) => day switch
    {
        DayOfWeek.Sunday => "الأحد",
        DayOfWeek.Monday => "الاثنين",
        DayOfWeek.Tuesday => "الثلاثاء",
        DayOfWeek.Wednesday => "الأربعاء",
        DayOfWeek.Thursday => "الخميس",
        DayOfWeek.Friday => "الجمعة",
        DayOfWeek.Saturday => "السبت",
        _ => ""
    };

    private class CalendarDay
    {
        public DateTime Date { get; set; }
        public bool IsCurrentMonth { get; set; }
    }
}