@page "/change-password"
@layout YKCoatings.Components.Layout.EmptyLayout
@using YKCoatings.Services
@inject UserSessionService UserSession
@inject UserService UserService
@inject NavigationManager Navigation
@inject LoginHistoryService LoginHistoryService
@using YKCoatings.Models

<PageTitle>تغيير كلمة المرور - واي كي كوتينج</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap');

    .chpwd-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #060b16 0%, #0b1526 30%, #123a6b 60%, #0b1526 100%);
        font-family: 'Cairo', sans-serif;
        direction: rtl;
        padding: 20px;
    }

    .chpwd-card {
        background: rgba(255,255,255,.03);
        backdrop-filter: blur(40px);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 28px;
        padding: 48px 40px;
        width: 100%;
        max-width: 460px;
        box-shadow: 0 32px 64px rgba(0,0,0,.4);
        position: relative;
        overflow: hidden;
        animation: slideUp .6s cubic-bezier(.16,1,.3,1);
    }

    .chpwd-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(37,99,235,.5), transparent);
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(30px) scale(.97); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }

    .chpwd-header {
        text-align: center;
        margin-bottom: 36px;
    }

    .chpwd-icon {
        width: 80px;
        height: 80px;
        border-radius: 22px;
        background: linear-gradient(135deg, #1d4ed8, #93c5fd);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        box-shadow: 0 12px 40px rgba(37,99,235,.4);
    }

    .chpwd-icon svg { width: 40px; height: 40px; color: white; }

    .chpwd-title {
        font-size: 1.5rem;
        font-weight: 800;
        background: linear-gradient(135deg, #fff, #bfdbfe);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 8px;
    }

    .chpwd-subtitle {
        font-size: .84rem;
        color: rgba(255,255,255,.4);
        line-height: 1.6;
    }

    .chpwd-reason {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 12px;
        margin-bottom: 28px;
        font-size: .82rem;
        font-weight: 600;
    }

    .reason-first {
        background: rgba(37,99,235,.12);
        border: 1px solid rgba(37,99,235,.25);
        color: #bfdbfe;
    }

    .reason-expired {
        background: rgba(245,158,11,.12);
        border: 1px solid rgba(245,158,11,.25);
        color: #fcd34d;
    }

    .chpwd-reason svg { width: 18px; height: 18px; flex-shrink: 0; }

    .field-group { margin-bottom: 20px; }
    .field-label {
        display: block;
        font-size: .8rem;
        font-weight: 600;
        color: rgba(255,255,255,.5);
        margin-bottom: 10px;
    }

    .field-wrapper {
        display: flex;
        align-items: center;
        background: rgba(255,255,255,.04);
        border: 1.5px solid rgba(255,255,255,.08);
        border-radius: 14px;
        transition: all .3s;
        overflow: hidden;
    }

    .field-wrapper:focus-within {
        border-color: rgba(37,99,235,.6);
        background: rgba(37,99,235,.05);
        box-shadow: 0 0 0 4px rgba(37,99,235,.1);
    }

    .field-icon {
        width: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(255,255,255,.25);
        flex-shrink: 0;
        transition: color .3s;
    }

    .field-wrapper:focus-within .field-icon { color: rgba(37,99,235,.8); }
    .field-icon svg { width: 20px; height: 20px; }

    .field-input {
        flex: 1;
        background: transparent;
        border: none;
        outline: none;
        padding: 15px 15px 15px 0;
        font-size: .9rem;
        font-weight: 500;
        color: rgba(255,255,255,.9);
        font-family: 'Cairo', sans-serif;
    }

    .field-input::placeholder { color: rgba(255,255,255,.2); }

    .toggle-pwd {
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        border: none;
        color: rgba(255,255,255,.25);
        cursor: pointer;
        border-radius: 10px;
        margin: 3px;
        transition: all .2s;
    }
    .toggle-pwd:hover { background: rgba(255,255,255,.06); color: rgba(37,99,235,.8); }
    .toggle-pwd svg { width: 18px; height: 18px; }

    /* Password Strength */
    .pwd-strength { margin-top: 10px; }
    .pwd-strength-bar {
        height: 4px;
        background: rgba(255,255,255,.1);
        border-radius: 4px;
        overflow: hidden;
        margin-bottom: 6px;
    }
    .pwd-strength-fill {
        height: 100%;
        border-radius: 4px;
        transition: all .3s;
    }
    .strength-0 { width: 0%; background: #ef4444; }
    .strength-1 { width: 25%; background: #ef4444; }
    .strength-2 { width: 50%; background: #f59e0b; }
    .strength-3 { width: 75%; background: #2563eb; }
    .strength-4 { width: 100%; background: #22c55e; }
    .pwd-strength-label { font-size: .72rem; color: rgba(255,255,255,.35); }

    /* Hints */
    .pwd-hints { margin-top: 16px; margin-bottom: 8px; }
    .pwd-hint {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: .76rem;
        color: rgba(255,255,255,.3);
        padding: 3px 0;
        transition: color .2s;
    }
    .pwd-hint.ok { color: #86efac; }
    .pwd-hint-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
        flex-shrink: 0;
    }

    /* Alert */
    .alert-modern {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 16px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-size: .82rem;
        font-weight: 600;
        animation: alertIn .3s ease;
    }
    @@keyframes alertIn { from { opacity: 0; transform: translateY(-8px); } }
    .alert-error { background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.2); color: #fca5a5; }
    .alert-success { background: rgba(34,197,94,.12); border: 1px solid rgba(34,197,94,.2); color: #86efac; }
    .alert-modern svg { width: 18px; height: 18px; flex-shrink: 0; }

    /* Submit Button */
    .submit-btn {
        width: 100%;
        padding: 15px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #1d4ed8, #2563eb, #93c5fd);
        color: white;
        font-size: .95rem;
        font-weight: 700;
        font-family: 'Cairo', sans-serif;
        cursor: pointer;
        transition: all .3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 8px;
        box-shadow: 0 8px 32px rgba(37,99,235,.35);
    }
    .submit-btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(37,99,235,.5); }
    .submit-btn:disabled { opacity: .6; cursor: not-allowed; }
    .submit-btn svg { width: 18px; height: 18px; }

    .btn-spinner {
        width: 20px;
        height: 20px;
        border: 2.5px solid rgba(255,255,255,.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin .7s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    /* Logout link */
    .logout-link {
        text-align: center;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid rgba(255,255,255,.06);
    }
    .logout-btn {
        background: none;
        border: none;
        color: rgba(255,255,255,.25);
        font-size: .78rem;
        font-family: 'Cairo', sans-serif;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: color .2s;
    }
    .logout-btn:hover { color: rgba(239,68,68,.7); }
    .logout-btn svg { width: 14px; height: 14px; }
</style>

<div class="chpwd-page">
    <div class="chpwd-card">

        <!-- الهيدر -->
        <div class="chpwd-header">
            <div class="chpwd-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    <circle cx="12" cy="16" r="1"/>
                </svg>
            </div>
            <h1 class="chpwd-title">تغيير كلمة المرور</h1>
            <p class="chpwd-subtitle">
                مرحباً @UserSession.FullName<br/>
                يرجى تعيين كلمة مرور جديدة للمتابعة
            </p>
        </div>

        <!-- سبب الإجبار -->
        @if (UserSession.PasswordExpired)
        {
            <div class="chpwd-reason reason-expired">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span>انتهت صلاحية كلمة المرور، يجب تغييرها للمتابعة</span>
            </div>
        }
        else
        {
            <div class="chpwd-reason reason-first">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span>يجب تغيير كلمة المرور المؤقتة قبل الدخول للنظام</span>
            </div>
        }

        <!-- رسالة -->
        @if (!string.IsNullOrEmpty(_message))
        {
            <div class="alert-modern @(_isError ? "alert-error" : "alert-success")">
                @if (_isError)
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="15" y1="9" x2="9" y2="15"/>
                        <line x1="9" y1="9" x2="15" y2="15"/>
                    </svg>
                }
                else
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                }
                <span>@_message</span>
            </div>
        }

        <!-- كلمة المرور الجديدة -->
        <div class="field-group">
            <label class="field-label">كلمة المرور الجديدة</label>
            <div class="field-wrapper">
                <div class="field-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                </div>
                <input type="@(_showNew ? "text" : "password")"
                       class="field-input"
                       @bind="_newPassword"
                       @bind:event="oninput"
                       placeholder="أدخل كلمة المرور الجديدة"
                       disabled="@_saving" />
                <button class="toggle-pwd" type="button" tabindex="-1"
                        @onclick="@(() => _showNew = !_showNew)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        @if (_showNew)
                        {
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        }
                        else
                        {
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        }
                    </svg>
                </button>
            </div>

            <!-- قوة كلمة المرور -->
            @if (!string.IsNullOrEmpty(_newPassword))
            {
                <div class="pwd-strength">
                    <div class="pwd-strength-bar">
                        <div class="pwd-strength-fill strength-@_passwordStrength"></div>
                    </div>
                    <span class="pwd-strength-label">@GetStrengthLabel()</span>
                </div>
            }
        </div>

        <!-- تأكيد كلمة المرور -->
        <div class="field-group">
            <label class="field-label">تأكيد كلمة المرور</label>
            <div class="field-wrapper">
                <div class="field-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="11" width="18" height="11" rx="2"/>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                </div>
                <input type="@(_showConfirm ? "text" : "password")"
                       class="field-input"
                       @bind="_confirmPassword"
                       @bind:event="oninput"
                       @onkeydown="HandleKeyDown"
                       placeholder="أعد إدخال كلمة المرور"
                       disabled="@_saving" />
                <button class="toggle-pwd" type="button" tabindex="-1"
                        @onclick="@(() => _showConfirm = !_showConfirm)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        @if (_showConfirm)
                        {
                            <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
                            <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
                            <line x1="1" y1="1" x2="23" y2="23"/>
                        }
                        else
                        {
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        }
                    </svg>
                </button>
            </div>
        </div>

        <!-- متطلبات كلمة المرور -->
        <div class="pwd-hints">
            <div class="pwd-hint @(_newPassword.Length >= 8 ? "ok" : "")">
                <div class="pwd-hint-dot"></div>
                <span>8 أحرف على الأقل</span>
            </div>
            <div class="pwd-hint @(HasUpperCase() ? "ok" : "")">
                <div class="pwd-hint-dot"></div>
                <span>حرف كبير واحد على الأقل</span>
            </div>
            <div class="pwd-hint @(HasNumber() ? "ok" : "")">
                <div class="pwd-hint-dot"></div>
                <span>رقم واحد على الأقل</span>
            </div>
            <div class="pwd-hint @(PasswordsMatch() ? "ok" : "")">
                <div class="pwd-hint-dot"></div>
                <span>كلمة المرور وتأكيدها متطابقتان</span>
            </div>
        </div>

        <!-- زر الحفظ -->
        <button class="submit-btn" @onclick="DoChangePassword" disabled="@_saving">
            @if (_saving)
            {
                <div class="btn-spinner"></div>
                <span>جاري الحفظ...</span>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                    <polyline points="17 21 17 13 7 13 7 21"/>
                    <polyline points="7 3 7 8 15 8"/>
                </svg>
                <span>حفظ كلمة المرور</span>
            }
        </button>

        <!-- تسجيل الخروج -->
        <div class="logout-link">
            <button class="logout-btn" @onclick="DoLogout">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                <span>تسجيل الخروج بدلاً من ذلك</span>
            </button>
        </div>

    </div>
</div>

@code {
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _showNew = false;
    private bool _showConfirm = false;
    private bool _saving = false;
    private string _message = "";
    private bool _isError = false;
    private int _passwordStrength = 0;

    private bool _sessionChecked;

    // ️ بعد الرندر فقط — لأن الجلسة تُسترجَع من ProtectedSessionStorage عبر JS Interop
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionChecked) return;
        _sessionChecked = true;

        // لو مش logged in → login
        if (!await UserSession.EnsureRestoredAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        // لو مش محتاج تغيير → dashboard
        if (!UserSession.RequiresPasswordChange)
        {
            Navigation.NavigateTo("/dashboard");
        }
    }

    // ══════════════════════════════════════
    // تغيير كلمة المرور
    // ══════════════════════════════════════
    private async Task DoChangePassword()
    {
        _message = "";

        // التحقق من المتطلبات
        if (string.IsNullOrWhiteSpace(_newPassword))
        { ShowError("يجب إدخال كلمة المرور الجديدة"); return; }

        if (_newPassword.Length < 8)
        { ShowError("كلمة المرور يجب أن تكون 8 أحرف على الأقل"); return; }

        if (!HasUpperCase())
        { ShowError("كلمة المرور يجب أن تحتوي على حرف كبير واحد على الأقل"); return; }

        if (!HasNumber())
        { ShowError("كلمة المرور يجب أن تحتوي على رقم واحد على الأقل"); return; }

        if (_newPassword != _confirmPassword)
        { ShowError("كلمة المرور وتأكيدها غير متطابقتين"); return; }

        try
        {
            _saving = true;
            StateHasChanged();

            var dto = new UserPasswordDto
            {
                UserID = UserSession.UserID,
                NewPassword = _newPassword,
                ConfirmPassword = _confirmPassword,
                MustChangeOnLogin = false
            };

            await UserService.ResetPasswordAsync(dto, UserSession.CurrentUserID);

            // مسح إجبار التغيير من الجلسة
            await UserSession.ClearPasswordChangeRequirementAsync();

            // تحميل الصلاحيات
            // (هنا نحمل الصلاحيات لأن أول مرة لم تكن محملة بعد)
            ShowSuccess("تم تغيير كلمة المرور بنجاح، جاري الدخول...");
            StateHasChanged();

            await Task.Delay(1200);
            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
{
    if (e.Key == "Enter")
        await DoChangePassword();
}

    private async Task DoLogout()
{
    try
    {
        if (UserSession.UserID > 0)
            await LoginHistoryService.RecordLogoutAsync(UserSession.UserID);
    }
    catch { }

    await UserSession.LogoutAsync();
    Navigation.NavigateTo("/login");
}

    // ══════════════════════════════════════
    // قوة كلمة المرور
    // ══════════════════════════════════════
    private void CalculateStrength()
    {
        int score = 0;
        if (_newPassword.Length >= 8) score++;
        if (_newPassword.Length >= 12) score++;
        if (HasUpperCase()) score++;
        if (HasNumber()) score++;
        _passwordStrength = score;
    }

    private string GetStrengthLabel() => _passwordStrength switch
    {
        0 or 1 => "ضعيفة جداً",
        2 => "متوسطة",
        3 => "جيدة",
        4 => "قوية ✓",
        _ => ""
    };

    protected override void OnParametersSet()
    {
        CalculateStrength();
    }

    // ══════════════════════════════════════
    // Helpers
    // ══════════════════════════════════════
    private bool HasUpperCase() =>
        _newPassword.Any(char.IsUpper);

    private bool HasNumber() =>
        _newPassword.Any(char.IsDigit);

    private bool PasswordsMatch() =>
        !string.IsNullOrEmpty(_newPassword) &&
        !string.IsNullOrEmpty(_confirmPassword) &&
        _newPassword == _confirmPassword;

    private void ShowSuccess(string msg) { _message = msg; _isError = false; }
    private void ShowError(string msg) { _message = msg; _isError = true; }
}