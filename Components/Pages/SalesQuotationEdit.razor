@code {
    [Parameter] public int QuotationId { get; set; }

    private ModulePermissionDto? permissions;
    private SalesQuotationHeaderDto header = new();
    private SalesQuotationCustomerContactDto? sendContact;
    private List<SalesQuotationDetailDto> details = new();
    private List<SearchableItem> customers = new();
    private List<SearchableItem> saleItems = new();
    private List<LookupDto> units = new();
    private List<LookupDto> salesReps = new();
    private SalesQuotationDetailDto editLine = new();
    private int salesRepValue
    {
        get => header.SalesRepID ?? 0;
        set => header.SalesRepID = value > 0 ? value : null;
    }
    private string pageTitle = "عرض سعر جديد";
    private string loadError = string.Empty;
    private string lineError = string.Empty;
    private string rejectReason = string.Empty;
    private string rejectError = string.Empty;
    private string sendChannel = "WhatsApp";
    private string sendRecipient = string.Empty;
    private string sendMessage = string.Empty;
    private string sendError = string.Empty;
    private bool sendComposerOpened;
    private string toastMessage = string.Empty;
    private bool toastSuccess = true;
    private bool isLoading = true;
    private bool isSaving;
    private bool isApproving;
    private bool showLineDialog;
    private bool showRejectDialog;
    private bool showSendDialog;
    private bool isEditingLine;
    private bool isNewMode;
    private bool isViewMode;

    private bool CanModify => permissions is not null && !isViewMode &&
        (isNewMode ? permissions.CanAdd : header.QuotationStatus == 1 && permissions.CanEdit);
    private bool isBusy => isSaving || isApproving;
    private decimal GrossTotal => Math.Round(details.Sum(x => x.Quantity * x.UnitPrice), 2, MidpointRounding.AwayFromZero);
    private decimal DiscountTotal => Math.Round(details.Sum(x => x.DiscountAmount), 2, MidpointRounding.AwayFromZero);
    private decimal SubTotal => Math.Round(details.Sum(x => x.LineTotal), 2, MidpointRounding.AwayFromZero);
    private decimal TaxTotal => Math.Round(details.Sum(x => x.TaxAmount), 2, MidpointRounding.AwayFromZero);
    private decimal GrandTotal => Math.Round(details.Sum(x => x.LineTotalWithTax), 2, MidpointRounding.AwayFromZero);
    private bool CanOpenSendComposer => string.Equals(sendChannel, "Email", StringComparison.OrdinalIgnoreCase)
        ? sendRecipient.Trim().IndexOf('@') > 0 && sendRecipient.Trim().LastIndexOf('.') > sendRecipient.Trim().IndexOf('@') + 1
        : GetAsciiPhoneDigits(sendRecipient).Length >= 8;

    private static string GetAsciiPhoneDigits(string? value) =>
        new((value ?? string.Empty).Where(character => character is >= '0' and <= '9').ToArray());

    private string BuildSendMessage()
    {
        var customerName = string.IsNullOrWhiteSpace(header.CustomerNameAr) ? "السادة الكرام" : header.CustomerNameAr.Trim();
        var validUntil = header.ValidUntilDate.HasValue
            ? $"وصالح حتى {header.ValidUntilDate.Value:dd/MM/yyyy}.\n"
            : string.Empty;
        var total = header.TotalAmount.ToString("#,##0.00", CultureInfo.GetCultureInfo("en-US"));
        return $"السلام عليكم {customerName}،\nنرفق لكم عرض السعر رقم {header.QuotationNumber}.\nالإجمالي شامل الضريبة: {total} ج.م.\n{validUntil}نشكركم على ثقتكم، ونسعد بخدمتكم.";
    }

    private string GetSendComposeUrl()
    {
        var encodedMessage = Uri.EscapeDataString(sendMessage);
        if (string.Equals(sendChannel, "Email", StringComparison.OrdinalIgnoreCase))
        {
            var subject = Uri.EscapeDataString($"عرض سعر رقم {header.QuotationNumber}");
            var recipient = sendRecipient.Trim();
            var atIndex = recipient.IndexOf('@');
            var safeAddress = Uri.EscapeDataString(recipient[..atIndex]) + "@" + Uri.EscapeDataString(recipient[(atIndex + 1)..]);
            return $"mailto:{safeAddress}?subject={subject}&body={encodedMessage}";
        }

        var phone = GetAsciiPhoneDigits(sendRecipient);
        return $"https://wa.me/{phone}?text={encodedMessage}";
    }

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_QUOT");
        isNewMode = QuotationId <= 0;
        var route = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0];
        isViewMode = route.StartsWith("quotations/view/", StringComparison.OrdinalIgnoreCase);
        pageTitle = isNewMode ? "عرض سعر جديد" : "تفاصيل عرض السعر";

        if (permissions?.CanView != true || (isNewMode && permissions.CanAdd != true))
        {
            isLoading = false;
            return;
        }

        try
        {
            await LoadLookupsAsync();
            if (!isNewMode)
            {
                header = await QuotationService.GetQuotationByIdAsync(QuotationId)
                    ?? throw new InvalidOperationException("عرض السعر غير موجود");
                details = await QuotationService.GetQuotationDetailsAsync(QuotationId);
                pageTitle = isViewMode ? "عرض تفاصيل عرض السعر"
                    : header.QuotationStatus == 2 && permissions.CanApprove ? "مراجعة واعتماد عرض السعر"
                    : header.QuotationStatus == 1 && permissions.CanEdit ? "تعديل عرض السعر"
                    : "تفاصيل عرض السعر";
            }
            else
            {
                header = new SalesQuotationHeaderDto
                {
                    QuotationDate = DateTime.Today,
                    QuotationStatus = 1
                };
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadLookupsAsync()
    {
        customers = await LookupService.GetCustomersSearchableAsync();
        saleItems = await LookupService.GetItemsForSaleSearchableAsync();
        units = await LookupService.GetUnitsAsync();
        try { salesReps = await LookupService.GetSalesRepsAsync(); }
        catch { salesReps = new List<LookupDto>(); }
    }

    private Task OnCustomerSelected(SearchableItem? item)
    {
        header.CustomerID = item?.Id ?? 0;
        header.CustomerNameAr = item?.Name;
        header.CustomerCode = item?.Code;
        return Task.CompletedTask;
    }

    private async Task OnItemSelected(SearchableItem? item)
    {
        if (item is null)
        {
            editLine.ItemID = 0;
            editLine.ItemCode = null;
            editLine.ItemNameAr = null;
            return;
        }

        editLine.ItemID = item.Id;
        editLine.ItemCode = item.Code;
        editLine.ItemNameAr = item.Name;
        try
        {
            var info = await LookupService.GetItemQuickInfoAsync(item.Id);
            if (info is not null)
            {
                if (info.UnitID > 0) editLine.UnitID = info.UnitID;
                if (info.SalesPrice > 0) editLine.UnitPrice = info.SalesPrice;
            }
            else if (decimal.TryParse(item.Extra, NumberStyles.Any, CultureInfo.InvariantCulture, out var price))
            {
                editLine.UnitPrice = price;
            }

            editLine.UnitName = units.FirstOrDefault(x => x.Id == editLine.UnitID)?.Name;
        }
        catch (Exception ex)
        {
            await ShowToastAsync("تعذر تحميل بيانات الصنف: " + ex.Message, false);
        }
    }

    private void OpenNewLine()
    {
        if (!CanModify) return;
        isEditingLine = false;
        editLine = new SalesQuotationDetailDto { Quantity = 1m, TaxRate = 14m };
        lineError = string.Empty;
        showLineDialog = true;
    }

    private void EditLine(SalesQuotationDetailDto line)
    {
        if (!CanModify) return;
        isEditingLine = true;
        editLine = new SalesQuotationDetailDto
        {
            QuotationDetailID = line.QuotationDetailID,
            QuotationID = line.QuotationID,
            LineNumber = line.LineNumber,
            ItemID = line.ItemID,
            ItemCode = line.ItemCode,
            ItemNameAr = line.ItemNameAr,
            UnitID = line.UnitID,
            UnitName = line.UnitName,
            Quantity = line.Quantity,
            UnitPrice = line.UnitPrice,
            DiscountPercent = line.DiscountPercent,
            TaxRate = line.TaxRate,
            Notes = line.Notes
        };
        lineError = string.Empty;
        showLineDialog = true;
    }

    private void CloseLineDialog()
    {
        if (isBusy) return;
        showLineDialog = false;
        lineError = string.Empty;
    }

    private void SaveLine()
    {
        lineError = string.Empty;
        if (editLine.ItemID <= 0) { lineError = "اختر الصنف"; return; }
        if (editLine.UnitID <= 0) { lineError = "اختر الوحدة"; return; }
        if (editLine.Quantity <= 0) { lineError = "الكمية يجب أن تكون أكبر من صفر"; return; }
        if (editLine.UnitPrice < 0) { lineError = "سعر الوحدة لا يمكن أن يكون سالباً"; return; }
        if (editLine.DiscountPercent is < 0 or > 100) { lineError = "نسبة الخصم يجب أن تكون بين 0 و100"; return; }
        if (editLine.TaxRate is < 0 or > 100) { lineError = "معدل الضريبة يجب أن يكون بين 0 و100"; return; }

        editLine.UnitName = units.FirstOrDefault(x => x.Id == editLine.UnitID)?.Name;
        if (isEditingLine)
        {
            var index = details.FindIndex(x => x.QuotationDetailID == editLine.QuotationDetailID && x.QuotationDetailID > 0);
            if (index < 0) index = details.FindIndex(x => x.LineNumber == editLine.LineNumber);
            if (index >= 0) details[index] = editLine;
        }
        else
        {
            editLine.LineNumber = details.Count == 0 ? 1 : details.Max(x => x.LineNumber) + 1;
            details.Add(editLine);
        }
        RenumberLines();
        showLineDialog = false;
    }

    private void RemoveLine(SalesQuotationDetailDto line)
    {
        if (!CanModify) return;
        details.Remove(line);
        RenumberLines();
    }

    private void RenumberLines()
    {
        for (var index = 0; index < details.Count; index++) details[index].LineNumber = index + 1;
    }

    private async Task SaveDraft()
    {
        if (!CanModify || isBusy) return;
        var oldId = QuotationId;
        var savedId = await PersistAsync();
        if (!savedId.HasValue) return;
        await ShowToastAsync("تم حفظ المسودة");
        if (oldId <= 0) Navigation.NavigateTo($"/quotations/edit/{savedId.Value}", replace: true);
    }

    private async Task<int?> PersistAsync()
    {
        if (header.CustomerID <= 0)
        {
            await ShowToastAsync("اختر العميل أولاً", false);
            return null;
        }
        if (header.QuotationDate == default)
        {
            await ShowToastAsync("حدد تاريخ عرض السعر", false);
            return null;
        }

        isSaving = true;
        var wasNew = isNewMode;
        try
        {
            header.QuotationID = QuotationId;
            var savedId = await QuotationService.SaveQuotationAsync(header, details, UserSession.UserID);
            QuotationId = savedId;
            isNewMode = false;
            if (wasNew) pageTitle = "تفاصيل عرض السعر";
            header = await QuotationService.GetQuotationByIdAsync(savedId) ?? header;
            details = await QuotationService.GetQuotationDetailsAsync(savedId);
            return savedId;
        }
        catch (Exception ex)
        {
            await ShowToastAsync("تعذر حفظ العرض: " + ex.Message, false);
            return null;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SubmitForApproval()
    {
        if (!CanModify || details.Count == 0 || isBusy) return;
        var isNew = QuotationId <= 0;
        var savedId = await PersistAsync();
        if (!savedId.HasValue) return;

        isApproving = true;
        try
        {
            await QuotationService.SubmitForApprovalAsync(savedId.Value, UserSession.UserID);
            header.QuotationStatus = 2;
            header.SubmittedDate = DateTime.Now;
            await ShowToastAsync("تم إرسال عرض السعر للاعتماد");
            if (isNew) Navigation.NavigateTo($"/quotations/edit/{savedId.Value}", replace: true);
        }
        catch (Exception ex)
        {
            await ShowToastAsync("تعذر الإرسال للاعتماد: " + ex.Message, false);
        }
        finally
        {
            isApproving = false;
        }
    }

    private async Task ApproveQuotation()
    {
        if (permissions?.CanApprove != true || header.QuotationStatus != 2 || isBusy) return;
        isApproving = true;
        try
        {
            await QuotationService.ApproveAsync(QuotationId, UserSession.UserID);
            header.QuotationStatus = 3;
            header.ApprovedDate = DateTime.Now;
            pageTitle = "تفاصيل عرض السعر";
            await ShowToastAsync("تم اعتماد عرض السعر");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("تعذر اعتماد العرض: " + ex.Message, false);
        }
        finally
        {
            isApproving = false;
        }
    }

    private void OpenRejectDialog()
    {
        rejectReason = string.Empty;
        rejectError = string.Empty;
        showRejectDialog = true;
    }

    private void CloseRejectDialog()
    {
        if (isBusy) return;
        showRejectDialog = false;
        rejectError = string.Empty;
    }

    private async Task ConfirmReject()
    {
        if (string.IsNullOrWhiteSpace(rejectReason)) { rejectError = "أدخل سبب الرفض"; return; }
        isApproving = true;
        rejectError = string.Empty;
        try
        {
            await QuotationService.RejectAsync(QuotationId, rejectReason, UserSession.UserID);
            header.QuotationStatus = 4;
            header.RejectionReason = rejectReason.Trim();
            pageTitle = "تفاصيل عرض السعر";
            showRejectDialog = false;
            await ShowToastAsync("تم رفض عرض السعر وإشعار منشئه");
        }
        catch (Exception ex)
        {
            rejectError = ex.Message;
        }
        finally
        {
            isApproving = false;
        }
    }

    private async Task OpenSendDialog()
    {
        if (isBusy || header.QuotationStatus != 3 || (permissions?.CanEdit != true && permissions?.CanApprove != true)) return;
        isApproving = true;
        sendError = string.Empty;
        await InvokeAsync(StateHasChanged);
        string? error = null;
        try
        {
            var contact = await QuotationService.GetCustomerContactForManualSendAsync(QuotationId, UserSession.UserID);
            sendContact = contact;
            sendChannel = !string.IsNullOrWhiteSpace(contact.Phone) ? "WhatsApp" : "Email";
            sendRecipient = string.Equals(sendChannel, "Email", StringComparison.OrdinalIgnoreCase)
                ? contact.Email ?? string.Empty
                : contact.Phone ?? string.Empty;
            sendMessage = BuildSendMessage();
            sendComposerOpened = false;
            showSendDialog = true;
        }
        catch (Exception ex)
        {
            error = "تعذر تحميل بيانات التواصل للإرسال: " + ex.Message;
        }
        finally
        {
            isApproving = false;
        }
        if (error is not null) await ShowToastAsync(error, false);
    }

    private void OnSendChannelChanged(ChangeEventArgs args)
    {
        sendChannel = string.Equals(args.Value?.ToString(), "Email", StringComparison.OrdinalIgnoreCase)
            ? "Email"
            : "WhatsApp";
        sendRecipient = string.Equals(sendChannel, "Email", StringComparison.OrdinalIgnoreCase)
            ? sendContact?.Email ?? string.Empty
            : sendContact?.Phone ?? string.Empty;
        sendError = string.Empty;
        sendComposerOpened = false;
    }

    private void OnSendRecipientChanged() => sendComposerOpened = false;

    private void OnSendMessageChanged() => sendComposerOpened = false;

    private void OnSendComposerOpened()
    {
        sendComposerOpened = true;
        sendError = string.Empty;
    }

    private void CloseSendDialog()
    {
        if (isBusy) return;
        showSendDialog = false;
        sendError = string.Empty;
        sendContact = null;
        sendRecipient = string.Empty;
        sendMessage = string.Empty;
        sendComposerOpened = false;
    }

    private async Task ConfirmManualSend()
    {
        if (isBusy || header.QuotationStatus != 3 || (permissions?.CanEdit != true && permissions?.CanApprove != true)) return;
        if (!sendComposerOpened)
        {
            sendError = "افتح وسيلة الإرسال أولاً، ثم أكد بعد الإرسال الفعلي.";
            return;
        }
        if (!CanOpenSendComposer)
        {
            sendError = string.Equals(sendChannel, "Email", StringComparison.OrdinalIgnoreCase)
                ? "أدخل عنوان بريد إلكتروني صالحاً."
                : "أدخل رقم هاتف صالحاً، ويفضّل تضمين مفتاح الدولة لواتساب.";
            return;
        }

        isApproving = true;
        sendError = string.Empty;
        try
        {
            await QuotationService.MarkSentToCustomerAsync(
                QuotationId, UserSession.UserID, sendChannel, sendRecipient.Trim());
            header.QuotationStatus = 5;
            header.SentDate = DateTime.Now;
            pageTitle = "تفاصيل عرض السعر";
            showSendDialog = false;
            sendContact = null;
            sendRecipient = string.Empty;
            sendMessage = string.Empty;
            sendComposerOpened = false;
            await ShowToastAsync("تم تسجيل الإرسال اليدوي للعرض");
        }
        catch (Exception ex)
        {
            sendError = "تعذر تسجيل الإرسال: " + ex.Message;
        }
        finally
        {
            isApproving = false;
        }
    }

    private async Task DeleteCurrentDraft()
    {
        if (isBusy || permissions?.CanDelete != true || header.QuotationStatus != 1 || QuotationId <= 0) return;
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"هل تريد حذف المسودة {header.QuotationNumber}؟");
        if (!confirmed) return;
        isSaving = true;
        try
        {
            await QuotationService.DeleteQuotationAsync(QuotationId, UserSession.UserID);
            await ShowToastAsync("تم حذف المسودة");
            Navigation.NavigateTo("/quotations");
        }
        catch (Exception ex)
        {
            await ShowToastAsync("تعذر حذف المسودة: " + ex.Message, false);
        }
        finally
        {
            isSaving = false;
        }
    }

