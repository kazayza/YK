@page "/quotations/new"
@page "/quotations/edit/{QuotationId:int}"
@page "/quotations/view/{QuotationId:int}"

@using System.Globalization
@using YKCoatings.Services
@using YKCoatings.Models
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject SalesQuotationService QuotationService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="quotation-access" dir="rtl"><div class="quotation-access-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h3>يجب تسجيل الدخول أولاً</h3></div>
}
else if (permissions is null || !permissions.CanView || (isNewMode && !permissions.CanAdd))
{
    <div class="quotation-access" dir="rtl"><div class="quotation-access-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg></div><h3>ليس لديك صلاحية لفتح هذه الشاشة</h3><button class="quotation-btn secondary" @onclick="GoBack">العودة لعروض الأسعار</button></div>
}
else
{
    <main class="quotation-edit-page" dir="rtl">
        <header class="quotation-hero">
            <div class="quotation-hero-top"></div>
            <button class="quotation-back" @onclick="GoBack" aria-label="العودة لعروض الأسعار"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 12H5m7 7-7-7 7-7"/></svg><span>عروض الأسعار</span></button>
            <div class="quotation-hero-body">
                <div class="quotation-hero-symbol"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
                <div class="quotation-heading">
                    <div class="quotation-eyebrow">إدارة عروض العملاء <span>SCR_QUOT</span></div>
                    <h1>@pageTitle</h1>
                    <p>@(string.IsNullOrWhiteSpace(header.QuotationNumber) ? "أدخل بيانات العرض وأضف أصناف التسعير" : $"{header.QuotationNumber} · {header.CustomerNameAr ?? "لم يتم اختيار العميل"}")</p>
                </div>
                <div class="quotation-hero-actions">
                    @if (header.QuotationID > 0)
                    {
                        <span class="quotation-status-pill" style="--q-status:@SalesQuotationService.GetStatusColor(header.QuotationStatus)"><i></i>@SalesQuotationService.GetStatusName(header.QuotationStatus)</span>
                        @if (permissions.CanPrint)
                        {
                            <button class="quotation-btn header-quiet" @onclick="PrintDocument" disabled="@isBusy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 9V2h12v7"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>طباعة</button>
                        }
                    }
                    <span class="quotation-mode-tag">@(isNewMode ? "إنشاء جديد" : isViewMode ? "عرض فقط" : header.QuotationStatus == 2 && permissions.CanApprove ? "مراجعة واعتماد" : "تفاصيل العرض")</span>
                </div>
            </div>
        </header>

        <section class="quotation-steps" aria-label="مسار عرض السعر">
            <div class="quotation-step @(header.QuotationStatus == 1 ? "current" : "done")"><span class="quotation-step-no">1</span><span>إعداد العرض</span></div><span class="quotation-step-line"></span>
            <div class="quotation-step @(header.QuotationStatus == 2 ? "current" : (header.QuotationStatus == 3 || header.QuotationStatus == 5) ? "done" : "")"><span class="quotation-step-no">2</span><span>الاعتماد</span></div><span class="quotation-step-line"></span>
            <div class="quotation-step @(header.QuotationStatus == 5 ? "current done" : header.QuotationStatus == 3 ? "ready" : "")"><span class="quotation-step-no">3</span><span>الإرسال للعميل</span></div><span class="quotation-step-line"></span>
            <div class="quotation-step"><span class="quotation-step-no">4</span><span>أمر البيع</span></div>
        </section>

        @if (isLoading)
        {
            <div class="quotation-loading"><span class="quotation-spinner"></span><p>جاري تحميل بيانات العرض...</p></div>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <div class="quotation-error-banner" role="alert"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="10"/><path d="M12 8v4m0 4h.01"/></svg><span>@loadError</span></div>
        }
        else
        {
            @if (header.QuotationStatus == 2 && permissions.CanApprove && !isViewMode)
            {
                <section class="quotation-approval-banner">
                    <span class="approval-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3 4 6v5c0 5 3.4 8.5 8 10 4.6-1.5 8-5 8-10V6l-8-3Z"/><path d="m9 12 2 2 4-4"/></svg></span>
                    <div class="approval-copy"><strong>العرض بانتظار اعتمادك</strong><span>راجع العميل والأصناف والإجماليات قبل اتخاذ القرار.</span></div>
                    <div class="approval-actions"><button class="quotation-btn approve-btn" @onclick="ApproveQuotation" disabled="@isBusy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m5 12 4 4L19 6"/></svg>اعتماد</button><button class="quotation-btn reject-btn" @onclick="OpenRejectDialog" disabled="@isBusy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m18 6-12 12M6 6l12 12"/></svg>رفض</button></div>
                </section>
            }

            <section class="quotation-panel">
                <div class="quotation-panel-heading">
                    <span class="quotation-panel-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h5"/></svg></span>
                    <div><h2>البيانات الأساسية</h2><p>العميل والتواريخ والمرجع التجاري للعرض</p></div>
                </div>
                <div class="quotation-form-grid">
                    <div class="quotation-field wide">
                        <label class="required">العميل</label>
                        <SearchableSelect Items="@customers" @bind-SelectedId="header.CustomerID" OnSelected="OnCustomerSelected" Placeholder="ابحث باسم العميل أو كوده..." IsDisabled="@(!CanModify)" />
                    </div>
                    <div class="quotation-field"><label>رقم عرض السعر</label><input class="quotation-input ltr" value="@(header.QuotationNumber ?? "سيُنشأ عند الحفظ")" readonly /></div>
                    <div class="quotation-field"><label class="required">تاريخ العرض</label><input class="quotation-input" type="date" @bind="header.QuotationDate" disabled="@(!CanModify)" /></div>
                    <div class="quotation-field"><label>صالح حتى</label><input class="quotation-input" type="date" @bind="header.ValidUntilDate" disabled="@(!CanModify)" /></div>
                    <div class="quotation-field"><label>مندوب المبيعات</label><select class="quotation-input" @bind="salesRepValue" disabled="@(!CanModify)"><option value="0">بدون تعيين</option>@foreach (var representative in salesReps){<option value="@representative.Id">@representative.Name</option>}</select></div>
                    <div class="quotation-field wide"><label>ملاحظات وشروط العرض</label><textarea class="quotation-input quotation-textarea" @bind="header.Notes" disabled="@(!CanModify)" maxlength="2000" placeholder="اكتب أي ملاحظات أو شروط تخص هذا العرض..."></textarea></div>
                </div>
            </section>

            <section class="quotation-panel quotation-lines-panel">
                <div class="quotation-panel-heading quotation-lines-heading">
                    <span class="quotation-panel-icon items"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5M12 22V12"/></svg></span>
                    <div><h2>الأصناف والتسعير</h2><p>أضف البنود والكميات والأسعار والخصم والضريبة</p></div>
                    <span class="quotation-line-count">@details.Count صنف</span>
                    @if (CanModify)
                    {
                        <button class="quotation-btn add-line-btn" @onclick="OpenNewLine"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9"><path d="M12 5v14M5 12h14"/></svg>إضافة صنف</button>
                    }
                </div>

                @if (details.Count == 0)
                {
                    <div class="quotation-lines-empty"><div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16v16H4zM8 8h8M8 12h8M8 16h4"/></svg></div><strong>لم تتم إضافة أصناف</strong><span>@(CanModify ? "أضف أول صنف لاحتساب الإجماليات." : "لا توجد تفاصيل محفوظة في هذا العرض.")</span></div>
                }
                else
                {
                    <div class="quotation-table-scroll"><table class="quotation-lines-table"><thead><tr><th class="line-index">م</th><th>الصنف</th><th>الوحدة</th><th>الكمية</th><th>سعر الوحدة</th><th>خصم %</th><th>ضريبة %</th><th>الإجمالي شامل الضريبة</th>@if (CanModify){<th class="center">إجراءات</th>}</tr></thead><tbody>
                    @foreach (var line in details.OrderBy(x => x.LineNumber))
                    {
                        <tr>
                            <td class="line-index">@line.LineNumber</td>
                            <td><strong class="line-item-name">@line.ItemNameAr</strong><span class="line-item-code">@line.ItemCode</span></td>
                            <td>@(line.UnitName ?? "—")</td>
                            <td class="numeric">@line.Quantity.ToString("#,##0.####")</td>
                            <td class="numeric">@line.UnitPrice.ToString("#,##0.00")</td>
                            <td class="numeric">@line.DiscountPercent.ToString("0.##")%</td>
                            <td class="numeric">@line.TaxRate.ToString("0.##")%</td>
                            <td class="numeric line-total">@line.LineTotalWithTax.ToString("#,##0.00") <small>ج.م</small></td>
                            @if (CanModify)
                            {
                                <td class="center"><div class="line-actions"><button class="line-action edit" title="تعديل السطر" aria-label="تعديل السطر" @onclick="() => EditLine(line)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg></button><button class="line-action remove" title="حذف السطر" aria-label="حذف السطر" @onclick="() => RemoveLine(line)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"/></svg></button></div></td>
                            }
                        </tr>
                    }
                    </tbody></table></div>
                }

                <div class="quotation-totals">
                    <div class="quotation-total-item"><span>الإجمالي قبل الخصم</span><strong>@GrossTotal.ToString("#,##0.00") <small>ج.م</small></strong></div>
                    <div class="quotation-total-item"><span>إجمالي الخصم</span><strong class="discount-value">− @DiscountTotal.ToString("#,##0.00") <small>ج.م</small></strong></div>
                    <div class="quotation-total-item"><span>الإجمالي قبل الضريبة</span><strong>@SubTotal.ToString("#,##0.00") <small>ج.م</small></strong></div>
                    <div class="quotation-total-item"><span>إجمالي الضريبة</span><strong>@TaxTotal.ToString("#,##0.00") <small>ج.م</small></strong></div>
                    <div class="quotation-grand-total"><span>الإجمالي شامل الضريبة</span><strong>@GrandTotal.ToString("#,##0.00") <small>ج.م</small></strong></div>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(header.RejectionReason))
            {
                <section class="quotation-rejection-note"><span class="rejection-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 8v4m0 4h.01"/><circle cx="12" cy="12" r="10"/></svg></span><div><strong>سبب الرفض</strong><p>@header.RejectionReason</p></div></section>
            }

            <footer class="quotation-footer-actions">
                <button class="quotation-btn secondary" @onclick="GoBack" disabled="@isBusy">إغلاق</button>
                <div class="quotation-primary-actions">
                    @if (CanModify)
                    {
                        <button class="quotation-btn save-btn" @onclick="SaveDraft" disabled="@isBusy">
                            @if (isSaving){<span class="quotation-mini-spinner"></span>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>}
                            حفظ المسودة
                        </button>
                        @if (header.QuotationStatus == 1 && details.Count > 0)
                        {
                            <button class="quotation-btn submit-btn" @onclick="SubmitForApproval" disabled="@isBusy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7Z"/></svg>إرسال للاعتماد</button>
                        }
                    }
                    @if (!isViewMode && header.QuotationStatus == 3 && (permissions.CanEdit || permissions.CanApprove))
                    {
                        <button class="quotation-btn send-customer-btn" @onclick="OpenSendDialog" disabled="@isBusy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7Z"/></svg>إرسال عرض السعر للعميل</button>
                    }
                    @if (!isNewMode && permissions.CanDelete && header.QuotationStatus == 1 && !isViewMode)
                    {
                        <button class="quotation-btn delete-draft-btn" @onclick="DeleteCurrentDraft" disabled="@isBusy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6"/></svg>حذف المسودة</button>
                    }
                </div>
            </footer>
        }
    </main>

    @if (showLineDialog)
    {
        <div class="quotation-modal-backdrop" role="presentation" @onclick="CloseLineDialog">
            <section class="quotation-modal" role="dialog" aria-modal="true" aria-labelledby="line-modal-title" @onclick:stopPropagation="true">
                <div class="quotation-modal-top"></div>
                <header class="quotation-modal-header"><div><span class="modal-eyebrow">تفاصيل التسعير</span><h2 id="line-modal-title">@(isEditingLine ? "تعديل صنف" : "إضافة صنف")</h2></div><button class="quotation-modal-close" aria-label="إغلاق" @onclick="CloseLineDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m18 6-12 12M6 6l12 12"/></svg></button></header>
                <div class="quotation-modal-body">
                    <div class="quotation-field modal-full"><label class="required">الصنف</label><SearchableSelect Items="@saleItems" @bind-SelectedId="editLine.ItemID" OnSelected="OnItemSelected" Placeholder="ابحث باسم الصنف أو كوده..." IsDisabled="@isBusy" /></div>
                    <div class="quotation-field"><label class="required">الوحدة</label><select class="quotation-input" @bind="editLine.UnitID" disabled="@isBusy"><option value="0">اختر الوحدة</option>@foreach (var unit in units){<option value="@unit.Id">@unit.Name</option>}</select></div>
                    <div class="quotation-field"><label class="required">الكمية</label><input class="quotation-input ltr" type="number" min="0.0001" step="0.0001" @bind="editLine.Quantity" disabled="@isBusy" /></div>
                    <div class="quotation-field"><label class="required">سعر الوحدة (ج.م)</label><input class="quotation-input ltr" type="number" min="0" step="0.01" @bind="editLine.UnitPrice" disabled="@isBusy" /></div>
                    <div class="quotation-field"><label>الخصم (%)</label><input class="quotation-input ltr" type="number" min="0" max="100" step="0.01" @bind="editLine.DiscountPercent" disabled="@isBusy" /></div>
                    <div class="quotation-field"><label>الضريبة (%)</label><input class="quotation-input ltr" type="number" min="0" max="100" step="0.01" @bind="editLine.TaxRate" disabled="@isBusy" /></div>
                    <div class="quotation-field modal-full"><label>ملاحظة السطر</label><input class="quotation-input" @bind="editLine.Notes" disabled="@isBusy" maxlength="200" placeholder="اختياري" /></div>
                    <div class="quotation-line-preview modal-full"><span>إجمالي السطر شامل الضريبة</span><strong>@editLine.LineTotalWithTax.ToString("#,##0.00") <small>ج.م</small></strong></div>
                    @if (!string.IsNullOrWhiteSpace(lineError)){<div class="quotation-inline-error modal-full">@lineError</div>}
                </div>
                <footer class="quotation-modal-footer"><button class="quotation-btn secondary" @onclick="CloseLineDialog" disabled="@isBusy">إلغاء</button><button class="quotation-btn save-btn" @onclick="SaveLine" disabled="@isBusy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m5 12 4 4L19 6"/></svg>حفظ السطر</button></footer>
            </section>
        </div>
    }

    @if (showRejectDialog)
    {
        <div class="quotation-modal-backdrop" role="presentation" @onclick="CloseRejectDialog">
            <section class="quotation-modal reject-modal" role="dialog" aria-modal="true" aria-labelledby="reject-modal-title" @onclick:stopPropagation="true">
                <div class="quotation-modal-top danger"></div>
                <header class="quotation-modal-header"><div><span class="modal-eyebrow danger-text">قرار الاعتماد</span><h2 id="reject-modal-title">رفض عرض السعر</h2></div><button class="quotation-modal-close" aria-label="إغلاق" @onclick="CloseRejectDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m18 6-12 12M6 6l12 12"/></svg></button></header>
                <div class="quotation-modal-body single-column"><div class="quotation-field"><label class="required">سبب الرفض</label><textarea class="quotation-input quotation-textarea" @bind="rejectReason" maxlength="500" placeholder="اكتب سبباً واضحاً لإرساله إلى منشئ العرض..."></textarea></div>@if (!string.IsNullOrWhiteSpace(rejectError)){<div class="quotation-inline-error">@rejectError</div>}</div>
                <footer class="quotation-modal-footer"><button class="quotation-btn secondary" @onclick="CloseRejectDialog" disabled="@isBusy">إلغاء</button><button class="quotation-btn reject-btn" @onclick="ConfirmReject" disabled="@isBusy"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m18 6-12 12M6 6l12 12"/></svg>تأكيد الرفض</button></footer>
            </section>
        </div>
    }

    @if (showSendDialog)
    {
        <div class="quotation-modal-backdrop" role="presentation" @onclick="CloseSendDialog">
            <section class="quotation-modal" role="dialog" aria-modal="true" aria-labelledby="send-modal-title" @onclick:stopPropagation="true">
                <div class="quotation-modal-top"></div>
                <header class="quotation-modal-header">
                    <div><span class="modal-eyebrow">إرسال يدوي</span><h2 id="send-modal-title">إرسال عرض السعر للعميل</h2></div>
                    <button class="quotation-modal-close" aria-label="إغلاق" @onclick="CloseSendDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m18 6-12 12M6 6l12 12"/></svg></button>
                </header>
                <div class="quotation-modal-body single-column">
                    <div class="quotation-field"><label class="required">قناة الإرسال</label><select class="quotation-input" value="@sendChannel" @onchange="OnSendChannelChanged"><option value="WhatsApp">واتساب</option><option value="Email">البريد الإلكتروني</option></select></div>
                    <div class="quotation-field"><label class="required">المستلم</label><input class="quotation-input ltr" type="@(sendChannel == "Email" ? "email" : "tel")" @bind="sendRecipient" @bind:event="oninput" @bind:after="OnSendRecipientChanged" placeholder="@(sendChannel == "Email" ? "name@example.com" : "رقم الهاتف مع مفتاح الدولة")" /></div>
                    <div class="quotation-field"><label>نص الرسالة المقترح</label><textarea class="quotation-input quotation-textarea" @bind="sendMessage" @bind:event="oninput" @bind:after="OnSendMessageChanged"></textarea></div>
                    <div class="quotation-line-preview"><span>إجمالي العرض شامل الضريبة</span><strong>@header.TotalAmount.ToString("#,##0.00") <small>ج.م</small></strong></div>
                    <div style="padding:10px 12px;border:1px solid #eee4c6;border-radius:10px;background:#fcf8e9;color:#756020;font-size:.73rem;line-height:1.7">افتح وسيلة الإرسال، أرفق ملف العرض يدوياً، ثم ارجع واضغط «تم الإرسال» بعد الإرسال الفعلي. لن تتغير حالة العرض عند فتح واتساب أو البريد فقط.</div>
                    @if (!string.IsNullOrWhiteSpace(sendError)){<div class="quotation-inline-error">@sendError</div>}
                </div>
                <footer class="quotation-modal-footer">
                    <button class="quotation-btn secondary" @onclick="CloseSendDialog" disabled="@isBusy">إلغاء</button>
                    @if (CanOpenSendComposer)
                    {
                        <a class="quotation-btn send-customer-btn" href="@GetSendComposeUrl()" target="_blank" rel="noopener noreferrer" @onclick="OnSendComposerOpened"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7Z"/></svg>فتح @(sendChannel == "Email" ? "البريد" : "واتساب")</a>
                    }
                    else
                    {
                        <button class="quotation-btn send-customer-btn" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4 20-7Z"/></svg>أدخل مستلماً صالحاً</button>
                    }
                    <button class="quotation-btn save-btn" @onclick="ConfirmManualSend" disabled="@(isBusy || string.IsNullOrWhiteSpace(sendRecipient))">@if(isApproving){<span class="quotation-mini-spinner"></span>}تم الإرسال، سجّل الحالة</button>
                </footer>
            </section>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(toastMessage))
    {
