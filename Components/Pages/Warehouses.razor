@code {
    private List<WarehouseListDto>? warehouses;
    private List<WarehouseListDto> filteredWarehouses = new();
    private List<LookupDto>? employees;
    private ModulePermissionDto? permissions;
    private string searchText = "";
    private int filterType = 0;

    private bool showFormDialog = false;
    private bool isEditMode = false;
    private WarehouseEditDto editItem = new();
    private bool isSaving = false;
    private string formMessage = "";
    private bool formSuccess = true;

    private bool showDeleteDialog = false;
    private WarehouseListDto? deleteWarehouse;
    private string deleteMessage = "";

    private string resultMessage = "";
    private bool resultSuccess = true;
    private bool isExporting = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsLoggedIn) { Navigation.NavigateTo("/login"); return; }
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        permissions = PermissionService.GetModule("SCR_WAREHOUSES");
        if (permissions != null && permissions.CanView) await LoadData();
    }

    private async Task LoadData()
    {
        warehouses = await WarehouseService.GetWarehousesListAsync();
        employees = await LookupService.GetEmployeesAsync();
        Search();
    }

    private void Search()
    {
        if (warehouses == null) return;
        filteredWarehouses = warehouses.Where(w =>
            (filterType == 0 || w.WarehouseType == filterType) &&
            (string.IsNullOrEmpty(searchText) ||
             ArabicSearchHelper.Contains(w.WarehouseNameAr, searchText) ||
             ArabicSearchHelper.Contains(w.WarehouseNameEn, searchText) ||
             ArabicSearchHelper.Contains(w.WarehouseCode, searchText) ||
             ArabicSearchHelper.Contains(w.ManagerName, searchText))
        ).ToList();
    }

    private void ClearSearch() { searchText = ""; Search(); }

    private void ShowAddDialog()
    {
        isEditMode = false;
        editItem = new WarehouseEditDto();
        formMessage = "";
        showFormDialog = true;
    }

    private void ShowEditDialog(WarehouseListDto wh)
    {
        isEditMode = true;
        editItem = new WarehouseEditDto
        {
            WarehouseID = wh.WarehouseID,
            WarehouseCode = wh.WarehouseCode,
            WarehouseNameAr = wh.WarehouseNameAr,
            WarehouseNameEn = wh.WarehouseNameEn,
            WarehouseType = wh.WarehouseType,
            Address = wh.Address,
            Phone = wh.Phone,
            ManagerID = wh.ManagerID ?? 0,
            IsDefault = wh.IsDefault
        };
        formMessage = "";
        showFormDialog = true;
    }

    private void CloseDialog() { showFormDialog = false; formMessage = ""; }

    private async Task SaveWarehouse()
    {
        formMessage = "";
        if (string.IsNullOrWhiteSpace(editItem.WarehouseCode))
        { formMessage = "يجب إدخال كود المخزن"; formSuccess = false; return; }
        if (string.IsNullOrWhiteSpace(editItem.WarehouseNameAr))
        { formMessage = "يجب إدخال اسم المخزن"; formSuccess = false; return; }
        if (editItem.WarehouseType == 0)
        { formMessage = "يجب اختيار نوع المخزن"; formSuccess = false; return; }

        isSaving = true; StateHasChanged();
        try
        {
            if (isEditMode)
            {
                await WarehouseService.UpdateWarehouseAsync(editItem, UserSession.UserID);
                resultMessage = "تم تعديل المخزن بنجاح ✅";
            }
            else
            {
                await WarehouseService.InsertWarehouseAsync(editItem, UserSession.UserID);
                resultMessage = "تم إضافة المخزن بنجاح ✅";
            }
            resultSuccess = true;
            showFormDialog = false;
            await LoadData();
        }
        catch (Exception ex) { formMessage = "خطأ: " + ex.Message; formSuccess = false; }
        finally { isSaving = false; }
    }

    private void ShowDeleteConfirm(WarehouseListDto wh)
    { deleteWarehouse = wh; deleteMessage = ""; showDeleteDialog = true; }

    private void CloseDeleteDialog() { showDeleteDialog = false; deleteMessage = ""; }

    private async Task ConfirmDelete()
    {
        if (deleteWarehouse == null) return;
        try
        {
            var result = await WarehouseService.DeleteWarehouseAsync(deleteWarehouse.WarehouseID, UserSession.UserID);
            if (result.Success)
            { resultMessage = result.Message + " ✅"; resultSuccess = true; showDeleteDialog = false; await LoadData(); }
            else { deleteMessage = result.Message; }
        }
        catch (Exception ex) { deleteMessage = "خطأ: " + ex.Message; }
    }

    private async Task ExportToExcel()
    {
        if (filteredWarehouses == null || !filteredWarehouses.Any()) return;
        isExporting = true; StateHasChanged();
        try
        {
            var fileBytes = await WarehouseService.ExportWarehousesToExcelAsync(filteredWarehouses, UserSession.UserID);
            var base64 = Convert.ToBase64String(fileBytes);
            await JS.InvokeVoidAsync("downloadFile", $"Warehouses_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", base64);
        }
        catch (Exception ex) { resultMessage = "خطأ: " + ex.Message; resultSuccess = false; }
        finally { isExporting = false; }
    }
}