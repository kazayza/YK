@page "/warehouses"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject WarehouseService WarehouseService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>المخازن - واي كي كوتينج Gold Edition</PageTitle>

@if (!UserSession.IsLoggedIn)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div><h4>يجب تسجيل الدخول أولاً</h4></div>}
else if (permissions == null || !permissions.CanView)
{<div class="no-access-luxury" dir="rtl"><div class="na-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg></div><h4>ليس لديك صلاحية</h4><button class="btn-luxury btn-secondary-luxury" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة للرئيسية</button></div>}
else
{
    <div class="luxury-page" dir="rtl">

        <div class="luxury-header-hybrid">
            <div class="lh-gold-line"></div>
            <div class="lh-bg-logo"><img src="/images/yk-icon-gold.png" alt="YK" /></div>
            <div class="lh-content">
                <div class="lh-right">
                    <div class="lh-logo-wrap"><img src="/images/yk-icon-gold.png" alt="YK" class="lh-logo" /></div>
                    <div class="lh-text"><h2 class="lh-title">المخازن والمستودعات</h2><p class="lh-subtitle">إدارة مخازن المصنع والمستودعات - تتبع ذكي للأرصدة</p></div>
                </div>
                <div class="lh-actions">
                    <span class="lh-badge"><span class="lh-dot"></span>@filteredWarehouses.Count مخزن</span>
                    @if (permissions.CanExport)
                    {
                        <button class="btn-luxury btn-export-luxury" @onclick="ExportToExcel" disabled="@isExporting">
                            @if (isExporting){<div class="btn-spinner-sm"></div>}else{<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>}
                            تصدير Excel
                        </button>
                    }
                    @if (permissions.CanAdd){<button class="btn-luxury btn-primary-luxury" @onclick="ShowAddDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>إضافة مخزن</button>}
                </div>
            </div>
        </div>

        @if (warehouses != null)
        {
            <div class="stats-luxury">
                <div class="stat-luxury"><div class="st-icon dark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01 20.73 6.96"/><path d="M12 22.08V12"/></svg></div><div class="st-info"><span class="st-value">@warehouses.Count</span><span class="st-label">إجمالي المخازن</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon blue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/></svg></div><div class="st-info"><span class="st-value">@warehouses.Count(w => w.WarehouseType == 1)</span><span class="st-label">مواد خام</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon cyan"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9h18v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/><path d="M9 9h6"/><path d="M9 15h6"/></svg></div><div class="st-info"><span class="st-value">@warehouses.Count(w => w.WarehouseType == 2)</span><span class="st-label">تعبئة</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon amber"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg></div><div class="st-info"><span class="st-value">@warehouses.Count(w => w.WarehouseType == 3 || w.WarehouseType == 4)</span><span class="st-label">تصنيع ومنتجات</span></div><div class="st-gold-line"></div></div>
                <div class="stat-luxury"><div class="st-icon gold"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/><path d="M12 8v8"/></svg></div><div class="st-info"><span class="st-value">@warehouses.Count(w => w.IsDefault)</span><span class="st-label">افتراضي</span></div><div class="st-gold-line"></div></div>
            </div>
        }

        <div class="filter-luxury">
            <div class="search-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input type="text" placeholder="بحث بالاسم أو الكود أو المسؤول..." @bind="searchText" @bind:event="oninput" @onkeyup="Search" />
                @if (!string.IsNullOrEmpty(searchText)){<button class="clear-search-luxury" @onclick="ClearSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>}
            </div>
            <div class="select-wrap-luxury">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                <select @bind="filterType" @bind:after="Search">
                    <option value="0">كل الأنواع</option>
                    <option value="1">مواد خام</option>
                    <option value="2">مواد تعبئة</option>
                    <option value="3">تحت التصنيع</option>
                    <option value="4">منتجات تامة</option>
                    <option value="5">مرتجعات</option>
                    <option value="6">عام</option>
                </select>
                <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </div>
            <div class="view-toggle-luxury">
                <button class="vt-btn @(viewMode=="cards"?"active":"")" @onclick='() => viewMode="cards"'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg></button>
                <button class="vt-btn @(viewMode=="table"?"active":"")" @onclick='() => viewMode="table"'><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 3h18v18H3z"/><path d="M9 3v18"/><path d="M3 9h18"/></svg></button>
            </div>
            <button class="btn-luxury btn-ghost-luxury" @onclick="LoadData"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/></svg>تحديث</button>
        </div>

        @if (warehouses == null)
        {<div class="loading-luxury"><div class="loader-luxury"></div><p>جاري تحميل المخازن...</p></div>}
        else if (!filteredWarehouses.Any())
        {<div class="empty-luxury"><div class="empty-icon-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div><h4>لا توجد مخازن</h4><p>جرب تغيير معايير البحث</p></div>}
        else
        {
            @if (viewMode == "cards")
            {
                <div class="wh-grid-luxury">
                    @foreach (var wh in filteredWarehouses)
                    {
                        <div class="wh-card-luxury @(wh.IsDefault ? "default" : "")">
                            <div class="wh-gold-line"></div>
                            @if (wh.IsDefault){<span class="wh-default-badge"><svg viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>افتراضي</span>}
                            <div class="wh-header-luxury">
                                <div class="wh-icon-luxury type-@wh.WarehouseType">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="M3.27 6.96 12 12.01 20.73 6.96"/><path d="M12 22.08V12"/></svg>
                                </div>
                                <div class="wh-info-luxury"><strong>@wh.WarehouseNameAr</strong><code>@wh.WarehouseCode</code><span class="wh-type-badge type-@wh.WarehouseType">@WarehouseService.GetWarehouseTypeName(wh.WarehouseType)</span></div>
                            </div>
                            <div class="wh-body-luxury">
                                @if (!string.IsNullOrEmpty(wh.ManagerName)){<div class="wh-row"><span class="wh-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>المسؤول</span><span class="wh-value">@wh.ManagerName</span></div>}
                                @if (!string.IsNullOrEmpty(wh.Phone)){<div class="wh-row"><span class="wh-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>الهاتف</span><span class="wh-value" dir="ltr">@wh.Phone</span></div>}
                                @if (!string.IsNullOrEmpty(wh.Address)){<div class="wh-row"><span class="wh-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>العنوان</span><span class="wh-value">@wh.Address</span></div>}
                                @if (!string.IsNullOrEmpty(wh.WarehouseNameEn)){<div class="wh-row"><span class="wh-label"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>En</span><span class="wh-value" dir="ltr">@wh.WarehouseNameEn</span></div>}
                            </div>
                            <div class="wh-footer-luxury">
                                <div class="wh-capacity"><span class="cap-label">السعة</span><div class="cap-bar"><div class="cap-fill" style="width:@(GetCapacityPercent(wh.WarehouseType))%"></div></div><span class="cap-value">@GetCapacityPercent(wh.WarehouseType)%</span></div>
                                <div class="wh-actions-luxury">
                                    @if (permissions.CanEdit){<button class="act-btn edit" @onclick="() => ShowEditDialog(wh)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>تعديل</button>}
                                    @if (permissions.CanDelete){<button class="act-btn delete" @onclick="() => ShowDeleteConfirm(wh)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg>حذف</button>}
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="table-card-luxury">
                    <div class="table-responsive">
                        <table class="table-luxury">
                            <thead><tr><th class="th-num">#</th><th>الكود</th><th>الاسم عربي</th><th>الاسم إنجليزي</th><th class="th-center">النوع</th><th>المسؤول</th><th>الهاتف</th><th class="th-center">افتراضي</th><th class="th-actions">إجراءات</th></tr></thead>
                            <tbody>
                                @{int i=0;}
                                @foreach(var wh in filteredWarehouses){i++;
                                    <tr class="@(wh.IsDefault?"row-gold":"")">
                                        <td class="td-num">@i</td>
                                        <td><span class="code-luxury">@wh.WarehouseCode</span></td>
                                        <td class="td-name">@wh.WarehouseNameAr</td>
                                        <td class="td-muted">@wh.WarehouseNameEn</td>
                                        <td class="td-center"><span class="wh-type-badge type-@wh.WarehouseType">@WarehouseService.GetWarehouseTypeName(wh.WarehouseType)</span></td>
                                        <td>@wh.ManagerName</td>
                                        <td dir="ltr">@wh.Phone</td>
                                        <td class="td-center">@if(wh.IsDefault){<span class="default-star"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>}else{<span class="no-val">—</span>}</td>
                                        <td class="td-actions">
                                            @if (permissions.CanEdit){<button class="act-btn edit" @onclick="() => ShowEditDialog(wh)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>}
                                            @if (permissions.CanDelete){<button class="act-btn delete" @onclick="() => ShowDeleteConfirm(wh)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/></svg></button>}
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </div>

    @if (showFormDialog)
    {
        <div class="modal-overlay-luxury" @onclick="CloseDialog">
            <div class="modal-card-luxury large" @onclick:stopPropagation="true">
                <div class="ml-gold-line"></div>
                <div class="ml-header">
                    <div class="ml-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div>
                    <div class="ml-text"><h3>@(isEditMode ? "تعديل مخزن" : "إضافة مخزن جديد")</h3><p>@(isEditMode ? "تحديث بيانات المخزن" : "أدخل بيانات المخزن الجديد مع تفاصيل الموقع")</p></div>
                    <button class="ml-close" @onclick="CloseDialog"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>
                </div>

                <div class="ml-body">
                    <!-- TABS INSIDE MODAL LUXURY -->
                    <div class="modal-tabs-luxury">
                        <button class="mtl-btn @(modalTab==0?"active":"")" @onclick="() => modalTab=0"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>الأساسية</button>
                        <button class="mtl-btn @(modalTab==1?"active":"")" @onclick="() => modalTab=1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/></svg>الموقع والاتصال</button>
                        <button class="mtl-btn @(modalTab==2?"active":"")" @onclick="() => modalTab=2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>الإعدادات</button>
                    </div>

                    @if (modalTab == 0)
                    {
                        <div class="form-grid-luxury cols-2">
                            <div class="field-luxury"><label class="fl-label required">كود المخزن</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6"/><path d="M9 15h6"/></svg><input type="text" @bind="editItem.WarehouseCode" placeholder="WH-RAW" dir="ltr" /></div><span class="fl-hint">كود فريد - مثال: WH-RAW</span></div>
                            <div class="field-luxury"><label class="fl-label required">نوع المخزن</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><select @bind="editItem.WarehouseType"><option value="0">-- اختر النوع --</option><option value="1">مواد خام</option><option value="2">مواد تعبئة</option><option value="3">تحت التصنيع</option><option value="4">منتجات تامة</option><option value="5">مرتجعات</option><option value="6">عام</option></select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                        </div>
                        <div class="form-grid-luxury cols-2">
                            <div class="field-luxury"><label class="fl-label required">اسم المخزن (عربي)</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><input type="text" @bind="editItem.WarehouseNameAr" placeholder="مخزن المواد الخام" /></div></div>
                            <div class="field-luxury"><label class="fl-label">اسم المخزن (إنجليزي)</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg><input type="text" @bind="editItem.WarehouseNameEn" placeholder="Raw Materials Store" dir="ltr" /></div></div>
                        </div>
                        <div class="preview-card-luxury"><h4><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>معاينة المخزن</h4><div class="pc-body"><span class="code-luxury">@(string.IsNullOrWhiteSpace(editItem.WarehouseCode)?"CODE":editItem.WarehouseCode)</span><strong>@(string.IsNullOrWhiteSpace(editItem.WarehouseNameAr)?"اسم المخزن":editItem.WarehouseNameAr)</strong><span class="wh-type-badge type-@(editItem.WarehouseType)">@(editItem.WarehouseType==0?"النوع":WarehouseService.GetWarehouseTypeName(editItem.WarehouseType))</span></div></div>
                    }
                    @if (modalTab == 1)
                    {
                        <div class="form-grid-luxury cols-2">
                            <div class="field-luxury"><label class="fl-label">مسؤول المخزن</label><div class="select-wrap-luxury-input"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><select @bind="editItem.ManagerID"><option value="0">-- بدون --</option>@if (employees != null){@foreach(var emp in employees){<option value="@emp.Id">@emp.Name</option>}}</select><svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg></div></div>
                            <div class="field-luxury"><label class="fl-label">الهاتف</label><div class="input-wrap-luxury"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><input type="text" @bind="editItem.Phone" placeholder="رقم الهاتف" dir="ltr" /></div></div>
                        </div>
