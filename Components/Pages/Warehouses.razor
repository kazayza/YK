@page "/warehouses"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject WarehouseService WarehouseService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>المخازن - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access-card"><div class="no-access-icon">🔒</div><h4>يجب تسجيل الدخول أولاً</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access-card">
        <div class="no-access-icon">⛔</div>
        <h4>ليس لديك صلاحية لعرض هذه الشاشة</h4>
        <button class="btn-modern btn-secondary-modern" @onclick='() => Navigation.NavigateTo("/dashboard")'>العودة للرئيسية</button>
    </div>
}
else
{
    <div class="items-page" dir="rtl">

        <!-- العنوان -->
        <div class="page-header">
            <div>
                <h2 class="page-title">المخازن</h2>
                <p class="page-subtitle">إدارة مخازن المصنع والمستودعات</p>
            </div>
            <div class="header-actions">
                <span class="result-badge">@filteredWarehouses.Count مخزن</span>

                @if (permissions.CanExport)
                {
                    <button class="btn-modern btn-export" @onclick="ExportToExcel" disabled="@isExporting">
                        @if (isExporting) { <div class="btn-spinner-sm"></div> }
                        else
                        {
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
                            </svg>
                        }
                        تصدير Excel
                    </button>
                }

                @if (permissions.CanAdd)
                {
                    <button class="btn-modern btn-primary-modern" @onclick="ShowAddDialog">
                        <span class="btn-icon">+</span> إضافة مخزن
                    </button>
                }
            </div>
        </div>

        <!-- الإحصائيات -->
        @if (warehouses != null)
        {
            <div class="stats-grid">
                <div class="stat-card stat-total">
                    <div class="stat-value">@warehouses.Count</div>
                    <div class="stat-label">إجمالي المخازن</div>
                </div>
                <div class="stat-card stat-raw">
                    <div class="stat-value">@warehouses.Count(w => w.WarehouseType == 1)</div>
                    <div class="stat-label">مواد خام</div>
                </div>
                <div class="stat-card stat-pkg">
                    <div class="stat-value">@warehouses.Count(w => w.WarehouseType == 2)</div>
                    <div class="stat-label">مواد تعبئة</div>
                </div>
                <div class="stat-card stat-semi">
                    <div class="stat-value">@warehouses.Count(w => w.WarehouseType == 3 || w.WarehouseType == 4)</div>
                    <div class="stat-label">تصنيع ومنتجات</div>
                </div>
                <div class="stat-card stat-fin">
                    <div class="stat-value">@warehouses.Count(w => w.WarehouseType == 5 || w.WarehouseType == 6)</div>
                    <div class="stat-label">مرتجعات وعام</div>
                </div>
            </div>
        }

        <!-- شريط البحث -->
        <div class="filter-bar">
            <div class="search-box">
                <span class="search-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
                    </svg>
                </span>
                <input type="text" class="search-input" placeholder="بحث بالاسم أو الكود..."
                       @bind="searchText" @bind:event="oninput" @onkeyup="Search" />
                @if (!string.IsNullOrEmpty(searchText))
                { <button class="clear-search" @onclick="ClearSearch">✕</button> }
            </div>

            <select class="filter-select" @bind="filterType" @bind:after="Search">
                <option value="0">كل الأنواع</option>
                <option value="1">مواد خام</option>
                <option value="2">مواد تعبئة</option>
                <option value="3">تحت التصنيع</option>
                <option value="4">منتجات تامة</option>
                <option value="5">مرتجعات</option>
                <option value="6">عام</option>
            </select>

            <button class="btn-modern btn-ghost" @onclick="LoadData">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 2v6h-6"/><path d="M3 12a9 9 0 0 1 15-6.7L21 8"/>
                    <path d="M3 22v-6h6"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/>
                </svg>
                تحديث
            </button>
        </div>

        <!-- بطاقات المخازن -->
        @if (warehouses == null)
        {
            <div class="loading-state"><div class="loader"></div><p>جاري تحميل البيانات...</p></div>
        }
        else if (!filteredWarehouses.Any())
        {
            <div class="empty-state"><div class="empty-icon">🏭</div><h4>لا توجد مخازن</h4></div>
        }
        else
        {
            <div class="wh-grid">
                @foreach (var wh in filteredWarehouses)
                {
                    <div class="wh-card @(wh.IsDefault ? "wh-default" : "")">
                        <div class="wh-card-header">
                            <div class="wh-type-icon wh-type-@wh.WarehouseType">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                                    <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                                    <line x1="12" y1="22.08" x2="12" y2="12"/>
                                </svg>
                            </div>
                            <div>
                                <div class="wh-name">@wh.WarehouseNameAr</div>
                                <code class="wh-code">@wh.WarehouseCode</code>
                            </div>
                            @if (wh.IsDefault)
                            { <span class="default-badge">افتراضي</span> }
                        </div>

                        <div class="wh-details">
                            <div class="wh-detail-row">
                                <span class="wh-label">النوع</span>
                                <span class="type-badge type-wh-@wh.WarehouseType">@WarehouseService.GetWarehouseTypeName(wh.WarehouseType)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(wh.ManagerName))
                            {
                                <div class="wh-detail-row">
                                    <span class="wh-label">المسؤول</span>
                                    <span class="wh-value">@wh.ManagerName</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(wh.Phone))
                            {
                                <div class="wh-detail-row">
                                    <span class="wh-label">الهاتف</span>
                                    <span class="wh-value" dir="ltr">@wh.Phone</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(wh.Address))
                            {
                                <div class="wh-detail-row">
                                    <span class="wh-label">العنوان</span>
                                    <span class="wh-value">@wh.Address</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(wh.WarehouseNameEn))
                            {
                                <div class="wh-detail-row">
                                    <span class="wh-label">إنجليزي</span>
                                    <span class="wh-value" dir="ltr">@wh.WarehouseNameEn</span>
                                </div>
                            }
                        </div>

                        <div class="wh-card-actions">
                            @if (permissions.CanEdit)
                            {
                                <button class="action-btn edit-btn" @onclick="() => ShowEditDialog(wh)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                    </svg> تعديل
                                </button>
                            }
                            @if (permissions.CanDelete)
                            {
                                <button class="action-btn delete-btn" @onclick="() => ShowDeleteConfirm(wh)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/>
                                    </svg> حذف
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- مودال الإضافة/التعديل -->
    @if (showFormDialog)
    {
        <div class="modal-overlay" @onclick="CloseDialog">
            <div class="modal-card form-modal" @onclick:stopPropagation="true">
                <h3 class="modal-title">@(isEditMode ? "تعديل مخزن" : "إضافة مخزن جديد")</h3>

                <div class="form-grid-modal">
                    <div class="form-field">
                        <label class="field-label required-field">كود المخزن</label>
                        <input type="text" class="field-input" @bind="editItem.WarehouseCode" placeholder="مثال: WH-RAW" dir="ltr" />
                    </div>
                    <div class="form-field">
                        <label class="field-label required-field">اسم المخزن (عربي)</label>
                        <input type="text" class="field-input" @bind="editItem.WarehouseNameAr" placeholder="مخزن المواد الخام" />
                    </div>
                    <div class="form-field">
                        <label class="field-label">اسم المخزن (إنجليزي)</label>
                        <input type="text" class="field-input" @bind="editItem.WarehouseNameEn" placeholder="Raw Materials Store" dir="ltr" />
                    </div>
                    <div class="form-field">
                        <label class="field-label required-field">نوع المخزن</label>
                        <select class="field-select" @bind="editItem.WarehouseType">
                            <option value="0">-- اختر النوع --</option>
                            <option value="1">مواد خام</option>
                            <option value="2">مواد تعبئة</option>
                            <option value="3">تحت التصنيع</option>
                            <option value="4">منتجات تامة</option>
                            <option value="5">مرتجعات</option>
                            <option value="6">عام</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="field-label">مسؤول المخزن</label>
                        <select class="field-select" @bind="editItem.ManagerID">
                            <option value="0">-- بدون --</option>
                            @if (employees != null)
                            {
                                @foreach (var emp in employees)
                                { <option value="@emp.Id">@emp.Name</option> }
                            }
                        </select>
                    </div>
                    <div class="form-field">
                        <label class="field-label">الهاتف</label>
                        <input type="text" class="field-input" @bind="editItem.Phone" placeholder="رقم الهاتف" dir="ltr" />
                    </div>
                </div>

                <div class="form-field" style="margin-bottom:14px;">
                    <label class="field-label">العنوان</label>
                    <input type="text" class="field-input" @bind="editItem.Address" placeholder="عنوان المخزن" />
                </div>

                <div class="form-field" style="margin-bottom:14px;">
                    <label class="toggle-switch">
                        <input type="checkbox" @bind="editItem.IsDefault" />
                        <span class="toggle-slider"></span>
                        <span class="toggle-text">@(editItem.IsDefault ? "مخزن افتراضي ✅" : "ليس افتراضي")</span>
                    </label>
                </div>

                @if (!string.IsNullOrEmpty(formMessage))
                { <div class="form-message @(formSuccess ? "msg-success" : "msg-error")">@formMessage</div> }

                <div class="modal-buttons">
                    <button class="btn-modern btn-primary-modern" @onclick="SaveWarehouse" disabled="@isSaving">
                        @if (isSaving) { <div class="btn-spinner-sm"></div> <span>جاري الحفظ...</span> }
                        else { <span>@(isEditMode ? "حفظ التعديلات" : "حفظ")</span> }
                    </button>
                    <button class="btn-modern btn-ghost" @onclick="CloseDialog">إلغاء</button>
                </div>
            </div>
        </div>
    }

    <!-- مودال الحذف -->
    @if (showDeleteDialog)
    {
        <div class="modal-overlay" @onclick="CloseDeleteDialog">
            <div class="modal-card" @onclick:stopPropagation="true">
                <div class="modal-icon delete-modal-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                    </svg>
                </div>
                <h4>تأكيد الحذف</h4>
                <p>هل أنت متأكد من حذف المخزن: <strong>@deleteWarehouse?.WarehouseNameAr</strong>؟</p>
                @if (!string.IsNullOrEmpty(deleteMessage))
                { <div class="form-message msg-error">@deleteMessage</div> }
                <div class="modal-buttons">
                    <button class="btn-modern btn-danger-modern" @onclick="ConfirmDelete">تأكيد الحذف</button>
                    <button class="btn-modern btn-ghost" @onclick="CloseDeleteDialog">إلغاء</button>
                </div>
            </div>
        </div>
    }

    <!-- Toast -->
    @if (!string.IsNullOrEmpty(resultMessage))
    {
        <div class="toast-container">
            <div class="toast-card @(resultSuccess ? "toast-success" : "toast-error")">
                <span class="toast-text">@resultMessage</span>
                <button class="toast-close" @onclick='() => resultMessage = ""'>✕</button>
            </div>
        </div>
    }
}

<style>
    .items-page { display: flex; flex-direction: column; gap: 20px; }
    .page-header { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; }
    .page-title { font-weight: 800; color: #1f2937; margin: 0; }
    .page-subtitle { color: #6b7280; font-size: .88rem; margin: 4px 0 0; }
    .header-actions { display: flex; align-items: center; gap: 12px; }
    .result-badge { background: #f3f4f6; color: #4b5563; padding: 8px 16px; border-radius: 999px; font-size: .82rem; font-weight: 700; }

    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 14px; }
    .stat-card { background: white; border-radius: 18px; padding: 18px; text-align: center; border: 1px solid #eef2f7; box-shadow: 0 4px 12px rgba(15,23,42,.04); transition: .2s; }
    .stat-card:hover { transform: translateY(-2px); }
    .stat-value { font-size: 1.6rem; font-weight: 800; color: #1f2937; }
    .stat-label { font-size: .8rem; color: #6b7280; margin-top: 4px; }
    .stat-total { border-top: 3px solid #1f2937; } .stat-raw { border-top: 3px solid #1d4ed8; }
    .stat-pkg { border-top: 3px solid #06b6d4; } .stat-semi { border-top: 3px solid #f59e0b; } .stat-fin { border-top: 3px solid #10b981; }

    .filter-bar { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
    .search-box { flex: 1; min-width: 280px; position: relative; display: flex; align-items: center; }
    .search-icon { position: absolute; right: 14px; color: #9ca3af; pointer-events: none; }
    .search-input { width: 100%; padding: 12px 44px 12px 40px; border: 1.5px solid #e5e7eb; border-radius: 14px; font-size: .92rem; background: white; outline: none; transition: .2s; }
    .search-input:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
    .clear-search { position: absolute; left: 12px; background: #f3f4f6; border: none; width: 24px; height: 24px; border-radius: 50%; font-size: .75rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .filter-select { padding: 12px 16px; border: 1.5px solid #e5e7eb; border-radius: 14px; font-size: .88rem; background: white; min-width: 150px; outline: none; }

    .wh-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 18px; }
    .wh-card { background: white; border-radius: 20px; border: 1px solid #eef2f7; box-shadow: 0 4px 16px rgba(15,23,42,.04); overflow: hidden; transition: .2s; }
    .wh-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(15,23,42,.08); }
    .wh-default { border: 2px solid #93c5fd; box-shadow: 0 4px 20px rgba(37,99,235,.1); }

    .wh-card-header { display: flex; align-items: center; gap: 12px; padding: 18px 20px; border-bottom: 1px solid #f3f4f6; position: relative; }
    .wh-type-icon { width: 46px; height: 46px; border-radius: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .wh-type-1 { background: #eff6ff; color: #2563eb; } .wh-type-2 { background: #ecfeff; color: #0891b2; }
    .wh-type-3 { background: #fef3c7; color: #d97706; } .wh-type-4 { background: #ecfdf5; color: #059669; }
    .wh-type-5 { background: #fef2f2; color: #ef4444; } .wh-type-6 { background: #f3f4f6; color: #6b7280; }

    .wh-name { font-weight: 800; color: #1f2937; font-size: .95rem; }
    .wh-code { background: #f3f4f6; padding: 2px 8px; border-radius: 6px; font-size: .78rem; color: #1d4ed8; font-weight: 600; }
    .default-badge { position: absolute; top: 12px; left: 12px; background: linear-gradient(135deg, #1d4ed8, #93c5fd); color: white; padding: 4px 12px; border-radius: 999px; font-size: .72rem; font-weight: 700; }

    .wh-details { padding: 14px 20px; }
    .wh-detail-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-bottom: 1px solid #f9fafb; }
    .wh-detail-row:last-child { border-bottom: none; }
    .wh-label { font-size: .82rem; color: #9ca3af; font-weight: 600; }
    .wh-value { font-size: .85rem; color: #374151; font-weight: 600; }

    .type-badge { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: .78rem; font-weight: 700; }
    .type-wh-1 { background: #eff6ff; color: #2563eb; } .type-wh-2 { background: #ecfeff; color: #0891b2; }
    .type-wh-3 { background: #fef3c7; color: #d97706; } .type-wh-4 { background: #ecfdf5; color: #059669; }
    .type-wh-5 { background: #fef2f2; color: #dc2626; } .type-wh-6 { background: #f3f4f6; color: #6b7280; }

    .wh-card-actions { display: flex; gap: 8px; padding: 14px 20px; border-top: 1px solid #f3f4f6; background: #fafbfc; }

    .action-btn { display: inline-flex; align-items: center; gap: 4px; padding: 6px 12px; border-radius: 10px; border: 1.5px solid; background: transparent; font-size: .78rem; font-weight: 700; cursor: pointer; transition: .2s; }
    .edit-btn { color: #1d4ed8; border-color: #e9e0ff; } .edit-btn:hover { background: #f5f3ff; }
    .delete-btn { color: #ef4444; border-color: #fee2e2; } .delete-btn:hover { background: #fef2f2; }

    .btn-modern { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 14px; border: none; font-weight: 700; font-size: .88rem; cursor: pointer; transition: .2s; }
    .btn-modern:disabled { opacity: .6; cursor: not-allowed; }
    .btn-primary-modern { background: linear-gradient(135deg, #1d4ed8, #2563eb); color: white; box-shadow: 0 4px 16px rgba(37,99,235,.25); }
    .btn-primary-modern:hover:not(:disabled) { transform: translateY(-1px); }
    .btn-danger-modern { background: linear-gradient(135deg, #ef4444, #dc2626); color: white; }
    .btn-secondary-modern { background: #f3f4f6; color: #374151; }
    .btn-ghost { background: transparent; color: #6b7280; border: 1.5px solid #e5e7eb; } .btn-ghost:hover { background: #f9fafb; }
    .btn-export { background: linear-gradient(135deg, #059669, #10b981); color: white; }
    .btn-icon { font-size: 1.1rem; font-weight: 800; }
    .btn-spinner-sm { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.3); border-top-color: white; border-radius: 50%; animation: spin .6s linear infinite; }

    .toggle-switch { display: flex; align-items: center; gap: 10px; cursor: pointer; padding: 8px 0; }
    .toggle-switch input { display: none; }
    .toggle-slider { width: 44px; height: 24px; background: #d1d5db; border-radius: 999px; position: relative; transition: .3s; flex-shrink: 0; }
    .toggle-slider::after { content: ''; position: absolute; width: 18px; height: 18px; background: white; border-radius: 50%; top: 3px; right: 3px; transition: .3s; box-shadow: 0 2px 4px rgba(0,0,0,.15); }
    .toggle-switch input:checked + .toggle-slider { background: #1d4ed8; }
    .toggle-switch input:checked + .toggle-slider::after { right: 23px; }
    .toggle-text { font-size: .85rem; font-weight: 600; color: #374151; }

    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.5); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; z-index: 1000; }
    .modal-card { background: white; border-radius: 24px; padding: 36px; max-width: 440px; width: 90%; text-align: center; box-shadow: 0 24px 48px rgba(0,0,0,.15); animation: modalIn .3s ease; }
    .form-modal { max-width: 600px; text-align: right; }
    .modal-title { font-weight: 800; color: #1f2937; margin-bottom: 20px; text-align: center; }
    .modal-icon { width: 64px; height: 64px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px; }
    .delete-modal-icon { background: #fef2f2; color: #ef4444; }
    .modal-buttons { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; }
    @@keyframes modalIn { from { opacity: 0; transform: scale(.95) translateY(10px); } to { opacity: 1; transform: scale(1) translateY(0); } }

    .form-grid-modal { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-bottom: 16px; }
    .form-field { display: flex; flex-direction: column; gap: 6px; }
    .field-label { font-size: .82rem; font-weight: 700; color: #374151; }
    .required-field::after { content: ' *'; color: #ef4444; }
    .field-input, .field-select { padding: 10px 14px; border: 1.5px solid #e5e7eb; border-radius: 12px; font-size: .9rem; background: white; outline: none; width: 100%; transition: .2s; }
    .field-input:focus, .field-select:focus { border-color: #2563eb; box-shadow: 0 0 0 3px rgba(37,99,235,.1); }
    .form-message { padding: 10px 14px; border-radius: 12px; font-size: .85rem; font-weight: 600; margin-top: 12px; }
