            var html = await SupService.GenerateSupplierCardHtmlAsync(SupplierId, UserSession.UserID);
            await JS.InvokeVoidAsync("printHtml", html);
            await ShowToast("🖨️ تم الطباعة", true);
        }
        catch (Exception ex)
        {
            await ShowToast($"❌ خطأ: {ex.Message}", false);
        }
        finally
        {
            isPrintLoading = false;
            StateHasChanged();
        }
    }

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await ShowToast($"📋 تم نسخ: {text}", true);
            await Task.Delay(2000);
            toast = "";
        }
        catch
        {
            await ShowToast("❌ خطأ في النسخ", false);
        }
    }

    private async Task ShowToast(string message, bool isSuccess = true)
    {
        toast = message;
        toastOk = isSuccess;
        StateHasChanged();
        await Task.Delay(3000);
        toast = "";
        StateHasChanged();
    }

    private void GoBack() => Navigation.NavigateTo("/suppliers");
}

