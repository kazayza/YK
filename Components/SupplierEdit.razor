@page "/suppliers/new"
@page "/suppliers/edit/{SupplierId:int}"
@page "/suppliers/view/{SupplierId:int}"

@using YKCoatings.Services
@using YKCoatings.Models
@using YKCoatings.Helpers
@using System
@using System.Collections.Generic
@using System.Text.Json
@using System.Text.RegularExpressions
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Rendering
@using System.Linq

@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject SupplierService SupService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@pageTitle - واي كي كوتينج</PageTitle>

@if (!UserSession.IsLoggedIn)
{
    <div class="no-access"><div class="na-icon">🔒</div><h4>يجب تسجيل الدخول</h4></div>
}
else if (permissions == null || !permissions.CanView)
{
    <div class="no-access"><div class="na-icon">⛔</div><h4>ليس لديك صلاحية</h4></div>
}
else
{
    <div class="doc-page" dir="rtl" @onkeydown="OnKeyDown" @onkeydown:preventDefault="shouldPreventDefault">

        <!-- Header -->
        <div class="doc-header">
            <div class="doc-header-right">
                <button class="btn-m btn-ghost" @onclick="GoBack" title="رجوع (Escape)">→ رجوع</button>
                <div>
                    <h2 class="doc-title">@pageTitle</h2>
                    @if (!string.IsNullOrEmpty(header.SupplierCode))
                    {
                        <div class="doc-num-wrap">
                            <code class="doc-number" title="انقر للنسخ" @onclick='() => CopyToClipboard(header.SupplierCode)'>
                                @header.SupplierCode
                            </code>
                            <span class="type-chip" style="--tc:@SupplierService.GetTypeColor(header.SupplierType)">
                                @SupplierService.GetTypeName(header.SupplierType)
                            </span>
                            <span class="rating-chip">@(new string('⭐', header.Rating))</span>
                        </div>
                    }
                </div>
            </div>
            <div class="doc-header-left">
                @if (permissions.CanPrint && SupplierId > 0)
                {
                    <button class="btn-m btn-outline" @onclick="PrintCard" disabled="@isPrintLoading" title="طباعة (Ctrl+P)">
                        @if (isPrintLoading) { <div class="btn-spin"></div> } else { <span>🖨️</span> }
                        طباعة
                    </button>
                }
            </div>
        </div>

        @if (isLoading)
        {
            <div class="loading-st"><div class="loader"></div></div>
        }
        else
        {
            <!-- Tabs -->
            <div class="tabs-bar">
                <button class="tab @(activeTab == 0 ? "tab-active" : "")" @onclick="() => SelectTab(0)">
                    📝 البيانات الأساسية
                </button>
                @if (SupplierId > 0)
                {
                    <button class="tab @(activeTab == 1 ? "tab-active" : "")" @onclick="() => SelectTab(1)">
                        👥 جهات الاتصال <span class="tab-count">@contacts.Count</span>
                    </button>
                    <button class="tab @(activeTab == 2 ? "tab-active" : "")" @onclick="() => SelectTab(2)">
                        📦 الأصناف <span class="tab-count">@supplierItems.Count</span>
                    </button>
                    <button class="tab @(activeTab == 3 ? "tab-active" : "")" @onclick="() => SelectTab(3)">
                        📊 كشف الحساب <span class="tab-count">@statement.Count</span>
                    </button>
                }
            </div>

            <!-- Tab 0: البيانات الأساسية -->
            @if (activeTab == 0)
            {
                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon blue">🏭</div><h3 class="sec-title">البيانات الأساسية</h3></div>
                    <div class="form-grid c4">
                        <div class="f-field">
                            <label class="f-label">الكود</label>
                            <input type="text" class="f-input" value="@(header.SupplierCode ?? "تلقائي")" disabled />
                        </div>
                        <div class="f-field">
                            <label class="f-label required">اسم المورد (عربي)</label>
                            <input type="text" class="f-input @(supplierErrors.ContainsKey(nameof(header.SupplierNameAr)) ? "input-error" : "")"
                                   @bind="header.SupplierNameAr" disabled="@isReadOnly" placeholder="اسم المورد بالعربي..." />
                            @if (supplierErrors.ContainsKey(nameof(header.SupplierNameAr)))
                            {
                                <span class="field-error">@supplierErrors[nameof(header.SupplierNameAr)]</span>
                            }
                        </div>
                        <div class="f-field">
                            <label class="f-label">اسم المورد (إنجليزي)</label>
                            <input type="text" class="f-input" @bind="header.SupplierNameEn" disabled="@isReadOnly" placeholder="Supplier name..." />
                        </div>
                        <div class="f-field">
                            <label class="f-label required">النوع</label>
                            <select class="f-input @(supplierErrors.ContainsKey(nameof(header.SupplierType)) ? "input-error" : "")"
                                    @bind="header.SupplierType" disabled="@isReadOnly">
                                <option value="1">🟣 مورد خامات</option>
                                <option value="2">🔵 مورد تعبئة</option>
                                <option value="3">🟠 مورد خدمات</option>
                                <option value="4">⚪ مورد عام</option>
                            </select>
                            @if (supplierErrors.ContainsKey(nameof(header.SupplierType)))
                            {
                                <span class="field-error">@supplierErrors[nameof(header.SupplierType)]</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon green">📞</div><h3 class="sec-title">بيانات التواصل</h3></div>
                    <div class="form-grid c4">
                        <div class="f-field">
                            <label class="f-label">هاتف 1</label>
                            <input type="text" class="f-input @(supplierErrors.ContainsKey("Phone1") ? "input-error" : "")"
                                   @bind="header.Phone1" disabled="@isReadOnly" placeholder="رقم الهاتف..." />
                            @if (supplierErrors.ContainsKey("Phone1"))
                            {
                                <span class="field-error">@supplierErrors["Phone1"]</span>
                            }
                        </div>
                        <div class="f-field">
                            <label class="f-label">هاتف 2</label>
                            <input type="text" class="f-input @(supplierErrors.ContainsKey("Phone2") ? "input-error" : "")"
                                   @bind="header.Phone2" disabled="@isReadOnly" />
                            @if (supplierErrors.ContainsKey("Phone2"))
                            {
                                <span class="field-error">@supplierErrors["Phone2"]</span>
                            }
                        </div>
                        <div class="f-field">
                            <label class="f-label">موبايل</label>
                            <input type="text" class="f-input @(supplierErrors.ContainsKey("Mobile") ? "input-error" : "")"
                                   @bind="header.Mobile" disabled="@isReadOnly" />
                            @if (supplierErrors.ContainsKey("Mobile"))
                            {
                                <span class="field-error">@supplierErrors["Mobile"]</span>
                            }
                        </div>
                        <div class="f-field">
                            <label class="f-label">البريد الإلكتروني</label>
                            <input type="email" class="f-input @(supplierErrors.ContainsKey(nameof(header.Email)) ? "input-error" : "")"
                                   @bind="header.Email" disabled="@isReadOnly" />
                            @if (supplierErrors.ContainsKey(nameof(header.Email)))
                            {
                                <span class="field-error">@supplierErrors[nameof(header.Email)]</span>
                            }
                        </div>
                        <div class="f-field">
                            <label class="f-label">الموقع الإلكتروني</label>
                            <input type="text" class="f-input" @bind="header.Website" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">المدينة</label>
                            <input type="text" class="f-input" @bind="header.City" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">الدولة</label>
                            <input type="text" class="f-input" @bind="header.Country" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">العنوان</label>
                            <input type="text" class="f-input" @bind="header.Address" disabled="@isReadOnly" />
                        </div>
                    </div>
                </div>

                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon orange">📋</div><h3 class="sec-title">البيانات القانونية والمالية</h3></div>
                    <div class="form-grid c4">
                        <div class="f-field">
                            <label class="f-label">الرقم الضريبي</label>
                            <input type="text" class="f-input" @bind="header.TaxNumber" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">السجل التجاري</label>
                            <input type="text" class="f-input" @bind="header.CommercialRegister" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">شروط الدفع</label>
                            <select class="f-input" @bind="header.PaymentTermID" disabled="@isReadOnly">
                                <option value="0">-- اختر --</option>
                                @if (paymentTerms != null)
                                {
                                    @foreach (var pt in paymentTerms)
                                    {
                                        <option value="@pt.Id">@pt.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="f-field">
                            <label class="f-label">العملة</label>
                            <select class="f-input" @bind="header.CurrencyID" disabled="@isReadOnly">
                                <option value="0">-- اختر --</option>
                                @if (currencies != null)
                                {
                                    @foreach (var c in currencies)
                                    {
                                        <option value="@c.Id">@c.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="f-field">
                            <label class="f-label required">حد الائتمان</label>
                            <input type="number" class="f-input @(supplierErrors.ContainsKey(nameof(header.CreditLimit)) ? "input-error" : "")"
                                   @bind="header.CreditLimit" step="0.01" disabled="@isReadOnly" />
                            @if (supplierErrors.ContainsKey(nameof(header.CreditLimit)))
                            {
                                <span class="field-error">@supplierErrors[nameof(header.CreditLimit)]</span>
                            }
                        </div>
                        <div class="f-field">
                            <label class="f-label">الرصيد الافتتاحي</label>
                            <input type="number" class="f-input" @bind="header.OpeningBalance" step="0.01"
                                   disabled="@(isReadOnly || SupplierId > 0)" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">التقييم</label>
                            <select class="f-input" @bind="header.Rating" disabled="@isReadOnly">
                                @foreach (SupplierRating rating in Enum.GetValues(typeof(SupplierRating)))
                                {
                                    <option value="@((int)rating)">@GetRatingName(rating)</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="doc-section">
                    <div class="sec-head"><div class="sec-icon purple">🏦</div><h3 class="sec-title">البيانات البنكية</h3></div>
                    <div class="form-grid c3">
                        <div class="f-field">
                            <label class="f-label">اسم البنك</label>
                            <input type="text" class="f-input" @bind="header.BankName" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">رقم الحساب</label>
                            <input type="text" class="f-input" @bind="header.BankAccountNumber" disabled="@isReadOnly" />
                        </div>
                        <div class="f-field">
                            <label class="f-label">IBAN</label>
                            <input type="text" class="f-input" @bind="header.IBAN" disabled="@isReadOnly" />
                        </div>
                    </div>
                </div>

                <div class="doc-section">
                    <div class="form-grid c1">
                        <div class="f-field">
                            <label class="f-label">ملاحظات</label>
                            <textarea class="f-input" rows="3" @bind="header.Notes" disabled="@isReadOnly" placeholder="ملاحظات عامة..."></textarea>
                        </div>
                    </div>
                </div>

                @if (!isViewMode)
                {
                    <div class="doc-actions">
                        <div>
                            <button class="btn-m btn-primary" @onclick="SaveSupplier" disabled="@isSaving" title="حفظ (Ctrl+S)">
                                @if (isSaving) { <div class="btn-spin"></div> } @(isNewMode ? "💾 حفظ المورد" : "💾 حفظ التعديلات")
                            </button>
                            @if (!isNewMode && HasChanges())
                            {
                                <span class="unsaved-indicator">* هناك تعديلات غير محفوظة</span>
                            }
                        </div>
                        <button class="btn-m btn-ghost" @onclick="GoBack" title="رجوع">رجوع</button>
                    </div>
                }
            }

            <!-- Tab 1: جهات الاتصال -->
            @if (activeTab == 1 && SupplierId > 0)
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon green">👥</div>
                        <h3 class="sec-title">جهات الاتصال</h3>
                        <span class="sec-badge">@contacts.Count</span>
                        @if (!isViewMode)
                        {
                            <button class="btn-m btn-primary btn-sm" @onclick="ShowAddContact" style="margin-right:auto;">+ إضافة</button>
                        }
                    </div>

                    @if (!contacts.Any() && !showContactForm)
                    {
                        <div class="empty-lines"><p>لا توجد جهات اتصال</p></div>
                    }
                    else if (contacts.Any())
                    {
                        <div class="tbl-card">
                            <table class="tbl">
                                <thead>
                                    <tr>
                                        <th>#</th><th>الاسم</th><th>المنصب</th><th>الهاتف</th><th>الموبايل</th><th>البريد</th>
                                        <th class="tc">رئيسي</th>
                                        @if (!isViewMode) { <th class="tc">إجراءات</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int cn = 0; }
                                    @foreach (var c in contacts)
                                    {
                                        cn++;
                                        <tr>
                                            <td class="td-n">@cn</td>
                                            <td class="td-name">@c.ContactName</td>
                                            <td class="td-muted">@(c.JobTitle ?? "—")</td>
                                            <td>@(c.Phone ?? "—")</td>
                                            <td>@(c.Mobile ?? "—")</td>
                                            <td>@(c.Email ?? "—")</td>
                                            <td class="tc">@(c.IsPrimary ? "✅" : "")</td>
                                            @if (!isViewMode)
                                            {
                                                <td class="tc">
                                                    <button class="act-btn" @onclick="() => ShowDeleteContact(c.ContactID)" title="حذف">🗑️</button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (showContactForm)
                    {
                        <div class="line-form">
                            <div class="line-form-head">
                                <h4>إضافة جهة اتصال</h4>
                                <button class="btn-close-x" @onclick="() => showContactForm = false" title="إغلاق">✕</button>
                            </div>
                            <div class="form-grid c3">
                                <div class="f-field">
                                    <label class="f-label required">الاسم</label>
                                    <input type="text" class="f-input @(contactErrors.ContainsKey(nameof(newContact.ContactName)) ? "input-error" : "")"
                                           @bind="newContact.ContactName" />
                                    @if (contactErrors.ContainsKey(nameof(newContact.ContactName)))
                                    {
                                        <span class="field-error">@contactErrors[nameof(newContact.ContactName)]</span>
                                    }
                                </div>
                                <div class="f-field">
                                    <label class="f-label">المنصب</label>
                                    <input type="text" class="f-input" @bind="newContact.JobTitle" />
                                </div>
                                <div class="f-field">
                                    <label class="f-label">الهاتف</label>
                                    <input type="text" class="f-input @(contactErrors.ContainsKey("Phone") ? "input-error" : "")"
                                           @bind="newContact.Phone" />
                                    @if (contactErrors.ContainsKey("Phone"))
                                    {
                                        <span class="field-error">@contactErrors["Phone"]</span>
                                    }
                                </div>
                                <div class="f-field">
                                    <label class="f-label">الموبايل</label>
                                    <input type="text" class="f-input @(contactErrors.ContainsKey("Mobile") ? "input-error" : "")"
                                           @bind="newContact.Mobile" />
                                    @if (contactErrors.ContainsKey("Mobile"))
                                    {
                                        <span class="field-error">@contactErrors["Mobile"]</span>
                                    }
                                </div>
                                <div class="f-field">
                                    <label class="f-label">البريد</label>
                                    <input type="email" class="f-input @(contactErrors.ContainsKey(nameof(newContact.Email)) ? "input-error" : "")"
                                           @bind="newContact.Email" />
                                    @if (contactErrors.ContainsKey(nameof(newContact.Email)))
                                    {
                                        <span class="field-error">@contactErrors[nameof(newContact.Email)]</span>
                                    }
                                </div>
                                <div class="f-field">
                                    <label class="f-label">رئيسي؟</label>
                                    <select class="f-input" @bind="newContact.IsPrimary">
                                        <option value="false">لا</option>
                                        <option value="true">نعم</option>
                                    </select>
                                </div>
                            </div>
                            <div class="line-form-btns">
                                <button class="btn-m btn-primary" @onclick="SaveContact">💾 حفظ</button>
                                <button class="btn-m btn-ghost" @onclick="() => showContactForm = false">إلغاء</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Tab 2: الأصناف -->
            @if (activeTab == 2 && SupplierId > 0)
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon blue">📦</div>
                        <h3 class="sec-title">أصناف المورد</h3>
                        <span class="sec-badge">@supplierItems.Count</span>
                        @if (!isViewMode)
                        {
                            <button class="btn-m btn-primary btn-sm" @onclick="ShowAddItem" style="margin-right:auto;">+ إضافة صنف</button>
                        }
                    </div>

                    @if (!supplierItems.Any() && !showItemForm)
                    {
                        <div class="empty-lines"><p>لا توجد أصناف مرتبطة</p></div>
                    }
                    else if (supplierItems.Any())
                    {
                        <div class="tbl-card">
                            <table class="tbl">
                                <thead>
                                    <tr>
                                        <th>#</th><th>الكود</th><th>الصنف</th><th>كود المورد</th><th class="tl">السعر</th>
                                        <th class="tc">أقل كمية</th><th class="tc">مدة التوريد</th><th class="tc">رئيسي</th>
                                        @if (!isViewMode) { <th class="tc">إجراءات</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int sn = 0; }
                                    @foreach (var si in supplierItems)
                                    {
                                        sn++;
                                        <tr>
                                            <td class="td-n">@sn</td>
                                            <td><code class="code-tag">@si.ItemCode</code></td>
                                            <td class="td-name">@si.ItemNameAr</td>
                                            <td class="td-muted">@(si.SupplierItemCode ?? "—")</td>
                                            <td class="tl num-cell">@si.UnitPrice.ToString("#,##0.00")</td>
                                            <td class="tc">@si.MinOrderQty.ToString("#,##0.##")</td>
                                            <td class="tc">@si.LeadTimeDays يوم</td>
                                            <td class="tc">@(si.IsPrimary ? "✅" : "")</td>
                                            @if (!isViewMode)
                                            {
                                                <td class="tc">
                                                    <button class="act-btn" @onclick="() => ShowDeleteItem(si.SupplierItemID)" title="حذف">🗑️</button>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (showItemForm)
                    {
                        <div class="line-form">
                            <div class="line-form-head">
                                <h4>إضافة صنف للمورد</h4>
                                <button class="btn-close-x" @onclick="() => showItemForm = false" title="إغلاق">✕</button>
                            </div>
                            @if (isLoadingItems)
                            {
                                <div class="loading-inline"><div class="loader-sm"></div> جاري التحميل...</div>
                            }
                            else
                            {
                                <div class="form-grid c3">
                                    <div class="f-field">
                                        <label class="f-label required">الصنف</label>
                                        <select class="f-input @(itemErrors.ContainsKey(nameof(newItem.ItemID)) ? "input-error" : "")"
                                                @onchange="@((ChangeEventArgs e) => { if (int.TryParse(e.Value?.ToString(), out int id)) HandleItemSelected(id); })">
                                            <option value="0">-- اختر صنف --</option>
                                            @if (allItems != null)
                                            {
                                                @foreach (var item in allItems)
                                                {
                                                    <option value="@item.Id" selected="@(newItem.ItemID == item.Id)">@(item.Code ?? "") - @item.Name</option>
                                                }
                                            }
                                        </select>
                                        @if (itemErrors.ContainsKey(nameof(newItem.ItemID)))
                                        {
                                            <span class="field-error">@itemErrors[nameof(newItem.ItemID)]</span>
                                        }
                                    </div>
                                    <div class="f-field">
                                        <label class="f-label">كود المورد للصنف</label>
                                        <input type="text" class="f-input" @bind="newItem.SupplierItemCode" />
                                    </div>
                                    <div class="f-field">
                                        <label class="f-label required">السعر</label>
                                        <input type="number" class="f-input @(itemErrors.ContainsKey(nameof(newItem.UnitPrice)) ? "input-error" : "")"
                                               @bind="newItem.UnitPrice" step="0.01" />
                                        @if (itemErrors.ContainsKey(nameof(newItem.UnitPrice)))
                                        {
                                            <span class="field-error">@itemErrors[nameof(newItem.UnitPrice)]</span>
                                        }
                                    </div>
                                    <div class="f-field">
                                        <label class="f-label">أقل كمية طلب</label>
                                        <input type="number" class="f-input @(itemErrors.ContainsKey(nameof(newItem.MinOrderQty)) ? "input-error" : "")"
                                               @bind="newItem.MinOrderQty" step="0.01" />
                                        @if (itemErrors.ContainsKey(nameof(newItem.MinOrderQty)))
                                        {
                                            <span class="field-error">@itemErrors[nameof(newItem.MinOrderQty)]</span>
                                        }
                                    </div>
                                    <div class="f-field">
                                        <label class="f-label">مدة التوريد (يوم)</label>
                                        <input type="number" class="f-input @(itemErrors.ContainsKey(nameof(newItem.LeadTimeDays)) ? "input-error" : "")"
                                               @bind="newItem.LeadTimeDays" />
                                        @if (itemErrors.ContainsKey(nameof(newItem.LeadTimeDays)))
                                        {
                                            <span class="field-error">@itemErrors[nameof(newItem.LeadTimeDays)]</span>
                                        }
                                    </div>
                                    <div class="f-field">
                                        <label class="f-label">مورد رئيسي؟</label>
                                        <select class="f-input" @bind="newItem.IsPrimary">
                                            <option value="false">لا</option>
                                            <option value="true">نعم</option>
                                        </select>
                                    </div>
                                </div>
                            }
                            <div class="line-form-btns">
                                <button class="btn-m btn-primary" @onclick="SaveItem" disabled="@isLoadingItems">💾 حفظ</button>
                                <button class="btn-m btn-ghost" @onclick="() => showItemForm = false">إلغاء</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Tab 3: كشف الحساب -->
            @if (activeTab == 3 && SupplierId > 0)
            {
                <div class="doc-section">
                    <div class="sec-head">
                        <div class="sec-icon orange">📊</div>
                        <h3 class="sec-title">كشف حساب المورد</h3>
                        <span class="sec-badge">@statement.Count حركة</span>
                        @if (header.CurrentBalance != 0)
                        {
                            <span class="bal-chip @(header.CurrentBalance > 0 ? "bal-neg" : "bal-pos")">
                                الرصيد: @header.CurrentBalance.ToString("#,##0.00") ج.م
                            </span>
                        }
                    </div>

                    @if (!statement.Any())
                    {
                        <div class="empty-lines"><p>لا توجد حركات</p></div>
                    }
                    else
                    {
                        <div class="tbl-card">
                            <table class="tbl">
                                <thead>
                                    <tr>
                                        <th>#</th><th>التاريخ</th><th>النوع</th><th>المستند</th><th class="tl">مدين (له)</th>
                                        <th class="tl">دائن (منه)</th><th class="tl">الرصيد</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int stn = 0; decimal runBal = 0; }
                                    @foreach (var st in statement)
                                    {
                                        stn++;
                                        runBal += st.DebitAmount - st.CreditAmount;
                                        <tr>
                                            <td class="td-n">@stn</td>
                                            <td>@st.TransDate.ToString("dd/MM/yyyy")</td>
                                            <td>@st.TransType</td>
                                            <td><code class="code-tag">@st.DocNumber</code></td>
                                            <td class="tl num-cell @(st.DebitAmount > 0 ? "amt-debit" : "")">
                                                @(st.DebitAmount > 0 ? st.DebitAmount.ToString("#,##0.00") : "—")
                                            </td>
                                            <td class="tl num-cell @(st.CreditAmount > 0 ? "amt-credit" : "")">
                                                @(st.CreditAmount > 0 ? st.CreditAmount.ToString("#,##0.00") : "—")
                                            </td>
                                            <td class="tl num-cell"><strong>@runBal.ToString("#,##0.00")</strong></td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="total-row">
                                        <td colspan="4" class="tl"><strong>الإجمالي</strong></td>
                                        <td class="tl num-cell amt-debit"><strong>@statement.Sum(s => s.DebitAmount).ToString("#,##0.00")</strong></td>
                                        <td class="tl num-cell amt-credit"><strong>@statement.Sum(s => s.CreditAmount).ToString("#,##0.00")</strong></td>
                                        <td class="tl num-cell"><strong>@runBal.ToString("#,##0.00") ج.م</strong></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- Delete Confirmation Dialogs -->
    @if (showDeleteContactDialog && contactToDelete != null)
    {
        <div class="modal-ov" @onclick="() => showDeleteContactDialog = false">
            <div class="modal-box" @onclick:stopPropagation="true">
                <h4>🗑️ حذف جهة اتصال</h4>
                <p>هل تريد حذف: <strong>@contactToDelete.ContactName</strong>؟</p>
                <p class="modal-subtitle">هذا الإجراء لا يمكن التراجع عنه</p>
                <div class="modal-btns">
                    <button class="btn-m btn-danger" @onclick="ConfirmDeleteContact">🗑️ حذف نهائي</button>
                    <button class="btn-m btn-ghost" @onclick="() => showDeleteContactDialog = false">إلغاء</button>
                </div>
            </div>
        </div>
    }

    @if (showDeleteItemDialog && itemToDelete != null)
    {
        <div class="modal-ov" @onclick="() => showDeleteItemDialog = false">
            <div class="modal-box" @onclick:stopPropagation="true">
                <h4>🗑️ حذف صنف</h4>
                <p>هل تريد حذف: <strong>@itemToDelete.ItemNameAr</strong>؟</p>
                <p class="modal-subtitle">هذا الإجراء لا يمكن التراجع عنه</p>
                <div class="modal-btns">
                    <button class="btn-m btn-danger" @onclick="ConfirmDeleteItem">🗑️ حذف نهائي</button>
                    <button class="btn-m btn-ghost" @onclick="() => showDeleteItemDialog = false">إلغاء</button>
                </div>
            </div>
        </div>
    }

    <!-- Toast Notification -->
    @if (!string.IsNullOrEmpty(toast))
    {
        <div class="toast-wrap">
            <div class="toast @(toastOk ? "t-ok" : "t-err")">
                <span>@toast</span>
                <button @onclick='() => toast = ""'>✕</button>
            </div>
        </div>
    }
}

