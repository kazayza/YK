@using YKCoatings.Models

<div class="pt-node" style="--pt-depth:@Level">
    <div class="pt-node-card @(Level == 0 ? "pt-root-card" : "")">
        @if (Node.Components.Count > 0)
        {
            <button class="pt-expand" type="button" @onclick="ToggleExpanded" aria-label="@(isExpanded ? "طيّ الفروع" : "توسيع الفروع")">
                @(isExpanded ? "−" : "+")
            </button>
        }
        else
        {
            <span class="pt-leaf-mark"></span>
        }

        <div class="pt-main-info">
            <div class="pt-item-heading">
                <span class="pt-item-code">@Node.ItemCode</span>
                <strong>@Node.ItemName</strong>
            </div>
            <div class="pt-tags">
                <span class="pt-type-tag type-@Node.ItemType">@Node.ItemTypeName</span>
                @if (Node.IsOptional){<span class="pt-neutral-tag">اختياري</span>}
                @if (Node.Quantity.HasValue)
                {
                    <span class="pt-qty-tag">@Node.Quantity.Value.ToString("0.####") @Node.UnitName</span>
                }
                @if (Node.WastePercent > 0)
                {
                    <span class="pt-neutral-tag">نسبة الهالك المسجلة: @Node.WastePercent.ToString("0.##")%</span>
                }
                @if (Node.StageNumber > 0 && Level > 0)
                {
                    <span class="pt-neutral-tag">مرحلة @Node.StageNumber</span>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Node.Notes))
            {
                <p class="pt-notes">@Node.Notes</p>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Node.BOMCode))
        {
            <div class="pt-bom-meta">
                <span class="pt-bom-code">@Node.BOMCode · نسخة @Node.BOMVersion</span>
                @if (Node.BatchSize.HasValue && Node.OutputQty.HasValue)
                {
                    <span>دفعة @Node.BatchSize.Value.ToString("0.####") @Node.BatchUnitName</span>
                    <span>إخراج @Node.OutputQty.Value.ToString("0.####") @Node.OutputUnitName</span>
                }
                @if (Node.EffectiveFrom.HasValue || Node.EffectiveTo.HasValue)
                {
                    <span>الفعالية: @(Node.EffectiveFrom?.ToString("dd/MM/yyyy") ?? "—") إلى @(Node.EffectiveTo?.ToString("dd/MM/yyyy") ?? "مفتوحة")</span>
                }
            </div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Node.ExpansionNote))
    {
        <div class="pt-expansion-note">@Node.ExpansionNote</div>
    }
    @if (Node.Components.Count > 0 && isExpanded)
    {
        <div class="pt-children">
            @foreach (var child in Node.Components)
            {
                <ProductionTreeNode Node="child" Level="@(Level + 1)" ExpandSignal="@ExpandSignal" />
            }
        </div>
    }
    @if (Level == 0 && Node.Components.Count == 0 && string.IsNullOrWhiteSpace(Node.ExpansionNote))
    {
        <div class="pt-empty-children">لا توجد مكونات مسجلة في هذه الوصفة.</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ProductionTreeNodeDto Node { get; set; } = new();
    [Parameter] public int Level { get; set; }
    [Parameter] public int ExpandSignal { get; set; }
    private bool isExpanded = true;
    private int lastExpandSignal;

    protected override void OnParametersSet()
    {
        if (lastExpandSignal != ExpandSignal)
        {
            isExpanded = true;
            lastExpandSignal = ExpandSignal;
        }
    }

    private void ToggleExpanded() => isExpanded = !isExpanded;
}

<style>
.pt-node{position:relative;margin:10px 0}.pt-node-card{position:relative;display:flex;align-items:flex-start;gap:11px;padding:13px 14px;background:#fff;border:1px solid #e9e2d0;border-radius:13px;box-shadow:0 4px 13px rgba(10,15,30,.035)}.pt-root-card{background:linear-gradient(115deg,#0a101d,#182131);border:1px solid rgba(212,175,55,.58);color:#f5e6c8;box-shadow:0 12px 26px rgba(7,11,20,.13)}.pt-expand{flex:0 0 27px;width:27px;height:27px;border-radius:8px;border:1px solid rgba(212,175,55,.55);background:#101725;color:#d8b849;font-size:1.1rem;font-weight:800;line-height:1;cursor:pointer}.pt-leaf-mark{flex:0 0 10px;width:10px;height:10px;margin:8px 8px 0 9px;border-radius:50%;background:#d4af37;box-shadow:0 0 0 4px rgba(212,175,55,.11)}.pt-main-info{min-width:0;flex:1}.pt-item-heading{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap}.pt-item-heading strong{font-size:.87rem;color:#172033}.pt-root-card .pt-item-heading strong{color:#f5e6c8}.pt-item-code{font:800 .73rem Consolas,monospace;color:#8b6c17;direction:ltr}.pt-root-card .pt-item-code{color:#e6c65c}.pt-tags{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-top:7px}.pt-type-tag,.pt-neutral-tag,.pt-qty-tag{display:inline-flex;padding:4px 8px;border-radius:999px;font-size:.65rem;font-weight:800}.pt-type-tag{background:#f2f4f7;color:#3c4655}.pt-type-tag.type-1{background:#edf4ff;color:#28538b}.pt-type-tag.type-2{background:#ecf9fb;color:#136b78}.pt-type-tag.type-3{background:#fff4dc;color:#8c6515}.pt-type-tag.type-4{background:#eaf7ee;color:#287343}.pt-neutral-tag{background:#f5f3ed;color:#716b5b}.pt-qty-tag{background:#fbf4d8;border:1px solid #eee0a6;color:#654f0d}.pt-notes{margin:8px 0 0;color:#707887;font-size:.7rem;line-height:1.6}.pt-root-card .pt-notes{color:#b7bec9}.pt-bom-meta{display:flex;flex-direction:column;align-items:flex-start;gap:4px;min-width:160px;padding:7px 10px;border-radius:9px;background:#fbf8ec;border:1px solid #efe5bf;color:#74601e;font-size:.64rem;white-space:nowrap}.pt-root-card .pt-bom-meta{background:rgba(212,175,55,.08);border-color:rgba(212,175,55,.25);color:#e4d29a}.pt-bom-code{font-weight:900}.pt-children{position:relative;margin-right:25px;padding-right:18px;border-right:2px solid rgba(212,175,55,.32)}.pt-children:before{content:'';position:absolute;top:0;right:-2px;width:16px;border-top:2px solid rgba(212,175,55,.32)}.pt-expansion-note,.pt-empty-children{margin:6px 0 8px 36px;padding:9px 12px;background:#fbf7e9;border:1px solid #eee1b3;border-radius:9px;color:#6a571f;font-size:.7rem}.pt-empty-children{color:#7b8492;background:#f8f8f6;border-color:#e7e5df}.pt-node{padding-right:calc(var(--pt-depth) * 0px)}
@@media(max-width:700px){.pt-node-card{flex-wrap:wrap}.pt-bom-meta{width:100%;margin-right:37px;white-space:normal}.pt-children{margin-right:13px;padding-right:12px}.pt-expansion-note,.pt-empty-children{margin-right:28px}.pt-item-heading strong{font-size:.8rem}}
</style>
