    private string GetPageTitle()
    {
        var uri = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/').ToLower();
        return uri switch
        {
            "" or "dashboard" => "لوحة التحكم",
            "suppliers" => "الموردين","items" => "الأصناف","warehouses" => "المخازن",
            "purchase-requests" => "طلبات الشراء","purchase-orders" => "أوامر الشراء",
            "stock-balances" => "أرصدة المخزون","users" => "المستخدمين","roles" => "الصلاحيات","audit" => "سجل العمليات",
            _ => "واي كي كوتينج ERP"
        };
    }
    private string GetInitials()
    {
        if (string.IsNullOrWhiteSpace(UserSession.FullName)) return "YK";
        var parts = UserSession.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : parts[0][0].ToString().ToUpper();
    }
    private async Task DoLogout(bool isAutoLogout = false)
    {
        try{if (UserSession.UserID > 0) await LoginHistoryService.RecordLogoutAsync(UserSession.UserID);}catch{}
        try{await JS.InvokeVoidAsync("sessionTimeoutManager.stop");}catch{}
        showSessionWarning = false;
        PermissionService.Clear();
        await UserSession.LogoutAsync();
        if (isAutoLogout) Navigation.NavigateTo("/login", true);
        else Navigation.NavigateTo("/login");
    }
    private async Task LoadNotifications()
    {
        try
        {
            notifications = await NotificationService.GetUserNotificationsAsync(UserSession.UserID, UserSession.RoleID);
            var newCount = await NotificationService.GetUnreadCountAsync(UserSession.UserID, UserSession.RoleID);
            if (newCount > _lastUnreadCount && _lastUnreadCount >= 0){try{await JS.InvokeVoidAsync("playNotificationSound");}catch{}}
            _lastUnreadCount = newCount;unreadCount = newCount;
        }catch{}
    }
    private async Task ToggleNotifications(){showNotifications = !showNotifications;showUserMenu = false;if (showNotifications) await LoadNotifications();}
    private async Task MarkAllRead(){await NotificationService.MarkAllAsReadAsync(UserSession.UserID, UserSession.RoleID);await LoadNotifications();StateHasChanged();}
    private async Task OnNotifClick(NotificationDto notif)
    {
        if (!notif.IsRead){await NotificationService.MarkAsReadAsync(notif.NotificationID);notif.IsRead = true;unreadCount = Math.Max(0, unreadCount - 1);}
        showNotifications = false;
        if (!string.IsNullOrEmpty(notif.RelatedModule) && notif.RelatedRecordID > 0){var route = ModuleRouteHelper.GetRoute(notif.RelatedModule);Navigation.NavigateTo($"{route}/view/{notif.RelatedRecordID}");}
        else if (!string.IsNullOrEmpty(notif.RelatedModule)){Navigation.NavigateTo(ModuleRouteHelper.GetRoute(notif.RelatedModule));}
    }
    private string GetTimeAgo(DateTime date)
    {
        var diff = DateTime.Now - date;
        if (diff.TotalMinutes < 1) return "الآن";
        if (diff.TotalMinutes < 60) return $"منذ {(int)diff.TotalMinutes} دقيقة";
        if (diff.TotalHours < 24) return $"منذ {(int)diff.TotalHours} ساعة";
        if (diff.TotalDays < 7) return $"منذ {(int)diff.TotalDays} يوم";
        return date.ToString("dd/MM/yyyy");
    }
    private async Task InitializeSessionTimeoutAsync()
    {
        try
        {
            var timeoutValue = await SettingService.GetSettingValueAsync("SessionTimeout");
            if (!int.TryParse(timeoutValue, out _sessionTimeoutMinutes) || _sessionTimeoutMinutes < 2) _sessionTimeoutMinutes = 30;
            _sessionWarningMinutes = _sessionTimeoutMinutes > 2 ? 2 : 1;
            _sessionTimeoutRef?.Dispose();
            _sessionTimeoutRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("sessionTimeoutManager.init", _sessionTimeoutRef, _sessionTimeoutMinutes, _sessionWarningMinutes);
        }catch{}
    }
    private async Task StayLoggedIn(){showSessionWarning = false;try{await JS.InvokeVoidAsync("sessionTimeoutManager.stayAlive");}catch{}StateHasChanged();}
    [JSInvokable] public async Task ShowSessionWarning(){showSessionWarning = true;await InvokeAsync(StateHasChanged);}
    [JSInvokable] public async Task HideSessionWarning(){showSessionWarning = false;await InvokeAsync(StateHasChanged);}
    [JSInvokable] public async Task ForceLogoutFromIdle(){await DoLogout(true);}
    public void Dispose(){UserSession.OnChange -= Refresh;Navigation.LocationChanged -= OnLocationChanged;_notifTimer?.Dispose();_sessionTimeoutRef?.Dispose();}
}
