@inherits LayoutComponentBase
@implements IDisposable
@using YKCoatings.Services
@using YKCoatings.Helpers
@using YKCoatings.Models
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject SettingService SettingService
@inject LoginHistoryService LoginHistoryService

@* ═══ بوابة الجلسة ═══
   لا نُظهر الهيكل أو الصفحة الحالية قبل معرفة حالة تسجيل الدخول،
   حتى لا يرى فحص الصفحات (OnInitializedAsync) أن IsLoggedIn=false
   عند عمل Refresh فيقوم بطرد المستخدم إلى /login. *@
@if (!sessionReady)
{
    <div class="app-boot" dir="rtl">
        <img src="/images/yk-logo.svg" alt="واي كي كوتينج" class="app-boot-logo" />
        <div class="app-boot-spinner"></div>
        <div class="app-boot-text">جاري تجهيز النظام…</div>
    </div>
}
else
{
<div class="app-shell @(isCollapsed ? "sidebar-collapsed" : "")" dir="rtl">
    
    <!-- Mobile Overlay -->
    <div class="mobile-overlay @(isMobileOpen ? "visible" : "")" @onclick="CloseMobile"></div>

    <!-- ===== SIDEBAR ===== -->
    <aside class="app-sidebar @(isMobileOpen ? "mobile-open" : "")">
        
        <!-- Logo Header -->
        <div class="sb-header">
            <div class="sb-brand">
                <div class="sb-logo">
                    @if (!isCollapsed)
                    {
                        <img src="/images/yk-logo.svg" alt="واي كي كوتينج" class="sb-logo-full" />
                    }
                    else
                    {
                        <img src="/images/yk-icon.svg" alt="YK" class="sb-logo-icon" />
                    }
                </div>
                
                <!-- الاسم التجاري مدمج داخل الشعار — لا تكرار للنص -->
            </div>

            <!-- Collapse Button Desktop -->
            <button class="sb-collapse-btn desktop-only" 
                    @onclick="ToggleCollapse" 
                    title="@(isCollapsed ? "توسيع القائمة" : "طي القائمة")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    @if (isCollapsed)
                    {
                        <path d="M9 18l6-6-6-6"/>
                    }
                    else
                    {
                        <path d="M15 18l-6-6 6-6"/>
                    }
                </svg>
            </button>

            <!-- Close Button Mobile -->
            <button class="sb-collapse-btn mobile-only" @onclick="CloseMobile">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M18 6 6 18"/><path d="M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <!-- User Info -->
        <div class="sb-user">
            <div class="sb-avatar" title="@UserSession.FullName">
                @GetInitials()
            </div>
            <div class="sb-user-text">
                <span class="sb-user-name">@UserSession.FullName</span>
                <span class="sb-user-role">
                    <span class="online-dot"></span>
                    @UserSession.RoleName
                </span>
            </div>
        </div>

        <!-- Navigation -->
        <div class="sb-nav-area">
            <NavMenu IsCollapsed="@isCollapsed"/>
        </div>

        <!-- Sidebar Footer -->
        <div class="sb-footer">
            <div class="sb-footer-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                </svg>
            </div>
            <div class="sb-footer-text">
                <span>الإصدار 2.0</span>
                <span class="sb-footer-status">● متصل</span>
            </div>
        </div>
    </aside>

    <!-- ===== MAIN CONTENT ===== -->
    <main class="app-main">
        
        <!-- Top Bar -->
        <header class="app-topbar">
            <div class="tb-right">
                <!-- Mobile Menu Button -->
                <button class="tb-menu-btn" @onclick="OpenMobile" title="القائمة">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/>
                    </svg>
                </button>

                <!-- Page Info -->
                <div class="tb-page-info">
                    <h1 class="tb-title">@GetPageTitle()</h1>
                    <p class="tb-breadcrumb">
                        <span>الرئيسية</span>
                        <span class="breadcrumb-sep">›</span>
                        <span>@GetPageTitle()</span>
                    </p>
                </div>
            </div>

            <div class="tb-left">
                
                <!-- Notifications -->
                <div class="notif-wrap">
                    @if (showNotifications)
                    {
                        <div class="notif-bg" @onclick="@(() => showNotifications = false)"></div>
                    }

                    <button class="tb-icon-btn" 
                            @onclick="ToggleNotifications" 
                            title="الإشعارات">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
                        </svg>
                        @if (unreadCount > 0)
                        {
                            <span class="notif-badge">@(unreadCount > 9 ? "9+" : unreadCount.ToString())</span>
                        }
                    </button>

                    @if (showNotifications)
                    {
                        <div class="notif-panel">
                            <div class="notif-panel-head">
                                <span class="notif-panel-title">
                                    🔔 الإشعارات
                                    @if (unreadCount > 0)
                                    {
                                        <span class="notif-count-chip">@unreadCount</span>
                                    }
                                </span>
                                @if (unreadCount > 0)
                                {
                                    <button class="notif-read-all" 
                                            @onclick="MarkAllRead" 
                                            @onclick:stopPropagation="true">
                                        تحديد الكل كمقروء ✓
                                    </button>
                                }
                            </div>

                            <div class="notif-panel-body">
                                @if (notifications == null || !notifications.Any())
                                {
                                    <div class="notif-empty">
                                        <div class="notif-empty-icon">🔕</div>
                                        <span>لا توجد إشعارات جديدة</span>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var notif in notifications)
                                    {
                                        <button class="notif-item @(!notif.IsRead ? "unread" : "") @(notif.IsActioned ? "actioned" : "")"
                                                @onclick="@(() => OnNotifClick(notif))"
                                                @onclick:stopPropagation="true">
                                            <div class="notif-item-icon">
                                                @NotificationService.GetTypeIcon(notif.NotificationType)
                                            </div>
                                            <div class="notif-item-body">
                                                <div class="notif-item-title">@notif.Title</div>
                                                <div class="notif-item-msg">@notif.Message</div>
                                                <div class="notif-item-time">
                                                    🕐 @GetTimeAgo(notif.NotificationDate)
                                                </div>
                                            </div>
                                            @if (!notif.IsRead)
                                            {
                                                <div class="notif-unread-dot" 
                                                     style="background:@NotificationService.GetPriorityColor(notif.Priority)">
                                                </div>
                                            }
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Date -->
                <div class="tb-date hide-sm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                        <path d="M16 2v4M8 2v4M3 10h18"/>
                    </svg>
                    <span>@DateTime.Now.ToString("dd/MM/yyyy")</span>
                </div>

                <!-- Role Badge -->
                <div class="tb-role hide-sm">@UserSession.RoleName</div>

                <!-- Logout -->
                <button class="tb-logout" @onclick="@(async () => await DoLogout())" title="تسجيل الخروج">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                        <path d="M16 17l5-5-5-5"/>
                        <path d="M21 12H9"/>
                    </svg>
                    <span class="logout-text">خروج</span>
                </button>
            </div>
        </header>

        <!-- Page Content -->
        <div class="app-body">
            <div class="app-body-inner">
                @Body
            </div>
        </div>

        <!-- Footer -->
        <footer class="app-footer">
    <span>© @DateTime.Now.Year واي كي كوتينج ERP</span>
    <span class="footer-sep">·</span>
    <span>الإصدار 2.0</span>
    <span class="footer-sep">·</span>
    <span class="footer-status">
        <span class="status-dot"></span>
        جميع الأنظمة تعمل
    </span>
    <span class="footer-sep">·</span>
    <span class="footer-dev-main">
        تصميم وتطوير : أحمد محمد الرفاعى | للتواصل : 01122050119
    </span>
</footer>
    </main>
    @if (showSessionWarning)
{
    <div class="session-timeout-overlay">
        <div class="session-timeout-modal">
            <div class="session-timeout-icon">⏳</div>

            <div class="session-timeout-title">ستنتهي الجلسة قريبًا</div>

            <div class="session-timeout-text">
    لم يتم اكتشاف أي نشاط على النظام.
    <br />
    سيتم تسجيل الخروج تلقائيًا إذا لم تقم بأي تفاعل.
</div>

            <div class="session-timeout-actions">
                <button class="session-btn session-btn-primary" @onclick="StayLoggedIn">
                    البقاء متصلاً
                </button>

                <button class="session-btn session-btn-danger" @onclick="@(async () => await DoLogout())">
                    تسجيل الخروج الآن
                </button>
            </div>
        </div>
    </div>
}
</div>
}

<style>
    /* ===== CSS VARIABLES ===== */
    :root {
        --sb-width: 280px;
        --sb-mini: 72px;
        --sb-bg: #0f172a;
        --sb-bg2: #1e293b;
        --sb-border: rgba(148,163,184,.12);
        --sb-text: #cbd5e1;
        --sb-text-dim: #64748b;
        --sb-accent: #2563eb;
        --sb-accent-soft: rgba(37,99,235,.14);
        --yk-primary: #2563eb;
        --yk-primary-dark: #1d4ed8;
        --yk-accent: #f97316;
        --yk-accent-soft: rgba(249,115,22,.14);
        --topbar-h: 64px;
        --body-bg: #eef2f7;
        --card-bg: #ffffff;
        --text-primary: #0f172a;
        --text-secondary: #475569;
        --border-color: #e2e8f0;
        --shadow-sm: 0 2px 8px rgba(15,23,42,.06);
        --shadow-md: 0 4px 20px rgba(15,23,42,.08);
        --shadow-lg: 0 8px 32px rgba(15,23,42,.12);
        --radius: 12px;
        --radius-lg: 16px;
        --transition: .25s cubic-bezier(.4,0,.2,1);
    }

    /* ===== RESET ===== */
    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    /* ===== APP SHELL ===== */
    .app-shell {
        display: flex;
        min-height: 100vh;
        background: var(--body-bg);
        font-family: 'Cairo', 'Segoe UI', sans-serif;
    }

    /* ===== MOBILE OVERLAY ===== */
    .mobile-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,23,42,.6);
        backdrop-filter: blur(4px);
        z-index: 200;
        opacity: 0;
        transition: opacity var(--transition);
        pointer-events: none;
    }
    .mobile-overlay.visible {
        opacity: 1;
        pointer-events: auto;
    }

    /* ===== SIDEBAR ===== */
    .app-sidebar {
        width: var(--sb-width);
        min-width: var(--sb-width);
        background: var(--sb-bg);
        color: var(--sb-text);
        display: flex;
        flex-direction: column;
        position: sticky;
        top: 0;
        height: 100vh;
        z-index: 210;
        transition: width var(--transition), min-width var(--transition);
        overflow: hidden;
        border-left: 1px solid var(--sb-border);
        box-shadow: 4px 0 24px rgba(0,0,0,.15);
    }

    .sidebar-collapsed .app-sidebar {
        width: var(--sb-mini);
        min-width: var(--sb-mini);
    }

    /* ===== SIDEBAR HEADER / LOGO ===== */
    .sb-header {
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--sb-border);
        min-height: 76px;
        background: rgba(0,0,0,.1);
        gap: 8px;
    }

    .sidebar-collapsed .sb-header {
        padding: 14px 8px;
    }

    .sb-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        flex: 1;
    }

    /* ===== الشعار ===== */
    .sb-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        transition: var(--transition);
    }

    /* الشعار الكامل (يظهر عند التوسيع) — بألوان الهوية الأصلية */
    .sb-logo-full {
        height: 40px;
        width: auto;
        max-width: 172px;
        object-fit: contain;
    }

    /* الأيقونة المختصرة (تظهر عند الطي) */
    .sb-logo-icon {
        width: 36px;
        height: 36px;
        object-fit: contain;
    }

    .sb-logo-fallback svg {
        width: 100%;
        height: 100%;
    }

    .sb-brand-name-fallback {
        font-weight: 800;
        font-size: .92rem;
        color: #f1f5f9;
        white-space: nowrap;
    }

    .sb-brand-desc {
        font-size: .7rem;
        color: var(--sb-text-dim);
        margin-top: 2px;
        white-space: nowrap;
    }

    /* Collapse Button */
    .sb-collapse-btn {
        width: 32px;
        height: 32px;
        border: 1px solid var(--sb-border);
        background: rgba(255,255,255,.05);
        color: var(--sb-text-dim);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        flex-shrink: 0;
        transition: var(--transition);
        margin-right: 4px;
    }
    .sb-collapse-btn:hover {
        background: var(--sb-accent-soft);
        color: var(--sb-accent);
        border-color: rgba(37,99,235,.3);
    }
    .sb-collapse-btn svg { width: 16px; height: 16px; }

    .desktop-only { display: flex; }
    .mobile-only { display: none; }

    /* ===== USER SECTION ===== */
    .sb-user {
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid var(--sb-border);
        background: rgba(255,255,255,.02);
    }

    .sb-avatar {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: linear-gradient(135deg, #1e40af, #2563eb);
        border: 2px solid rgba(37,99,235,.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        color: #fff;
        font-size: .88rem;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(37,99,235,.3);
        cursor: default;
    }

    .sb-user-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        transition: opacity var(--transition);
    }

    .sidebar-collapsed .sb-user-text {
        opacity: 0;
        width: 0;
        pointer-events: none;
    }

    .sb-user-name {
        font-weight: 700;
        font-size: .86rem;
        color: #e2e8f0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sb-user-role {
        font-size: .74rem;
        color: var(--sb-text-dim);
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 3px;
    }

    .online-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #22c55e;
        box-shadow: 0 0 0 3px rgba(34,197,94,.2);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { box-shadow: 0 0 0 3px rgba(34,197,94,.2); }
        50% { box-shadow: 0 0 0 6px rgba(34,197,94,.1); }
    }

    /* ===== NAV AREA ===== */
    .sb-nav-area {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 12px 10px;
        scrollbar-width: thin;
        scrollbar-color: rgba(148,163,184,.15) transparent;
    }
    .sb-nav-area::-webkit-scrollbar { width: 4px; }
    .sb-nav-area::-webkit-scrollbar-thumb {
        background: rgba(148,163,184,.15);
        border-radius: 99px;
    }

    /* ===== SIDEBAR FOOTER ===== */
    .sb-footer {
        padding: 12px 16px;
        border-top: 1px solid var(--sb-border);
        display: flex;
        align-items: center;
        gap: 10px;
        background: rgba(0,0,0,.1);
    }

    .sb-footer-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(255,255,255,.05);
        color: var(--sb-text-dim);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .sb-footer-icon svg { width: 15px; height: 15px; }

    .sb-footer-text {
        display: flex;
        flex-direction: column;
        font-size: .72rem;
        color: var(--sb-text-dim);
        white-space: nowrap;
        transition: opacity var(--transition);
    }

    .sidebar-collapsed .sb-footer-text {
        opacity: 0;
        width: 0;
        pointer-events: none;
    }

    .sb-footer-status {
        color: #22c55e;
        margin-top: 2px;
        font-weight: 600;
    }

    /* ===== MAIN ===== */
    .app-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
    }

    /* ===== TOPBAR ===== */
    .app-topbar {
         position: sticky;
    top: 0;
    z-index: 50;
    background: linear-gradient(135deg, #0b1526 0%, #123a6b 60%, #0f1f38 100%);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(37,99,235,.22);
        padding: 0 24px;
        height: var(--topbar-h);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        box-shadow: var(--shadow-sm);
    }

    .tb-right, .tb-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .tb-menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(249,115,22,.2);
    background: rgba(255,255,255,.05);
    border-radius: var(--radius);
    color: #cbd5e1;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: var(--transition);
    }
    .tb-menu-btn:hover { 
    background: rgba(249,115,22,.15); 
    color: #f97316;
}
    .tb-menu-btn svg { width: 18px; height: 18px; }

    .tb-page-info { display: flex; flex-direction: column; }

    .tb-title {
    font-size: 1rem;
    font-weight: 800;
    color: #f1f5f9;
    line-height: 1.2;
}

.tb-breadcrumb {
    font-size: .74rem;
    color: rgba(249,115,22,.7);
        margin-top: 2px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .breadcrumb-sep {
        opacity: .4;
        font-size: .8rem;
    }

    /* Icon Button */
    .tb-icon-btn {
    position: relative;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(249,115,22,.2);
    background: rgba(255,255,255,.05);
    border-radius: var(--radius);
    color: #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: var(--transition);
        z-index: 210;
    }
    .tb-icon-btn:hover {
    background: rgba(249,115,22,.15);
    color: #f97316;
    border-color: rgba(249,115,22,.4);
}
    .tb-icon-btn svg { width: 18px; height: 18px; }

    /* Notification Badge */
    .notif-badge {
        position: absolute;
        top: -5px;
        right: -5px;
        background: #ef4444;
        color: white;
        font-size: .58rem;
        font-weight: 800;
        min-width: 18px;
        height: 18px;
        border-radius: 999px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0 4px;
        border: 2px solid white;
        line-height: 1;
    }

    /* Date & Role */
    .tb-date {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(249,115,22,.2);
    border-radius: var(--radius);
    font-size: .8rem;
    color: #cbd5e1;
        font-weight: 600;
        white-space: nowrap;
    }
    .tb-date svg { width: 14px; height: 14px; }

    .tb-role {
    padding: 8px 14px;
    background: rgba(249,115,22,.12);
    color: #fdba74;
    border: 1px solid rgba(249,115,22,.3);
        border-radius: var(--radius);
        font-size: .78rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* Logout */
    .tb-logout {
        display: flex;
        align-items: center;
        gap: 8px;
        height: 40px;
        padding: 0 16px;
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        border-radius: var(--radius);
        font-weight: 700;
        font-size: .82rem;
        cursor: pointer;
        transition: var(--transition);
        white-space: nowrap;
    }
    .tb-logout:hover {
        background: #fee2e2;
        border-color: #fca5a5;
        transform: translateY(-1px);
    }
    .tb-logout svg { width: 16px; height: 16px; }

    /* ===== APP BODY ===== */
    .app-body {
        flex: 1;
        padding: 24px;
        background: #eef2f7;
        min-height: calc(100vh - var(--topbar-h) - 48px);
        overflow-x: hidden;
    }

