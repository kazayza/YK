@code {
    private bool isCollapsed;
    private bool isMobileOpen;
    private bool showNotifications = false;
    private bool showUserMenu = false;
    private string navSearch = "";
    private string globalSearch = "";
    private bool showGlobalSearch = false;
    private List<ModulePermissionDto> globalScreenResults = new();
    private List<DashboardService.GlobalSearchResultDto> globalDataResults = new();
    private int globalTotalCount => globalScreenResults.Count + globalDataResults.Count;
    private bool _searchLoading = false;
    private System.Threading.Timer? _searchDebounce;
    private List<NotificationDto>? notifications;
    private int unreadCount = 0;
    private int _lastUnreadCount = -1;
    private System.Threading.Timer? _notifTimer;
    private bool _initialized = false;
    private bool sessionReady = false;
    private DotNetObjectReference<MainLayout>? _sessionTimeoutRef;
    private bool showSessionWarning = false;
    private int _sessionTimeoutMinutes = 30;
    private int _sessionWarningMinutes = 2;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_initialized)
        {
            _initialized = true;
            UserSession.OnChange += Refresh;
            Navigation.LocationChanged += OnLocationChanged;
            var restored = await UserSession.EnsureRestoredAsync();
            sessionReady = true;
            if (!restored){Navigation.NavigateTo("/login");return;}
            if (!PermissionService.IsLoaded){try{await PermissionService.LoadPermissionsAsync(UserSession.UserID);}catch{}}
            if (UserSession.RequiresPasswordChange)
            {
                var currentPath = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].Trim('/').ToLower();
                if (currentPath != "change-password"){Navigation.NavigateTo("/change-password");return;}
            }
            await LoadNotifications();
            await InitializeSessionTimeoutAsync();
            _notifTimer = new System.Threading.Timer(async _ =>{if (UserSession.IsLoggedIn){try{await LoadNotifications();await InvokeAsync(StateHasChanged);}catch{}}}, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
            StateHasChanged();
        }
    }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    private async void OnLocationChanged(object? s, LocationChangedEventArgs e){isMobileOpen = false;showNotifications = false;showUserMenu = false;showGlobalSearch=false;if (UserSession.IsLoggedIn){try{await LoadNotifications();}catch{}}await InvokeAsync(StateHasChanged);}
    private void ToggleCollapse()
    {
        // زر واحد يخفي/يظهر القائمة تماماً
        if (!isCollapsed) // كانت ظاهرة -> اخفيها
        {
            isCollapsed = true;
            isMobileOpen = false;
        }
        else // كانت مخفية -> اظهرها
        {
            isCollapsed = false;
            isMobileOpen = true;
        }
        showUserMenu = false;
        showNotifications = false;
        showGlobalSearch = false;
    }
    private void OpenMobile(){isMobileOpen = true; isCollapsed = false;}
    private void CloseMobile(){isMobileOpen = false; isCollapsed = true;}
    private void ToggleUserMenu(){showUserMenu = !showUserMenu;showNotifications = false; showGlobalSearch=false;}

    // ===== GLOBAL SEARCH - حسب الصلاحيات =====
    private void OnGlobalSearchFocus()
    {
        if (!string.IsNullOrWhiteSpace(globalSearch) && globalSearch.Trim().Length >= 2)
        {
            if (globalScreenResults.Any() || globalDataResults.Any()) showGlobalSearch = true;
            else _ = RunGlobalSearch(globalSearch);
        }
    }
    private void OnGlobalSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape"){CloseGlobalSearch(); return;}
    }
    private void OnGlobalSearchInput(ChangeEventArgs e)
    {
        globalSearch = e.Value?.ToString() ?? "";
        _searchDebounce?.Dispose();
        var txt = globalSearch;
        if (string.IsNullOrWhiteSpace(txt))
        {
            globalScreenResults.Clear(); globalDataResults.Clear(); showGlobalSearch = false; _searchLoading = false;
            StateHasChanged(); return;
        }
        _searchLoading = true;
        _searchDebounce = new System.Threading.Timer(_ =>
        {
            InvokeAsync(async () => await RunGlobalSearch(txt));
        }, null, 300, System.Threading.Timeout.Infinite);
        StateHasChanged();
    }
    private async Task RunGlobalSearch(string txt)
    {
        try
        {
            txt = txt.Trim();
            if (txt.Length < 2){globalScreenResults.Clear(); globalDataResults.Clear(); showGlobalSearch = false; _searchLoading=false; await InvokeAsync(StateHasChanged); return;}

            // 1) الشاشات (كما كان)
            var all = PermissionService.GetMainModules().ToList();
            var childs = new List<ModulePermissionDto>();
            foreach(var m in all){ childs.AddRange(PermissionService.GetChildModules(m.ModuleID)); }
            globalScreenResults = all.Concat(childs).DistinctBy(x=>x.ModuleCode).Where(m =>
                m.ModuleNameAr.Contains(txt, StringComparison.OrdinalIgnoreCase) ||
                m.ModuleCode.Contains(txt, StringComparison.OrdinalIgnoreCase)
            ).Take(6).ToList();

            // 2) بيانات النظام (حسب الصلاحيات)
            var data = await DashboardService.GlobalSearchAsync(txt,
                PermissionService.CanView("SCR_ITEMS"),
                PermissionService.CanView("SCR_CUSTOMERS"),
                PermissionService.CanView("SCR_SUPPLIERS"),
                PermissionService.CanView("SCR_EMP"),
                PermissionService.CanView("SCR_USERS"),
                PermissionService.CanView("SCR_PINV"),
                PermissionService.CanView("SCR_PO"),
                PermissionService.CanView("SCR_PR"));
            globalDataResults = data;

            showGlobalSearch = globalScreenResults.Any() || globalDataResults.Any();
            _searchLoading = false;
        }
        catch
        {
            globalScreenResults.Clear(); globalDataResults.Clear(); showGlobalSearch = false; _searchLoading = false;
        }
        await InvokeAsync(StateHasChanged);
    }
    private void ClearGlobalSearch(){globalSearch="";globalScreenResults.Clear();globalDataResults.Clear();showGlobalSearch=false;}
    private void CloseGlobalSearch(){showGlobalSearch=false;}
    private void GoHome(){Navigation.NavigateTo("/dashboard");}
    private void GoToDataResult(DashboardService.GlobalSearchResultDto r)
    {
        globalSearch=""; showGlobalSearch=false; globalScreenResults.Clear(); globalDataResults.Clear();
        Navigation.NavigateTo(r.Route);
    }
    private void GoToGlobalResult(ModulePermissionDto mod)
    {
        var route = ModuleRouteHelper.GetRoute(mod.ModuleCode);
        globalSearch=""; showGlobalSearch=false; globalScreenResults.Clear(); globalDataResults.Clear();
        Navigation.NavigateTo(route);
    }
