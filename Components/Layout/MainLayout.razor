            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : parts[0][0].ToString().ToUpper();
    }

        private async Task DoLogout(bool isAutoLogout = false)
    {
        // تسجيل وقت الخروج في LoginHistory
        try
        {
            if (UserSession.UserID > 0)
                await LoginHistoryService.RecordLogoutAsync(UserSession.UserID);
        }
        catch { }

        try
        {
            await JS.InvokeVoidAsync("sessionTimeoutManager.stop");
        }
        catch { }
        
        showSessionWarning = false;
        

        PermissionService.Clear();
        await UserSession.LogoutAsync();

        if (isAutoLogout)
            Navigation.NavigateTo("/login", true);
        else
            Navigation.NavigateTo("/login");
    }

    private async Task LoadNotifications()
    {
        try
        {
            notifications = await NotificationService.GetUserNotificationsAsync(
                UserSession.UserID, UserSession.RoleID);

            var newCount = await NotificationService.GetUnreadCountAsync(
                UserSession.UserID, UserSession.RoleID);

            if (newCount > _lastUnreadCount && _lastUnreadCount >= 0)
            {
                try { await JS.InvokeVoidAsync("playNotificationSound"); }
                catch { }
            }

            _lastUnreadCount = newCount;
            unreadCount = newCount;
        }
        catch { }
    }

    private async Task ToggleNotifications()
    {
        showNotifications = !showNotifications;
        if (showNotifications)
            await LoadNotifications();
    }

