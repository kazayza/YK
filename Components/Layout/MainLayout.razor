    {
        await NotificationService.MarkAllAsReadAsync(UserSession.UserID, UserSession.RoleID);
        await LoadNotifications();
        StateHasChanged();
    }

    private async Task OnNotifClick(NotificationDto notif)
    {
        if (!notif.IsRead)
        {
            await NotificationService.MarkAsReadAsync(notif.NotificationID);
            notif.IsRead = true;
            unreadCount = Math.Max(0, unreadCount - 1);
        }

        showNotifications = false;

        if (!string.IsNullOrEmpty(notif.RelatedModule) && notif.RelatedRecordID > 0)
        {
            var route = ModuleRouteHelper.GetRoute(notif.RelatedModule);
            Navigation.NavigateTo($"{route}/view/{notif.RelatedRecordID}");
        }
        else if (!string.IsNullOrEmpty(notif.RelatedModule))
        {
            Navigation.NavigateTo(ModuleRouteHelper.GetRoute(notif.RelatedModule));
        }
    }

    private string GetTimeAgo(DateTime date)
    {
        var diff = DateTime.Now - date;
        if (diff.TotalMinutes < 1) return "الآن";
        if (diff.TotalMinutes < 60) return $"منذ {(int)diff.TotalMinutes} دقيقة";
        if (diff.TotalHours < 24) return $"منذ {(int)diff.TotalHours} ساعة";
        if (diff.TotalDays < 7) return $"منذ {(int)diff.TotalDays} يوم";
        return date.ToString("dd/MM/yyyy");
    }
        private async Task InitializeSessionTimeoutAsync()
{
    try
    {
        var timeoutValue = await SettingService.GetSettingValueAsync("SessionTimeout");

