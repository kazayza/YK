@inherits LayoutComponentBase
@implements IDisposable
@using YKCoatings.Services
@using YKCoatings.Helpers
@using YKCoatings.Models
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject UserSessionService UserSession
@inject PermissionService PermissionService
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject DashboardService DashboardService
@inject IJSRuntime JS
@inject SettingService SettingService
@inject LoginHistoryService LoginHistoryService

@if (!sessionReady)
{
    <div class="app-boot" dir="rtl">
        <img src="/images/yk-logo-white.png" alt="واي كي كوتينج" class="app-boot-logo" style="height:56px" />
        <div class="app-boot-spinner"></div>
        <div class="app-boot-text">جاري تجهيز النظام…</div>
    </div>
}
else
{
<div class="app-shell @(isCollapsed ? "sidebar-collapsed" : "")" dir="rtl">
    <!-- لا يوجد Overlay - القائمة تظهر بدون تعتيم نهائياً -->

    <!-- SIDEBAR - FIXED FULL HEIGHT -->
    <aside class="app-sidebar @(isMobileOpen ? "mobile-open" : "")">
        <div class="sb-gold-line"></div>
        <div class="sb-header">
            <div class="sb-brand">
                <div class="sb-logo-wrap">
                    <img src="/images/yk-icon-gold.png" alt="YK Coatings" class="sb-logo-full" />
                </div>
                <div class="sb-brand-text">
                    <span class="sb-brand-name">واي كي كوتينج</span>
                    <span class="sb-brand-sub">YK COATINGS ERP</span>
                </div>
            </div>
            <button class="sb-close-mobile" @onclick="CloseMobile" title="إغلاق">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
            </button>
        </div>

        <div class="sb-tagline"></div>
        <div class="sb-search">
            <input placeholder="تصفية أقسام القائمة..." @bind="navSearch" @bind:event="oninput" aria-label="تصفية أقسام القائمة" />
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><circle cx="11" cy="11" r="6"/><path d="m21 21-4.3-4.3"/></svg>
            @if (!string.IsNullOrWhiteSpace(navSearch))
            {
                <button class="sb-search-clear" @onclick='() => navSearch = ""' title="مسح" aria-label="مسح التصفية">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="2.4"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
                </button>
            }
        </div>

        <div class="sb-user">
            <div class="sb-avatar">@GetInitials()</div>
            <div class="sb-user-text">
                <span class="sb-user-name">@UserSession.FullName</span>
                <span class="sb-user-role"><span class="online-dot"></span>@UserSession.RoleName</span>
            </div>
        </div>

        <div class="sb-nav-area">
            <NavMenu IsCollapsed="false" SearchText="@navSearch" />
        </div>

        <div class="sb-footer">
            <div class="sb-footer-content">
                <div class="sb-footer-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                </div>
                <div class="sb-footer-text">
                    <span>الإصدار 2.0 Gold Edition</span>
                    <span class="sb-footer-status">● جميع الأنظمة تعمل</span>
                </div>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main class="app-main">
        <header class="app-topbar">
            <div class="tb-right">
                <button class="tb-toggle-btn" @onclick="ToggleCollapse" title="@(isCollapsed ? "إظهار القائمة الجانبية" : "إخفاء القائمة الجانبية")">
                    @if (isCollapsed)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg>
                    }
                </button>
                <a href="/dashboard" class="tb-brand" title="الذهاب إلى الرئيسية">
                    <img src="/images/yk-icon-gold.png" alt="YK Coatings" class="tb-brand-icon" />
                    <span class="tb-brand-text">
                        <span class="tb-brand-name">واي كي كوتينج</span>
                        <span class="tb-brand-sub">YK COATINGS ERP</span>
                    </span>
                </a>
                <div class="tb-divider hide-sm"></div>
                <a href="/dashboard" class="tb-page-info" title="العودة إلى الرئيسية" aria-label="العودة إلى الصفحة الرئيسية">
                    <h1 class="tb-title">@GetPageTitle()</h1>
                    <p class="tb-breadcrumb"><span class="tb-bc-home">الرئيسية</span><span class="breadcrumb-sep">›</span><span>@GetPageTitle()</span></p>
                </a>
            </div>

            <div class="tb-left">
                <div class="tb-search-wrap hide-md @(showGlobalSearch ? "active" : "")">
                    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><circle cx="11" cy="11" r="6"/><path d="m21 21-4.3-4.3"/></svg>
                    <input placeholder="بحث شامل في النظام… (أصناف / عملاء / موردين / مستندات)" value="@globalSearch" @oninput="OnGlobalSearchInput" @onfocus="OnGlobalSearchFocus" @onkeydown="OnGlobalSearchKey" />
                    <span class="tb-kbd">ctrl+K</span>
                    @if (!string.IsNullOrWhiteSpace(globalSearch))
                    {
                        <button class="tb-search-clear" @onclick="ClearGlobalSearch"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="M6 6l12 12"/></svg></button>
                    }
                    @if (showGlobalSearch && globalTotalCount > 0)
                    {
                        <div class="global-search-dropdown">
                            <div class="gs-head">
                                <span>نتائج البحث — @globalTotalCount نتيجة حسب صلاحياتك</span>
                                <span class="gs-count">@globalTotalCount</span>
                            </div>
                            <div class="gs-body">
                                @if (_searchLoading)
                                {
                                    <div class="gs-loading"><span class="gs-spinner"></span> جاري البحث…</div>
                                }
                                @if (globalScreenResults.Any())
                                {
                                    <div class="gs-group"><span class="gs-group-title">الشاشات</span><span class="gs-group-line"></span><span class="gs-group-count">@globalScreenResults.Count</span></div>
                                    @foreach (var mod in globalScreenResults.Take(6))
                                    {
                                        <button class="gs-item" @onclick="() => GoToGlobalResult(mod)">
                                            <span class="gs-icon">@((MarkupString)NavMenuIcons.Get(mod.ModuleCode))</span>
                                            <span class="gs-info"><span class="gs-name">@mod.ModuleNameAr</span><span class="gs-code">@mod.ModuleCode</span></span>
                                            <span class="gs-tag screen">شاشة</span>
                                            <svg class="gs-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                                        </button>
                                    }
                                }
                                @if (globalDataResults.Any())
                                {
                                    <div class="gs-group"><span class="gs-group-title">بيانات النظام</span><span class="gs-group-line"></span><span class="gs-group-count">@globalDataResults.Count</span></div>
                                    @foreach (var row in globalDataResults.Take(14))
                                    {
                                        <button class="gs-item" @onclick="() => GoToDataResult(row)">
                                            <span class="gs-icon data">@((MarkupString)GetDataIcon(row.Type))</span>
                                            <span class="gs-info"><span class="gs-name">@row.Title</span><span class="gs-code">@row.SubTitle</span></span>
                                            <span class="gs-tag @row.Type">@row.TypeLabel</span>
                                            <svg class="gs-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
                                        </button>
                                    }
                                }
                            </div>
                            <div class="gs-foot"><span class="gs-kbd">ESC</span> للإغلاق <span class="gs-sep">·</span> يمكنك البحث بالكود أو الاسم</div>
                        </div>
                        <div class="global-search-bg" @onclick="CloseGlobalSearch"></div>
                    }
                </div>

                <div class="notif-wrap">
                    @if (showNotifications){<div class="notif-bg" @onclick="@(() => showNotifications = false)"></div>}
                    <button class="tb-icon-btn" @onclick="ToggleNotifications" title="الإشعارات">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                        @if (unreadCount > 0){<span class="notif-badge">@(unreadCount > 9 ? "9+" : unreadCount.ToString())</span>}
                    </button>
                    @if (showNotifications)
                    {
                        <div class="notif-panel">
                            <div class="notif-panel-head">
                                <span class="notif-panel-title">🔔 الإشعارات @if(unreadCount>0){<span class="notif-count-chip">@unreadCount</span>}</span>
                                @if (unreadCount > 0){<button class="notif-read-all" @onclick="MarkAllRead" @onclick:stopPropagation="true">تحديد الكل كمقروء ✓</button>}
                            </div>
                            <div class="notif-panel-body">
                                @if (notifications == null || !notifications.Any())
                                {
                                    <div class="notif-empty"><div class="notif-empty-icon">🔕</div><span>لا توجد إشعارات جديدة</span></div>
                                }
                                else
                                {
                                    @foreach (var notif in notifications)
                                    {
                                        <button class="notif-item @(!notif.IsRead ? "unread" : "")" @onclick="@(() => OnNotifClick(notif))" @onclick:stopPropagation="true">
                                            <div class="notif-item-icon">@NotificationService.GetTypeIcon(notif.NotificationType)</div>
                                            <div class="notif-item-body">
                                                <div class="notif-item-title">@notif.Title</div>
                                                <div class="notif-item-msg">@notif.Message</div>
                                                <div class="notif-item-time">🕐 @GetTimeAgo(notif.NotificationDate)</div>
                                            </div>
                                            @if (!notif.IsRead){<div class="notif-unread-dot" style="background:@NotificationService.GetPriorityColor(notif.Priority)"></div>}
                                        </button>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="tb-divider hide-sm"></div>
                <div class="tb-date hide-sm"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><span>@DateTime.Now.ToString("dd/MM/yyyy")</span></div>

                <div class="tb-user-menu">
                    <button class="tb-user-btn" @onclick="ToggleUserMenu">
                        <div class="tb-avatar">@GetInitials()</div>
                        <div class="tb-user-info hide-sm"><span class="tb-user-name">@UserSession.FullName</span><span class="tb-user-role">@UserSession.RoleName</span></div>
                        <svg class="tb-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
                    </button>
                    @if (showUserMenu)
                    {
                        <div class="tb-user-dropdown">
                            <div class="tb-user-dropdown-head">
                                <div class="tb-avatar large">@GetInitials()</div>
                                <div><div class="tb-dropdown-name">@UserSession.FullName</div><div class="tb-dropdown-role">@UserSession.RoleName</div></div>
                            </div>
                            <div class="tb-dropdown-divider"></div>
                            <button class="tb-dropdown-item" @onclick="@(() => Navigation.NavigateTo("/change-password"))"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>تغيير كلمة المرور</button>
                            <button class="tb-dropdown-item danger" @onclick="@(async () => await DoLogout())"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>تسجيل الخروج</button>
                        </div>
                        <div class="tb-user-bg" @onclick="@(() => showUserMenu = false)"></div>
                    }
                </div>
            </div>
        </header>

        <div class="app-body">
            <div class="app-body-inner">@Body</div>
        </div>

        <footer class="app-footer">
            <span>© @DateTime.Now.Year <strong style="color:#D4AF37">YK COATINGS</strong> Gold Edition</span>
            <span class="footer-sep">·</span><span>الإصدار 2.0</span>
            <span class="footer-sep">·</span><span class="footer-status"><span class="status-dot"></span>جميع الأنظمة تعمل</span>
            <span class="footer-sep">·</span><span class="footer-dev-main">تصميم وتطوير : أحمد محمد الرفاعى | 01122050119</span>
        </footer>
    </main>
</div>
}

<style>
:root{
  --gold:#D4AF37;--gold-light:#E8C86A;--gold-dark:#9C7C2E;
  --gold-10:rgba(212,175,55,.10);--gold-15:rgba(212,175,55,.15);--border-gold:rgba(212,175,55,.18);
  --black:#070B14;--black2:#0A0F1E;--black3:#121A2E;--black4:#1A2540;
  --sb-width:300px;--topbar-h:68px;--body-bg:#f8f7f4;
  --transition:.30s cubic-bezier(.4,0,.2,1);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
.app-shell{display:flex;min-height:100vh;background:var(--body-bg);font-family:'Tajawal',sans-serif;position:relative}

/* SIDEBAR - FIXED FULL HEIGHT - ALWAYS FULL */
.app-sidebar{
  position:fixed;top:0;right:0;bottom:0;
  width:var(--sb-width);height:100vh;height:100dvh;
  background:linear-gradient(180deg,var(--black) 0%,var(--black2) 20%,var(--black3) 100%);
  color:#cbd5e1;display:flex;flex-direction:column;
  z-index:200;border-left:1px solid var(--border-gold);
  box-shadow:8px 0 40px rgba(0,0,0,.55),inset -1px 0 0 rgba(212,175,55,.08);
  transition:transform var(--transition),opacity var(--transition);
  overflow:hidden;
}
.sidebar-collapsed .app-sidebar{transform:translateX(100%);opacity:0;pointer-events:none}
.sb-gold-line{position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.8;z-index:5}
.sb-header{padding:16px 14px 6px;display:flex;align-items:center;justify-content:space-between;gap:8px;flex-shrink:0;position:relative}
.sb-brand{flex:1;min-width:0;display:flex;align-items:center;gap:11px}
.sb-logo-wrap{position:relative;width:46px;height:46px;flex-shrink:0;border-radius:14px;background:linear-gradient(140deg,rgba(212,175,55,.18),rgba(212,175,55,.03));border:1px solid rgba(212,175,55,.3);display:flex;align-items:center;justify-content:center;box-shadow:0 6px 18px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.07)}
.sb-logo-wrap::after{content:'';position:absolute;inset:-4px;border-radius:18px;border:1px solid rgba(212,175,55,.13);pointer-events:none}
.sb-logo-full{width:32px;height:32px;object-fit:contain;display:block;filter:drop-shadow(0 2px 8px rgba(212,175,55,.35))}
.sb-brand-text{display:flex;flex-direction:column;min-width:0;overflow:hidden}
.sb-brand-name{font-size:.92rem;font-weight:900;color:#F5E6C8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.2;letter-spacing:.2px}
.sb-brand-sub{font-size:.58rem;font-weight:700;color:rgba(212,175,55,.6);letter-spacing:1.3px;white-space:nowrap;margin-top:3px}
.sb-close-mobile{width:34px;height:34px;border:1px solid rgba(212,175,55,.15);background:rgba(255,255,255,.04);color:#8B95A5;border-radius:10px;display:flex;align-items:center;justify-content:center;cursor:pointer;display:none}
.sb-close-mobile svg{width:16px;height:16px}
.sb-tagline{display:flex;align-items:center;gap:8px;margin:10px 12px 2px;padding:6px 10px;font-size:9.5px;letter-spacing:2px;font-weight:700;color:rgba(212,175,55,.62);border:1px solid rgba(212,175,55,.10);background:linear-gradient(to left,rgba(212,175,55,.07),transparent);border-radius:9px;flex-shrink:0;white-space:nowrap;overflow:hidden}
.sb-tagline::before{content:'';width:4px;height:4px;border-radius:50%;background:#D4AF37;box-shadow:0 0 8px rgba(212,175,55,.9);flex-shrink:0}
.sb-search{margin:12px 12px 8px;position:relative;flex-shrink:0}
.sb-search input{width:100%;height:38px;background:rgba(255,255,255,.03);border:1px solid rgba(212,175,55,.12);border-radius:11px;padding:0 38px 0 34px;color:#fff;font-family:'Tajawal';font-size:13px;transition:background .25s,border-color .25s,box-shadow .25s}
.sb-search input::placeholder{color:#5A6577}
.sb-search input:focus{outline:none;background:rgba(212,175,55,.07);border-color:rgba(212,175,55,.3);box-shadow:0 0 0 3px rgba(212,175,55,.07)}
.sb-search svg{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:16px;height:16px;stroke:#5A6577}
.sb-search-clear{position:absolute;left:8px;top:50%;transform:translateY(-50%);width:22px;height:22px;border-radius:7px;border:none;background:rgba(255,255,255,.06);color:#8B95A5;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s}
.sb-search-clear:hover{background:rgba(212,175,55,.16);color:#D4AF37}
.sb-search-clear svg{position:static;transform:none;width:12px;height:12px;stroke:currentColor}
.sb-user{margin:10px 12px 0;padding:10px 12px;display:flex;align-items:center;gap:11px;background:linear-gradient(to left,rgba(212,175,55,.07),rgba(255,255,255,.015));border:1px solid rgba(212,175,55,.12);border-radius:14px;flex-shrink:0;position:relative;overflow:hidden;box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}
.sb-user::after{content:'';position:absolute;right:0;top:14px;bottom:14px;width:2px;border-radius:2px;background:linear-gradient(to bottom,transparent,rgba(212,175,55,.6),transparent)}
.sb-avatar{width:38px;height:38px;border-radius:11px;background:linear-gradient(135deg,var(--gold),var(--gold-dark));display:flex;align-items:center;justify-content:center;font-weight:900;color:var(--black2);font-size:.88rem;flex-shrink:0;box-shadow:0 4px 12px rgba(0,0,0,.3)}
.sb-user-text{display:flex;flex-direction:column;min-width:0;overflow:hidden;flex:1}
.sb-user-name{font-weight:700;font-size:.85rem;color:#F5E6C8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.sb-user-role{font-size:.72rem;color:#8B95A5;display:flex;align-items:center;gap:6px;margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.online-dot{width:7px;height:7px;border-radius:50%;background:#22c55e;box-shadow:0 0 0 3px rgba(34,197,94,.15);animation:pulse 2s infinite}
@@keyframes pulse{0%,100%{box-shadow:0 0 0 3px rgba(34,197,94,.15)}50%{box-shadow:0 0 0 6px rgba(34,197,94,.08)}}
.sb-nav-area{flex:1;overflow-y:auto;overflow-x:hidden;padding:10px 8px;scrollbar-width:thin;scrollbar-color:rgba(212,175,55,.15) transparent}
.sb-nav-area::-webkit-scrollbar{width:4px}
.sb-nav-area::-webkit-scrollbar-thumb{background:rgba(212,175,55,.15);border-radius:99px}
.sb-footer{padding:12px;border-top:1px solid rgba(212,175,55,.08);background:rgba(0,0,0,.2);flex-shrink:0}
.sb-footer-content{display:flex;align-items:center;gap:10px}
.sb-footer-icon{width:32px;height:32px;border-radius:8px;background:rgba(212,175,55,.08);border:1px solid rgba(212,175,55,.12);color:var(--gold);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.sb-footer-icon svg{width:15px;height:15px}
.sb-footer-text{display:flex;flex-direction:column;font-size:.72rem;color:#5A6577}
.sb-footer-status{color:var(--gold);margin-top:2px;font-weight:600;font-size:.68rem}

/* MAIN - WITH MARGIN FOR SIDEBAR */
.app-main{flex:1;display:flex;flex-direction:column;min-width:0;margin-right:var(--sb-width);transition:margin-right var(--transition);min-height:100vh}
.sidebar-collapsed .app-main{margin-right:0}

/* TOPBAR - FIXED ALWAYS VISIBLE */
.app-topbar{
  position:fixed;top:0;right:var(--sb-width);left:0;z-index:100;
  background:linear-gradient(135deg,var(--black2) 0%,var(--black3) 70%,var(--black4) 100%);
  border-bottom:1px solid var(--border-gold);
  padding:0 24px;height:var(--topbar-h);display:flex;align-items:center;justify-content:space-between;gap:16px;
  box-shadow:0 1px 0 rgba(212,175,55,.08),0 4px 24px rgba(0,0,0,.25);
  transition:right var(--transition),left var(--transition);
}
.sidebar-collapsed .app-topbar{right:0}
.app-topbar::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.5}
.tb-right,.tb-left{display:flex;align-items:center;gap:12px}
.tb-toggle-btn{
  width:46px;height:46px;border:1.5px solid var(--gold);background:rgba(212,175,55,.10);
  border-radius:12px;color:var(--gold);display:flex;align-items:center;justify-content:center;
  cursor:pointer;transition:all .2s;flex-shrink:0;box-shadow:0 0 0 3px rgba(212,175,55,.08),0 4px 12px rgba(212,175,55,.15);
}
.tb-toggle-btn:hover{background:var(--gold);color:var(--black2);transform:scale(1.05);box-shadow:0 0 0 4px rgba(212,175,55,.15),0 6px 20px rgba(212,175,55,.25)}
.tb-toggle-btn svg{width:22px;height:22px}
.tb-brand{display:flex;align-items:center;gap:10px;text-decoration:none;padding:6px 14px 6px 10px;border-radius:14px;background:linear-gradient(135deg,rgba(212,175,55,.10),rgba(212,175,55,.03));border:1px solid rgba(212,175,55,.16);transition:all .25s;flex-shrink:0;box-shadow:inset 0 1px 0 rgba(255,255,255,.04)}
