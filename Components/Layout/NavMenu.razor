@implements IDisposable
@using YKCoatings.Services
@using YKCoatings.Helpers
@using YKCoatings.Models
@inject PermissionService PermissionService
@inject UserSessionService UserSession
@inject NavigationManager Navigation

@if (isLoading)
{
    <div class="nm-skeleton" aria-busy="true" aria-label="جاري تحميل القائمة">
        @for (int i = 0; i < 3; i++){<div class="nm-skel-item"></div>}
        <div class="nm-skel-item" style="height:12px;width:60%;margin-right:8px"></div>
        @for (int i = 0; i < 3; i++){<div class="nm-skel-item"></div>}
    </div>
}
else
{
    <nav class="nm-root" role="navigation" aria-label="القائمة الرئيسية">
        @if (!IsCollapsed)
        {
            <div class="nm-section-label"><span>القائمة الرئيسية</span></div>
        }

        <NavLink class="@GetItemClass()" href="/dashboard" Match="NavLinkMatch.All" title="الرئيسية">
            <span class="nm-icon" style="--ic:#D4AF37">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9.5 12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5Z"/><path d="M9 21V12h6v9"/></svg>
            </span>
            @if (!IsCollapsed){<span class="nm-label">الرئيسية</span>}
        </NavLink>

        @if (filteredModules.Any() && !IsCollapsed)
        {
            <div class="nm-section-label alt"><span>الأقسام والوحدات</span></div>
        }

        @foreach (var mod in filteredModules)
        {
            var kids = PermissionService.GetChildModules(mod.ModuleID).ToList();
            var modColor = GetModuleColor(mod, kids);
            var groupClass = GetGroupClass(mod);
            var isVisible = IsModuleVisible(mod, kids);
            @if (!isVisible) { continue; }

            @if (kids.Any())
            {
                <div class="@groupClass" style="@($"--mc:{modColor}" )">
                    <span class="nm-rail"></span>
                    <button class="nm-group-btn" @onclick="@(() => Toggle(mod.ModuleID))" title="@mod.ModuleNameAr" aria-expanded="@expandedGroups.Contains(mod.ModuleID)">
                        <span class="nm-icon" style="@($"--ic:{modColor}")">@((MarkupString)NavMenuIcons.Get(mod.ModuleCode))</span>
                        @if (!IsCollapsed)
                        {
                            <span class="nm-label">@mod.ModuleNameAr</span>
                            <span class="nm-badge">@kids.Count(k => IsChildVisible(k))</span>
                            <span class="nm-arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
                        }
                    </button>
                    @if (!IsCollapsed)
                    {
                        <div class="nm-sub-panel"><div class="nm-sub-list" style="@($"--mc:{modColor}")">
                            @foreach (var kid in kids.Where(k => IsChildVisible(k)))
                            {
                                var kidColor = GetModuleColor(kid, new List<ModulePermissionDto>());
                                <NavLink class="nm-sub-item" href="@ModuleRouteHelper.GetRoute(kid.ModuleCode)" Match="NavLinkMatch.Prefix" title="@kid.ModuleNameAr">
                                    <span class="nm-sub-icon" style="@($"--ic:{kidColor}")">@((MarkupString)NavMenuIcons.Get(kid.ModuleCode))</span>
                                    <span class="nm-sub-dot"></span><span class="nm-sub-text">@kid.ModuleNameAr</span>
                                    <svg class="nm-sub-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m15 18-6-6 6-6"/></svg>
                                </NavLink>
                            }
                        </div></div>
                    }
                </div>
            }
            else
            {
                <NavLink class="@GetItemClass()" href="@ModuleRouteHelper.GetRoute(mod.ModuleCode)" Match="NavLinkMatch.Prefix" title="@mod.ModuleNameAr" style="@($"--mc:{modColor}")">
                    <span class="nm-icon" style="@($"--ic:{modColor}")">@((MarkupString)NavMenuIcons.Get(mod.ModuleCode))</span>
                    @if (!IsCollapsed){<span class="nm-label">@mod.ModuleNameAr</span>}
                </NavLink>
            }
        }

        @if (!filteredModules.Any() && !string.IsNullOrWhiteSpace(SearchText))
        {
            <div class="nm-empty"><div class="nm-empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="28" height="28"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg></div><span>لا توجد نتائج لـ "@SearchText"</span></div>
        }
    </nav>
}

<style>
.nm-root{display:flex;flex-direction:column;gap:3px;padding:2px}
.nm-section-label{padding:14px 12px 8px;font-size:.6rem;font-weight:800;letter-spacing:1.6px;color:rgba(212,175,55,.5);display:flex;align-items:center;gap:8px}
.nm-section-label::before{content:'';width:5px;height:5px;border-radius:50%;background:#D4AF37;box-shadow:0 0 9px rgba(212,175,55,.85);flex-shrink:0}
.nm-section-label::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,rgba(212,175,55,.2),transparent)}
.nm-section-label.alt{padding-top:18px}
.nm-item{display:flex;align-items:center;gap:12px;padding:9px 11px;border-radius:13px;text-decoration:none;color:#8B95A5;font-size:.875rem;font-weight:600;transition:background .25s,color .25s,transform .25s,border-color .25s,box-shadow .25s;border:1px solid transparent;position:relative;overflow:hidden}
.nm-item::before{content:'';position:absolute;inset:0;background:linear-gradient(to left,rgba(255,255,255,.055),transparent 60%);opacity:0;transition:opacity .25s;pointer-events:none}
.nm-item::after{content:'';position:absolute;right:0;top:50%;transform:translateY(-50%);width:3px;height:0;background:var(--mc,#D4AF37);border-radius:0 4px 4px 0;transition:height .3s cubic-bezier(.4,0,.2,1);box-shadow:0 0 10px var(--mc,#D4AF37)}
.nm-item:hover{background:rgba(255,255,255,.045);color:#F5E6C8;border-color:rgba(212,175,55,.12);transform:translateX(-3px)}
.nm-item:hover::before{opacity:1}
.nm-item:hover::after{height:52%}
.nm-item.active{background:linear-gradient(to left,rgba(212,175,55,.20),rgba(212,175,55,.05));color:#FFF6DF;border-color:rgba(212,175,55,.28);font-weight:800;box-shadow:0 6px 20px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.05)}
.nm-item.active::before{opacity:1}
.nm-item.active::after{height:70%;box-shadow:0 0 14px var(--mc,#D4AF37)}
.nm-item.compact{justify-content:center;padding:11px 8px;gap:0}
.nm-icon{width:36px;height:36px;border-radius:11px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--ic,#D4AF37);transition:background .28s,border-color .28s,box-shadow .28s,transform .28s}
.nm-icon svg{width:18px;height:18px;stroke-linecap:round;stroke-linejoin:round;transition:transform .28s;stroke-width:1.5;fill:none}
.nm-item:hover .nm-icon,.nm-group-btn:hover .nm-icon{border-color:var(--ic,#D4AF37);background:rgba(255,255,255,.07);box-shadow:0 4px 14px rgba(0,0,0,.3)}
.nm-item:hover .nm-icon svg,.nm-group-btn:hover .nm-icon svg{transform:scale(1.1)}
.nm-item.active .nm-icon{border-color:var(--ic,#D4AF37);background:rgba(255,255,255,.09);box-shadow:0 0 0 3px rgba(212,175,55,.08),0 4px 16px rgba(0,0,0,.3)}
.nm-group.has-active .nm-icon{border-color:var(--ic,#D4AF37)}
.nm-label{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;line-height:1.3}
.nm-group{border-radius:14px;border:1px solid transparent;transition:background .25s,border-color .25s;position:relative;overflow:hidden}
.nm-group.open{background:rgba(255,255,255,.022);border-color:rgba(212,175,55,.10)}
.nm-group.has-active{background:linear-gradient(to left,rgba(212,175,55,.07),transparent);border-color:rgba(212,175,55,.16)}
.nm-rail{position:absolute;right:0;top:12px;bottom:12px;width:2px;border-radius:2px;background:linear-gradient(to bottom,transparent,var(--mc,#D4AF37),transparent);opacity:0;transition:opacity .25s;pointer-events:none;z-index:2}
.nm-group.has-active .nm-rail{opacity:.85}
.nm-group-btn{width:100%;border:none;background:transparent;color:#8B95A5;padding:9px 11px;display:flex;align-items:center;gap:12px;font-size:.875rem;font-weight:600;cursor:pointer;transition:color .22s,background .22s;border-radius:14px;font-family:'Tajawal',inherit}
.nm-group-btn:hover{background:rgba(255,255,255,.04);color:#F5E6C8}
.nm-group.has-active .nm-group-btn{color:#F5E6C8;font-weight:700}
.nm-group.compact .nm-group-btn{justify-content:center;padding:11px 8px}
.nm-group-btn:focus-visible{outline:2px solid var(--mc,#D4AF37);outline-offset:2px}
.nm-badge{min-width:22px;height:19px;border-radius:7px;background:rgba(255,255,255,.055);color:#7A8598;display:flex;align-items:center;justify-content:center;font-size:.62rem;font-weight:800;flex-shrink:0;padding:0 6px;border:1px solid rgba(255,255,255,.05);transition:all .25s}
.nm-group.has-active .nm-badge{background:rgba(212,175,55,.16);color:#D4AF37;border-color:rgba(212,175,55,.25)}
.nm-arrow{width:18px;height:18px;display:flex;align-items:center;justify-content:center;transition:transform .3s,color .25s;flex-shrink:0;color:#5A6577}
.nm-arrow svg{width:12px;height:12px}
.nm-group:hover .nm-arrow{color:#8B95A5}
.nm-group.open .nm-arrow{transform:rotate(180deg);color:var(--mc,#D4AF37)}
.nm-sub-panel{display:grid;grid-template-rows:0fr;transition:grid-template-rows .32s cubic-bezier(.4,0,.2,1),opacity .26s;opacity:0}
.nm-group.open .nm-sub-panel{grid-template-rows:1fr;opacity:1}
.nm-sub-list{overflow:hidden;display:flex;flex-direction:column;gap:2px;padding:5px 6px 10px 6px;margin-right:26px;position:relative}
.nm-sub-list::before{content:'';position:absolute;right:0;top:8px;bottom:14px;width:1.5px;background:linear-gradient(to bottom,var(--mc,#D4AF37),rgba(212,175,55,.08));border-radius:2px;opacity:.5}
.nm-sub-item{display:flex;align-items:center;gap:8px;padding:7px 8px 7px 6px;border-radius:10px;text-decoration:none;color:#6C7789;font-size:.82rem;font-weight:600;transition:background .22s,color .22s,padding .22s,border-color .22s;border:1px solid transparent}
.nm-sub-item:hover{background:rgba(255,255,255,.045);color:#F5E6C8;padding-right:10px}
.nm-sub-item.active{background:linear-gradient(to left,rgba(212,175,55,.15),rgba(212,175,55,.03));color:#FFF6DF;border-color:rgba(212,175,55,.20);font-weight:700}
.nm-sub-icon{width:26px;height:26px;border-radius:8px;background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.06);display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--ic,#8B95A5);transition:all .22s}
.nm-sub-icon svg{width:14px;height:14px;stroke-width:1.5;fill:none}
.nm-sub-item:hover .nm-sub-icon{border-color:var(--ic,#D4AF37);background:rgba(255,255,255,.06);box-shadow:0 2px 8px rgba(0,0,0,.2)}
.nm-sub-item.active .nm-sub-icon{border-color:var(--ic,#D4AF37);background:rgba(212,175,55,.12);color:var(--ic,#D4AF37);box-shadow:0 0 0 2px rgba(212,175,55,.12)}
.nm-sub-dot{width:5px;height:5px;border-radius:50%;border:1.5px solid #3A4555;background:transparent;flex-shrink:0;transition:all .22s}
.nm-sub-item:hover .nm-sub-dot{border-color:var(--mc,#D4AF37);background:rgba(212,175,55,.35)}
.nm-sub-item.active .nm-sub-dot{border-color:var(--mc,#D4AF37);background:var(--mc,#D4AF37);box-shadow:0 0 0 3px rgba(212,175,55,.15)}
.nm-sub-text{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1}
.nm-sub-arrow{width:11px;height:11px;opacity:0;transition:opacity .22s,transform .22s;color:var(--mc,#D4AF37);flex-shrink:0}
.nm-sub-item:hover .nm-sub-arrow{opacity:.7;transform:translateX(-2px)}
.nm-skeleton{display:flex;flex-direction:column;gap:7px;padding:6px 2px}
.nm-skel-item{height:38px;border-radius:12px;background:linear-gradient(90deg,rgba(255,255,255,.03) 25%,rgba(255,255,255,.07) 50%,rgba(255,255,255,.03) 75%);background-size:200% 100%;animation:nmShimmer 1.3s infinite}
@@keyframes nmShimmer{0%{background-position:200% 0}100%{background-position:-200% 0}}
.nm-empty{display:flex;flex-direction:column;align-items:center;gap:8px;padding:26px 12px;color:#5A6577;font-size:.84rem;text-align:center}
.nm-empty-icon{font-size:1.8rem;opacity:.6}
@@media(prefers-reduced-motion:reduce){.nm-item,.nm-icon,.nm-arrow,.nm-sub-item,.nm-rail{transition:none!important}.nm-skel-item{animation:none!important}}
</style>

@code {
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public string SearchText { get; set; } = "";
    private bool isLoading = true;
    private List<ModulePermissionDto> mainModules = new();
    private HashSet<int> expandedGroups = new();
    private string? lastRoute;

    // ===== ألوان الموديولات - حسب العائلة الوظيفية =====
    private static readonly Dictionary<string, string> ColorByCode = new(StringComparer.OrdinalIgnoreCase)
    {
        // البيانات الأساسية - ذهبي
        ["SCR_ITEMS"] = "#D4AF37", ["SCR_CATEGORIES"] = "#D4AF37", ["SCR_UNITS"] = "#D4AF37",
        ["SCR_CURRENCIES"] = "#D4AF37", ["SCR_PAYTERMS"] = "#D4AF37", ["SCR_PRICELISTS"] = "#D4AF37",
        ["SCR_SETTINGS"] = "#D4AF37",
        // المشتريات - سماوي
        ["SCR_PR"] = "#0ea5e9", ["SCR_PO"] = "#0ea5e9", ["SCR_GRN"] = "#0ea5e9",
        ["SCR_PINV"] = "#0ea5e9", ["SCR_PRET"] = "#0ea5e9", ["SCR_SUPPLIERS"] = "#0ea5e9",
        // التصنيع - بنفسجي
        ["SCR_BOM"] = "#8b5cf6", ["SCR_PRODORD"] = "#8b5cf6", ["SCR_MATISS"] = "#8b5cf6",
        ["SCR_BATCH"] = "#8b5cf6", ["SCR_QC"] = "#8b5cf6", ["SCR_CONTRACT"] = "#8b5cf6",
        // المخازن - برتقالي
        ["SCR_STOCK"] = "#f97316", ["SCR_TRANS"] = "#f97316", ["SCR_TRANSFER"] = "#f97316",
        ["SCR_COUNT"] = "#f97316", ["SCR_WAREHOUSES"] = "#f97316",
        // المبيعات - أخضر
        ["SCR_QUOT"] = "#10b981", ["SCR_SO"] = "#10b981", ["SCR_SINV"] = "#10b981",
        ["SCR_SRET"] = "#10b981", ["SCR_RECV"] = "#10b981", ["SCR_CUSTOMERS"] = "#10b981",
        // الحسابات - سماوي مزرق - Gold Edition Pro
        ["SCR_COA"] = "#06b6d4", ["SCR_JV"] = "#06b6d4", ["SCR_JV_NEW"] = "#06b6d4", ["SCR_PAYV"] = "#06b6d4",
        ["SCR_EXPENSES"] = "#06b6d4", ["SCR_EXPENSE"] = "#06b6d4", ["SCR_OVERHEAD"] = "#06b6d4", ["SCR_OVERHEAD_EXPENSES"] = "#06b6d4",
        ["SCR_BANKS"] = "#06b6d4", ["SCR_BANKACC"] = "#06b6d4", ["SCR_BANK_ACCOUNTS"] = "#06b6d4",
        ["SCR_CHEQUES"] = "#06b6d4", ["SCR_CHEQUE"] = "#06b6d4",
        ["SCR_COST"] = "#06b6d4", ["SCR_COSTCENTERS"] = "#06b6d4", ["SCR_COST_CENTERS"] = "#06b6d4",
        ["SCR_FY"] = "#06b6d4", ["SCR_FISCALYEARS"] = "#06b6d4", ["SCR_FISCAL_YEARS"] = "#06b6d4",
        ["SCR_TRIAL"] = "#06b6d4", ["SCR_TRIALBAL"] = "#06b6d4", ["SCR_TB"] = "#06b6d4",
        ["SCR_LEDGER"] = "#06b6d4", ["SCR_ACCLEDGER"] = "#06b6d4", ["SCR_ACCOUNT_LEDGER"] = "#06b6d4",
        ["SCR_COSTCARD"] = "#06b6d4",
        // الموارد البشرية - وردي
        ["SCR_DEPARTMENTS"] = "#ec4899", ["SCR_JOBTITLES"] = "#ec4899", ["SCR_EMP"] = "#ec4899",
        ["SCR_ATTEND"] = "#ec4899", ["SCR_LEAVE"] = "#ec4899", ["SCR_PAYROLL"] = "#ec4899",
        ["SCR_LOANS"] = "#ec4899", ["SCR_PENALTY"] = "#ec4899", ["SCR_HOLIDAYS"] = "#ec4899",
        ["SCR_LV_BALANCE"] = "#ec4899", ["SCR_LV_TYPE"] = "#ec4899",
        // إدارة النظام - أحمر
        ["SCR_USERS"] = "#ef4444", ["SCR_ROLES"] = "#ef4444", ["SCR_AUDIT"] = "#ef4444",
        ["SCR_LOGINLOG"] = "#ef4444", ["SCR_SYSSET"] = "#ef4444", ["SCR_BACKUP"] = "#ef4444"
    };
    private static readonly string[] ColorPalette = { "#D4AF37", "#0ea5e9", "#10b981", "#8b5cf6", "#f97316", "#06b6d4", "#ec4899", "#ef4444", "#84cc16" };

    /// <summary>لون الموديول: من الخريطة الدلالية، أو من أول شاشة فرعية، أو من اللوحة حسب المعرّف (ثابت)</summary>
    private string GetModuleColor(ModulePermissionDto mod, List<ModulePermissionDto> kids)
    {
        if (!string.IsNullOrWhiteSpace(mod.ModuleCode) && ColorByCode.TryGetValue(mod.ModuleCode, out var c)) return c;
        foreach (var k in kids)
        {
            if (!string.IsNullOrWhiteSpace(k.ModuleCode) && ColorByCode.TryGetValue(k.ModuleCode, out var kc)) return kc;
        }
        if (kids.Any()) return ColorPalette[Math.Abs(mod.ModuleID) % ColorPalette.Length];
        return "#D4AF37";
    }

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnNav;
        if (!UserSession.IsLoggedIn){Navigation.NavigateTo("/login");return;}
        if (!PermissionService.IsLoaded) await PermissionService.LoadPermissionsAsync(UserSession.UserID);
        mainModules = PermissionService.GetMainModules().ToList();
        SyncRoute();
        if (!expandedGroups.Any() && mainModules.Any()) expandedGroups.Add(mainModules.First().ModuleID);
        isLoading = false;
    }
    private List<ModulePermissionDto> filteredModules
    {
        get
        {
            if (string.IsNullOrWhiteSpace(SearchText)) return mainModules;
            return mainModules.Where(m => IsModuleVisible(m, PermissionService.GetChildModules(m.ModuleID).ToList())).ToList();
        }
    }
    private bool IsModuleVisible(ModulePermissionDto mod, List<ModulePermissionDto> kids)
    {
        if (string.IsNullOrWhiteSpace(SearchText)) return true;
        var s = SearchText.Trim();
        if (mod.ModuleNameAr.Contains(s, StringComparison.OrdinalIgnoreCase)) return true;
        return kids.Any(k => k.ModuleNameAr.Contains(s, StringComparison.OrdinalIgnoreCase));
    }
    private bool IsChildVisible(ModulePermissionDto kid)
    {
        if (string.IsNullOrWhiteSpace(SearchText)) return true;
        return kid.ModuleNameAr.Contains(SearchText.Trim(), StringComparison.OrdinalIgnoreCase);
    }
    private string GetItemClass() => IsCollapsed ? "nm-item compact" : "nm-item";
    private string GetGroupClass(ModulePermissionDto mod)
    {
        var classes = new List<string> { "nm-group" };
        if (expandedGroups.Contains(mod.ModuleID)) classes.Add("open");
        if (HasActiveChild(mod.ModuleID)) classes.Add("has-active");
        if (IsCollapsed) classes.Add("compact");
        return string.Join(" ", classes);
    }
    private void Toggle(int id){if (!expandedGroups.Add(id)) expandedGroups.Remove(id);}
    private void OnNav(object? s, LocationChangedEventArgs e){if (lastRoute == e.Location) return;lastRoute = e.Location;SyncRoute();InvokeAsync(StateHasChanged);}
    private void SyncRoute(){foreach (var m in mainModules) if (HasActiveChild(m.ModuleID)) expandedGroups.Add(m.ModuleID);}
    private bool HasActiveChild(int id) => PermissionService.GetChildModules(id).Any(c => IsCurrent(ModuleRouteHelper.GetRoute(c.ModuleCode)));
    private bool IsCurrent(string? route)
    {
        if (string.IsNullOrWhiteSpace(route)) return false;
        var cur = Norm("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
        var tgt = Norm(route);
        return cur == tgt || (tgt != "/" && cur.StartsWith(tgt + "/"));
    }
    private static string Norm(string r)
    {
        r = (r ?? "/").Split('?', '#')[0].Trim();
        if (!r.StartsWith("/")) r = "/" + r;
        r = r.TrimEnd('/').ToLowerInvariant();
        return string.IsNullOrEmpty(r) ? "/" : r;
    }
    public void Dispose() => Navigation.LocationChanged -= OnNav;
}
